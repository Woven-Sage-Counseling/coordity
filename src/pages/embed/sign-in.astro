---
import '../../styles/global.css';
import { COORDITY_PRODUCT_NAME } from '../../lib/organization';

export const prerender = false;

const error = Astro.url.searchParams.get('error');
const organization = Astro.locals.organization;
const orgName = organization?.displayName ?? organization?.name ?? 'Workspace';
const orgLogo = organization?.logoUrl;
const next = String(Astro.url.searchParams.get('next') ?? '/').trim() || '/';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Sign in | {orgName}</title>
  </head>
  <body class="min-h-screen bg-cream px-4 py-8 text-charcoal">
    <div class="mx-auto max-w-sm">
      {
        orgLogo ? (
          <img src={orgLogo} alt={orgName} class="mx-auto h-8 w-auto" width="200" height="34" />
        ) : (
          <p class="text-center text-xs uppercase tracking-[0.2em] text-sage-dark/60">{orgName}</p>
        )
      }
      <h1 class="mt-4 text-center font-display text-3xl">Sign in</h1>
      <p class="mt-2 text-center text-sm text-sage-dark/70">Invite-only employee access</p>

      {
        error && (
          <p class="mt-5 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800">
            {error}
          </p>
        )
      }

      <form method="post" action="/api/session/sign-in" class="mt-6 space-y-4">
        <input type="hidden" name="next" value={next} />
        <label class="block text-sm font-medium">
          Email
          <input class="field" type="email" name="email" autocomplete="username" required />
        </label>
        <label class="block text-sm font-medium">
          Password
          <input
            class="field"
            type="password"
            name="password"
            autocomplete="current-password"
            required
            minlength="12"
          />
        </label>
        <button class="btn-primary w-full" type="submit">Sign in</button>
      </form>

      <p class="mt-6 text-center text-xs text-sage-dark/50">Powered by {COORDITY_PRODUCT_NAME}</p>
    </div>
  </body>
</html>
