---
import PortalLayout from '../../../layouts/PortalLayout.astro';
import {
  getModuleProgressForUser,
  moduleVisibleToRoles,
} from '../../../lib/training';
import { orgIdFromLocals } from '../../../lib/organization';

export const prerender = false;

const employee = Astro.locals.employee!;
const orgId = orgIdFromLocals(Astro.locals.organization);
const moduleId = Astro.params.moduleId ?? '';
const roleKeys = employee.roles;

const progress = await getModuleProgressForUser({
  orgId,
  moduleId,
  userId: employee.id,
  roleKeys,
}).catch(() => null as Awaited<ReturnType<typeof getModuleProgressForUser>>);

if (!progress || !moduleVisibleToRoles(progress.module, roleKeys) || !progress.module.visible) {
  return Astro.redirect('/training');
}

const hasAssignments = progress.assignments.length > 0;
const hasLessons = progress.lessons.length > 0;
---

<PortalLayout title={progress.module.title} wide>
  <p class="text-sm text-sage-dark/65">
    <a href="/training" class="hover:text-sage-dark">Training</a>
    <span class="mx-1.5 text-sage-dark/35">/</span>
    {progress.module.title}
  </p>

  <div class="mt-3 max-w-3xl">
    <h1 class="font-display text-4xl text-charcoal">{progress.module.title}</h1>
    {
      progress.module.description ? (
        <p class="mt-3 text-sage-dark/75">{progress.module.description}</p>
      ) : null
    }
    <p class="mt-4 text-sm font-semibold text-sage-dark/80">{progress.percent}% complete</p>
    <div class="mt-2 h-2 overflow-hidden rounded-full bg-[#e3e5e8]">
      <div
        class:list={['h-full rounded-full', progress.complete ? 'bg-emerald-600' : 'bg-sage-dark']}
        style={`width: ${progress.percent}%`}
      />
    </div>
  </div>

  {
    hasAssignments ? (
      <section class="mt-8 max-w-3xl" aria-labelledby="module-assignments">
        <h2 id="module-assignments" class="text-sm font-semibold uppercase tracking-[0.14em] text-sage-dark/60">
          Assignments
        </h2>
        <p class="mt-1 text-sm text-sage-dark/65">Tasks and acknowledgments for this module.</p>
        <ol class="mt-4 space-y-3">
          {progress.assignments.map((assignment, index) => (
            <li>
              <a
                href={`/training/${progress.module.id}/${assignment.id}`}
                class="card flex items-center justify-between gap-3 transition hover:ring-1 hover:ring-sage-dark/20"
              >
                <div class="min-w-0">
                  <p class="text-xs text-sage-dark/50">Assignment {index + 1}</p>
                  <p class="mt-0.5 font-semibold text-charcoal">{assignment.title}</p>
                </div>
                <span
                  class:list={[
                    'shrink-0 rounded-full px-2.5 py-1 text-[11px] font-semibold',
                    assignment.completed
                      ? 'bg-emerald-100 text-emerald-900'
                      : 'bg-sage-dark/10 text-sage-dark/80',
                  ]}
                >
                  {assignment.completed ? 'Done' : 'Start'}
                </span>
              </a>
            </li>
          ))}
        </ol>
      </section>
    ) : null
  }

  <section class="mt-8 max-w-3xl" aria-labelledby="module-lessons">
    <h2 id="module-lessons" class="text-sm font-semibold uppercase tracking-[0.14em] text-sage-dark/60">
      Lessons
    </h2>
    <ol class="mt-4 space-y-3">
      {
        !hasLessons ? (
          <li class="text-sm text-sage-dark/65">
            {hasAssignments
              ? 'No lessons in this module yet.'
              : 'No assignments or lessons in this module yet.'}
          </li>
        ) : (
          progress.lessons.map((lesson, index) => (
            <li>
              <a
                href={`/training/${progress.module.id}/${lesson.id}`}
                class="card flex items-center justify-between gap-3 transition hover:ring-1 hover:ring-sage-dark/20"
              >
                <div class="min-w-0">
                  <p class="text-xs text-sage-dark/50">Lesson {index + 1}</p>
                  <p class="mt-0.5 font-semibold text-charcoal">{lesson.title}</p>
                </div>
                <span
                  class:list={[
                    'shrink-0 rounded-full px-2.5 py-1 text-[11px] font-semibold',
                    lesson.completed
                      ? 'bg-emerald-100 text-emerald-900'
                      : 'bg-sage-dark/10 text-sage-dark/80',
                  ]}
                >
                  {lesson.completed ? 'Done' : 'Start'}
                </span>
              </a>
            </li>
          ))
        )
      }
    </ol>
  </section>
</PortalLayout>
