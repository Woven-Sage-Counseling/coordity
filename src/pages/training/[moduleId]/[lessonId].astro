---
import PortalLayout from '../../../layouts/PortalLayout.astro';
import {
  CONTACT_FIELD_OPTIONS,
  UPLOAD_DOC_OPTIONS,
  extractYoutubeId,
  getBlockResponse,
  getLesson,
  getModuleProgressForUser,
  hasBlockResponse,
  hasContentReview,
  hasUploadResponse,
  isContentBlockType,
  latestQuizPass,
  lessonVisibleToRoles,
  listBlocks,
  listCompletedLessonIds,
  listUploadFiles,
  moduleVisibleToRoles,
  uploadDocAcceptsText,
  uploadDocLabel,
} from '../../../lib/training';
import { getDocuSignEnvelopeForUser, latestDocuSignComplete } from '../../../lib/docusign';
import { orgIdFromLocals } from '../../../lib/organization';
import { canAccessManagement } from '../../../lib/permissions';

export const prerender = false;

const employee = Astro.locals.employee!;
const orgId = orgIdFromLocals(Astro.locals.organization);
const moduleId = Astro.params.moduleId ?? '';
const lessonId = Astro.params.lessonId ?? '';
const roleKeys = employee.roles;
const error = Astro.url.searchParams.get('error');
const quizScore = Astro.url.searchParams.get('score');
const quizPassed = Astro.url.searchParams.get('passed');
const docusignFlash = Astro.url.searchParams.get('docusign');
const contactFlash = Astro.url.searchParams.get('contact');
const uploadFlash = Astro.url.searchParams.get('upload');
const reviewFlash = Astro.url.searchParams.get('review');
const isPreview =
  Astro.url.searchParams.get('preview') === '1' && canAccessManagement(employee);

const lesson = await getLesson(lessonId);
if (!lesson || lesson.orgId !== orgId || lesson.moduleId !== moduleId) {
  return Astro.redirect('/training');
}

const progress = await getModuleProgressForUser({
  orgId,
  moduleId,
  userId: employee.id,
  roleKeys: isPreview ? [] : roleKeys,
});
if (
  !progress ||
  (!isPreview && (!moduleVisibleToRoles(progress.module, roleKeys) || !progress.module.visible))
) {
  return Astro.redirect('/training');
}
if (!isPreview && !lessonVisibleToRoles(lesson, roleKeys)) {
  return Astro.redirect(`/training/${moduleId}`);
}

const blocks = await listBlocks(lessonId);
const completed = await listCompletedLessonIds(employee.id, [lessonId]);
const isComplete = completed.has(lessonId);

const quizPassMap = new Map<string, boolean>();
for (const block of blocks.filter((b) => b.type === 'quiz')) {
  quizPassMap.set(block.id, await latestQuizPass(employee.id, block.id));
}

const docusignDoneMap = new Map<string, boolean>();
const docusignStatusMap = new Map<string, string>();
for (const block of blocks.filter((b) => b.type === 'docusign')) {
  const done = await latestDocuSignComplete(employee.id, block.id);
  docusignDoneMap.set(block.id, done);
  const envelope = await getDocuSignEnvelopeForUser(employee.id, block.id);
  if (envelope) docusignStatusMap.set(block.id, envelope.status);
}

const contactDoneMap = new Map<string, boolean>();
const contactAnswersMap = new Map<string, Awaited<ReturnType<typeof getBlockResponse>>>();
for (const block of blocks.filter((b) => b.type === 'contact')) {
  const answers = await getBlockResponse(employee.id, block.id);
  contactAnswersMap.set(block.id, answers);
  contactDoneMap.set(block.id, await hasBlockResponse(employee.id, block.id));
}

const uploadDoneMap = new Map<string, boolean>();
const uploadFilesMap = new Map<string, Awaited<ReturnType<typeof listUploadFiles>>>();
for (const block of blocks.filter((b) => b.type === 'upload')) {
  const files = await listUploadFiles(employee.id, block.id);
  uploadFilesMap.set(block.id, files);
  uploadDoneMap.set(block.id, await hasUploadResponse(employee.id, block.id));
}

const contentReviewMap = new Map<string, boolean>();
for (const block of blocks.filter((b) => isContentBlockType(b.type))) {
  contentReviewMap.set(block.id, await hasContentReview(employee.id, block.id));
}

const requiredBlocks = blocks.filter((b) => b.required);
const needsAck = requiredBlocks.some((b) => b.type === 'ack');
const quizzesOk = requiredBlocks
  .filter((b) => b.type === 'quiz')
  .every((b) => quizPassMap.get(b.id));
const docusignOk = requiredBlocks
  .filter((b) => b.type === 'docusign')
  .every((b) => docusignDoneMap.get(b.id));
const contactOk = requiredBlocks
  .filter((b) => b.type === 'contact')
  .every((b) => contactDoneMap.get(b.id));
const uploadOk = requiredBlocks
  .filter((b) => b.type === 'upload')
  .every((b) => uploadDoneMap.get(b.id));
const contentOk = requiredBlocks
  .filter((b) => isContentBlockType(b.type))
  .every((b) => contentReviewMap.get(b.id));
const canComplete = quizzesOk && docusignOk && contactOk && uploadOk && contentOk;
const itemLabel = lesson.isAssignment ? 'assignment' : 'lesson';
const itemLabelTitle = lesson.isAssignment ? 'Assignment' : 'Lesson';

function blockHeading(label: string, required: boolean) {
  return required ? label : `${label} (optional)`;
}
---

<PortalLayout title={lesson.title} wide>
  <p class="text-sm text-sage-dark/65">
    <a href="/training" class="hover:text-sage-dark">Training</a>
    <span class="mx-1.5 text-sage-dark/35">/</span>
    <a href={`/training/${moduleId}`} class="hover:text-sage-dark">{progress.module.title}</a>
    <span class="mx-1.5 text-sage-dark/35">/</span>
    {lesson.title}
  </p>

  <div class="mt-3 max-w-3xl">
    <p class="text-xs font-semibold uppercase tracking-[0.14em] text-sage-dark/55">{itemLabelTitle}</p>
    <h1 class="mt-1 font-display text-4xl text-charcoal">{lesson.title}</h1>
    {
      isPreview ? (
        <p class="mt-3 rounded-xl border border-sage-dark/15 bg-[#f7f8fa] px-3 py-2 text-sm text-sage-dark/80">
          Preview mode — this is how the {itemLabel} looks to learners.
        </p>
      ) : null
    }
    {
      isComplete ? (
        <p class="mt-3 text-sm font-semibold text-emerald-800">{itemLabelTitle} complete</p>
      ) : null
    }
  </div>

  {error ? <p class="mt-4 max-w-3xl rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800">{error}</p> : null}
  {
    docusignFlash === 'completed' ? (
      <p class="mt-4 max-w-3xl rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-900">
        Document signed. You can continue this {itemLabel}.
      </p>
    ) : null
  }
  {
    contactFlash === 'saved' ? (
      <p class="mt-4 max-w-3xl rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-900">
        Contact details saved.
      </p>
    ) : null
  }
  {
    uploadFlash === 'saved' ? (
      <p class="mt-4 max-w-3xl rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-900">
        Document saved.
      </p>
    ) : null
  }
  {
    reviewFlash === 'saved' ? (
      <p class="mt-4 max-w-3xl rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-900">
        Section marked as reviewed.
      </p>
    ) : null
  }
  {
    quizScore != null ? (
      <p
        class:list={[
          'mt-4 max-w-3xl rounded-xl px-4 py-3 text-sm',
          quizPassed === '1'
            ? 'border border-emerald-200 bg-emerald-50 text-emerald-900'
            : 'border border-amber-200 bg-amber-50 text-amber-950',
        ]}
      >
        Quiz score: {quizScore}%{quizPassed === '1' ? ' — passed' : ' — try again to pass'}
      </p>
    ) : null
  }

  <div class="mt-8 max-w-3xl space-y-6">
    {
      blocks.length === 0 ? (
        <p class="text-sm text-sage-dark/65">This {itemLabel} has no content yet.</p>
      ) : (
        blocks.map((block) => {
          if (block.type === 'video') {
            const id = block.youtubeUrl ? extractYoutubeId(block.youtubeUrl) : null;
            const reviewed = contentReviewMap.get(block.id);
            return (
              <section class="card">
                <h2 class="text-sm font-semibold uppercase tracking-[0.14em] text-sage-dark/60">
                  {blockHeading('Video', block.required)}
                </h2>
                {id ? (
                  <div class="mt-4 aspect-video overflow-hidden rounded-xl bg-black">
                    <iframe
                      class="h-full w-full"
                      src={`https://www.youtube.com/embed/${id}`}
                      title="Lesson video"
                      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                      allowfullscreen
                    />
                  </div>
                ) : (
                  <p class="mt-3 text-sm text-sage-dark/65">Video coming soon.</p>
                )}
                {block.required && !isComplete ? (
                  reviewed ? (
                    <p class="mt-4 text-sm font-semibold text-emerald-800">Marked as reviewed</p>
                  ) : (
                    <form method="post" action="/api/training/review-block" class="mt-4">
                      <input type="hidden" name="blockId" value={block.id} />
                      <input type="hidden" name="moduleId" value={moduleId} />
                      <input type="hidden" name="lessonId" value={lessonId} />
                      <button class="btn-primary" type="submit">I’ve reviewed this</button>
                    </form>
                  )
                ) : null}
              </section>
            );
          }
          if (block.type === 'written') {
            return (
              <section class="card">
                <h2 class="text-sm font-semibold uppercase tracking-[0.14em] text-sage-dark/60">
                  Content
                </h2>
                <div class="mt-3 whitespace-pre-wrap text-sm leading-relaxed text-charcoal">
                  {block.bodyText || 'Content coming soon.'}
                </div>
              </section>
            );
          }
          if (block.type === 'resource') {
            const reviewed = contentReviewMap.get(block.id);
            return (
              <section class="card">
                <h2 class="text-sm font-semibold uppercase tracking-[0.14em] text-sage-dark/60">
                  {blockHeading('Resource', block.required)}
                </h2>
                {block.resourceUrl ? (
                  <a
                    class="mt-3 inline-flex text-sm font-semibold text-sage-dark underline-offset-2 hover:underline"
                    href={block.resourceUrl}
                    target="_blank"
                    rel="noreferrer"
                  >
                    {block.resourceLabel || block.resourceUrl}
                  </a>
                ) : (
                  <p class="mt-3 text-sm text-sage-dark/65">No link yet.</p>
                )}
                {block.required && !isComplete ? (
                  reviewed ? (
                    <p class="mt-4 text-sm font-semibold text-emerald-800">Marked as reviewed</p>
                  ) : (
                    <form method="post" action="/api/training/review-block" class="mt-4">
                      <input type="hidden" name="blockId" value={block.id} />
                      <input type="hidden" name="moduleId" value={moduleId} />
                      <input type="hidden" name="lessonId" value={lessonId} />
                      <button class="btn-primary" type="submit">I’ve reviewed this</button>
                    </form>
                  )
                ) : null}
              </section>
            );
          }
          if (block.type === 'quiz') {
            const passed = quizPassMap.get(block.id);
            return (
              <section class="card">
                <h2 class="text-sm font-semibold uppercase tracking-[0.14em] text-sage-dark/60">
                  {blockHeading('Quiz', block.required)}
                </h2>
                <p class="mt-2 text-sm text-sage-dark/70">
                  Pass with {block.passPercent ?? 80}% or higher.
                  {passed ? ' You have already passed this quiz.' : ''}
                </p>
                {block.questions.length === 0 ? (
                  <p class="mt-3 text-sm text-sage-dark/65">No questions yet.</p>
                ) : (
                  <form method="post" action="/api/training/quiz" class="mt-4 space-y-5">
                    <input type="hidden" name="blockId" value={block.id} />
                    <input type="hidden" name="moduleId" value={moduleId} />
                    <input type="hidden" name="lessonId" value={lessonId} />
                    {block.questions.map((question, qIndex) => (
                      <fieldset class="rounded-xl border border-sage-dark/10 p-4">
                        <legend class="px-1 text-sm font-semibold text-charcoal">
                          {qIndex + 1}. {question.prompt}
                        </legend>
                        <div class="mt-3 space-y-2">
                          {question.options.map((option, oIndex) => (
                            <label class="flex items-center gap-2 text-sm text-charcoal">
                              <input
                                type="radio"
                                name={`q_${qIndex}`}
                                value={String(oIndex)}
                                required
                              />
                              {option}
                            </label>
                          ))}
                        </div>
                      </fieldset>
                    ))}
                    <button class="btn-primary" type="submit">Submit quiz</button>
                  </form>
                )}
              </section>
            );
          }
          if (block.type === 'ack') {
            return (
              <section class="card">
                <h2 class="text-sm font-semibold uppercase tracking-[0.14em] text-sage-dark/60">
                  {blockHeading('Acknowledgment', block.required)}
                </h2>
                <p class="mt-3 text-sm text-charcoal">
                  {block.ackPrompt || `I acknowledge that I have completed this ${itemLabel}.`}
                </p>
              </section>
            );
          }
          if (block.type === 'docusign') {
            const signed = docusignDoneMap.get(block.id);
            const status = docusignStatusMap.get(block.id);
            return (
              <section class="card">
                <h2 class="text-sm font-semibold uppercase tracking-[0.14em] text-sage-dark/60">
                  {blockHeading('Document to sign', block.required)}
                </h2>
                <p class="mt-2 text-sm font-medium text-charcoal">
                  {block.docusignTemplateName || 'Required document'}
                </p>
                {block.bodyText ? (
                  <p class="mt-2 whitespace-pre-wrap text-sm text-sage-dark/75">{block.bodyText}</p>
                ) : (
                  <p class="mt-2 text-sm text-sage-dark/70">
                    Review and sign this document to continue. It is saved to your organization’s DocuSign
                    account when complete.
                  </p>
                )}
                {signed ? (
                  <p class="mt-4 text-sm font-semibold text-emerald-800">Signed</p>
                ) : !block.docusignTemplateId ? (
                  <p class="mt-4 text-sm text-amber-800">This document is not ready yet.</p>
                ) : (
                  <form method="post" action="/api/training/docusign/start" class="mt-4">
                    <input type="hidden" name="blockId" value={block.id} />
                    <input type="hidden" name="moduleId" value={moduleId} />
                    <input type="hidden" name="lessonId" value={lessonId} />
                    <button class="btn-primary" type="submit">
                      {status ? 'Continue signing' : 'Sign document'}
                    </button>
                  </form>
                )}
              </section>
            );
          }
          if (block.type === 'contact') {
            const saved = contactAnswersMap.get(block.id);
            const fields = CONTACT_FIELD_OPTIONS.filter((field) =>
              block.contactFields.includes(field.key),
            );
            const defaults = {
              fullName: saved?.fullName || employee.name || '',
              phone: saved?.phone || employee.phone || '',
              workEmail: saved?.workEmail || employee.email || '',
              jobTitle: saved?.jobTitle || employee.jobTitle || '',
            };
            return (
              <section class="card">
                <h2 class="text-sm font-semibold uppercase tracking-[0.14em] text-sage-dark/60">
                  {blockHeading('Contact details', block.required)}
                </h2>
                {block.bodyText ? (
                  <p class="mt-2 text-sm text-sage-dark/70">{block.bodyText}</p>
                ) : (
                  <p class="mt-2 text-sm text-sage-dark/70">
                    Fill in the details below. Empty account fields will be updated from your answers.
                  </p>
                )}
                {contactDoneMap.get(block.id) ? (
                  <p class="mt-3 text-sm font-semibold text-emerald-800">Saved for this {itemLabel}.</p>
                ) : null}
                <form method="post" action="/api/training/contact" class="mt-4 space-y-3">
                  <input type="hidden" name="blockId" value={block.id} />
                  <input type="hidden" name="moduleId" value={moduleId} />
                  <input type="hidden" name="lessonId" value={lessonId} />
                  {fields.map((field) => (
                    <label class="block text-sm font-medium text-charcoal">
                      {field.label}
                      {!field.required ? (
                        <span class="font-normal text-sage-dark/55"> (optional)</span>
                      ) : null}
                      <input
                        class="field mt-1.5"
                        type={field.inputType}
                        name={field.key}
                        required={field.required}
                        maxlength={field.key === 'fullName' || field.key === 'jobTitle' ? 80 : undefined}
                        value={defaults[field.key] ?? ''}
                        placeholder={field.key === 'phone' ? '(555) 555-5555' : undefined}
                      />
                    </label>
                  ))}
                  <button class="btn-primary" type="submit">
                    {contactDoneMap.get(block.id) ? 'Update answers' : 'Save answers'}
                  </button>
                </form>
              </section>
            );
          }
          if (block.type === 'upload') {
            const files = uploadFilesMap.get(block.id) ?? [];
            const byKey = new Map(files.map((file) => [file.docKey, file]));
            const docs = UPLOAD_DOC_OPTIONS.filter((doc) => block.uploadDocs.includes(doc.key));
            return (
              <section class="card">
                <h2 class="text-sm font-semibold uppercase tracking-[0.14em] text-sage-dark/60">
                  {blockHeading('Document uploads', block.required)}
                </h2>
                {block.bodyText ? (
                  <p class="mt-2 text-sm text-sage-dark/70">{block.bodyText}</p>
                ) : (
                  <p class="mt-2 text-sm text-sage-dark/70">
                    Upload the requested documents below. JPEG, PNG, WebP, or PDF up to about 1.2MB each.
                  </p>
                )}
                {uploadDoneMap.get(block.id) ? (
                  <p class="mt-3 text-sm font-semibold text-emerald-800">All requested documents saved.</p>
                ) : null}
                <div class="mt-4 space-y-4">
                  {docs.map((doc) => {
                    const saved = byKey.get(doc.key);
                    const label = uploadDocLabel(doc.key, block.uploadOtherLabel);
                    return (
                      <div class="rounded-xl border border-sage-dark/10 p-4">
                        <p class="text-sm font-medium text-charcoal">{label}</p>
                        {saved?.hasFile || saved?.textValue ? (
                          <p class="mt-1 text-xs text-emerald-800">
                            {saved.hasFile && saved.textValue?.trim()
                              ? 'File and text saved'
                              : saved.hasFile
                                ? `File saved${saved.fileName ? `: ${saved.fileName}` : ''}`
                                : 'Text saved'}
                          </p>
                        ) : null}
                        {saved?.hasFile ? (
                          <p class="mt-2">
                            <a
                              class="text-sm font-semibold text-sage-dark underline-offset-2 hover:underline"
                              href={`/api/training/upload/file/${employee.id}/${block.id}/${doc.key}`}
                            >
                              Download your file
                            </a>
                          </p>
                        ) : null}
                        <form
                          method="post"
                          action="/api/training/upload"
                          enctype="multipart/form-data"
                          class="mt-3 space-y-3"
                        >
                          <input type="hidden" name="blockId" value={block.id} />
                          <input type="hidden" name="moduleId" value={moduleId} />
                          <input type="hidden" name="lessonId" value={lessonId} />
                          <input type="hidden" name="docKey" value={doc.key} />
                          {uploadDocAcceptsText(doc.key) ? (
                            <label class="block text-sm font-medium text-charcoal">
                              {doc.key === 'npiRecord' ? 'NPI number' : 'CAQH number or ID'}
                              <span class="font-normal text-sage-dark/55"> (optional if you upload a file)</span>
                              <input
                                class="field mt-1.5"
                                type="text"
                                name="textValue"
                                maxlength="80"
                                value={saved?.textValue ?? ''}
                              />
                            </label>
                          ) : null}
                          <label class="block text-sm font-medium text-charcoal">
                            {uploadDocAcceptsText(doc.key) ? 'Or upload a file' : 'Upload file'}
                            <input
                              class="field mt-1.5"
                              type="file"
                              name="file"
                              accept="image/jpeg,image/png,image/webp,application/pdf,.pdf"
                              required={!uploadDocAcceptsText(doc.key) && !saved?.hasFile && !saved?.textValue}
                            />
                          </label>
                          <button class="btn-primary" type="submit">
                            {saved?.hasFile || saved?.textValue ? 'Update' : 'Save'}
                          </button>
                        </form>
                      </div>
                    );
                  })}
                </div>
              </section>
            );
          }
          return null;
        })
      )
    }
  </div>

  {
    !isComplete ? (
      <form method="post" action="/api/training/complete-lesson" class="mt-8 max-w-3xl space-y-3">
        <input type="hidden" name="moduleId" value={moduleId} />
        <input type="hidden" name="lessonId" value={lessonId} />
        {needsAck ? (
          <label class="block text-sm font-medium text-charcoal">
            Type your full name to acknowledge
            <input class="field mt-1.5" type="text" name="ackName" required maxlength="80" />
          </label>
        ) : null}
        {!quizzesOk ? (
          <p class="text-sm text-amber-800">Pass all required quizzes before marking this {itemLabel} complete.</p>
        ) : null}
        {!docusignOk ? (
          <p class="text-sm text-amber-800">
            Sign all required documents before marking this {itemLabel} complete.
          </p>
        ) : null}
        {!contactOk ? (
          <p class="text-sm text-amber-800">
            Save required contact details before marking this {itemLabel} complete.
          </p>
        ) : null}
        {!uploadOk ? (
          <p class="text-sm text-amber-800">
            Upload all required documents before marking this {itemLabel} complete.
          </p>
        ) : null}
        {!contentOk ? (
          <p class="text-sm text-amber-800">
            Mark all required sections as reviewed before marking this {itemLabel} complete.
          </p>
        ) : null}
        <button class="btn-primary" type="submit" disabled={!canComplete}>
          Mark {itemLabel} complete
        </button>
      </form>
    ) : (
      <p class="mt-8">
        <a class="text-sm font-semibold text-sage-dark hover:underline" href={`/training/${moduleId}`}>
          Back to module
        </a>
      </p>
    )
  }
</PortalLayout>
