---
import PortalLayout from '../layouts/PortalLayout.astro';
import { formatAnnouncementDate, listAnnouncementsForUser } from '../lib/announcements';

export const prerender = false;

const employee = Astro.locals.employee!;
const announcements = await listAnnouncementsForUser(employee.id, 100);
---

<PortalLayout title="Announcements" wide>
  <p class="text-sm text-sage-dark/65">
    <a href="/" class="hover:text-sage-dark">Home</a>
    <span class="mx-1.5 text-sage-dark/35">/</span>
    Announcements
  </p>
  <div class="mt-3 flex flex-wrap items-end justify-between gap-4">
    <div>
      <h1 class="font-display text-4xl text-charcoal sm:text-5xl">Announcement history</h1>
      <p class="mt-3 max-w-2xl text-sage-dark/75">
        Practice updates you still want to keep. Delete removes an announcement from your history only.
      </p>
    </div>
    <a
      href="/"
      class="rounded-full border border-sage-dark/20 px-3 py-1.5 text-sm font-semibold text-sage-dark transition hover:border-sage-dark/35 hover:bg-sage/10"
    >
      Back to home
    </a>
  </div>

  {
    announcements.length === 0 ? (
      <p class="mt-10 text-sm text-sage-dark/65">No announcements in your history.</p>
    ) : (
      <ul class="mt-10 space-y-4" data-announcements-history>
        {announcements.map((item) => (
          <li
            class="rounded-2xl border border-sage-dark/10 bg-white/80 p-5 shadow-sm"
            data-announcement-item
            data-announcement-id={item.id}
          >
            <div class="flex flex-wrap items-baseline justify-between gap-x-3 gap-y-1">
              <h2 class="text-lg font-semibold text-charcoal">{item.title}</h2>
              <div class="flex items-center gap-3">
                <p class="text-xs text-sage-dark/55">
                  Posted by: {item.authorName} · {formatAnnouncementDate(item.createdAt)}
                </p>
                <button
                  type="button"
                  class="rounded-md px-2 py-1 text-xs font-semibold text-red-700 ring-1 ring-red-200 transition hover:bg-red-50"
                  data-announcement-delete
                >
                  Delete
                </button>
              </div>
            </div>
            <p class="mt-3 whitespace-pre-wrap text-sm leading-relaxed text-sage-dark/80">{item.body}</p>
          </li>
        ))}
      </ul>
    )
  }
</PortalLayout>

<script>
  document.querySelectorAll('[data-announcements-history] [data-announcement-delete]').forEach((button) => {
    button.addEventListener('click', async () => {
      const item = button.closest('[data-announcement-item]');
      if (!(item instanceof HTMLElement) || !(button instanceof HTMLButtonElement)) return;
      const id = item.dataset.announcementId;
      if (!id) return;
      button.disabled = true;
      try {
        await fetch('/api/announcements/dismiss', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ ids: [id] }),
        });
        item.remove();
        const list = document.querySelector('[data-announcements-history]');
        if (list && list.querySelectorAll('[data-announcement-item]').length === 0) {
          list.outerHTML = '<p class="mt-10 text-sm text-sage-dark/65">No announcements in your history.</p>';
        }
      } catch {
        button.disabled = false;
      }
    });
  });
</script>
