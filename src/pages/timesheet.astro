---
import PortalLayout from '../layouts/PortalLayout.astro';
import {
  getWeekSummary,
  serializeTimesheetEntry,
  shiftWeek,
  weekStartMonday,
} from '../lib/timesheet-entries';
import {
  currentWeekRange,
  formatHours,
  formatWeekLabel,
} from '../lib/timesheet';
import { todayEastern } from '../lib/financials/periods';

export const prerender = false;

const employee = Astro.locals.employee!;
const error = Astro.url.searchParams.get('error');
const saved = Astro.url.searchParams.get('saved') === '1';
const deleted = Astro.url.searchParams.get('deleted') === '1';

const weekParam = Astro.url.searchParams.get('week');
const current = currentWeekRange();
const weekStart =
  weekParam && /^\d{4}-\d{2}-\d{2}$/.test(weekParam)
    ? weekStartMonday(weekParam)
    : current.start;

let week = await getWeekSummary(employee.id, weekStart);
const today = todayEastern();
const prevWeek = shiftWeek(week.start, -1);
const nextWeek = shiftWeek(week.start, 1);
const canGoNext = nextWeek <= current.start;
---

<PortalLayout title="Hours worked" wide>
  <p class="text-sm text-sage-dark/65">
    <a href="/" class="hover:text-sage-dark">Home</a>
    <span class="mx-1.5 text-sage-dark/35">/</span>
    Hours worked
  </p>

  <div class="mt-3">
    <h1 class="font-display text-4xl text-charcoal sm:text-5xl">Hours worked</h1>
    <p class="mt-3 max-w-2xl text-sage-dark/75">
      Log the hours you worked each day. Saving the same date again updates that day&apos;s entry.
    </p>
  </div>

  {
    error ? (
      <p class="mt-6 max-w-2xl rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800">
        {error}
      </p>
    ) : null
  }
  {
    saved ? (
      <p class="mt-6 max-w-2xl rounded-xl border border-sage-dark/15 bg-white px-4 py-3 text-sm text-sage-dark/80">
        Hours saved.
      </p>
    ) : null
  }
  {
    deleted ? (
      <p class="mt-6 max-w-2xl rounded-xl border border-sage-dark/15 bg-white px-4 py-3 text-sm text-sage-dark/80">
        Entry removed.
      </p>
    ) : null
  }

  <section class="mt-8 max-w-3xl">
    <div class="flex flex-wrap items-center justify-between gap-3">
      <div>
        <p class="text-sm font-semibold text-charcoal">{formatWeekLabel(week.start, week.end)}</p>
        <p class="mt-1 text-3xl font-semibold text-charcoal">{formatHours(week.totalMinutes)}</p>
      </div>
      <div class="flex items-center gap-2">
        <a
          href={`/timesheet?week=${prevWeek}`}
          class="rounded-full border border-sage-dark/20 px-3 py-1.5 text-sm font-semibold text-sage-dark transition hover:bg-sage/10"
        >
          Previous
        </a>
        {
          canGoNext ? (
            <a
              href={`/timesheet?week=${nextWeek}`}
              class="rounded-full border border-sage-dark/20 px-3 py-1.5 text-sm font-semibold text-sage-dark transition hover:bg-sage/10"
            >
              Next
            </a>
          ) : (
            <span class="rounded-full border border-sage-dark/10 px-3 py-1.5 text-sm font-semibold text-sage-dark/35">
              Next
            </span>
          )
        }
      </div>
    </div>

    <form method="post" action="/api/timesheet/upsert" class="mt-6 rounded-2xl border border-sage-dark/10 bg-white/80 p-5 shadow-sm">
      <input type="hidden" name="returnTo" value={`/timesheet?week=${week.start}`} />
      <h2 class="text-sm font-semibold text-charcoal">Log hours</h2>
      <div class="mt-4 grid gap-4 sm:grid-cols-[minmax(0,1fr)_8rem_minmax(0,1.2fr)_auto] sm:items-end">
        <label class="block text-sm">
          <span class="font-medium text-charcoal">Date</span>
          <input
            name="workDate"
            type="date"
            required
            value={today}
            class="mt-1.5 w-full rounded-xl border border-sage-dark/15 bg-white px-3 py-2 text-sm text-charcoal"
          />
        </label>
        <label class="block text-sm">
          <span class="font-medium text-charcoal">Hours</span>
          <input
            name="hours"
            type="text"
            inputmode="decimal"
            required
            placeholder="7.5"
            class="mt-1.5 w-full rounded-xl border border-sage-dark/15 bg-white px-3 py-2 text-sm text-charcoal placeholder:text-sage-dark/45"
          />
        </label>
        <label class="block text-sm">
          <span class="font-medium text-charcoal">Notes</span>
          <input
            name="notes"
            type="text"
            maxlength="500"
            placeholder="Optional"
            class="mt-1.5 w-full rounded-xl border border-sage-dark/15 bg-white px-3 py-2 text-sm text-charcoal placeholder:text-sage-dark/45"
          />
        </label>
        <button class="btn-primary !px-4 !py-2" type="submit">Save</button>
      </div>
      <p class="mt-3 text-xs text-sage-dark/55">Use decimals like 7.5 or times like 7:30.</p>
    </form>

    <div class="mt-8">
      <h2 class="text-sm font-semibold text-charcoal">Entries</h2>
      {
        week.entries.length === 0 ? (
          <p class="mt-4 text-sm text-sage-dark/65">No hours logged for this week.</p>
        ) : (
          <div class="mt-4 space-y-3">
            {
              week.entries.map((entry) => {
                const serialized = serializeTimesheetEntry(entry);
                return (
                  <article class="rounded-2xl border border-sage-dark/10 bg-white/80 p-4 shadow-sm">
                    <div class="flex flex-wrap items-start justify-between gap-3">
                      <div>
                        <p class="text-sm font-semibold text-charcoal">{serialized.dateLabel}</p>
                        <p class="mt-1 text-sm text-sage-dark/80">{serialized.hoursLabel}</p>
                        {entry.notes ? (
                          <p class="mt-2 text-sm text-sage-dark/70">{entry.notes}</p>
                        ) : null}
                      </div>
                      <form method="post" action="/api/timesheet/delete" class="contents">
                        <input type="hidden" name="entryId" value={entry.id} />
                        <input type="hidden" name="returnTo" value={`/timesheet?week=${week.start}`} />
                        <button
                          class="rounded-md bg-red-50 px-2.5 py-1 text-[11px] font-semibold text-red-800 ring-1 ring-red-200 transition hover:bg-red-100"
                          type="submit"
                          data-confirm="Remove this entry?"
                        >
                          Remove
                        </button>
                      </form>
                    </div>
                  </article>
                );
              })
            }
          </div>
        )
      }
    </div>
  </section>
</PortalLayout>

<script>
  document.querySelectorAll('[data-confirm]').forEach((button) => {
    if (!(button instanceof HTMLButtonElement)) return;
    const form = button.form;
    if (!(form instanceof HTMLFormElement)) return;
    form.addEventListener('submit', (event) => {
      const message = button.getAttribute('data-confirm');
      if (message && !window.confirm(message)) {
        event.preventDefault();
      }
    });
  });
</script>
