---
import PortalLayout from '../layouts/PortalLayout.astro';
import { hasPermission } from '../lib/permissions';

export const prerender = false;

const employee = Astro.locals.employee!;
const manager = hasPermission(employee, 'apps:management');
---

<PortalLayout title="Resources">
  <h1 class="font-display text-4xl text-charcoal">Employee resources</h1>
  <p class="mt-4 text-sage-dark/75">
    Practice resources for staff. Clinical records, notes, and patient details are not stored here.
  </p>

  <ul class="mt-8 space-y-4">
    <li class="card">
      <h2 class="font-display text-2xl">Public website</h2>
      <p class="mt-2 text-sm text-sage-dark/70">wovensage.com marketing site for clients.</p>
      <a class="mt-3 inline-block text-sm font-medium underline" href="https://wovensage.com" target="_blank" rel="noopener noreferrer">
        Open wovensage.com
      </a>
    </li>
    {
      manager && (
        <li class="card">
          <h2 class="font-display text-2xl">Management resources</h2>
          <p class="mt-2 text-sm text-sage-dark/70">
            Approved management materials will appear here. Placeholder only — no invented documents.
          </p>
        </li>
      )
    }
  </ul>
</PortalLayout>
