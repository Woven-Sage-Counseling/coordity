---
import PortalLayout from '../../layouts/PortalLayout.astro';
import TimesheetPeriodPicker from '../../components/TimesheetPeriodPicker.astro';
import { buildPieSlices, type PieSlicePath } from '../../lib/timesheet-charts';
import { formatWorkDate } from '../../lib/timesheet';
import { getWorkBreakdownByCategory, serializeWorkBreakdown } from '../../lib/timesheet-work-items';
import { resolveTimesheetPeriod } from '../../lib/timesheet-periods';
import { canUseTimesheet } from '../../lib/timesheet-access';

export const prerender = false;

const employee = Astro.locals.employee!;
if (!canUseTimesheet(employee)) {
  return Astro.redirect('/');
}
const period = resolveTimesheetPeriod(Astro.url.searchParams);
const breakdown = await getWorkBreakdownByCategory(employee.id, {
  start: period.start,
  end: period.end,
});
const serialized = serializeWorkBreakdown(breakdown);
const pieSlices: PieSlicePath[] = buildPieSlices(serialized.slices);
const hasData = serialized.slices.length > 0;
---

<PortalLayout title="Work breakdown" wide>
  <p class="text-sm text-sage-dark/65">
    <a href="/" class="hover:text-sage-dark">Home</a>
    <span class="mx-1.5 text-sage-dark/35">/</span>
    <a href="/timesheet" class="hover:text-sage-dark">Timesheet</a>
    <span class="mx-1.5 text-sage-dark/35">/</span>
    Work breakdown
  </p>

  <div class="mt-3 flex flex-wrap items-start justify-between gap-4">
    <div>
      <h1 class="font-display text-4xl text-charcoal sm:text-5xl">Work breakdown</h1>
      <p class="mt-3 max-w-2xl text-sage-dark/75">
        See how often you worked on each category across completed shifts in this period.
      </p>
    </div>
    <a href="/timesheet" class="btn-secondary !px-4 !py-2 text-sm">Back to timesheet</a>
  </div>

  <TimesheetPeriodPicker period={period} action="/timesheet/work" />
  <p class="mt-2 text-sm text-sage-dark/65">
    {formatWorkDate(period.start, { weekday: false })} – {formatWorkDate(period.end, { weekday: false })}
  </p>

  <section class="mt-8 grid gap-6 lg:grid-cols-[minmax(0,18rem)_minmax(0,1fr)]">
    <article class="rounded-2xl border border-sage-dark/10 bg-white/80 p-5 shadow-sm">
      <p class="text-xs font-semibold uppercase tracking-[0.14em] text-sage-dark/55">Logged hours</p>
      <p class="mt-2 text-4xl font-semibold text-charcoal">{serialized.totalHoursLabel}</p>
      <p class="mt-2 text-sm text-sage-dark/70">
        {serialized.taggedShiftCount} shift{serialized.taggedShiftCount === 1 ? '' : 's'} with work items
        {
          serialized.untaggedShiftCount > 0 ? (
            <span> · {serialized.untaggedShiftCount} without items</span>
          ) : null
        }
      </p>
    </article>

    <article class="rounded-2xl border border-sage-dark/10 bg-white/80 p-5 shadow-sm">
      <h2 class="text-sm font-semibold text-charcoal">By category (days worked)</h2>
      {
        hasData && pieSlices.length > 0 ? (
          <div class="mt-4 flex flex-col items-center gap-6 md:flex-row md:items-start">
            <svg viewBox="0 0 220 220" class="h-52 w-52 shrink-0" role="img" aria-label="Work category breakdown chart">
              {
                pieSlices.map((slice) => (
                  <path d={slice.path} fill={slice.color} stroke="#ffffff" stroke-width="1.5">
                    <title>{slice.label}: {slice.hoursLabel} ({slice.percent}%)</title>
                  </path>
                ))
              }
            </svg>
            <ul class="w-full space-y-2">
              {
                pieSlices.map((slice) => (
                  <li class="flex items-center justify-between gap-3 rounded-xl bg-[#f8f9fb] px-3 py-2 text-sm">
                    <span class="flex min-w-0 items-center gap-2 text-charcoal">
                      <span class="size-2.5 shrink-0 rounded-full" style={`background-color: ${slice.color}`} />
                      <span class="truncate">{slice.label}</span>
                    </span>
                    <span class="shrink-0 tabular-nums text-sage-dark/75">
                      {slice.hoursLabel}
                      <span class="ml-2 text-xs text-sage-dark/55">{slice.percent}%</span>
                    </span>
                  </li>
                ))
              }
            </ul>
          </div>
        ) : (
          <p class="mt-4 text-sm text-sage-dark/70">
            No work items in this period. Log shifts on the timesheet and check the categories you worked on each day.
          </p>
        )
      }
    </article>
  </section>
</PortalLayout>
