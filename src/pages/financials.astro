---
import PortalLayout from '../layouts/PortalLayout.astro';
import PeriodPicker from '../components/PeriodPicker.astro';
import { getFinancialSummary, formatUsd } from '../lib/financials/summary';
import { hasPermission } from '../lib/permissions';

export const prerender = false;

const employee = Astro.locals.employee!;
if (!hasPermission(employee, 'financials:view')) {
  return new Response('Forbidden', { status: 403 });
}

const summary = await getFinancialSummary(Astro.url.searchParams);
const snapshot = summary.snapshot;
const canManage = hasPermission(employee, 'financials:manage');
const error = Astro.url.searchParams.get('error');
const lastSync = summary.quickbooks.lastSyncAt
  ? new Date(summary.quickbooks.lastSyncAt).toLocaleString('en-US', { timeZone: 'America/New_York' })
  : null;
---

<PortalLayout title="Financials" wide>
  <p class="text-xs uppercase tracking-[0.2em] text-sage-dark/60">Permission: financials:view</p>
  <h1 class="mt-3 font-display text-4xl text-charcoal sm:text-5xl">Financial dashboard</h1>
  <p class="mt-4 max-w-2xl text-sage-dark/75">
    QuickBooks is the source of truth. Figures below are cash-basis for the selected timeframe.
    Bank balances are current, not tied to the profit and loss dates.
  </p>

  <PeriodPicker period={summary.period} action="/financials" allowCustom />

  {
    snapshot ? (
      <p class="mt-4 text-sm text-sage-dark/65">
        {summary.period.label}: {snapshot.periodStart} through {snapshot.periodEnd} · {snapshot.accountingMethod}{' '}
        basis · source: {snapshot.source === 'quickbooks' ? 'QuickBooks' : 'QuickBooks (manual snapshot)'}
      </p>
    ) : (
      <p class="mt-4 text-sm text-sage-dark/65">No financial snapshot is available yet.</p>
    )
  }

  <section class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    <article class="card">
      <h2 class="text-sm text-sage-dark/60">Revenue</h2>
      <p class="mt-2 font-display text-3xl">{formatUsd(snapshot?.revenueCents ?? null)}</p>
    </article>
    <article class="card">
      <h2 class="text-sm text-sage-dark/60">Therapist compensation</h2>
      <p class="mt-2 font-display text-3xl">{formatUsd(snapshot?.therapistCompensationCents ?? null)}</p>
    </article>
    <article class="card">
      <h2 class="text-sm text-sage-dark/60">Management compensation</h2>
      <p class="mt-2 font-display text-3xl">{formatUsd(snapshot?.managementCompensationCents ?? null)}</p>
    </article>
    <article class="card">
      <h2 class="text-sm text-sage-dark/60">Software and technology</h2>
      <p class="mt-2 font-display text-3xl">{formatUsd(snapshot?.softwareAndTechnologyCents ?? null)}</p>
    </article>
    <article class="card">
      <h2 class="text-sm text-sage-dark/60">Total expenses</h2>
      <p class="mt-2 font-display text-3xl">{formatUsd(snapshot?.totalExpensesCents ?? null)}</p>
    </article>
    <article class="card">
      <h2 class="text-sm text-sage-dark/60">Net income</h2>
      <p class="mt-2 font-display text-3xl">{formatUsd(snapshot?.netIncomeCents ?? null)}</p>
    </article>
  </section>

  <section class="mt-12">
    <h2 class="font-display text-3xl text-charcoal">Cash and reserves</h2>
    <div class="mt-5 grid gap-4 sm:grid-cols-2">
      <article class="card">
        <h3 class="text-sm text-sage-dark/60">Relay operating cash</h3>
        <p class="mt-2 font-display text-3xl">{formatUsd(summary.cash.relayOperatingCents)}</p>
      </article>
      <article class="card">
        <h3 class="text-sm text-sage-dark/60">Bank of America reserve</h3>
        <p class="mt-2 font-display text-3xl">{formatUsd(summary.cash.boaReserveCents)}</p>
      </article>
      <article class="card">
        <h3 class="text-sm text-sage-dark/60">Total cash</h3>
        <p class="mt-2 font-display text-3xl">{formatUsd(summary.totalCashCents)}</p>
      </article>
      <article class="card">
        <h3 class="text-sm text-sage-dark/60">
          Reserve progress ({summary.reserveTargetMonths} months of average revenue)
        </h3>
        <p class="mt-2 font-display text-3xl">
          {
            summary.reserveProgressRatio == null
              ? '—'
              : `${Math.round(summary.reserveProgressRatio * 100)}%`
          }
        </p>
        <p class="mt-2 text-sm text-sage-dark/65">
          Target: {formatUsd(summary.reserveTargetCents)} based on year-to-date average revenue.
          Progress stays blank until cash balances are available.
        </p>
      </article>
    </div>
  </section>

  <section class="card mt-12">
    <h2 class="font-display text-2xl text-charcoal">QuickBooks connection</h2>
    {
      error && (
        <p class="mt-4 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800">{error}</p>
      )
    }
    <p class="mt-2 text-sm text-sage-dark/70">
      Status: {summary.quickbooks.status}
      {' · '}
      {summary.quickbooks.environment}
      {lastSync ? ` · last sync ${lastSync}` : ''}.
      {
        summary.quickbooks.configured
          ? 'OAuth credentials are present on the server.'
          : 'OAuth client ID and secret are not set yet.'
      }
    </p>
    {
      summary.quickbooks.lastError && (
        <p class="mt-2 text-sm text-red-800">{summary.quickbooks.lastError}</p>
      )
    }
    {
      summary.quickbooks.environment === 'sandbox' && (
        <p class="mt-2 text-sm text-sage-dark/65">
          Connected to a <strong>sandbox</strong> company with Development keys. The $86 net income figure is from
          live Woven Sage books — sandbox P&L will not match until you reconnect with Production keys.
        </p>
      )
    }
    {
      canManage && (summary.pnlLines.length > 0 || summary.bankAccounts.length > 0) && (
        <div class="mt-6 border-t border-sage-dark/10 pt-5">
          <h3 class="font-display text-xl text-charcoal">Accounts in this sync</h3>
          {
            summary.bankAccounts.length > 0 && (
              <ul class="mt-3 space-y-1 text-sm text-sage-dark/80">
                {summary.bankAccounts.map((account) => (
                  <li>
                    {account.name}: {formatUsd(account.balanceCents)}{' '}
                    {account.mappedKey === 'relay_operating'
                      ? '→ operating cash'
                      : account.mappedKey === 'boa_reserve'
                        ? '→ reserve'
                        : '→ not mapped'}
                  </li>
                ))}
              </ul>
            )
          }
          {
            summary.pnlLines.length > 0 && (
              <ul class="mt-4 space-y-1 text-sm text-sage-dark/80">
                {summary.pnlLines.map((line) => (
                  <li>
                    {line.name}: {formatUsd(line.cents)}
                    {line.bucket ? ` → ${line.bucket}` : ''}
                  </li>
                ))}
              </ul>
            )
          }
        </div>
      )
    }
    {
      canManage && summary.quickbooks.configured && (
        <div class="mt-4 flex flex-wrap gap-3">
          <form method="post" action="/api/quickbooks/connect">
            <button class="btn-secondary" type="submit">
              {summary.quickbooks.status === 'connected' ? 'Reconnect QuickBooks' : 'Connect QuickBooks'}
            </button>
          </form>
          {
            summary.quickbooks.status === 'connected' || summary.quickbooks.status === 'error' ? (
              <form method="post" action="/api/quickbooks/sync">
                <button class="btn-primary" type="submit">
                  Sync numbers now
                </button>
              </form>
            ) : null
          }
        </div>
      )
    }
  </section>
</PortalLayout>
