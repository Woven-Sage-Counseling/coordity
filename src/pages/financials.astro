---
import PortalLayout from '../layouts/PortalLayout.astro';
import PeriodPicker from '../components/PeriodPicker.astro';
import { calendarDateValue, formatDisplayDate, formatUsd, getFinancialSummary } from '../lib/financials/summary';
import { hasPermission } from '../lib/permissions';

export const prerender = false;

const employee = Astro.locals.employee!;
if (!hasPermission(employee, 'financials:view')) {
  return new Response('Forbidden', { status: 403 });
}

const summary = await getFinancialSummary(Astro.url.searchParams);
const snapshot = summary.snapshot;
const canManage = hasPermission(employee, 'financials:manage');
const error = Astro.url.searchParams.get('error');
const lastSync = summary.quickbooks.lastSyncAt
  ? new Date(summary.quickbooks.lastSyncAt).toLocaleString('en-US', { timeZone: 'America/New_York' })
  : null;

const revenue = snapshot?.revenueCents ?? 0;
const net = snapshot?.netIncomeCents ?? 0;
const therapist = snapshot?.therapistCompensationCents ?? 0;
const management = snapshot?.managementCompensationCents ?? 0;
const software = snapshot?.softwareAndTechnologyCents ?? 0;
const expenses = snapshot?.totalExpensesCents ?? 0;
const scale = Math.max(revenue, therapist, management, software, expenses, 1);
const bar = (cents: number) => `${Math.round((cents / scale) * 100)}%`;
const shareOfIncome = (cents: number) => (revenue > 0 ? `${Math.round((cents / revenue) * 100)}%` : null);
const netPositive = net >= 0;

const ratio = summary.reserveProgressRatio;
const percent = ratio == null ? null : Math.round(ratio * 100);
const ringRatio = ratio == null ? 0 : Math.min(Math.max(ratio, 0), 1);
const ringRadius = 30;
const ringCircumference = 2 * Math.PI * ringRadius;
const ringOffset = ringCircumference * (1 - ringRatio);

const pnlRows = [
  { label: 'Income', cents: revenue, color: '#2CA01C', share: null as string | null },
  { label: 'Therapist income', cents: therapist, color: '#3d8b37', share: shareOfIncome(therapist) },
  { label: 'Management income', cents: management, color: '#6aa84f', share: shareOfIncome(management) },
  { label: 'Software and technology', cents: software, color: '#8fbc8f', share: shareOfIncome(software) },
  { label: 'Total expenses', cents: expenses, color: '#a8c5a0', share: shareOfIncome(expenses) },
];

function bucketLabel(bucket: (typeof summary.pnlLines)[number]['bucket']): string | null {
  if (bucket === 'therapist') return 'Therapist';
  if (bucket === 'management') return 'Management';
  if (bucket === 'software') return 'Software';
  if (bucket === 'other') return 'Other';
  return null;
}

const incomeLines = summary.pnlLines
  .filter((line) => line.bucket === 'income' && line.cents !== 0)
  .sort((a, b) => b.cents - a.cents);

const expenseLines = summary.pnlLines
  .filter((line) => line.bucket !== 'income' && line.cents !== 0)
  .sort((a, b) => Math.abs(b.cents) - Math.abs(a.cents));

const incomeTransactions = summary.transactions
  .filter((transaction) => transaction.bucket === 'income' && transaction.cents !== 0)
  .sort(
    (a, b) =>
      calendarDateValue(b.date) - calendarDateValue(a.date) ||
      Math.abs(b.cents) - Math.abs(a.cents),
  );

const expenseTransactions = summary.transactions
  .filter((transaction) => transaction.bucket !== 'income' && transaction.cents !== 0)
  .sort(
    (a, b) =>
      calendarDateValue(b.date) - calendarDateValue(a.date) ||
      Math.abs(b.cents) - Math.abs(a.cents),
  );

function formatPeriod(iso: string): string {
  return formatDisplayDate(iso) ?? iso;
}

function formatMonthYear(iso: string): string {
  const [year, month] = iso.split('-').map(Number);
  return new Date(Date.UTC(year, month - 1, 1)).toLocaleDateString('en-US', {
    month: 'long',
    year: 'numeric',
    timeZone: 'UTC',
  });
}

function transactionMetaLine(
  transaction: (typeof summary.transactions)[number],
  omitTypes: readonly string[],
): string {
  const omit = new Set(omitTypes.map((value) => value.toLowerCase()));
  const type =
    transaction.type && !omit.has(transaction.type.trim().toLowerCase()) ? transaction.type : null;
  return [formatDisplayDate(transaction.date), transaction.accountName, type].filter(Boolean).join(' · ');
}

const periodLabel = snapshot
  ? `${formatPeriod(snapshot.periodStart)} – ${formatPeriod(snapshot.periodEnd)}`
  : null;
---

<PortalLayout title="Financials" wide>
  <h1 class="font-display text-4xl text-charcoal sm:text-5xl">Financial dashboard</h1>

  <div class="mt-6">
    <PeriodPicker period={summary.period} action="/financials" allowCustom theme="quickbooks" />
  </div>
  {
    periodLabel ? (
      <p class="mt-2 text-sm text-sage-dark/65">{periodLabel}</p>
    ) : (
      <p class="mt-2 text-sm text-sage-dark/65">No financial snapshot is available yet.</p>
    )
  }

  <section class="mt-10" aria-labelledby="overview-heading">
    <h2 id="overview-heading" class="font-display text-2xl text-charcoal">Overview</h2>
    <div class="mt-4 grid gap-4 md:grid-cols-2">
      <article class="rounded-2xl bg-white p-5 shadow-sm ring-1 ring-black/[0.06]">
        <p class="text-xs font-semibold uppercase tracking-[0.14em] text-[#6b6c72]">Net income</p>
        <p
          class:list={[
            'mt-2 text-4xl font-semibold tracking-tight tabular-nums',
            netPositive ? 'text-[#2CA01C]' : 'text-[#d52b1e]',
          ]}
        >
          {formatUsd(snapshot?.netIncomeCents ?? null)}
        </p>
      </article>

      <article class="flex items-center justify-between gap-4 rounded-2xl bg-white p-5 shadow-sm ring-1 ring-black/[0.06]">
        <div class="min-w-0">
          <p class="text-xs font-semibold uppercase tracking-[0.14em] text-[#6b6c72]">Reserve</p>
          <p class="mt-2 text-2xl font-semibold tabular-nums text-charcoal">
            {formatUsd(summary.cash.boaReserveCents)}
          </p>
          <p class="mt-1 text-sm text-[#6b6c72]">
            of {formatUsd(summary.reserveTargetCents)}
          </p>
          <p class="mt-2 text-xs text-[#b0b1b6]">
            {summary.reserveTargetMonths}-month target
            {summary.reserveAveragingStart
              ? ` since ${formatMonthYear(summary.reserveAveragingStart)}`
              : ''}
          </p>
        </div>
        <div
          class="relative h-24 w-24 shrink-0"
          role="img"
          aria-label={percent == null ? 'Reserve progress unavailable' : `Reserve ${percent} percent of target`}
        >
          <svg class="h-full w-full -rotate-90" viewBox="0 0 76 76" aria-hidden="true">
            <circle cx="38" cy="38" r={ringRadius} fill="none" stroke="#e3e5e8" stroke-width="6"></circle>
            <circle
              cx="38"
              cy="38"
              r={ringRadius}
              fill="none"
              stroke={percent != null && percent >= 100 ? '#2CA01C' : '#3d8b37'}
              stroke-width="6"
              stroke-linecap="round"
              stroke-dasharray={ringCircumference.toFixed(2)}
              stroke-dashoffset={ringOffset.toFixed(2)}
            ></circle>
          </svg>
          <p class="absolute inset-0 flex items-center justify-center text-sm font-semibold tabular-nums text-charcoal">
            {percent == null ? '—' : `${percent}%`}
          </p>
        </div>
      </article>
    </div>
  </section>

  <div class="mt-12 grid gap-8 lg:grid-cols-2 lg:items-stretch">
    <section class="flex flex-col" aria-labelledby="pnl-heading">
      <h2 id="pnl-heading" class="font-display text-2xl text-charcoal">Profit and Loss</h2>
      <div class="mt-4 flex flex-1 flex-col rounded-2xl bg-white p-5 shadow-sm ring-1 ring-black/[0.06]">
        <div class="flex flex-1 flex-col justify-between gap-5">
          {
            pnlRows.map((row) => (
              <div>
                <div class="flex items-baseline justify-between gap-3 text-[13px]">
                  <span class="font-medium text-charcoal">{row.label}</span>
                  <span class="flex items-baseline gap-1.5 tabular-nums">
                    <span class="font-semibold text-charcoal">{formatUsd(snapshot ? row.cents : null)}</span>
                    {row.share ? <span class="font-medium text-[#b0b1b6]">{row.share}</span> : null}
                  </span>
                </div>
                <div class="mt-2 h-1.5 overflow-hidden rounded-full bg-[#e3e5e8]">
                  <div
                    class="h-full rounded-full"
                    style={`width: ${snapshot ? bar(row.cents) : '0%'}; background-color: ${row.color}`}
                  ></div>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <section class="flex flex-col" aria-labelledby="cash-heading">
      <h2 id="cash-heading" class="font-display text-2xl text-charcoal">Cash and reserves</h2>
      <div class="mt-4 flex flex-1 flex-col gap-3">
        <article class="rounded-2xl bg-white p-5 shadow-sm ring-1 ring-black/[0.06]">
          <p class="text-xs font-semibold uppercase tracking-[0.14em] text-[#6b6c72]">Relay operating</p>
          <p class="mt-2 text-2xl font-semibold tabular-nums text-charcoal">
            {formatUsd(summary.cash.relayOperatingCents)}
          </p>
        </article>
        <article class="rounded-2xl bg-white p-5 shadow-sm ring-1 ring-black/[0.06]">
          <p class="text-xs font-semibold uppercase tracking-[0.14em] text-[#6b6c72]">Bank of America reserve</p>
          <p class="mt-2 text-2xl font-semibold tabular-nums text-charcoal">
            {formatUsd(summary.cash.boaReserveCents)}
          </p>
        </article>
        <article class="rounded-2xl bg-white p-5 shadow-sm ring-1 ring-black/[0.06]">
          <p class="text-xs font-semibold uppercase tracking-[0.14em] text-[#6b6c72]">Total cash</p>
          <p class="mt-2 text-2xl font-semibold tabular-nums text-charcoal">
            {formatUsd(summary.totalCashCents)}
          </p>
        </article>
      </div>
    </section>
  </div>

  <section class="mt-12" aria-labelledby="detail-heading">
    <h2 id="detail-heading" class="font-display text-2xl text-charcoal">Income and expense transactions</h2>
    <p class="mt-2 text-sm text-sage-dark/65">
      Individual QuickBooks transactions for this period, grouped by income and expense. Sync QuickBooks to refresh the list.
    </p>

    <div class="mt-4 grid gap-8 lg:grid-cols-2 lg:items-start">
      <article class="flex flex-col rounded-2xl bg-white p-5 shadow-sm ring-1 ring-black/[0.06]">
        <h3 class="text-xs font-semibold uppercase tracking-[0.14em] text-[#6b6c72]">Income</h3>
        {
          incomeTransactions.length === 0 ? (
            <p class="mt-4 text-sm text-sage-dark/65">
              No income transactions are available for this period yet.
            </p>
          ) : (
            <div
              class="financials-scroll-panel"
              tabindex="0"
              role="region"
              aria-label="Income transactions"
            >
              <ul class="divide-y divide-black/[0.06]">
                {incomeTransactions.map((transaction) => (
                  <li class="flex items-start justify-between gap-4 py-3 first:pt-0 last:pb-0">
                    <div class="min-w-0">
                      <p class="text-sm font-medium text-charcoal">{transaction.name}</p>
                      <p class="mt-0.5 text-xs text-sage-dark/65">
                        {transactionMetaLine(transaction, ['deposit'])}
                      </p>
                      {
                        transaction.memo && (
                          <p class="mt-1 text-xs text-sage-dark/65">{transaction.memo}</p>
                        )
                      }
                    </div>
                    <div class="shrink-0 text-right">
                      <p class="text-sm font-semibold tabular-nums text-[#2CA01C]">
                        {formatUsd(transaction.cents)}
                      </p>
                      {
                        transaction.docNum && (
                          <p class="mt-0.5 text-[11px] uppercase tracking-wide text-[#b0b1b6]">
                            {transaction.docNum}
                          </p>
                        )
                      }
                    </div>
                  </li>
                ))}
              </ul>
            </div>
          )
        }
      </article>

      <article class="flex flex-col rounded-2xl bg-white p-5 shadow-sm ring-1 ring-black/[0.06]">
        <h3 class="text-xs font-semibold uppercase tracking-[0.14em] text-[#6b6c72]">Expenses</h3>
        {
          expenseTransactions.length === 0 ? (
            <p class="mt-4 text-sm text-sage-dark/65">
              No expense transactions are available for this period yet.
            </p>
          ) : (
            <div
              class="financials-scroll-panel"
              tabindex="0"
              role="region"
              aria-label="Expense transactions"
            >
              <ul class="divide-y divide-black/[0.06]">
                {expenseTransactions.map((transaction) => {
                  const tag = bucketLabel(transaction.bucket);
                  return (
                    <li class="flex items-start justify-between gap-4 py-3 first:pt-0 last:pb-0">
                      <div class="min-w-0">
                        <p class="text-sm font-medium text-charcoal">{transaction.name}</p>
                        <p class="mt-0.5 text-xs text-sage-dark/65">
                          {transactionMetaLine(transaction, ['expense'])}
                        </p>
                        {
                          tag && (
                            <p class="mt-0.5 text-[11px] font-medium uppercase tracking-wide text-[#b0b1b6]">
                              {tag}
                            </p>
                          )
                        }
                        {
                          transaction.memo && (
                            <p class="mt-1 text-xs text-sage-dark/65">{transaction.memo}</p>
                          )
                        }
                      </div>
                      <div class="shrink-0 text-right">
                        <p class="text-sm font-semibold tabular-nums text-charcoal">
                          {formatUsd(Math.abs(transaction.cents))}
                        </p>
                        {
                          transaction.docNum && (
                            <p class="mt-0.5 text-[11px] uppercase tracking-wide text-[#b0b1b6]">
                              {transaction.docNum}
                            </p>
                          )
                        }
                      </div>
                    </li>
                  );
                })}
              </ul>
            </div>
          )
        }
      </article>
    </div>
  </section>

  <section class="mt-12" aria-labelledby="account-detail-heading">
    <h2 id="account-detail-heading" class="font-display text-2xl text-charcoal">Account totals</h2>
    <p class="mt-2 text-sm text-sage-dark/65">
      QuickBooks account-level totals for this period.
    </p>

    <div class="mt-4 grid gap-8 lg:grid-cols-2 lg:items-start">
      <article class="flex flex-col rounded-2xl bg-white p-5 shadow-sm ring-1 ring-black/[0.06]">
        <h3 class="text-xs font-semibold uppercase tracking-[0.14em] text-[#6b6c72]">Income accounts</h3>
        {
          incomeLines.length === 0 ? (
            <p class="mt-4 text-sm text-sage-dark/65">
              No income account totals are available for this period yet.
            </p>
          ) : (
            <div
              class="financials-scroll-panel"
              tabindex="0"
              role="region"
              aria-label="Income account totals"
            >
              <ul class="divide-y divide-black/[0.06]">
                {incomeLines.map((line) => (
                  <li class="flex items-start justify-between gap-4 py-3 first:pt-0 last:pb-0">
                    <span class="min-w-0 text-sm font-medium text-charcoal">{line.name}</span>
                    <span class="shrink-0 text-sm font-semibold tabular-nums text-[#2CA01C]">
                      {formatUsd(line.cents)}
                    </span>
                  </li>
                ))}
              </ul>
            </div>
          )
        }
      </article>

      <article class="flex flex-col rounded-2xl bg-white p-5 shadow-sm ring-1 ring-black/[0.06]">
        <h3 class="text-xs font-semibold uppercase tracking-[0.14em] text-[#6b6c72]">Expense accounts</h3>
        {
          expenseLines.length === 0 ? (
            <p class="mt-4 text-sm text-sage-dark/65">
              No expense account totals are available for this period yet.
            </p>
          ) : (
            <div
              class="financials-scroll-panel"
              tabindex="0"
              role="region"
              aria-label="Expense account totals"
            >
              <ul class="divide-y divide-black/[0.06]">
                {expenseLines.map((line) => {
                  const tag = bucketLabel(line.bucket);
                  return (
                    <li class="flex items-start justify-between gap-4 py-3 first:pt-0 last:pb-0">
                      <div class="min-w-0">
                        <p class="text-sm font-medium text-charcoal">{line.name}</p>
                        {
                          tag && (
                            <p class="mt-0.5 text-[11px] font-medium uppercase tracking-wide text-[#b0b1b6]">
                              {tag}
                            </p>
                          )
                        }
                      </div>
                      <span class="shrink-0 text-sm font-semibold tabular-nums text-charcoal">
                        {formatUsd(Math.abs(line.cents))}
                      </span>
                    </li>
                  );
                })}
              </ul>
            </div>
          )
        }
      </article>
    </div>
  </section>

  <section class="mt-12" aria-labelledby="connection-heading">
    <h2 id="connection-heading" class="font-display text-2xl text-charcoal">QuickBooks connection</h2>
    <div class="mt-4 rounded-2xl bg-white p-5 shadow-sm ring-1 ring-black/[0.06]">
      <div class="flex flex-wrap items-center justify-between gap-2">
        <p class="text-sm text-[#6b6c72]">
          {summary.quickbooks.environment}
          {lastSync ? ` · last sync ${lastSync}` : ''}
        </p>
        <span
          class:list={[
            'rounded-full px-2.5 py-1 text-[11px] font-semibold uppercase tracking-wide ring-1',
            summary.quickbooks.status === 'connected'
              ? 'bg-[#eaf6ea] text-[#2CA01C] ring-[#2CA01C]/25'
              : 'bg-[#f4f5f8] text-[#6b6c72] ring-black/10',
          ]}
        >
          {summary.quickbooks.status}
        </span>
      </div>

      {
        error && (
          <p class="mt-3 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800">{error}</p>
        )
      }

      {
        summary.quickbooks.lastError && (
          <p class="mt-3 text-sm text-red-800">{summary.quickbooks.lastError}</p>
        )
      }

      {
        canManage && summary.quickbooks.configured && (
          <div class="mt-4 flex flex-wrap gap-2">
            <form method="post" action="/api/quickbooks/connect">
              <button
                class="rounded-md bg-white px-3.5 py-2 text-sm font-semibold text-charcoal shadow-sm ring-1 ring-black/[0.1] hover:bg-[#f4f5f8]"
                type="submit"
              >
                {summary.quickbooks.status === 'connected' ? 'Reconnect QuickBooks' : 'Connect QuickBooks'}
              </button>
            </form>
            {(summary.quickbooks.status === 'connected' || summary.quickbooks.status === 'error') && (
              <form method="post" action="/api/quickbooks/sync">
                <button
                  class="rounded-md bg-[#2CA01C] px-3.5 py-2 text-sm font-semibold text-white shadow-sm hover:bg-[#248a18]"
                  type="submit"
                >
                  Sync numbers now
                </button>
              </form>
            )}
          </div>
        )
      }
    </div>
  </section>
</PortalLayout>
