---
import PortalLayout from '../layouts/PortalLayout.astro';
import PeriodPicker from '../components/PeriodPicker.astro';
import { getFinancialSummary, formatUsd } from '../lib/financials/summary';
import { hasPermission } from '../lib/permissions';

export const prerender = false;

const employee = Astro.locals.employee!;
if (!hasPermission(employee, 'financials:view')) {
  return new Response('Forbidden', { status: 403 });
}

const summary = await getFinancialSummary(Astro.url.searchParams);
const snapshot = summary.snapshot;
const canManage = hasPermission(employee, 'financials:manage');
const canViewBooks = hasPermission(employee, 'financials:view');
const error = Astro.url.searchParams.get('error');
const lastSync = summary.quickbooks.lastSyncAt
  ? new Date(summary.quickbooks.lastSyncAt).toLocaleString('en-US', { timeZone: 'America/New_York' })
  : null;

const revenue = snapshot?.revenueCents ?? 0;
const net = snapshot?.netIncomeCents ?? 0;
const therapist = snapshot?.therapistCompensationCents ?? 0;
const management = snapshot?.managementCompensationCents ?? 0;
const software = snapshot?.softwareAndTechnologyCents ?? 0;
const expenses = snapshot?.totalExpensesCents ?? 0;
const scale = Math.max(revenue, therapist, management, software, expenses, 1);
const bar = (cents: number) => `${Math.round((cents / scale) * 100)}%`;
const shareOfIncome = (cents: number) => (revenue > 0 ? Math.round((cents / revenue) * 100) : null);
const netPositive = net >= 0;

const ratio = summary.reserveProgressRatio;
const percent = ratio == null ? null : Math.round(ratio * 100);
const ringRatio = ratio == null ? 0 : Math.min(Math.max(ratio, 0), 1);
const ringRadius = 30;
const ringCircumference = 2 * Math.PI * ringRadius;
const ringOffset = ringCircumference * (1 - ringRatio);

const pnlRows = [
  { label: 'Income', cents: revenue, color: '#2CA01C', share: null as number | null },
  { label: 'Therapist income', cents: therapist, color: '#3d8b37', share: shareOfIncome(therapist) },
  { label: 'Management income', cents: management, color: '#6aa84f', share: shareOfIncome(management) },
  { label: 'Software and technology', cents: software, color: '#8fbc8f', share: shareOfIncome(software) },
  { label: 'Total expenses', cents: expenses, color: '#a8c5a0', share: shareOfIncome(expenses) },
  { label: 'Net income', cents: net, color: netPositive ? '#2CA01C' : '#d52b1e', share: shareOfIncome(net) },
];

function formatPeriod(iso: string): string {
  const [year, month, day] = iso.split('-').map(Number);
  return new Date(Date.UTC(year, month - 1, day)).toLocaleDateString('en-US', {
    month: 'short',
    day: 'numeric',
    year: 'numeric',
    timeZone: 'UTC',
  });
}

function formatMonthYear(iso: string): string {
  const [year, month] = iso.split('-').map(Number);
  return new Date(Date.UTC(year, month - 1, 1)).toLocaleDateString('en-US', {
    month: 'long',
    year: 'numeric',
    timeZone: 'UTC',
  });
}

const periodLabel = snapshot
  ? `${formatPeriod(snapshot.periodStart)} – ${formatPeriod(snapshot.periodEnd)}`
  : 'No snapshot yet';
---

<PortalLayout title="Financials" wide>
  <div class="flex flex-wrap items-start justify-between gap-4">
    <div>
      <p class="text-xs uppercase tracking-[0.2em] text-sage-dark/60">Financials</p>
      <h1 class="mt-3 font-display text-4xl text-charcoal sm:text-5xl">Financial dashboard</h1>
      <p class="mt-3 max-w-2xl text-sage-dark/75">
        QuickBooks is the source of truth. Profit and loss figures are cash-basis for the selected timeframe.
        Bank balances are current and not tied to those dates.
      </p>
    </div>
    <div class="flex flex-wrap items-center gap-2 pt-1">
      <span
        class="inline-flex items-center gap-1.5 rounded-full bg-white px-2.5 py-1 text-[11px] font-semibold text-[#2CA01C] ring-1 ring-[#2CA01C]/25"
      >
        <span
          class="flex h-4 w-4 items-center justify-center rounded-[3px] bg-[#2CA01C] text-[9px] font-black text-white"
          aria-hidden="true"
        >
          q
        </span>
        QuickBooks
      </span>
      <span
        class="rounded-full bg-white px-2.5 py-1 text-[11px] font-semibold uppercase tracking-wide text-[#2CA01C] ring-1 ring-[#2CA01C]/25"
      >
        Cash
      </span>
    </div>
  </div>

  <div class="mt-6 flex flex-wrap items-end gap-4">
    <PeriodPicker period={summary.period} action="/financials" allowCustom theme="quickbooks" />
  </div>
  {
    snapshot ? (
      <p class="mt-2 text-sm text-sage-dark/65">
        {summary.period.label}: {periodLabel} · {snapshot.accountingMethod} basis · source:{' '}
        {snapshot.source === 'quickbooks' ? 'QuickBooks' : 'QuickBooks (manual snapshot)'}
      </p>
    ) : (
      <p class="mt-2 text-sm text-sage-dark/65">No financial snapshot is available yet.</p>
    )
  }

  <!-- Overview -->
  <section class="mt-10" aria-labelledby="overview-heading">
    <h2 id="overview-heading" class="font-display text-2xl text-charcoal">Overview</h2>
    <div class="mt-4 grid gap-4 md:grid-cols-2">
      <article class="rounded-2xl bg-white p-5 shadow-sm ring-1 ring-black/[0.06]">
        <p class="text-xs font-semibold uppercase tracking-[0.14em] text-[#6b6c72]">Net income</p>
        <p
          class:list={[
            'mt-2 text-4xl font-semibold tracking-tight tabular-nums',
            netPositive ? 'text-[#2CA01C]' : 'text-[#d52b1e]',
          ]}
        >
          {formatUsd(snapshot?.netIncomeCents ?? null)}
        </p>
        <p class="mt-2 text-sm text-[#6b6c72]">
          For {summary.period.label.toLowerCase()}
          {snapshot ? ` (${periodLabel})` : ''}.
        </p>
      </article>

      <article class="flex items-center justify-between gap-4 rounded-2xl bg-white p-5 shadow-sm ring-1 ring-black/[0.06]">
        <div class="min-w-0">
          <p class="text-xs font-semibold uppercase tracking-[0.14em] text-[#6b6c72]">Reserve progress</p>
          <p class="mt-2 text-2xl font-semibold tabular-nums text-charcoal">
            {formatUsd(summary.cash.boaReserveCents)}
          </p>
          <p class="mt-1 text-sm text-[#6b6c72]">
            of {formatUsd(summary.reserveTargetCents)} target
          </p>
          <p class="mt-2 text-xs text-[#b0b1b6]">
            {summary.reserveTargetMonths} months of average revenue
            {summary.reserveAveragingStart
              ? ` since ${formatMonthYear(summary.reserveAveragingStart)}`
              : ''}
            . Bank of America only; Relay is excluded.
          </p>
        </div>
        <div
          class="relative h-24 w-24 shrink-0"
          role="img"
          aria-label={percent == null ? 'Reserve progress unavailable' : `Reserve ${percent} percent of target`}
        >
          <svg class="h-full w-full -rotate-90" viewBox="0 0 76 76" aria-hidden="true">
            <circle cx="38" cy="38" r={ringRadius} fill="none" stroke="#e3e5e8" stroke-width="6"></circle>
            <circle
              cx="38"
              cy="38"
              r={ringRadius}
              fill="none"
              stroke={percent != null && percent >= 100 ? '#2CA01C' : '#3d8b37'}
              stroke-width="6"
              stroke-linecap="round"
              stroke-dasharray={ringCircumference.toFixed(2)}
              stroke-dashoffset={ringOffset.toFixed(2)}
            ></circle>
          </svg>
          <p class="absolute inset-0 flex items-center justify-center text-sm font-semibold tabular-nums text-charcoal">
            {percent == null ? '—' : `${percent}%`}
          </p>
        </div>
      </article>
    </div>
  </section>

  <!-- Profit and Loss -->
  <section class="mt-12" aria-labelledby="pnl-heading">
    <div class="flex flex-wrap items-end justify-between gap-2">
      <div>
        <h2 id="pnl-heading" class="font-display text-2xl text-charcoal">Profit and Loss</h2>
        <p class="mt-1 text-sm text-sage-dark/65">Cash-basis summary for the selected timeframe.</p>
      </div>
    </div>

    <div class="mt-4 grid gap-6 lg:grid-cols-[minmax(0,22rem)_minmax(0,1fr)] lg:items-start">
      <div class="rounded-2xl bg-white p-5 shadow-sm ring-1 ring-black/[0.06]">
        <p class="text-xs font-semibold uppercase tracking-[0.14em] text-[#6b6c72]">Relative scale</p>
        <div class="mt-4 space-y-3.5">
          {
            pnlRows
              .filter((row) => row.label !== 'Net income')
              .map((row) => (
                <div>
                  <div class="flex items-baseline justify-between gap-3 text-[13px]">
                    <span class="font-medium text-charcoal">{row.label}</span>
                    <span class="font-semibold tabular-nums text-charcoal">
                      {formatUsd(snapshot ? row.cents : null)}
                    </span>
                  </div>
                  <div class="mt-1.5 h-1.5 overflow-hidden rounded-full bg-[#e3e5e8]">
                    <div
                      class="h-full rounded-full"
                      style={`width: ${snapshot ? bar(row.cents) : '0%'}; background-color: ${row.color}`}
                    ></div>
                  </div>
                </div>
              ))
          }
        </div>
      </div>

      <div class="overflow-hidden rounded-2xl bg-white shadow-sm ring-1 ring-black/[0.06]">
        <table class="w-full text-left text-sm">
          <thead class="border-b border-black/[0.06] bg-[#f4f5f8] text-[11px] uppercase tracking-[0.12em] text-[#6b6c72]">
            <tr>
              <th class="px-4 py-3 font-semibold">Line</th>
              <th class="px-4 py-3 text-right font-semibold">Amount</th>
              <th class="px-4 py-3 text-right font-semibold">% of income</th>
            </tr>
          </thead>
          <tbody>
            {
              pnlRows.map((row) => (
                <tr class="border-b border-black/[0.05] last:border-0">
                  <td class="px-4 py-3 font-medium text-charcoal">{row.label}</td>
                  <td
                    class:list={[
                      'px-4 py-3 text-right tabular-nums font-semibold',
                      row.label === 'Net income'
                        ? netPositive
                          ? 'text-[#2CA01C]'
                          : 'text-[#d52b1e]'
                        : 'text-charcoal',
                    ]}
                  >
                    {formatUsd(snapshot ? row.cents : null)}
                  </td>
                  <td class="px-4 py-3 text-right tabular-nums text-[#6b6c72]">
                    {row.share == null ? (row.label === 'Income' ? '100%' : '—') : `${row.share}%`}
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- Cash and reserves -->
  <section class="mt-12" aria-labelledby="cash-heading">
    <h2 id="cash-heading" class="font-display text-2xl text-charcoal">Cash and reserves</h2>
    <p class="mt-1 text-sm text-sage-dark/65">
      Current balances from QuickBooks. Reserve progress uses Bank of America only.
    </p>
    <div class="mt-4 grid gap-4 sm:grid-cols-3">
      <article class="rounded-2xl bg-white p-5 shadow-sm ring-1 ring-black/[0.06]">
        <p class="text-xs font-semibold uppercase tracking-[0.14em] text-[#6b6c72]">Relay operating</p>
        <p class="mt-2 text-2xl font-semibold tabular-nums text-charcoal">
          {formatUsd(summary.cash.relayOperatingCents)}
        </p>
        <p class="mt-2 text-sm text-[#6b6c72]">
          Revolving operating cash. Not counted toward the reserve target.
        </p>
      </article>
      <article class="rounded-2xl bg-white p-5 shadow-sm ring-1 ring-black/[0.06]">
        <p class="text-xs font-semibold uppercase tracking-[0.14em] text-[#6b6c72]">Bank of America reserve</p>
        <p class="mt-2 text-2xl font-semibold tabular-nums text-charcoal">
          {formatUsd(summary.cash.boaReserveCents)}
        </p>
        <p class="mt-2 text-sm text-[#6b6c72]">This account is the practice cash reserve.</p>
      </article>
      <article class="rounded-2xl bg-white p-5 shadow-sm ring-1 ring-black/[0.06]">
        <p class="text-xs font-semibold uppercase tracking-[0.14em] text-[#6b6c72]">Total cash</p>
        <p class="mt-2 text-2xl font-semibold tabular-nums text-charcoal">
          {formatUsd(summary.totalCashCents)}
        </p>
        <p class="mt-2 text-sm text-[#6b6c72]">Relay + Bank of America combined.</p>
      </article>
    </div>
  </section>

  <!-- Sync details -->
  {
    canViewBooks && (summary.pnlLines.length > 0 || summary.bankAccounts.length > 0) && (
      <section class="mt-12" aria-labelledby="sync-heading">
        <h2 id="sync-heading" class="font-display text-2xl text-charcoal">Accounts in this sync</h2>
        <p class="mt-1 text-sm text-sage-dark/65">
          Raw QuickBooks lines and how they map into the dashboard.
        </p>

        <div class="mt-4 grid gap-4 lg:grid-cols-2">
          {summary.bankAccounts.length > 0 && (
            <div class="overflow-hidden rounded-2xl bg-white shadow-sm ring-1 ring-black/[0.06]">
              <div class="border-b border-black/[0.06] bg-[#f4f5f8] px-4 py-3">
                <p class="text-xs font-semibold uppercase tracking-[0.14em] text-[#6b6c72]">Bank accounts</p>
              </div>
              <table class="w-full text-left text-sm">
                <thead class="border-b border-black/[0.05] text-[11px] uppercase tracking-[0.12em] text-[#6b6c72]">
                  <tr>
                    <th class="px-4 py-2.5 font-semibold">Account</th>
                    <th class="px-4 py-2.5 text-right font-semibold">Balance</th>
                    <th class="px-4 py-2.5 font-semibold">Mapped to</th>
                  </tr>
                </thead>
                <tbody>
                  {summary.bankAccounts.map((account) => (
                    <tr class="border-b border-black/[0.05] last:border-0">
                      <td class="px-4 py-3 font-medium text-charcoal">{account.name}</td>
                      <td class="px-4 py-3 text-right tabular-nums text-charcoal">
                        {formatUsd(account.balanceCents)}
                      </td>
                      <td class="px-4 py-3 text-[#6b6c72]">
                        {account.mappedKey === 'relay_operating'
                          ? 'Operating cash'
                          : account.mappedKey === 'boa_reserve'
                            ? 'Reserve'
                            : 'Not mapped'}
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )}

          {summary.pnlLines.length > 0 && (
            <div class="overflow-hidden rounded-2xl bg-white shadow-sm ring-1 ring-black/[0.06]">
              <div class="border-b border-black/[0.06] bg-[#f4f5f8] px-4 py-3">
                <p class="text-xs font-semibold uppercase tracking-[0.14em] text-[#6b6c72]">P&L lines</p>
              </div>
              <table class="w-full text-left text-sm">
                <thead class="border-b border-black/[0.05] text-[11px] uppercase tracking-[0.12em] text-[#6b6c72]">
                  <tr>
                    <th class="px-4 py-2.5 font-semibold">Line</th>
                    <th class="px-4 py-2.5 text-right font-semibold">Amount</th>
                    <th class="px-4 py-2.5 font-semibold">Bucket</th>
                  </tr>
                </thead>
                <tbody>
                  {summary.pnlLines.map((line) => (
                    <tr class="border-b border-black/[0.05] last:border-0">
                      <td class="px-4 py-3 font-medium text-charcoal">{line.name}</td>
                      <td class="px-4 py-3 text-right tabular-nums text-charcoal">{formatUsd(line.cents)}</td>
                      <td class="px-4 py-3 text-[#6b6c72]">{line.bucket || '—'}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )}
        </div>
      </section>
    )
  }

  <!-- Connection -->
  <section class="mt-12" aria-labelledby="connection-heading">
    <h2 id="connection-heading" class="font-display text-2xl text-charcoal">QuickBooks connection</h2>
    <div class="mt-4 rounded-2xl bg-white p-5 shadow-sm ring-1 ring-black/[0.06]">
      <div class="flex flex-wrap items-center justify-between gap-2">
        <p class="text-sm text-[#6b6c72]">
          Environment: <span class="font-medium text-charcoal">{summary.quickbooks.environment}</span>
          {lastSync ? ` · last sync ${lastSync}` : ''}
        </p>
        <span
          class:list={[
            'rounded-full px-2.5 py-1 text-[11px] font-semibold uppercase tracking-wide ring-1',
            summary.quickbooks.status === 'connected'
              ? 'bg-[#eaf6ea] text-[#2CA01C] ring-[#2CA01C]/25'
              : 'bg-[#f4f5f8] text-[#6b6c72] ring-black/10',
          ]}
        >
          {summary.quickbooks.status}
        </span>
      </div>

      {
        error && (
          <p class="mt-3 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800">{error}</p>
        )
      }

      <p class="mt-3 text-sm text-[#6b6c72]">
        {summary.quickbooks.configured
          ? 'OAuth credentials are present on the server.'
          : 'OAuth client ID and secret are not set yet.'}
      </p>

      {
        summary.quickbooks.lastError && (
          <p class="mt-2 text-sm text-red-800">{summary.quickbooks.lastError}</p>
        )
      }

      {
        summary.quickbooks.environment === 'sandbox' && (
          <p class="mt-2 text-sm text-[#6b6c72]">
            Connected to a <strong class="font-semibold text-charcoal">sandbox</strong> company with Development
            keys. Live books will not match until you reconnect with Production keys.
          </p>
        )
      }

      {
        canManage && summary.quickbooks.configured && (
          <div class="mt-4 flex flex-wrap gap-2">
            <form method="post" action="/api/quickbooks/connect">
              <button
                class="rounded-md bg-white px-3.5 py-2 text-sm font-semibold text-charcoal shadow-sm ring-1 ring-black/[0.1] hover:bg-[#f4f5f8]"
                type="submit"
              >
                {summary.quickbooks.status === 'connected' ? 'Reconnect QuickBooks' : 'Connect QuickBooks'}
              </button>
            </form>
            {(summary.quickbooks.status === 'connected' || summary.quickbooks.status === 'error') && (
              <form method="post" action="/api/quickbooks/sync">
                <button
                  class="rounded-md bg-[#2CA01C] px-3.5 py-2 text-sm font-semibold text-white shadow-sm hover:bg-[#248a18]"
                  type="submit"
                >
                  Sync numbers now
                </button>
              </form>
            )}
          </div>
        )
      }
    </div>
  </section>
</PortalLayout>
