---
import PortalLayout from '../layouts/PortalLayout.astro';
import PeriodPicker from '../components/PeriodPicker.astro';
import FinancialScrollPanel from '../components/FinancialScrollPanel.astro';
import FinancialTransactionItem from '../components/FinancialTransactionItem.astro';
import { QuickBooksProvider, type ChartAccountChoice } from '../lib/financials/quickbooks';
import { periodQuery } from '../lib/financials/periods';
import { calendarDateValue, formatDisplayDate, formatUsd, getFinancialSummary } from '../lib/financials/summary';
import { orgIdFromLocals } from '../lib/organization';
import { getFinancialOutlook, normalizeMatchName, type OutlookLine } from '../lib/financials/outlook';
import { hasPermission } from '../lib/permissions';

export const prerender = false;

const employee = Astro.locals.employee!;
if (!hasPermission(employee, 'financials:view')) {
  return new Response('Forbidden', { status: 403 });
}

const orgId = orgIdFromLocals(Astro.locals.organization);
const summary = await getFinancialSummary(Astro.url.searchParams, { orgId });
const snapshot = summary.snapshot;
const canManage = hasPermission(employee, 'financials:manage');
const outlookOpen = canManage && summary.quickbooks.status === 'connected';
const outlook = outlookOpen ? await getFinancialOutlook(orgId) : null;
const outlookLines: OutlookLine[] = outlook?.lines ?? [];
let chartAccounts: ChartAccountChoice[] = [];
let accountsError: string | null = null;
if (outlookOpen && Astro.url.searchParams.get('accounts') === '1') {
  try {
    chartAccounts = await new QuickBooksProvider(orgId).listChartAccounts();
  } catch (loadError) {
    accountsError = loadError instanceof Error ? loadError.message : 'Could not load QuickBooks accounts.';
  }
}
const expenseAccounts = chartAccounts.filter((account) => account.accountType === 'expense');
const bankAccounts = chartAccounts.filter((account) => account.accountType === 'bank');
const error = Astro.url.searchParams.get('error');
const lastSync = summary.quickbooks.lastSyncAt
  ? new Date(summary.quickbooks.lastSyncAt).toLocaleString('en-US', { timeZone: 'America/New_York' })
  : null;

const revenue = snapshot?.revenueCents ?? 0;
const net = summary.reportedNetCents ?? 0;
const expenses = summary.reportedExpensesCents ?? 0;
const linePalette = ['#3d8b37', '#6aa84f', '#8fbc8f', '#a8c5a0'];
const scale = Math.max(revenue, expenses, ...summary.expenseLines.map((line) => line.cents ?? 0), 1);
const bar = (cents: number) => `${Math.round((cents / scale) * 100)}%`;
const shareOfIncome = (cents: number) => (revenue > 0 ? `${Math.round((cents / revenue) * 100)}%` : null);
const netPositive = net >= 0;

const ratio = summary.reserveProgressRatio;
const percent = ratio == null ? null : Math.round(ratio * 100);
const ringRatio = ratio == null ? 0 : Math.min(Math.max(ratio, 0), 1);
const ringRadius = 30;
const ringCircumference = 2 * Math.PI * ringRadius;
const ringOffset = ringCircumference * (1 - ringRatio);

const pnlRows = [
  { label: 'Income', cents: revenue, color: '#2CA01C', share: null as string | null, showBar: false },
  ...summary.expenseLines.map((line, index) => ({
    label: line.label,
    cents: line.cents ?? 0,
    color: line.color || linePalette[index % linePalette.length],
    share: shareOfIncome(line.cents ?? 0),
    showBar: true,
  })),
  {
    label: 'Total expenses',
    cents: expenses,
    color: '#a8c5a0',
    share: shareOfIncome(expenses),
    showBar: summary.expenseLines.length === 0,
  },
];
const reserveLine = summary.cashLines.find((line) => line.role === 'reserve') ?? null;
const accountsHref = `${periodQuery(summary.period)}${periodQuery(summary.period) ? '&' : '?'}accounts=1#outlook`;

const incomeTransactions = summary.transactions
  .filter((transaction) => transaction.bucket === 'income' && transaction.cents !== 0)
  .sort(
    (a, b) =>
      calendarDateValue(b.date) - calendarDateValue(a.date) ||
      Math.abs(b.cents) - Math.abs(a.cents),
  );

const expenseTransactions = summary.transactions
  .filter((transaction) => transaction.bucket !== 'income' && transaction.cents !== 0)
  .sort(
    (a, b) =>
      calendarDateValue(b.date) - calendarDateValue(a.date) ||
      Math.abs(b.cents) - Math.abs(a.cents),
  );

function formatPeriod(iso: string): string {
  return formatDisplayDate(iso) ?? iso;
}

function formatMonthYear(iso: string): string {
  const [year, month] = iso.split('-').map(Number);
  return new Date(Date.UTC(year, month - 1, 1)).toLocaleDateString('en-US', {
    month: 'long',
    year: 'numeric',
    timeZone: 'UTC',
  });
}

function transactionMetaLine(
  transaction: (typeof summary.transactions)[number],
  omitTypes: readonly string[],
): string {
  const omit = new Set(omitTypes.map((value) => value.toLowerCase()));
  const type =
    transaction.type && !omit.has(transaction.type.trim().toLowerCase()) ? transaction.type : null;
  return [formatDisplayDate(transaction.date), type].filter(Boolean).join(' · ');
}

const periodLabel = snapshot
  ? `${formatPeriod(snapshot.periodStart)} – ${formatPeriod(snapshot.periodEnd)}`
  : null;
const connectionError = error ?? summary.quickbooks.lastError;
const needsReconnect =
  summary.quickbooks.status === 'disconnected' ||
  (connectionError?.toLowerCase().includes('reconnect quickbooks') ?? false);
---

<PortalLayout title="Financials" wide>
  <h1 class="font-display text-4xl text-charcoal sm:text-5xl">Financial dashboard</h1>

  <div class="mt-6">
    <PeriodPicker period={summary.period} action="/financials" allowCustom theme="quickbooks" />
  </div>
  {
    periodLabel ? (
      <p class="mt-2 text-sm text-sage-dark/65">{periodLabel}</p>
    ) : (
      <p class="mt-2 text-sm text-sage-dark/65">No financial snapshot is available yet.</p>
    )
  }

  <section class="mt-10" aria-labelledby="overview-heading">
    <h2 id="overview-heading" class="font-display text-2xl text-charcoal">Overview</h2>
    <div class:list={['mt-4 grid gap-4', reserveLine && 'md:grid-cols-2']}>
      <article class="rounded-2xl bg-white p-5 shadow-sm ring-1 ring-black/[0.06]">
        <p class="text-xs font-semibold uppercase tracking-[0.14em] text-[#6b6c72]">Net income</p>
        <p
          class:list={[
            'mt-2 text-4xl font-semibold tracking-tight tabular-nums',
            netPositive ? 'text-[#2CA01C]' : 'text-[#d52b1e]',
          ]}
        >
          {formatUsd(snapshot ? net : null)}
        </p>
      </article>

      {reserveLine && (
      <article class="flex items-center justify-between gap-4 rounded-2xl bg-white p-5 shadow-sm ring-1 ring-black/[0.06]">
        <div class="min-w-0">
          <p class="text-xs font-semibold uppercase tracking-[0.14em] text-[#6b6c72]">Reserve</p>
          <p class="mt-2 text-2xl font-semibold tabular-nums text-charcoal">
            {formatUsd(summary.reserveCents)}
          </p>
          <p class="mt-1 text-sm text-[#6b6c72]">
            of {formatUsd(summary.reserveTargetCents)}
          </p>
          <p class="mt-2 text-xs text-[#b0b1b6]">
            {summary.reserveTargetMonths}-month target
            {summary.reserveAveragingStart
              ? ` since ${formatMonthYear(summary.reserveAveragingStart)}`
              : ''}
          </p>
        </div>
        <div
          class="relative h-24 w-24 shrink-0"
          role="img"
          aria-label={percent == null ? 'Reserve progress unavailable' : `Reserve ${percent} percent of target`}
        >
          <svg class="h-full w-full -rotate-90" viewBox="0 0 76 76" aria-hidden="true">
            <circle cx="38" cy="38" r={ringRadius} fill="none" stroke="#e3e5e8" stroke-width="6"></circle>
            <circle
              cx="38"
              cy="38"
              r={ringRadius}
              fill="none"
              stroke={percent != null && percent >= 100 ? '#2CA01C' : '#3d8b37'}
              stroke-width="6"
              stroke-linecap="round"
              stroke-dasharray={ringCircumference.toFixed(2)}
              stroke-dashoffset={ringOffset.toFixed(2)}
            ></circle>
          </svg>
          <p class="absolute inset-0 flex items-center justify-center text-sm font-semibold tabular-nums text-charcoal">
            {percent == null ? '—' : `${percent}%`}
          </p>
        </div>
      </article>
      )}
    </div>
  </section>

  <div class:list={['mt-12 grid gap-8 lg:items-stretch', summary.cashLines.length > 0 && 'lg:grid-cols-2']}>
    <section class="flex flex-col" aria-labelledby="pnl-heading">
      <h2 id="pnl-heading" class="font-display text-2xl text-charcoal">Profit and Loss</h2>
      <div class="mt-4 flex flex-1 flex-col rounded-2xl bg-white p-5 shadow-sm ring-1 ring-black/[0.06]">
        <div class="flex flex-1 flex-col justify-between gap-5">
          {
            pnlRows.map((row) => (
              <div>
                <div class="flex items-baseline justify-between gap-3 text-[13px]">
                  <span class="font-medium text-charcoal">{row.label}</span>
                  <span class="flex items-baseline gap-1.5 tabular-nums">
                    <span class="font-semibold text-charcoal">{formatUsd(snapshot ? row.cents : null)}</span>
                    {row.share ? <span class="font-medium text-[#b0b1b6]">{row.share}</span> : null}
                  </span>
                </div>
                {
                  row.showBar && (
                    <div class="mt-2 h-1.5 overflow-hidden rounded-full bg-[#e3e5e8]">
                      <div
                        class="h-full rounded-full"
                        style={`width: ${snapshot ? bar(row.cents) : '0%'}; background-color: ${row.color}`}
                      ></div>
                    </div>
                  )
                }
              </div>
            ))
          }
        </div>
      </div>
    </section>

    {
      summary.cashLines.length > 0 && (
        <section class="flex flex-col" aria-labelledby="cash-heading">
          <h2 id="cash-heading" class="font-display text-2xl text-charcoal">Cash and reserves</h2>
          <div class="mt-4 flex flex-1 flex-col gap-3">
            {summary.cashLines.map((line) => (
              <article class="rounded-2xl bg-white p-5 shadow-sm ring-1 ring-black/[0.06]">
                <p class="text-xs font-semibold uppercase tracking-[0.14em] text-[#6b6c72]">{line.label}</p>
                <p class="mt-2 text-2xl font-semibold tabular-nums text-charcoal">{formatUsd(line.cents)}</p>
              </article>
            ))}
            <article class="rounded-2xl bg-white p-5 shadow-sm ring-1 ring-black/[0.06]">
              <p class="text-xs font-semibold uppercase tracking-[0.14em] text-[#6b6c72]">Total cash</p>
              <p class="mt-2 text-2xl font-semibold tabular-nums text-charcoal">{formatUsd(summary.totalCashCents)}</p>
            </article>
          </div>
        </section>
      )
    }
  </div>

  {
    outlookOpen && (
      <section class="mt-12" id="outlook" aria-labelledby="outlook-heading">
        <h2 id="outlook-heading" class="font-display text-2xl text-charcoal">Outlook</h2>
        <p class="mt-2 max-w-2xl text-sm text-sage-dark/70">
          Choose which QuickBooks accounts roll into each expense group and cash account. Until you save groups, the dashboard keeps the full QuickBooks income, expenses, and net income.
        </p>
        <form method="post" action="/api/financials/outlook" class="mt-4 rounded-2xl bg-white p-5 shadow-sm ring-1 ring-black/[0.06]">
          {chartAccounts.length > 0 && <input type="hidden" name="accountsLoaded" value="1" />}
          <input type="hidden" name="period" value={summary.period.id} />
          <input type="hidden" name="start" value={summary.period.start} />
          <input type="hidden" name="end" value={summary.period.end} />

          <div class="grid gap-3 sm:grid-cols-2">
            <label class="block text-sm text-charcoal">
              Reserve target (months)
              <input class="field" type="number" name="reserveTargetMonths" min="1" max="24" required value={summary.reserveTargetMonths} />
            </label>
            <label class="block text-sm text-charcoal">
              Averaging starts
              <input class="field" type="date" name="operationsStart" value={outlook?.operationsStart ?? ''} />
            </label>
          </div>
          <p class="mt-1 text-[11px] text-sage-dark/55">Leave the date empty to average across the whole reporting period. The reserve ring appears after you mark one cash account as the reserve.</p>

          {
            outlookLines.filter((line) => line.kind === 'expense').map((line) => (
              <fieldset class="mt-5 rounded-xl border border-black/[0.08] p-3">
                <legend class="px-1 text-xs font-semibold uppercase tracking-[0.14em] text-[#6b6c72]">Expense group</legend>
                <input type="hidden" name="lineId" value={line.id} />
                <input type="hidden" name="lineKind" value="expense" />
                <input type="hidden" name="lineRole" value="expense" />
                <div class="grid gap-2 sm:grid-cols-[1fr_auto]">
                  <input class="field" type="text" name="lineLabel" required value={line.label} aria-label="Expense group name" />
                  <input class="field h-11 w-16" type="color" name="lineColor" value={line.color || '#3d8b37'} aria-label="Bar color" />
                </div>
                <label class="mt-2 inline-flex items-center gap-2 text-sm text-charcoal">
                  <input type="checkbox" name="remove" value={line.id} />
                  Remove
                </label>
                {chartAccounts.length > 0 && (
                  <div class="mt-3 grid gap-1 sm:grid-cols-2">
                    {expenseAccounts.map((account) => (
                      <label class="inline-flex items-center gap-2 text-sm text-charcoal">
                        <input
                          type="checkbox"
                          name="lineAccount"
                          value={`${line.id}\t${account.id}\t${normalizeMatchName(account.name)}`}
                          checked={line.accounts.some((saved) => saved.qbAccountId === account.id || saved.matchName === normalizeMatchName(account.name))}
                        />
                        {account.name}
                      </label>
                    ))}
                  </div>
                )}
                {chartAccounts.length === 0 && (
                  <label class="mt-2 block text-sm text-charcoal">
                    Account names, one per line
                    <textarea class="field min-h-16" name="lineTyped" placeholder="Software and technology">{line.accounts.map((account) => account.matchName).join('\n')}</textarea>
                  </label>
                )}
              </fieldset>
            ))
          }

          {
            outlookLines.filter((line) => line.kind === 'cash').map((line) => (
              <fieldset class="mt-5 rounded-xl border border-black/[0.08] p-3">
                <legend class="px-1 text-xs font-semibold uppercase tracking-[0.14em] text-[#6b6c72]">Cash account</legend>
                <input type="hidden" name="lineId" value={line.id} />
                <input type="hidden" name="lineKind" value="cash" />
                <div class="grid gap-2 sm:grid-cols-[1fr_auto]">
                  <input class="field" type="text" name="lineLabel" required value={line.label} aria-label="Cash account name" />
                  <select class="field" name="lineRole" aria-label="Cash role">
                    <option value="operating" selected={line.role === 'operating'}>Operating</option>
                    <option value="reserve" selected={line.role === 'reserve'}>Reserve</option>
                  </select>
                </div>
                <input type="hidden" name="lineColor" value={line.color || '#3d8b37'} />
                <label class="mt-2 inline-flex items-center gap-2 text-sm text-charcoal">
                  <input type="checkbox" name="remove" value={line.id} />
                  Remove
                </label>
                {chartAccounts.length > 0 && (
                  <div class="mt-3 grid gap-1 sm:grid-cols-2">
                    {bankAccounts.map((account) => (
                      <label class="inline-flex items-center gap-2 text-sm text-charcoal">
                        <input
                          type="checkbox"
                          name="lineAccount"
                          value={`${line.id}\t${account.id}\t${normalizeMatchName(account.name)}`}
                          checked={line.accounts.some((saved) => saved.qbAccountId === account.id || saved.matchName === normalizeMatchName(account.name) || (account.accountNumber != null && saved.matchName === normalizeMatchName(account.accountNumber)))}
                        />
                        {account.name}
                      </label>
                    ))}
                  </div>
                )}
                {chartAccounts.length === 0 && (
                  <label class="mt-2 block text-sm text-charcoal">
                    Account names or numbers, one per line
                    <textarea class="field min-h-16" name="lineTyped">{line.accounts.map((account) => account.matchName).join('\n')}</textarea>
                  </label>
                )}
              </fieldset>
            ))
          }

          <fieldset class="mt-5 rounded-xl border border-dashed border-sage-dark/30 p-3">
            <legend class="px-1 text-xs font-semibold uppercase tracking-[0.14em] text-[#6b6c72]">Add expense group</legend>
            <div class="grid gap-2 sm:grid-cols-[1fr_auto]">
              <input class="field" type="text" name="newExpenseLabel" placeholder="Group name" aria-label="New expense group name" />
              <input class="field h-11 w-16" type="color" name="newExpenseColor" value="#3d8b37" aria-label="New group color" />
            </div>
            {expenseAccounts.length > 0 && (
              <div class="mt-3 grid gap-1 sm:grid-cols-2">
                {expenseAccounts.map((account) => (
                  <label class="inline-flex items-center gap-2 text-sm text-charcoal">
                    <input type="checkbox" name="newExpenseAccount" value={`${account.id}\t${normalizeMatchName(account.name)}`} />
                    {account.name}
                  </label>
                ))}
              </div>
            )}
            <label class="mt-2 block text-sm text-charcoal">
              Account names, one per line
              <textarea class="field min-h-16" name="newExpenseTyped"></textarea>
            </label>
          </fieldset>

          <fieldset class="mt-5 rounded-xl border border-dashed border-sage-dark/30 p-3">
            <legend class="px-1 text-xs font-semibold uppercase tracking-[0.14em] text-[#6b6c72]">Add cash account</legend>
            <div class="grid gap-2 sm:grid-cols-[1fr_auto]">
              <input class="field" type="text" name="newCashLabel" placeholder="Account name" aria-label="New cash account name" />
              <select class="field" name="newCashRole" aria-label="New cash role">
                <option value="operating">Operating</option>
                <option value="reserve">Reserve</option>
              </select>
            </div>
            {bankAccounts.length > 0 && (
              <div class="mt-3 grid gap-1 sm:grid-cols-2">
                {bankAccounts.map((account) => (
                  <label class="inline-flex items-center gap-2 text-sm text-charcoal">
                    <input type="checkbox" name="newCashAccount" value={`${account.id}\t${normalizeMatchName(`${account.name} ${account.accountNumber ?? ''}`)}`} />
                    {account.name}
                  </label>
                ))}
              </div>
            )}
            <label class="mt-2 block text-sm text-charcoal">
              Account names or numbers, one per line
              <textarea class="field min-h-16" name="newCashTyped"></textarea>
            </label>
          </fieldset>

          {accountsError && <p class="mt-3 text-sm text-red-800">{accountsError}</p>}

          <div class="mt-4 flex flex-wrap gap-2">
            <a class="rounded-md bg-white px-3.5 py-2 text-sm font-semibold text-charcoal shadow-sm ring-1 ring-black/[0.1] hover:bg-[#f4f5f8]" href={accountsHref}>
              Load accounts from QuickBooks
            </a>
            <button class="rounded-md bg-[#2CA01C] px-3.5 py-2 text-sm font-semibold text-white shadow-sm hover:bg-[#248a18]" type="submit">
              Save outlook
            </button>
          </div>
        </form>
      </section>
    )
  }

  <section class="mt-12" aria-labelledby="detail-heading">
    <h2 id="detail-heading" class="font-display text-2xl text-charcoal">Income and expense transactions</h2>

    <div class="mt-4 grid gap-8 lg:grid-cols-2 lg:items-start">
      <article class="flex flex-col rounded-2xl bg-white p-5 shadow-sm ring-1 ring-black/[0.06]">
        <h3 class="text-xs font-semibold uppercase tracking-[0.14em] text-[#6b6c72]">Income</h3>
        {
          incomeTransactions.length === 0 ? (
            <p class="mt-4 text-sm text-sage-dark/65">
              No income transactions are available for this period yet.
            </p>
          ) : (
            <FinancialScrollPanel ariaLabel="Income transactions">
              <ul class="divide-y divide-black/[0.06]">
                {incomeTransactions.map((transaction) => (
                  <FinancialTransactionItem
                    transaction={transaction}
                    metaLine={transactionMetaLine(transaction, ['deposit'])}
                    amountClass="text-[#2CA01C]"
                  />
                ))}
              </ul>
            </FinancialScrollPanel>
          )
        }
      </article>

      <article class="flex flex-col rounded-2xl bg-white p-5 shadow-sm ring-1 ring-black/[0.06]">
        <h3 class="text-xs font-semibold uppercase tracking-[0.14em] text-[#6b6c72]">Expenses</h3>
        {
          expenseTransactions.length === 0 ? (
            <p class="mt-4 text-sm text-sage-dark/65">
              No expense transactions are available for this period yet.
            </p>
          ) : (
            <FinancialScrollPanel ariaLabel="Expense transactions">
              <ul class="divide-y divide-black/[0.06]">
                {expenseTransactions.map((transaction) => (
                  <FinancialTransactionItem
                    transaction={transaction}
                    metaLine={transactionMetaLine(transaction, ['expense'])}
                    amountClass="text-charcoal"
                  />
                ))}
              </ul>
            </FinancialScrollPanel>
          )
        }
      </article>
    </div>
  </section>

  <section class="mt-12" aria-labelledby="connection-heading">
    <h2 id="connection-heading" class="font-display text-2xl text-charcoal">QuickBooks connection</h2>
    <div class="mt-4 rounded-2xl bg-white p-5 shadow-sm ring-1 ring-black/[0.06]">
      <div class="flex flex-wrap items-center justify-between gap-2">
        <p class="text-sm text-[#6b6c72]">
          {summary.quickbooks.environment}
          {lastSync ? ` · last sync ${lastSync}` : ''}
        </p>
        <span
          class:list={[
            'rounded-full px-2.5 py-1 text-[11px] font-semibold uppercase tracking-wide ring-1',
            summary.quickbooks.status === 'connected'
              ? 'bg-[#eaf6ea] text-[#2CA01C] ring-[#2CA01C]/25'
              : summary.quickbooks.status === 'error'
                ? 'bg-red-50 text-red-800 ring-red-200'
                : 'bg-[#f4f5f8] text-[#6b6c72] ring-black/10',
          ]}
        >
          {summary.quickbooks.status}
        </span>
      </div>

      {
        connectionError && (
          <p class="mt-3 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800">{connectionError}</p>
        )
      }

      {
        needsReconnect && canManage && summary.quickbooks.configured && (
          <p class="mt-3 text-sm text-[#6b6c72]">
            Use Reconnect QuickBooks below to sign in with Intuit again. Sync will work after that.
          </p>
        )
      }

      {
        canManage && summary.quickbooks.configured && (
          <div class="mt-4 flex flex-wrap gap-2">
            <form method="post" action="/api/quickbooks/connect">
              <button
                class:list={[
                  'rounded-md px-3.5 py-2 text-sm font-semibold shadow-sm',
                  needsReconnect
                    ? 'bg-[#2CA01C] text-white hover:bg-[#248a18]'
                    : 'bg-white text-charcoal ring-1 ring-black/[0.1] hover:bg-[#f4f5f8]',
                ]}
                type="submit"
              >
                {summary.quickbooks.status === 'connected' ? 'Reconnect QuickBooks' : 'Connect QuickBooks'}
              </button>
            </form>
            {summary.quickbooks.status === 'connected' && (
              <form method="post" action="/api/quickbooks/sync">
                <button
                  class="rounded-md bg-white px-3.5 py-2 text-sm font-semibold text-charcoal shadow-sm ring-1 ring-black/[0.1] hover:bg-[#f4f5f8]"
                  type="submit"
                >
                  Sync numbers now
                </button>
              </form>
            )}
          </div>
        )
      }
    </div>
  </section>
</PortalLayout>

<script>
  const updateFinancialScrollHints = () => {
    document.querySelectorAll<HTMLElement>('[data-financials-scroll]').forEach((panel) => {
      const shell = panel.closest('.financials-scroll-shell');
      const fade = shell?.querySelector<HTMLElement>('[data-financials-scroll-fade]');
      const hint = shell?.querySelector<HTMLElement>('[data-financials-scroll-hint]');
      const canScroll = panel.scrollHeight > panel.clientHeight + 1;
      const atBottom = panel.scrollTop + panel.clientHeight >= panel.scrollHeight - 8;
      const showHint = canScroll && !atBottom;

      panel.classList.toggle('is-scrollable', canScroll);
      fade?.classList.toggle('is-visible', showHint);
      hint?.classList.toggle('is-visible', showHint);
    });
  };

  document.querySelectorAll<HTMLElement>('[data-financials-scroll]').forEach((panel) => {
    panel.addEventListener('scroll', updateFinancialScrollHints, { passive: true });
  });

  document.querySelectorAll<HTMLDetailsElement>('.financials-scroll-panel details').forEach((details) => {
    details.addEventListener('toggle', updateFinancialScrollHints);
  });

  window.addEventListener('resize', updateFinancialScrollHints, { passive: true });
  updateFinancialScrollHints();
</script>
