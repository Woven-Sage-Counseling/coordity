---
import PortalLayout from '../layouts/PortalLayout.astro';
import FinancialCardBoard from '../components/FinancialCardBoard.astro';
import { QuickBooksProvider, type ChartAccountChoice } from '../lib/financials/quickbooks';
import { formatDisplayDate, getFinancialSummary } from '../lib/financials/summary';
import { orgIdFromLocals } from '../lib/organization';
import { normalizeMatchName } from '../lib/financials/outlook';
import type { DashboardAccountChoice } from '../lib/financials/cards';
import { hasPermission } from '../lib/permissions';

export const prerender = false;

const employee = Astro.locals.employee!;
if (!hasPermission(employee, 'financials:view')) {
  return new Response('Forbidden', { status: 403 });
}

const orgId = orgIdFromLocals(Astro.locals.organization);
const summary = await getFinancialSummary(Astro.url.searchParams, { orgId });
const canManage = hasPermission(employee, 'financials:manage');
const connected = summary.quickbooks.status === 'connected';
let chartAccounts: ChartAccountChoice[] = [];
let accountsError: string | null = null;
if (canManage && connected) {
  try {
    chartAccounts = await new QuickBooksProvider(orgId).listChartAccounts();
  } catch (loadError) {
    accountsError = loadError instanceof Error ? loadError.message : 'Could not load QuickBooks accounts.';
  }
}

const choices: DashboardAccountChoice[] = [];
const seenIds = new Set<string>();
const seenNames = new Set<string>();
function addChoice(choice: DashboardAccountChoice) {
  const nameKey = normalizeMatchName(choice.name);
  if (!choice.id || seenIds.has(choice.id) || (nameKey && seenNames.has(nameKey))) return;
  seenIds.add(choice.id);
  if (nameKey) seenNames.add(nameKey);
  choices.push(choice);
}

for (const account of chartAccounts) {
  if (account.accountType !== 'income' && account.accountType !== 'expense' && account.accountType !== 'bank') continue;
  addChoice({ id: account.id, name: account.name, kind: account.accountType });
}
for (const line of summary.pnlLines) {
  addChoice({
    id: line.accountId || `name:${normalizeMatchName(line.name)}`,
    name: line.name,
    kind: line.bucket === 'income' ? 'income' : 'expense',
  });
}
for (const bank of summary.bankAccounts) {
  addChoice({
    id: bank.accountId || `bank:${normalizeMatchName(bank.name)}`,
    name: bank.name,
    kind: 'bank',
  });
}

const error = Astro.url.searchParams.get('error');
const connectionError = error ?? summary.quickbooks.lastError;
const needsReconnect =
  summary.quickbooks.status === 'disconnected' ||
  (connectionError?.toLowerCase().includes('reconnect quickbooks') ?? false);
const periodLabel = summary.snapshot
  ? `${formatDisplayDate(summary.snapshot.periodStart) ?? summary.snapshot.periodStart} – ${formatDisplayDate(summary.snapshot.periodEnd) ?? summary.snapshot.periodEnd}`
  : null;
---

<PortalLayout title="Financials" wide>
  <h1 class="font-display text-4xl text-charcoal sm:text-5xl">Financial dashboard</h1>
  <div class="mt-6">
    <FinancialCardBoard
      canManage={canManage}
      cards={summary.dashboardCards}
      choices={choices}
      accountsError={accountsError}
      summary={summary}
      period={summary.period}
      periodLabel={periodLabel}
      connectionError={connectionError}
      needsReconnect={needsReconnect}
      quickbooksConfigured={summary.quickbooks.configured}
      quickbooksStatus={summary.quickbooks.status}
    />
  </div>
</PortalLayout>
