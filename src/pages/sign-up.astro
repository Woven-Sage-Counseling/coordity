---
import CoordityLayout from '../layouts/CoordityLayout.astro';
import CoordityMark from '../components/CoordityMark.astro';
import { COORDITY_PRODUCT_NAME } from '../lib/organization';

// SECURITY CONTAINMENT (2026-11-06): self-serve workspace creation is disabled (the orgs create API route refuses all).
// This page only explains how to get a workspace; it has no form.
export const prerender = false;

if (!Astro.locals.isCoordityApex) {
  return Astro.redirect('/sign-in');
}
---

<CoordityLayout title="Get a workspace">
  <a href="/" class="inline-block">
    <CoordityMark variant="light" class="h-9 w-auto" />
  </a>
  <h1 class="mt-6 font-display text-4xl text-white sm:text-5xl">Workspaces are by invitation</h1>
  <p class="mt-4 text-sm leading-relaxed text-white/75">
    {COORDITY_PRODUCT_NAME} sets up each practice&rsquo;s workspace for them. Request early access and we will
    e-mail your invitation once your workspace is ready.
  </p>

  <p class="mt-8">
    <a href="/early-access" class="btn-coordity">Request early access</a>
  </p>

  <p class="mt-8 text-center text-xs text-white/55">
    Already have a workspace?{' '}
    <a href="/continue" class="font-medium text-coordity-soft underline-offset-2 hover:underline">
      Find it
    </a>
  </p>
</CoordityLayout>
