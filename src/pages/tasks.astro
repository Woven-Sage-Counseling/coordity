---
import PortalLayout from '../layouts/PortalLayout.astro';
import TasksPanel from '../components/TasksPanel.astro';

export const prerender = false;

const employee = Astro.locals.employee!;
const error = Astro.url.searchParams.get('tasksError');
const initialError = error != null && error !== '' ? error : null;
---

<PortalLayout title="Tasks" wide>
  <p class="text-sm text-sage-dark/65">
    <a href="/workspace" class="hover:text-sage-dark">WorkHub</a>
    <span class="mx-1.5 text-sage-dark/35">/</span>
    Tasks
  </p>

  <div class="mt-3">
    <h1 class="font-display text-4xl text-charcoal sm:text-5xl">Tasks</h1>
    <p class="mt-3 max-w-2xl text-sage-dark/75">
      Keep track of personal to-dos and tasks assigned by admins. Check items off when you are done,
      or delete them to clear your list.
    </p>
  </div>

  <TasksPanel userId={employee.id} mode="page" returnTo="/tasks" initialError={initialError} />
</PortalLayout>
