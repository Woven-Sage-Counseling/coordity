---
import PlatformLayout from '../../layouts/PlatformLayout.astro';
import { countPlatformOrganizations } from '../../lib/platform-orgs';
import { listPlatformStaff } from '../../lib/platform-access';

export const prerender = false;

const staff = Astro.locals.platformStaff!;
const counts = await countPlatformOrganizations().catch(() => ({ active: 0, archived: 0 }));
const staffCount = await listPlatformStaff().then((rows) => rows.length).catch(() => 1);
---

<PlatformLayout title="Dashboard" staffName={staff.name}>
  <h1 class="font-display text-4xl text-[#0b1f33]">Dashboard</h1>
  <p class="mt-2 text-sm text-[#5b6b7c]">Coordity platform overview.</p>

  <div class="mt-8 grid gap-4 sm:grid-cols-3">
    <a href="/platform/orgs" class="rounded-2xl border border-black/10 bg-white/90 p-5 shadow-sm transition hover:border-[#005284]/40">
      <p class="text-xs font-semibold uppercase tracking-[0.14em] text-[#5b6b7c]">Organizations</p>
      <p class="mt-2 text-3xl font-semibold text-[#0b1f33]">{counts.active}</p>
      <p class="mt-1 text-sm text-[#5b6b7c]">{counts.archived} archived</p>
    </a>
    <div class="rounded-2xl border border-black/10 bg-white/90 p-5 shadow-sm">
      <p class="text-xs font-semibold uppercase tracking-[0.14em] text-[#5b6b7c]">Platform staff</p>
      <p class="mt-2 text-3xl font-semibold text-[#0b1f33]">{staffCount}</p>
      <p class="mt-1 text-sm text-[#5b6b7c]">Signed in as {staff.roleName}</p>
    </div>
    <div class="rounded-2xl border border-black/10 bg-white/90 p-5 shadow-sm">
      <p class="text-xs font-semibold uppercase tracking-[0.14em] text-[#5b6b7c]">Marketing</p>
      <p class="mt-2 text-lg font-semibold text-[#0b1f33]">Coming soon</p>
      <p class="mt-1 text-sm text-[#5b6b7c]">Campaigns and promotions</p>
    </div>
  </div>
</PlatformLayout>
