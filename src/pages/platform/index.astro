---
import PlatformLayout from '../../layouts/PlatformLayout.astro';
import { countPlatformOrganizations } from '../../lib/platform-orgs';
import { listPlatformStaff } from '../../lib/platform-access';

export const prerender = false;

const staff = Astro.locals.platformStaff!;
const counts = await countPlatformOrganizations().catch(() => ({ active: 0, archived: 0 }));
const staffCount = await listPlatformStaff().then((rows) => rows.length).catch(() => 1);
const firstName = staff.name.trim().split(/\s+/)[0] || staff.name;
---

<PlatformLayout title="Home" staffName={staff.name}>
  <h1 class="platform-title">Coordity</h1>
  <p class="platform-lede">
    Welcome back, {firstName}. Run customer workspaces from here — organizations, owners, and the
    tools that keep the platform moving.
  </p>

  <a class="platform-cta" href="/platform/orgs">
    Organizations
    <span aria-hidden="true">→</span>
  </a>

  <p class="platform-stat">
    <strong>{counts.active}</strong> active workspace{counts.active === 1 ? '' : 's'}
    {counts.archived > 0 ? <> · {counts.archived} archived</> : null}
    <> · {staffCount} staff</>
  </p>

  <div class="platform-secondary">
    <a href="/platform/marketing">Marketing</a>
    <a href="/platform/promotions">Promotions</a>
    <a href="/platform/staff">Staff</a>
  </div>
</PlatformLayout>
