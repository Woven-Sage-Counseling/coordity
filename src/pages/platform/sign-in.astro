---
import CoordityMark from '../../components/CoordityMark.astro';
import CoordityLayout from '../../layouts/CoordityLayout.astro';

export const prerender = false;

if (!Astro.locals.isCoordityApex) {
  return Astro.redirect('/');
}
if (Astro.locals.platformStaff) {
  return Astro.redirect('/platform');
}

const error = Astro.url.searchParams.get('error');
---

<CoordityLayout title="Platform sign in">
  <div class="rounded-2xl border border-black/10 bg-white/90 p-6 shadow-sm sm:p-8">
    <CoordityMark class="text-xl" />
    <h1 class="mt-4 font-display text-3xl text-[#0b1f33]">Platform sign in</h1>
    <p class="mt-2 text-sm text-[#5b6b7c]">Coordity staff only. Customer workspaces use their own subdomain.</p>

    {
      error && (
        <p class="mt-4 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800">{error}</p>
      )
    }

    <form method="post" action="/api/platform/session/sign-in" class="mt-6 space-y-4">
      <label class="block text-sm font-medium text-[#0b1f33]">
        Email
        <input class="field" type="email" name="email" autocomplete="username" required />
      </label>
      <label class="block text-sm font-medium text-[#0b1f33]">
        Password
        <input
          class="field"
          type="password"
          name="password"
          autocomplete="current-password"
          required
          minlength="12"
        />
      </label>
      <button class="btn-primary w-full" type="submit">Sign in</button>
    </form>
  </div>
</CoordityLayout>
