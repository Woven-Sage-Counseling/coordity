---
import PlatformLayout from '../../layouts/PlatformLayout.astro';

export const prerender = false;
const staff = Astro.locals.platformStaff!;
---

<PlatformLayout title="Marketing" staffName={staff.name} eyebrow="Growth">
  <h1 class="platform-title" style="font-size:clamp(1.85rem, 3vw, 2.35rem);">Marketing</h1>
  <p class="platform-lede">Email campaigns and lifecycle messaging for Coordity.</p>
  <div class="platform-empty">
    <strong>Coming soon</strong>
    <span>Marketing tools will live here for sales and growth staff.</span>
  </div>
</PlatformLayout>
