---
import PlatformLayout from '../../layouts/PlatformLayout.astro';
import { hasPlatformPermission } from '../../lib/platform-access';
import { listPlatformOrganizations } from '../../lib/platform-orgs';
import { tenantOrigin } from '../../lib/organization';

export const prerender = false;

const staff = Astro.locals.platformStaff!;
const canCreate = hasPlatformPermission(staff, 'platform:orgs:create');
const canDelete = hasPlatformPermission(staff, 'platform:orgs:delete');
const includeArchived = Astro.url.searchParams.get('archived') === '1';
const orgs = await listPlatformOrganizations({ includeArchived });
const error = Astro.url.searchParams.get('error');
const inviteUrl = Astro.url.searchParams.get('inviteUrl');
const saved = Astro.url.searchParams.get('saved');
---

<PlatformLayout title="Organizations" staffName={staff.name} eyebrow="Workspaces">
  <div style="display:flex;flex-wrap:wrap;align-items:flex-end;justify-content:space-between;gap:1rem;">
    <div>
      <h1 class="platform-title" style="font-size:clamp(1.85rem, 3vw, 2.35rem);">Organizations</h1>
      <p class="platform-lede">Customer workspaces and primary subscribers.</p>
    </div>
    <div style="display:flex;flex-wrap:wrap;gap:0.4rem;">
      <a
        href="/platform/orgs"
        class:list={['platform-chip', !includeArchived && 'is-active']}
      >
        Active
      </a>
      <a
        href="/platform/orgs?archived=1"
        class:list={['platform-chip', includeArchived && 'is-active']}
      >
        Archived
      </a>
    </div>
  </div>

  {
    error && (
      <p class="platform-alert platform-alert-error">{error}</p>
    )
  }
  {
    saved && (
      <p class="platform-alert platform-alert-ok">
        {saved === 'created' ? 'Organization created.' : saved === 'archived' ? 'Organization archived.' : 'Saved.'}
      </p>
    )
  }
  {
    inviteUrl && (
      <p class="platform-alert platform-alert-ok" style="word-break:break-all;">
        Owner invite link:
        <br />
        <a href={inviteUrl} style="text-decoration:underline;text-underline-offset:3px;">
          {inviteUrl}
        </a>
      </p>
    )
  }

  {
    canCreate && !includeArchived ? (
      <form method="post" action="/api/platform/orgs/create" class="platform-panel" style="display:grid;gap:0.15rem 1rem;grid-template-columns:1fr;">
        <div style="grid-column:1/-1;">
          <h2>Create organization</h2>
          <p class="hint">Provisions a subdomain and invites the primary owner.</p>
        </div>
        <label class="platform-field">
          Company name
          <input class="platform-input" type="text" name="companyName" required />
        </label>
        <label class="platform-field">
          Slug
          <input class="platform-input" type="text" name="slug" placeholder="acme" />
        </label>
        <label class="platform-field">
          Website
          <input class="platform-input" type="url" name="websiteUrl" placeholder="https://" />
        </label>
        <label class="platform-field">
          Owner name
          <input class="platform-input" type="text" name="adminName" required />
        </label>
        <label class="platform-field" style="grid-column:1/-1;">
          Owner email
          <input class="platform-input" type="email" name="adminEmail" required />
        </label>
        <div style="grid-column:1/-1;">
          <button class="platform-btn" type="submit">Create workspace</button>
        </div>
      </form>
    ) : null
  }

  {
    orgs.length === 0 ? (
      <div class="platform-empty">
        <strong>No organizations yet</strong>
        <span>{includeArchived ? 'Nothing in the archive.' : 'Create a workspace to get started.'}</span>
      </div>
    ) : (
      <div class="platform-table-wrap">
        <table class="platform-table">
          <thead>
            <tr>
              <th>Organization</th>
              <th>Primary subscriber</th>
              <th>Status</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            {
              orgs.map((org) => {
                const openUrl = tenantOrigin(org.slug, Astro.url.href);
                const subscriber =
                  org.primarySubscriberEmail
                    ? `${org.primarySubscriberName ?? 'Owner'} · ${org.primarySubscriberEmail}`
                    : org.pendingOwnerEmail
                      ? `Invite pending · ${org.pendingOwnerEmail}`
                      : '—';
                return (
                  <tr>
                    <td>
                      <div class="org-name">{org.displayName}</div>
                      <div class="org-slug">{org.slug}.coordity.com</div>
                    </td>
                    <td>{subscriber}</td>
                    <td style="text-transform:capitalize;color:var(--c-muted);">
                      {org.archivedAt ? 'archived' : 'active'}
                    </td>
                    <td>
                      <div class="platform-actions">
                        {!org.archivedAt ? (
                          <a class="platform-chip" href={openUrl} target="_blank" rel="noreferrer">
                            Open
                          </a>
                        ) : null}
                        {canDelete && !org.archivedAt && org.slug !== 'wovensage' ? (
                          <form method="post" action="/api/platform/orgs/archive">
                            <input type="hidden" name="orgId" value={org.id} />
                            <button class="platform-chip" type="submit" style="color:#9f1d1d;border-color:rgba(159,29,29,0.25);">
                              Archive
                            </button>
                          </form>
                        ) : null}
                        {canDelete && org.archivedAt ? (
                          <form method="post" action="/api/platform/orgs/restore">
                            <input type="hidden" name="orgId" value={org.id} />
                            <button class="platform-chip" type="submit">
                              Restore
                            </button>
                          </form>
                        ) : null}
                      </div>
                    </td>
                  </tr>
                );
              })
            }
          </tbody>
        </table>
      </div>
    )
  }
</PlatformLayout>

<style>
  @media (min-width: 640px) {
    form.platform-panel {
      grid-template-columns: 1fr 1fr !important;
    }
  }
</style>
