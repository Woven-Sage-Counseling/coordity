---
import PlatformLayout from '../../layouts/PlatformLayout.astro';

export const prerender = false;
const staff = Astro.locals.platformStaff!;
---

<PlatformLayout title="Promotions" staffName={staff.name} eyebrow="Growth">
  <h1 class="platform-title" style="font-size:clamp(1.85rem, 3vw, 2.35rem);">Promotions</h1>
  <p class="platform-lede">Offers, trials, and promotional campaigns.</p>
  <div class="platform-empty">
    <strong>Coming soon</strong>
    <span>Promotion management will land here.</span>
  </div>
</PlatformLayout>
