---
import PlatformLayout from '../../layouts/PlatformLayout.astro';
import { listPlatformStaff } from '../../lib/platform-access';

export const prerender = false;
const staff = Astro.locals.platformStaff!;
const people = await listPlatformStaff().catch(() => [staff]);
---

<PlatformLayout title="Staff" staffName={staff.name} eyebrow="Access">
  <h1 class="platform-title" style="font-size:clamp(1.85rem, 3vw, 2.35rem);">Platform staff</h1>
  <p class="platform-lede">Coordity internal accounts. Inviting more staff roles comes next.</p>

  <div class="platform-table-wrap">
    <table class="platform-table">
      <thead>
        <tr>
          <th>Name</th>
          <th>Email</th>
          <th>Role</th>
          <th>Status</th>
        </tr>
      </thead>
      <tbody>
        {
          people.map((person) => (
            <tr>
              <td>
                <div class="org-name">{person.name}</div>
              </td>
              <td>{person.email}</td>
              <td>{person.roleName}</td>
              <td style="text-transform:capitalize;color:var(--c-muted);">{person.status}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  <div class="platform-empty" style="margin-top:1.25rem;">
    <strong>Staff invites coming soon</strong>
    <span>Sales, IT, and security roles are already seeded in the database.</span>
  </div>
</PlatformLayout>
