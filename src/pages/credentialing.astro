---
import PortalLayout from '../layouts/PortalLayout.astro';
import { canSeeCredentialing, listPublicInsuranceDisplay } from '../lib/credentialing';

export const prerender = false;

const employee = Astro.locals.employee!;
if (!canSeeCredentialing(employee)) {
  return new Response('Forbidden', { status: 403 });
}

const insuranceGroups = await listPublicInsuranceDisplay();
const hasInNetwork = insuranceGroups.some((group) => group.inNetworkPlans.length > 0);
const hasComingSoon = insuranceGroups.some((group) => group.comingSoonPlans.length > 0);
---

<PortalLayout title="Insurance" wide>
  <p class="text-sm text-sage-dark/65">
    <a href="/" class="hover:text-sage-dark">Home</a>
    <span class="mx-1.5 text-sage-dark/35">/</span>
    Insurance
  </p>

  <div class="mt-3">
    <h1 class="font-display text-4xl text-charcoal sm:text-5xl">Insurance</h1>
    <p class="mt-3 max-w-2xl text-sage-dark/75">
      Accepted insurance plans and plans that are expected to be available soon.
    </p>
  </div>

  <p class="mt-6 max-w-2xl rounded-xl border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-950">
    Disclaimer: If an insurance company or plan does not appear here, that does not necessarily mean we
    do not accept it. This list reflects plans we are currently in network with or actively working to
    add.
  </p>

  <section class="card mt-8 max-w-2xl" data-insurance-page>
    <label class="block text-sm font-medium text-charcoal">
      Search companies or plans
      <input
        class="field mt-1"
        type="search"
        placeholder="Aetna, Choice POS…"
        data-insurance-search
      />
    </label>

    <div class="mt-8 space-y-10" data-insurance-results>
      {
        !hasInNetwork && !hasComingSoon ? (
          <p class="text-sm text-sage-dark/65">No insurance plans are listed yet.</p>
        ) : (
          <>
            {
              hasInNetwork ? (
                <div data-insurance-section="in-network">
                  <h2 class="text-lg font-semibold text-charcoal">Currently in network</h2>
                  <div class="mt-4 space-y-6">
                    {
                      insuranceGroups
                        .filter((group) => group.inNetworkPlans.length > 0)
                        .map((group) => (
                          <div
                            data-insurance-group
                            data-search-text={group.groupName.toLowerCase()}
                          >
                            <h3 class="text-sm font-semibold uppercase tracking-wide text-sage-dark/65">
                              {group.groupName}
                            </h3>
                            <ul class="mt-3 space-y-2">
                              {
                                group.inNetworkPlans.map((plan) => (
                                  <li
                                    class="rounded-xl border border-sage-dark/10 bg-[#fafbf9] px-3.5 py-3 text-sm font-medium text-charcoal"
                                    data-insurance-plan
                                    data-search-text={`${group.groupName} ${plan.planName}`.toLowerCase()}
                                  >
                                    {plan.planName}
                                  </li>
                                ))
                              }
                            </ul>
                          </div>
                        ))
                    }
                  </div>
                </div>
              ) : null
            }

            {
              hasComingSoon ? (
                <div data-insurance-section="coming-soon">
                  <h2 class="text-lg font-semibold text-charcoal">Coming soon</h2>
                  <div class="mt-4 space-y-6">
                    {
                      insuranceGroups
                        .filter((group) => group.comingSoonPlans.length > 0)
                        .map((group) => (
                          <div
                            data-insurance-group
                            data-search-text={group.groupName.toLowerCase()}
                          >
                            <h3 class="text-sm font-semibold uppercase tracking-wide text-sage-dark/65">
                              {group.groupName}
                            </h3>
                            <ul class="mt-3 space-y-2">
                              {
                                group.comingSoonPlans.map((plan) => (
                                  <li
                                    class="rounded-xl border border-sage-dark/10 bg-[#fafbf9] px-3.5 py-3 text-sm font-medium text-charcoal"
                                    data-insurance-plan
                                    data-search-text={`${group.groupName} ${plan.planName}`.toLowerCase()}
                                  >
                                    {plan.planName}
                                  </li>
                                ))
                              }
                            </ul>
                          </div>
                        ))
                    }
                  </div>
                  <p class="mt-5 text-sm leading-relaxed text-sage-dark/65">
                    Plans listed as Coming soon are still undergoing credentialing and aren&apos;t currently
                    available for in-network billing. Participation and effective dates aren&apos;t guaranteed
                    until credentialing is complete.
                  </p>
                </div>
              ) : null
            }
          </>
        )
      }
    </div>
  </section>
</PortalLayout>

<script>
  function applyInsuranceSearch(root: HTMLElement): void {
    const query =
      root.querySelector('[data-insurance-search]') instanceof HTMLInputElement
        ? root.querySelector<HTMLInputElement>('[data-insurance-search]')!.value.trim().toLowerCase()
        : '';

    root.querySelectorAll('[data-insurance-section]').forEach((section) => {
      if (!(section instanceof HTMLElement)) return;
      let sectionVisible = 0;

      section.querySelectorAll('[data-insurance-group]').forEach((group) => {
        if (!(group instanceof HTMLElement)) return;
        let groupVisible = 0;

        group.querySelectorAll('[data-insurance-plan]').forEach((plan) => {
          if (!(plan instanceof HTMLElement)) return;
          const haystack = plan.dataset.searchText ?? group.dataset.searchText ?? '';
          const show = !query || haystack.includes(query);
          plan.hidden = !show;
          if (show) groupVisible += 1;
        });

        group.hidden = groupVisible === 0;
        if (groupVisible > 0) sectionVisible += 1;
      });

      section.hidden = sectionVisible === 0;
    });
  }

  document.querySelectorAll('[data-insurance-page]').forEach((root) => {
    if (!(root instanceof HTMLElement)) return;
    const search = root.querySelector('[data-insurance-search]');
    search?.addEventListener('input', () => applyInsuranceSearch(root));
  });
</script>
