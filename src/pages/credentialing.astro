---
import PortalLayout from '../layouts/PortalLayout.astro';
import {
  canLookupAnyProvider,
  canSeeCredentialing,
  coverageStatusLabel,
  getProviderForUser,
  listProvidersForLookup,
  listProviderCoverage,
  type ProviderCoverageRow,
} from '../lib/credentialing';

export const prerender = false;

const employee = Astro.locals.employee!;
if (!canSeeCredentialing(employee)) {
  return new Response('Forbidden', { status: 403 });
}

const canPickProvider = canLookupAnyProvider(employee);
const providers = canPickProvider ? await listProvidersForLookup() : [];
const linkedProvider = await getProviderForUser(employee.id);

const selectedFromQuery = Astro.url.searchParams.get('provider')?.trim() ?? '';
const initialProviderId = canPickProvider
  ? selectedFromQuery && providers.some((p) => p.id === selectedFromQuery)
    ? selectedFromQuery
    : (providers[0]?.id ?? '')
  : (linkedProvider?.id ?? '');

const coverage = initialProviderId ? await listProviderCoverage(initialProviderId) : [];
const providerName = canPickProvider
  ? (providers.find((p) => p.id === initialProviderId)?.name ?? '')
  : (linkedProvider?.name ?? '');

function groupCoverage(rows: ProviderCoverageRow[]) {
  const map = new Map<string, { groupName: string; plans: ProviderCoverageRow[] }>();
  for (const row of rows) {
    const existing = map.get(row.groupId);
    if (existing) existing.plans.push(row);
    else map.set(row.groupId, { groupName: row.groupName, plans: [row] });
  }
  return [...map.entries()].map(([groupId, value]) => ({ groupId, ...value }));
}

const groups = groupCoverage(coverage);
---

<PortalLayout title="Credentialing" wide>
  <p class="text-sm text-sage-dark/65">
    <a href="/" class="hover:text-sage-dark">Home</a>
    <span class="mx-1.5 text-sage-dark/35">/</span>
    Credentialing
  </p>

  <div class="mt-3">
    <h1 class="font-display text-4xl text-charcoal sm:text-5xl">Credentialing</h1>
    <p class="mt-3 max-w-2xl text-sage-dark/75">
      Look up insurance groups and plans that are accepted or actively in credentialing for a provider.
    </p>
  </div>

  <p class="mt-6 max-w-2xl rounded-xl border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-950">
    Disclaimer: If an insurance group or plan does not appear here, that does not necessarily mean the
    provider does not take it. This list is for coverages that are definitely accepted or actively
    being credentialed for that provider.
  </p>

  <section class="card mt-8 max-w-2xl" data-credentialing-page data-can-pick={canPickProvider ? '1' : '0'}>
    {
      canPickProvider ? (
        <label class="block text-sm font-medium text-charcoal">
          Provider
          <select class="field mt-1" data-credentialing-provider>
            {providers.length === 0 ? (
              <option value="">No providers yet</option>
            ) : (
              providers.map((provider) => (
                <option value={provider.id} selected={provider.id === initialProviderId}>
                  {provider.name}
                </option>
              ))
            )}
          </select>
        </label>
      ) : (
        <div>
          <p class="text-sm font-medium text-charcoal">Provider</p>
          <p class="mt-1 text-base font-semibold text-charcoal">
            {linkedProvider ? linkedProvider.name : 'Not linked to a provider profile yet'}
          </p>
          {!linkedProvider ? (
            <p class="mt-2 text-sm text-sage-dark/65">
              You need to be on the Clinical team or have the Clinician role in the directory before
              coverage will show here.
            </p>
          ) : null}
        </div>
      )
    }

    <label class="mt-5 block text-sm font-medium text-charcoal">
      Search groups or plans
      <input
        class="field mt-1"
        type="search"
        placeholder="Aetna, Choice POS…"
        data-credentialing-search
        disabled={!initialProviderId}
      />
    </label>

    <div class="mt-6" data-credentialing-results>
      {
        !initialProviderId ? (
          <p class="text-sm text-sage-dark/65">No provider selected.</p>
        ) : coverage.length === 0 ? (
          <p class="text-sm text-sage-dark/65">No coverage listed for {providerName || 'this provider'} yet.</p>
        ) : (
          <div class="space-y-6">
            {groups.map((group) => (
              <div data-credentialing-group>
                <h2 class="text-lg font-semibold text-charcoal">{group.groupName}</h2>
                <ul class="mt-3 space-y-2">
                  {group.plans.map((plan) => (
                    <li
                      class="flex items-start justify-between gap-3 rounded-xl border border-sage-dark/10 bg-[#fafbf9] px-3.5 py-3"
                      data-credentialing-plan
                      data-search-text={`${group.groupName} ${plan.planName}`.toLowerCase()}
                    >
                      <p class="text-sm font-medium text-charcoal">{plan.planName}</p>
                      <span
                        class:list={[
                          'shrink-0 rounded-full px-2 py-0.5 text-[11px] font-semibold uppercase tracking-wide',
                          plan.status === 'accepted'
                            ? 'bg-emerald-100 text-emerald-900'
                            : 'bg-amber-100 text-amber-900',
                        ]}
                      >
                        {coverageStatusLabel(plan.status)}
                      </span>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        )
      }
    </div>
  </section>
</PortalLayout>

<script>
  type CoverageRow = {
    planName: string;
    groupId: string;
    groupName: string;
    status: 'accepted' | 'credentialing';
  };

  function escapeHtml(value: string): string {
    return value
      .replaceAll('&', '&amp;')
      .replaceAll('<', '&lt;')
      .replaceAll('>', '&gt;')
      .replaceAll('"', '&quot;');
  }

  function render(results: HTMLElement, rows: CoverageRow[], providerName: string): void {
    if (rows.length === 0) {
      results.innerHTML = `<p class="text-sm text-sage-dark/65">No coverage listed for ${escapeHtml(providerName || 'this provider')} yet.</p>`;
      return;
    }
    const groups = new Map<string, { groupName: string; plans: CoverageRow[] }>();
    for (const row of rows) {
      const existing = groups.get(row.groupId);
      if (existing) existing.plans.push(row);
      else groups.set(row.groupId, { groupName: row.groupName, plans: [row] });
    }
    results.innerHTML = [...groups.values()]
      .map((group) => {
        const plans = group.plans
          .map((plan) => {
            const badge =
              plan.status === 'accepted'
                ? 'bg-emerald-100 text-emerald-900'
                : 'bg-amber-100 text-amber-900';
            const label = plan.status === 'accepted' ? 'Accepted' : 'Credentialing';
            return `<li
              class="flex items-start justify-between gap-3 rounded-xl border border-sage-dark/10 bg-[#fafbf9] px-3.5 py-3"
              data-credentialing-plan
              data-search-text="${escapeHtml(`${group.groupName} ${plan.planName}`.toLowerCase())}"
            >
              <p class="text-sm font-medium text-charcoal">${escapeHtml(plan.planName)}</p>
              <span class="shrink-0 rounded-full px-2 py-0.5 text-[11px] font-semibold uppercase tracking-wide ${badge}">${label}</span>
            </li>`;
          })
          .join('');
        return `<div data-credentialing-group>
          <h2 class="text-lg font-semibold text-charcoal">${escapeHtml(group.groupName)}</h2>
          <ul class="mt-3 space-y-2">${plans}</ul>
        </div>`;
      })
      .join('');
  }

  function applySearch(root: HTMLElement): void {
    const input = root.querySelector('[data-credentialing-search]');
    const query = input instanceof HTMLInputElement ? input.value.trim().toLowerCase() : '';
    root.querySelectorAll('[data-credentialing-group]').forEach((group) => {
      if (!(group instanceof HTMLElement)) return;
      let visible = 0;
      group.querySelectorAll('[data-credentialing-plan]').forEach((plan) => {
        if (!(plan instanceof HTMLElement)) return;
        const show = !query || (plan.dataset.searchText ?? '').includes(query);
        plan.hidden = !show;
        if (show) visible += 1;
      });
      group.hidden = visible === 0;
    });
  }

  document.querySelectorAll('[data-credentialing-page]').forEach((root) => {
    if (!(root instanceof HTMLElement)) return;
    const results = root.querySelector('[data-credentialing-results]');
    const search = root.querySelector('[data-credentialing-search]');
    const select = root.querySelector('[data-credentialing-provider]');
    if (!(results instanceof HTMLElement)) return;

    search?.addEventListener('input', () => applySearch(root));

    if (!(select instanceof HTMLSelectElement)) return;
    select.addEventListener('change', () => {
      void (async () => {
        const providerId = select.value;
        const providerName = select.selectedOptions[0]?.textContent?.trim() ?? '';
        if (search instanceof HTMLInputElement) {
          search.value = '';
          search.disabled = !providerId;
        }
        const url = new URL(window.location.href);
        if (providerId) url.searchParams.set('provider', providerId);
        else url.searchParams.delete('provider');
        history.replaceState(null, '', url.toString());

        if (!providerId) {
          results.innerHTML = `<p class="text-sm text-sage-dark/65">No provider selected.</p>`;
          return;
        }
        results.innerHTML = `<p class="text-sm text-sage-dark/65">Loading…</p>`;
        try {
          const response = await fetch(
            `/api/credentialing/coverage?providerId=${encodeURIComponent(providerId)}`,
            { headers: { Accept: 'application/json' }, credentials: 'same-origin' },
          );
          const payload = (await response.json()) as {
            ok?: boolean;
            coverage?: CoverageRow[];
            error?: string;
          };
          if (!response.ok || !payload.ok || !payload.coverage) {
            results.innerHTML = `<p class="text-sm text-red-700">${escapeHtml(payload.error || 'Unable to load coverage.')}</p>`;
            return;
          }
          render(results, payload.coverage, providerName);
          applySearch(root);
        } catch {
          results.innerHTML = `<p class="text-sm text-red-700">Unable to load coverage.</p>`;
        }
      })();
    });
  });
</script>
