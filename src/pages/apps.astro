---
import PortalLayout from '../layouts/PortalLayout.astro';
import AppCard from '../components/AppCard.astro';
import { appCategories, portalApps } from '../lib/apps';
import { hasPermission } from '../lib/permissions';

export const prerender = false;

const employee = Astro.locals.employee!;
const visibleApps = portalApps.filter((app) => hasPermission(employee, app.permission));
---

<PortalLayout title="Quick links" wide>
  <h1 class="font-display text-4xl text-charcoal sm:text-5xl">Quick links</h1>

  {
    appCategories.map((category) => {
      const apps = visibleApps.filter((app) => app.category === category.id);
      if (apps.length === 0) return null;
      return (
        <section class="mt-12">
          <h2 class="font-display text-3xl text-charcoal">{category.title}</h2>
          <div class="mt-5 flex flex-wrap gap-x-4 gap-y-6">
            {apps.map((app) => (
              <AppCard app={app} />
            ))}
          </div>
        </section>
      );
    })
  }
</PortalLayout>
