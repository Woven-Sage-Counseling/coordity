---
import PortalLayout from '../layouts/PortalLayout.astro';
import AppCard from '../components/AppCard.astro';
import { appCategories, portalApps } from '../lib/apps';
import { hasPermission } from '../lib/permissions';

export const prerender = false;

const employee = Astro.locals.employee!;
const visibleApps = portalApps.filter((app) => hasPermission(employee, app.permission));
---

<PortalLayout title="Applications" wide>
  <p class="text-xs uppercase tracking-[0.2em] text-sage-dark/60">Applications</p>
  <h1 class="mt-3 font-display text-4xl text-charcoal sm:text-5xl">Open the tool you need.</h1>
  <p class="mt-4 max-w-2xl text-sage-dark/75">
    Each tile opens the respective website. Woven Sage does not copy clinical data into this portal.
  </p>

  {
    appCategories.map((category) => {
      const apps = visibleApps.filter((app) => app.category === category.id);
      if (apps.length === 0) return null;
      return (
        <section class="mt-12">
          <h2 class="font-display text-3xl text-charcoal">{category.title}</h2>
          <div class="mt-5 flex flex-wrap gap-x-4 gap-y-6">
            {apps.map((app) => (
              <AppCard app={app} />
            ))}
          </div>
        </section>
      );
    })
  }
</PortalLayout>
