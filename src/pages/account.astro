---
import PortalLayout from '../layouts/PortalLayout.astro';
import { canAccessManagement } from '../lib/permissions';

export const prerender = false;

const employee = Astro.locals.employee!;
const canSeeManagement = canAccessManagement(employee);
const error = Astro.url.searchParams.get('error');
---

<PortalLayout title="Account">
  <h1 class="font-display text-4xl text-charcoal">Account</h1>
  {
    error && (
      <p class="mt-6 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800">{error}</p>
    )
  }
  <dl class="card mt-8 space-y-4 text-sm">
    <div>
      <dt class="text-sage-dark/60">Name</dt>
      <dd class="mt-1 text-charcoal">{employee.name}</dd>
    </div>
    <div>
      <dt class="text-sage-dark/60">Job title</dt>
      <dd class="mt-1 text-charcoal">{employee.jobTitle || '—'}</dd>
    </div>
    <div>
      <dt class="text-sage-dark/60">Email</dt>
      <dd class="mt-1 text-charcoal">{employee.email}</dd>
    </div>
    <div>
      <dt class="text-sage-dark/60">Phone</dt>
      <dd class="mt-1 text-charcoal">{employee.phone || '—'}</dd>
    </div>
    <div>
      <dt class="text-sage-dark/60">Roles</dt>
      <dd class="mt-1 text-charcoal">
        {employee.roles.includes('owner')
          ? 'Primary owner'
          : employee.roles.includes('owner_view')
            ? 'Owner'
            : employee.roles.join(', ') || 'None'}
      </dd>
    </div>
    <div>
      <dt class="text-sage-dark/60">Status</dt>
      <dd class="mt-1 capitalize text-charcoal">{employee.status}</dd>
    </div>
  </dl>

  <form method="post" action="/api/account/update" class="card mt-6 space-y-4">
    <h2 class="font-display text-2xl text-charcoal">Directory profile</h2>
    <p class="text-sm text-sage-dark/65">
      Name and phone appear on the staff Directory. Job titles are set by management.
    </p>
    <label class="block text-sm font-medium">
      Display name
      <input class="field" type="text" name="name" value={employee.name} required minlength="2" maxlength="80" />
    </label>
    <label class="block text-sm font-medium">
      Phone
      <input
        class="field"
        type="tel"
        name="phone"
        value={employee.phone ?? ''}
        maxlength="40"
        placeholder="e.g. (555) 123-4567"
      />
    </label>
    <button class="btn-primary" type="submit">Save profile</button>
  </form>

  {
    canSeeManagement && (
      <a href="/management#people" class="card mt-6 block hover:border-sage-dark/25">
        <h2 class="font-display text-2xl text-charcoal">People and roles</h2>
        <p class="mt-2 text-sm text-sage-dark/70">
          Invite people and assign roles from Management.
        </p>
      </a>
    )
  }

  <form method="post" action="/api/session/sign-out" class="mt-8">
    <button class="btn-secondary" type="submit">Sign out</button>
  </form>
</PortalLayout>
