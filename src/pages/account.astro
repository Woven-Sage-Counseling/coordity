---
import PortalLayout from '../layouts/PortalLayout.astro';
import { canAccessManagement } from '../lib/permissions';

export const prerender = false;

const employee = Astro.locals.employee!;
const canSeeManagement = canAccessManagement(employee);
const error = Astro.url.searchParams.get('error');
const saved = Astro.url.searchParams.get('saved');
const avatarSrc = employee.hasAvatar
  ? `/api/avatars/${employee.id}?v=${Date.now()}`
  : null;
const initials = employee.name
  .split(/\s+/)
  .filter(Boolean)
  .slice(0, 2)
  .map((part) => part[0]?.toUpperCase() ?? '')
  .join('');
const roleLabel = employee.roles.includes('owner')
  ? 'Primary owner'
  : employee.roles.includes('owner_view')
    ? 'Owner'
    : employee.roles.join(', ') || 'None';
---

<PortalLayout title="Account">
  <h1 class="font-display text-4xl text-charcoal">Account</h1>
  {
    error && (
      <p class="mt-6 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800">{error}</p>
    )
  }
  {
    saved && (
      <p class="mt-6 rounded-xl border border-sage-dark/15 bg-white px-4 py-3 text-sm text-sage-dark/80">
        Saved.
      </p>
    )
  }

  <section class="card mt-8" data-account-card>
    <div class="flex flex-wrap items-center gap-5 border-b border-sage-dark/10 pb-5">
      <div class="relative">
        {
          avatarSrc ? (
            <img
              src={avatarSrc}
              alt=""
              width="88"
              height="88"
              class="h-22 w-22 h-[5.5rem] w-[5.5rem] rounded-full object-cover ring-1 ring-black/10"
              data-avatar-preview
            />
          ) : (
            <div
              class="flex h-[5.5rem] w-[5.5rem] items-center justify-center rounded-full bg-[#e8ebe7] text-xl font-semibold text-sage-dark ring-1 ring-black/10"
              data-avatar-fallback
            >
              {initials || '?'}
            </div>
          )
        }
      </div>
      <div class="min-w-0 flex-1">
        <p class="text-sm font-medium text-charcoal">Profile picture</p>
        <p class="mt-1 text-sm text-sage-dark/65">Shown on your account and the staff Directory.</p>
        <div class="mt-3 flex flex-wrap gap-2">
          <label class="btn-secondary !px-3 !py-1.5 cursor-pointer">
            Change photo
            <input
              class="sr-only"
              type="file"
              accept="image/jpeg,image/png,image/webp"
              data-avatar-input
            />
          </label>
          {
            employee.hasAvatar && (
              <form method="post" action="/api/account/avatar">
                <input type="hidden" name="action" value="remove" />
                <button class="btn-secondary !px-3 !py-1.5" type="submit">
                  Remove
                </button>
              </form>
            )
          }
        </div>
        <form method="post" action="/api/account/avatar" class="hidden" data-avatar-form>
          <input type="hidden" name="avatarData" value="" data-avatar-data />
        </form>
      </div>
    </div>

    <dl class="mt-2 divide-y divide-sage-dark/10 text-sm">
      <div class="flex flex-wrap items-start justify-between gap-3 py-4" data-field-row="name">
        <div class="min-w-0 flex-1">
          <dt class="text-sage-dark/60">Name</dt>
          <dd class="mt-1 text-charcoal" data-field-display>{employee.name}</dd>
          <form
            method="post"
            action="/api/account/update"
            class="mt-2 hidden space-y-2"
            data-field-editor
            hidden
          >
            <input type="hidden" name="field" value="name" />
            <input
              class="field !mt-0"
              type="text"
              name="name"
              value={employee.name}
              required
              minlength="2"
              maxlength="80"
            />
            <div class="flex flex-wrap gap-2">
              <button class="btn-primary !px-3 !py-1.5" type="submit">Save</button>
              <button class="btn-secondary !px-3 !py-1.5" type="button" data-field-cancel>
                Cancel
              </button>
            </div>
          </form>
        </div>
        <button
          type="button"
          class="btn-secondary !px-3 !py-1.5"
          data-field-edit
          aria-expanded="false"
        >
          Edit
        </button>
      </div>

      <div class="flex flex-wrap items-start justify-between gap-3 py-4">
        <div class="min-w-0 flex-1">
          <dt class="text-sage-dark/60">Job title</dt>
          <dd class="mt-1 text-charcoal">{employee.jobTitle || '—'}</dd>
          <p class="mt-1 text-xs text-sage-dark/50">Set by management</p>
        </div>
      </div>

      <div class="flex flex-wrap items-start justify-between gap-3 py-4">
        <div class="min-w-0 flex-1">
          <dt class="text-sage-dark/60">Teams</dt>
          <dd class="mt-1 text-charcoal">
            {employee.teams.length > 0 ? employee.teams.join(', ') : '—'}
          </dd>
          <p class="mt-1 text-xs text-sage-dark/50">Set by management</p>
        </div>
      </div>

      <div class="flex flex-wrap items-start justify-between gap-3 py-4">
        <div class="min-w-0 flex-1">
          <dt class="text-sage-dark/60">Email</dt>
          <dd class="mt-1 text-charcoal">{employee.email}</dd>
        </div>
      </div>

      <div class="flex flex-wrap items-start justify-between gap-3 py-4" data-field-row="phone">
        <div class="min-w-0 flex-1">
          <dt class="text-sage-dark/60">Phone</dt>
          <dd class="mt-1 text-charcoal" data-field-display>{employee.phone || '—'}</dd>
          <form
            method="post"
            action="/api/account/update"
            class="mt-2 hidden space-y-2"
            data-field-editor
            hidden
          >
            <input type="hidden" name="field" value="phone" />
            <input
              class="field !mt-0"
              type="tel"
              name="phone"
              value={employee.phone ?? ''}
              maxlength="40"
              placeholder="e.g. (555) 123-4567"
            />
            <div class="flex flex-wrap gap-2">
              <button class="btn-primary !px-3 !py-1.5" type="submit">Save</button>
              <button class="btn-secondary !px-3 !py-1.5" type="button" data-field-cancel>
                Cancel
              </button>
            </div>
          </form>
        </div>
        <button
          type="button"
          class="btn-secondary !px-3 !py-1.5"
          data-field-edit
          aria-expanded="false"
        >
          Edit
        </button>
      </div>

      <div class="flex flex-wrap items-start justify-between gap-3 py-4">
        <div class="min-w-0 flex-1">
          <dt class="text-sage-dark/60">Roles</dt>
          <dd class="mt-1 text-charcoal">{roleLabel}</dd>
        </div>
      </div>

      <div class="flex flex-wrap items-start justify-between gap-3 py-4">
        <div class="min-w-0 flex-1">
          <dt class="text-sage-dark/60">Status</dt>
          <dd class="mt-1 capitalize text-charcoal">{employee.status}</dd>
        </div>
      </div>
    </dl>
  </section>

  {
    canSeeManagement && (
      <a href="/management#people" class="card mt-6 block hover:border-sage-dark/25">
        <h2 class="font-display text-2xl text-charcoal">People and roles</h2>
        <p class="mt-2 text-sm text-sage-dark/70">
          Invite people and assign roles from Management.
        </p>
      </a>
    )
  }

  <form method="post" action="/api/session/sign-out" class="mt-8">
    <button class="btn-secondary" type="submit">Sign out</button>
  </form>
</PortalLayout>

<script>
  function setupInlineFields(root: Element) {
    root.querySelectorAll('[data-field-row]').forEach((row) => {
      const edit = row.querySelector('[data-field-edit]');
      const cancel = row.querySelector('[data-field-cancel]');
      const display = row.querySelector('[data-field-display]');
      const editor = row.querySelector('[data-field-editor]');
      if (
        !(edit instanceof HTMLButtonElement) ||
        !(display instanceof HTMLElement) ||
        !(editor instanceof HTMLFormElement)
      ) {
        return;
      }

      const setOpen = (open: boolean) => {
        display.hidden = open;
        editor.hidden = !open;
        editor.classList.toggle('hidden', !open);
        edit.hidden = open;
        edit.setAttribute('aria-expanded', open ? 'true' : 'false');
        if (open) {
          const input = editor.querySelector('input:not([type="hidden"])');
          if (input instanceof HTMLInputElement) input.focus();
        }
      };

      edit.addEventListener('click', () => setOpen(true));
      cancel?.addEventListener('click', () => setOpen(false));
    });
  }

  function setupAvatarUpload(root: Element) {
    const input = root.querySelector('[data-avatar-input]');
    const form = root.querySelector('[data-avatar-form]');
    const dataField = root.querySelector('[data-avatar-data]');
    if (
      !(input instanceof HTMLInputElement) ||
      !(form instanceof HTMLFormElement) ||
      !(dataField instanceof HTMLInputElement)
    ) {
      return;
    }

    const resizeToDataUrl = (file: File): Promise<string> =>
      new Promise((resolve, reject) => {
        const reader = new FileReader();
        reader.onerror = () => reject(new Error('Could not read that image.'));
        reader.onload = () => {
          const image = new Image();
          image.onerror = () => reject(new Error('Could not load that image.'));
          image.onload = () => {
            const size = 256;
            const canvas = document.createElement('canvas');
            canvas.width = size;
            canvas.height = size;
            const ctx = canvas.getContext('2d');
            if (!ctx) {
              reject(new Error('Could not process that image.'));
              return;
            }
            const scale = Math.max(size / image.width, size / image.height);
            const w = image.width * scale;
            const h = image.height * scale;
            ctx.drawImage(image, (size - w) / 2, (size - h) / 2, w, h);
            resolve(canvas.toDataURL('image/jpeg', 0.88));
          };
          image.src = String(reader.result);
        };
        reader.readAsDataURL(file);
      });

    input.addEventListener('change', async () => {
      const file = input.files?.[0];
      if (!file) return;
      try {
        dataField.value = await resizeToDataUrl(file);
        form.submit();
      } catch (error) {
        const message = error instanceof Error ? error.message : 'Could not upload that photo.';
        window.alert(message);
      } finally {
        input.value = '';
      }
    });
  }

  const card = document.querySelector('[data-account-card]');
  if (card) {
    setupInlineFields(card);
    setupAvatarUpload(card);
  }
</script>
