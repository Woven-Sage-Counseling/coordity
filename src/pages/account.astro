---
import PortalLayout from '../layouts/PortalLayout.astro';

export const prerender = false;

const employee = Astro.locals.employee!;
const error = Astro.url.searchParams.get('error');
const savedField = Astro.url.searchParams.get('saved');
const avatarSrc = employee.hasAvatar
  ? `/api/avatars/${employee.id}?v=${Date.now()}`
  : null;
const initials = employee.name
  .split(/\s+/)
  .filter(Boolean)
  .slice(0, 2)
  .map((part) => part[0]?.toUpperCase() ?? '')
  .join('');
const roleLabel = employee.roles.includes('owner')
  ? 'Primary owner'
  : employee.roles.includes('owner_view')
    ? 'Owner'
    : employee.roles.join(', ') || 'None';
---

<PortalLayout title="Account">
  <div class="mx-auto max-w-lg" data-account-card>
    <p class="text-sm text-sage-dark/65">
      <a href="/" class="hover:text-sage-dark">Home</a>
      <span class="mx-1.5 text-sage-dark/35">/</span>
      Account
    </p>
    <h1 class="mt-3 font-display text-4xl text-charcoal">Account</h1>

    {
      error && (
        <p class="mt-6 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800">{error}</p>
      )
    }

    <div class="mt-8 flex flex-col items-center text-center">
      <div class="relative">
        {
          avatarSrc ? (
            <img
              src={avatarSrc}
              alt=""
              width="96"
              height="96"
              class="h-24 w-24 rounded-full object-cover ring-1 ring-black/10"
              data-avatar-preview
            />
          ) : (
            <div
              class="flex h-24 w-24 items-center justify-center rounded-full bg-[#e8ebe7] text-2xl font-semibold text-sage-dark ring-1 ring-black/10"
              data-avatar-fallback
            >
              {initials || '?'}
            </div>
          )
        }
      </div>
      <p class="mt-4 text-xl font-semibold tracking-tight text-charcoal">{employee.name}</p>
      <p class="mt-0.5 text-sm text-sage-dark/65">{employee.email}</p>
      <div class="mt-4 flex flex-wrap justify-center gap-2">
        <label class="cursor-pointer rounded-full border border-sage-dark/20 bg-white/80 px-3.5 py-1.5 text-sm font-medium text-sage-dark transition hover:border-sage-dark/35 hover:bg-white">
          Change photo
          <input
            class="sr-only"
            type="file"
            accept="image/jpeg,image/png,image/webp"
            data-avatar-input
          />
        </label>
        {
          employee.hasAvatar && (
            <form method="post" action="/api/account/avatar">
              <input type="hidden" name="action" value="remove" />
              <button
                class="rounded-full border border-sage-dark/20 bg-white/80 px-3.5 py-1.5 text-sm font-medium text-sage-dark transition hover:border-sage-dark/35 hover:bg-white"
                type="submit"
              >
                Remove
              </button>
            </form>
          )
        }
      </div>
      <form method="post" action="/api/account/avatar" class="hidden" data-avatar-form>
        <input type="hidden" name="avatarData" value="" data-avatar-data />
      </form>
    </div>

    <div class="mt-8 overflow-hidden rounded-2xl border border-sage-dark/10 bg-white/90 shadow-sm">
      <div class="px-4 py-3.5" data-field-row="name">
        <div class="flex items-start justify-between gap-3">
          <div class="min-w-0 flex-1">
            <p class="text-[13px] font-medium text-sage-dark/55">Name</p>
            <p class="mt-0.5 text-[15px] font-medium text-charcoal" data-field-display>{employee.name}</p>
            <form
              method="post"
              action="/api/account/update"
              class="mt-2 hidden space-y-2"
              data-field-editor
              hidden
            >
              <input type="hidden" name="field" value="name" />
              <input
                class="field !mt-0"
                type="text"
                name="name"
                value={employee.name}
                required
                minlength="2"
                maxlength="80"
              />
              <div class="flex flex-wrap items-center gap-2">
                <button class="btn-primary !px-3 !py-1.5" type="submit">Save</button>
                <button class="btn-secondary !px-3 !py-1.5" type="button" data-field-cancel>
                  Cancel
                </button>
              </div>
            </form>
          </div>
          <button
            type="button"
            class="shrink-0 pt-0.5 text-sm font-medium text-sage-dark/70 transition hover:text-charcoal"
            data-field-edit
            aria-expanded="false"
          >
            Edit
          </button>
        </div>
        {
          savedField === 'name' ? (
            <p class="mt-2 text-sm font-medium text-sage-dark/70" data-field-saved aria-live="polite">
              Saved.
            </p>
          ) : null
        }
      </div>

      <div class="mx-4 border-t border-sage-dark/10"></div>

      <div class="px-4 py-3.5" data-field-row="phone">
        <div class="flex items-start justify-between gap-3">
          <div class="min-w-0 flex-1">
            <p class="text-[13px] font-medium text-sage-dark/55">Phone</p>
            <p class="mt-0.5 text-[15px] font-medium text-charcoal" data-field-display>{employee.phone || '—'}</p>
            <form
              method="post"
              action="/api/account/update"
              class="mt-2 hidden space-y-2"
              data-field-editor
              hidden
            >
              <input type="hidden" name="field" value="phone" />
              <input
                class="field !mt-0"
                type="tel"
                name="phone"
                value={employee.phone ?? ''}
                maxlength="40"
                placeholder="e.g. (555) 123-4567"
              />
              <div class="flex flex-wrap items-center gap-2">
                <button class="btn-primary !px-3 !py-1.5" type="submit">Save</button>
                <button class="btn-secondary !px-3 !py-1.5" type="button" data-field-cancel>
                  Cancel
                </button>
              </div>
            </form>
          </div>
          <button
            type="button"
            class="shrink-0 pt-0.5 text-sm font-medium text-sage-dark/70 transition hover:text-charcoal"
            data-field-edit
            aria-expanded="false"
          >
            Edit
          </button>
        </div>
        {
          savedField === 'phone' ? (
            <p class="mt-2 text-sm font-medium text-sage-dark/70" data-field-saved aria-live="polite">
              Saved.
            </p>
          ) : null
        }
      </div>
    </div>

    <div class="mt-6 overflow-hidden rounded-2xl border border-sage-dark/10 bg-white/90 shadow-sm">
      <div class="flex items-start justify-between gap-3 px-4 py-3.5">
        <div class="min-w-0">
          <p class="text-[13px] font-medium text-sage-dark/55">Job title</p>
          <p class="mt-0.5 text-[15px] font-medium text-charcoal">{employee.jobTitle || '—'}</p>
        </div>
        <p class="shrink-0 pt-0.5 text-xs text-sage-dark/45">Set by management</p>
      </div>
      <div class="mx-4 border-t border-sage-dark/10"></div>
      <div class="flex items-start justify-between gap-3 px-4 py-3.5">
        <div class="min-w-0">
          <p class="text-[13px] font-medium text-sage-dark/55">Teams</p>
          <p class="mt-0.5 text-[15px] font-medium text-charcoal">
            {employee.teams.length > 0 ? employee.teams.join(', ') : '—'}
          </p>
        </div>
        <p class="shrink-0 pt-0.5 text-xs text-sage-dark/45">Set by management</p>
      </div>
      <div class="mx-4 border-t border-sage-dark/10"></div>
      <div class="px-4 py-3.5">
        <p class="text-[13px] font-medium text-sage-dark/55">Email</p>
        <p class="mt-0.5 text-[15px] font-medium text-charcoal">{employee.email}</p>
      </div>
      <div class="mx-4 border-t border-sage-dark/10"></div>
      <div class="px-4 py-3.5">
        <p class="text-[13px] font-medium text-sage-dark/55">Roles</p>
        <p class="mt-0.5 text-[15px] font-medium text-charcoal">{roleLabel}</p>
      </div>
      <div class="mx-4 border-t border-sage-dark/10"></div>
      <div class="px-4 py-3.5">
        <p class="text-[13px] font-medium text-sage-dark/55">Status</p>
        <p class="mt-0.5 text-[15px] font-medium capitalize text-charcoal">{employee.status}</p>
      </div>
    </div>

    <form method="post" action="/api/session/sign-out" class="mt-6">
      <button
        class="w-full rounded-2xl border border-sage-dark/10 bg-white/90 px-4 py-3.5 text-[15px] font-medium text-red-700 shadow-sm transition hover:bg-red-50"
        type="submit"
      >
        Sign out
      </button>
    </form>
  </div>
</PortalLayout>

<script>
  function setupInlineFields(root: Element) {
    root.querySelectorAll('[data-field-row]').forEach((row) => {
      const edit = row.querySelector('[data-field-edit]');
      const cancel = row.querySelector('[data-field-cancel]');
      const display = row.querySelector('[data-field-display]');
      const editor = row.querySelector('[data-field-editor]');
      if (
        !(edit instanceof HTMLButtonElement) ||
        !(display instanceof HTMLElement) ||
        !(editor instanceof HTMLFormElement)
      ) {
        return;
      }

      const setOpen = (open: boolean) => {
        display.hidden = open;
        editor.hidden = !open;
        editor.classList.toggle('hidden', !open);
        edit.hidden = open;
        edit.setAttribute('aria-expanded', open ? 'true' : 'false');
        if (open) {
          const input = editor.querySelector('input:not([type="hidden"])');
          if (input instanceof HTMLInputElement) input.focus();
        }
      };

      edit.addEventListener('click', () => setOpen(true));
      cancel?.addEventListener('click', () => setOpen(false));
    });
  }

  function setupAvatarUpload(root: Element) {
    const input = root.querySelector('[data-avatar-input]');
    const form = root.querySelector('[data-avatar-form]');
    const dataField = root.querySelector('[data-avatar-data]');
    if (
      !(input instanceof HTMLInputElement) ||
      !(form instanceof HTMLFormElement) ||
      !(dataField instanceof HTMLInputElement)
    ) {
      return;
    }

    const resizeToDataUrl = (file: File): Promise<string> =>
      new Promise((resolve, reject) => {
        const reader = new FileReader();
        reader.onerror = () => reject(new Error('Could not read that image.'));
        reader.onload = () => {
          const image = new Image();
          image.onerror = () => reject(new Error('Could not load that image.'));
          image.onload = () => {
            const size = 256;
            const canvas = document.createElement('canvas');
            canvas.width = size;
            canvas.height = size;
            const ctx = canvas.getContext('2d');
            if (!ctx) {
              reject(new Error('Could not process that image.'));
              return;
            }
            const scale = Math.max(size / image.width, size / image.height);
            const w = image.width * scale;
            const h = image.height * scale;
            ctx.drawImage(image, (size - w) / 2, (size - h) / 2, w, h);
            resolve(canvas.toDataURL('image/jpeg', 0.88));
          };
          image.src = String(reader.result);
        };
        reader.readAsDataURL(file);
      });

    input.addEventListener('change', async () => {
      const file = input.files?.[0];
      if (!file) return;
      try {
        dataField.value = await resizeToDataUrl(file);
        form.submit();
      } catch (error) {
        const message = error instanceof Error ? error.message : 'Could not upload that photo.';
        window.alert(message);
      } finally {
        input.value = '';
      }
    });
  }

  const card = document.querySelector('[data-account-card]');
  if (card) {
    setupInlineFields(card);
    setupAvatarUpload(card);
  }
</script>
