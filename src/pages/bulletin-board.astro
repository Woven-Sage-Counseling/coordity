---
import '../styles/bulletin-board.css';
import PortalLayout from '../layouts/PortalLayout.astro';
import {
  BULLETIN_AUTHOR_COLORS,
  BULLETIN_IMAGE_MAX_EDGE,
  BULLETIN_MAX_IMAGE_BYTES,
  BULLETIN_MAX_PDF_BYTES,
  ensureDuplicatePinTwins,
  getBulletinBoardSettings,
  listBulletinBoardPins,
  serializePin,
  serializeRequest,
  writingModeForSurface,
  listBulletinBoardRequests,
} from '../lib/bulletin-board';
import { getHomeLayoutSettings, serializeHomeLayout } from '../lib/home-layout';
import { canAccessManagement } from '../lib/permissions';

export const prerender = false;

const employee = Astro.locals.employee!;
if (!canAccessManagement(employee)) {
  return new Response('Forbidden', { status: 403 });
}

const settings = await getBulletinBoardSettings();
if (settings.boardMode === 'duplicate') {
  await ensureDuplicatePinTwins();
}
const homeLayout = await getHomeLayoutSettings();
const allDraftPins = await listBulletinBoardPins({ channel: 'draft' });
const pending = await listBulletinBoardRequests({ status: 'pending' });
const writingMode = writingModeForSurface(settings.draftSurface);
const colors = BULLETIN_AUTHOR_COLORS;
const hasUnpublishedChanges =
  settings.draftUpdatedAt > (settings.publishedAt ?? 0) ||
  settings.draftSurface !== settings.surface;
const boardVariant = 'portrait' as const;

const payload = {
  surface: settings.draftSurface,
  liveSurface: settings.surface,
  boardMode: settings.boardMode,
  writingMode,
  colors,
  pins: allDraftPins.map((pin) => serializePin(pin, settings.draftSurface)),
  requests: pending.map(serializeRequest),
  maxImageBytes: BULLETIN_MAX_IMAGE_BYTES,
  maxPdfBytes: BULLETIN_MAX_PDF_BYTES,
  imageMaxEdge: BULLETIN_IMAGE_MAX_EDGE,
  draftUpdatedAt: settings.draftUpdatedAt,
  publishedAt: settings.publishedAt,
  hasUnpublishedChanges,
  boardVariant,
  layout: serializeHomeLayout(homeLayout),
};
---

<PortalLayout title="Bulletin board" wide>
  <p class="text-sm text-sage-dark/65">
    <a href="/" class="hover:text-sage-dark">Home</a>
    <span class="mx-1.5 text-sage-dark/35">/</span>
    <a href="/admin" class="hover:text-sage-dark">Admin</a>
    <span class="mx-1.5 text-sage-dark/35">/</span>
    Bulletin board
  </p>

  <div data-board-lab data-payload={JSON.stringify(payload)}>
    <div class="mt-3 flex flex-wrap items-end justify-between gap-4">
      <div>
        <h1 class="font-display text-4xl text-charcoal sm:text-5xl">Bulletin board</h1>
        <p class="mt-3 max-w-2xl text-sage-dark/75">
          Edit a private draft of the Home board. Nothing changes for the team until you click Update
          board.
        </p>
      </div>
      <div class="flex flex-col items-end gap-2">
        <p
          class:list={[
            'rounded-full border px-3 py-1 text-xs font-semibold uppercase tracking-[0.14em]',
            hasUnpublishedChanges
              ? 'border-amber-300/70 bg-amber-50 text-amber-900'
              : 'border-sage-dark/15 bg-white/80 text-sage-dark/70',
          ]}
          data-draft-badge
        >
          {hasUnpublishedChanges ? 'Draft / unpublished changes' : 'Draft matches live board'}
        </p>
        <button type="button" class="btn-primary !px-4 !py-2 text-sm" data-publish-board>
          Update board
        </button>
        <p class="hidden max-w-xs text-right text-xs text-sage-dark/60" data-publish-status></p>
        <p class="hidden max-w-xs text-right text-xs text-red-700" data-publish-error></p>
      </div>
    </div>

    <div class="mt-8 flex flex-wrap gap-2 border-b border-sage-dark/10 pb-3" role="tablist" aria-label="Bulletin board sections">
      <button type="button" class="rounded-full px-3.5 py-1.5 text-sm font-semibold" data-lab-tab="board" aria-selected="true">
        Draft board
      </button>
      <button type="button" class="rounded-full px-3.5 py-1.5 text-sm font-medium text-sage-dark/70" data-lab-tab="requests" aria-selected="false">
        Requests
        <span class="ml-1 rounded-full bg-amber-500 px-1.5 text-[10px] font-bold text-white" data-request-count>
          {pending.length}
        </span>
      </button>
      <button type="button" class="rounded-full px-3.5 py-1.5 text-sm font-medium text-sage-dark/70" data-lab-tab="surface" aria-selected="false">
        Surface
      </button>
      <button type="button" class="rounded-full px-3.5 py-1.5 text-sm font-medium text-sage-dark/70" data-lab-tab="layout" aria-selected="false">
        Home layout
      </button>
    </div>

    <section class="mt-6" data-lab-panel="board">
      <div class="flex flex-col gap-6 lg:flex-row lg:items-start">
        <div class="min-w-0 flex-1" data-board-canvas-wrap>
          <div class="mb-3 flex flex-wrap items-center gap-2">
            <p class="text-sm text-sage-dark/70">Edit arrangement for:</p>
            <div class="flex gap-1 rounded-full border border-sage-dark/15 bg-white/80 p-0.5" role="group" aria-label="Board shape">
              <button
                type="button"
                class="rounded-full px-3 py-1 text-xs font-semibold"
                data-variant-tab="portrait"
                aria-pressed="true"
              >
                Tall (rail)
              </button>
              <button
                type="button"
                class="rounded-full px-3 py-1 text-xs font-medium text-sage-dark/70"
                data-variant-tab="landscape"
                aria-pressed="false"
              >
                Wide (underneath)
              </button>
            </div>
          </div>
          <p class="mb-3 text-sm text-sage-dark/70" data-board-shape-hint>
            Tall pins appear in the right rail; wide pins appear underneath. Duplicate mode keeps
            the same notes with separate layouts.
          </p>
          <div
            class="board-surface board-frame relative"
            data-board-canvas
            data-board-shape="portrait"
            data-surface={settings.draftSurface}
          >
            <div class="pointer-events-none absolute inset-0 opacity-40" data-board-texture aria-hidden="true"></div>
          </div>
        </div>

        <div class="flex w-full max-w-sm flex-col gap-4 lg:sticky lg:top-6">
          <form class="rounded-2xl border border-sage-dark/10 bg-white/80 p-4 shadow-sm" data-admin-post-form>
            <h2 class="text-sm font-semibold text-charcoal">Add to draft</h2>
            <p class="mt-1 text-xs text-sage-dark/60">
              Places on this draft only. Large images are compressed automatically.
            </p>
            <label class="mt-3 block text-sm">
              <span class="font-medium text-charcoal">Type</span>
              <select name="kind" class="field mt-1" data-admin-kind>
                <option value="text">Text / sticky note</option>
                <option value="image">Photo / poster</option>
                <option value="pdf">PDF flyer</option>
              </select>
            </label>
            <label class="mt-3 block text-sm" data-admin-body-wrap>
              <span class="font-medium text-charcoal">Text</span>
              <textarea name="body" class="field mt-1 min-h-[4.5rem] resize-y text-sm" placeholder="Write something…" data-admin-body></textarea>
            </label>
            <label class="mt-3 block text-sm hidden" data-admin-file-wrap>
              <span class="font-medium text-charcoal">File</span>
              <input name="file" type="file" class="mt-1 block w-full text-sm" accept="image/*,application/pdf" data-admin-file />
              <span class="mt-1 block text-[11px] text-sage-dark/55" data-admin-file-hint>
                Photos compress to about 1MB. PDFs must be under 1.2MB.
              </span>
            </label>
            <button type="submit" class="btn-primary mt-4 !px-4 !py-2 text-sm" data-admin-submit>Place on draft</button>
            <p class="mt-2 hidden text-xs text-sage-dark/60" data-admin-status></p>
            <p class="mt-2 hidden text-xs text-red-700" data-admin-error></p>
          </form>

          <aside class="rounded-2xl border border-sage-dark/10 bg-white/80 p-4 shadow-sm" data-pin-inspector>
            <h2 class="text-sm font-semibold text-charcoal">Pin controls</h2>
            <p class="mt-2 text-sm text-sage-dark/60" data-inspector-empty>Select a pin on the board.</p>
            <div class="mt-3 hidden space-y-3" data-inspector-form>
              <label class="block text-sm">
                <span class="font-medium text-charcoal">Text</span>
                <textarea class="field mt-1 min-h-[5rem] resize-y text-sm" data-insp-body></textarea>
              </label>
              <label class="block text-sm">
                <span class="font-medium text-charcoal">Color</span>
                <div class="mt-2 flex flex-wrap gap-2" data-insp-colors></div>
              </label>
              <label class="block text-sm" data-insp-font-wrap>
                <span class="font-medium text-charcoal">Font size (<span data-insp-font-label>1.05</span>rem)</span>
                <input class="mt-2 w-full" type="range" min="0.7" max="2.5" step="0.05" data-insp-font />
              </label>
              <label class="block text-sm">
                <span class="font-medium text-charcoal">Width (<span data-insp-width-label>22</span>%)</span>
                <input class="mt-2 w-full" type="range" min="10" max="55" step="1" data-insp-width />
              </label>
              <label class="block text-sm">
                <span class="font-medium text-charcoal">Rotation (<span data-insp-rotation-label>0</span>°)</span>
                <input class="mt-2 w-full" type="range" min="-35" max="35" step="1" data-insp-rotation />
              </label>
              <label class="block text-sm">
                <span class="font-medium text-charcoal">Expires</span>
                <select class="field mt-1" data-insp-expires>
                  <option value="">Permanent until removed</option>
                  <option value="1d">In 1 day</option>
                  <option value="3d">In 3 days</option>
                  <option value="7d">In 7 days</option>
                  <option value="30d">In 30 days</option>
                </select>
              </label>
              <div class="flex flex-wrap gap-2 pt-1">
                <button type="button" class="btn-primary !px-3 !py-1.5 text-xs" data-insp-save>Save placement</button>
                <button type="button" class="text-xs font-medium text-red-700 hover:text-red-900" data-insp-remove>
                  Take off board
                </button>
              </div>
              <p class="hidden text-xs text-red-700" data-insp-error></p>
            </div>
          </aside>
        </div>
      </div>

      <dialog class="board-expand-dialog" data-board-expand>
        <div class="board-expand-panel">
          <div class="flex items-center justify-between gap-3 border-b border-black/5 px-4 py-3">
            <p class="text-sm font-semibold text-charcoal" data-expand-title>Item</p>
            <button type="button" class="text-sm font-medium text-sage-dark/70 hover:text-charcoal" data-expand-close>
              Close
            </button>
          </div>
          <div class="p-0" data-expand-body></div>
        </div>
      </dialog>
    </section>

    <section class="mt-6 hidden" data-lab-panel="requests">
      <div class="grid gap-6 lg:grid-cols-[minmax(0,1.1fr)_minmax(0,0.9fr)]">
        <div>
          <h2 class="text-sm font-semibold text-charcoal">Pending requests</h2>
          <p class="mt-1 text-sm text-sage-dark/65">Place onto the draft board, or reject.</p>
          <div class="mt-4 space-y-3" data-request-list></div>
          <p class="mt-4 hidden text-sm text-sage-dark/60" data-requests-empty>No pending requests.</p>
        </div>

        <form class="rounded-2xl border border-sage-dark/10 bg-white/80 p-5 shadow-sm" data-request-form>
          <h3 class="text-sm font-semibold text-charcoal">Create a pending request</h3>
          <p class="mt-1 text-xs text-sage-dark/60">
            Same flow employees use from Home — place it from the Requests list when ready.
          </p>
          <label class="mt-4 block text-sm">
            <span class="font-medium text-charcoal">Type</span>
            <select name="kind" class="field mt-1" data-request-kind>
              <option value="text">Text / sticky note</option>
              <option value="image">Photo / poster</option>
              <option value="pdf">PDF flyer</option>
            </select>
          </label>
          <label class="mt-3 block text-sm">
            <span class="font-medium text-charcoal">Message / caption</span>
            <textarea name="body" class="field mt-1 min-h-[5rem] resize-y" placeholder="Have a great weekend!" data-request-body></textarea>
          </label>
          <label class="mt-3 block text-sm" data-request-file-wrap>
            <span class="font-medium text-charcoal">File</span>
            <input name="file" type="file" class="mt-1 block w-full text-sm" accept="image/*,application/pdf" data-request-file />
            <span class="mt-1 block text-[11px] text-sage-dark/55">
              Photos compress to about 1MB. PDFs must be under 1.2MB.
            </span>
          </label>
          <button type="submit" class="btn-primary mt-4 !px-4 !py-2 text-sm">Submit request</button>
          <p class="mt-2 hidden text-xs text-red-700" data-request-error></p>
        </form>
      </div>
    </section>

    <section class="mt-6 hidden" data-lab-panel="surface">
      <h2 class="text-sm font-semibold text-charcoal">Draft surface</h2>
      <p class="mt-1 max-w-2xl text-sm text-sage-dark/65">
        Sets the company default board style on Home. Teammates can override their own view in
        Settings. Pin positions stay the same — sticky notes become chalk or marker ink in matching
        colors. Changes apply to the live board only after you click Update board.
      </p>
      <div class="mt-5 grid gap-3 sm:grid-cols-3" data-surface-picker>
        {
          [
            { id: 'cork', label: 'Cork board', hint: 'Sticky notes + tacks' },
            { id: 'blackboard', label: 'Blackboard', hint: 'Chalk writing' },
            { id: 'whiteboard', label: 'Whiteboard', hint: 'Marker writing' },
          ].map((option) => (
            <button
              type="button"
              class:list={[
                'rounded-2xl border px-4 py-4 text-left transition',
                settings.draftSurface === option.id
                  ? 'border-sage-dark/40 bg-sage/15 ring-2 ring-sage-dark/20'
                  : 'border-sage-dark/10 bg-white/80 hover:border-sage-dark/25',
              ]}
              data-surface-option={option.id}
            >
              <span class="block text-sm font-semibold text-charcoal">{option.label}</span>
              <span class="mt-1 block text-xs text-sage-dark/60">{option.hint}</span>
            </button>
          ))
        }
      </div>
      <p class="mt-3 text-sm text-sage-dark/70">
        Draft writing mode: <strong data-writing-mode>{writingMode}</strong>
        <span class="mx-2 text-sage-dark/30">·</span>
        Live Home surface: <strong data-live-surface>{settings.surface}</strong>
      </p>

      <h2 class="mt-10 text-sm font-semibold text-charcoal">Tall vs wide boards</h2>
      <div class="mt-3 max-w-2xl rounded-2xl border border-amber-300/50 bg-amber-50/80 px-4 py-3 text-sm text-amber-950">
        <p class="font-semibold">How the two shapes relate</p>
        <p class="mt-1.5 text-amber-950/85">
          <strong>Duplicate</strong> — same notes on both boards; you can rearrange tall and wide
          independently. Editing text or color updates both. Deleting removes both.
        </p>
        <p class="mt-1.5 text-amber-950/85">
          <strong>Separate</strong> — two unique boards. Pins you add on tall only exist there;
          wide is edited on its own.
        </p>
      </div>
      <div class="mt-4 flex flex-wrap gap-2" data-board-mode-picker>
        <button
          type="button"
          class:list={[
            'rounded-full border px-3.5 py-1.5 text-sm font-semibold transition',
            settings.boardMode === 'duplicate'
              ? 'border-sage-dark/35 bg-sage/15'
              : 'border-sage-dark/15 bg-white/80 text-sage-dark/70',
          ]}
          data-board-mode="duplicate"
          aria-pressed={settings.boardMode === 'duplicate' ? 'true' : 'false'}
        >
          Duplicate
        </button>
        <button
          type="button"
          class:list={[
            'rounded-full border px-3.5 py-1.5 text-sm font-semibold transition',
            settings.boardMode === 'separate'
              ? 'border-sage-dark/35 bg-sage/15'
              : 'border-sage-dark/15 bg-white/80 text-sage-dark/70',
          ]}
          data-board-mode="separate"
          aria-pressed={settings.boardMode === 'separate' ? 'true' : 'false'}
        >
          Separate
        </button>
      </div>
      <p class="mt-2 hidden text-sm text-sage-dark/70" data-board-mode-status></p>
      <p class="mt-2 hidden text-sm text-red-700" data-board-mode-error></p>
    </section>

    <section class="mt-6 hidden" data-lab-panel="layout">
      <h2 class="text-sm font-semibold text-charcoal">Home layout defaults</h2>
      <p class="mt-1 max-w-2xl text-sm text-sage-dark/65">
        Company defaults for the right rail and underneath area. Each person can override these in
        Settings. The board may appear in both places at once (tall in the rail, wide underneath).
      </p>

      <form class="mt-6 max-w-xl space-y-6" data-home-layout-form>
        <fieldset class="rounded-2xl border border-sage-dark/10 bg-white/80 p-4 shadow-sm">
          <legend class="px-1 text-sm font-semibold text-charcoal">Right rail</legend>
          {
            (
              [
                { value: 'board', label: 'Bulletin board (tall)' },
                { value: 'widgets', label: 'Widgets' },
                { value: 'company', label: 'Company logo' },
                { value: 'portal', label: 'Portal mark' },
                { value: 'custom', label: 'Custom picture' },
                { value: 'none', label: 'Nothing' },
              ] as const
            ).map((option) => (
              <label class="mt-3 flex items-center gap-2 text-sm text-charcoal">
                <input
                  type="radio"
                  name="railSlot"
                  value={option.value}
                  data-layout-rail
                  checked={homeLayout.railSlot === option.value}
                />
                {option.label}
              </label>
            ))
          }
          <label class="mt-4 block text-sm" data-layout-image-upload-wrap>
            <span class="font-medium text-charcoal">Upload image</span>
            <input name="railImage" type="file" accept="image/jpeg,image/png,image/webp,image/gif" class="mt-1 block w-full text-sm" />
            <span class="mt-1 block text-[11px] text-sage-dark/55">
              Used for custom or company logo. Max about 1.2MB.
              {homeLayout.hasRailImage ? ' A picture is already saved.' : ''}
            </span>
          </label>
          {
            homeLayout.hasRailImage ? (
              <label class="mt-2 flex items-center gap-2 text-sm text-sage-dark/80">
                <input type="checkbox" name="clearRailImage" value="1" />
                Remove saved picture
              </label>
            ) : null
          }
        </fieldset>

        <fieldset class="rounded-2xl border border-sage-dark/10 bg-white/80 p-4 shadow-sm">
          <legend class="px-1 text-sm font-semibold text-charcoal">Underneath</legend>
          <label class="mt-3 flex items-center gap-2 text-sm text-charcoal">
            <input type="radio" name="belowSlot" value="none" data-layout-below checked={homeLayout.belowSlot === 'none'} />
            Nothing
          </label>
          <label class="mt-2 flex items-center gap-2 text-sm text-charcoal">
            <input type="radio" name="belowSlot" value="board" data-layout-below checked={homeLayout.belowSlot === 'board'} />
            Bulletin board (wide)
          </label>
          <label class="mt-2 flex items-center gap-2 text-sm text-charcoal">
            <input type="radio" name="belowSlot" value="widgets" data-layout-below checked={homeLayout.belowSlot === 'widgets'} />
            Widgets
          </label>
        </fieldset>

        <button type="submit" class="btn-primary !px-4 !py-2 text-sm" data-layout-save>Save home layout</button>
        <p class="hidden text-sm text-sage-dark/70" data-layout-status></p>
        <p class="hidden text-sm text-red-700" data-layout-error></p>
      </form>
    </section>
  </div>
</PortalLayout>

<style is:global>
  @import url('https://fonts.googleapis.com/css2?family=Caveat:wght@500;600&family=Patrick+Hand&family=Permanent+Marker&display=swap');
</style>

<script is:inline>
  function setupBoardLab(root) {
    let state = JSON.parse(root.dataset.payload || '{}');
    let selectedId = null;
    let drag = null;
    const maxImageBytes = Number(state.maxImageBytes) || 1000000;
    const maxPdfBytes = Number(state.maxPdfBytes) || 1200000;
    const imageMaxEdge = Number(state.imageMaxEdge) || 1600;

    function loadImage(file) {
      return new Promise((resolve, reject) => {
        const url = URL.createObjectURL(file);
        const image = new Image();
        image.onload = () => {
          URL.revokeObjectURL(url);
          resolve(image);
        };
        image.onerror = () => {
          URL.revokeObjectURL(url);
          reject(new Error('Could not read that image.'));
        };
        image.src = url;
      });
    }

    function canvasToBlob(canvas, type, quality) {
      return new Promise((resolve) => canvas.toBlob((blob) => resolve(blob), type, quality));
    }

    async function compressBoardImage(file) {
      if (!(file instanceof File) || !file.type.startsWith('image/')) return file;

      const image = await loadImage(file);
      const needsResize = Math.max(image.width, image.height) > imageMaxEdge;
      if (!needsResize && file.size <= maxImageBytes) return file;

      const scale = Math.min(1, imageMaxEdge / Math.max(image.width, image.height));
      const width = Math.max(1, Math.round(image.width * scale));
      const height = Math.max(1, Math.round(image.height * scale));
      const scratch = document.createElement('canvas');
      scratch.width = width;
      scratch.height = height;
      const ctx = scratch.getContext('2d');
      if (!ctx) throw new Error('Could not compress that image.');
      ctx.fillStyle = '#ffffff';
      ctx.fillRect(0, 0, width, height);
      ctx.drawImage(image, 0, 0, width, height);

      const qualities = [0.88, 0.8, 0.72, 0.64];
      let best = null;
      for (const quality of qualities) {
        const blob = await canvasToBlob(scratch, 'image/jpeg', quality);
        if (!blob) continue;
        best = blob;
        if (blob.size <= maxImageBytes) break;
      }
      if (!best) throw new Error('Could not compress that image.');
      if (best.size > maxImageBytes) {
        throw new Error('Image is still too large after compression. Try a smaller photo.');
      }
      const baseName = (file.name || 'photo').replace(/\.[^.]+$/, '') || 'photo';
      return new File([best], baseName + '.jpg', { type: 'image/jpeg', lastModified: Date.now() });
    }

    async function prepareUploadFile(kind, file) {
      if (!(file instanceof File) || file.size <= 0) {
        if (kind === 'image' || kind === 'pdf') throw new Error('Choose a file to upload.');
        return null;
      }
      if (kind === 'image') {
        if (!/^image\/(jpeg|png|webp|gif)$/i.test(file.type)) {
          throw new Error('Use a JPEG, PNG, WebP, or GIF image.');
        }
        return compressBoardImage(file);
      }
      if (kind === 'pdf') {
        if (file.type !== 'application/pdf') throw new Error('Upload a PDF file.');
        if (file.size > maxPdfBytes) throw new Error('PDF is too large (max about 1.2MB).');
        return file;
      }
      return null;
    }

    const canvas = root.querySelector('[data-board-canvas]');
    const requestList = root.querySelector('[data-request-list]');
    const requestsEmpty = root.querySelector('[data-requests-empty]');
    const requestCount = root.querySelector('[data-request-count]');
    const inspectorEmpty = root.querySelector('[data-inspector-empty]');
    const inspectorForm = root.querySelector('[data-inspector-form]');
    const inspBody = root.querySelector('[data-insp-body]');
    const inspColors = root.querySelector('[data-insp-colors]');
    const inspFont = root.querySelector('[data-insp-font]');
    const inspFontLabel = root.querySelector('[data-insp-font-label]');
    const inspFontWrap = root.querySelector('[data-insp-font-wrap]');
    const inspWidth = root.querySelector('[data-insp-width]');
    const inspWidthLabel = root.querySelector('[data-insp-width-label]');
    const inspRotation = root.querySelector('[data-insp-rotation]');
    const inspRotationLabel = root.querySelector('[data-insp-rotation-label]');
    const inspExpires = root.querySelector('[data-insp-expires]');
    const inspError = root.querySelector('[data-insp-error]');
    const writingModeEl = root.querySelector('[data-writing-mode]');
    const liveSurfaceEl = root.querySelector('[data-live-surface]');
    const draftBadge = root.querySelector('[data-draft-badge]');
    const publishBtn = root.querySelector('[data-publish-board]');
    const publishStatus = root.querySelector('[data-publish-status]');
    const publishError = root.querySelector('[data-publish-error]');
    const adminPostForm = root.querySelector('[data-admin-post-form]');
    const adminKind = root.querySelector('[data-admin-kind]');
    const adminBodyWrap = root.querySelector('[data-admin-body-wrap]');
    const adminFileWrap = root.querySelector('[data-admin-file-wrap]');
    const adminStatus = root.querySelector('[data-admin-status]');
    const adminError = root.querySelector('[data-admin-error]');
    const adminSubmit = root.querySelector('[data-admin-submit]');

    function markDraftDirty() {
      state.hasUnpublishedChanges = true;
      if (draftBadge instanceof HTMLElement) {
        draftBadge.textContent = 'Draft / unpublished changes';
        draftBadge.className =
          'rounded-full border border-amber-300/70 bg-amber-50 px-3 py-1 text-xs font-semibold uppercase tracking-[0.14em] text-amber-900';
      }
    }

    function markDraftPublished(liveSurface) {
      state.hasUnpublishedChanges = false;
      state.liveSurface = liveSurface || state.surface;
      if (draftBadge instanceof HTMLElement) {
        draftBadge.textContent = 'Draft matches live board';
        draftBadge.className =
          'rounded-full border border-sage-dark/15 bg-white/80 px-3 py-1 text-xs font-semibold uppercase tracking-[0.14em] text-sage-dark/70';
      }
      if (liveSurfaceEl) liveSurfaceEl.textContent = state.liveSurface;
    }

    if (!(canvas instanceof HTMLElement)) return;

    const showTab = (id) => {
      root.querySelectorAll('[data-lab-tab]').forEach((btn) => {
        if (!(btn instanceof HTMLButtonElement)) return;
        const active = btn.dataset.labTab === id;
        btn.setAttribute('aria-selected', active ? 'true' : 'false');
        btn.className = active
          ? 'rounded-full px-3.5 py-1.5 text-sm font-semibold text-charcoal bg-sage/20'
          : 'rounded-full px-3.5 py-1.5 text-sm font-medium text-sage-dark/70 hover:bg-sage/10';
      });
      root.querySelectorAll('[data-lab-panel]').forEach((panel) => {
        if (!(panel instanceof HTMLElement)) return;
        panel.classList.toggle('hidden', panel.dataset.labPanel !== id);
      });
    };

    root.querySelectorAll('[data-lab-tab]').forEach((btn) => {
      btn.addEventListener('click', () => {
        if (!(btn instanceof HTMLButtonElement)) return;
        showTab(btn.dataset.labTab || 'board');
      });
    });
    showTab('board');

    async function postForm(url, data) {
      const form = new FormData();
      for (const [key, value] of Object.entries(data)) {
        if (value == null) continue;
        form.append(key, value instanceof Blob ? value : String(value));
      }
      const res = await fetch(url, {
        method: 'POST',
        body: form,
        headers: { Accept: 'application/json' },
      });
      const json = await res.json().catch(() => ({}));
      if (!res.ok) throw new Error(json.error || 'Request failed.');
      return json;
    }

    function escapeHtml(value) {
      return value
        .replaceAll('&', '&amp;')
        .replaceAll('<', '&lt;')
        .replaceAll('>', '&gt;')
        .replaceAll('"', '&quot;');
    }

    function linkifyHtml(value) {
      return escapeHtml(value).replace(/(https?:\/\/[^\s<]+|www\.[^\s<]+)/gi, (raw) => {
        let url = raw;
        let trailing = '';
        while (/[.,!?);:\]]$/.test(url)) {
          trailing = url.slice(-1) + trailing;
          url = url.slice(0, -1);
        }
        if (!url) return raw;
        const href = url.startsWith('http') ? url : 'https://' + url;
        return '<a href="' + href + '" target="_blank" rel="noopener noreferrer">' + url + '</a>' + trailing;
      });
    }

    const zoomIcon = '<svg width="12" height="12" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.25" stroke="currentColor" stroke-width="1.75"/><path d="M15.5 15.5L20 20" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/></svg>';

    const expandDialog = root.querySelector('[data-board-expand]');
    const expandTitle = root.querySelector('[data-expand-title]');
    const expandBody = root.querySelector('[data-expand-body]');
    root.querySelector('[data-expand-close]')?.addEventListener('click', () => {
      if (expandDialog instanceof HTMLDialogElement) expandDialog.close();
    });
    expandDialog?.addEventListener('click', (event) => {
      if (event.target === expandDialog) expandDialog.close();
    });

    function openExpand(pin) {
      if (!(expandDialog instanceof HTMLDialogElement) || !(expandBody instanceof HTMLElement)) return;
      if (expandTitle instanceof HTMLElement) {
        expandTitle.textContent = pin.kind === 'pdf' ? (pin.fileName || 'PDF') : pin.kind === 'image' ? 'Photo' : 'Note';
      }
      if (pin.kind === 'image' && pin.fileUrl) {
        expandBody.innerHTML = '<img src="' + pin.fileUrl + '" alt="" />';
      } else if (pin.kind === 'pdf' && pin.fileUrl) {
        expandBody.innerHTML = '<iframe src="' + pin.fileUrl + '" title="' + escapeHtml(pin.fileName || 'PDF') + '"></iframe>';
      } else {
        expandBody.innerHTML = '<div class="whitespace-pre-wrap px-5 py-4 text-sm text-charcoal">' + linkifyHtml(pin.body || '') + '</div>';
      }
      expandDialog.showModal();
    }

    function syncLinkedPinContent(sourcePin) {
      if (!sourcePin?.linkId) return;
      state.pins.forEach((other) => {
        if (other.id === sourcePin.id || other.linkId !== sourcePin.linkId) return;
        other.body = sourcePin.body;
        other.color = sourcePin.color;
        other.fontSizeRem = sourcePin.fontSizeRem;
        other.expiresAt = sourcePin.expiresAt;
      });
    }

    async function savePinPlacement(pin, options = {}) {
      if (!pin) return null;
      const body =
        options.body !== undefined
          ? options.body
          : inspBody instanceof HTMLTextAreaElement && selectedId === pin.id
            ? inspBody.value
            : pin.body;
      const expiresValue =
        options.expiresValue !== undefined
          ? options.expiresValue
          : inspExpires instanceof HTMLSelectElement && selectedId === pin.id
            ? inspExpires.value
            : '';
      let expiresAt = null;
      let clearExpires = false;
      if (!expiresValue) clearExpires = true;
      else {
        const days = Number(String(expiresValue).replace('d', ''));
        expiresAt = Date.now() + days * 24 * 60 * 60 * 1000;
      }

      const json = await postForm('/api/bulletin-board/pins/update', {
        id: pin.id,
        body,
        color: pin.color,
        fontSizeRem: pin.fontSizeRem,
        widthPct: pin.widthPct,
        rotationDeg: pin.rotationDeg,
        xPct: pin.xPct,
        yPct: pin.yPct,
        clearExpires: clearExpires ? '1' : '0',
        expiresAt,
      });

      // Keep geometry from local state; only take content fields from the response
      // so a remapped color/body cannot fight with concurrent position saves.
      if (json.pin) {
        pin.body = json.pin.body;
        pin.color = json.pin.color;
        pin.fontSizeRem = json.pin.fontSizeRem;
        pin.widthPct = json.pin.widthPct;
        pin.rotationDeg = json.pin.rotationDeg;
        pin.expiresAt = json.pin.expiresAt;
        pin.xPct = json.pin.xPct ?? pin.xPct;
        pin.yPct = json.pin.yPct ?? pin.yPct;
      } else {
        pin.body = body;
      }
      syncLinkedPinContent(pin);
      markDraftDirty();
      return json.pin;
    }

    async function flushInspectorForPin(pinId) {
      const pin = state.pins.find((item) => item.id === pinId);
      if (!pin) return;
      const nextBody = inspBody instanceof HTMLTextAreaElement ? inspBody.value : pin.body;
      const bodyChanged = String(nextBody ?? '') !== String(pin.body ?? '');
      const dirty =
        bodyChanged ||
        (inspWidth instanceof HTMLInputElement && Number(inspWidth.value) !== Number(pin.widthPct)) ||
        (inspFont instanceof HTMLInputElement && Number(inspFont.value) !== Number(pin.fontSizeRem)) ||
        (inspRotation instanceof HTMLInputElement &&
          Number(inspRotation.value) !== Number(pin.rotationDeg));
      if (!dirty) return;
      try {
        if (inspWidth instanceof HTMLInputElement) pin.widthPct = Number(inspWidth.value);
        if (inspFont instanceof HTMLInputElement) pin.fontSizeRem = Number(inspFont.value);
        if (inspRotation instanceof HTMLInputElement) pin.rotationDeg = Number(inspRotation.value);
        await savePinPlacement(pin, { body: nextBody });
        renderBoard();
      } catch (error) {
        console.error(error);
      }
    }

    function renderPin(pin) {
      const el = document.createElement('div');
      el.className = 'board-pin';
      el.dataset.pinId = pin.id;
      el.dataset.editable = 'true';
      el.dataset.selected = pin.id === selectedId ? 'true' : 'false';
      const expandable = pin.kind === 'image' || pin.kind === 'pdf' || Boolean(pin.body && pin.body.length > 80);
      el.dataset.expandable = expandable ? 'true' : 'false';
      el.style.left = `${pin.xPct}%`;
      el.style.top = `${pin.yPct}%`;
      el.style.width = `${pin.widthPct}%`;
      el.style.zIndex = String(pin.zIndex);
      el.style.transform = `rotate(${pin.rotationDeg}deg)`;

      const tack = `<span class="board-pin-tack" aria-hidden="true"></span>`;
      let inner = '';
      if (pin.kind === 'text') {
        const fontSize = Number(pin.fontSizeRem) || 1.05;
        inner = `<div class="board-pin-body whitespace-pre-wrap" data-font-size style="--board-font-size:${fontSize}rem;background:${pin.color};color:${state.surface === 'cork' ? '#1f2937' : pin.color}">${linkifyHtml(pin.body || '')}</div>`;
      } else if (pin.kind === 'image' && pin.fileUrl) {
        inner = `<div class="board-pin-body" style="background:${state.surface === 'cork' ? '#fff7ed' : 'transparent'}"><img class="board-pin-media" src="${pin.fileUrl}" alt="" draggable="false" /></div>`;
      } else {
        inner = `<div class="board-pin-body" style="background:${state.surface === 'cork' ? '#fff7ed' : 'transparent'}"><div class="board-pin-pdf"><span>PDF</span><span>${escapeHtml(pin.fileName || 'Flyer')}</span></div></div>`;
      }
      const zoom = expandable
        ? `<button type="button" class="board-pin-zoom" aria-label="Expand item" data-board-zoom>${zoomIcon}</button>`
        : '';
      el.innerHTML = tack + inner + zoom;

      el.querySelector('[data-board-zoom]')?.addEventListener('pointerdown', (event) => {
        event.preventDefault();
        event.stopPropagation();
      });
      el.querySelector('[data-board-zoom]')?.addEventListener('click', (event) => {
        event.preventDefault();
        event.stopPropagation();
        openExpand(pin);
      });

      el.addEventListener('pointerdown', (event) => {
        if (event.button !== 0) return;
        if (event.target && event.target.closest && (event.target.closest('a') || event.target.closest('[data-board-zoom]'))) return;
        event.preventDefault();
        const previousId = selectedId;
        selectedId = pin.id;
        drag = {
          id: pin.id,
          startX: event.clientX,
          startY: event.clientY,
          origX: pin.xPct,
          origY: pin.yPct,
          moved: false,
        };
        el.setPointerCapture(event.pointerId);
        el.dataset.dragging = 'true';
        if (previousId && previousId !== pin.id) {
          void flushInspectorForPin(previousId);
        }
        renderBoard();
        renderInspector();
      });

      el.addEventListener('pointermove', (event) => {
        if (!drag || drag.id !== pin.id || !(canvas instanceof HTMLElement)) return;
        const rect = canvas.getBoundingClientRect();
        const dx = ((event.clientX - drag.startX) / rect.width) * 100;
        const dy = ((event.clientY - drag.startY) / rect.height) * 100;
        if (Math.abs(dx) > 0.15 || Math.abs(dy) > 0.15) drag.moved = true;
        pin.xPct = Math.min(92, Math.max(-4, drag.origX + dx));
        pin.yPct = Math.min(92, Math.max(-4, drag.origY + dy));
        el.style.left = `${pin.xPct}%`;
        el.style.top = `${pin.yPct}%`;
      });

      const endDrag = async () => {
        if (!drag || drag.id !== pin.id) return;
        const didMove = Boolean(drag.moved);
        el.dataset.dragging = 'false';
        drag = null;
        if (!didMove) return;
        try {
          await postForm('/api/bulletin-board/pins/update', {
            id: pin.id,
            xPct: pin.xPct,
            yPct: pin.yPct,
          });
          // Do not Object.assign the full pin — a stale position response can wipe a newer body edit.
          markDraftDirty();
        } catch (error) {
          console.error(error);
        }
      };

      el.addEventListener('pointerup', endDrag);
      el.addEventListener('pointercancel', endDrag);
      return el;
    }

    function visiblePins() {
      const variant = state.boardVariant || 'portrait';
      return (state.pins || []).filter((pin) => (pin.boardVariant || 'portrait') === variant);
    }

    function setBoardVariant(variant) {
      state.boardVariant = variant === 'landscape' ? 'landscape' : 'portrait';
      root.querySelectorAll('[data-variant-tab]').forEach((btn) => {
        if (!(btn instanceof HTMLButtonElement)) return;
        const active = btn.dataset.variantTab === state.boardVariant;
        btn.setAttribute('aria-pressed', active ? 'true' : 'false');
        btn.className = active
          ? 'rounded-full px-3 py-1 text-xs font-semibold text-charcoal bg-sage/20'
          : 'rounded-full px-3 py-1 text-xs font-medium text-sage-dark/70 hover:bg-sage/10';
      });
      selectedId = null;
      renderBoard();
      renderInspector();
    }

    root.querySelectorAll('[data-variant-tab]').forEach((btn) => {
      btn.addEventListener('click', () => {
        if (!(btn instanceof HTMLButtonElement)) return;
        setBoardVariant(btn.dataset.variantTab || 'portrait');
      });
    });

    function renderBoard() {
      canvas.dataset.surface = state.surface;
      canvas.dataset.boardShape = state.boardVariant || 'portrait';
      const wrap = root.querySelector('[data-board-canvas-wrap]');
      if (wrap instanceof HTMLElement) {
        wrap.classList.toggle('shrink-0', state.boardVariant !== 'landscape');
        wrap.classList.toggle('flex-1', state.boardVariant === 'landscape');
      }
      const hint = root.querySelector('[data-board-shape-hint]');
      if (hint) {
        hint.textContent =
          state.boardVariant === 'landscape'
            ? 'Editing the wide (underneath) board. Changes stay here until you update the live board.'
            : 'Editing the tall (rail) board. Changes stay here until you update the live board.';
      }
      canvas.querySelectorAll('[data-pin-id]').forEach((node) => node.remove());
      visiblePins().forEach((pin) => canvas.appendChild(renderPin(pin)));
    }

    function renderRequests() {
      if (!(requestList instanceof HTMLElement)) return;
      requestList.innerHTML = '';
      if (requestCount) requestCount.textContent = String(state.requests.length);
      if (requestsEmpty instanceof HTMLElement) {
        requestsEmpty.classList.toggle('hidden', state.requests.length > 0);
      }
      state.requests.forEach((request) => {
        const card = document.createElement('article');
        card.className = 'rounded-2xl border border-sage-dark/10 bg-white/80 p-4 shadow-sm';
        const preview =
          request.kind === 'text'
            ? `<p class="mt-2 text-sm text-charcoal whitespace-pre-wrap">${escapeHtml(request.body || '')}</p>`
            : request.kind === 'image' && request.fileUrl
              ? `<img class="mt-2 max-h-40 rounded-lg object-cover" src="${request.fileUrl}" alt="" />`
              : `<p class="mt-2 text-sm text-sage-dark/70">PDF: ${escapeHtml(request.fileName || 'file')}</p>`;
        card.innerHTML = `
          <div class="flex items-start justify-between gap-3">
            <div>
              <p class="text-sm font-semibold text-charcoal">${escapeHtml(request.submitterName)}</p>
              <p class="text-xs uppercase tracking-[0.12em] text-sage-dark/50">${request.kind}</p>
            </div>
          </div>
          ${preview}
          <div class="mt-3 flex flex-wrap gap-2">
            <button type="button" class="btn-primary !px-3 !py-1.5 text-xs" data-place-request="${request.id}">Place on draft</button>
            <button type="button" class="text-xs font-medium text-red-700 hover:text-red-900" data-reject-request="${request.id}">Reject</button>
          </div>
        `;
        requestList.appendChild(card);
      });
    }

    function renderInspector() {
      const pin = visiblePins().find((item) => item.id === selectedId) ?? null;
      if (!(inspectorEmpty instanceof HTMLElement) || !(inspectorForm instanceof HTMLElement)) return;
      if (!pin) {
        inspectorEmpty.classList.remove('hidden');
        inspectorForm.classList.add('hidden');
        return;
      }
      inspectorEmpty.classList.add('hidden');
      inspectorForm.classList.remove('hidden');
      if (inspBody instanceof HTMLTextAreaElement) {
        inspBody.value = pin.body || '';
        inspBody.disabled = pin.kind !== 'text';
      }
      if (inspFontWrap instanceof HTMLElement) {
        inspFontWrap.classList.toggle('hidden', pin.kind !== 'text');
      }
      if (inspFont instanceof HTMLInputElement) {
        inspFont.value = String(Number(pin.fontSizeRem) || 1.05);
      }
      if (inspFontLabel) {
        inspFontLabel.textContent = (Number(pin.fontSizeRem) || 1.05).toFixed(2);
      }
      if (inspWidth instanceof HTMLInputElement) {
        inspWidth.value = String(Math.round(pin.widthPct));
      }
      if (inspWidthLabel) inspWidthLabel.textContent = String(Math.round(pin.widthPct));
      if (inspRotation instanceof HTMLInputElement) {
        inspRotation.value = String(Math.round(pin.rotationDeg));
      }
      if (inspRotationLabel) inspRotationLabel.textContent = String(Math.round(pin.rotationDeg));
      if (inspExpires instanceof HTMLSelectElement) {
        inspExpires.value = '';
      }
      if (inspColors instanceof HTMLElement) {
        inspColors.innerHTML = '';
        state.colors.forEach((color) => {
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.className =
            'h-7 w-7 rounded-full ring-1 ring-black/10 ' +
            (color === pin.color ? 'ring-2 ring-offset-2 ring-charcoal' : '');
          btn.style.background = color;
          btn.addEventListener('click', () => {
            pin.color = color;
            renderBoard();
            renderInspector();
          });
          inspColors.appendChild(btn);
        });
      }
      if (inspError instanceof HTMLElement) {
        inspError.classList.add('hidden');
        inspError.textContent = '';
      }
    }

    inspWidth?.addEventListener('input', () => {
      const pin = state.pins.find((item) => item.id === selectedId);
      if (!pin || !(inspWidth instanceof HTMLInputElement)) return;
      pin.widthPct = Number(inspWidth.value);
      if (inspWidthLabel) inspWidthLabel.textContent = inspWidth.value;
      renderBoard();
    });

    inspFont?.addEventListener('input', () => {
      const pin = state.pins.find((item) => item.id === selectedId);
      if (!pin || !(inspFont instanceof HTMLInputElement)) return;
      pin.fontSizeRem = Number(inspFont.value);
      if (inspFontLabel) inspFontLabel.textContent = Number(inspFont.value).toFixed(2);
      renderBoard();
    });

    inspRotation?.addEventListener('input', () => {
      const pin = state.pins.find((item) => item.id === selectedId);
      if (!pin || !(inspRotation instanceof HTMLInputElement)) return;
      pin.rotationDeg = Number(inspRotation.value);
      if (inspRotationLabel) inspRotationLabel.textContent = inspRotation.value;
      renderBoard();
    });

    root.querySelector('[data-insp-save]')?.addEventListener('click', async () => {
      const pin = state.pins.find((item) => item.id === selectedId);
      if (!pin) return;
      try {
        await savePinPlacement(pin);
        renderBoard();
        renderInspector();
      } catch (error) {
        if (inspError instanceof HTMLElement) {
          inspError.textContent = error instanceof Error ? error.message : 'Save failed.';
          inspError.classList.remove('hidden');
        }
      }
    });

    root.querySelector('[data-insp-remove]')?.addEventListener('click', async () => {
      const pin = state.pins.find((item) => item.id === selectedId);
      if (!pin) return;
      if (!confirm('Remove this from the draft board?')) return;
      await postForm('/api/bulletin-board/pins/remove', { id: pin.id });
      if (pin.linkId) {
        state.pins = state.pins.filter((item) => item.linkId !== pin.linkId);
      } else {
        state.pins = state.pins.filter((item) => item.id !== pin.id);
      }
      selectedId = null;
      markDraftDirty();
      renderBoard();
      renderInspector();
    });

    requestList?.addEventListener('click', async (event) => {
      const target = event.target instanceof Element ? event.target : event.target.parentElement;
      if (!target) return;
      const placeId = target.closest('[data-place-request]')?.getAttribute('data-place-request');
      const rejectId = target.closest('[data-reject-request]')?.getAttribute('data-reject-request');
      if (placeId) {
        await postForm('/api/bulletin-board/pins/place', {
          requestId: placeId,
          color: state.colors[0],
          rotationDeg: Math.round(Math.random() * 10 - 5),
          boardVariant: state.boardVariant || 'portrait',
        });
        // Reload pins so duplicate twins appear in state.
        window.location.reload();
        return;
      }
      if (rejectId) {
        await postForm('/api/bulletin-board/requests/reject', { id: rejectId });
        state.requests = state.requests.filter((item) => item.id !== rejectId);
        renderRequests();
      }
    });

    const requestForm = root.querySelector('[data-request-form]');
    const requestKind = root.querySelector('[data-request-kind]');
    const requestFileWrap = root.querySelector('[data-request-file-wrap]');
    const requestError = root.querySelector('[data-request-error]');

    const syncRequestKind = () => {
      if (!(requestKind instanceof HTMLSelectElement) || !(requestFileWrap instanceof HTMLElement)) return;
      requestFileWrap.classList.toggle('hidden', requestKind.value === 'text');
    };
    requestKind?.addEventListener('change', syncRequestKind);
    syncRequestKind();

    requestForm?.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!(requestForm instanceof HTMLFormElement)) return;
      if (requestError instanceof HTMLElement) requestError.classList.add('hidden');
      const kind = requestKind instanceof HTMLSelectElement ? requestKind.value : 'text';
      const fileInput = requestForm.querySelector('[data-request-file]');
      try {
        const prepared = await prepareUploadFile(
          kind,
          fileInput instanceof HTMLInputElement ? fileInput.files?.[0] : null,
        );
        const form = new FormData(requestForm);
        if (prepared) form.set('file', prepared);
        else form.delete('file');
        const res = await fetch('/api/bulletin-board/requests/create', {
          method: 'POST',
          body: form,
          headers: { Accept: 'application/json' },
        });
        const json = await res.json();
        if (!res.ok) throw new Error(json.error || 'Could not submit.');
        state.requests.unshift(json.request);
        requestForm.reset();
        syncRequestKind();
        renderRequests();
      } catch (error) {
        if (requestError instanceof HTMLElement) {
          requestError.textContent = error instanceof Error ? error.message : 'Submit failed.';
          requestError.classList.remove('hidden');
        }
      }
    });

    root.querySelectorAll('[data-surface-option]').forEach((btn) => {
      btn.addEventListener('click', async () => {
        if (!(btn instanceof HTMLButtonElement)) return;
        const surface = btn.dataset.surfaceOption;
        if (!surface) return;
        const json = await postForm('/api/bulletin-board/surface', { surface });
        state.surface = json.surface;
        state.liveSurface = json.liveSurface || state.liveSurface;
        state.writingMode = json.writingMode;
        state.colors = json.colors;
        state.pins = json.pins;
        markDraftDirty();
        if (writingModeEl) writingModeEl.textContent = state.writingMode;
        if (liveSurfaceEl && state.liveSurface) liveSurfaceEl.textContent = state.liveSurface;
        root.querySelectorAll('[data-surface-option]').forEach((node) => {
          if (!(node instanceof HTMLButtonElement)) return;
          const active = node.dataset.surfaceOption === surface;
          node.className = active
            ? 'rounded-2xl border border-sage-dark/40 bg-sage/15 px-4 py-4 text-left ring-2 ring-sage-dark/20 transition'
            : 'rounded-2xl border border-sage-dark/10 bg-white/80 px-4 py-4 text-left transition hover:border-sage-dark/25';
        });
        renderBoard();
        renderInspector();
      });
    });

    const syncAdminKind = () => {
      const kind = adminKind instanceof HTMLSelectElement ? adminKind.value : 'text';
      if (adminBodyWrap instanceof HTMLElement) {
        adminBodyWrap.classList.toggle('hidden', kind !== 'text');
      }
      if (adminFileWrap instanceof HTMLElement) {
        adminFileWrap.classList.toggle('hidden', kind === 'text');
      }
    };
    adminKind?.addEventListener('change', syncAdminKind);
    syncAdminKind();

    adminPostForm?.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!(adminPostForm instanceof HTMLFormElement)) return;
      if (adminError instanceof HTMLElement) {
        adminError.classList.add('hidden');
        adminError.textContent = '';
      }
      if (adminStatus instanceof HTMLElement) {
        adminStatus.classList.add('hidden');
        adminStatus.textContent = '';
      }

      const kind = adminKind instanceof HTMLSelectElement ? adminKind.value : 'text';
      const bodyInput = adminPostForm.querySelector('[data-admin-body]');
      const fileInput = adminPostForm.querySelector('[data-admin-file]');
      const body = bodyInput instanceof HTMLTextAreaElement ? bodyInput.value.trim() : '';

      try {
        if (kind === 'text' && !body) throw new Error('Write something for the note.');
        if (adminSubmit instanceof HTMLButtonElement) adminSubmit.disabled = true;
        if (adminStatus instanceof HTMLElement) {
          adminStatus.textContent = kind === 'image' ? 'Compressing image…' : 'Uploading…';
          adminStatus.classList.remove('hidden');
        }

        const prepared = await prepareUploadFile(
          kind,
          fileInput instanceof HTMLInputElement ? fileInput.files?.[0] : null,
        );
        if (adminStatus instanceof HTMLElement && kind === 'image') {
          adminStatus.textContent = 'Placing on board…';
        }

        const form = new FormData();
        form.append('kind', kind);
        if (kind === 'text') form.append('body', body);
        if (prepared) form.append('file', prepared);
        form.append('color', state.colors[0] || '');
        form.append('rotationDeg', String(Math.round(Math.random() * 8 - 4)));
        form.append('boardVariant', state.boardVariant || 'portrait');
        if (kind === 'image' || kind === 'pdf') form.append('widthPct', '28');

        const res = await fetch('/api/bulletin-board/pins/create', {
          method: 'POST',
          body: form,
          headers: { Accept: 'application/json' },
        });
        const json = await res.json();
        if (!res.ok) throw new Error(json.error || 'Could not create post.');

        // Reload so duplicate twins are present for both variants.
        window.location.reload();
        return;
      } catch (error) {
        if (adminStatus instanceof HTMLElement) adminStatus.classList.add('hidden');
        if (adminError instanceof HTMLElement) {
          adminError.textContent = error instanceof Error ? error.message : 'Could not create post.';
          adminError.classList.remove('hidden');
        }
      } finally {
        if (adminSubmit instanceof HTMLButtonElement) adminSubmit.disabled = false;
      }
    });

    publishBtn?.addEventListener('click', async () => {
      if (publishError instanceof HTMLElement) {
        publishError.classList.add('hidden');
        publishError.textContent = '';
      }
      if (publishStatus instanceof HTMLElement) {
        publishStatus.textContent = 'Publishing to Home…';
        publishStatus.classList.remove('hidden');
      }
      if (publishBtn instanceof HTMLButtonElement) publishBtn.disabled = true;
      try {
        const json = await postForm('/api/bulletin-board/publish', {});
        markDraftPublished(json.surface);
        if (publishStatus instanceof HTMLElement) {
          publishStatus.textContent = 'Live Home board updated.';
          publishStatus.classList.remove('hidden');
        }
      } catch (error) {
        if (publishStatus instanceof HTMLElement) publishStatus.classList.add('hidden');
        if (publishError instanceof HTMLElement) {
          publishError.textContent =
            error instanceof Error ? error.message : 'Could not update the live board.';
          publishError.classList.remove('hidden');
        }
      } finally {
        if (publishBtn instanceof HTMLButtonElement) publishBtn.disabled = false;
      }
    });

    const layoutForm = root.querySelector('[data-home-layout-form]');
    const layoutStatus = root.querySelector('[data-layout-status]');
    const layoutError = root.querySelector('[data-layout-error]');
    const layoutImageUploadWrap = root.querySelector('[data-layout-image-upload-wrap]');

    const syncLayoutForm = () => {
      const rail = root.querySelector('[data-layout-rail]:checked');
      const railVal = rail instanceof HTMLInputElement ? rail.value : 'none';
      const showUpload = railVal === 'custom' || railVal === 'company';
      if (layoutImageUploadWrap instanceof HTMLElement) {
        layoutImageUploadWrap.classList.toggle('hidden', !showUpload);
      }
    };

    root.querySelectorAll('[data-layout-rail]').forEach((node) => {
      node.addEventListener('change', syncLayoutForm);
    });
    syncLayoutForm();

    layoutForm?.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!(layoutForm instanceof HTMLFormElement)) return;
      if (layoutStatus instanceof HTMLElement) {
        layoutStatus.classList.add('hidden');
        layoutStatus.textContent = '';
      }
      if (layoutError instanceof HTMLElement) {
        layoutError.classList.add('hidden');
        layoutError.textContent = '';
      }
      try {
        const form = new FormData(layoutForm);
        const res = await fetch('/api/home-layout/update', {
          method: 'POST',
          body: form,
          headers: { Accept: 'application/json' },
        });
        const json = await res.json();
        if (!res.ok) throw new Error(json.error || 'Could not save layout.');
        state.layout = json.layout;
        if (layoutStatus instanceof HTMLElement) {
          layoutStatus.textContent = 'Home layout defaults saved.';
          layoutStatus.classList.remove('hidden');
        }
      } catch (error) {
        if (layoutError instanceof HTMLElement) {
          layoutError.textContent = error instanceof Error ? error.message : 'Save failed.';
          layoutError.classList.remove('hidden');
        }
      }
    });

    const boardModeStatus = root.querySelector('[data-board-mode-status]');
    const boardModeError = root.querySelector('[data-board-mode-error]');
    root.querySelectorAll('[data-board-mode]').forEach((btn) => {
      btn.addEventListener('click', async () => {
        if (!(btn instanceof HTMLButtonElement)) return;
        const mode = btn.dataset.boardMode;
        if (!mode || mode === state.boardMode) return;
        if (boardModeError instanceof HTMLElement) {
          boardModeError.classList.add('hidden');
          boardModeError.textContent = '';
        }
        try {
          const json = await postForm('/api/bulletin-board/board-mode', { mode });
          state.boardMode = json.boardMode;
          root.querySelectorAll('[data-board-mode]').forEach((node) => {
            if (!(node instanceof HTMLButtonElement)) return;
            const active = node.dataset.boardMode === state.boardMode;
            node.setAttribute('aria-pressed', active ? 'true' : 'false');
            node.className = active
              ? 'rounded-full border border-sage-dark/35 bg-sage/15 px-3.5 py-1.5 text-sm font-semibold transition'
              : 'rounded-full border border-sage-dark/15 bg-white/80 px-3.5 py-1.5 text-sm font-semibold text-sage-dark/70 transition';
          });
          markDraftDirty();
          if (boardModeStatus instanceof HTMLElement) {
            boardModeStatus.textContent =
              mode === 'duplicate'
                ? 'Switched to duplicate. Missing twins were created where needed.'
                : 'Switched to separate. Linked pins were unlinked and kept.';
            boardModeStatus.classList.remove('hidden');
          }
          window.location.reload();
        } catch (error) {
          if (boardModeError instanceof HTMLElement) {
            boardModeError.textContent =
              error instanceof Error ? error.message : 'Could not change board mode.';
            boardModeError.classList.remove('hidden');
          }
        }
      });
    });

    setBoardVariant(state.boardVariant || 'portrait');
    renderRequests();
    renderInspector();
  }

  document.querySelectorAll('[data-board-lab]').forEach((root) => {
    if (root instanceof HTMLElement) setupBoardLab(root);
  });
</script>
