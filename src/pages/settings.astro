---
import PanelHeading from '../components/PanelHeading.astro';
import PortalLayout from '../layouts/PortalLayout.astro';
import { canSeeCredentialing } from '../lib/credentialing';
import { canSeeCaseload } from '../lib/caseload';
import { availableWidgets, HOME_WIDGET_MAX } from '../lib/home-widgets';
import { hasPermission } from '../lib/permissions';
import { GoogleCalendarProvider } from '../lib/schedule/google-calendar';

export const prerender = false;

const employee = Astro.locals.employee!;
const canSeeFinancials = hasPermission(employee, 'financials:view');
const canSeeCredentialingWidget = canSeeCredentialing(employee);
const canSeeClinicalWidget = canSeeCaseload(employee);
const widgets = availableWidgets({
  canSeeFinancials,
  canSeeCredentialing: canSeeCredentialingWidget,
  canSeeClinical: canSeeClinicalWidget,
});

const calendarProvider = new GoogleCalendarProvider();
let calendarConnection: Awaited<ReturnType<GoogleCalendarProvider['getConnection']>> = {
  status: 'disconnected',
  googleEmail: null,
  lastError: null,
  configured: calendarProvider.isConfigured(),
  hiddenTitleKeywords: [],
  hideOutOfOffice: false,
};
let calendarOptions: Array<{
  id: string;
  name: string;
  enabled: boolean;
  color: string | null;
  coverTitle: string | null;
}> = [];

try {
  calendarConnection = await calendarProvider.getConnection(employee.id);
  if (calendarConnection.status === 'connected') {
    try {
      await calendarProvider.refreshCalendarList(employee.id);
    } catch (error) {
      console.error('settings calendar refresh failed', error);
    }
    calendarOptions = (await calendarProvider.listCalendars(employee.id)).map((calendar) => ({
      id: calendar.id,
      name: calendar.name,
      enabled: calendar.enabled,
      color: calendar.color,
      coverTitle: calendar.coverTitle,
    }));
  }
} catch (error) {
  console.error('settings calendar lookup failed', error);
}

const calendarNotice = Astro.url.searchParams.get('calendar') === 'connected'
  ? 'Google Calendar connected.'
  : Astro.url.searchParams.get('error');

const menuChevron = `<svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M6 3l5 5-5 5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg>`;
---

<PortalLayout title="Settings">
  <div class="mx-auto max-w-lg" data-settings-shell>
    <div data-settings-header>
      <p class="text-sm text-sage-dark/65">
        <a href="/" class="hover:text-sage-dark">Home</a>
        <span class="mx-1.5 text-sage-dark/35">/</span>
        Settings
      </p>
      <h1 class="mt-3 font-display text-4xl text-charcoal">Settings</h1>
    </div>

    <div data-settings-menu>
      <p class="mt-3 text-sage-dark/75">Choose a category to manage.</p>

      <div class="mt-8 overflow-hidden rounded-2xl border border-sage-dark/10 bg-white/90 shadow-sm">
        <button
          type="button"
          class="flex w-full items-center justify-between gap-3 px-4 py-3.5 text-left transition hover:bg-sage/10"
          data-settings-open="appearance"
        >
          <span class="text-[15px] font-medium text-charcoal">Appearance</span>
          <span class="text-sage-dark/40" set:html={menuChevron} />
        </button>
        <div class="mx-4 border-t border-sage-dark/10"></div>
        <button
          type="button"
          class="flex w-full items-center justify-between gap-3 px-4 py-3.5 text-left transition hover:bg-sage/10"
          data-settings-open="widgets"
        >
          <span class="text-[15px] font-medium text-charcoal">Home widgets</span>
          <span class="text-sage-dark/40" set:html={menuChevron} />
        </button>
        <div class="mx-4 border-t border-sage-dark/10"></div>
        <button
          type="button"
          class="flex w-full items-center justify-between gap-3 px-4 py-3.5 text-left transition hover:bg-sage/10"
          data-settings-open="google-calendar"
        >
          <span class="text-[15px] font-medium text-charcoal">Google Calendar</span>
          <span class="text-sage-dark/40" set:html={menuChevron} />
        </button>
      </div>

      <form method="post" action="/api/session/sign-out" class="mt-6">
        <button
          class="w-full rounded-2xl border border-sage-dark/10 bg-white/90 px-4 py-3.5 text-[15px] font-medium text-red-700 shadow-sm transition hover:bg-red-50"
          type="submit"
        >
          Sign out
        </button>
      </form>
    </div>

    <section class="hidden" data-settings-panel="appearance" data-theme-settings data-user-id={employee.id}>
      <button
        type="button"
        class="inline-flex items-center gap-1 rounded-full border border-sage-dark/20 px-3 py-1.5 text-sm font-semibold text-sage-dark transition hover:border-sage-dark/35 hover:bg-sage/10"
        data-settings-back
      >
        <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M10 3L5 8l5 5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        Back
      </button>
      <PanelHeading title="Appearance" description="Light or dark portal theme." />

      <div class="mt-6 overflow-hidden rounded-2xl border border-sage-dark/10 bg-white/90 shadow-sm" role="radiogroup" aria-label="Color theme">
        <label class="flex cursor-pointer items-center justify-between gap-3 px-4 py-3.5 has-[:checked]:bg-sage/10">
          <span class="text-[15px] font-medium text-charcoal">Light</span>
          <input
            type="radio"
            name="theme"
            value="light"
            class="h-4 w-4 border-sage-dark/30 text-sage-dark focus:ring-sage-dark/30"
            data-theme-option
          />
        </label>
        <div class="mx-4 border-t border-sage-dark/10"></div>
        <label class="flex cursor-pointer items-center justify-between gap-3 px-4 py-3.5 has-[:checked]:bg-sage/10">
          <span class="text-[15px] font-medium text-charcoal">Dark</span>
          <input
            type="radio"
            name="theme"
            value="dark"
            class="h-4 w-4 border-sage-dark/30 text-sage-dark focus:ring-sage-dark/30"
            data-theme-option
          />
        </label>
      </div>
    </section>

    <section
      class="hidden"
      data-settings-panel="widgets"
      data-widget-settings
      data-user-id={employee.id}
      data-can-financials={canSeeFinancials ? '1' : '0'}
      data-can-credentialing={canSeeCredentialingWidget ? '1' : '0'}
      data-can-clinical={canSeeClinicalWidget ? '1' : '0'}
      data-max={HOME_WIDGET_MAX}
      data-catalog={JSON.stringify(widgets)}
    >
      <button
        type="button"
        class="inline-flex items-center gap-1 rounded-full border border-sage-dark/20 px-3 py-1.5 text-sm font-semibold text-sage-dark transition hover:border-sage-dark/35 hover:bg-sage/10"
        data-settings-back
      >
        <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M10 3L5 8l5 5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        Back
      </button>
      <PanelHeading
        title="Home widgets"
        description={`Enable widgets, set carousel order (up to ${HOME_WIDGET_MAX}), and customize header colors and icons.`}
      />

      <p
        class="mt-4 hidden rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800"
        data-settings-error
      ></p>

      <ul class="mt-6 space-y-2 overflow-visible" data-widget-list></ul>

      <div class="mt-6 overflow-hidden rounded-2xl border border-sage-dark/10 bg-white/90 shadow-sm">
        <label for="default-widget" class="block px-4 pt-3.5 text-[13px] font-medium text-sage-dark/65">
          Open home to
        </label>
        <select
          id="default-widget"
          class="w-full border-0 bg-transparent px-4 pb-3.5 pt-1 text-[15px] font-medium text-charcoal outline-none"
          data-widget-default
        ></select>
      </div>

      <div class="mt-6 flex flex-wrap items-center gap-3">
        <button type="button" class="btn-primary" data-settings-save>Save preferences</button>
        <span
          class="hidden text-sm font-medium text-sage-dark/45 transition-opacity duration-300"
          data-settings-saved
          data-save-flash
          aria-live="polite"
        >
          Saved.
        </span>
      </div>
    </section>

    <section class="hidden" data-settings-panel="google-calendar" id="google-calendar" data-calendar-settings>
      <button
        type="button"
        class="inline-flex items-center gap-1 rounded-full border border-sage-dark/20 px-3 py-1.5 text-sm font-semibold text-sage-dark transition hover:border-sage-dark/35 hover:bg-sage/10"
        data-settings-back
      >
        <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M10 3L5 8l5 5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        Back
      </button>
      <PanelHeading
        title="Google Calendar"
        description="Connect your Google account for the Calendar widget. Read-only access only."
      />

      {
        calendarNotice ? (
          <p class="mt-4 rounded-xl border border-sage-dark/15 bg-white px-4 py-3 text-sm text-sage-dark/80">
            {calendarNotice}
          </p>
        ) : null
      }

      {
        !calendarConnection.configured ? (
          <p class="mt-6 text-sm text-sage-dark/65">
            Google Calendar OAuth is not configured yet. Add <code class="text-xs">GOOGLE_CLIENT_ID</code> and{' '}
            <code class="text-xs">GOOGLE_CLIENT_SECRET</code> to the portal environment.
          </p>
        ) : calendarConnection.status !== 'connected' ? (
          <div class="mt-6">
            <form method="post" action="/api/google-calendar/connect">
              <input type="hidden" name="returnTo" value="/settings#google-calendar" />
              <button type="submit" class="btn-primary">Connect Google Calendar</button>
            </form>
          </div>
        ) : (
          <>
            <p class="mt-4 text-sm text-sage-dark/75">
              Connected as <span class="font-semibold text-charcoal">{calendarConnection.googleEmail}</span>.
            </p>
            <p class="mt-2 text-sm text-sage-dark/65">
              Check the calendars you want on the home Calendar widget, then save. Optional cover names replace every event title from that calendar.
            </p>
            {
              calendarConnection.lastError ? (
                <p class="mt-3 text-sm text-red-700">{calendarConnection.lastError}</p>
              ) : null
            }
            {
              calendarOptions.length === 0 ? (
                <p class="mt-6 text-sm text-sage-dark/65">
                  No calendars loaded yet. Click <span class="font-semibold text-charcoal">Refresh list</span>.
                </p>
              ) : (
                <ul class="mt-6 space-y-2" data-calendar-list>
                  {
                    calendarOptions.map((calendar) => (
                      <li class="overflow-hidden rounded-2xl border border-sage-dark/10 bg-white/90 px-4 py-3 shadow-sm">
                        <div class="flex items-start gap-3">
                          <input
                            type="checkbox"
                            id={`calendar-${encodeURIComponent(calendar.id)}`}
                            value={calendar.id}
                            checked={calendar.enabled}
                            class="mt-1 h-4 w-4 rounded border-sage-dark/30 text-sage-dark focus:ring-sage-dark/30"
                            data-calendar-option
                          />
                          <label for={`calendar-${encodeURIComponent(calendar.id)}`} class="flex min-w-0 flex-1 cursor-pointer items-center gap-2">
                            <span
                              class="mt-0.5 h-3 w-3 shrink-0 rounded-sm"
                              style={`background-color: ${calendar.color ?? '#6b6c72'}`}
                              aria-hidden="true"
                            ></span>
                            <span class="block text-[15px] font-medium text-charcoal">{calendar.name}</span>
                          </label>
                        </div>
                        <label class="mt-3 block pl-7">
                          <span class="text-xs font-medium text-sage-dark/70">Cover name</span>
                          <input
                            type="text"
                            class="field mt-1"
                            maxlength="80"
                            placeholder="Leave blank to show real titles"
                            value={calendar.coverTitle ?? ''}
                            data-calendar-cover
                            data-calendar-id={calendar.id}
                          />
                        </label>
                      </li>
                    ))
                  }
                </ul>
              )
            }
            <div class="mt-6 overflow-hidden rounded-2xl border border-sage-dark/10 bg-white/90 shadow-sm">
              <div class="px-4 py-3.5">
                <h3 class="text-[15px] font-medium text-charcoal">Hide events</h3>
                <p class="mt-1 text-sm text-sage-dark/65">
                  Hide specific overlapping busy blocks. Each line must match an event title exactly (case-insensitive).
                </p>
                <label for="hidden-title-keywords" class="mt-4 block text-sm font-medium text-charcoal">
                  Hide these exact titles
                </label>
                <textarea
                  id="hidden-title-keywords"
                  class="field mt-2 min-h-[6rem]"
                  rows="4"
                  placeholder={'Not available\nBusy - Other Practice'}
                  data-hidden-title-keywords
                >{calendarConnection.hiddenTitleKeywords.join('\n')}</textarea>
                <p class="mt-1 text-xs text-sage-dark/55">
                  One full title per line.
                </p>
              </div>
              <div class="mx-4 border-t border-sage-dark/10"></div>
              <label class="flex cursor-pointer items-start gap-3 px-4 py-3.5">
                <input
                  type="checkbox"
                  class="mt-1 h-4 w-4 rounded border-sage-dark/30 text-sage-dark focus:ring-sage-dark/30"
                  checked={calendarConnection.hideOutOfOffice}
                  data-hide-out-of-office
                />
                <span>
                  <span class="block text-[15px] font-medium text-charcoal">Hide Out of office events</span>
                  <span class="mt-0.5 block text-sm text-sage-dark/65">
                    Hides Google Calendar out-of-office / unavailable blocks.
                  </span>
                </span>
              </label>
            </div>
            <div class="mt-6 flex flex-wrap items-center gap-3">
              <button type="button" class="btn-primary" data-calendar-save>Save calendars</button>
              <span
                class="hidden text-sm font-medium text-sage-dark/45 transition-opacity duration-300"
                data-calendar-saved
                data-save-flash
                aria-live="polite"
              >
                Saved.
              </span>
              <button type="button" class="text-sm text-sage-dark/70 hover:text-sage-dark" data-calendar-refresh>
                Refresh list
              </button>
              <button type="button" class="text-sm text-red-700 hover:text-red-800" data-calendar-disconnect>
                Disconnect
              </button>
            </div>
          </>
        )
      }
    </section>
  </div>
</PortalLayout>

<script>
  import {
    DEFAULT_WIDGET_ICONS,
    WIDGET_ICON_OPTIONS,
    widgetIconMarkup,
    type WidgetIconId,
  } from '../lib/home-widget-icons';

  type Prefs = {
    enabled: string[];
    defaultId: string;
    headerColors?: Record<string, string>;
    headerIcons?: Record<string, WidgetIconId>;
  };
  type CatalogItem = {
    id: string;
    label: string;
    description: string;
    brandHeaderColor?: string;
    brandIconSrc?: string;
  };

  const DEFAULT_WIDGET_HEADER_COLOR = '#535f51';

  function defaultHeaderColor(widget: CatalogItem): string {
    return widget.brandHeaderColor ?? DEFAULT_WIDGET_HEADER_COLOR;
  }

  function sanitizeHeaderColors(raw: unknown): Record<string, string> {
    if (!raw || typeof raw !== 'object') return {};
    const colors: Record<string, string> = {};
    for (const [key, value] of Object.entries(raw)) {
      if (typeof value === 'string' && /^#[0-9a-fA-F]{6}$/.test(value)) {
        colors[key] = value;
      }
    }
    return colors;
  }

  function sanitizeHeaderIcons(raw: unknown): Record<string, WidgetIconId> {
    if (!raw || typeof raw !== 'object') return {};
    const icons: Record<string, WidgetIconId> = {};
    const allowed = new Set(WIDGET_ICON_OPTIONS.map((option) => option.id));
    for (const [key, value] of Object.entries(raw)) {
      if (typeof value === 'string' && allowed.has(value as WidgetIconId)) {
        icons[key] = value as WidgetIconId;
      }
    }
    return icons;
  }

  function defaultPrefs(canFinancials: boolean, canCredentialing: boolean, canClinical: boolean): Prefs {
    const enabled = ['schedule', 'time_off', 'timesheet', 'my_progress', 'tasks'];
    if (canClinical) enabled.splice(1, 0, 'caseload');
    if (canCredentialing) enabled.push('credentialing');
    if (canFinancials) enabled.push('quickbooks');
    return { enabled, defaultId: 'schedule' };
  }

  function migrateWidgetId(id: string): string {
    return id === 'coming_soon' ? 'my_progress' : id;
  }

  function setupSettingsNav(shell: Element) {
    if (!(shell instanceof HTMLElement)) return;
    const menu = shell.querySelector('[data-settings-menu]');
    const header = shell.querySelector('[data-settings-header]');
    const panels = Array.from(shell.querySelectorAll('[data-settings-panel]')).filter(
      (node): node is HTMLElement => node instanceof HTMLElement,
    );

    const showMenu = () => {
      if (header instanceof HTMLElement) header.classList.remove('hidden');
      if (menu instanceof HTMLElement) menu.classList.remove('hidden');
      panels.forEach((panel) => panel.classList.add('hidden'));
      if (window.location.hash) {
        history.replaceState(null, '', window.location.pathname + window.location.search);
      }
    };

    const showPanel = (id: string, updateHash = true) => {
      if (header instanceof HTMLElement) header.classList.add('hidden');
      if (menu instanceof HTMLElement) menu.classList.add('hidden');
      panels.forEach((panel) => {
        panel.classList.toggle('hidden', panel.dataset.settingsPanel !== id);
      });
      if (updateHash) {
        const hash = id === 'google-calendar' ? '#google-calendar' : `#${id}`;
        history.replaceState(null, '', `${window.location.pathname}${window.location.search}${hash}`);
      }
    };

    shell.querySelectorAll('[data-settings-open]').forEach((node) => {
      if (!(node instanceof HTMLButtonElement)) return;
      node.addEventListener('click', () => {
        const id = node.dataset.settingsOpen;
        if (id) showPanel(id);
      });
    });

    shell.querySelectorAll('[data-settings-back]').forEach((node) => {
      node.addEventListener('click', () => showMenu());
    });

    const hash = window.location.hash.replace(/^#/, '');
    if (hash === 'google-calendar' || hash === 'appearance' || hash === 'widgets') {
      showPanel(hash, false);
    }
  }

  function applyTheme(theme: 'light' | 'dark', userId: string) {
    document.documentElement.classList.toggle('dark', theme === 'dark');
    try {
      localStorage.setItem('portal:theme:' + userId, theme);
      localStorage.setItem('portal:theme', theme);
    } catch {
      /* ignore */
    }
  }

  function setupTheme(root: Element) {
    if (!(root instanceof HTMLElement)) return;
    const userId = root.dataset.userId ?? '';
    const options = Array.from(root.querySelectorAll('[data-theme-option]')).filter(
      (el): el is HTMLInputElement => el instanceof HTMLInputElement,
    );
    let theme: 'light' | 'dark' = 'light';
    try {
      const raw =
        localStorage.getItem('portal:theme:' + userId) || localStorage.getItem('portal:theme');
      if (raw === 'dark') theme = 'dark';
    } catch {
      /* keep light */
    }
    options.forEach((option) => {
      option.checked = option.value === theme;
      option.addEventListener('change', () => {
        if (!option.checked) return;
        applyTheme(option.value === 'dark' ? 'dark' : 'light', userId);
      });
    });
  }

  function setupSettings(root: Element) {
    if (!(root instanceof HTMLElement)) return;
    const userId = root.dataset.userId ?? '';
    const canFinancials = root.dataset.canFinancials === '1';
    const canCredentialing = root.dataset.canCredentialing === '1';
    const canClinical = root.dataset.canClinical === '1';
    const max = Number(root.dataset.max || 10);
    const list = root.querySelector('[data-widget-list]');
    const select = root.querySelector('[data-widget-default]');
    const errorEl = root.querySelector('[data-settings-error]');
    const savedEl = root.querySelector('[data-settings-saved]');
    const saveBtn = root.querySelector('[data-settings-save]');
    if (!(list instanceof HTMLElement) || !(select instanceof HTMLSelectElement)) return;

    let catalog: CatalogItem[] = [];
    try {
      catalog = JSON.parse(root.dataset.catalog || '[]') as CatalogItem[];
    } catch {
      catalog = [];
    }

    const key = 'portal:home-widgets:' + userId;
    let prefs = defaultPrefs(canFinancials, canCredentialing, canClinical);
    let headerColors: Record<string, string> = {};
    let headerIcons: Record<string, WidgetIconId> = {};
    try {
      const raw = localStorage.getItem(key);
      if (raw) {
        const parsed = JSON.parse(raw) as Prefs;
        headerColors = sanitizeHeaderColors(parsed.headerColors);
        headerIcons = sanitizeHeaderIcons(parsed.headerIcons);
        if (Array.isArray(parsed.enabled) && parsed.enabled.length) {
          prefs = {
            enabled: parsed.enabled
              .map(migrateWidgetId)
              .filter((id) => catalog.some((w) => w.id === id))
              .slice(0, max),
            defaultId: migrateWidgetId(parsed.defaultId || parsed.enabled[0]!),
            ...(Object.keys(headerColors).length ? { headerColors } : {}),
            ...(Object.keys(headerIcons).length ? { headerIcons } : {}),
          };
          if (catalog.some((w) => w.id === 'time_off') && !prefs.enabled.includes('time_off') && prefs.enabled.length < max) {
            const scheduleIdx = prefs.enabled.indexOf('schedule');
            prefs.enabled.splice(scheduleIdx >= 0 ? scheduleIdx + 1 : prefs.enabled.length, 0, 'time_off');
          }
          if (
            catalog.some((w) => w.id === 'caseload') &&
            !prefs.enabled.includes('caseload') &&
            prefs.enabled.length < max
          ) {
            const scheduleIdx = prefs.enabled.indexOf('schedule');
            prefs.enabled.splice(scheduleIdx >= 0 ? scheduleIdx + 1 : prefs.enabled.length, 0, 'caseload');
          }
          if (
            catalog.some((w) => w.id === 'my_progress') &&
            !prefs.enabled.includes('my_progress') &&
            prefs.enabled.length < max
          ) {
            const timeOffIdx = prefs.enabled.indexOf('time_off');
            prefs.enabled.splice(timeOffIdx >= 0 ? timeOffIdx + 1 : prefs.enabled.length, 0, 'my_progress');
          }
          if (
            catalog.some((w) => w.id === 'timesheet') &&
            !prefs.enabled.includes('timesheet') &&
            prefs.enabled.length < max
          ) {
            const timeOffIdx = prefs.enabled.indexOf('time_off');
            prefs.enabled.splice(timeOffIdx >= 0 ? timeOffIdx + 1 : prefs.enabled.length, 0, 'timesheet');
          }
          if (
            catalog.some((w) => w.id === 'tasks') &&
            !prefs.enabled.includes('tasks') &&
            prefs.enabled.length < max
          ) {
            const progressIdx = prefs.enabled.indexOf('my_progress');
            prefs.enabled.splice(progressIdx >= 0 ? progressIdx + 1 : prefs.enabled.length, 0, 'tasks');
          }
          if (
            catalog.some((w) => w.id === 'credentialing') &&
            !prefs.enabled.includes('credentialing') &&
            prefs.enabled.length < max
          ) {
            const tasksIdx = prefs.enabled.indexOf('tasks');
            prefs.enabled.splice(
              tasksIdx >= 0 ? tasksIdx + 1 : prefs.enabled.length,
              0,
              'credentialing',
            );
          }
          if (!prefs.enabled.includes(prefs.defaultId)) {
            prefs.defaultId = prefs.enabled[0] || 'schedule';
          }
          if (!prefs.enabled.length) prefs = defaultPrefs(canFinancials, canCredentialing, canClinical);
        }
      }
    } catch {
      /* keep defaults */
    }

    const orderedIds = [
      ...prefs.enabled,
      ...catalog.map((w) => w.id).filter((id) => !prefs.enabled.includes(id)),
    ];

    type RowState = { id: string; enabled: boolean };
    let rows: RowState[] = orderedIds.map((id) => ({
      id,
      enabled: prefs.enabled.includes(id),
    }));

    const moveBtnClass =
      'inline-flex h-8 w-8 items-center justify-center rounded-lg text-sage-dark/70 ring-1 ring-sage-dark/15 transition hover:bg-white hover:text-charcoal disabled:cursor-not-allowed disabled:opacity-30';

    const resolveHeaderColor = (widgetId: string): string => {
      const widget = catalog.find((w) => w.id === widgetId);
      if (!widget) return DEFAULT_WIDGET_HEADER_COLOR;
      return headerColors[widgetId] ?? defaultHeaderColor(widget);
    };

    const setHeaderColor = (widgetId: string, value: string) => {
      const widget = catalog.find((w) => w.id === widgetId);
      const fallback = widget ? defaultHeaderColor(widget) : DEFAULT_WIDGET_HEADER_COLOR;
      if (value === fallback) {
        delete headerColors[widgetId];
      } else {
        headerColors[widgetId] = value;
      }
    };

    const resolveHeaderIcon = (widgetId: string): WidgetIconId => {
      return headerIcons[widgetId] ?? DEFAULT_WIDGET_ICONS[widgetId as keyof typeof DEFAULT_WIDGET_ICONS] ?? 'calendar';
    };

    const defaultHeaderIcon = (widgetId: string): WidgetIconId => {
      return DEFAULT_WIDGET_ICONS[widgetId as keyof typeof DEFAULT_WIDGET_ICONS] ?? 'calendar';
    };

    const setHeaderIcon = (widgetId: string, value: WidgetIconId) => {
      if (value === defaultHeaderIcon(widgetId)) {
        delete headerIcons[widgetId];
      } else {
        headerIcons[widgetId] = value;
      }
    };

    const fieldLabelClass = 'text-[11px] font-medium text-sage-dark/55';
    const controlTriggerClass =
      'inline-flex h-9 items-center gap-1.5 rounded-lg border border-sage-dark/20 bg-white px-2 text-charcoal shadow-sm transition hover:border-sage-dark/35 hover:bg-sage/10 focus:outline-none focus-visible:ring-2 focus-visible:ring-sage-dark/25';

    const createChevron = (): HTMLSpanElement => {
      const chevron = document.createElement('span');
      chevron.className = 'inline-flex text-sage-dark/45 transition-transform duration-150';
      chevron.setAttribute('aria-hidden', 'true');
      chevron.innerHTML =
        '<svg width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg>';
      return chevron;
    };

    const setControlOpen = (trigger: HTMLButtonElement, chevron: HTMLElement, open: boolean) => {
      trigger.classList.toggle('border-sage-dark/40', open);
      trigger.classList.toggle('bg-sage/10', open);
      trigger.classList.toggle('ring-2', open);
      trigger.classList.toggle('ring-sage-dark/15', open);
      chevron.classList.toggle('rotate-180', open);
    };

    let openIconPickerMenu: HTMLElement | null = null;

    const closeOpenIconPicker = () => {
      if (!openIconPickerMenu) return;
      openIconPickerMenu.classList.add('hidden');
      const picker = openIconPickerMenu.closest('[data-icon-picker]');
      const trigger = picker?.querySelector('[data-icon-picker-trigger]');
      if (trigger instanceof HTMLButtonElement) {
        trigger.setAttribute('aria-expanded', 'false');
        const chevron = trigger.querySelector('[data-control-chevron]');
        setControlOpen(trigger, chevron instanceof HTMLElement ? chevron : trigger, false);
      }
      openIconPickerMenu = null;
    };

    const createIconPicker = (
      widgetLabel: string,
      getSelected: () => WidgetIconId,
      onSelect: (iconId: WidgetIconId) => void,
    ): { element: HTMLElement; sync: () => void } => {
      const root = document.createElement('div');
      root.className = 'relative';
      root.dataset.iconPicker = 'true';

      const trigger = document.createElement('button');
      trigger.type = 'button';
      trigger.dataset.iconPickerTrigger = 'true';
      trigger.className = controlTriggerClass;
      trigger.setAttribute('aria-label', `Change ${widgetLabel} header icon`);
      trigger.setAttribute('aria-haspopup', 'listbox');
      trigger.setAttribute('aria-expanded', 'false');

      const preview = document.createElement('span');
      preview.dataset.iconPickerPreview = 'true';
      preview.className =
        'inline-flex h-7 w-7 shrink-0 items-center justify-center rounded-md bg-sage/15 text-charcoal';

      const chevron = createChevron();
      chevron.dataset.controlChevron = 'true';

      trigger.appendChild(preview);
      trigger.appendChild(chevron);

      const syncTrigger = () => {
        preview.innerHTML = widgetIconMarkup(getSelected()).replace(
          'width="16" height="16"',
          'width="18" height="18"',
        );
      };
      syncTrigger();

      const setTriggerOpen = (open: boolean) => {
        trigger.setAttribute('aria-expanded', open ? 'true' : 'false');
        setControlOpen(trigger, chevron, open);
      };

      const menu = document.createElement('div');
      menu.dataset.iconPickerMenu = 'true';
      menu.className =
        'absolute left-0 top-[calc(100%+0.35rem)] z-50 hidden w-[10.75rem] rounded-xl border border-sage-dark/10 bg-white p-2 shadow-lg';
      menu.setAttribute('role', 'listbox');
      menu.setAttribute('aria-label', `${widgetLabel} icon options`);

      const syncMenuSelection = () => {
        const selected = getSelected();
        menu.querySelectorAll('[data-icon-option]').forEach((node) => {
          if (!(node instanceof HTMLButtonElement)) return;
          const active = node.dataset.iconId === selected;
          node.setAttribute('aria-selected', active ? 'true' : 'false');
          node.classList.toggle('bg-sage/25', active);
          node.classList.toggle('ring-1', active);
          node.classList.toggle('ring-sage-dark/20', active);
        });
      };

      WIDGET_ICON_OPTIONS.forEach((option) => {
        const optionBtn = document.createElement('button');
        optionBtn.type = 'button';
        optionBtn.dataset.iconOption = 'true';
        optionBtn.dataset.iconId = option.id;
        optionBtn.className =
          'inline-flex h-8 w-8 items-center justify-center rounded-lg text-charcoal transition hover:bg-sage/15 focus:outline-none focus-visible:ring-2 focus-visible:ring-sage-dark/25';
        optionBtn.setAttribute('role', 'option');
        optionBtn.setAttribute('aria-label', option.label);
        optionBtn.title = option.label;
        optionBtn.innerHTML = widgetIconMarkup(option.id);
        optionBtn.addEventListener('click', () => {
          onSelect(option.id);
          syncTrigger();
          syncMenuSelection();
          closeOpenIconPicker();
        });
        menu.appendChild(optionBtn);
      });

      menu.classList.add('grid', 'grid-cols-4', 'gap-1');

      trigger.addEventListener('click', (event) => {
        event.stopPropagation();
        if (openIconPickerMenu === menu) {
          closeOpenIconPicker();
          return;
        }
        closeOpenIconPicker();
        menu.classList.remove('hidden');
        setTriggerOpen(true);
        openIconPickerMenu = menu;
        syncMenuSelection();
      });

      root.appendChild(trigger);
      root.appendChild(menu);
      return { element: root, sync: syncTrigger };
    };

    document.addEventListener('click', () => {
      closeOpenIconPicker();
    });

    const createInfoTooltip = (description: string, widgetLabel: string): HTMLElement => {
      const wrap = document.createElement('span');
      wrap.className = 'group/info relative inline-flex shrink-0';

      const button = document.createElement('button');
      button.type = 'button';
      button.className =
        'inline-flex h-[18px] w-[18px] items-center justify-center rounded-full border border-sage-dark/30 text-[11px] font-semibold leading-none text-sage-dark/50 transition hover:border-sage-dark/45 hover:text-sage-dark/70 focus:outline-none focus-visible:ring-2 focus-visible:ring-sage-dark/25';
      button.setAttribute('aria-label', `About ${widgetLabel}`);
      button.textContent = 'i';

      const tooltip = document.createElement('span');
      tooltip.setAttribute('role', 'tooltip');
      tooltip.className =
        'pointer-events-none absolute left-[calc(100%+0.45rem)] top-1/2 z-50 w-64 -translate-y-1/2 rounded-xl border border-sage-dark/10 bg-white px-3.5 py-2.5 text-left text-sm font-normal leading-snug text-sage-dark/75 opacity-0 shadow-lg transition-opacity duration-150 group-hover/info:opacity-100 group-focus-within/info:opacity-100';
      tooltip.textContent = description;

      wrap.appendChild(button);
      wrap.appendChild(tooltip);
      return wrap;
    };

    const syncSelect = () => {
      const enabled = rows.filter((r) => r.enabled).map((r) => r.id);
      select.innerHTML = '';
      catalog.forEach((widget) => {
        if (!enabled.includes(widget.id)) return;
        const opt = document.createElement('option');
        opt.value = widget.id;
        opt.textContent = widget.label;
        select.appendChild(opt);
      });
      if (enabled.includes(select.value) === false && enabled[0]) {
        select.value = enabled[0];
      } else if (enabled.includes(prefs.defaultId)) {
        select.value = prefs.defaultId;
      }
    };

    const render = () => {
      list.innerHTML = '';
      rows.forEach((row, index) => {
        const widget = catalog.find((w) => w.id === row.id);
        if (!widget) return;

        const li = document.createElement('li');
        li.className =
          'relative flex items-stretch gap-3 overflow-visible rounded-2xl border border-sage-dark/10 bg-white/90 px-4 py-3 shadow-sm';
        li.dataset.widgetId = row.id;

        const check = document.createElement('input');
        check.type = 'checkbox';
        check.id = `widget-${row.id}`;
        check.value = row.id;
        check.checked = row.enabled;
        check.className =
          'mb-2.5 h-4 w-4 shrink-0 self-end rounded border-sage-dark/30 text-sage-dark focus:ring-sage-dark/30';
        check.addEventListener('change', () => {
          const enabledCount = rows.filter((r) => r.enabled).length;
          if (check.checked && enabledCount >= max) {
            check.checked = false;
            if (errorEl instanceof HTMLElement) {
              errorEl.textContent = `You can enable at most ${max} widgets.`;
              errorEl.classList.remove('hidden');
            }
            return;
          }
          if (!check.checked && rows.filter((r) => r.enabled).length <= 1) {
            check.checked = true;
            if (errorEl instanceof HTMLElement) {
              errorEl.textContent = 'Keep at least one widget enabled.';
              errorEl.classList.remove('hidden');
            }
            return;
          }
          row.enabled = check.checked;
          if (errorEl instanceof HTMLElement) errorEl.classList.add('hidden');
          if (savedEl instanceof HTMLElement) savedEl.classList.add('hidden');
          syncSelect();
          render();
        });

        const main = document.createElement('div');
        main.className = 'flex min-w-0 flex-1 flex-wrap items-end gap-x-4 gap-y-2';

        const titleWrap = document.createElement('div');
        titleWrap.className = 'flex min-w-[6rem] flex-1 items-center gap-1.5 overflow-visible pb-0.5';

        const label = document.createElement('label');
        label.htmlFor = check.id;
        label.className = 'cursor-pointer text-[15px] font-medium text-charcoal';
        label.textContent = widget.label;
        titleWrap.appendChild(label);
        if (widget.description) {
          titleWrap.appendChild(createInfoTooltip(widget.description, widget.label));
        }

        const colorWrap = document.createElement('div');
        colorWrap.className = 'flex shrink-0 flex-col gap-1';
        const colorLabel = document.createElement('span');
        colorLabel.className = fieldLabelClass;
        colorLabel.textContent = 'Color';
        const colorRow = document.createElement('div');
        colorRow.className = 'flex items-center gap-2';

        const colorTrigger = document.createElement('button');
        colorTrigger.type = 'button';
        colorTrigger.className = controlTriggerClass;
        colorTrigger.setAttribute('aria-label', `${widget.label} color`);

        const colorSwatch = document.createElement('span');
        colorSwatch.className =
          'inline-flex h-7 w-7 shrink-0 rounded-md border border-black/10 ring-1 ring-black/5';
        const colorChevron = createChevron();
        colorChevron.dataset.controlChevron = 'true';

        const syncColorSwatch = () => {
          colorSwatch.style.backgroundColor = resolveHeaderColor(row.id);
        };
        syncColorSwatch();

        const colorInput = document.createElement('input');
        colorInput.type = 'color';
        colorInput.value = resolveHeaderColor(row.id);
        colorInput.className = 'sr-only';
        colorInput.tabIndex = -1;
        colorInput.setAttribute('aria-hidden', 'true');
        colorInput.addEventListener('input', () => {
          setHeaderColor(row.id, colorInput.value);
          syncColorSwatch();
          if (savedEl instanceof HTMLElement) savedEl.classList.add('hidden');
        });
        colorInput.addEventListener('focus', () => {
          setControlOpen(colorTrigger, colorChevron, true);
        });
        colorInput.addEventListener('blur', () => {
          setControlOpen(colorTrigger, colorChevron, false);
        });

        colorTrigger.addEventListener('click', () => {
          colorInput.click();
        });
        colorTrigger.appendChild(colorSwatch);
        colorTrigger.appendChild(colorChevron);

        const resetColor = document.createElement('button');
        resetColor.type = 'button';
        resetColor.className =
          'text-[11px] font-medium text-sage-dark/55 underline decoration-sage-dark/25 underline-offset-2 hover:text-charcoal';
        resetColor.textContent = 'Reset';
        resetColor.addEventListener('click', () => {
          setHeaderColor(row.id, defaultHeaderColor(widget));
          colorInput.value = resolveHeaderColor(row.id);
          syncColorSwatch();
          if (savedEl instanceof HTMLElement) savedEl.classList.add('hidden');
        });

        colorRow.appendChild(colorTrigger);
        colorRow.appendChild(colorInput);
        colorRow.appendChild(resetColor);
        colorWrap.appendChild(colorLabel);
        colorWrap.appendChild(colorRow);

        let iconWrap: HTMLElement | null = null;
        if (!widget.brandIconSrc) {
          iconWrap = document.createElement('div');
          iconWrap.className = 'flex shrink-0 flex-col gap-1';
          const iconLabel = document.createElement('span');
          iconLabel.className = fieldLabelClass;
          iconLabel.textContent = 'Icon';
          const iconRow = document.createElement('div');
          iconRow.className = 'flex items-center gap-2';
          const { element: iconPicker, sync: syncIconPicker } = createIconPicker(
            widget.label,
            () => resolveHeaderIcon(row.id),
            (iconId) => {
              setHeaderIcon(row.id, iconId);
              if (savedEl instanceof HTMLElement) savedEl.classList.add('hidden');
            },
          );
          const resetIcon = document.createElement('button');
          resetIcon.type = 'button';
          resetIcon.className =
            'text-[11px] font-medium text-sage-dark/55 underline decoration-sage-dark/25 underline-offset-2 hover:text-charcoal';
          resetIcon.textContent = 'Reset';
          resetIcon.addEventListener('click', () => {
            setHeaderIcon(row.id, defaultHeaderIcon(row.id));
            syncIconPicker();
            if (savedEl instanceof HTMLElement) savedEl.classList.add('hidden');
          });
          iconRow.appendChild(iconPicker);
          iconRow.appendChild(resetIcon);
          iconWrap.appendChild(iconLabel);
          iconWrap.appendChild(iconRow);
        }

        const controls = document.createElement('div');
        controls.className = 'mb-0.5 flex shrink-0 items-center gap-1 self-end';

        const up = document.createElement('button');
        up.type = 'button';
        up.className = moveBtnClass;
        up.setAttribute('aria-label', `Move ${widget.label} up`);
        up.disabled = index === 0;
        up.innerHTML =
          '<svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 10l5-5 5 5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg>';
        up.addEventListener('click', () => {
          if (index === 0) return;
          const tmp = rows[index - 1]!;
          rows[index - 1] = rows[index]!;
          rows[index] = tmp;
          if (savedEl instanceof HTMLElement) savedEl.classList.add('hidden');
          render();
          syncSelect();
        });

        const down = document.createElement('button');
        down.type = 'button';
        down.className = moveBtnClass;
        down.setAttribute('aria-label', `Move ${widget.label} down`);
        down.disabled = index === rows.length - 1;
        down.innerHTML =
          '<svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 6l5 5 5-5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg>';
        down.addEventListener('click', () => {
          if (index >= rows.length - 1) return;
          const tmp = rows[index + 1]!;
          rows[index + 1] = rows[index]!;
          rows[index] = tmp;
          if (savedEl instanceof HTMLElement) savedEl.classList.add('hidden');
          render();
          syncSelect();
        });

        controls.appendChild(up);
        controls.appendChild(down);

        main.appendChild(titleWrap);
        main.appendChild(colorWrap);
        if (iconWrap) main.appendChild(iconWrap);

        li.appendChild(check);
        li.appendChild(main);
        li.appendChild(controls);
        list.appendChild(li);
      });
      syncSelect();
    };

    render();
    if (prefs.enabled.includes(prefs.defaultId)) {
      select.value = prefs.defaultId;
    }

    saveBtn?.addEventListener('click', () => {
      const enabled = rows.filter((r) => r.enabled).map((r) => r.id).slice(0, max);
      if (enabled.length === 0) {
        if (errorEl instanceof HTMLElement) {
          errorEl.textContent = 'Keep at least one widget enabled.';
          errorEl.classList.remove('hidden');
        }
        return;
      }
      const defaultId = enabled.includes(select.value) ? select.value : enabled[0]!;
      const next: Prefs = {
        enabled,
        defaultId,
        ...(Object.keys(headerColors).length ? { headerColors: { ...headerColors } } : {}),
        ...(Object.keys(headerIcons).length ? { headerIcons: { ...headerIcons } } : {}),
      };
      localStorage.setItem(key, JSON.stringify(next));
      prefs = next;
      window.dispatchEvent(new CustomEvent('portal:widget-prefs-changed', { detail: next }));
      if (errorEl instanceof HTMLElement) errorEl.classList.add('hidden');
      if (savedEl instanceof HTMLElement) {
        const flash =
          typeof window.showSaveFlash === 'function'
            ? window.showSaveFlash
            : (el: HTMLElement) => el.classList.remove('hidden');
        flash(savedEl);
      }
    });
  }

  document.querySelectorAll('[data-settings-shell]').forEach((root) => setupSettingsNav(root));
  document.querySelectorAll('[data-theme-settings]').forEach((root) => setupTheme(root));
  document.querySelectorAll('[data-widget-settings]').forEach((root) => setupSettings(root));

  function setupCalendarSettings(root: Element) {
    if (!(root instanceof HTMLElement)) return;
    const saveButton = root.querySelector('[data-calendar-save]') as HTMLButtonElement | null;
    const refreshButton = root.querySelector('[data-calendar-refresh]') as HTMLButtonElement | null;
    const disconnectButton = root.querySelector('[data-calendar-disconnect]') as HTMLButtonElement | null;
    const savedEl = root.querySelector('[data-calendar-saved]') as HTMLElement | null;

    saveButton?.addEventListener('click', async () => {
      const enabledIds = Array.from(root.querySelectorAll('[data-calendar-option]'))
        .filter((node): node is HTMLInputElement => node instanceof HTMLInputElement && node.checked)
        .map((node) => node.value);
      const keywordsField = root.querySelector('[data-hidden-title-keywords]');
      const hideOutOfOfficeField = root.querySelector('[data-hide-out-of-office]');
      const hiddenTitleKeywords =
        keywordsField instanceof HTMLTextAreaElement
          ? keywordsField.value
              .split('\n')
              .map((line) => line.trim())
              .filter(Boolean)
          : [];
      const hideOutOfOffice =
        hideOutOfOfficeField instanceof HTMLInputElement ? hideOutOfOfficeField.checked : false;
      const coverTitles: Record<string, string> = {};
      for (const node of root.querySelectorAll('[data-calendar-cover]')) {
        if (!(node instanceof HTMLInputElement)) continue;
        const calendarId = node.dataset.calendarId;
        if (!calendarId) continue;
        coverTitles[calendarId] = node.value;
      }
      await fetch('/api/google-calendar/calendars', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ enabledIds, hiddenTitleKeywords, hideOutOfOffice, coverTitles }),
      });
      if (savedEl) {
        const flash =
          typeof window.showSaveFlash === 'function'
            ? window.showSaveFlash
            : (el: HTMLElement) => el.classList.remove('hidden');
        flash(savedEl);
      }
    });

    refreshButton?.addEventListener('click', async () => {
      await fetch('/api/google-calendar/calendars', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ refresh: true }),
      });
      window.location.reload();
    });

    disconnectButton?.addEventListener('click', async () => {
      await fetch('/api/google-calendar/disconnect', { method: 'POST' });
      window.location.reload();
    });
  }

  document.querySelectorAll('[data-calendar-settings]').forEach((root) => setupCalendarSettings(root));
</script>
