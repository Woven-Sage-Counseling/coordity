---
import PortalLayout from '../layouts/PortalLayout.astro';
import { availableWidgets, HOME_WIDGET_MAX } from '../lib/home-widgets';
import { hasPermission } from '../lib/permissions';
import { GoogleCalendarProvider } from '../lib/schedule/google-calendar';

export const prerender = false;

const employee = Astro.locals.employee!;
const canSeeFinancials = hasPermission(employee, 'financials:view');
const widgets = availableWidgets(canSeeFinancials);

const calendarProvider = new GoogleCalendarProvider();
let calendarConnection: Awaited<ReturnType<GoogleCalendarProvider['getConnection']>> = {
  status: 'disconnected',
  googleEmail: null,
  lastError: null,
  configured: calendarProvider.isConfigured(),
  hiddenTitleKeywords: [],
  hideOutOfOffice: false,
};
let calendarOptions: Array<{ id: string; name: string; enabled: boolean; color: string | null }> = [];

try {
  calendarConnection = await calendarProvider.getConnection(employee.id);
  if (calendarConnection.status === 'connected') {
    try {
      await calendarProvider.refreshCalendarList(employee.id);
    } catch (error) {
      console.error('settings calendar refresh failed', error);
    }
    calendarOptions = (await calendarProvider.listCalendars(employee.id)).map((calendar) => ({
      id: calendar.id,
      name: calendar.name,
      enabled: calendar.enabled,
      color: calendar.color,
    }));
  }
} catch (error) {
  console.error('settings calendar lookup failed', error);
}

const calendarNotice = Astro.url.searchParams.get('calendar') === 'connected'
  ? 'Google Calendar connected.'
  : Astro.url.searchParams.get('error');
---

<PortalLayout title="Settings">
  <p class="text-sm text-sage-dark/65">
    <a href="/" class="hover:text-sage-dark">Home</a>
    <span class="mx-1.5 text-sage-dark/35">/</span>
    Settings
  </p>
  <h1 class="mt-3 font-display text-4xl text-charcoal">Settings</h1>
  <p class="mt-3 max-w-2xl text-sage-dark/75">
    Personalize appearance and which widgets show on your home page.
  </p>

  <section class="card mt-8" data-theme-settings data-user-id={employee.id}>
    <h2 class="font-display text-2xl text-charcoal">Appearance</h2>
    <p class="mt-2 text-sm text-sage-dark/65">
      Switch between the light and dark employee portal themes.
    </p>

    <div class="mt-6 grid gap-3 sm:grid-cols-2" role="radiogroup" aria-label="Color theme">
      <label
        class="flex cursor-pointer items-start gap-3 rounded-xl border border-sage-dark/10 bg-[#f7f8f6] px-4 py-3 has-[:checked]:border-sage-dark/40 has-[:checked]:ring-2 has-[:checked]:ring-sage-dark/20"
      >
        <input
          type="radio"
          name="theme"
          value="light"
          class="mt-1 h-4 w-4 border-sage-dark/30 text-sage-dark focus:ring-sage-dark/30"
          data-theme-option
        />
        <span>
          <span class="block text-sm font-semibold text-charcoal">Light</span>
          <span class="mt-0.5 block text-sm text-sage-dark/65">Cream background and soft sage accents.</span>
        </span>
      </label>
      <label
        class="flex cursor-pointer items-start gap-3 rounded-xl border border-sage-dark/10 bg-[#f7f8f6] px-4 py-3 has-[:checked]:border-sage-dark/40 has-[:checked]:ring-2 has-[:checked]:ring-sage-dark/20"
      >
        <input
          type="radio"
          name="theme"
          value="dark"
          class="mt-1 h-4 w-4 border-sage-dark/30 text-sage-dark focus:ring-sage-dark/30"
          data-theme-option
        />
        <span>
          <span class="block text-sm font-semibold text-charcoal">Dark</span>
          <span class="mt-0.5 block text-sm text-sage-dark/65">Low-light surfaces with lighter text.</span>
        </span>
      </label>
    </div>
  </section>

  <section
    class="card mt-8"
    data-widget-settings
    data-user-id={employee.id}
    data-can-financials={canSeeFinancials ? '1' : '0'}
    data-max={HOME_WIDGET_MAX}
    data-catalog={JSON.stringify(widgets)}
  >
    <h2 class="font-display text-2xl text-charcoal">Home widgets</h2>
    <p class="mt-2 text-sm text-sage-dark/65">
      Enable widgets, then use the arrows to set carousel order (up to {HOME_WIDGET_MAX}).
    </p>

    <p
      class="mt-4 hidden rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800"
      data-settings-error
    ></p>
    <p
      class="mt-4 hidden rounded-xl border border-sage-dark/15 bg-white px-4 py-3 text-sm text-sage-dark/80"
      data-settings-saved
    >
      Saved. Your home page will use these choices next time you open it.
    </p>

    <ul class="mt-6 space-y-3" data-widget-list></ul>

    <div class="mt-8">
      <label for="default-widget" class="block text-sm font-semibold text-charcoal">
        Open home to
      </label>
      <p class="mt-1 text-sm text-sage-dark/65">
        This widget shows first when you land on Home after signing in.
      </p>
      <select id="default-widget" class="field mt-3 max-w-sm" data-widget-default></select>
    </div>

    <div class="mt-8 flex flex-wrap items-center gap-3">
      <button type="button" class="btn-primary" data-settings-save>Save preferences</button>
      <a href="/" class="text-sm text-sage-dark/70 hover:text-sage-dark">Back to home</a>
    </div>
  </section>

  <section class="card mt-8" id="google-calendar" data-calendar-settings>
    <h2 class="font-display text-2xl text-charcoal">Google Calendar</h2>
    <p class="mt-2 text-sm text-sage-dark/65">
      Connect your own Google account to show event titles on the Schedule home widget. Read-only access only.
    </p>

    {
      calendarNotice ? (
        <p class="mt-4 rounded-xl border border-sage-dark/15 bg-white px-4 py-3 text-sm text-sage-dark/80">
          {calendarNotice}
        </p>
      ) : null
    }

    {
      !calendarConnection.configured ? (
        <p class="mt-4 text-sm text-sage-dark/65">
          Google Calendar OAuth is not configured yet. Add <code class="text-xs">GOOGLE_CLIENT_ID</code> and{' '}
          <code class="text-xs">GOOGLE_CLIENT_SECRET</code> to the portal environment.
        </p>
      ) : calendarConnection.status !== 'connected' ? (
        <div class="mt-6">
          <form method="post" action="/api/google-calendar/connect">
            <input type="hidden" name="returnTo" value="/settings#google-calendar" />
            <button type="submit" class="btn-primary">Connect Google Calendar</button>
          </form>
        </div>
      ) : (
        <>
          <p class="mt-4 text-sm text-sage-dark/75">
            Connected as <span class="font-semibold text-charcoal">{calendarConnection.googleEmail}</span>.
          </p>
          <p class="mt-2 text-sm text-sage-dark/65">
            Check the calendars you want on the home Schedule widget, then save. Use Refresh list if a calendar is missing.
          </p>
          {
            calendarConnection.lastError ? (
              <p class="mt-3 text-sm text-red-700">{calendarConnection.lastError}</p>
            ) : null
          }
          <p
            class="mt-4 hidden rounded-xl border border-sage-dark/15 bg-white px-4 py-3 text-sm text-sage-dark/80"
            data-calendar-saved
          >
            Calendar preferences saved.
          </p>
          {
            calendarOptions.length === 0 ? (
              <p class="mt-6 text-sm text-sage-dark/65">
                No calendars loaded yet. Click <span class="font-semibold text-charcoal">Refresh list</span>.
              </p>
            ) : (
              <ul class="mt-6 space-y-3" data-calendar-list>
                {
                  calendarOptions.map((calendar) => (
                    <li class="flex items-start gap-3 rounded-xl border border-sage-dark/10 bg-[#f7f8f6] px-4 py-3">
                      <input
                        type="checkbox"
                        id={`calendar-${encodeURIComponent(calendar.id)}`}
                        value={calendar.id}
                        checked={calendar.enabled}
                        class="mt-1 h-4 w-4 rounded border-sage-dark/30 text-sage-dark focus:ring-sage-dark/30"
                        data-calendar-option
                      />
                      <label for={`calendar-${encodeURIComponent(calendar.id)}`} class="flex min-w-0 flex-1 cursor-pointer items-center gap-2">
                        <span
                          class="mt-0.5 h-3 w-3 shrink-0 rounded-sm"
                          style={`background-color: ${calendar.color ?? '#6b6c72'}`}
                          aria-hidden="true"
                        ></span>
                        <span class="block text-sm font-semibold text-charcoal">{calendar.name}</span>
                      </label>
                    </li>
                  ))
                }
              </ul>
            )
          }
          <div class="mt-8 border-t border-sage-dark/10 pt-6">
            <h3 class="text-sm font-semibold text-charcoal">Hide events</h3>
            <p class="mt-1 text-sm text-sage-dark/65">
              Hide specific overlapping busy blocks. Each line must match an event title exactly (case-insensitive).
            </p>
            <label for="hidden-title-keywords" class="mt-4 block text-sm font-medium text-charcoal">
              Hide these exact titles
            </label>
            <textarea
              id="hidden-title-keywords"
              class="field mt-2 min-h-[6rem]"
              rows="4"
              placeholder={'Not available\nBusy - Other Practice'}
              data-hidden-title-keywords
            >{calendarConnection.hiddenTitleKeywords.join('\n')}</textarea>
            <p class="mt-1 text-xs text-sage-dark/55">
              One full title per line. Example: <span class="font-medium text-sage-dark/70">Not available</span> will
              not hide <span class="font-medium text-sage-dark/70">Not available - Woven Sage</span>.
            </p>
            <label class="mt-4 flex cursor-pointer items-start gap-3">
              <input
                type="checkbox"
                class="mt-1 h-4 w-4 rounded border-sage-dark/30 text-sage-dark focus:ring-sage-dark/30"
                checked={calendarConnection.hideOutOfOffice}
                data-hide-out-of-office
              />
              <span>
                <span class="block text-sm font-medium text-charcoal">Hide Out of office events</span>
                <span class="mt-0.5 block text-sm text-sage-dark/65">
                  Hides Google Calendar out-of-office / unavailable blocks.
                </span>
              </span>
            </label>
          </div>
          <div class="mt-8 flex flex-wrap items-center gap-3">
            <button type="button" class="btn-primary" data-calendar-save>Save calendars</button>
            <button type="button" class="text-sm text-sage-dark/70 hover:text-sage-dark" data-calendar-refresh>
              Refresh list
            </button>
            <button type="button" class="text-sm text-red-700 hover:text-red-800" data-calendar-disconnect>
              Disconnect
            </button>
          </div>
        </>
      )
    }
  </section>
</PortalLayout>

<script>
  type Prefs = { enabled: string[]; defaultId: string };
  type CatalogItem = { id: string; label: string; description: string };

  function defaultPrefs(canFinancials: boolean): Prefs {
    const enabled = canFinancials
      ? ['schedule', 'quickbooks', 'coming_soon']
      : ['schedule', 'coming_soon'];
    return { enabled, defaultId: 'schedule' };
  }

  function applyTheme(theme: 'light' | 'dark', userId: string) {
    document.documentElement.classList.toggle('dark', theme === 'dark');
    try {
      localStorage.setItem('portal:theme:' + userId, theme);
      localStorage.setItem('portal:theme', theme);
    } catch {
      /* ignore */
    }
  }

  function setupTheme(root: Element) {
    if (!(root instanceof HTMLElement)) return;
    const userId = root.dataset.userId ?? '';
    const options = Array.from(root.querySelectorAll('[data-theme-option]')).filter(
      (el): el is HTMLInputElement => el instanceof HTMLInputElement,
    );
    let theme: 'light' | 'dark' = 'light';
    try {
      const raw =
        localStorage.getItem('portal:theme:' + userId) || localStorage.getItem('portal:theme');
      if (raw === 'dark') theme = 'dark';
    } catch {
      /* keep light */
    }
    options.forEach((option) => {
      option.checked = option.value === theme;
      option.addEventListener('change', () => {
        if (!option.checked) return;
        applyTheme(option.value === 'dark' ? 'dark' : 'light', userId);
      });
    });
  }

  function setupSettings(root: Element) {
    if (!(root instanceof HTMLElement)) return;
    const userId = root.dataset.userId ?? '';
    const canFinancials = root.dataset.canFinancials === '1';
    const max = Number(root.dataset.max || 10);
    const list = root.querySelector('[data-widget-list]');
    const select = root.querySelector('[data-widget-default]');
    const errorEl = root.querySelector('[data-settings-error]');
    const savedEl = root.querySelector('[data-settings-saved]');
    const saveBtn = root.querySelector('[data-settings-save]');
    if (!(list instanceof HTMLElement) || !(select instanceof HTMLSelectElement)) return;

    let catalog: CatalogItem[] = [];
    try {
      catalog = JSON.parse(root.dataset.catalog || '[]') as CatalogItem[];
    } catch {
      catalog = [];
    }

    const key = 'portal:home-widgets:' + userId;
    let prefs = defaultPrefs(canFinancials);
    try {
      const raw = localStorage.getItem(key);
      if (raw) {
        const parsed = JSON.parse(raw) as Prefs;
        if (Array.isArray(parsed.enabled) && parsed.enabled.length) {
          prefs = {
            enabled: parsed.enabled.filter((id) => catalog.some((w) => w.id === id)).slice(0, max),
            defaultId: parsed.defaultId || parsed.enabled[0]!,
          };
          if (!prefs.enabled.length) prefs = defaultPrefs(canFinancials);
        }
      }
    } catch {
      /* keep defaults */
    }

    // Ordered rows: enabled (in saved order) first, then remaining catalog items
    const orderedIds = [
      ...prefs.enabled,
      ...catalog.map((w) => w.id).filter((id) => !prefs.enabled.includes(id)),
    ];

    type RowState = { id: string; enabled: boolean };
    let rows: RowState[] = orderedIds.map((id) => ({
      id,
      enabled: prefs.enabled.includes(id),
    }));

    const moveBtnClass =
      'inline-flex h-8 w-8 items-center justify-center rounded-lg text-sage-dark/70 ring-1 ring-sage-dark/15 transition hover:bg-white hover:text-charcoal disabled:cursor-not-allowed disabled:opacity-30';

    const syncSelect = () => {
      const enabled = rows.filter((r) => r.enabled).map((r) => r.id);
      select.innerHTML = '';
      catalog.forEach((widget) => {
        if (!enabled.includes(widget.id)) return;
        const opt = document.createElement('option');
        opt.value = widget.id;
        opt.textContent = widget.label;
        select.appendChild(opt);
      });
      if (enabled.includes(select.value) === false && enabled[0]) {
        select.value = enabled[0];
      } else if (enabled.includes(prefs.defaultId)) {
        select.value = prefs.defaultId;
      }
    };

    const render = () => {
      list.innerHTML = '';
      rows.forEach((row, index) => {
        const widget = catalog.find((w) => w.id === row.id);
        if (!widget) return;

        const li = document.createElement('li');
        li.className =
          'flex flex-wrap items-center gap-3 rounded-xl border border-sage-dark/10 bg-[#f7f8f6] px-4 py-3';
        li.dataset.widgetId = row.id;

        const check = document.createElement('input');
        check.type = 'checkbox';
        check.id = `widget-${row.id}`;
        check.value = row.id;
        check.checked = row.enabled;
        check.className =
          'h-4 w-4 rounded border-sage-dark/30 text-sage-dark focus:ring-sage-dark/30';
        check.addEventListener('change', () => {
          const enabledCount = rows.filter((r) => r.enabled).length;
          if (check.checked && enabledCount >= max) {
            check.checked = false;
            if (errorEl instanceof HTMLElement) {
              errorEl.textContent = `You can enable at most ${max} widgets.`;
              errorEl.classList.remove('hidden');
            }
            return;
          }
          if (!check.checked && rows.filter((r) => r.enabled).length <= 1) {
            check.checked = true;
            if (errorEl instanceof HTMLElement) {
              errorEl.textContent = 'Keep at least one widget enabled.';
              errorEl.classList.remove('hidden');
            }
            return;
          }
          row.enabled = check.checked;
          if (errorEl instanceof HTMLElement) errorEl.classList.add('hidden');
          if (savedEl instanceof HTMLElement) savedEl.classList.add('hidden');
          syncSelect();
          render();
        });

        const label = document.createElement('label');
        label.htmlFor = check.id;
        label.className = 'min-w-0 flex-1 cursor-pointer';
        label.innerHTML = `<span class="block text-sm font-semibold text-charcoal"></span><span class="mt-0.5 block text-sm text-sage-dark/65"></span>`;
        (label.children[0] as HTMLElement).textContent = widget.label;
        (label.children[1] as HTMLElement).textContent = widget.description;

        const controls = document.createElement('div');
        controls.className = 'flex items-center gap-1';

        const up = document.createElement('button');
        up.type = 'button';
        up.className = moveBtnClass;
        up.setAttribute('aria-label', `Move ${widget.label} up`);
        up.disabled = index === 0;
        up.innerHTML =
          '<svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 10l5-5 5 5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg>';
        up.addEventListener('click', () => {
          if (index === 0) return;
          const tmp = rows[index - 1]!;
          rows[index - 1] = rows[index]!;
          rows[index] = tmp;
          if (savedEl instanceof HTMLElement) savedEl.classList.add('hidden');
          render();
          syncSelect();
        });

        const down = document.createElement('button');
        down.type = 'button';
        down.className = moveBtnClass;
        down.setAttribute('aria-label', `Move ${widget.label} down`);
        down.disabled = index === rows.length - 1;
        down.innerHTML =
          '<svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 6l5 5 5-5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg>';
        down.addEventListener('click', () => {
          if (index >= rows.length - 1) return;
          const tmp = rows[index + 1]!;
          rows[index + 1] = rows[index]!;
          rows[index] = tmp;
          if (savedEl instanceof HTMLElement) savedEl.classList.add('hidden');
          render();
          syncSelect();
        });

        controls.appendChild(up);
        controls.appendChild(down);
        li.appendChild(check);
        li.appendChild(label);
        li.appendChild(controls);
        list.appendChild(li);
      });
      syncSelect();
    };

    render();
    if (prefs.enabled.includes(prefs.defaultId)) {
      select.value = prefs.defaultId;
    }

    saveBtn?.addEventListener('click', () => {
      const enabled = rows.filter((r) => r.enabled).map((r) => r.id).slice(0, max);
      if (enabled.length === 0) {
        if (errorEl instanceof HTMLElement) {
          errorEl.textContent = 'Keep at least one widget enabled.';
          errorEl.classList.remove('hidden');
        }
        return;
      }
      const defaultId = enabled.includes(select.value) ? select.value : enabled[0]!;
      const next: Prefs = { enabled, defaultId };
      localStorage.setItem(key, JSON.stringify(next));
      prefs = next;
      if (errorEl instanceof HTMLElement) errorEl.classList.add('hidden');
      if (savedEl instanceof HTMLElement) savedEl.classList.remove('hidden');
    });
  }

  document.querySelectorAll('[data-theme-settings]').forEach((root) => setupTheme(root));
  document.querySelectorAll('[data-widget-settings]').forEach((root) => setupSettings(root));

  function setupCalendarSettings(root: Element) {
    if (!(root instanceof HTMLElement)) return;
    const saveButton = root.querySelector('[data-calendar-save]') as HTMLButtonElement | null;
    const refreshButton = root.querySelector('[data-calendar-refresh]') as HTMLButtonElement | null;
    const disconnectButton = root.querySelector('[data-calendar-disconnect]') as HTMLButtonElement | null;
    const savedEl = root.querySelector('[data-calendar-saved]') as HTMLElement | null;

    saveButton?.addEventListener('click', async () => {
      const enabledIds = Array.from(root.querySelectorAll('[data-calendar-option]'))
        .filter((node): node is HTMLInputElement => node instanceof HTMLInputElement && node.checked)
        .map((node) => node.value);
      const keywordsField = root.querySelector('[data-hidden-title-keywords]');
      const hideOutOfOfficeField = root.querySelector('[data-hide-out-of-office]');
      const hiddenTitleKeywords =
        keywordsField instanceof HTMLTextAreaElement
          ? keywordsField.value
              .split('\n')
              .map((line) => line.trim())
              .filter(Boolean)
          : [];
      const hideOutOfOffice =
        hideOutOfOfficeField instanceof HTMLInputElement ? hideOutOfOfficeField.checked : false;
      await fetch('/api/google-calendar/calendars', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ enabledIds, hiddenTitleKeywords, hideOutOfOffice }),
      });
      if (savedEl) savedEl.classList.remove('hidden');
    });

    refreshButton?.addEventListener('click', async () => {
      await fetch('/api/google-calendar/calendars', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ refresh: true }),
      });
      window.location.reload();
    });

    disconnectButton?.addEventListener('click', async () => {
      await fetch('/api/google-calendar/disconnect', { method: 'POST' });
      window.location.reload();
    });
  }

  document.querySelectorAll('[data-calendar-settings]').forEach((root) => setupCalendarSettings(root));
</script>
