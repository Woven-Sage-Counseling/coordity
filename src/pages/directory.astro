---
import PortalLayout from '../layouts/PortalLayout.astro';
import DirectoryPeopleTable from '../components/DirectoryPeopleTable.astro';
import { groupDirectoryByTeam, listDirectory, listDirectoryClinicians } from '../lib/employees';
import { listUsersOnApprovedTimeOffNow } from '../lib/time-off-requests';
import { listActiveShiftUserIds, listOnBreakUserIds } from '../lib/timesheet-entries';

export const prerender = false;

const people = await listDirectory();
const [activeShiftUserIds, onBreakUserIds, timeOffUserIds, clinicians] = await Promise.all([
  listActiveShiftUserIds(),
  listOnBreakUserIds(),
  listUsersOnApprovedTimeOffNow(),
  listDirectoryClinicians(),
]);
const onShiftUserIds = [...activeShiftUserIds];
const onBreakIds = [...onBreakUserIds];
const travelingUserIds = [...timeOffUserIds];
const clinicianUserIds = clinicians.map((person) => person.id);
const { groups, unassigned } = groupDirectoryByTeam(people);
---

<PortalLayout title="Directory" wide>
  <h1 class="font-display text-4xl text-charcoal sm:text-5xl">Directory</h1>
  <p class="mt-3 max-w-2xl text-sage-dark/75">
    Update your own name and phone on Account. Job titles and teams are set by management.
  </p>

  {
    people.length === 0 ? (
      <p class="mt-10 text-sm text-sage-dark/65">No active employees yet.</p>
    ) : (
      <div class="mt-10 space-y-12">
        {groups.map((group) => (
          <section aria-labelledby={`team-${group.id}`}>
            <h2 id={`team-${group.id}`} class="font-display text-3xl text-charcoal">
              {group.name}
            </h2>
            {
              group.people.length === 0 ? (
                <p class="mt-3 text-sm text-sage-dark/55">No one assigned yet.</p>
              ) : (
                <DirectoryPeopleTable
                  people={group.people}
                  onShiftUserIds={onShiftUserIds}
                  onBreakUserIds={onBreakIds}
                  travelingUserIds={travelingUserIds}
                  clinicianUserIds={clinicianUserIds}
                />
              )
            }
          </section>
        ))}

        {
          unassigned.length > 0 ? (
            <section aria-labelledby="team-unassigned">
              <h2 id="team-unassigned" class="font-display text-3xl text-charcoal">
                Unassigned
              </h2>
              <DirectoryPeopleTable
                people={unassigned}
                onShiftUserIds={onShiftUserIds}
                onBreakUserIds={onBreakIds}
                travelingUserIds={travelingUserIds}
                clinicianUserIds={clinicianUserIds}
              />
            </section>
          ) : null
        }
      </div>
    )
  }
</PortalLayout>
