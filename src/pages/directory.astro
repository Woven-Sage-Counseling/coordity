---
import PortalLayout from '../layouts/PortalLayout.astro';
import ShiftStatusIndicator from '../components/ShiftStatusIndicator.astro';
import { groupDirectoryByTeam, listDirectory, type DirectoryPerson } from '../lib/employees';
import { listActiveShiftUserIds } from '../lib/timesheet-entries';

export const prerender = false;

const people = await listDirectory();
const activeShiftUserIds = await listActiveShiftUserIds();
const { groups, unassigned } = groupDirectoryByTeam(people);

function isOnShift(person: DirectoryPerson): boolean {
  return activeShiftUserIds.has(person.id);
}

function initials(name: string): string {
  return name
    .split(/\s+/)
    .filter(Boolean)
    .slice(0, 2)
    .map((part) => part[0]?.toUpperCase() ?? '')
    .join('');
}

function personCells(person: DirectoryPerson) {
  return {
    avatar: person.hasAvatar ? `/api/avatars/${person.id}` : null,
    initials: initials(person.name) || '?',
  };
}
---

<PortalLayout title="Directory" wide>
  <h1 class="font-display text-4xl text-charcoal sm:text-5xl">Directory</h1>
  <p class="mt-3 max-w-2xl text-sage-dark/75">
    Update your own name and phone on Account. Job titles and teams are set by management.
  </p>

  {
    people.length === 0 ? (
      <p class="mt-10 text-sm text-sage-dark/65">No active employees yet.</p>
    ) : (
      <div class="mt-10 space-y-12">
        {groups.map((group) => (
          <section aria-labelledby={`team-${group.id}`}>
            <h2 id={`team-${group.id}`} class="font-display text-3xl text-charcoal">
              {group.name}
            </h2>
            {group.people.length === 0 ? (
              <p class="mt-3 text-sm text-sage-dark/55">No one assigned yet.</p>
            ) : (
              <div class="mt-4 overflow-x-auto">
                <table class="min-w-full text-left text-sm">
                  <thead>
                    <tr class="border-b border-sage-dark/15 text-sage-dark/60">
                      <th class="py-2 pr-4 font-medium">Name</th>
                      <th class="py-2 pr-4 font-medium">Status</th>
                      <th class="py-2 pr-4 font-medium">Job title</th>
                      <th class="py-2 pr-4 font-medium">Email</th>
                      <th class="py-2 font-medium">Phone</th>
                    </tr>
                  </thead>
                  <tbody>
                    {group.people.map((person) => {
                      const meta = personCells(person);
                      return (
                        <tr class="border-b border-sage-dark/10">
                          <td class="py-3 pr-4">
                            <div class="flex items-center gap-3">
                              {meta.avatar ? (
                                <img
                                  src={meta.avatar}
                                  alt=""
                                  width="36"
                                  height="36"
                                  class="h-9 w-9 rounded-full object-cover ring-1 ring-black/10"
                                />
                              ) : (
                                <div class="flex h-9 w-9 items-center justify-center rounded-full bg-[#e8ebe7] text-xs font-semibold text-sage-dark ring-1 ring-black/10">
                                  {meta.initials}
                                </div>
                              )}
                              <span class="font-medium text-charcoal">{person.name}</span>
                            </div>
                          </td>
                          <td class="py-3 pr-4">
                            <ShiftStatusIndicator onShift={isOnShift(person)} compact />
                          </td>
                          <td class="py-3 pr-4 text-sage-dark/80">{person.jobTitle || '—'}</td>
                          <td class="py-3 pr-4">
                            <a
                              class="text-charcoal underline-offset-2 hover:underline"
                              href={`mailto:${person.email}`}
                            >
                              {person.email}
                            </a>
                          </td>
                          <td class="py-3">
                            {person.phone ? (
                              <a
                                class="text-charcoal underline-offset-2 hover:underline"
                                href={`tel:${person.phone}`}
                              >
                                {person.phone}
                              </a>
                            ) : (
                              <span class="text-sage-dark/50">—</span>
                            )}
                          </td>
                        </tr>
                      );
                    })}
                  </tbody>
                </table>
              </div>
            )}
          </section>
        ))}

        {unassigned.length > 0 && (
          <section aria-labelledby="team-unassigned">
            <h2 id="team-unassigned" class="font-display text-3xl text-charcoal">
              Unassigned
            </h2>
            <div class="mt-4 overflow-x-auto">
              <table class="min-w-full text-left text-sm">
                <thead>
                  <tr class="border-b border-sage-dark/15 text-sage-dark/60">
                    <th class="py-2 pr-4 font-medium">Name</th>
                    <th class="py-2 pr-4 font-medium">Status</th>
                    <th class="py-2 pr-4 font-medium">Job title</th>
                    <th class="py-2 pr-4 font-medium">Email</th>
                    <th class="py-2 font-medium">Phone</th>
                  </tr>
                </thead>
                <tbody>
                  {unassigned.map((person) => {
                    const meta = personCells(person);
                    return (
                      <tr class="border-b border-sage-dark/10">
                        <td class="py-3 pr-4">
                          <div class="flex items-center gap-3">
                            {meta.avatar ? (
                              <img
                                src={meta.avatar}
                                alt=""
                                width="36"
                                height="36"
                                class="h-9 w-9 rounded-full object-cover ring-1 ring-black/10"
                              />
                            ) : (
                              <div class="flex h-9 w-9 items-center justify-center rounded-full bg-[#e8ebe7] text-xs font-semibold text-sage-dark ring-1 ring-black/10">
                                {meta.initials}
                              </div>
                            )}
                            <span class="font-medium text-charcoal">{person.name}</span>
                          </div>
                        </td>
                        <td class="py-3 pr-4">
                          <ShiftStatusIndicator onShift={isOnShift(person)} compact />
                        </td>
                        <td class="py-3 pr-4 text-sage-dark/80">{person.jobTitle || '—'}</td>
                        <td class="py-3 pr-4">
                          <a
                            class="text-charcoal underline-offset-2 hover:underline"
                            href={`mailto:${person.email}`}
                          >
                            {person.email}
                          </a>
                        </td>
                        <td class="py-3">
                          {person.phone ? (
                            <a
                              class="text-charcoal underline-offset-2 hover:underline"
                              href={`tel:${person.phone}`}
                            >
                              {person.phone}
                            </a>
                          ) : (
                            <span class="text-sage-dark/50">—</span>
                          )}
                        </td>
                      </tr>
                    );
                  })}
                </tbody>
              </table>
            </div>
          </section>
        )}
      </div>
    )
  }
</PortalLayout>
