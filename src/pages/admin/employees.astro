---
import PortalLayout from '../../layouts/PortalLayout.astro';
import { listEmployees, listRoles } from '../../lib/employees';
import { listPendingInvites } from '../../lib/invites';
import { hasPermission } from '../../lib/permissions';

export const prerender = false;

const employee = Astro.locals.employee!;
if (!hasPermission(employee, 'employees:manage')) {
  return new Response('Forbidden', { status: 403 });
}

const people = await listEmployees();
const roles = await listRoles();
const invites = await listPendingInvites();
const error = Astro.url.searchParams.get('error');
const inviteUrl = Astro.url.searchParams.get('inviteUrl');
---

<PortalLayout title="Employees" wide>
  <h1 class="font-display text-4xl text-charcoal">Employees and roles</h1>
  <p class="mt-4 max-w-2xl text-sage-dark/75">
    Invite-only. New people cannot register themselves. Disabling an account ends their session
    immediately.
  </p>

  {
    error && (
      <p class="mt-6 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800">{error}</p>
    )
  }
  {
    inviteUrl && (
      <p class="mt-6 break-all rounded-xl border border-sage-dark/15 bg-white px-4 py-3 text-sm">
        Invite link (send this privately — email delivery is not connected yet):
        <br />
        <a class="underline" href={inviteUrl}>{inviteUrl}</a>
      </p>
    )
  }

  <form method="post" action="/api/employees/invite" class="card mt-8 grid gap-4 sm:grid-cols-2">
    <h2 class="font-display text-2xl sm:col-span-2">Invite employee</h2>
    <label class="text-sm font-medium">
      Name
      <input class="field" type="text" name="name" required />
    </label>
    <label class="text-sm font-medium">
      Email
      <input class="field" type="email" name="email" required />
    </label>
    <label class="text-sm font-medium sm:col-span-2">
      Role
      <select class="field" name="roleId" required>
        {roles.map((role) => (
          <option value={role.id}>{role.name}</option>
        ))}
      </select>
    </label>
    <button class="btn-primary sm:col-span-2 w-fit" type="submit">Send invite</button>
  </form>

  <section class="mt-12">
    <h2 class="font-display text-3xl">People</h2>
    <div class="mt-4 overflow-x-auto">
      <table class="min-w-full text-left text-sm">
        <thead>
          <tr class="border-b border-sage-dark/15 text-sage-dark/60">
            <th class="py-2 pr-4 font-medium">Name</th>
            <th class="py-2 pr-4 font-medium">Email</th>
            <th class="py-2 pr-4 font-medium">Role</th>
            <th class="py-2 pr-4 font-medium">Status</th>
            <th class="py-2 font-medium">Actions</th>
          </tr>
        </thead>
        <tbody>
          {
            people.map((person) => (
              <tr class="border-b border-sage-dark/10">
                <td class="py-3 pr-4">{person.name}</td>
                <td class="py-3 pr-4">{person.email}</td>
                <td class="py-3 pr-4 capitalize">{person.roles.join(', ') || '—'}</td>
                <td class="py-3 pr-4 capitalize">{person.status}</td>
                <td class="py-3">
                  <div class="flex flex-wrap gap-2">
                    <form method="post" action="/api/employees/update">
                      <input type="hidden" name="userId" value={person.id} />
                      <input type="hidden" name="action" value="role" />
                      <select class="field !mt-0 !py-1.5" name="roleId">
                        {roles.map((role) => (
                          <option value={role.id} selected={person.roles.includes(role.key)}>
                            {role.name}
                          </option>
                        ))}
                      </select>
                      <button class="btn-secondary ml-2 !px-3 !py-1.5" type="submit">
                        Update role
                      </button>
                    </form>
                    {
                      person.status !== 'disabled' && person.id !== employee.id && (
                        <form method="post" action="/api/employees/update">
                          <input type="hidden" name="userId" value={person.id} />
                          <input type="hidden" name="action" value="disable" />
                          <button class="btn-secondary !px-3 !py-1.5" type="submit">
                            Disable
                          </button>
                        </form>
                      )
                    }
                    {
                      person.status === 'disabled' && (
                        <form method="post" action="/api/employees/update">
                          <input type="hidden" name="userId" value={person.id} />
                          <input type="hidden" name="action" value="enable" />
                          <button class="btn-secondary !px-3 !py-1.5" type="submit">
                            Reactivate
                          </button>
                        </form>
                      )
                    }
                  </div>
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </section>

  {
    invites.length > 0 && (
      <section class="mt-12">
        <h2 class="font-display text-3xl">Pending invites</h2>
        <ul class="mt-4 space-y-2 text-sm">
          {invites.map((invite) => (
            <li class="card">
              {invite.name} · {invite.email} · {invite.role_name}
            </li>
          ))}
        </ul>
      </section>
    )
  }
</PortalLayout>
