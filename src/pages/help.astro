---
import PortalLayout from '../layouts/PortalLayout.astro';

export const prerender = false;
---

<PortalLayout title="Help">
  <h1 class="font-display text-4xl text-charcoal sm:text-5xl">Help</h1>
  <p class="mt-4 text-sage-dark/80">
    Portal guides and tutorials are coming soon. Check back here for step-by-step walkthroughs on
    timesheets, time off, and other portal features.
  </p>
  <p class="mt-3 text-sm text-sage-dark/65">
    Need something right away? Use <strong class="font-medium text-charcoal">Report an issue</strong> at the
    bottom of any page, or ask your admin.
  </p>
</PortalLayout>
