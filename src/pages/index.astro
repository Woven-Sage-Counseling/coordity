---
import PortalLayout from '../layouts/PortalLayout.astro';
import AppCard from '../components/AppCard.astro';
import AnnouncementsPanel from '../components/AnnouncementsPanel.astro';
import HomeShortcuts from '../components/HomeShortcuts.astro';
import HomeWidgetCarousel from '../components/HomeWidgetCarousel.astro';
import ShiftStatusIndicator from '../components/ShiftStatusIndicator.astro';
import { appCategories, portalApps } from '../lib/apps';
import { listAnnouncementsForUser, countUnreadAnnouncements } from '../lib/announcements';
import { listNotificationsForUser, countUnreadNotifications } from '../lib/notifications';
import { canAccessManagement, hasPermission } from '../lib/permissions';
import { canSeeCredentialing } from '../lib/credentialing';
import { canSeeCaseload } from '../lib/caseload';
import { canUseTimesheet } from '../lib/timesheet-access';
import { getActiveShift } from '../lib/timesheet-entries';
import { isUserOnApprovedTimeOffNow } from '../lib/time-off-requests';

export const prerender = false;

const employee = Astro.locals.employee!;
const visibleApps = portalApps.filter((app) => hasPermission(employee, app.permission));
const firstName = employee.name.split(' ')[0] || employee.name;
const canSeeFinancials = hasPermission(employee, 'financials:view');
const canSeeCredentialingWidget = canSeeCredentialing(employee);
const canSeeCaseloadWidget = canSeeCaseload(employee);
const canSeeTimesheet = canUseTimesheet(employee);
const canSeeAdmin = canAccessManagement(employee);
const announcements = await listAnnouncementsForUser(employee.id);
const announcementUnreadCount = await countUnreadAnnouncements(employee.id);
const notifications = await listNotificationsForUser(employee.id);
const notificationUnreadCount = await countUnreadNotifications(employee.id);

const activeShift = canSeeTimesheet ? await getActiveShift(employee.id) : null;
const onShift = activeShift != null;
const onTimeOff = await isUserOnApprovedTimeOffNow(employee.id);
---

<PortalLayout title="Home" wide>
  <div>
    <div class="flex flex-wrap items-center gap-3">
      <h1 class="font-display text-4xl text-charcoal sm:text-5xl">Welcome back, {firstName}.</h1>
      <ShiftStatusIndicator
        onShift={onShift}
        onTimeOff={onTimeOff}
        showLabel
        self
        showShiftStatus={canSeeTimesheet}
      />
    </div>

    <AnnouncementsPanel
      announcements={announcements}
      announcementUnreadCount={announcementUnreadCount}
      notifications={notifications}
      notificationUnreadCount={notificationUnreadCount}
      canSeeAdmin={canSeeAdmin}
    />

    <HomeShortcuts userId={employee.id} canSeeFinancials={canSeeFinancials} />

    <div class="mt-8">
      <HomeWidgetCarousel
        userId={employee.id}
        employee={employee}
        canSeeFinancials={canSeeFinancials}
        canSeeCredentialing={canSeeCredentialingWidget}
        canSeeClinical={canSeeCaseloadWidget}
        canSeeTimesheet={canSeeTimesheet}
      />
    </div>

    {
      appCategories.map((category) => {
        const apps = visibleApps.filter((app) => app.category === category.id);
        if (apps.length === 0) return null;
        return (
          <section class="mt-12" aria-labelledby={`${category.id}-heading`}>
            <h2 id={`${category.id}-heading`} class="font-display text-3xl text-charcoal">
              {category.title}
            </h2>
            <div class="mt-5 flex flex-wrap gap-x-4 gap-y-6">
              {apps.map((app) => (
                <AppCard app={app} />
              ))}
            </div>
          </section>
        );
      })
    }
  </div>
</PortalLayout>
