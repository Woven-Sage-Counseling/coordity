---
import PortalLayout from '../layouts/PortalLayout.astro';
import AppCard from '../components/AppCard.astro';
import AnnouncementsPanel from '../components/AnnouncementsPanel.astro';
import HomeBulletinBoard from '../components/HomeBulletinBoard.astro';
import HomeShortcuts from '../components/HomeShortcuts.astro';
import HomeWidgetCarousel from '../components/HomeWidgetCarousel.astro';
import ShiftStatusIndicator from '../components/ShiftStatusIndicator.astro';
import CoordityLanding from '../components/CoordityLanding.astro';
import { appCategories, portalApps } from '../lib/apps';
import { listAnnouncementsForUser, countUnreadAnnouncements } from '../lib/announcements';
import { listNotificationsForUser, countUnreadNotifications } from '../lib/notifications';
import { canAccessManagement, hasPermission } from '../lib/permissions';
import { canSeeCredentialing } from '../lib/credentialing';
import { canSeeCaseload } from '../lib/caseload';
import { canUseTimesheet } from '../lib/timesheet-access';
import { getActiveShift } from '../lib/timesheet-entries';
import { isOnBreak } from '../lib/timesheet-breaks';
import { isUserOnApprovedTimeOffNow } from '../lib/time-off-requests';
import { COMPANY_WORDMARK_SRC, PORTAL_MARK_SRC } from '../lib/home-layout';
import { resolveEffectiveHomeComposition } from '../lib/home-user-prefs';
import { orgIdFromLocals } from '../lib/organization';

export const prerender = false;

const isApex = Astro.locals.isCoordityApex;
const landingError = Astro.url.searchParams.get('error');

if (isApex) {
  // Product marketing shell — rendered below without employee data.
} else {
  // Tenant home requires an authenticated employee (middleware enforces).
}

const employee = isApex ? null : Astro.locals.employee!;
const orgId = isApex ? null : orgIdFromLocals(Astro.locals.organization);
const visibleApps = employee ? portalApps.filter((app) => hasPermission(employee, app.permission)) : [];
const firstName = employee ? employee.name.split(' ')[0] || employee.name : '';
const canSeeFinancials = employee ? hasPermission(employee, 'financials:view') : false;
const canSeeCredentialingWidget = employee ? canSeeCredentialing(employee) : false;
const canSeeCaseloadWidget = employee ? canSeeCaseload(employee) : false;
const canSeeTimesheet = employee ? canUseTimesheet(employee) : false;
const canSeeAdmin = employee ? canAccessManagement(employee) : false;

const announcements = employee ? await listAnnouncementsForUser(employee.id) : [];
const announcementUnreadCount = employee ? await countUnreadAnnouncements(employee.id) : 0;
const notifications = employee ? await listNotificationsForUser(employee.id) : [];
const notificationUnreadCount = employee ? await countUnreadNotifications(employee.id) : 0;

const activeShift = employee && canSeeTimesheet ? await getActiveShift(employee.id) : null;
const onShift = activeShift != null;
const onBreak = activeShift ? isOnBreak(activeShift.breaks) : false;
const onTimeOff = employee ? await isUserOnApprovedTimeOffNow(employee.id) : false;

const layout =
  employee && orgId
    ? await resolveEffectiveHomeComposition({ userId: employee.id, orgId })
    : null;
const showRail = layout?.showRail ?? false;
const railBoard = layout?.showRailBoard ?? false;
const railWidgets = layout?.showRailWidgets ?? false;
const railImageUrl = layout?.railImageUrl ?? null;
const belowBoard = layout?.showBelowBoard ?? false;
const belowWidgets = layout?.showBelowWidgets ?? false;
const suggestOnRail = railBoard;
const suggestOnBelow = belowBoard;

const widgetProps = employee
  ? {
      userId: employee.id,
      employee,
      canSeeFinancials,
      canSeeCredentialing: canSeeCredentialingWidget,
      canSeeClinical: canSeeCaseloadWidget,
      canSeeTimesheet,
    }
  : null;
---

{
  isApex ? (
    <CoordityLanding error={landingError} />
  ) : (
<PortalLayout title="Home" wide>
  <div
    class:list={[
      'flex flex-col lg:items-start lg:gap-8',
      showRail ? 'lg:grid lg:grid-cols-[minmax(0,1fr)_24rem]' : '',
    ]}
  >
    <div class="order-1 min-w-0 lg:order-1">
      <div class="flex flex-wrap items-center gap-3">
        <h1 class="font-display text-4xl text-charcoal sm:text-5xl">Welcome back, {firstName}.</h1>
        <ShiftStatusIndicator
          onShift={onShift}
          onBreak={onBreak}
          onTimeOff={onTimeOff}
          showLabel
          self
          showShiftStatus={canSeeTimesheet}
        />
      </div>

      <AnnouncementsPanel
        announcements={announcements}
        announcementUnreadCount={announcementUnreadCount}
        notifications={notifications}
        notificationUnreadCount={notificationUnreadCount}
        canSeeAdmin={canSeeAdmin}
      />

      <HomeShortcuts userId={employee!.id} canSeeFinancials={canSeeFinancials} />

      {
        belowBoard ? (
          <div class="mt-8">
            <HomeBulletinBoard
              shape="landscape"
              surface={layout!.surface}
              showSuggest={suggestOnBelow}
            />
          </div>
        ) : null
      }
    </div>

    {
      showRail ? (
        <aside class="order-2 mt-8 flex min-w-0 flex-col gap-6 lg:order-2 lg:mt-0">
          {railBoard ? (
            <HomeBulletinBoard shape="portrait" surface={layout!.surface} showSuggest={suggestOnRail} />
          ) : null}
          {railWidgets ? (
            <div class="min-w-0">
              <HomeWidgetCarousel {...widgetProps!} />
            </div>
          ) : null}
          {layout!.showRailImage && railImageUrl ? (
            <div class="overflow-hidden rounded-[1.05rem] bg-white/80 p-6 shadow-sm ring-1 ring-black/10">
              <img
                src={
                  layout!.railSlot === 'portal'
                    ? PORTAL_MARK_SRC
                    : layout!.railSlot === 'company' && !layout!.hasRailImage
                      ? COMPANY_WORDMARK_SRC
                      : railImageUrl
                }
                alt=""
                class="mx-auto max-h-64 w-full object-contain"
              />
            </div>
          ) : null}
        </aside>
      ) : null
    }
  </div>

  {
    belowWidgets ? (
      <div class="mt-8">
        <HomeWidgetCarousel {...widgetProps!} />
      </div>
    ) : null
  }

  {
    appCategories.map((category) => {
      const apps = visibleApps.filter((app) => app.category === category.id);
      if (apps.length === 0) return null;
      return (
        <section class="mt-12" aria-labelledby={`${category.id}-heading`}>
          <h2 id={`${category.id}-heading`} class="font-display text-3xl text-charcoal">
            {category.title}
          </h2>
          <div class="mt-5 flex flex-wrap gap-x-4 gap-y-6">
            {apps.map((app) => (
              <AppCard app={app} />
            ))}
          </div>
        </section>
      );
    })
  }
</PortalLayout>
  )
}
