      const trainingFilledHover = readColor(`trainingFilledHoverColor${suffix}`);
      const trainingOutline = readColor(`trainingOutlineColor${suffix}`);
      const trainingOutlineText = readColor(`trainingOutlineTextColor${suffix}`);
