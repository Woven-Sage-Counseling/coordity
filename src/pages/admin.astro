<script>
  function setupAdminNav(shell: Element) {
    if (!(shell instanceof HTMLElement)) return;
    const empty = shell.querySelector('[data-admin-empty]');
    const menu = shell.querySelector('[data-admin-menu]');
    const menuBody = shell.querySelector('[data-admin-menu-body]');
    const menuIcons = shell.querySelector('[data-admin-menu-icons]');
    const menuToggle = shell.querySelector('[data-admin-menu-toggle]');
    const menuToggleIcon = shell.querySelector('[data-admin-menu-toggle-icon]');
    const menuToggleLabel = shell.querySelector('[data-admin-menu-toggle-label]');
    const menuToggleRow = menuToggle?.parentElement ?? null;
    const panels = Array.from(shell.querySelectorAll('[data-admin-panel]')).filter(
      (node): node is HTMLElement => node instanceof HTMLElement,
    );
    const openButtons = Array.from(shell.querySelectorAll('[data-admin-open]')).filter(
      (node): node is HTMLButtonElement => node instanceof HTMLButtonElement,
    );

    const MENU_COLLAPSE_KEY = 'portal:admin-menu-collapsed';
    const setMenuCollapsed = (collapsed: boolean) => {
      if (!(menu instanceof HTMLElement)) return;
      menu.dataset.collapsed = collapsed ? 'true' : 'false';
      if (menuBody instanceof HTMLElement) {
        menuBody.dataset.collapsed = collapsed ? 'true' : 'false';
        menuBody.classList.toggle('hidden', collapsed);
        menuBody.setAttribute('aria-hidden', collapsed ? 'true' : 'false');
      }
      if (menuIcons instanceof HTMLElement) {
        menuIcons.dataset.collapsed = collapsed ? 'true' : 'false';
        menuIcons.classList.toggle('hidden', !collapsed);
        menuIcons.classList.toggle('flex', collapsed);
        menuIcons.classList.toggle('overflow-visible', collapsed);
        menuIcons.setAttribute('aria-hidden', collapsed ? 'false' : 'true');
      }
      if (menuToggleRow instanceof HTMLElement) {
        menuToggleRow.dataset.collapsed = collapsed ? 'true' : 'false';
        menuToggleRow.classList.toggle('justify-center', collapsed);
        menuToggleRow.classList.toggle('justify-end', !collapsed);
      }
      if (menuToggle instanceof HTMLButtonElement) {
        menuToggle.setAttribute('aria-expanded', collapsed ? 'false' : 'true');
        menuToggle.title = collapsed ? 'Expand menu' : 'Collapse menu';
      }
      if (menuToggleLabel instanceof HTMLElement) {
        menuToggleLabel.textContent = collapsed ? 'Expand menu' : 'Collapse menu';
      }
      if (menuToggleIcon instanceof SVGElement) {
        menuToggleIcon.style.transform = collapsed ? 'rotate(180deg)' : '';
        menuToggleIcon.style.transition = 'transform 200ms ease';
      }
      try {
        localStorage.setItem(MENU_COLLAPSE_KEY, collapsed ? '1' : '0');
      } catch (e) {}
    };

    let menuCollapsed = false;
    try {
      menuCollapsed = localStorage.getItem(MENU_COLLAPSE_KEY) === '1';
    } catch (e) {}
    setMenuCollapsed(menuCollapsed);

    if (menuToggle instanceof HTMLButtonElement) {
      menuToggle.addEventListener('click', () => {
        menuCollapsed = !menuCollapsed;
        setMenuCollapsed(menuCollapsed);
      });
    }

    // Fixed tooltip so labels aren't clipped by the sidebar overflow.
    let tipEl = document.querySelector('[data-admin-floating-tip]');
    if (!(tipEl instanceof HTMLElement)) {
      tipEl = document.createElement('div');
      tipEl.setAttribute('data-admin-floating-tip', '');
      tipEl.className =
        'pointer-events-none fixed z-[200] hidden -translate-y-1/2 whitespace-nowrap rounded-md bg-charcoal px-2.5 py-1.5 text-xs font-medium text-cream shadow-md';
      document.body.appendChild(tipEl);
    }
    const hideTip = () => {
      if (tipEl instanceof HTMLElement) tipEl.classList.add('hidden');
    };
    const showTip = (target: HTMLElement) => {
      if (!(tipEl instanceof HTMLElement)) return;
      const label = target.getAttribute('data-admin-tip');
      if (!label) return;
      tipEl.textContent = label;
      tipEl.classList.remove('hidden');
      const rect = target.getBoundingClientRect();
      tipEl.style.left = `${Math.round(rect.right + 10)}px`;
      tipEl.style.top = `${Math.round(rect.top + rect.height / 2)}px`;
    };
    if (menuIcons instanceof HTMLElement) {
      menuIcons.addEventListener('pointerover', (event) => {
        const target = event.target;
        if (!(target instanceof Element)) return;
        const tipTarget = target.closest('[data-admin-tip]');
        if (tipTarget instanceof HTMLElement && menuIcons.contains(tipTarget)) showTip(tipTarget);
      });
      menuIcons.addEventListener('pointerout', (event) => {
        const related = event.relatedTarget;
        if (related instanceof Node && menuIcons.contains(related)) {
          const next = related instanceof Element ? related.closest('[data-admin-tip]') : null;
          if (next instanceof HTMLElement) {
            showTip(next);
            return;
          }
        }
        hideTip();
      });
      menuIcons.addEventListener('scroll', hideTip, { passive: true });
    }
    menuToggle?.addEventListener('click', hideTip);
    window.addEventListener('scroll', hideTip, true);

    const hashForPanel: Record<string, string> = {
      'time-off': '#time-off-requests',
      timesheet: '#timesheet-backlog',
      hours: '#hours',
      announcements: '#announcement-history',
      'bulletin-board': '#bulletin-board',
      people: '#people',
      tasks: '#tasks',
      'work-items': '#work-items',
      training: '#training',
      'quick-links': '#quick-links',
      integrations: '#integrations',
      credentialing: '#credentialing',
      branding: '#branding',
      roles: '#roles',
    };

    const panelFromHash = (hash: string): string | null => {
      if (hash === 'time-off-requests' || hash === 'time-off') return 'time-off';
      if (hash === 'timesheet-backlog' || hash === 'timesheet') return 'timesheet';
      if (hash === 'hours' || hash === 'hours-admin' || hash === 'employee-hours') return 'hours';
      if (hash === 'announcement-history' || hash === 'post-announcement' || hash === 'announcements') {
        return 'announcements';
      }
      if (hash === 'bulletin-board' || hash === 'bulletin' || hash === 'board') return 'bulletin-board';
      if (hash === 'people') return 'people';
      if (hash === 'tasks') return 'tasks';
      if (hash === 'work-items' || hash === 'work-items-admin') return 'work-items';
      if (hash === 'training' || hash === 'training-admin') return 'training';
      if (hash === 'quick-links' || hash === 'quick-links-heading') return 'quick-links';
      if (hash === 'integrations') return 'integrations';
      if (hash === 'credentialing' || hash === 'credentialing-admin') return 'credentialing';
      if (hash === 'branding' || hash === 'favicon') return 'branding';
      if (hash === 'roles' || hash === 'roles-heading') return 'roles';
      return null;
    };

    const groups = Array.from(shell.querySelectorAll('[data-admin-group]')).filter(
      (node): node is HTMLDetailsElement => node instanceof HTMLDetailsElement,
    );

    const openExclusiveGroup = (target: HTMLDetailsElement | null) => {
      groups.forEach((group) => {
        group.open = target != null && group === target;
      });
    };

    groups.forEach((group) => {
      group.addEventListener('toggle', () => {
        if (group.open) openExclusiveGroup(group);
      });
    });

    const setActiveButton = (id: string | null) => {
      openButtons.forEach((btn) => {
        const active = Boolean(id && btn.dataset.adminOpen === id);
        btn.dataset.active = active ? 'true' : 'false';
        if (active) btn.setAttribute('aria-current', 'page');
        else btn.removeAttribute('aria-current');
        if (active) {
          const groupId = btn.dataset.adminGroupId;
          if (groupId) {
            const group = shell.querySelector(`[data-admin-group="${groupId}"]`);
            if (group instanceof HTMLDetailsElement) openExclusiveGroup(group);
          }
        }
      });
    };

    const showEmpty = () => {
      if (empty instanceof HTMLElement) empty.classList.remove('hidden');
      panels.forEach((panel) => panel.classList.add('hidden'));
      setActiveButton(null);
      if (window.location.hash) {
        history.replaceState(null, '', window.location.pathname + window.location.search);
      }
    };

    const showPanel = (id: string, updateHash = true) => {
      if (empty instanceof HTMLElement) empty.classList.add('hidden');
      panels.forEach((panel) => {
        panel.classList.toggle('hidden', panel.dataset.adminPanel !== id);
      });
      setActiveButton(id);
      if (updateHash) {
        const hash = hashForPanel[id] ?? `#${id}`;
        history.replaceState(null, '', `${window.location.pathname}${window.location.search}${hash}`);
      }
    };

    openButtons.forEach((node) => {
      node.addEventListener('click', () => {
        const id = node.dataset.adminOpen;
        if (id) showPanel(id);
      });
    });

    const params = new URLSearchParams(window.location.search);
    if (params.has('timeOffError')) {
      showPanel('time-off', false);
      return;
    }
    if (params.has('timesheetError')) {
      showPanel('timesheet', false);
      return;
    }
    if (params.get('adminPanel') === 'hours' || params.has('hoursUser')) {
      showPanel('hours', false);
      return;
    }
    if (params.has('peopleError') || params.has('inviteUrl') || params.has('peopleSaved')) {
      showPanel('people', false);
      return;
    }
    if (params.has('credentialingError') || params.has('credentialingSaved')) {
      showPanel('credentialing', false);
      return;
    }
    if (params.has('tasksError') || params.has('tasksSaved')) {
      showPanel('tasks', false);
      return;
    }
    if (params.has('workCategoriesError') || params.has('workCategoriesSaved')) {
      showPanel('work-items', false);
      return;
    }
    if (params.has('trainingSaved') || params.has('trainingError') || params.has('module')) {
      showPanel('training', false);
      return;
    }
    if (params.has('quickLinksSaved') || params.has('quickLinksError')) {
      showPanel('quick-links', false);
      return;
    }
    if (params.has('rolesSaved') || params.has('rolesError') || params.has('roleCreated')) {
      showPanel('roles', false);
      return;
    }
    if (params.has('integrationsError') || params.has('integrationsSaved')) {
      showPanel('integrations', false);
      return;
    }
    if (params.has('error') || params.has('announcementSaved')) {
      showPanel('announcements', false);
      return;
    }

    const hash = window.location.hash.replace(/^#/, '');
    const fromHash = panelFromHash(hash);
    if (fromHash) showPanel(fromHash, false);
    else {
      showEmpty();
      const firstGroup = shell.querySelector('[data-admin-group]');
      if (firstGroup instanceof HTMLDetailsElement) openExclusiveGroup(firstGroup);
    }
  }

  document.querySelectorAll('[data-admin-shell]').forEach((root) => setupAdminNav(root));

  const brandingForm = document.getElementById('org-branding-form');
  if (brandingForm instanceof HTMLFormElement) {
    const statusEl = brandingForm.querySelector('[data-brand-status]');
    const errorEl = brandingForm.querySelector('[data-brand-error]');
    const colorKeys = [
      'bgColorLight',
      'surfaceColorLight',
      'textColorLight',
      'primaryColorLight',
      'primaryTextColorLight',
      'accentColorLight',
      'accentTextColorLight',
      'bgColorDark',
      'surfaceColorDark',
      'textColorDark',
      'primaryColorDark',
      'primaryTextColorDark',
      'accentColorDark',
      'accentTextColorDark',
      'widgetHeaderColorLight',
      'widgetBgColorLight',
      'widgetHeaderColorDark',
      'widgetBgColorDark',
    ];

    const readColor = (key: string) => {
      const stored = brandingForm.querySelector(`[data-brand-value="${key}"]`);
      if (stored instanceof HTMLInputElement && stored.value) return stored.value;
      const input = brandingForm.querySelector(`[data-brand-color="${key}"]`);
      return input instanceof HTMLInputElement ? input.value : '';
    };

    const paintPreview = (mode: 'light' | 'dark') => {
      const suffix = mode === 'dark' ? 'Dark' : 'Light';
      const bg = readColor(`bgColor${suffix}`);
      const surface = readColor(`surfaceColor${suffix}`);
      const text = readColor(`textColor${suffix}`);
      const primary = readColor(`primaryColor${suffix}`);
      const primaryText = readColor(`primaryTextColor${suffix}`);
      const accent = readColor(`accentColor${suffix}`);
      const accentText = readColor(`accentTextColor${suffix}`);
      const widgetHeader = readColor(`widgetHeaderColor${suffix}`);
      const widgetBg = readColor(`widgetBgColor${suffix}`);
      const preview = brandingForm.querySelector(`[data-brand-preview="${mode}"]`);
      if (preview instanceof HTMLElement) preview.style.backgroundColor = bg;
      const paint = (role: string, apply: (el: HTMLElement) => void) => {
        const el = brandingForm.querySelector(`[data-brand-preview-${role}="${mode}"]`);
        if (el instanceof HTMLElement) apply(el);
      };
      paint('heading', (el) => {
        el.style.color = text;
      });
      paint('body', (el) => {
        el.style.color = text;
      });
      paint('muted', (el) => {
        el.style.color = text;
      });
      paint('primary', (el) => {
        el.style.backgroundColor = primary;
        el.style.color = primaryText;
      });
      paint('accent', (el) => {
        el.style.borderColor = accent;
        el.style.color = accentText;
      });
      paint('chip', (el) => {
        el.style.backgroundColor = `color-mix(in srgb, ${accent} ${mode === 'dark' ? 22 : 18}%, transparent)`;
        el.style.color = accentText;
      });
      paint('card', (el) => {
        el.style.backgroundColor = surface;
      });
      paint('card-title', (el) => {
        el.style.color = text;
      });
      const headerFg = (() => {
        const match = /^#?([0-9a-fA-F]{6})([0-9a-fA-F]{2})?$/.exec(widgetHeader.trim());
        if (!match) return '#F7F4EE';
        const hex = match[1];
        const r = parseInt(hex.slice(0, 2), 16);
        const g = parseInt(hex.slice(2, 4), 16);
        const b = parseInt(hex.slice(4, 6), 16);
        return (0.299 * r + 0.587 * g + 0.114 * b) / 255 > 0.58 ? '#393A3D' : '#F7F4EE';
      })();
      paint('widget-header', (el) => {
        el.style.backgroundColor = widgetHeader;
        el.style.color = headerFg;
      });
      paint('widget-body', (el) => {
        el.style.backgroundColor = widgetBg;
      });
    };

    const syncPair = (key: string, fromColor: boolean) => {
      const colorInput = brandingForm.querySelector(`[data-brand-color="${key}"]`);
      const hexInput = brandingForm.querySelector(`[data-brand-hex="${key}"]`);
      const alphaInput = brandingForm.querySelector(`[data-brand-alpha="${key}"]`);
      const stored = brandingForm.querySelector(`[data-brand-value="${key}"]`);
      const alphaLabel = brandingForm.querySelector(`[data-brand-alpha-label="${key}"]`);
      if (!(colorInput instanceof HTMLInputElement) || !(hexInput instanceof HTMLInputElement)) return;
      if (fromColor) {
        hexInput.value = colorInput.value.toUpperCase();
      } else {
        const raw = hexInput.value.trim();
        const next = raw.startsWith('#') ? raw : `#${raw}`;
        if (/^#[0-9A-Fa-f]{6}$/.test(next)) {
          colorInput.value = next;
          hexInput.value = next.toUpperCase();
        }
      }
      const percent = alphaInput instanceof HTMLInputElement ? Number(alphaInput.value) : 100;
      const clamped = Number.isFinite(percent) ? Math.max(0, Math.min(100, Math.round(percent))) : 100;
      if (alphaLabel instanceof HTMLElement) alphaLabel.textContent = `${clamped}%`;
      const opaque = /^#[0-9A-Fa-f]{6}$/.test(colorInput.value) ? colorInput.value.toUpperCase() : hexInput.value.toUpperCase();
      const alphaByte = Math.round((clamped / 100) * 255).toString(16).padStart(2, '0').toUpperCase();
      const full = clamped >= 100 ? opaque : `${opaque}${alphaByte}`;
      if (stored instanceof HTMLInputElement) stored.value = full;
      paintPreview(key.endsWith('Dark') ? 'dark' : 'light');
    };

    colorKeys.forEach((key) => {
      const colorInput = brandingForm.querySelector(`[data-brand-color="${key}"]`);
      const hexInput = brandingForm.querySelector(`[data-brand-hex="${key}"]`);
      const alphaInput = brandingForm.querySelector(`[data-brand-alpha="${key}"]`);
      colorInput?.addEventListener('input', () => syncPair(key, true));
      hexInput?.addEventListener('change', () => syncPair(key, false));
      alphaInput?.addEventListener('input', () => syncPair(key, true));
    });

    const hexChannels = (value: string | null | undefined) => {
      const match = /^#?([0-9a-fA-F]{6})([0-9a-fA-F]{2})?$/.exec((value ?? '').trim());
      if (!match) return null;
      const hex = match[1];
      return `${parseInt(hex.slice(0, 2), 16)} ${parseInt(hex.slice(2, 4), 16)} ${parseInt(hex.slice(4, 6), 16)}`;
    };
    const hexAlpha = (value: string | null | undefined) => {
      const match = /^#?([0-9a-fA-F]{6})([0-9a-fA-F]{2})?$/.exec((value ?? '').trim());
      if (!match?.[2] || match[2].toUpperCase() === 'FF') return '1';
      return String(Math.round((parseInt(match[2], 16) / 255) * 1000) / 1000);
    };
    const applySavedBrandColors = (branding: {
      bgColorLight?: string | null;
      surfaceColorLight?: string | null;
      textColorLight?: string | null;
      primaryColorLight?: string | null;
      primaryTextColorLight?: string | null;
      accentColorLight?: string | null;
      accentTextColorLight?: string | null;
      bgColorDark?: string | null;
      surfaceColorDark?: string | null;
      textColorDark?: string | null;
      primaryColorDark?: string | null;
      primaryTextColorDark?: string | null;
      accentColorDark?: string | null;
      accentTextColorDark?: string | null;
      widgetHeaderColorLight?: string | null;
      widgetBgColorLight?: string | null;
      widgetHeaderColorDark?: string | null;
      widgetBgColorDark?: string | null;
    }) => {
      const onHeader = (hex: string | null | undefined, fallback: string) => {
        const match = /^#?([0-9a-fA-F]{6})([0-9a-fA-F]{2})?$/.exec((hex ?? '').trim());
        const rgb = (match ? match[1] : fallback.slice(1, 7)).toUpperCase();
        const aa = match?.[2]?.toUpperCase();
        const value = !aa || aa === 'FF' ? `#${rgb}` : `#${rgb}${aa}`;
        const r = parseInt(rgb.slice(0, 2), 16);
        const g = parseInt(rgb.slice(2, 4), 16);
        const b = parseInt(rgb.slice(4, 6), 16);
        const fg = (0.299 * r + 0.587 * g + 0.114 * b) / 255 > 0.58 ? '#393A3D' : '#F7F4EE';
        return { value, fg };
      };
      const block = (
        selector: string,
        bg: string,
        surface: string,
        text: string,
        primary: string,
        primaryText: string,
        accent: string,
        accentText: string,
        widgetHeader: string,
        widgetHeaderFg: string,
        widgetBg: string,
        alphas: {
          bg: string;
          surface: string;
          text: string;
          primary: string;
          primaryText: string;
          accent: string;
          accentText: string;
          widgetBg: string;
        },
      ) =>
        `${selector}{--portal-cream:${bg} !important;--portal-cream-a:${alphas.bg} !important;--portal-surface:${surface} !important;--portal-surface-a:${alphas.surface} !important;--portal-sage-dark:${text} !important;--portal-sage-dark-a:${alphas.text} !important;--portal-charcoal:${text} !important;--portal-charcoal-a:${alphas.text} !important;--portal-primary:${primary} !important;--portal-primary-a:${alphas.primary} !important;--portal-on-primary:${primaryText} !important;--portal-on-primary-a:${alphas.primaryText} !important;--portal-sage:${accent} !important;--portal-sage-a:${alphas.accent} !important;--portal-sage-light:${accent} !important;--portal-sage-light-a:${alphas.accent} !important;--portal-accent:${accent} !important;--portal-accent-a:${alphas.accent} !important;--portal-on-accent:${accentText} !important;--portal-on-accent-a:${alphas.accentText} !important;--portal-widget-header:${widgetHeader} !important;--portal-widget-header-fg:${widgetHeaderFg} !important;--portal-widget-bg:${widgetBg} !important;--portal-widget-bg-a:${alphas.widgetBg} !important;}`;
      const lightBg = hexChannels(branding.bgColorLight) ?? '247 244 238';
      const lightSurface = hexChannels(branding.surfaceColorLight) ?? '255 255 255';
      const lightText = hexChannels(branding.textColorLight) ?? hexChannels(branding.primaryColorLight) ?? '83 95 81';
      const lightPrimary = hexChannels(branding.primaryColorLight) ?? '83 95 81';
      const lightPrimaryText = hexChannels(branding.primaryTextColorLight) ?? lightBg;
      const lightAccent = hexChannels(branding.accentColorLight) ?? '120 143 117';
      const lightAccentText = hexChannels(branding.accentTextColorLight) ?? lightAccent;
      const lightWidgetHeader = onHeader(branding.widgetHeaderColorLight, '#535F51');
      const lightWidgetBg = hexChannels(branding.widgetBgColorLight) ?? '244 245 248';
      const darkBg = hexChannels(branding.bgColorDark) ?? '17 19 17';
      const darkSurface = hexChannels(branding.surfaceColorDark) ?? '30 33 30';
      const darkText = hexChannels(branding.textColorDark) ?? hexChannels(branding.primaryColorDark) ?? '186 198 182';
      const darkPrimary = hexChannels(branding.primaryColorDark) ?? '186 198 182';
      const darkPrimaryText = hexChannels(branding.primaryTextColorDark) ?? darkBg;
      const darkAccent = hexChannels(branding.accentColorDark) ?? '138 158 134';
      const darkAccentText = hexChannels(branding.accentTextColorDark) ?? darkAccent;
      const darkWidgetHeader = onHeader(branding.widgetHeaderColorDark, '#535F51');
      const darkWidgetBg = hexChannels(branding.widgetBgColorDark) ?? '37 41 37';
      let style = document.getElementById('org-brand');
      if (!(style instanceof HTMLStyleElement)) {
        style = document.createElement('style');
        style.id = 'org-brand';
        document.head.appendChild(style);
      }
      style.textContent =
        block('html', lightBg, lightSurface, lightText, lightPrimary, lightPrimaryText, lightAccent, lightAccentText, lightWidgetHeader.value, lightWidgetHeader.fg, lightWidgetBg, {
          bg: hexAlpha(branding.bgColorLight),
          surface: hexAlpha(branding.surfaceColorLight),
          text: hexAlpha(branding.textColorLight),
          primary: hexAlpha(branding.primaryColorLight),
          primaryText: hexAlpha(branding.primaryTextColorLight),
          accent: hexAlpha(branding.accentColorLight),
          accentText: hexAlpha(branding.accentTextColorLight),
          widgetBg: hexAlpha(branding.widgetBgColorLight),
        }) +
        block('html.dark', darkBg, darkSurface, darkText, darkPrimary, darkPrimaryText, darkAccent, darkAccentText, darkWidgetHeader.value, darkWidgetHeader.fg, darkWidgetBg, {
          bg: hexAlpha(branding.bgColorDark),
          surface: hexAlpha(branding.surfaceColorDark),
          text: hexAlpha(branding.textColorDark),
          primary: hexAlpha(branding.primaryColorDark),
          primaryText: hexAlpha(branding.primaryTextColorDark),
          accent: hexAlpha(branding.accentColorDark),
          accentText: hexAlpha(branding.accentTextColorDark),
          widgetBg: hexAlpha(branding.widgetBgColorDark),
        });
    };

    brandingForm.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (statusEl instanceof HTMLElement) {
        statusEl.classList.add('hidden');
        statusEl.textContent = '';
      }
      if (errorEl instanceof HTMLElement) {
        errorEl.classList.add('hidden');
        errorEl.textContent = '';
      }
      colorKeys.forEach((key) => syncPair(key, false));
      try {
        const res = await fetch('/api/org/branding', {
          method: 'POST',
          body: new FormData(brandingForm),
          headers: { Accept: 'application/json' },
        });
        const json = (await res.json().catch(() => ({}))) as {
          error?: string;
          branding?: {
            hasLogo?: boolean;
            logoUrl?: string | null;
            hasFavicon?: boolean;
            faviconUrl?: string | null;
            bgColorLight?: string | null;
            surfaceColorLight?: string | null;
            textColorLight?: string | null;
            primaryColorLight?: string | null;
            primaryTextColorLight?: string | null;
            accentColorLight?: string | null;
            accentTextColorLight?: string | null;
            bgColorDark?: string | null;
            surfaceColorDark?: string | null;
            textColorDark?: string | null;
            primaryColorDark?: string | null;
            primaryTextColorDark?: string | null;
            accentColorDark?: string | null;
            accentTextColorDark?: string | null;
            widgetHeaderColorLight?: string | null;
            widgetBgColorLight?: string | null;
            widgetHeaderColorDark?: string | null;
            widgetBgColorDark?: string | null;
          };
        };
        if (!res.ok) throw new Error(json.error || 'Could not save branding.');
        if (json.branding) applySavedBrandColors(json.branding);
        if (statusEl instanceof HTMLElement) {
          statusEl.textContent = 'Branding saved.';
          statusEl.classList.remove('hidden');
        }
        const branding = json.branding;
        if (branding?.logoUrl) {
          const logoPreview = brandingForm.querySelector('[data-brand-logo-preview]');
          if (logoPreview instanceof HTMLImageElement) logoPreview.src = branding.logoUrl;
        }
        if (branding?.faviconUrl) {
          const faviconPreview = brandingForm.querySelector('[data-brand-favicon-preview]');
          if (faviconPreview instanceof HTMLImageElement) faviconPreview.src = branding.faviconUrl;
        }
      } catch (error) {
        if (errorEl instanceof HTMLElement) {
          errorEl.textContent = error instanceof Error ? error.message : 'Could not save branding.';
          errorEl.classList.remove('hidden');
        }
      }
    });
  }

  document.addEventListener('click', async (event) => {
    if (!(event.target instanceof Element)) return;
    const button = event.target.closest('[data-copy-text]');
    if (!(button instanceof HTMLButtonElement)) return;
    const text = button.getAttribute('data-copy-text');
    if (!text) return;
    try {
      await navigator.clipboard.writeText(text);
      const previous = button.textContent;
      button.textContent = 'Copied';
      window.setTimeout(() => {
        button.textContent = previous || 'Copy';
      }, 1200);
    } catch {
      window.prompt('Copy this Redirect URI:', text);
    }
  });
</script>
