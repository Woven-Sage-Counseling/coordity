---
import PortalLayout from '../layouts/PortalLayout.astro';
import AnnouncementManager from '../components/AnnouncementManager.astro';
import CredentialingManager from '../components/CredentialingManager.astro';
import PanelHeading from '../components/PanelHeading.astro';
import PeopleManager from '../components/PeopleManager.astro';
import TasksManager from '../components/TasksManager.astro';
import TimeOffManager from '../components/TimeOffManager.astro';
import TimesheetBacklogManager from '../components/TimesheetBacklogManager.astro';
import TimesheetShiftEditManager from '../components/TimesheetShiftEditManager.astro';
import TimesheetStatsViewer from '../components/TimesheetStatsViewer.astro';
import WorkItemsManager from '../components/WorkItemsManager.astro';
import TrainingManager from '../components/TrainingManager.astro';
import QuickLinksManager from '../components/QuickLinksManager.astro';
import RolesManager from '../components/RolesManager.astro';
import { listActiveAnnouncements } from '../lib/announcements';
import {
  listProvidersForLookup,
  listInsuranceCatalog,
  listCoverageMatrix,
  listGroupCoverageMatrix,
} from '../lib/credentialing';
import { listEmployees, listRolesWithPermissions } from '../lib/employees';
import { canAccessManagement } from '../lib/permissions';
import { listTimeOffRequestsForAdmin } from '../lib/time-off-requests';
import { listTimesheetBacklogForAdmin } from '../lib/timesheet-backlog';
import { listTimesheetShiftEditsForAdmin } from '../lib/timesheet-shift-edits';
import { listAssignedTasksForAdmin } from '../lib/tasks';
import { listWorkCategoriesForAdmin } from '../lib/timesheet-work-categories';
import { listBulletinBoardRequests } from '../lib/bulletin-board';
import { orgCanonicalOrigin, orgIdFromLocals } from '../lib/organization';
import {
  getTrainingUserReview,
  listBlocks,
  listLessons,
  listAssignments,
  listTrainingModules,
  listTrainingRoster,
} from '../lib/training';
import { listQuickLinksForAdmin, listQuickLinkCategories } from '../lib/quick-links';
import {
  getDocuSignConnectionStatus,
  listDocuSignStatusesForLesson,
  listDocuSignTemplates,
} from '../lib/docusign';
import { QuickBooksProvider } from '../lib/financials/quickbooks';
import { hasPermission } from '../lib/permissions';

export const prerender = false;

const employee = Astro.locals.employee!;
if (!canAccessManagement(employee)) {
  return new Response('Forbidden', { status: 403 });
}

const orgId = orgIdFromLocals(Astro.locals.organization);
const organization = Astro.locals.organization;
const hasOrgFavicon = Boolean(organization?.hasFavicon);
const orgFaviconPreview = hasOrgFavicon
  ? `/api/org/favicon?v=${organization?.faviconUpdatedAt ?? 0}`
  : null;
const hasOrgLogo = Boolean(organization?.hasLogo);
const orgLogoPreview =
  organization?.logoUrl ??
  (hasOrgLogo ? `/api/org/logo?v=${organization?.logoUpdatedAt ?? 0}` : null);
const brandDisplayName = organization?.displayName ?? organization?.name ?? '';
const brandWebsiteUrl = organization?.websiteUrl ?? '';
const brandBgLight = organization?.bgColorLight ?? '#F7F4EE';
const brandPrimaryLight = organization?.primaryColorLight ?? '#535F51';
const brandAccentLight = organization?.accentColorLight ?? '#788F75';
const brandBgDark = organization?.bgColorDark ?? '#111311';
const brandPrimaryDark = organization?.primaryColorDark ?? '#BAC6B6';
const brandAccentDark = organization?.accentColorDark ?? '#8A9E86';
const brandInvertLogoDark = Boolean(organization?.invertLogoDark);

async function safeLoad<T>(label: string, load: () => Promise<T>, fallback: T): Promise<T> {
  try {
    return await load();
  } catch (error) {
    console.error(`admin ${label} load failed`, error);
    return fallback;
  }
}

const announcements = await safeLoad('announcements', () => listActiveAnnouncements(50), []);
const timeOffRequests = await safeLoad('time-off', () => listTimeOffRequestsForAdmin(), []);
const timesheetBacklogRequests = await safeLoad('timesheet-backlog', () => listTimesheetBacklogForAdmin(), []);
const timesheetShiftEditRequests = await safeLoad(
  'timesheet-shift-edits',
  () => listTimesheetShiftEditsForAdmin(),
  [],
);
const pendingBoardRequests = await safeLoad(
  'bulletin-requests',
  () => listBulletinBoardRequests({ status: 'pending' }),
  [],
);
const roles = await safeLoad('roles', () => listRolesWithPermissions(orgId), []);
const quickLinks = await safeLoad('quick-links', () => listQuickLinksForAdmin(orgId), []);
const quickLinkCategories = await safeLoad(
  'quick-link-categories',
  () => listQuickLinkCategories(orgId),
  [],
);
const credentialingProviders = await safeLoad('credentialing-providers', () => listProvidersForLookup(), []);
const insuranceCatalog = await safeLoad('insurance-catalog', () => listInsuranceCatalog(), []);
const coverageMap = await safeLoad('coverage-matrix', () => listCoverageMatrix(), {});
const groupCoverageMap = await safeLoad('group-coverage-matrix', () => listGroupCoverageMatrix(), {});
const employees = await safeLoad('employees', () => listEmployees(orgId), []);
let assignedTasks: Awaited<ReturnType<typeof listAssignedTasksForAdmin>> = [];
let tasksLoadError: string | null = Astro.url.searchParams.get('tasksError');
try {
  assignedTasks = await listAssignedTasksForAdmin();
} catch (error) {
  console.error('admin tasks load failed', error);
  if (!tasksLoadError) {
    tasksLoadError = 'Tasks are temporarily unavailable. Database migration may still be pending.';
  }
}

const error = Astro.url.searchParams.get('error');
const announcementSaved = Astro.url.searchParams.get('announcementSaved');
const inviteUrl = Astro.url.searchParams.get('inviteUrl');
const peopleError = Astro.url.searchParams.get('peopleError');
const peopleSaved = Astro.url.searchParams.get('peopleSaved');
const peopleUser = Astro.url.searchParams.get('peopleUser');
const timeOffError = Astro.url.searchParams.get('timeOffError');
const timesheetError = Astro.url.searchParams.get('timesheetError');
const credentialingError = Astro.url.searchParams.get('credentialingError');
const tasksError = tasksLoadError;
const tasksSaved = Astro.url.searchParams.get('tasksSaved');
const workCategoriesSaved = Astro.url.searchParams.get('workCategoriesSaved');
let workCategoriesError: string | null = Astro.url.searchParams.get('workCategoriesError');
const trainingError = Astro.url.searchParams.get('trainingError');
const integrationsError = Astro.url.searchParams.get('integrationsError');
const integrationsSaved = Astro.url.searchParams.get('integrationsSaved');
const quickLinksError = Astro.url.searchParams.get('quickLinksError');
const quickLinksSaved = Astro.url.searchParams.get('quickLinksSaved') === '1';
const rolesError = Astro.url.searchParams.get('rolesError');
const rolesSaved = Astro.url.searchParams.get('rolesSaved') === '1';
const roleCreated = Astro.url.searchParams.get('roleCreated') === '1';
const createdRoleName = Astro.url.searchParams.get('roleName');
const createdRoleSurfaces = (Astro.url.searchParams.get('roleSurfaces') ?? '')
  .split('|')
  .map((value) => value.trim())
  .filter(Boolean);
const selectedTrainingModuleId = Astro.url.searchParams.get('module');
const selectedTrainingItemId = Astro.url.searchParams.get('item');
const selectedTrainingViewParam = Astro.url.searchParams.get('view');
const pendingTimeOff = timeOffRequests.filter((request) => request.status === 'pending').length;
const pendingTimesheetBacklog = timesheetBacklogRequests.filter((request) => request.status === 'pending').length;
const pendingTimesheetShiftEdits = timesheetShiftEditRequests.filter((request) => request.status === 'pending').length;
const pendingTimesheetRequests = pendingTimesheetBacklog + pendingTimesheetShiftEdits;
const pendingBulletinRequests = pendingBoardRequests.length;
const openAssignedTasks = assignedTasks.filter((task) => task.completedAt == null).length;
let workCategories: Awaited<ReturnType<typeof listWorkCategoriesForAdmin>> = [];
try {
  workCategories = await listWorkCategoriesForAdmin();
} catch (error) {
  console.error('admin work categories load failed', error);
  if (!workCategoriesError) {
    workCategoriesError = 'Work items are temporarily unavailable. Database migration may still be pending.';
  }
}

const trainingModules = await safeLoad(
  'training-modules',
  () => listTrainingModules(orgId, { includeHidden: true, includeArchived: false }),
  [],
);
const trainingSelectedId =
  selectedTrainingModuleId && trainingModules.some((m) => m.id === selectedTrainingModuleId)
    ? selectedTrainingModuleId
    : (trainingModules[0]?.id ?? null);
const trainingLessons = trainingSelectedId
  ? await safeLoad('training-lessons', () => listLessons(trainingSelectedId), [])
  : [];
const trainingAssignments = trainingSelectedId
  ? await safeLoad('training-assignments', () => listAssignments(trainingSelectedId), [])
  : [];
const trainingItemIds = new Set([...trainingAssignments, ...trainingLessons].map((item) => item.id));
const trainingSelectedItemId =
  selectedTrainingItemId && trainingItemIds.has(selectedTrainingItemId)
    ? selectedTrainingItemId
    : null;
const trainingSelectedView: 'settings' | 'item' | 'idle' =
  trainingSelectedItemId != null
    ? 'item'
    : selectedTrainingViewParam === 'settings'
      ? 'settings'
      : 'idle';
const trainingBlocksByItem: Record<string, Awaited<ReturnType<typeof listBlocks>>> = {};
for (const item of [...trainingAssignments, ...trainingLessons]) {
  trainingBlocksByItem[item.id] = await safeLoad(
    `training-blocks-${item.id}`,
    () => listBlocks(item.id),
    [],
  );
}
const trainingRoster = await safeLoad('training-roster', () => listTrainingRoster(orgId), []);
const trainingTraineeId = Astro.url.searchParams.get('trainee')?.trim() || null;
const trainingTraineeReview = trainingTraineeId
  ? await safeLoad('training-trainee-review', () => getTrainingUserReview(orgId, trainingTraineeId), null)
  : null;

const docusignStatus = await safeLoad(
  'docusign-status',
  () => getDocuSignConnectionStatus(orgId),
  {
    configured: false,
    hasOrgApp: false,
    hasPlatformApp: false,
    integrationKey: null,
    authServer: 'https://account-d.docusign.com',
    status: 'disconnected' as const,
    accountEmail: null,
    accountName: null,
    accountId: null,
    lastError: null,
    connectedAt: null,
  },
);
const docusignConnected = docusignStatus.status === 'connected';
const docusignTemplates = docusignConnected
  ? await safeLoad('docusign-templates', () => listDocuSignTemplates(orgId), [])
  : [];
const docusignStatusesRaw = trainingSelectedItemId
  ? await safeLoad(
      'docusign-lesson-status',
      () => listDocuSignStatusesForLesson(trainingSelectedItemId),
      [],
    )
  : [];
const rosterByUser = new Map(trainingRoster.map((row) => [row.userId, row.name]));
const docusignStatuses = docusignStatusesRaw.map((row) => ({
  ...row,
  userName: rosterByUser.get(row.userId) ?? row.userId,
}));

const qbStatus = await safeLoad(
  'qb-status',
  () => new QuickBooksProvider().getConnectionStatus(),
  {
    configured: false,
    hasOrgApp: false,
    hasPlatformApp: false,
    clientId: null,
    environment: 'sandbox' as const,
    status: 'disconnected' as const,
    companyName: null,
    connectedEmail: null,
    lastError: null,
    lastSyncAt: null,
    connectedAt: null,
  },
);
const qbConnected = qbStatus.status === 'connected';
const canManageQuickBooks = hasPermission(employee, 'financials:manage');
const docusignRedirectUri = `${orgCanonicalOrigin(organization, Astro.url.href)}/api/docusign/callback`;
const quickbooksRedirectUri = `${orgCanonicalOrigin(organization, Astro.url.href)}/api/quickbooks/callback`;

const menuChevron = `<svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true" class="transition group-open:rotate-180"><path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg>`;

const adminIcons = {
  calendar: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2" stroke="currentColor" stroke-width="1.6"/><path d="M3 10h18M8 3v4M16 3v4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>`,
  clock: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="8.25" stroke="currentColor" stroke-width="1.6"/><path d="M12 8v4.5l3 1.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>`,
  chart: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 19h16M7 16V9M12 16V5M17 16v-5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>`,
  tags: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M3 12V5.5A1.5 1.5 0 0 1 4.5 4H12l8 8-7.5 7.5L3 12Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><circle cx="8" cy="8" r="1.2" fill="currentColor"/></svg>`,
  people: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="9" cy="8" r="3" stroke="currentColor" stroke-width="1.6"/><path d="M3.5 18.5c.8-2.8 2.9-4.5 5.5-4.5s4.7 1.7 5.5 4.5M16 8a2.5 2.5 0 1 1 0 5M15.2 14.2c1.8.3 3.2 1.5 3.8 3.3" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>`,
  shield: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 3 5 6v5c0 4.5 2.9 7.8 7 9 4.1-1.2 7-4.5 7-9V6l-7-3Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>`,
  check: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M9 11.5 11 13.5 15.5 9M6 5h12a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1Z" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>`,
  badge: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="9" r="4" stroke="currentColor" stroke-width="1.6"/><path d="M7 20.5 8.5 14h7L17 20.5 12.5 18 8 20.5" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>`,
  megaphone: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M3 11v2.5a1 1 0 0 0 1 1h1.2L9 18.5V5.5L5.2 9.5H4a1 1 0 0 0-1 1.5ZM15 8.5c1.4.8 2.3 2.1 2.3 3.5S16.4 14.7 15 15.5M18.2 6.2C20.5 7.6 22 9.7 22 12s-1.5 4.4-3.8 5.8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>`,
  board: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2" stroke="currentColor" stroke-width="1.6"/><path d="M8 8h4v5H8V8ZM14 8h4v3h-4V8ZM8 15h10" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>`,
  book: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 5.5A2.5 2.5 0 0 1 7.5 3H20v16.5H7.5A2.5 2.5 0 0 0 5 22V5.5Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M5 18.5h15" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>`,
  link: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M9.5 14.5 14.5 9.5M8 12H6.5a3.5 3.5 0 0 1 0-7H10a3.5 3.5 0 0 1 3.3 2.3M16 12h1.5a3.5 3.5 0 0 0 0-7H14a3.5 3.5 0 0 0-3.3 2.3" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>`,
  plug: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M9 7V3M15 7V3M8 7h8v4a4 4 0 0 1-4 4v5M8 11V7" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>`,
  paint: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 3c4.5 0 8 3 8 6.5S17 15 14 15h-1.5a1.5 1.5 0 0 0 0 3H14c.8 0 1.5.7 1.5 1.5S14.8 21 14 21H10c-3.3 0-6-2.7-6-6 0-6 3.6-12 8-12Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><circle cx="8.5" cy="10" r="1" fill="currentColor"/></svg>`,
};

type AdminNavItem = {
  id?: string;
  href?: string;
  label: string;
  description: string;
  icon: string;
  badge?: number;
  badgeTone?: 'red' | 'amber';
};

type AdminNavGroup = {
  id: string;
  label: string;
  items: AdminNavItem[];
};

type AdminNavSection = {
  label: string;
  groups: AdminNavGroup[];
};

const adminNav: AdminNavSection[] = [
  {
    label: 'Time & attendance',
    groups: [
      {
        id: 'requests',
        label: 'Requests',
        items: [
          {
            id: 'time-off',
            label: 'Time off',
            description: 'Approve or decline leave requests',
            icon: adminIcons.calendar,
            badge: pendingTimeOff,
            badgeTone: 'red',
          },
          {
            id: 'timesheet',
            label: 'Timesheet requests',
            description: 'Backlog hours and shift edits',
            icon: adminIcons.clock,
            badge: pendingTimesheetRequests,
            badgeTone: 'red',
          },
        ],
      },
      {
        id: 'hours',
        label: 'Hours',
        items: [
          {
            id: 'hours',
            label: 'Employee hours',
            description: 'Review logged hours by teammate',
            icon: adminIcons.chart,
          },
          {
            id: 'work-items',
            label: 'Work items',
            description: 'Categories used on completed shifts',
            icon: adminIcons.tags,
          },
        ],
      },
    ],
  },
  {
    label: 'Team',
    groups: [
      {
        id: 'people-access',
        label: 'People & access',
        items: [
          {
            id: 'people',
            label: 'People',
            description: 'Invites, titles, teams, and roles',
            icon: adminIcons.people,
          },
          {
            id: 'roles',
            label: 'Roles and permissions',
            description: 'What each role can do',
            icon: adminIcons.shield,
          },
          {
            id: 'tasks',
            label: 'Tasks',
            description: 'Assign work that shows on Home',
            icon: adminIcons.check,
            badge: openAssignedTasks,
            badgeTone: 'amber',
          },
        ],
      },
      {
        id: 'credentialing',
        label: 'Credentialing',
        items: [
          {
            id: 'credentialing',
            label: 'Insurance coverage',
            description: 'Networks and provider coverage',
            icon: adminIcons.badge,
          },
        ],
      },
    ],
  },
  {
    label: 'Workspace',
    groups: [
      {
        id: 'content',
        label: 'Content',
        items: [
          {
            id: 'announcements',
            label: 'Announcements',
            description: 'Posts for every dashboard',
            icon: adminIcons.megaphone,
          },
          {
            href: '/bulletin-board',
            label: 'Bulletin board',
            description: 'Pins and board requests',
            icon: adminIcons.board,
            badge: pendingBulletinRequests,
            badgeTone: 'amber',
          },
          {
            id: 'training',
            label: 'Training',
            description: 'Modules, lessons, and assignments',
            icon: adminIcons.book,
          },
        ],
      },
      {
        id: 'tools',
        label: 'Tools',
        items: [
          {
            id: 'quick-links',
            label: 'Quick links',
            description: 'Practice tools your team can open',
            icon: adminIcons.link,
          },
          {
            id: 'integrations',
            label: 'Integrations',
            description: 'DocuSign and QuickBooks',
            icon: adminIcons.plug,
          },
        ],
      },
      {
        id: 'appearance',
        label: 'Appearance',
        items: [
          {
            id: 'branding',
            label: 'Workspace branding',
            description: 'Name, logos, and colors',
            icon: adminIcons.paint,
          },
        ],
      },
    ],
  },
];
---

<PortalLayout title="Admin" flush>
  <div class="flex min-h-0 flex-1" data-admin-shell>
    <aside
      class="flex w-[min(100%,288px)] shrink-0 flex-col overflow-y-auto border-r border-sage-dark/10 bg-white/95 px-2 py-3 sm:w-72"
      data-admin-menu
      aria-label="Admin sections"
    >
      {
        adminNav.map((section) => (
          <div class="mb-4 last:mb-1">
            <p class="px-2.5 pb-1.5 pt-2 text-[11px] font-semibold uppercase tracking-[0.14em] text-sage-dark/45">
              {section.label}
            </p>
            <div class="space-y-0.5">
              {section.groups.map((group) => (
                <details class="group" data-admin-group={group.id}>
                  <summary class="flex cursor-pointer list-none items-center justify-between gap-2 rounded-xl px-2.5 py-2 text-[15px] font-medium text-charcoal transition hover:bg-sage/10 [&::-webkit-details-marker]:hidden">
                    <span>{group.label}</span>
                    <span class="text-sage-dark/40" set:html={menuChevron} />
                  </summary>
                  <div class="mt-0.5 space-y-0.5 pb-1 pl-0.5">
                    {group.items.map((item) => {
                      const badge =
                        item.badge && item.badge > 0 ? (
                          <span
                            class:list={[
                              'inline-flex h-5 min-w-5 items-center justify-center rounded-full px-1.5 text-[11px] font-semibold leading-none text-white',
                              item.badgeTone === 'amber' ? 'bg-amber-500' : 'bg-red-600',
                            ]}
                          >
                            {item.badge > 9 ? '9+' : item.badge}
                          </span>
                        ) : null;
                      const body = (
                        <>
                          <span
                            class="mt-0.5 inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-sage/15 text-sage-dark"
                            set:html={item.icon}
                          />
                          <span class="min-w-0 flex-1">
                            <span class="flex items-center gap-2">
                              <span class="block text-sm font-semibold text-charcoal">{item.label}</span>
                              {badge}
                            </span>
                            <span class="mt-0.5 block text-xs leading-snug text-sage-dark/55">
                              {item.description}
                            </span>
                          </span>
                        </>
                      );
                      if (item.href) {
                        return (
                          <a
                            href={item.href}
                            class="flex w-full items-start gap-2.5 rounded-xl px-2.5 py-2 text-left transition hover:bg-sage/10"
                          >
                            {body}
                          </a>
                        );
                      }
                      return (
                        <button
                          type="button"
                          class="flex w-full items-start gap-2.5 rounded-xl border-l-[3px] border-transparent px-2.5 py-2 text-left transition hover:bg-sage/10 data-[active=true]:border-sage-dark data-[active=true]:bg-sage/20"
                          data-admin-open={item.id}
                          data-admin-group-id={group.id}
                        >
                          {body}
                        </button>
                      );
                    })}
                  </div>
                </details>
              ))}
            </div>
          </div>
        ))
      }
    </aside>

    <div class="min-h-0 min-w-0 flex-1 overflow-y-auto px-5 py-8 sm:px-8" data-admin-content>
      <div class="mx-auto max-w-5xl">
        <div
          class="rounded-2xl border border-dashed border-sage-dark/20 bg-[#fafbfc] px-6 py-16 text-center"
          data-admin-empty
        >
          <p class="font-display text-2xl text-charcoal">Choose a section</p>
          <p class="mx-auto mt-2 max-w-md text-sm text-sage-dark/65">
            Open a category on the left, then pick an item to manage it here without leaving Admin.
          </p>
        </div>

    <section class="hidden" data-admin-panel="time-off">
      <PanelHeading
        title="Time off requests"
        description="Review pending requests. Approved requests stay here until the last requested date has passed."
      />
      <TimeOffManager requests={timeOffRequests} error={timeOffError} embedded />
