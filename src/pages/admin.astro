      const trainingHeader = readColor(`trainingHeaderColor${suffix}`);
      const trainingHeaderText = readColor(`trainingHeaderTextColor${suffix}`);
      const trainingHeaderLabel = readColor(`trainingHeaderLabelColor${suffix}`);
