  book: `<svg width="23" height="23" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M3 10.5 12 5l9 5.5-9 5.5L3 10.5Z" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"/><path d="M6.2 12.4v4.2c0 .9 2.6 2.4 5.8 2.4s5.8-1.5 5.8-2.4v-4.2M21 10.5v5.2" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg>`,
  link: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="3.5" y="3.5" width="7" height="7" rx="1.5" stroke="currentColor" stroke-width="1.5"/><rect x="13.5" y="3.5" width="7" height="7" rx="1.5" stroke="currentColor" stroke-width="1.5"/><rect x="3.5" y="13.5" width="7" height="7" rx="1.5" stroke="currentColor" stroke-width="1.5"/><path d="M14.5 16.5h5M17 14v5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>`,
  puzzle: `<svg width="26" height="26" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M7 19v-2.73A2.3 2.3 0 1 0 7 11.73V9h2.73A2.3 2.3 0 1 1 14.27 9H17v2.73A2.3 2.3 0 1 1 17 16.27V19H7Z" stroke="currentColor" stroke-width="1.15" stroke-linejoin="miter"/></svg>`,
  palette: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="8.45" r="6.45" stroke="currentColor" stroke-width="1.5"/><circle cx="8.75" cy="14.15" r="6.45" stroke="currentColor" stroke-width="1.5"/><circle cx="15.25" cy="14.15" r="6.45" stroke="currentColor" stroke-width="1.5"/></svg>`,
