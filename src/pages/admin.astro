    const bindBrandModeSwitch = (switcher: Element | null, panelSelector: string) => {
      if (!(switcher instanceof HTMLElement)) return;
      const bubble = switcher.querySelector('[data-brand-mode-bubble]');
      const buttons = Array.from(switcher.querySelectorAll('[data-brand-mode]'));
      const placeBubble = (mode: 'light' | 'dark') => {
        const button = buttons.find((entry) => entry.getAttribute('data-brand-mode') === mode);
        if (!(bubble instanceof HTMLElement) || !(button instanceof HTMLElement)) return;
        bubble.style.width = `${button.offsetWidth}px`;
        bubble.style.transform = `translateX(${button.offsetLeft}px)`;
      };
      const showMode = (mode: 'light' | 'dark') => {
        brandingForm.querySelectorAll(panelSelector).forEach((panel) => {
          if (!(panel instanceof HTMLElement)) return;
          panel.hidden = panel.getAttribute(panelSelector.slice(1, -1)) !== mode;
        });
        buttons.forEach((button) => {
          if (!(button instanceof HTMLButtonElement)) return;
          const active = button.getAttribute('data-brand-mode') === mode;
          button.setAttribute('aria-pressed', active ? 'true' : 'false');
          button.classList.toggle('text-charcoal', active);
          button.classList.toggle('text-sage-dark/55', !active);
        });
        placeBubble(mode);
      };
      buttons.forEach((button) => {
        button.addEventListener('click', () => {
          const mode = button.getAttribute('data-brand-mode');
          if (mode === 'light' || mode === 'dark') showMode(mode);
        });
      });
      showMode('light');
      if (typeof ResizeObserver !== 'undefined') {
        const observer = new ResizeObserver(() => {
          if (switcher.offsetWidth === 0) return;
          const active = buttons.find((button) => button.getAttribute('aria-pressed') === 'true');
          const mode = active?.getAttribute('data-brand-mode');
          if (mode === 'light' || mode === 'dark') placeBubble(mode);
        });
        observer.observe(switcher);
      }
    };
    bindBrandModeSwitch(brandingForm.querySelector('[data-brand-mode-switch]'), '[data-brand-page-panel]');
    bindBrandModeSwitch(brandingForm.querySelector('[data-brand-widget-mode-switch]'), '[data-brand-widget-panel]');
    bindBrandModeSwitch(brandingForm.querySelector('[data-brand-training-mode-switch]'), '[data-brand-training-panel]');

    const colorKeys = [
