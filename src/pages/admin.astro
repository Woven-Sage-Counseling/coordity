            description: 'Name, logos, and colors',
            icon: adminIcons.palette,
          },
        ],
      },
    ],
  },
];

const adminCollapsedItems = adminNav.flatMap((section) =>
  section.groups.flatMap((group) =>
    group.items.map((item) => ({
      ...item,
      groupId: group.id,
    })),
  ),
);
