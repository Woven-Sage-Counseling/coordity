      const widgetOutline = readColor(`widgetOutlineColor${suffix}`);
      const widgetOutlineText = readColor(`widgetOutlineTextColor${suffix}`);
      const widgetOutlineHover = readColor(`widgetOutlineHoverColor${suffix}`);
      const preview = brandingForm.querySelector(`[data-brand-preview="${mode}"]`);
      if (preview instanceof HTMLElement) preview.style.backgroundColor = bg;
      const paint = (role: string, apply: (el: HTMLElement) => void) => {
        brandingForm.querySelectorAll(`[data-brand-preview-${role}="${mode}"]`).forEach((el) => {
          if (el instanceof HTMLElement) apply(el);
        });
      };
      paint('heading', (el) => {
        el.style.color = text;
      });
      paint('body', (el) => {
        el.style.color = text;
      });
      paint('muted', (el) => {
        el.style.color = text;
      });
      paint('primary', (el) => {
        el.style.backgroundColor = primary;
        el.style.color = primaryText;
        el.style.setProperty('--brand-preview-hover', primaryHover);
      });
      paint('accent', (el) => {
        el.style.borderColor = accent;
        el.style.color = accentText;
        el.style.setProperty('--brand-preview-hover', accentHover);
      });
      paint('chip', (el) => {
        el.style.backgroundColor = shadow;
        el.style.color = shadowText;
        el.style.setProperty('--brand-preview-hover', shadowHover);
      });
      paint('selected', (el) => {
        el.style.backgroundColor = selected;
        el.style.color = selectedText;
        el.style.borderColor = `color-mix(in srgb, ${selectedText} 35%, transparent)`;
        el.style.setProperty('--brand-preview-hover', selectedHover);
      });
      paint('card', (el) => {
        el.style.backgroundColor = surface;
      });
      paint('card-title', (el) => {
        el.style.color = text;
      });
      const headerFg = (() => {
        const match = /^#?([0-9a-fA-F]{6})([0-9a-fA-F]{2})?$/.exec(widgetHeader.trim());
        if (!match) return '#F7F4EE';
        const hex = match[1];
        const r = parseInt(hex.slice(0, 2), 16);
        const g = parseInt(hex.slice(2, 4), 16);
        const b = parseInt(hex.slice(4, 6), 16);
        return (0.299 * r + 0.587 * g + 0.114 * b) / 255 > 0.58 ? '#393A3D' : '#F7F4EE';
      })();
      paint('widget-header', (el) => {
        el.style.backgroundColor = widgetHeader;
        el.style.color = headerFg;
      });
      paint('widget-body', (el) => {
        el.style.backgroundColor = widgetBg;
      });
      paint('widget-card', (el) => {
        el.style.backgroundColor = widgetCard;
      });
      paint('widget-button', (el) => {
        el.style.backgroundColor = widgetButton;
        el.style.color = widgetButtonText;
        el.style.setProperty('--brand-preview-hover', widgetButtonHover);
