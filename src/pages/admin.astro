---
import PortalLayout from '../layouts/PortalLayout.astro';
import AnnouncementManager from '../components/AnnouncementManager.astro';
import PeopleManager from '../components/PeopleManager.astro';
import TimeOffManager from '../components/TimeOffManager.astro';
import { listActiveAnnouncements } from '../lib/announcements';
import { listRolesWithPermissions } from '../lib/employees';
import { canAccessManagement } from '../lib/permissions';
import { plainPermission, plainRole } from '../lib/role-plain-language';
import { listTimeOffRequestsForAdmin } from '../lib/time-off-requests';

export const prerender = false;

const employee = Astro.locals.employee!;
if (!canAccessManagement(employee)) {
  return new Response('Forbidden', { status: 403 });
}

const announcements = await listActiveAnnouncements(50);
const timeOffRequests = await listTimeOffRequestsForAdmin();
const roles = await listRolesWithPermissions();
const error = Astro.url.searchParams.get('error');
const inviteUrl = Astro.url.searchParams.get('inviteUrl');
const peopleError = Astro.url.searchParams.get('peopleError');
const timeOffError = Astro.url.searchParams.get('timeOffError');
---

<PortalLayout title="Admin" wide>
  <h1 class="font-display text-4xl text-charcoal sm:text-5xl">Admin</h1>
  <p class="mt-3 max-w-2xl text-sage-dark/75">
    Post announcements, review time off, manage people, and review portal roles.
  </p>

  <TimeOffManager requests={timeOffRequests} error={timeOffError} />

  <AnnouncementManager announcements={announcements} error={error} />

  <PeopleManager error={peopleError} inviteUrl={inviteUrl} />

  <section class="mt-14" aria-labelledby="roles-heading">
    <h2 id="roles-heading" class="font-display text-3xl text-charcoal">Roles and permissions</h2>
    <p class="mt-2 text-sm text-sage-dark/65">
      A plain-language guide to what each role can and cannot do.
    </p>

    <div class="mt-6 space-y-4">
      {
        roles.map((role) => {
          const guide = plainRole(role.key);
          return (
            <article class="rounded-2xl border border-sage-dark/10 bg-white/80 p-5 shadow-sm">
              <h3 class="font-display text-2xl text-charcoal">{role.name}</h3>
              <p class="mt-2 text-sm text-sage-dark/75">
                {guide?.summary ?? role.description}
              </p>

              {
                guide ? (
                  <div class="mt-4 grid gap-4 sm:grid-cols-2">
                    <div>
                      <p class="text-xs font-semibold uppercase tracking-[0.14em] text-[#2CA01C]">Can</p>
                      <ul class="mt-2 space-y-1.5 text-sm text-charcoal">
                        {guide.can.map((item) => (
                          <li class="flex gap-2">
                            <span class="text-[#2CA01C]" aria-hidden="true">
                              •
                            </span>
                            <span>{item}</span>
                          </li>
                        ))}
                      </ul>
                    </div>
                    {guide.cannot && guide.cannot.length > 0 ? (
                      <div>
                        <p class="text-xs font-semibold uppercase tracking-[0.14em] text-sage-dark/50">Cannot</p>
                        <ul class="mt-2 space-y-1.5 text-sm text-sage-dark/75">
                          {guide.cannot.map((item) => (
                            <li class="flex gap-2">
                              <span class="text-sage-dark/40" aria-hidden="true">
                                •
                              </span>
                              <span>{item}</span>
                            </li>
                          ))}
                        </ul>
                      </div>
                    ) : null}
                  </div>
                ) : null
              }

              <details class="mt-5">
                <summary class="cursor-pointer text-sm font-medium text-sage-dark/70 hover:text-charcoal">
                  Technical permission list
                </summary>
                {role.permissions.length === 0 ? (
                  <p class="mt-3 text-sm text-sage-dark/55">No permissions assigned.</p>
                ) : (
                  <ul class="mt-3 grid gap-2 sm:grid-cols-2">
                    {role.permissions.map((permission) => (
                      <li class="rounded-xl bg-[#f4f5f8] px-3 py-2 text-sm text-charcoal">
                        {plainPermission(permission.key, permission.description)}
                      </li>
                    ))}
                  </ul>
                )}
              </details>
            </article>
          );
        })
      }
    </div>
  </section>
</PortalLayout>
