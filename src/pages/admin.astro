function brandColorParts(value: string): { opaque: string; alpha: number; full: string } {
  const match = /^#([0-9A-Fa-f]{6})([0-9A-Fa-f]{2})?$/.exec(value.trim());
  if (!match) return { opaque: '#000000', alpha: 100, full: '#000000' };
  const opaque = `#${match[1].toUpperCase()}`;
  if (!match[2] || match[2].toUpperCase() === 'FF') return { opaque, alpha: 100, full: opaque };
  const alpha = Math.round((Number.parseInt(match[2], 16) / 255) * 100);
  return { opaque, alpha, full: `${opaque}${match[2].toUpperCase()}` };
}
