    const syncPair = (key: string, fromColor: boolean) => {
      const colorInput = brandingForm.querySelector(`[data-brand-color="${key}"]`);
      const hexInput = brandingForm.querySelector(`[data-brand-hex="${key}"]`);
      const alphaInput = brandingForm.querySelector(`[data-brand-alpha="${key}"]`);
      const stored = brandingForm.querySelector(`[data-brand-value="${key}"]`);
      const alphaLabel = brandingForm.querySelector(`[data-brand-alpha-label="${key}"]`);
      if (!(colorInput instanceof HTMLInputElement) || !(hexInput instanceof HTMLInputElement)) return;
      if (fromColor) {
        hexInput.value = colorInput.value.toUpperCase();
      } else {
        const raw = hexInput.value.trim();
        const next = raw.startsWith('#') ? raw : `#${raw}`;
        if (/^#[0-9A-Fa-f]{6}$/.test(next)) {
          colorInput.value = next;
          hexInput.value = next.toUpperCase();
        }
      }
      const percent = alphaInput instanceof HTMLInputElement ? Number(alphaInput.value) : 100;
      const clamped = Number.isFinite(percent) ? Math.max(0, Math.min(100, Math.round(percent))) : 100;
      if (alphaLabel instanceof HTMLElement) alphaLabel.textContent = `${clamped}%`;
      const opaque = /^#[0-9A-Fa-f]{6}$/.test(colorInput.value) ? colorInput.value.toUpperCase() : hexInput.value.toUpperCase();
      const alphaByte = Math.round((clamped / 100) * 255).toString(16).padStart(2, '0').toUpperCase();
      const full = clamped >= 100 ? opaque : `${opaque}${alphaByte}`;
      if (stored instanceof HTMLInputElement) stored.value = full;
      paintPreview(key.endsWith('Dark') ? 'dark' : 'light');
    };

    colorKeys.forEach((key) => {
      const colorInput = brandingForm.querySelector(`[data-brand-color="${key}"]`);
      const hexInput = brandingForm.querySelector(`[data-brand-hex="${key}"]`);
      const alphaInput = brandingForm.querySelector(`[data-brand-alpha="${key}"]`);
      colorInput?.addEventListener('input', () => syncPair(key, true));
      hexInput?.addEventListener('change', () => syncPair(key, false));
      alphaInput?.addEventListener('input', () => syncPair(key, true));
    });

    const hexChannels = (value: string | null | undefined) => {
      const match = /^#?([0-9a-fA-F]{6})([0-9a-fA-F]{2})?$/.exec((value ?? '').trim());
      if (!match) return null;
      const hex = match[1];
      return `${parseInt(hex.slice(0, 2), 16)} ${parseInt(hex.slice(2, 4), 16)} ${parseInt(hex.slice(4, 6), 16)}`;
    };
    const hexAlpha = (value: string | null | undefined) => {
      const match = /^#?([0-9a-fA-F]{6})([0-9a-fA-F]{2})?$/.exec((value ?? '').trim());
      if (!match?.[2] || match[2].toUpperCase() === 'FF') return '1';
      return String(Math.round((parseInt(match[2], 16) / 255) * 1000) / 1000);
    };
    const applySavedBrandColors = (branding: {
      bgColorLight?: string | null;
      surfaceColorLight?: string | null;
      textColorLight?: string | null;
      primaryColorLight?: string | null;
      primaryTextColorLight?: string | null;
      primaryHoverColorLight?: string | null;
