---
import PortalLayout from '../layouts/PortalLayout.astro';
import AnnouncementManager from '../components/AnnouncementManager.astro';
import CredentialingManager from '../components/CredentialingManager.astro';
import PanelHeading from '../components/PanelHeading.astro';
import PeopleManager from '../components/PeopleManager.astro';
import TasksManager from '../components/TasksManager.astro';
import TimeOffManager from '../components/TimeOffManager.astro';
import TimesheetBacklogManager from '../components/TimesheetBacklogManager.astro';
import TimesheetShiftEditManager from '../components/TimesheetShiftEditManager.astro';
import TimesheetStatsViewer from '../components/TimesheetStatsViewer.astro';
import WorkItemsManager from '../components/WorkItemsManager.astro';
import { listActiveAnnouncements } from '../lib/announcements';
import {
  listProvidersForLookup,
  listInsuranceCatalog,
  listCoverageMatrix,
  listGroupCoverageMatrix,
} from '../lib/credentialing';
import { listEmployees, listRolesWithPermissions } from '../lib/employees';
import { canAccessManagement } from '../lib/permissions';
import { plainPermission, plainRole } from '../lib/role-plain-language';
import { listTimeOffRequestsForAdmin } from '../lib/time-off-requests';
import { listTimesheetBacklogForAdmin } from '../lib/timesheet-backlog';
import { listTimesheetShiftEditsForAdmin } from '../lib/timesheet-shift-edits';
import { listAssignedTasksForAdmin } from '../lib/tasks';
import { listWorkCategoriesForAdmin } from '../lib/timesheet-work-categories';
import { listBulletinBoardRequests } from '../lib/bulletin-board';
import { orgIdFromLocals } from '../lib/organization';

export const prerender = false;

const employee = Astro.locals.employee!;
if (!canAccessManagement(employee)) {
  return new Response('Forbidden', { status: 403 });
}

const orgId = orgIdFromLocals(Astro.locals.organization);
const organization = Astro.locals.organization;
const hasOrgFavicon = Boolean(organization?.hasFavicon);
const orgFaviconPreview = hasOrgFavicon
  ? `/api/org/favicon?v=${organization?.faviconUpdatedAt ?? 0}`
  : null;
const hasOrgLogo = Boolean(organization?.hasLogo);
const orgLogoPreview =
  organization?.logoUrl ??
  (hasOrgLogo ? `/api/org/logo?v=${organization?.logoUpdatedAt ?? 0}` : null);
const brandDisplayName = organization?.displayName ?? organization?.name ?? '';
const brandWebsiteUrl = organization?.websiteUrl ?? '';
const brandBgLight = organization?.bgColorLight ?? '#F7F4EE';
const brandPrimaryLight = organization?.primaryColorLight ?? '#535F51';
const brandAccentLight = organization?.accentColorLight ?? '#788F75';
const brandBgDark = organization?.bgColorDark ?? '#111311';
const brandPrimaryDark = organization?.primaryColorDark ?? '#BAC6B6';
const brandAccentDark = organization?.accentColorDark ?? '#8A9E86';
const brandInvertLogoDark = Boolean(organization?.invertLogoDark);

async function safeLoad<T>(label: string, load: () => Promise<T>, fallback: T): Promise<T> {
  try {
    return await load();
  } catch (error) {
    console.error(`admin ${label} load failed`, error);
    return fallback;
  }
}

const announcements = await safeLoad('announcements', () => listActiveAnnouncements(50), []);
const timeOffRequests = await safeLoad('time-off', () => listTimeOffRequestsForAdmin(), []);
const timesheetBacklogRequests = await safeLoad('timesheet-backlog', () => listTimesheetBacklogForAdmin(), []);
const timesheetShiftEditRequests = await safeLoad(
  'timesheet-shift-edits',
  () => listTimesheetShiftEditsForAdmin(),
  [],
);
const pendingBoardRequests = await safeLoad(
  'bulletin-requests',
  () => listBulletinBoardRequests({ status: 'pending' }),
  [],
);
const roles = await safeLoad('roles', () => listRolesWithPermissions(), []);
const credentialingProviders = await safeLoad('credentialing-providers', () => listProvidersForLookup(), []);
const insuranceCatalog = await safeLoad('insurance-catalog', () => listInsuranceCatalog(), []);
const coverageMap = await safeLoad('coverage-matrix', () => listCoverageMatrix(), {});
const groupCoverageMap = await safeLoad('group-coverage-matrix', () => listGroupCoverageMatrix(), {});
const employees = await safeLoad('employees', () => listEmployees(orgId), []);
let assignedTasks: Awaited<ReturnType<typeof listAssignedTasksForAdmin>> = [];
let tasksLoadError: string | null = Astro.url.searchParams.get('tasksError');
try {
  assignedTasks = await listAssignedTasksForAdmin();
} catch (error) {
  console.error('admin tasks load failed', error);
  if (!tasksLoadError) {
    tasksLoadError = 'Tasks are temporarily unavailable. Database migration may still be pending.';
  }
}

const error = Astro.url.searchParams.get('error');
const announcementSaved = Astro.url.searchParams.get('announcementSaved');
const inviteUrl = Astro.url.searchParams.get('inviteUrl');
const peopleError = Astro.url.searchParams.get('peopleError');
const peopleSaved = Astro.url.searchParams.get('peopleSaved');
const peopleUser = Astro.url.searchParams.get('peopleUser');
const timeOffError = Astro.url.searchParams.get('timeOffError');
const timesheetError = Astro.url.searchParams.get('timesheetError');
const credentialingError = Astro.url.searchParams.get('credentialingError');
const tasksError = tasksLoadError;
const tasksSaved = Astro.url.searchParams.get('tasksSaved');
const workCategoriesSaved = Astro.url.searchParams.get('workCategoriesSaved');
let workCategoriesError: string | null = Astro.url.searchParams.get('workCategoriesError');
const pendingTimeOff = timeOffRequests.filter((request) => request.status === 'pending').length;
const pendingTimesheetBacklog = timesheetBacklogRequests.filter((request) => request.status === 'pending').length;
const pendingTimesheetShiftEdits = timesheetShiftEditRequests.filter((request) => request.status === 'pending').length;
const pendingTimesheetRequests = pendingTimesheetBacklog + pendingTimesheetShiftEdits;
const pendingBulletinRequests = pendingBoardRequests.length;
const openAssignedTasks = assignedTasks.filter((task) => task.completedAt == null).length;
let workCategories: Awaited<ReturnType<typeof listWorkCategoriesForAdmin>> = [];
try {
  workCategories = await listWorkCategoriesForAdmin();
} catch (error) {
  console.error('admin work categories load failed', error);
  if (!workCategoriesError) {
    workCategoriesError = 'Work items are temporarily unavailable. Database migration may still be pending.';
  }
}

const menuChevron = `<svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M6 3l5 5-5 5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg>`;
---

<PortalLayout title="Admin" wide>
  <div class="mx-auto max-w-2xl" data-admin-shell>
    <div data-admin-header>
      <p class="text-sm text-sage-dark/65">
        <a href="/" class="hover:text-sage-dark">Home</a>
        <span class="mx-1.5 text-sage-dark/35">/</span>
        Admin
      </p>
      <h1 class="mt-3 font-display text-4xl text-charcoal">Admin</h1>
    </div>

    <div data-admin-menu>
      <p class="mt-3 text-sage-dark/75">Choose a category to manage.</p>

      <div class="mt-8 overflow-hidden rounded-2xl border border-sage-dark/10 bg-white/90 shadow-sm">
        <button
          type="button"
          class="flex w-full items-center justify-between gap-3 px-4 py-3.5 text-left transition hover:bg-sage/10"
          data-admin-open="time-off"
        >
          <span class="text-[15px] font-medium text-charcoal">Time off requests</span>
          <span class="inline-flex shrink-0 items-center gap-2">
            {
              pendingTimeOff > 0 ? (
                <span
                  class="inline-flex h-5 min-w-5 items-center justify-center rounded-full bg-red-600 px-1.5 text-[11px] font-semibold leading-none text-white"
                  aria-label={`${pendingTimeOff} pending time off ${pendingTimeOff === 1 ? 'request' : 'requests'}`}
                >
                  {pendingTimeOff > 9 ? '9+' : pendingTimeOff}
                </span>
              ) : null
            }
            <span class="text-sage-dark/40" set:html={menuChevron} />
          </span>
        </button>
        <div class="mx-4 border-t border-sage-dark/10"></div>
        <button
          type="button"
          class="flex w-full items-center justify-between gap-3 px-4 py-3.5 text-left transition hover:bg-sage/10"
          data-admin-open="timesheet"
        >
          <span class="text-[15px] font-medium text-charcoal">Timesheet requests</span>
          <span class="inline-flex shrink-0 items-center gap-2">
            {
              pendingTimesheetRequests > 0 ? (
                <span
                  class="inline-flex h-5 min-w-5 items-center justify-center rounded-full bg-red-600 px-1.5 text-[11px] font-semibold leading-none text-white"
                  aria-label={`${pendingTimesheetRequests} pending timesheet ${pendingTimesheetRequests === 1 ? 'request' : 'requests'}`}
                >
                  {pendingTimesheetRequests > 9 ? '9+' : pendingTimesheetRequests}
                </span>
              ) : null
            }
            <span class="text-sage-dark/40" set:html={menuChevron} />
          </span>
        </button>
        <div class="mx-4 border-t border-sage-dark/10"></div>
        <button
          type="button"
          class="flex w-full items-center justify-between gap-3 px-4 py-3.5 text-left transition hover:bg-sage/10"
          data-admin-open="hours"
        >
          <span class="text-[15px] font-medium text-charcoal">Employee hours</span>
          <span class="text-sage-dark/40" set:html={menuChevron} />
        </button>
        <div class="mx-4 border-t border-sage-dark/10"></div>
        <button
          type="button"
          class="flex w-full items-center justify-between gap-3 px-4 py-3.5 text-left transition hover:bg-sage/10"
          data-admin-open="announcements"
        >
          <span class="text-[15px] font-medium text-charcoal">Announcements</span>
          <span class="text-sage-dark/40" set:html={menuChevron} />
        </button>
        <div class="mx-4 border-t border-sage-dark/10"></div>
        <a
          href="/bulletin-board"
          class="flex w-full items-center justify-between gap-3 px-4 py-3.5 text-left transition hover:bg-sage/10"
        >
          <span class="text-[15px] font-medium text-charcoal">Bulletin board</span>
          <span class="inline-flex shrink-0 items-center gap-2">
            {
              pendingBulletinRequests > 0 ? (
                <span
                  class="inline-flex h-5 min-w-5 items-center justify-center rounded-full bg-amber-500 px-1.5 text-[11px] font-semibold leading-none text-white"
                  aria-label={`${pendingBulletinRequests} pending board ${pendingBulletinRequests === 1 ? 'request' : 'requests'}`}
                >
                  {pendingBulletinRequests > 9 ? '9+' : pendingBulletinRequests}
                </span>
              ) : null
            }
            <span class="text-sage-dark/40" set:html={menuChevron} />
          </span>
        </a>
        <div class="mx-4 border-t border-sage-dark/10"></div>
        <button
          type="button"
          class="flex w-full items-center justify-between gap-3 px-4 py-3.5 text-left transition hover:bg-sage/10"
          data-admin-open="people"
        >
          <span class="text-[15px] font-medium text-charcoal">People</span>
          <span class="text-sage-dark/40" set:html={menuChevron} />
        </button>
        <div class="mx-4 border-t border-sage-dark/10"></div>
        <button
          type="button"
          class="flex w-full items-center justify-between gap-3 px-4 py-3.5 text-left transition hover:bg-sage/10"
          data-admin-open="tasks"
        >
          <span class="text-[15px] font-medium text-charcoal">Tasks</span>
          <span class="inline-flex shrink-0 items-center gap-2">
            {
              openAssignedTasks > 0 ? (
                <span
                  class="inline-flex h-5 min-w-5 items-center justify-center rounded-full bg-amber-500 px-1.5 text-[11px] font-semibold leading-none text-white"
                  aria-label={`${openAssignedTasks} open assigned ${openAssignedTasks === 1 ? 'task' : 'tasks'}`}
                >
                  {openAssignedTasks > 9 ? '9+' : openAssignedTasks}
                </span>
              ) : null
            }
            <span class="text-sage-dark/40" set:html={menuChevron} />
          </span>
        </button>
        <div class="mx-4 border-t border-sage-dark/10"></div>
        <button
          type="button"
          class="flex w-full items-center justify-between gap-3 px-4 py-3.5 text-left transition hover:bg-sage/10"
          data-admin-open="credentialing"
        >
          <span class="text-[15px] font-medium text-charcoal">Credentialing</span>
          <span class="text-sage-dark/40" set:html={menuChevron} />
        </button>
        <div class="mx-4 border-t border-sage-dark/10"></div>
        <button
          type="button"
          class="flex w-full items-center justify-between gap-3 px-4 py-3.5 text-left transition hover:bg-sage/10"
          data-admin-open="work-items"
        >
          <span class="text-[15px] font-medium text-charcoal">Work items</span>
          <span class="text-sage-dark/40" set:html={menuChevron} />
        </button>
        <div class="mx-4 border-t border-sage-dark/10"></div>
        <button
          type="button"
          class="flex w-full items-center justify-between gap-3 px-4 py-3.5 text-left transition hover:bg-sage/10"
          data-admin-open="branding"
        >
          <span class="text-[15px] font-medium text-charcoal">Workspace branding</span>
          <span class="text-sage-dark/40" set:html={menuChevron} />
        </button>
        <div class="mx-4 border-t border-sage-dark/10"></div>
        <button
          type="button"
          class="flex w-full items-center justify-between gap-3 px-4 py-3.5 text-left transition hover:bg-sage/10"
          data-admin-open="roles"
        >
          <span class="text-[15px] font-medium text-charcoal">Roles and permissions</span>
          <span class="text-sage-dark/40" set:html={menuChevron} />
        </button>
      </div>
    </div>

    <section class="hidden" data-admin-panel="time-off">
      <button
        type="button"
        class="inline-flex items-center gap-1 rounded-full border border-sage-dark/20 px-3 py-1.5 text-sm font-semibold text-sage-dark transition hover:border-sage-dark/35 hover:bg-sage/10"
        data-admin-back
      >
        <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M10 3L5 8l5 5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        Back
      </button>
      <PanelHeading
        title="Time off requests"
        description="Review pending requests. Approved requests stay here until the last requested date has passed."
      />
      <TimeOffManager requests={timeOffRequests} error={timeOffError} embedded />
    </section>

    <section class="hidden" data-admin-panel="timesheet">
      <button
        type="button"
        class="inline-flex items-center gap-1 rounded-full border border-sage-dark/20 px-3 py-1.5 text-sm font-semibold text-sage-dark transition hover:border-sage-dark/35 hover:bg-sage/10"
        data-admin-back
      >
        <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M10 3L5 8l5 5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        Back
      </button>
      <PanelHeading
        title="Timesheet requests"
        description="Review backlog hours and requested shift time changes. Clear approved requests once handled — hours stay on the employee timesheet."
      />
      <TimesheetBacklogManager requests={timesheetBacklogRequests} error={timesheetError} embedded />
      <TimesheetShiftEditManager requests={timesheetShiftEditRequests} embedded />
    </section>

    <section class="hidden" data-admin-panel="hours">
      <button
        type="button"
        class="inline-flex items-center gap-1 rounded-full border border-sage-dark/20 px-3 py-1.5 text-sm font-semibold text-sage-dark transition hover:border-sage-dark/35 hover:bg-sage/10"
        data-admin-back
      >
        <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M10 3L5 8l5 5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        Back
      </button>
      <PanelHeading
        title="Employee hours"
        description="Pick a teammate to review their logged hours, work item chart, and completed shifts for a timeframe."
      />
      <TimesheetStatsViewer employees={employees} />
    </section>

    <section class="hidden" data-admin-panel="announcements">
      <button
        type="button"
        class="inline-flex items-center gap-1 rounded-full border border-sage-dark/20 px-3 py-1.5 text-sm font-semibold text-sage-dark transition hover:border-sage-dark/35 hover:bg-sage/10"
        data-admin-back
      >
        <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M10 3L5 8l5 5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        Back
      </button>
      <PanelHeading
        title="Announcements"
        description="Post to every dashboard, then edit, resend, or remove from the history log."
      />
      <AnnouncementManager
        announcements={announcements}
        error={error}
        savedId={announcementSaved}
        embedded
      />
    </section>

    <section class="hidden" data-admin-panel="people">
      <button
        type="button"
        class="inline-flex items-center gap-1 rounded-full border border-sage-dark/20 px-3 py-1.5 text-sm font-semibold text-sage-dark transition hover:border-sage-dark/35 hover:bg-sage/10"
        data-admin-back
      >
        <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M10 3L5 8l5 5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        Back
      </button>
      <PanelHeading
        title="People"
        description="Invite people, set job titles and teams, and assign roles."
      />
      <PeopleManager
        error={peopleError}
        inviteUrl={inviteUrl}
        savedAction={peopleSaved}
        savedUserId={peopleUser}
        embedded
      />
    </section>

    <section class="hidden" data-admin-panel="tasks">
      <button
        type="button"
        class="inline-flex items-center gap-1 rounded-full border border-sage-dark/20 px-3 py-1.5 text-sm font-semibold text-sage-dark transition hover:border-sage-dark/35 hover:bg-sage/10"
        data-admin-back
      >
        <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M10 3L5 8l5 5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        Back
      </button>
      <PanelHeading
        title="Tasks"
        description="Assign tasks to team members. They appear in each person's Tasks widget on Home."
      />
      <TasksManager
        tasks={assignedTasks}
        employees={employees}
        error={tasksError}
        saved={tasksSaved === '1'}
        embedded
      />
    </section>

    <section class="hidden" data-admin-panel="credentialing">
      <button
        type="button"
        class="inline-flex items-center gap-1 rounded-full border border-sage-dark/20 px-3 py-1.5 text-sm font-semibold text-sage-dark transition hover:border-sage-dark/35 hover:bg-sage/10"
        data-admin-back
      >
        <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M10 3L5 8l5 5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        Back
      </button>
      <PanelHeading
        title="Credentialing"
        description="Directory clinicians appear automatically. Assign insurance networks per provider and manage the catalog."
      />
      <CredentialingManager
        providers={credentialingProviders}
        catalog={insuranceCatalog}
        coverageMap={coverageMap}
        groupCoverageMap={groupCoverageMap}
        error={credentialingError}
        embedded
      />
    </section>

    <section class="hidden" data-admin-panel="work-items">
      <button
        type="button"
        class="inline-flex items-center gap-1 rounded-full border border-sage-dark/20 px-3 py-1.5 text-sm font-semibold text-sage-dark transition hover:border-sage-dark/35 hover:bg-sage/10"
        data-admin-back
      >
        <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M10 3L5 8l5 5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        Back
      </button>
      <PanelHeading
        title="Work items"
        description="Customize the categories employees tag on completed shifts. Names and colors appear on the timesheet and work breakdown chart."
      />
      <WorkItemsManager
        categories={workCategories}
        error={workCategoriesError}
        saved={workCategoriesSaved === '1'}
        embedded
      />
    </section>

    <section class="hidden" data-admin-panel="branding">
      <button
        type="button"
        class="inline-flex items-center gap-1 rounded-full border border-sage-dark/20 px-3 py-1.5 text-sm font-semibold text-sage-dark transition hover:border-sage-dark/35 hover:bg-sage/10"
        data-admin-back
      >
        <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M10 3L5 8l5 5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        Back
      </button>
      <PanelHeading
        title="Workspace branding"
        description="Customize how your portal looks — name, logos, tab icon, and colors used across buttons and accents."
      />
      <form
        id="org-branding-form"
        class="mt-6 space-y-8 rounded-2xl border border-sage-dark/10 bg-white/90 p-5 shadow-sm"
        enctype="multipart/form-data"
      >
        <div class="space-y-4">
          <h3 class="text-sm font-semibold text-charcoal">Workspace identity</h3>
          <label class="block text-sm font-medium text-charcoal">
            Display name
            <input class="field" type="text" name="displayName" required maxlength="80" value={brandDisplayName} />
          </label>
          <label class="block text-sm font-medium text-charcoal">
            Website
            <input
              class="field"
              type="url"
              name="websiteUrl"
              placeholder="https://example.com"
              value={brandWebsiteUrl}
            />
          </label>
        </div>

        <div class="space-y-4 border-t border-sage-dark/10 pt-6">
          <h3 class="text-sm font-semibold text-charcoal">Header &amp; sign-in logo</h3>
          <p class="text-sm text-sage-dark/65">
            Used in the portal header, sign-in page, and workspace finder. Transparent PNG works best. Max about 1.2MB.
          </p>
          <div class="flex items-center gap-4">
            <div class="flex h-16 min-w-[7rem] items-center justify-center overflow-hidden rounded-xl border border-sage-dark/15 bg-[#f4f5f8] px-3">
              {
                orgLogoPreview ? (
                  <img src={orgLogoPreview} alt="" class="max-h-12 w-auto max-w-[9rem] object-contain" data-brand-logo-preview />
                ) : (
                  <span class="text-[11px] text-sage-dark/45" data-brand-logo-empty>None</span>
                )
              }
            </div>
            <label class="min-w-0 flex-1 text-sm font-medium text-charcoal">
              Logo file
              <input
                class="mt-1.5 block w-full text-sm"
                type="file"
                name="logo"
                accept="image/png,image/jpeg,image/webp,image/gif,image/svg+xml"
              />
            </label>
          </div>
          {
            hasOrgLogo || organization?.logoUrl ? (
              <label class="flex items-center gap-2 text-sm text-sage-dark/80">
                <input type="checkbox" name="clearLogo" value="1" />
                Remove logo
              </label>
            ) : null
          }
          <label class="flex items-center gap-2 text-sm text-sage-dark/80">
            <input type="checkbox" name="invertLogoDark" value="1" checked={brandInvertLogoDark} />
            Invert logo in dark mode
          </label>
        </div>

        <div class="space-y-4 border-t border-sage-dark/10 pt-6">
          <h3 class="text-sm font-semibold text-charcoal">Favicon</h3>
          <p class="text-sm text-sage-dark/65">
            Browser tab icon. Square PNG or ICO works best. Max about 1.2MB.
          </p>
          <div class="flex items-center gap-4">
            <div class="flex h-14 w-14 items-center justify-center overflow-hidden rounded-xl border border-sage-dark/15 bg-[#f4f5f8]">
              {
                orgFaviconPreview ? (
                  <img src={orgFaviconPreview} alt="" class="h-10 w-10 object-contain" data-brand-favicon-preview />
                ) : (
                  <span class="text-[11px] text-sage-dark/45" data-brand-favicon-empty>None</span>
                )
              }
            </div>
            <label class="min-w-0 flex-1 text-sm font-medium text-charcoal">
              Favicon file
              <input
                class="mt-1.5 block w-full text-sm"
                type="file"
                name="favicon"
                accept="image/png,image/jpeg,image/webp,image/x-icon,image/vnd.microsoft.icon,image/svg+xml,.ico"
              />
            </label>
          </div>
          {
            hasOrgFavicon ? (
              <label class="flex items-center gap-2 text-sm text-sage-dark/80">
                <input type="checkbox" name="clearFavicon" value="1" />
                Remove custom favicon
              </label>
            ) : null
          }
        </div>

        <div class="space-y-4 border-t border-sage-dark/10 pt-6">
          <h3 class="text-sm font-semibold text-charcoal">Colors</h3>
          <p class="text-sm text-sage-dark/65">
            Set background, primary, and accent for light and dark mode. Primary drives buttons and
            strong text; accent is used for secondary highlights.
          </p>

          <div class="space-y-3 rounded-2xl border border-sage-dark/10 p-4">
            <h4 class="text-xs font-semibold uppercase tracking-wide text-sage-dark/55">Light mode</h4>
            <div class="grid gap-4 sm:grid-cols-3">
              <label class="block text-sm font-medium text-charcoal">
                Background
                <span class="mt-1.5 flex items-center gap-2">
                  <input
                    class="h-10 w-14 cursor-pointer rounded-lg border border-sage-dark/15 bg-white p-1"
                    type="color"
                    name="bgColorLight"
                    value={brandBgLight}
                    data-brand-color="bgColorLight"
                  />
                  <input
                    class="field mt-0"
                    type="text"
                    value={brandBgLight}
                    maxlength="7"
                    data-brand-hex="bgColorLight"
                    aria-label="Light background hex"
                  />
                </span>
              </label>
              <label class="block text-sm font-medium text-charcoal">
                Primary
                <span class="mt-1.5 flex items-center gap-2">
                  <input
                    class="h-10 w-14 cursor-pointer rounded-lg border border-sage-dark/15 bg-white p-1"
                    type="color"
                    name="primaryColorLight"
                    value={brandPrimaryLight}
                    data-brand-color="primaryColorLight"
                  />
                  <input
                    class="field mt-0"
                    type="text"
                    value={brandPrimaryLight}
                    maxlength="7"
                    data-brand-hex="primaryColorLight"
                    aria-label="Light primary hex"
                  />
                </span>
              </label>
              <label class="block text-sm font-medium text-charcoal">
                Accent
                <span class="mt-1.5 flex items-center gap-2">
                  <input
                    class="h-10 w-14 cursor-pointer rounded-lg border border-sage-dark/15 bg-white p-1"
                    type="color"
                    name="accentColorLight"
                    value={brandAccentLight}
                    data-brand-color="accentColorLight"
                  />
                  <input
                    class="field mt-0"
                    type="text"
                    value={brandAccentLight}
                    maxlength="7"
                    data-brand-hex="accentColorLight"
                    aria-label="Light accent hex"
                  />
                </span>
              </label>
            </div>
            <div
              class="flex flex-wrap items-center gap-3 rounded-xl border border-sage-dark/10 px-4 py-3"
              data-brand-preview="light"
              style={`background:${brandBgLight}`}
            >
              <span
                class="inline-flex rounded-full px-4 py-2 text-sm font-semibold text-white"
                data-brand-preview-primary="light"
                style={`background:${brandPrimaryLight}`}
              >
                Primary
              </span>
              <span
                class="inline-flex rounded-full border px-4 py-2 text-sm font-medium"
                data-brand-preview-accent="light"
                style={`border-color:${brandAccentLight};color:${brandAccentLight}`}
              >
                Accent
              </span>
            </div>
          </div>

          <div class="space-y-3 rounded-2xl border border-sage-dark/10 p-4">
            <h4 class="text-xs font-semibold uppercase tracking-wide text-sage-dark/55">Dark mode</h4>
            <div class="grid gap-4 sm:grid-cols-3">
              <label class="block text-sm font-medium text-charcoal">
                Background
                <span class="mt-1.5 flex items-center gap-2">
                  <input
                    class="h-10 w-14 cursor-pointer rounded-lg border border-sage-dark/15 bg-white p-1"
                    type="color"
                    name="bgColorDark"
                    value={brandBgDark}
                    data-brand-color="bgColorDark"
                  />
                  <input
                    class="field mt-0"
                    type="text"
                    value={brandBgDark}
                    maxlength="7"
                    data-brand-hex="bgColorDark"
                    aria-label="Dark background hex"
                  />
                </span>
              </label>
              <label class="block text-sm font-medium text-charcoal">
                Primary
                <span class="mt-1.5 flex items-center gap-2">
                  <input
                    class="h-10 w-14 cursor-pointer rounded-lg border border-sage-dark/15 bg-white p-1"
                    type="color"
                    name="primaryColorDark"
                    value={brandPrimaryDark}
                    data-brand-color="primaryColorDark"
                  />
                  <input
                    class="field mt-0"
                    type="text"
                    value={brandPrimaryDark}
                    maxlength="7"
                    data-brand-hex="primaryColorDark"
                    aria-label="Dark primary hex"
                  />
                </span>
              </label>
              <label class="block text-sm font-medium text-charcoal">
                Accent
                <span class="mt-1.5 flex items-center gap-2">
                  <input
                    class="h-10 w-14 cursor-pointer rounded-lg border border-sage-dark/15 bg-white p-1"
                    type="color"
                    name="accentColorDark"
                    value={brandAccentDark}
                    data-brand-color="accentColorDark"
                  />
                  <input
                    class="field mt-0"
                    type="text"
                    value={brandAccentDark}
                    maxlength="7"
                    data-brand-hex="accentColorDark"
                    aria-label="Dark accent hex"
                  />
                </span>
              </label>
            </div>
            <div
              class="flex flex-wrap items-center gap-3 rounded-xl border border-white/10 px-4 py-3"
              data-brand-preview="dark"
              style={`background:${brandBgDark}`}
            >
              <span
                class="inline-flex rounded-full px-4 py-2 text-sm font-semibold"
                data-brand-preview-primary="dark"
                style={`background:${brandPrimaryDark};color:${brandBgDark}`}
              >
                Primary
              </span>
              <span
                class="inline-flex rounded-full border px-4 py-2 text-sm font-medium"
                data-brand-preview-accent="dark"
                style={`border-color:${brandAccentDark};color:${brandAccentDark}`}
              >
                Accent
              </span>
            </div>
          </div>
        </div>

        <div class="border-t border-sage-dark/10 pt-6">
          <button
            type="submit"
            class="inline-flex rounded-full bg-charcoal px-4 py-2 text-sm font-semibold text-white transition hover:bg-charcoal/90"
          >
            Save branding
          </button>
          <p class="mt-3 hidden text-sm text-sage-dark/70" data-brand-status></p>
          <p class="mt-3 hidden text-sm text-red-700" data-brand-error></p>
        </div>
      </form>
    </section>

    <section class="hidden" data-admin-panel="roles" id="roles">
      <button
        type="button"
        class="inline-flex items-center gap-1 rounded-full border border-sage-dark/20 px-3 py-1.5 text-sm font-semibold text-sage-dark transition hover:border-sage-dark/35 hover:bg-sage/10"
        data-admin-back
      >
        <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M10 3L5 8l5 5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        Back
      </button>
      <PanelHeading
        id="roles-heading"
        title="Roles and permissions"
        description="A plain-language guide to what each role can and cannot do."
      />

      <div class="mt-6 space-y-3">
        {
          roles.map((role) => {
            const guide = plainRole(role.key);
            return (
              <article class="overflow-hidden rounded-2xl border border-sage-dark/10 bg-white/90 p-5 shadow-sm">
                <h3 class="text-lg font-semibold tracking-tight text-charcoal">{role.name}</h3>
                <p class="mt-2 text-sm text-sage-dark/75">
                  {guide?.summary ?? role.description}
                </p>

                {
                  guide ? (
                    <div class="mt-4 grid gap-4 sm:grid-cols-2">
                      <div>
                        <p class="text-xs font-semibold uppercase tracking-[0.14em] text-[#2CA01C]">Can</p>
                        <ul class="mt-2 space-y-1.5 text-sm text-charcoal">
                          {guide.can.map((item) => (
                            <li class="flex gap-2">
                              <span class="text-[#2CA01C]" aria-hidden="true">
                                •
                              </span>
                              <span>{item}</span>
                            </li>
                          ))}
                        </ul>
                      </div>
                      {guide.cannot && guide.cannot.length > 0 ? (
                        <div>
                          <p class="text-xs font-semibold uppercase tracking-[0.14em] text-sage-dark/50">Cannot</p>
                          <ul class="mt-2 space-y-1.5 text-sm text-sage-dark/75">
                            {guide.cannot.map((item) => (
                              <li class="flex gap-2">
                                <span class="text-sage-dark/40" aria-hidden="true">
                                  •
                                </span>
                                <span>{item}</span>
                              </li>
                            ))}
                          </ul>
                        </div>
                      ) : null}
                    </div>
                  ) : null
                }

                <details class="mt-5">
                  <summary class="cursor-pointer text-sm font-medium text-sage-dark/70 hover:text-charcoal">
                    Technical permission list
                  </summary>
                  {role.permissions.length === 0 ? (
                    <p class="mt-3 text-sm text-sage-dark/55">No permissions assigned.</p>
                  ) : (
                    <ul class="mt-3 grid gap-2 sm:grid-cols-2">
                      {role.permissions.map((permission) => (
                        <li class="rounded-xl bg-[#f4f5f8] px-3 py-2 text-sm text-charcoal">
                          {plainPermission(permission.key, permission.description)}
                        </li>
                      ))}
                    </ul>
                  )}
                </details>
              </article>
            );
          })
        }
      </div>
    </section>
  </div>
</PortalLayout>

<script>
  function setupAdminNav(shell: Element) {
    if (!(shell instanceof HTMLElement)) return;
    const menu = shell.querySelector('[data-admin-menu]');
    const header = shell.querySelector('[data-admin-header]');
    const panels = Array.from(shell.querySelectorAll('[data-admin-panel]')).filter(
      (node): node is HTMLElement => node instanceof HTMLElement,
    );

    const hashForPanel: Record<string, string> = {
      'time-off': '#time-off-requests',
      timesheet: '#timesheet-backlog',
      hours: '#hours',
      announcements: '#announcement-history',
      people: '#people',
      tasks: '#tasks',
      'work-items': '#work-items',
      credentialing: '#credentialing',
      branding: '#branding',
      roles: '#roles',
    };

    const panelFromHash = (hash: string): string | null => {
      if (hash === 'time-off-requests' || hash === 'time-off') return 'time-off';
      if (hash === 'timesheet-backlog' || hash === 'timesheet') return 'timesheet';
      if (hash === 'hours' || hash === 'hours-admin' || hash === 'employee-hours') return 'hours';
      if (hash === 'announcement-history' || hash === 'post-announcement' || hash === 'announcements') {
        return 'announcements';
      }
      if (hash === 'people') return 'people';
      if (hash === 'tasks') return 'tasks';
      if (hash === 'work-items' || hash === 'work-items-admin') return 'work-items';
      if (hash === 'credentialing' || hash === 'credentialing-admin') return 'credentialing';
      if (hash === 'branding' || hash === 'favicon') return 'branding';
      if (hash === 'roles' || hash === 'roles-heading') return 'roles';
      return null;
    };

    const showMenu = () => {
      if (header instanceof HTMLElement) header.classList.remove('hidden');
      if (menu instanceof HTMLElement) menu.classList.remove('hidden');
      panels.forEach((panel) => panel.classList.add('hidden'));
      if (window.location.hash) {
        history.replaceState(null, '', window.location.pathname + window.location.search);
      }
    };

    const showPanel = (id: string, updateHash = true) => {
      if (header instanceof HTMLElement) header.classList.add('hidden');
      if (menu instanceof HTMLElement) menu.classList.add('hidden');
      panels.forEach((panel) => {
        panel.classList.toggle('hidden', panel.dataset.adminPanel !== id);
      });
      if (updateHash) {
        const hash = hashForPanel[id] ?? `#${id}`;
        history.replaceState(null, '', `${window.location.pathname}${window.location.search}${hash}`);
      }
    };

    shell.querySelectorAll('[data-admin-open]').forEach((node) => {
      if (!(node instanceof HTMLButtonElement)) return;
      node.addEventListener('click', () => {
        const id = node.dataset.adminOpen;
        if (id) showPanel(id);
      });
    });

    shell.querySelectorAll('[data-admin-back]').forEach((node) => {
      node.addEventListener('click', () => showMenu());
    });

    const params = new URLSearchParams(window.location.search);
    if (params.has('timeOffError')) {
      showPanel('time-off', false);
      return;
    }
    if (params.has('timesheetError')) {
      showPanel('timesheet', false);
      return;
    }
    if (params.get('adminPanel') === 'hours' || params.has('hoursUser')) {
      showPanel('hours', false);
      return;
    }
    if (params.has('peopleError') || params.has('inviteUrl') || params.has('peopleSaved')) {
      showPanel('people', false);
      return;
    }
    if (params.has('credentialingError') || params.has('credentialingSaved')) {
      showPanel('credentialing', false);
      return;
    }
    if (params.has('tasksError') || params.has('tasksSaved')) {
      showPanel('tasks', false);
      return;
    }
    if (params.has('workCategoriesError') || params.has('workCategoriesSaved')) {
      showPanel('work-items', false);
      return;
    }
    if (params.has('error') || params.has('announcementSaved')) {
      showPanel('announcements', false);
      return;
    }

    const hash = window.location.hash.replace(/^#/, '');
    const fromHash = panelFromHash(hash);
    if (fromHash) showPanel(fromHash, false);
  }

  document.querySelectorAll('[data-admin-shell]').forEach((root) => setupAdminNav(root));

  const brandingForm = document.getElementById('org-branding-form');
  if (brandingForm instanceof HTMLFormElement) {
    const statusEl = brandingForm.querySelector('[data-brand-status]');
    const errorEl = brandingForm.querySelector('[data-brand-error]');
    const colorKeys = [
      'bgColorLight',
      'primaryColorLight',
      'accentColorLight',
      'bgColorDark',
      'primaryColorDark',
      'accentColorDark',
    ];

    const syncPair = (key: string, fromColor: boolean) => {
      const colorInput = brandingForm.querySelector(`[data-brand-color="${key}"]`);
      const hexInput = brandingForm.querySelector(`[data-brand-hex="${key}"]`);
      if (!(colorInput instanceof HTMLInputElement) || !(hexInput instanceof HTMLInputElement)) return;
      if (fromColor) {
        hexInput.value = colorInput.value.toUpperCase();
      } else {
        const raw = hexInput.value.trim();
        const next = raw.startsWith('#') ? raw : `#${raw}`;
        if (/^#[0-9A-Fa-f]{6}$/.test(next)) {
          colorInput.value = next;
          hexInput.value = next.toUpperCase();
        }
      }
      const value = colorInput.value;
      const mode = key.endsWith('Dark') ? 'dark' : 'light';
      const role = key.startsWith('bg') ? 'bg' : key.startsWith('primary') ? 'primary' : 'accent';
      const preview = brandingForm.querySelector(`[data-brand-preview="${mode}"]`);
      const previewPrimary = brandingForm.querySelector(`[data-brand-preview-primary="${mode}"]`);
      const previewAccent = brandingForm.querySelector(`[data-brand-preview-accent="${mode}"]`);
      if (role === 'bg' && preview instanceof HTMLElement) {
        preview.style.background = value;
        if (mode === 'dark' && previewPrimary instanceof HTMLElement) {
          previewPrimary.style.color = value;
        }
      }
      if (role === 'primary' && previewPrimary instanceof HTMLElement) {
        previewPrimary.style.background = value;
      }
      if (role === 'accent' && previewAccent instanceof HTMLElement) {
        previewAccent.style.borderColor = value;
        previewAccent.style.color = value;
      }
    };

    colorKeys.forEach((key) => {
      const colorInput = brandingForm.querySelector(`[data-brand-color="${key}"]`);
      const hexInput = brandingForm.querySelector(`[data-brand-hex="${key}"]`);
      colorInput?.addEventListener('input', () => syncPair(key, true));
      hexInput?.addEventListener('change', () => syncPair(key, false));
    });

    brandingForm.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (statusEl instanceof HTMLElement) {
        statusEl.classList.add('hidden');
        statusEl.textContent = '';
      }
      if (errorEl instanceof HTMLElement) {
        errorEl.classList.add('hidden');
        errorEl.textContent = '';
      }
      colorKeys.forEach((key) => syncPair(key, false));
      try {
        const res = await fetch('/api/org/branding', {
          method: 'POST',
          body: new FormData(brandingForm),
          headers: { Accept: 'application/json' },
        });
        const json = (await res.json().catch(() => ({}))) as {
          error?: string;
          branding?: { hasLogo?: boolean; logoUrl?: string | null; hasFavicon?: boolean; faviconUrl?: string | null };
        };
        if (!res.ok) throw new Error(json.error || 'Could not save branding.');
        if (statusEl instanceof HTMLElement) {
          statusEl.textContent = 'Branding saved. Refresh if colors or logos do not update everywhere.';
          statusEl.classList.remove('hidden');
        }
        const branding = json.branding;
        if (branding?.logoUrl) {
          const logoPreview = brandingForm.querySelector('[data-brand-logo-preview]');
          if (logoPreview instanceof HTMLImageElement) logoPreview.src = branding.logoUrl;
        }
        if (branding?.faviconUrl) {
          const faviconPreview = brandingForm.querySelector('[data-brand-favicon-preview]');
          if (faviconPreview instanceof HTMLImageElement) faviconPreview.src = branding.faviconUrl;
        }
      } catch (error) {
        if (errorEl instanceof HTMLElement) {
          errorEl.textContent = error instanceof Error ? error.message : 'Could not save branding.';
          errorEl.classList.remove('hidden');
        }
      }
    });
  }
</script>
