---

<PortalLayout title="Admin" flush>
  <div class="flex min-h-0 flex-1" data-admin-shell>
    <aside
      class="flex w-[min(100%,288px)] shrink-0 flex-col overflow-hidden border-r border-sage-dark/10 bg-white/95 transition-[width] duration-200 ease-out sm:w-72 data-[collapsed=true]:w-14 data-[collapsed=true]:overflow-visible"
      data-admin-menu
      aria-label="Admin sections"
    >
      <div
        class="min-h-0 flex-1 overflow-y-auto px-2 py-3"
        id="admin-menu-nav"
        data-admin-menu-body
      >
        {
          adminNav.map((section) => (
            <div class="mb-4 last:mb-1">
              <p class="px-2.5 pb-1.5 pt-2 text-[11px] font-semibold uppercase tracking-[0.14em] text-sage-dark/45">
                {section.label}
              </p>
              <div class="space-y-0.5">
                {section.groups.map((group) => (
                  <details class="group" data-admin-group={group.id}>
                    <summary class="item-selected-hover flex cursor-pointer list-none items-center justify-between gap-2 rounded-xl px-2.5 py-2 text-[15px] font-medium text-charcoal transition [&::-webkit-details-marker]:hidden">
                      <span>{group.label}</span>
                      <span class="text-sage-dark/40" set:html={menuChevron} />
                    </summary>
                    <div class="mt-0.5 space-y-0.5 pb-1 pl-0.5">
                      {group.items.map((item) => {
                        const badge =
                          item.badge && item.badge > 0 ? (
                            <span
                              class:list={[
                                'inline-flex h-5 min-w-5 items-center justify-center rounded-full px-1.5 text-[11px] font-semibold leading-none text-white',
                                item.badgeTone === 'amber' ? 'bg-amber-500' : 'bg-red-600',
                              ]}
                            >
                              {item.badge > 9 ? '9+' : item.badge}
                            </span>
                          ) : null;
                        const body = (
                          <>
                            <span
                              class="item-selected-chip mt-0.5 inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-lg text-sage-dark"
                              data-admin-icon
                              set:html={item.icon}
                            />
                            <span class="min-w-0 flex-1">
                              <span class="flex items-center gap-2">
                                <span class="block text-sm font-semibold text-charcoal">{item.label}</span>
                                {badge}
                              </span>
                              <span class="mt-0.5 block text-xs leading-snug text-sage-dark/55">
                                {item.description}
                              </span>
                            </span>
                          </>
                        );
                        if (item.href) {
                          return (
                            <a
                              href={item.href}
                              class="item-selected-hover flex w-full items-start gap-2.5 rounded-xl px-2.5 py-2 text-left transition"
                            >
                              {body}
                            </a>
                          );
                        }
                        return (
                          <button
                            type="button"
                            class="item-selected item-selected-hover flex w-full items-start gap-2.5 rounded-xl px-2.5 py-2 text-left transition"
                            data-admin-open={item.id}
                            data-admin-group-id={group.id}
                          >
                            {body}
                          </button>
                        );
                      })}
                    </div>
                  </details>
                ))}
              </div>
            </div>
          ))
        }
      </div>

      <div
        class="hidden min-h-0 flex-1 flex-col items-center gap-1 overflow-y-auto px-1.5 py-3"
        data-admin-menu-icons
        aria-label="Admin shortcuts"
        aria-hidden="true"
      >
        {
          adminCollapsedItems.map((item) => {
            const badgeDot =
              item.badge && item.badge > 0 ? (
                <span
                  class:list={[
                    'absolute -right-0.5 -top-0.5 h-2 w-2 rounded-full ring-2 ring-white',
                    item.badgeTone === 'amber' ? 'bg-amber-500' : 'bg-red-600',
                  ]}
                />
              ) : null;
            if (item.href) {
              return (
                <a
                  href={item.href}
                  class="item-selected-hover relative inline-flex h-10 w-10 items-center justify-center rounded-lg text-sage-dark transition"
                  aria-label={item.label}
                  data-admin-tip={item.label}
                >
                  <span class="inline-flex" set:html={item.icon} />
                  {badgeDot}
                </a>
              );
            }
            return (
              <button
                type="button"
                class="item-selected item-selected-hover relative inline-flex h-10 w-10 items-center justify-center rounded-lg text-sage-dark transition"
                aria-label={item.label}
                data-admin-tip={item.label}
                data-admin-open={item.id}
                data-admin-group-id={item.groupId}
              >
                <span class="inline-flex" set:html={item.icon} />
                {badgeDot}
              </button>
            );
          })
        }
      </div>

      <div class="mt-auto flex shrink-0 items-center justify-end border-t border-sage-dark/10 px-1.5 py-1.5">
        <button
          type="button"
          class="item-selected-hover inline-flex h-8 w-8 items-center justify-center rounded-lg text-sage-dark/70 transition hover:text-charcoal"
          data-admin-menu-toggle
          aria-expanded="true"
          aria-controls="admin-menu-nav"
          title="Collapse menu"
        >
          <svg
            width="16"
            height="16"
            viewBox="0 0 16 16"
            fill="none"
            aria-hidden="true"
            data-admin-menu-toggle-icon
          >
            <path
              d="M10 3 5 8l5 5"
              stroke="currentColor"
              stroke-width="1.75"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
          <span class="sr-only" data-admin-menu-toggle-label>Collapse menu</span>
        </button>
      </div>
    </aside>

    <div class="min-h-0 min-w-0 flex-1 overflow-y-auto px-5 py-8 sm:px-8" data-admin-content>
      <div class="mx-auto w-full max-w-6xl">
        <div
          class="rounded-2xl border border-dashed border-sage-dark/20 bg-surface px-6 py-16 text-center"
          data-admin-empty
        >
          <p class="font-display text-2xl text-charcoal">Choose a section</p>
          <p class="mx-auto mt-2 max-w-md text-sm text-sage-dark/65">
            Open a category on the left, then pick an item to manage it here without leaving Admin.
          </p>
        </div>

    <section class="hidden" data-admin-panel="time-off">
      <PanelHeading
        title="Time off requests"
        description="Review pending requests. Approved requests stay here until the last requested date has passed."
      />
      <TimeOffManager requests={timeOffRequests} error={timeOffError} embedded />
    </section>

    <section class="hidden" data-admin-panel="timesheet">
      <PanelHeading
        title="Timesheet requests"
        description="Review backlog hours and requested shift time changes. Clear approved requests once handled — hours stay on the employee timesheet."
      />
      <TimesheetBacklogManager requests={timesheetBacklogRequests} error={timesheetError} embedded />
      <TimesheetShiftEditManager requests={timesheetShiftEditRequests} embedded />
    </section>

    <section class="hidden" data-admin-panel="hours">
      <PanelHeading
        title="Employee hours"
        description="Pick a teammate to review their logged hours, work item chart, and completed shifts for a timeframe."
      />
      <TimesheetStatsViewer employees={employees} />
    </section>

    <section class="hidden" data-admin-panel="announcements">
      <PanelHeading
        title="Announcements"
        description="Post to every dashboard, then edit, resend, or remove from the history log."
      />
      <AnnouncementManager
        announcements={announcements}
        error={error}
        savedId={announcementSaved}
        embedded
      />
    </section>

    <section class="hidden" data-admin-panel="bulletin-board">
      {
        bulletinPayload && bulletinSettings ? (
          <BulletinBoardManager
            payload={bulletinPayload}
            pendingCount={pendingBulletinRequests}
            hasUnpublishedChanges={bulletinHasUnpublishedChanges}
            draftSurface={bulletinSettings.draftSurface}
            embedded
          />
        ) : (
          <p class="rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800">
            Bulletin board is temporarily unavailable.
          </p>
        )
      }
    </section>

    <section class="hidden" data-admin-panel="people">
      <PanelHeading
        title="People"
        description="Invite people, set job titles and teams, and assign roles."
      />
      <PeopleManager
        error={peopleError}
        inviteUrl={inviteUrl}
        savedAction={peopleSaved}
        savedUserId={peopleUser}
        embedded
      />
    </section>

    <section class="hidden" data-admin-panel="tasks">
      <PanelHeading
        title="Tasks"
        description="Assign tasks to team members. They appear in each person's Tasks widget on Home."
      />
      <TasksManager
        tasks={assignedTasks}
        employees={employees}
        error={tasksError}
        saved={tasksSaved === '1'}
        embedded
      />
    </section>

    <section class="hidden" data-admin-panel="credentialing">
      <PanelHeading
        title="Credentialing"
        description="Directory clinicians appear automatically. Assign insurance networks per provider and manage the catalog."
      />
      <CredentialingManager
        providers={credentialingProviders}
        catalog={insuranceCatalog}
        coverageMap={coverageMap}
        groupCoverageMap={groupCoverageMap}
        error={credentialingError}
        embedded
      />
    </section>

    <section class="hidden" data-admin-panel="work-items">
      <PanelHeading
        title="Work items"
        description="Customize the categories employees tag on completed shifts. Names and colors appear on the timesheet and work breakdown chart."
      />
      <WorkItemsManager
        categories={workCategories}
        error={workCategoriesError}
        saved={workCategoriesSaved === '1'}
        embedded
      />
    </section>

    <section class="hidden" data-admin-panel="training">
      <PanelHeading
        title="Training"
        description="Use the three columns: pick a module, choose what’s inside it, then edit on the right. For videos, upload an unlisted YouTube video and paste the link."
      />
      <TrainingManager
        modules={trainingModules}
        selectedModuleId={trainingSelectedId}
        selectedItemId={trainingSelectedItemId}
        selectedView={trainingSelectedView}
        assignments={trainingAssignments}
        lessons={trainingLessons}
        blocksByItem={trainingBlocksByItem}
        roles={roles.map((role) => ({ key: role.key, name: role.name }))}
        roster={trainingRoster}
        traineeReview={trainingTraineeReview}
        docusignConnected={docusignConnected}
        docusignTemplates={docusignTemplates}
        docusignStatuses={docusignStatuses}
        error={trainingError}
        embedded
      />
    </section>

    <section class="hidden" data-admin-panel="quick-links">
      <PanelHeading
        title="Quick links"
        description="Choose tools from the catalog (EHR, banking, and more) or add a custom URL. Nothing appears for your team until you add at least one link."
      />
      <QuickLinksManager
        links={quickLinks}
        categories={quickLinkCategories}
        roles={roles.map((role) => ({ key: role.key, name: role.name }))}
        error={quickLinksError}
        saved={quickLinksSaved}
        embedded
      />
    </section>

    <section class="hidden" data-admin-panel="integrations">
      <PanelHeading
        title="Integrations"
        description="Connect your organization’s DocuSign and QuickBooks accounts. Employees keep Google Calendar under Settings."
      />
      {
        integrationsError ? (
          <p class="mt-4 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800">
            {integrationsError}
          </p>
        ) : null
      }
      {
        integrationsSaved ? (
          <p class="item-selected-fill item-selected-text mt-4 rounded-xl border px-4 py-3 text-sm">
            {integrationsSaved === 'docusign-disconnected'
              ? 'DocuSign disconnected.'
              : integrationsSaved === 'docusign-settings'
                ? 'DocuSign keys saved. You can connect now.'
                : integrationsSaved === 'docusign'
                  ? 'DocuSign connected.'
                  : integrationsSaved === 'quickbooks-settings'
                    ? 'QuickBooks keys saved. You can connect now.'
                    : integrationsSaved === 'quickbooks'
                      ? 'QuickBooks connected.'
                      : integrationsSaved === 'quickbooks-disconnected'
                        ? 'QuickBooks disconnected.'
                        : 'Saved.'}
          </p>
        ) : null
      }

      <div class="mt-6 space-y-4">
        <details
          class="group rounded-2xl border border-sage-dark/10 bg-white shadow-sm open:pb-5"
          open={
            docusignStatus.status !== 'connected' ||
            Boolean(integrationsError) ||
            integrationsSaved === 'docusign' ||
            integrationsSaved === 'docusign-settings' ||
            integrationsSaved === 'docusign-disconnected'
              ? true
              : undefined
          }
        >
          <summary class="flex cursor-pointer list-none items-start justify-between gap-3 p-5 [&::-webkit-details-marker]:hidden">
            <div class="min-w-0">
              <div class="flex flex-wrap items-center gap-2">
                <h3 class="text-lg font-semibold text-charcoal">DocuSign</h3>
                <span
                  class:list={[
                    'rounded-full px-2.5 py-1 text-[11px] font-semibold uppercase tracking-wide',
                    docusignStatus.status === 'connected'
                      ? 'bg-emerald-100 text-emerald-900'
                      : docusignStatus.status === 'error'
                        ? 'bg-red-100 text-red-800'
                        : 'bg-[#f0f1f4] text-sage-dark/70',
                  ]}
                >
                  {docusignStatus.status}
                </span>
              </div>
              <p class="mt-1 text-sm text-sage-dark/70">
                Connect your company DocuSign so employees can sign contracts and policies inside training.
                Signed files stay in your DocuSign account.
              </p>
              {
                docusignStatus.accountEmail || docusignStatus.accountName ? (
                  <p class="mt-2 text-sm text-charcoal">
                    Connected as {docusignStatus.accountName}
                    {docusignStatus.accountEmail ? ` · ${docusignStatus.accountEmail}` : ''}
                  </p>
                ) : null
              }
            </div>
            <span
              class="mt-1 shrink-0 text-sage-dark/40 transition group-open:rotate-90"
              aria-hidden="true"
              set:html={menuChevron}
            />
          </summary>

          <div class="border-t border-sage-dark/10 px-5 pt-4">
          {
            docusignStatus.lastError ? (
              <p class="mb-3 text-sm text-red-700">{docusignStatus.lastError}</p>
            ) : null
          }

          <ol class="space-y-3 text-sm text-sage-dark/80">
            <li class="rounded-xl bg-[#f7f8fa]">
              <details class="group/step">
                <summary class="flex cursor-pointer list-none items-center justify-between gap-3 px-3 py-3 [&::-webkit-details-marker]:hidden">
                  <span class="min-w-0">
                    <span class="block font-semibold text-charcoal">1. Create a DocuSign app</span>
                    <span class="mt-0.5 block text-xs font-normal text-sage-dark/65">
                      Create an app at developers.docusign.com.
                    </span>
                  </span>
                  <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true" class="shrink-0 text-sage-dark/40 transition group-open/step:rotate-180">
                    <path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </summary>
                <div class="border-t border-sage-dark/10 px-3 pb-3 pt-3">
                  <ol class="list-decimal space-y-1 pl-5">
                    <li>
                      Go to
                      <a
                        class="font-medium text-sage-dark underline underline-offset-2"
                        href="https://developers.docusign.com/"
                        target="_blank"
                        rel="noreferrer"
                      >
                        developers.docusign.com
                      </a>
                      and sign in with your organization’s account.
                    </li>
                    <li>
                      Click the profile icon, then click
                      <span class="font-medium text-charcoal">My Apps &amp; Keys</span>.
                    </li>
                    <li>
                      Click <span class="font-medium text-charcoal">Add App and Integration Key</span>.
                    </li>
                    <li>
                      Add the name of this integration (we recommend
                      <span class="font-medium text-charcoal">Coordity</span>).
                    </li>
                  </ol>
                </div>
              </details>
            </li>
            <li class="rounded-xl bg-[#f7f8fa]">
              <details class="group/step">
                <summary class="flex cursor-pointer list-none items-center justify-between gap-3 px-3 py-3 [&::-webkit-details-marker]:hidden">
