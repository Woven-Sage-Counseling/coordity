      <TimesheetBacklogManager requests={timesheetBacklogRequests} error={timesheetError} embedded />
      <TimesheetShiftEditManager requests={timesheetShiftEditRequests} embedded />
    </section>

    <section class="hidden" data-admin-panel="hours">
      <PanelHeading
        title="Employee hours"
        description="Pick a teammate to review their logged hours, work item chart, and completed shifts for a timeframe."
      />
      <TimesheetStatsViewer employees={employees} />
    </section>

    <section class="hidden" data-admin-panel="announcements">
      <PanelHeading
        title="Announcements"
        description="Post to every dashboard, then edit, resend, or remove from the history log."
      />
      <AnnouncementManager
        announcements={announcements}
        error={error}
        savedId={announcementSaved}
        embedded
      />
    </section>

    <section class="hidden" data-admin-panel="people">
      <PanelHeading
        title="People"
        description="Invite people, set job titles and teams, and assign roles."
      />
      <PeopleManager
        error={peopleError}
        inviteUrl={inviteUrl}
        savedAction={peopleSaved}
        savedUserId={peopleUser}
        embedded
      />
    </section>

    <section class="hidden" data-admin-panel="tasks">
      <PanelHeading
        title="Tasks"
        description="Assign tasks to team members. They appear in each person's Tasks widget on Home."
      />
      <TasksManager
        tasks={assignedTasks}
        employees={employees}
        error={tasksError}
        saved={tasksSaved === '1'}
        embedded
      />
    </section>

    <section class="hidden" data-admin-panel="credentialing">
      <PanelHeading
        title="Credentialing"
        description="Directory clinicians appear automatically. Assign insurance networks per provider and manage the catalog."
      />
      <CredentialingManager
        providers={credentialingProviders}
        catalog={insuranceCatalog}
        coverageMap={coverageMap}
        groupCoverageMap={groupCoverageMap}
        error={credentialingError}
        embedded
      />
    </section>

    <section class="hidden" data-admin-panel="work-items">
      <PanelHeading
        title="Work items"
        description="Customize the categories employees tag on completed shifts. Names and colors appear on the timesheet and work breakdown chart."
      />
      <WorkItemsManager
        categories={workCategories}
        error={workCategoriesError}
        saved={workCategoriesSaved === '1'}
        embedded
      />
    </section>

    <section class="hidden" data-admin-panel="training">
      <PanelHeading
        title="Training"
        description="Use the three columns: pick a module, choose what’s inside it, then edit on the right. For videos, upload an unlisted YouTube video and paste the link."
      />
      <TrainingManager
        modules={trainingModules}
        selectedModuleId={trainingSelectedId}
        selectedItemId={trainingSelectedItemId}
        selectedView={trainingSelectedView}
        assignments={trainingAssignments}
        lessons={trainingLessons}
        blocksByItem={trainingBlocksByItem}
        roles={roles.map((role) => ({ key: role.key, name: role.name }))}
        roster={trainingRoster}
        traineeReview={trainingTraineeReview}
        docusignConnected={docusignConnected}
        docusignTemplates={docusignTemplates}
        docusignStatuses={docusignStatuses}
        error={trainingError}
        embedded
      />
    </section>

    <section class="hidden" data-admin-panel="quick-links">
      <PanelHeading
        title="Quick links"
        description="Choose tools from the catalog (EHR, banking, and more) or add a custom URL. Nothing appears for your team until you add at least one link."
      />
      <QuickLinksManager
        links={quickLinks}
        categories={quickLinkCategories}
        roles={roles.map((role) => ({ key: role.key, name: role.name }))}
        error={quickLinksError}
        saved={quickLinksSaved}
        embedded
      />
    </section>

    <section class="hidden" data-admin-panel="integrations">
      <PanelHeading
        title="Integrations"
        description="Connect your organization’s DocuSign and QuickBooks accounts. Employees keep Google Calendar under Settings."
      />
      {
        integrationsError ? (
          <p class="mt-4 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800">
            {integrationsError}
          </p>
        ) : null
      }
      {
        integrationsSaved ? (
          <p class="mt-4 rounded-xl border border-sage-dark/15 bg-sage/10 px-4 py-3 text-sm text-sage-dark">
            {integrationsSaved === 'docusign-disconnected'
              ? 'DocuSign disconnected.'
              : integrationsSaved === 'docusign-settings'
                ? 'DocuSign keys saved. You can connect now.'
                : integrationsSaved === 'docusign'
                  ? 'DocuSign connected.'
                  : integrationsSaved === 'quickbooks-settings'
                    ? 'QuickBooks keys saved. You can connect now.'
                    : integrationsSaved === 'quickbooks'
                      ? 'QuickBooks connected.'
                      : 'Saved.'}
          </p>
        ) : null
      }

      <div class="mt-6 space-y-4">
        <details
          class="group rounded-2xl border border-sage-dark/10 bg-white shadow-sm open:pb-5"
          open={
            docusignStatus.status !== 'connected' ||
            Boolean(integrationsError) ||
            integrationsSaved === 'docusign' ||
            integrationsSaved === 'docusign-settings' ||
            integrationsSaved === 'docusign-disconnected'
              ? true
              : undefined
          }
        >
          <summary class="flex cursor-pointer list-none items-start justify-between gap-3 p-5 [&::-webkit-details-marker]:hidden">
            <div class="min-w-0">
              <div class="flex flex-wrap items-center gap-2">
                <h3 class="text-lg font-semibold text-charcoal">DocuSign</h3>
                <span
                  class:list={[
                    'rounded-full px-2.5 py-1 text-[11px] font-semibold uppercase tracking-wide',
                    docusignStatus.status === 'connected'
                      ? 'bg-emerald-100 text-emerald-900'
                      : docusignStatus.status === 'error'
                        ? 'bg-red-100 text-red-800'
                        : 'bg-[#f0f1f4] text-sage-dark/70',
                  ]}
                >
                  {docusignStatus.status}
                </span>
              </div>
              <p class="mt-1 text-sm text-sage-dark/70">
                Connect your company DocuSign so employees can sign contracts and policies inside training.
                Signed files stay in your DocuSign account.
              </p>
              {
                docusignStatus.accountEmail || docusignStatus.accountName ? (
                  <p class="mt-2 text-sm text-charcoal">
                    Connected as {docusignStatus.accountName}
                    {docusignStatus.accountEmail ? ` · ${docusignStatus.accountEmail}` : ''}
                  </p>
                ) : null
              }
            </div>
            <span
              class="mt-1 shrink-0 text-sage-dark/40 transition group-open:rotate-90"
              aria-hidden="true"
              set:html={menuChevron}
            />
          </summary>

          <div class="border-t border-sage-dark/10 px-5 pt-4">
          {
            docusignStatus.lastError ? (
              <p class="mb-3 text-sm text-red-700">{docusignStatus.lastError}</p>
            ) : null
          }

          <ol class="space-y-3 text-sm text-sage-dark/80">
            <li class="rounded-xl bg-[#f7f8fa] px-3 py-3">
              <p class="font-semibold text-charcoal">1. Create an app in DocuSign Developer Console</p>
              <p class="mt-1">
                Open the Developer Console (go to
                <a
                  class="font-medium text-sage-dark underline underline-offset-2"
                  href="https://developers.docusign.com/"
                  target="_blank"
                  rel="noreferrer"
                >
                  developers.docusign.com
                </a>
                ) and sign in with your organization’s account.
              </p>
              <p class="mt-1.5">
                Then click <span class="font-medium text-charcoal">+ Add</span> next to API Integrations. Add the name
                of this integration (we recommend
                <span class="font-medium text-charcoal">“Coordity”</span>).
              </p>
            </li>
            <li class="rounded-xl bg-[#f7f8fa] px-3 py-3">
              <p class="font-semibold text-charcoal">2. Add the Redirect URI and Client Secret</p>
              <p class="mt-1">
                Scroll down to Additional Settings, click <span class="font-medium text-charcoal">+ Add</span> under
                Redirect URL, and add this Redirect URI on that app. Hit Save. Go to Authentication, then click
                <span class="font-medium text-charcoal">+ Add</span> under Client Secret.
              </p>
              <div class="mt-2 flex flex-wrap items-center gap-2">
                <code
                  id="docusign-redirect-uri"
                  class="block max-w-full flex-1 truncate rounded-lg bg-white px-2.5 py-2 text-xs text-charcoal ring-1 ring-sage-dark/10"
                >
                  {docusignRedirectUri}
                </code>
                <button
                  type="button"
                  class="rounded-full border border-sage-dark/20 px-3 py-1.5 text-xs font-semibold text-sage-dark hover:bg-white"
                  data-copy-text={docusignRedirectUri}
                >
                  Copy
                </button>
              </div>
            </li>
            <li class="rounded-xl bg-[#f7f8fa] px-3 py-3">
              <p class="font-semibold text-charcoal">3. Paste your keys here</p>
              <p class="mt-1 text-xs text-sage-dark/60">
                Copy the Client ID (and Client Secret) from Developer Console. For first-time setup, keep the
                environment on <span class="font-medium text-charcoal">Demo / developer</span>. Switch to Production
                only after DocuSign go-live.
              </p>
              <form method="post" action="/api/docusign/settings" class="mt-3 space-y-3">
                <label class="block text-xs font-medium text-charcoal">
                  Client ID
                  <input
                    class="field mt-1"
                    type="text"
                    name="integrationKey"
                    required
                    autocomplete="off"
                    placeholder="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
                    value={docusignStatus.hasOrgApp ? (docusignStatus.integrationKey ?? '') : ''}
                  />
                </label>
                <label class="block text-xs font-medium text-charcoal">
                  Client Secret
                  <input
                    class="field mt-1"
                    type="password"
                    name="secretKey"
                    autocomplete="new-password"
                    placeholder={
                      docusignStatus.hasOrgApp
                        ? 'Leave blank to keep the saved secret'
                        : 'Add a client secret in DocuSign, then paste it'
                    }
                    {...(!docusignStatus.hasOrgApp ? { required: true } : {})}
                  />
                </label>
                <label class="block text-xs font-medium text-charcoal">
                  DocuSign environment
                  <select class="field mt-1" name="authServer">
                    <option
                      value="demo"
                      selected={docusignStatus.authServer.includes('account-d.docusign.com')}
                    >
                      Demo / developer (start here)
                    </option>
                    <option
                      value="production"
                      selected={docusignStatus.authServer.includes('account.docusign.com') && !docusignStatus.authServer.includes('account-d')}
                    >
                      Production (after DocuSign go-live)
                    </option>
                  </select>
                </label>
                <button class="btn-primary !px-4 !py-2 text-sm" type="submit">
                  Save DocuSign keys
                </button>
              </form>
              {
                docusignStatus.hasOrgApp ? (
                  <p class="mt-2 text-xs text-emerald-800">Keys saved. Continue to step 4.</p>
                ) : docusignStatus.hasPlatformApp ? (
                  <p class="mt-2 text-xs text-sage-dark/60">
                    Optional: Coordity already has a platform DocuSign app, so you can skip to Connect — or save your
                    own keys above to use your company’s DocuSign app.
                  </p>
                ) : null
              }
            </li>
            <li class="rounded-xl bg-[#f7f8fa] px-3 py-3">
              <p class="font-semibold text-charcoal">4. Connect your DocuSign login</p>
              <p class="mt-1">
                Click Connect, sign in with the matching DocuSign account (developer account for Demo, production
                account after go-live), and allow access.
              </p>
              <div class="mt-3 flex flex-wrap gap-2">
                <form method="post" action="/api/docusign/connect">
                  <button
                    class="btn-primary !px-4 !py-2 text-sm"
                    type="submit"
                    disabled={!docusignStatus.configured}
                  >
                    {docusignConnected ? 'Reconnect DocuSign' : 'Connect DocuSign'}
                  </button>
                </form>
                {
                  docusignConnected ? (
                    <form method="post" action="/api/docusign/disconnect">
                      <button
                        class="rounded-full border border-red-200 px-4 py-2 text-sm font-semibold text-red-700"
                        type="submit"
                      >
                        Disconnect
                      </button>
                    </form>
                  ) : null
                }
              </div>
              {
                !docusignStatus.configured ? (
                  <p class="mt-2 text-xs text-amber-800">Save your Client ID and Client Secret in step 3 first.</p>
                ) : null
              }
            </li>
          </ol>
          </div>
        </details>

        <details
          class="group rounded-2xl border border-sage-dark/10 bg-white shadow-sm open:pb-5"
          open={
            qbStatus.status !== 'connected' ||
            Boolean(integrationsError) ||
            integrationsSaved === 'quickbooks' ||
            integrationsSaved === 'quickbooks-settings'
              ? true
              : undefined
          }
        >
          <summary class="flex cursor-pointer list-none items-start justify-between gap-3 p-5 [&::-webkit-details-marker]:hidden">
            <div class="min-w-0">
              <div class="flex flex-wrap items-center gap-2">
                <h3 class="text-lg font-semibold text-charcoal">QuickBooks</h3>
                <span
                  class:list={[
                    'rounded-full px-2.5 py-1 text-[11px] font-semibold uppercase tracking-wide',
                    qbStatus.status === 'connected'
                      ? 'bg-emerald-100 text-emerald-900'
                      : qbStatus.status === 'error'
                        ? 'bg-red-100 text-red-800'
                        : 'bg-[#f0f1f4] text-sage-dark/70',
                  ]}
                >
                  {qbStatus.status}
                </span>
              </div>
              <p class="mt-1 text-sm text-sage-dark/70">
                Connect QuickBooks Online so Financials can sync company books into Coordity.
              </p>
              {
                qbStatus.companyName || qbStatus.connectedEmail ? (
                  <p class="mt-2 text-sm text-charcoal">
                    Connected as {qbStatus.companyName || qbStatus.connectedEmail}
                    {qbStatus.companyName && qbStatus.connectedEmail ? ` · ${qbStatus.connectedEmail}` : ''}
                  </p>
                ) : null
              }
            </div>
            <span
              class="mt-1 shrink-0 text-sage-dark/40 transition group-open:rotate-90"
              aria-hidden="true"
              set:html={menuChevron}
            />
          </summary>

          <div class="border-t border-sage-dark/10 px-5 pt-4">
            {
              qbStatus.lastError ? (
                <p class="mb-3 text-sm text-red-700">{qbStatus.lastError}</p>
              ) : null
            }
            {
              !canManageQuickBooks ? (
                <p class="text-sm text-sage-dark/65">You need Financials manage permission to connect QuickBooks.</p>
              ) : (
                <ol class="space-y-3 text-sm text-sage-dark/80">
                  <li class="rounded-xl bg-[#f7f8fa] px-3 py-3">
                    <p class="font-semibold text-charcoal">1. Create a QuickBooks app (one-time)</p>
                    <p class="mt-1">
                      Go to
                      <a
                        class="font-medium text-sage-dark underline underline-offset-2"
                        href="https://developer.intuit.com/app/developer/dashboard"
                        target="_blank"
                        rel="noreferrer"
                      >
                        developer.intuit.com
                      </a>
                      . Click <span class="font-medium text-charcoal">App dashboard</span> under My Hub. Then click
                      the plus sign to create an app (we recommend naming it
                      <span class="font-medium text-charcoal">Coordity</span>). Under authorization scope, select both
                      options for accounting and payment. Click to open the app, go to
                      <span class="font-medium text-charcoal">Keys and credentials</span>, then click
                      <span class="font-medium text-charcoal">Show credentials</span> under Development.
                    </p>
                  </li>
                  <li class="rounded-xl bg-[#f7f8fa] px-3 py-3">
                    <p class="font-semibold text-charcoal">2. Paste your keys here</p>
                    <p class="mt-1 text-xs text-sage-dark/60">
                      Copy the Client ID and Client Secret from Development credentials. Keep the environment on
                      <span class="font-medium text-charcoal">Sandbox / development</span> first; switch to Production
                      keys when the Intuit app is live.
                    </p>
                    <form method="post" action="/api/quickbooks/settings" class="mt-3 space-y-3">
                      <label class="block text-xs font-medium text-charcoal">
                        Client ID
                        <input
                          class="field mt-1"
                          type="text"
                          name="clientId"
                          required
                          autocomplete="off"
                          placeholder="QuickBooks Client ID"
                          value={qbStatus.hasOrgApp ? (qbStatus.clientId ?? '') : ''}
                        />
                      </label>
                      <label class="block text-xs font-medium text-charcoal">
                        Client Secret
                        <input
                          class="field mt-1"
                          type="password"
                          name="clientSecret"
                          autocomplete="new-password"
                          placeholder={
                            qbStatus.hasOrgApp
                              ? 'Leave blank to keep the saved secret'
                              : 'Paste the Client Secret from Intuit'
                          }
                          {...(!qbStatus.hasOrgApp ? { required: true } : {})}
                        />
                      </label>
                      <label class="block text-xs font-medium text-charcoal">
                        QuickBooks environment
                        <select class="field mt-1" name="environment">
                          <option value="sandbox" selected={qbStatus.environment === 'sandbox'}>
                            Sandbox / development (start here)
                          </option>
                          <option value="production" selected={qbStatus.environment === 'production'}>
                            Production (after Intuit app go-live)
                          </option>
                        </select>
                      </label>
                      <button class="btn-primary !px-4 !py-2 text-sm" type="submit">
                        Save QuickBooks keys
                      </button>
                    </form>
                    {
                      qbStatus.hasOrgApp ? (
                        <p class="mt-2 text-xs text-emerald-800">Keys saved. Continue to step 3.</p>
                      ) : qbStatus.hasPlatformApp ? (
                        <p class="mt-2 text-xs text-sage-dark/60">
                          Optional: Coordity already has platform QuickBooks keys, so you can skip to Connect — or
                          save your own Intuit app keys above.
                        </p>
                      ) : null
                    }
                  </li>
                  <li class="rounded-xl bg-[#f7f8fa] px-3 py-3">
                    <p class="font-semibold text-charcoal">3. Add this Redirect URI</p>
                    <p class="mt-1">
                      Go to <span class="font-medium text-charcoal">Settings</span>, click
                      <span class="font-medium text-charcoal">Redirect URIs</span>, paste this URL, then click Save.
                    </p>
                    <div class="mt-2 flex flex-wrap items-center gap-2">
                      <code class="block max-w-full flex-1 truncate rounded-lg bg-white px-2.5 py-2 text-xs text-charcoal ring-1 ring-sage-dark/10">
                        {quickbooksRedirectUri}
                      </code>
                      <button
                        type="button"
                        class="rounded-full border border-sage-dark/20 px-3 py-1.5 text-xs font-semibold text-sage-dark hover:bg-white"
                        data-copy-text={quickbooksRedirectUri}
                      >
                        Copy
                      </button>
                    </div>
                  </li>
                  <li class="rounded-xl bg-[#f7f8fa] px-3 py-3">
                    <p class="font-semibold text-charcoal">4. Connect your QuickBooks company</p>
                    <p class="mt-1">
                      Click Connect, sign in to Intuit, and choose the company file Coordity should sync.
                    </p>
                    <div class="mt-3 flex flex-wrap gap-2">
                      <form method="post" action="/api/quickbooks/connect">
                        <button
                          class="btn-primary !px-4 !py-2 text-sm"
                          type="submit"
                          disabled={!qbStatus.configured}
                        >
                          {qbConnected ? 'Reconnect QuickBooks' : 'Connect QuickBooks'}
                        </button>
                      </form>
                      <a
                        href="/financials"
                        class="rounded-full border border-sage-dark/20 px-4 py-2 text-sm font-semibold text-sage-dark transition hover:bg-sage/10"
                      >
                        Open Financials
                      </a>
                    </div>
                    {
                      !qbStatus.configured ? (
                        <p class="mt-2 text-xs text-amber-800">
                          Save your Client ID and Client Secret in step 2 first.
                        </p>
                      ) : null
                    }
                  </li>
                </ol>
              )
            }
          </div>
        </details>

        <div class="rounded-2xl border border-sage-dark/10 bg-white p-5 shadow-sm">
          <h3 class="text-lg font-semibold text-charcoal">Google Calendar</h3>
          <p class="mt-1 text-sm text-sage-dark/70">
            Each person connects their own Google Calendar under Settings so schedules stay personal.
          </p>
          <a
            href="/settings"
            class="mt-4 inline-flex rounded-full border border-sage-dark/20 px-4 py-2 text-sm font-semibold text-sage-dark transition hover:bg-sage/10"
          >
            Open Settings
          </a>
        </div>
      </div>
    </section>

    <section class="hidden" data-admin-panel="branding">
      <PanelHeading
        title="Workspace branding"
        description="Customize how your portal looks — name, logos, tab icon, and colors used across buttons and accents."
      />
      <form
        id="org-branding-form"
        class="mt-6 space-y-8 rounded-2xl border border-sage-dark/10 bg-white/90 p-5 shadow-sm"
        enctype="multipart/form-data"
      >
        <div class="space-y-4">
          <h3 class="text-sm font-semibold text-charcoal">Workspace identity</h3>
          <label class="block text-sm font-medium text-charcoal">
            Display name
            <input class="field" type="text" name="displayName" required maxlength="80" value={brandDisplayName} />
          </label>
          <label class="block text-sm font-medium text-charcoal">
            Website
            <input
              class="field"
              type="url"
              name="websiteUrl"
              placeholder="https://example.com"
              value={brandWebsiteUrl}
            />
          </label>
        </div>

        <div class="space-y-4 border-t border-sage-dark/10 pt-6">
          <h3 class="text-sm font-semibold text-charcoal">Header &amp; sign-in logo</h3>
          <p class="text-sm text-sage-dark/65">
            Used in the portal header, sign-in page, and workspace finder. Transparent PNG works best. Max about 1.2MB.
          </p>
          <div class="flex items-center gap-4">
            <div class="flex h-16 min-w-[7rem] items-center justify-center overflow-hidden rounded-xl border border-sage-dark/15 bg-[#f4f5f8] px-3">
              {
                orgLogoPreview ? (
                  <img src={orgLogoPreview} alt="" class="max-h-12 w-auto max-w-[9rem] object-contain" data-brand-logo-preview />
                ) : (
                  <span class="text-[11px] text-sage-dark/45" data-brand-logo-empty>None</span>
                )
              }
            </div>
            <label class="min-w-0 flex-1 text-sm font-medium text-charcoal">
              Logo file
              <input
                class="mt-1.5 block w-full text-sm"
                type="file"
                name="logo"
                accept="image/png,image/jpeg,image/webp,image/gif,image/svg+xml"
              />
            </label>
          </div>
          {
            hasOrgLogo || organization?.logoUrl ? (
              <label class="flex items-center gap-2 text-sm text-sage-dark/80">
                <input type="checkbox" name="clearLogo" value="1" />
                Remove logo
              </label>
            ) : null
          }
          <label class="flex items-center gap-2 text-sm text-sage-dark/80">
            <input type="checkbox" name="invertLogoDark" value="1" checked={brandInvertLogoDark} />
            Invert logo in dark mode
          </label>
        </div>

        <div class="space-y-4 border-t border-sage-dark/10 pt-6">
          <h3 class="text-sm font-semibold text-charcoal">Favicon</h3>
          <p class="text-sm text-sage-dark/65">
            Browser tab icon. Square PNG or ICO works best. Max about 1.2MB.
          </p>
          <div class="flex items-center gap-4">
            <div class="flex h-14 w-14 items-center justify-center overflow-hidden rounded-xl border border-sage-dark/15 bg-[#f4f5f8]">
              {
                orgFaviconPreview ? (
                  <img src={orgFaviconPreview} alt="" class="h-10 w-10 object-contain" data-brand-favicon-preview />
                ) : (
                  <span class="text-[11px] text-sage-dark/45" data-brand-favicon-empty>None</span>
                )
              }
            </div>
            <label class="min-w-0 flex-1 text-sm font-medium text-charcoal">
              Favicon file
              <input
                class="mt-1.5 block w-full text-sm"
                type="file"
                name="favicon"
                accept="image/png,image/jpeg,image/webp,image/x-icon,image/vnd.microsoft.icon,image/svg+xml,.ico"
              />
            </label>
          </div>
          {
            hasOrgFavicon ? (
              <label class="flex items-center gap-2 text-sm text-sage-dark/80">
                <input type="checkbox" name="clearFavicon" value="1" />
                Remove custom favicon
              </label>
            ) : null
          }
        </div>

        <div class="space-y-4 border-t border-sage-dark/10 pt-6">
          <h3 class="text-sm font-semibold text-charcoal">Colors</h3>
          <p class="text-sm text-sage-dark/65">
            Set background, primary, and accent for light and dark mode. Primary drives buttons and
            strong text; accent is used for secondary highlights.
          </p>

          <div class="space-y-3 rounded-2xl border border-sage-dark/10 p-4">
            <h4 class="text-xs font-semibold uppercase tracking-wide text-sage-dark/55">Light mode</h4>
            <div class="grid gap-4 sm:grid-cols-3">
              <label class="block text-sm font-medium text-charcoal">
                Background
                <span class="mt-1.5 flex items-center gap-2">
                  <input
                    class="h-10 w-14 cursor-pointer rounded-lg border border-sage-dark/15 bg-white p-1"
                    type="color"
                    name="bgColorLight"
                    value={brandBgLight}
                    data-brand-color="bgColorLight"
                  />
                  <input
                    class="field mt-0"
                    type="text"
                    value={brandBgLight}
                    maxlength="7"
                    data-brand-hex="bgColorLight"
                    aria-label="Light background hex"
                  />
                </span>
              </label>
              <label class="block text-sm font-medium text-charcoal">
                Primary
                <span class="mt-1.5 flex items-center gap-2">
                  <input
                    class="h-10 w-14 cursor-pointer rounded-lg border border-sage-dark/15 bg-white p-1"
                    type="color"
                    name="primaryColorLight"
                    value={brandPrimaryLight}
                    data-brand-color="primaryColorLight"
                  />
                  <input
                    class="field mt-0"
                    type="text"
                    value={brandPrimaryLight}
                    maxlength="7"
                    data-brand-hex="primaryColorLight"
                    aria-label="Light primary hex"
                  />
                </span>
              </label>
              <label class="block text-sm font-medium text-charcoal">
                Accent
                <span class="mt-1.5 flex items-center gap-2">
                  <input
                    class="h-10 w-14 cursor-pointer rounded-lg border border-sage-dark/15 bg-white p-1"
                    type="color"
                    name="accentColorLight"
                    value={brandAccentLight}
                    data-brand-color="accentColorLight"
                  />
                  <input
                    class="field mt-0"
                    type="text"
                    value={brandAccentLight}
                    maxlength="7"
                    data-brand-hex="accentColorLight"
                    aria-label="Light accent hex"
                  />
                </span>
              </label>
            </div>
            <div
              class="flex flex-wrap items-center gap-3 rounded-xl border border-sage-dark/10 px-4 py-3"
              data-brand-preview="light"
              style={`background:${brandBgLight}`}
            >
              <span
                class="inline-flex rounded-full px-4 py-2 text-sm font-semibold text-white"
                data-brand-preview-primary="light"
                style={`background:${brandPrimaryLight}`}
              >
                Primary
              </span>
              <span
                class="inline-flex rounded-full border px-4 py-2 text-sm font-medium"
                data-brand-preview-accent="light"
                style={`border-color:${brandAccentLight};color:${brandAccentLight}`}
              >
                Accent
              </span>
            </div>
          </div>

          <div class="space-y-3 rounded-2xl border border-sage-dark/10 p-4">
            <h4 class="text-xs font-semibold uppercase tracking-wide text-sage-dark/55">Dark mode</h4>
            <div class="grid gap-4 sm:grid-cols-3">
              <label class="block text-sm font-medium text-charcoal">
                Background
                <span class="mt-1.5 flex items-center gap-2">
                  <input
                    class="h-10 w-14 cursor-pointer rounded-lg border border-sage-dark/15 bg-white p-1"
                    type="color"
                    name="bgColorDark"
                    value={brandBgDark}
                    data-brand-color="bgColorDark"
                  />
                  <input
                    class="field mt-0"
                    type="text"
                    value={brandBgDark}
                    maxlength="7"
                    data-brand-hex="bgColorDark"
                    aria-label="Dark background hex"
                  />
                </span>
              </label>
              <label class="block text-sm font-medium text-charcoal">
                Primary
                <span class="mt-1.5 flex items-center gap-2">
                  <input
                    class="h-10 w-14 cursor-pointer rounded-lg border border-sage-dark/15 bg-white p-1"
                    type="color"
                    name="primaryColorDark"
                    value={brandPrimaryDark}
                    data-brand-color="primaryColorDark"
                  />
                  <input
                    class="field mt-0"
                    type="text"
                    value={brandPrimaryDark}
                    maxlength="7"
                    data-brand-hex="primaryColorDark"
                    aria-label="Dark primary hex"
                  />
                </span>
              </label>
              <label class="block text-sm font-medium text-charcoal">
                Accent
                <span class="mt-1.5 flex items-center gap-2">
                  <input
                    class="h-10 w-14 cursor-pointer rounded-lg border border-sage-dark/15 bg-white p-1"
                    type="color"
                    name="accentColorDark"
                    value={brandAccentDark}
                    data-brand-color="accentColorDark"
                  />
                  <input
                    class="field mt-0"
                    type="text"
                    value={brandAccentDark}
                    maxlength="7"
                    data-brand-hex="accentColorDark"
                    aria-label="Dark accent hex"
                  />
                </span>
              </label>
            </div>
            <div
              class="flex flex-wrap items-center gap-3 rounded-xl border border-white/10 px-4 py-3"
              data-brand-preview="dark"
              style={`background:${brandBgDark}`}
            >
              <span
                class="inline-flex rounded-full px-4 py-2 text-sm font-semibold"
                data-brand-preview-primary="dark"
                style={`background:${brandPrimaryDark};color:${brandBgDark}`}
              >
                Primary
              </span>
              <span
                class="inline-flex rounded-full border px-4 py-2 text-sm font-medium"
                data-brand-preview-accent="dark"
                style={`border-color:${brandAccentDark};color:${brandAccentDark}`}
              >
                Accent
              </span>
            </div>
          </div>
        </div>

        <div class="border-t border-sage-dark/10 pt-6">
          <button
            type="submit"
            class="inline-flex rounded-full bg-charcoal px-4 py-2 text-sm font-semibold text-white transition hover:bg-charcoal/90"
          >
            Save branding
          </button>
          <p class="mt-3 hidden text-sm text-sage-dark/70" data-brand-status></p>
          <p class="mt-3 hidden text-sm text-red-700" data-brand-error></p>
        </div>
      </form>
    </section>

    <section class="hidden" data-admin-panel="roles" id="roles">
      <PanelHeading
        id="roles-heading"
        title="Roles and permissions"
        description="Manage who can do what. Default roles match the Woven Sage starter set. Custom roles appear in People, Training, and Quick links without changing existing assignments."
      />
      <RolesManager
        roles={roles.map((role) => ({
          ...role,
          isSystem: 'isSystem' in role ? Boolean((role as { isSystem?: boolean }).isSystem) : ['owner','owner_view','finance','manager','it','clinician','employee','intern'].includes(role.key),
        }))}
        error={rolesError}
        saved={rolesSaved}
        createdRoleName={roleCreated ? createdRoleName : null}
        createdRoleSurfaces={createdRoleSurfaces}
        embedded
      />
    </section>
      </div>
    </div>
  </div>
</PortalLayout>

<script>
  function setupAdminNav(shell: Element) {
    if (!(shell instanceof HTMLElement)) return;
    const empty = shell.querySelector('[data-admin-empty]');
    const panels = Array.from(shell.querySelectorAll('[data-admin-panel]')).filter(
      (node): node is HTMLElement => node instanceof HTMLElement,
    );
    const openButtons = Array.from(shell.querySelectorAll('[data-admin-open]')).filter(
      (node): node is HTMLButtonElement => node instanceof HTMLButtonElement,
    );

    const hashForPanel: Record<string, string> = {
      'time-off': '#time-off-requests',
      timesheet: '#timesheet-backlog',
      hours: '#hours',
      announcements: '#announcement-history',
      people: '#people',
      tasks: '#tasks',
      'work-items': '#work-items',
      training: '#training',
      'quick-links': '#quick-links',
      integrations: '#integrations',
      credentialing: '#credentialing',
      branding: '#branding',
      roles: '#roles',
    };

    const panelFromHash = (hash: string): string | null => {
      if (hash === 'time-off-requests' || hash === 'time-off') return 'time-off';
      if (hash === 'timesheet-backlog' || hash === 'timesheet') return 'timesheet';
      if (hash === 'hours' || hash === 'hours-admin' || hash === 'employee-hours') return 'hours';
      if (hash === 'announcement-history' || hash === 'post-announcement' || hash === 'announcements') {
        return 'announcements';
      }
      if (hash === 'people') return 'people';
      if (hash === 'tasks') return 'tasks';
      if (hash === 'work-items' || hash === 'work-items-admin') return 'work-items';
      if (hash === 'training' || hash === 'training-admin') return 'training';
      if (hash === 'quick-links' || hash === 'quick-links-heading') return 'quick-links';
      if (hash === 'integrations') return 'integrations';
      if (hash === 'credentialing' || hash === 'credentialing-admin') return 'credentialing';
      if (hash === 'branding' || hash === 'favicon') return 'branding';
      if (hash === 'roles' || hash === 'roles-heading') return 'roles';
      return null;
    };

    const setActiveButton = (id: string | null) => {
      openButtons.forEach((btn) => {
        const active = Boolean(id && btn.dataset.adminOpen === id);
        btn.dataset.active = active ? 'true' : 'false';
        if (active) btn.setAttribute('aria-current', 'page');
        else btn.removeAttribute('aria-current');
        if (active) {
          const groupId = btn.dataset.adminGroupId;
          if (groupId) {
            const group = shell.querySelector(`[data-admin-group="${groupId}"]`);
            if (group instanceof HTMLDetailsElement) group.open = true;
          }
        }
      });
    };

    const showEmpty = () => {
      if (empty instanceof HTMLElement) empty.classList.remove('hidden');
      panels.forEach((panel) => panel.classList.add('hidden'));
      setActiveButton(null);
      if (window.location.hash) {
        history.replaceState(null, '', window.location.pathname + window.location.search);
      }
    };

    const showPanel = (id: string, updateHash = true) => {
      if (empty instanceof HTMLElement) empty.classList.add('hidden');
      panels.forEach((panel) => {
        panel.classList.toggle('hidden', panel.dataset.adminPanel !== id);
      });
      setActiveButton(id);
      if (updateHash) {
        const hash = hashForPanel[id] ?? `#${id}`;
        history.replaceState(null, '', `${window.location.pathname}${window.location.search}${hash}`);
      }
    };

    openButtons.forEach((node) => {
      node.addEventListener('click', () => {
        const id = node.dataset.adminOpen;
        if (id) showPanel(id);
      });
    });

    const params = new URLSearchParams(window.location.search);
    if (params.has('timeOffError')) {
      showPanel('time-off', false);
      return;
    }
    if (params.has('timesheetError')) {
      showPanel('timesheet', false);
      return;
    }
    if (params.get('adminPanel') === 'hours' || params.has('hoursUser')) {
      showPanel('hours', false);
      return;
    }
    if (params.has('peopleError') || params.has('inviteUrl') || params.has('peopleSaved')) {
      showPanel('people', false);
      return;
    }
    if (params.has('credentialingError') || params.has('credentialingSaved')) {
      showPanel('credentialing', false);
      return;
    }
    if (params.has('tasksError') || params.has('tasksSaved')) {
      showPanel('tasks', false);
      return;
    }
    if (params.has('workCategoriesError') || params.has('workCategoriesSaved')) {
      showPanel('work-items', false);
      return;
    }
    if (params.has('trainingSaved') || params.has('trainingError') || params.has('module')) {
      showPanel('training', false);
      return;
    }
    if (params.has('quickLinksSaved') || params.has('quickLinksError')) {
      showPanel('quick-links', false);
      return;
    }
    if (params.has('rolesSaved') || params.has('rolesError') || params.has('roleCreated')) {
      showPanel('roles', false);
      return;
    }
    if (params.has('integrationsError') || params.has('integrationsSaved')) {
      showPanel('integrations', false);
      return;
    }
    if (params.has('error') || params.has('announcementSaved')) {
      showPanel('announcements', false);
      return;
    }

    const hash = window.location.hash.replace(/^#/, '');
    const fromHash = panelFromHash(hash);
    if (fromHash) showPanel(fromHash, false);
    else {
      showEmpty();
      const firstGroup = shell.querySelector('[data-admin-group]');
      if (firstGroup instanceof HTMLDetailsElement) firstGroup.open = true;
    }
  }

  document.querySelectorAll('[data-admin-shell]').forEach((root) => setupAdminNav(root));

  const brandingForm = document.getElementById('org-branding-form');
  if (brandingForm instanceof HTMLFormElement) {
    const statusEl = brandingForm.querySelector('[data-brand-status]');
    const errorEl = brandingForm.querySelector('[data-brand-error]');
    const colorKeys = [
      'bgColorLight',
      'primaryColorLight',
      'accentColorLight',
      'bgColorDark',
      'primaryColorDark',
      'accentColorDark',
    ];

    const syncPair = (key: string, fromColor: boolean) => {
      const colorInput = brandingForm.querySelector(`[data-brand-color="${key}"]`);
      const hexInput = brandingForm.querySelector(`[data-brand-hex="${key}"]`);
      if (!(colorInput instanceof HTMLInputElement) || !(hexInput instanceof HTMLInputElement)) return;
      if (fromColor) {
        hexInput.value = colorInput.value.toUpperCase();
      } else {
        const raw = hexInput.value.trim();
        const next = raw.startsWith('#') ? raw : `#${raw}`;
        if (/^#[0-9A-Fa-f]{6}$/.test(next)) {
          colorInput.value = next;
          hexInput.value = next.toUpperCase();
        }
      }
      const value = colorInput.value;
      const mode = key.endsWith('Dark') ? 'dark' : 'light';
      const role = key.startsWith('bg') ? 'bg' : key.startsWith('primary') ? 'primary' : 'accent';
      const preview = brandingForm.querySelector(`[data-brand-preview="${mode}"]`);
      const previewPrimary = brandingForm.querySelector(`[data-brand-preview-primary="${mode}"]`);
      const previewAccent = brandingForm.querySelector(`[data-brand-preview-accent="${mode}"]`);
      if (role === 'bg' && preview instanceof HTMLElement) {
        preview.style.background = value;
        if (mode === 'dark' && previewPrimary instanceof HTMLElement) {
          previewPrimary.style.color = value;
        }
      }
      if (role === 'primary' && previewPrimary instanceof HTMLElement) {
        previewPrimary.style.background = value;
      }
      if (role === 'accent' && previewAccent instanceof HTMLElement) {
        previewAccent.style.borderColor = value;
        previewAccent.style.color = value;
      }
    };

    colorKeys.forEach((key) => {
      const colorInput = brandingForm.querySelector(`[data-brand-color="${key}"]`);
      const hexInput = brandingForm.querySelector(`[data-brand-hex="${key}"]`);
      colorInput?.addEventListener('input', () => syncPair(key, true));
      hexInput?.addEventListener('change', () => syncPair(key, false));
    });

    brandingForm.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (statusEl instanceof HTMLElement) {
        statusEl.classList.add('hidden');
        statusEl.textContent = '';
      }
      if (errorEl instanceof HTMLElement) {
        errorEl.classList.add('hidden');
        errorEl.textContent = '';
      }
      colorKeys.forEach((key) => syncPair(key, false));
      try {
        const res = await fetch('/api/org/branding', {
          method: 'POST',
          body: new FormData(brandingForm),
          headers: { Accept: 'application/json' },
        });
        const json = (await res.json().catch(() => ({}))) as {
          error?: string;
          branding?: { hasLogo?: boolean; logoUrl?: string | null; hasFavicon?: boolean; faviconUrl?: string | null };
        };
        if (!res.ok) throw new Error(json.error || 'Could not save branding.');
        if (statusEl instanceof HTMLElement) {
          statusEl.textContent = 'Branding saved. Refresh if colors or logos do not update everywhere.';
          statusEl.classList.remove('hidden');
        }
        const branding = json.branding;
        if (branding?.logoUrl) {
          const logoPreview = brandingForm.querySelector('[data-brand-logo-preview]');
          if (logoPreview instanceof HTMLImageElement) logoPreview.src = branding.logoUrl;
        }
        if (branding?.faviconUrl) {
          const faviconPreview = brandingForm.querySelector('[data-brand-favicon-preview]');
          if (faviconPreview instanceof HTMLImageElement) faviconPreview.src = branding.faviconUrl;
        }
      } catch (error) {
        if (errorEl instanceof HTMLElement) {
          errorEl.textContent = error instanceof Error ? error.message : 'Could not save branding.';
          errorEl.classList.remove('hidden');
        }
      }
    });
  }

  document.addEventListener('click', async (event) => {
    if (!(event.target instanceof Element)) return;
    const button = event.target.closest('[data-copy-text]');
    if (!(button instanceof HTMLButtonElement)) return;
    const text = button.getAttribute('data-copy-text');
    if (!text) return;
    try {
      await navigator.clipboard.writeText(text);
      const previous = button.textContent;
      button.textContent = 'Copied';
      window.setTimeout(() => {
        button.textContent = previous || 'Copy';
      }, 1200);
    } catch {
      window.prompt('Copy this Redirect URI:', text);
    }
  });
</script>
