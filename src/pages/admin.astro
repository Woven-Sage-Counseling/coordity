      shadowTextColorLight?: string | null;
      shadowHoverColorLight?: string | null;
      selectedColorLight?: string | null;
      selectedTextColorLight?: string | null;
      selectedHoverColorLight?: string | null;
      bgColorDark?: string | null;
      surfaceColorDark?: string | null;
      textColorDark?: string | null;
      primaryColorDark?: string | null;
      primaryTextColorDark?: string | null;
      primaryHoverColorDark?: string | null;
      accentColorDark?: string | null;
      accentTextColorDark?: string | null;
      accentHoverColorDark?: string | null;
      shadowColorDark?: string | null;
      shadowTextColorDark?: string | null;
      shadowHoverColorDark?: string | null;
      selectedColorDark?: string | null;
      selectedTextColorDark?: string | null;
      selectedHoverColorDark?: string | null;
      widgetHeaderColorLight?: string | null;
      widgetBgColorLight?: string | null;
      widgetCardColorLight?: string | null;
      widgetButtonColorLight?: string | null;
      widgetButtonTextColorLight?: string | null;
      widgetButtonHoverColorLight?: string | null;
      widgetHeaderColorDark?: string | null;
      widgetBgColorDark?: string | null;
      widgetCardColorDark?: string | null;
      widgetButtonColorDark?: string | null;
      widgetButtonTextColorDark?: string | null;
      widgetButtonHoverColorDark?: string | null;
      widgetOutlineColorLight?: string | null;
      widgetOutlineTextColorLight?: string | null;
      widgetOutlineHoverColorLight?: string | null;
      widgetOutlineColorDark?: string | null;
      widgetOutlineTextColorDark?: string | null;
      widgetOutlineHoverColorDark?: string | null;
      trainingHeaderColorLight?: string | null;
      trainingHeaderTextColorLight?: string | null;
      trainingHeaderLabelColorLight?: string | null;
      trainingCheckboxColorLight?: string | null;
      trainingCheckboxBorderColorLight?: string | null;
      trainingModuleColorLight?: string | null;
      trainingModuleTextColorLight?: string | null;
      trainingLessonColorLight?: string | null;
      trainingLessonTextColorLight?: string | null;
      trainingBlockColorLight?: string | null;
      trainingBlockTextColorLight?: string | null;
      trainingFieldColorLight?: string | null;
      trainingFieldTextColorLight?: string | null;
      trainingFilledColorLight?: string | null;
      trainingFilledTextColorLight?: string | null;
      trainingFilledHoverColorLight?: string | null;
      trainingOutlineColorLight?: string | null;
      trainingOutlineTextColorLight?: string | null;
      trainingOutlineHoverColorLight?: string | null;
      trainingListTextColorLight?: string | null;
      trainingCardOutlineColorLight?: string | null;
      trainingCardOutlineTextColorLight?: string | null;
      trainingCardOutlineHoverColorLight?: string | null;
      trainingHeaderColorDark?: string | null;
      trainingHeaderTextColorDark?: string | null;
      trainingHeaderLabelColorDark?: string | null;
      trainingCheckboxColorDark?: string | null;
      trainingCheckboxBorderColorDark?: string | null;
      trainingModuleColorDark?: string | null;
      trainingModuleTextColorDark?: string | null;
      trainingLessonColorDark?: string | null;
      trainingLessonTextColorDark?: string | null;
      trainingBlockColorDark?: string | null;
      trainingBlockTextColorDark?: string | null;
      trainingFieldColorDark?: string | null;
      trainingFieldTextColorDark?: string | null;
      trainingFilledColorDark?: string | null;
      trainingFilledTextColorDark?: string | null;
      trainingFilledHoverColorDark?: string | null;
      trainingOutlineColorDark?: string | null;
      trainingOutlineTextColorDark?: string | null;
      trainingOutlineHoverColorDark?: string | null;
      trainingListTextColorDark?: string | null;
      trainingCardOutlineColorDark?: string | null;
      trainingCardOutlineTextColorDark?: string | null;
      trainingCardOutlineHoverColorDark?: string | null;
    }) => {
      const onHeader = (hex: string | null | undefined, fallback: string) => {
        const match = /^#?([0-9a-fA-F]{6})([0-9a-fA-F]{2})?$/.exec((hex ?? '').trim());
        const rgb = (match ? match[1] : fallback.slice(1, 7)).toUpperCase();
        const aa = match?.[2]?.toUpperCase();
        const value = !aa || aa === 'FF' ? `#${rgb}` : `#${rgb}${aa}`;
        const r = parseInt(rgb.slice(0, 2), 16);
        const g = parseInt(rgb.slice(2, 4), 16);
        const b = parseInt(rgb.slice(4, 6), 16);
        const fg = (0.299 * r + 0.587 * g + 0.114 * b) / 255 > 0.58 ? '#393A3D' : '#F7F4EE';
        return { value, fg };
      };
      const block = (
        selector: string,
        bg: string,
        surface: string,
        text: string,
        primary: string,
        primaryText: string,
        accent: string,
        accentText: string,
        widgetHeader: string,
        widgetHeaderFg: string,
        widgetBg: string,
        widgetCard: string,
        primaryHover: string,
        accentHover: string,
        widgetButton: string,
        widgetButtonText: string,
        widgetButtonHover: string,
        shadow: string,
        shadowText: string,
        shadowHover: string,
        alphas: {
          bg: string;
          surface: string;
          text: string;
          primary: string;
          primaryText: string;
          accent: string;
          accentText: string;
          widgetBg: string;
          widgetCard: string;
          primaryHover: string;
          accentHover: string;
          widgetButton: string;
          widgetButtonText: string;
          widgetButtonHover: string;
          shadow: string;
          shadowText: string;
          shadowHover: string;
        },
      ) =>
        `${selector}{--portal-cream:${bg} !important;--portal-cream-a:${alphas.bg} !important;--portal-surface:${surface} !important;--portal-surface-a:${alphas.surface} !important;--portal-sage-dark:${text} !important;--portal-sage-dark-a:${alphas.text} !important;--portal-charcoal:${text} !important;--portal-charcoal-a:${alphas.text} !important;--portal-primary:${primary} !important;--portal-primary-a:${alphas.primary} !important;--portal-on-primary:${primaryText} !important;--portal-on-primary-a:${alphas.primaryText} !important;--portal-sage:${accent} !important;--portal-sage-a:${alphas.accent} !important;--portal-sage-light:${accent} !important;--portal-sage-light-a:${alphas.accent} !important;--portal-accent:${accent} !important;--portal-accent-a:${alphas.accent} !important;--portal-on-accent:${accentText} !important;--portal-on-accent-a:${alphas.accentText} !important;--portal-primary-hover:${primaryHover} !important;--portal-primary-hover-a:${alphas.primaryHover} !important;--portal-accent-hover:${accentHover} !important;--portal-accent-hover-a:${alphas.accentHover} !important;--portal-shadow:${shadow} !important;--portal-shadow-a:${alphas.shadow} !important;--portal-on-shadow:${shadowText} !important;--portal-on-shadow-a:${alphas.shadowText} !important;--portal-shadow-hover:${shadowHover} !important;--portal-shadow-hover-a:${alphas.shadowHover} !important;--portal-widget-header:${widgetHeader} !important;--portal-widget-header-fg:${widgetHeaderFg} !important;--portal-widget-bg:${widgetBg} !important;--portal-widget-bg-a:${alphas.widgetBg} !important;--portal-widget-card:${widgetCard} !important;--portal-widget-card-a:${alphas.widgetCard} !important;--portal-widget-button:${widgetButton} !important;--portal-widget-button-a:${alphas.widgetButton} !important;--portal-widget-button-text:${widgetButtonText} !important;--portal-widget-button-text-a:${alphas.widgetButtonText} !important;--portal-widget-button-hover:${widgetButtonHover} !important;--portal-widget-button-hover-a:${alphas.widgetButtonHover} !important;}`;
      const lightBg = hexChannels(branding.bgColorLight) ?? '247 244 238';
      const lightSurface = hexChannels(branding.surfaceColorLight) ?? '255 255 255';
      const lightText = hexChannels(branding.textColorLight) ?? hexChannels(branding.primaryColorLight) ?? '83 95 81';
      const lightPrimary = hexChannels(branding.primaryColorLight) ?? '83 95 81';
      const lightPrimaryText = hexChannels(branding.primaryTextColorLight) ?? lightBg;
      const lightAccent = hexChannels(branding.accentColorLight) ?? '120 143 117';
      const lightAccentText = hexChannels(branding.accentTextColorLight) ?? lightAccent;
      const lightPrimaryHover = hexChannels(branding.primaryHoverColorLight) ?? lightAccent;
      const lightAccentHover = hexChannels(branding.accentHoverColorLight) ?? lightAccent;
      const lightShadow = hexChannels(branding.shadowColorLight) ?? lightAccent;
      const lightShadowText = hexChannels(branding.shadowTextColorLight) ?? lightAccentText;
      const lightShadowHover = hexChannels(branding.shadowHoverColorLight) ?? lightAccent;
      const lightWidgetHeader = onHeader(branding.widgetHeaderColorLight, '#535F51');
      const lightWidgetBg = hexChannels(branding.widgetBgColorLight) ?? '244 245 248';
      const lightWidgetCard = hexChannels(branding.widgetCardColorLight) ?? lightSurface;
      const lightWidgetButton = hexChannels(branding.widgetButtonColorLight) ?? '83 95 81';
      const lightWidgetButtonText = hexChannels(branding.widgetButtonTextColorLight) ?? '247 244 238';
      const lightWidgetButtonHover = hexChannels(branding.widgetButtonHoverColorLight) ?? lightWidgetButton.split(' ').map((channel) => String(Math.round(Number(channel) * 0.92))).join(' ');
      const darkBg = hexChannels(branding.bgColorDark) ?? '17 19 17';
      const darkSurface = hexChannels(branding.surfaceColorDark) ?? '30 33 30';
      const darkText = hexChannels(branding.textColorDark) ?? hexChannels(branding.primaryColorDark) ?? '186 198 182';
      const darkPrimary = hexChannels(branding.primaryColorDark) ?? '186 198 182';
      const darkPrimaryText = hexChannels(branding.primaryTextColorDark) ?? darkBg;
      const darkAccent = hexChannels(branding.accentColorDark) ?? '138 158 134';
      const darkAccentText = hexChannels(branding.accentTextColorDark) ?? darkAccent;
      const darkPrimaryHover = hexChannels(branding.primaryHoverColorDark) ?? darkAccent;
      const darkAccentHover = hexChannels(branding.accentHoverColorDark) ?? darkAccent;
      const darkShadow = hexChannels(branding.shadowColorDark) ?? darkAccent;
      const darkShadowText = hexChannels(branding.shadowTextColorDark) ?? darkAccentText;
      const darkShadowHover = hexChannels(branding.shadowHoverColorDark) ?? darkAccent;
      const darkWidgetHeader = onHeader(branding.widgetHeaderColorDark, '#535F51');
      const darkWidgetBg = hexChannels(branding.widgetBgColorDark) ?? '37 41 37';
      const darkWidgetCard = hexChannels(branding.widgetCardColorDark) ?? darkSurface;
      const darkWidgetButton = hexChannels(branding.widgetButtonColorDark) ?? '83 95 81';
      const darkWidgetButtonText = hexChannels(branding.widgetButtonTextColorDark) ?? '247 244 238';
      const darkWidgetButtonHover = hexChannels(branding.widgetButtonHoverColorDark) ?? darkWidgetButton.split(' ').map((channel) => String(Math.round(Number(channel) * 0.92))).join(' ');
      const selectedItemRule = (
        selector: string,
        color: string | null | undefined,
        colorFallback: string,
        text: string | null | undefined,
        textFallback: string | null | undefined,
        textDefault: string,
        hover: string | null | undefined,
        hoverFallback: string,
      ) => {
        const channels = (value: string | null | undefined, fallback: string) =>
          hexChannels(value) ?? hexChannels(fallback) ?? '120 143 117';
        const alpha = (value: string | null | undefined, fallback: string) => hexAlpha(value || fallback);
        return `${selector}{--portal-selected:${channels(color, colorFallback)} !important;--portal-selected-a:${alpha(color, colorFallback)} !important;--portal-on-selected:${channels(text, textFallback || textDefault)} !important;--portal-on-selected-a:${alpha(text, textFallback || textDefault)} !important;--portal-selected-hover:${channels(hover, hoverFallback)} !important;--portal-selected-hover-a:${alpha(hover, hoverFallback)} !important;}`;
      };
      const widgetOutlineRule = (
        selector: string,
        color: string | null | undefined,
        colorFallback: string,
        text: string | null | undefined,
        textFallback: string,
        hover: string | null | undefined,
        hoverFallback: string,
      ) => {
        const channels = (value: string | null | undefined, fallback: string) =>
          hexChannels(value) ?? hexChannels(fallback) ?? '83 95 81';
        const alpha = (value: string | null | undefined, fallback: string) => hexAlpha(value || fallback);
        return `${selector}{--portal-widget-outline:${channels(color, colorFallback)} !important;--portal-widget-outline-a:${alpha(color, colorFallback)} !important;--portal-widget-outline-text:${channels(text, textFallback)} !important;--portal-widget-outline-text-a:${alpha(text, textFallback)} !important;--portal-widget-outline-hover:${channels(hover, hoverFallback)} !important;--portal-widget-outline-hover-a:${alpha(hover, hoverFallback)} !important;}`;
      };
      const trainingRule = (selector: string, mode: 'Light' | 'Dark') => {
        const accent = mode === 'Light' ? branding.accentColorLight : branding.accentColorDark;
        const accentBase = accent && accent.length >= 7 ? accent.slice(0, 7) : mode === 'Light' ? '#788F75' : '#8A9E86';
        const fallbacks: Record<string, string> = mode === 'Light'
          ? {
              header: branding.selectedColorLight || '#F7F8FA',
              'header-text': branding.textColorLight || '#535F51',
              'header-title': branding.textColorLight || '#535F51',
              'header-label': branding.trainingHeaderLabelColorLight || branding.textColorLight || '#535F518C',
              checkbox: branding.trainingCheckboxColorLight || branding.primaryColorLight || '#535F51',
              'checkbox-border': branding.trainingCheckboxBorderColorLight || '#B7BEB4',
              module: branding.primaryColorLight || '#535F51',
              'module-text': branding.primaryTextColorLight || '#F7F4EE',
              lesson: `${accentBase}40`,
              'lesson-text': branding.textColorLight || '#535F51',
              block: '#F7F8FA',
              'block-text': branding.textColorLight || '#535F51',
              field: branding.surfaceColorLight || '#FFFFFF',
              'field-text': branding.textColorLight || '#535F51',
              filled: branding.primaryColorLight || '#535F51',
              'filled-text': branding.primaryTextColorLight || '#F7F4EE',
              'filled-hover': branding.primaryHoverColorLight || branding.accentColorLight || '#788F75',
              outline: branding.accentColorLight || '#788F75',
              'outline-text': branding.accentTextColorLight || branding.accentColorLight || '#788F75',
              'outline-hover': branding.accentHoverColorLight || `${accentBase}1A`,
              'list-text': branding.textColorLight || '#535F51',
              'card-outline': branding.trainingOutlineColorLight || branding.accentColorLight || '#788F75',
              'card-outline-text': branding.trainingOutlineTextColorLight || branding.accentTextColorLight || '#788F75',
              'card-outline-hover': branding.trainingOutlineHoverColorLight || branding.accentHoverColorLight || `${accentBase}1A`,
            }
          : {
              header: branding.selectedColorDark || '#2A2E2A',
              'header-text': branding.textColorDark || '#BAC6B6',
              'header-title': branding.textColorDark || '#BAC6B6',
              'header-label': branding.trainingHeaderLabelColorDark || branding.textColorDark || '#BAC6B68C',
              checkbox: branding.trainingCheckboxColorDark || branding.primaryColorDark || '#BAC6B6',
              'checkbox-border': branding.trainingCheckboxBorderColorDark || '#6E786C',
              module: branding.primaryColorDark || '#BAC6B6',
              'module-text': branding.primaryTextColorDark || '#111311',
              lesson: `${accentBase}40`,
              'lesson-text': branding.textColorDark || '#BAC6B6',
              block: '#252925',
              'block-text': branding.textColorDark || '#BAC6B6',
              field: branding.surfaceColorDark || '#1E211E',
              'field-text': branding.textColorDark || '#BAC6B6',
              filled: branding.primaryColorDark || '#BAC6B6',
              'filled-text': branding.primaryTextColorDark || '#111311',
              'filled-hover': branding.primaryHoverColorDark || branding.accentColorDark || '#8A9E86',
              outline: branding.accentColorDark || '#8A9E86',
              'outline-text': branding.accentTextColorDark || branding.accentColorDark || '#8A9E86',
              'outline-hover': branding.accentHoverColorDark || `${accentBase}1A`,
              'list-text': branding.textColorDark || '#BAC6B6',
              'card-outline': branding.trainingOutlineColorDark || branding.accentColorDark || '#8A9E86',
              'card-outline-text': branding.trainingOutlineTextColorDark || branding.accentTextColorDark || '#8A9E86',
              'card-outline-hover': branding.trainingOutlineHoverColorDark || branding.accentHoverColorDark || `${accentBase}1A`,
            };
        const keys: Record<string, string> = {
          header: 'trainingHeaderColor',
          'header-text': 'trainingHeaderTextColor',
          'header-title': 'trainingHeaderTextColor',
          'header-label': 'trainingHeaderLabelColor',
          checkbox: 'trainingCheckboxColor',
          'checkbox-border': 'trainingCheckboxBorderColor',
          module: 'trainingModuleColor',
          'module-text': 'trainingModuleTextColor',
          lesson: 'trainingLessonColor',
          'lesson-text': 'trainingLessonTextColor',
          block: 'trainingBlockColor',
          'block-text': 'trainingBlockTextColor',
          field: 'trainingFieldColor',
          'field-text': 'trainingFieldTextColor',
          filled: 'trainingFilledColor',
          'filled-text': 'trainingFilledTextColor',
          'filled-hover': 'trainingFilledHoverColor',
          outline: 'trainingOutlineColor',
          'outline-text': 'trainingOutlineTextColor',
          'outline-hover': 'trainingOutlineHoverColor',
          'list-text': 'trainingListTextColor',
          'card-outline': 'trainingCardOutlineColor',
          'card-outline-text': 'trainingCardOutlineTextColor',
          'card-outline-hover': 'trainingCardOutlineHoverColor',
        };
        const decl = Object.entries(keys)
          .map(([name, key]) => {
            const stored = branding[`${key}${mode}` as keyof typeof branding] as string | null | undefined;
            const hex = stored || fallbacks[name];
            const channels = hexChannels(hex) ?? '247 248 250';
            return `--portal-training-${name}:${channels} !important;--portal-training-${name}-a:${hexAlpha(hex)} !important;`;
          })
          .join('');
        return `${selector}{${decl}}`;
      };
      let style = document.getElementById('org-brand');
      if (!(style instanceof HTMLStyleElement)) {
        style = document.createElement('style');
        style.id = 'org-brand';
        document.head.appendChild(style);
      }
      style.textContent =
        block('html', lightBg, lightSurface, lightText, lightPrimary, lightPrimaryText, lightAccent, lightAccentText, lightWidgetHeader.value, lightWidgetHeader.fg, lightWidgetBg, lightWidgetCard, lightPrimaryHover, lightAccentHover, lightWidgetButton, lightWidgetButtonText, lightWidgetButtonHover, lightShadow, lightShadowText, lightShadowHover, {
          bg: hexAlpha(branding.bgColorLight),
          surface: hexAlpha(branding.surfaceColorLight),
          text: hexAlpha(branding.textColorLight),
          primary: hexAlpha(branding.primaryColorLight),
          primaryText: hexAlpha(branding.primaryTextColorLight),
          accent: hexAlpha(branding.accentColorLight),
          accentText: hexAlpha(branding.accentTextColorLight),
          widgetBg: hexAlpha(branding.widgetBgColorLight),
          widgetCard: hexAlpha(branding.widgetCardColorLight),
          primaryHover: hexAlpha(branding.primaryHoverColorLight),
          accentHover: branding.accentHoverColorLight ? hexAlpha(branding.accentHoverColorLight) : '0.1',
          widgetButton: hexAlpha(branding.widgetButtonColorLight),
          widgetButtonText: hexAlpha(branding.widgetButtonTextColorLight),
          widgetButtonHover: hexAlpha(branding.widgetButtonHoverColorLight),
          shadow: branding.shadowColorLight ? hexAlpha(branding.shadowColorLight) : '0.18',
          shadowText: hexAlpha(branding.shadowTextColorLight),
          shadowHover: branding.shadowHoverColorLight ? hexAlpha(branding.shadowHoverColorLight) : '0.28',
        }) +
        block('html.dark', darkBg, darkSurface, darkText, darkPrimary, darkPrimaryText, darkAccent, darkAccentText, darkWidgetHeader.value, darkWidgetHeader.fg, darkWidgetBg, darkWidgetCard, darkPrimaryHover, darkAccentHover, darkWidgetButton, darkWidgetButtonText, darkWidgetButtonHover, darkShadow, darkShadowText, darkShadowHover, {
          bg: hexAlpha(branding.bgColorDark),
          surface: hexAlpha(branding.surfaceColorDark),
          text: hexAlpha(branding.textColorDark),
          primary: hexAlpha(branding.primaryColorDark),
          primaryText: hexAlpha(branding.primaryTextColorDark),
          accent: hexAlpha(branding.accentColorDark),
          accentText: hexAlpha(branding.accentTextColorDark),
          widgetBg: hexAlpha(branding.widgetBgColorDark),
          widgetCard: hexAlpha(branding.widgetCardColorDark),
          primaryHover: hexAlpha(branding.primaryHoverColorDark),
          accentHover: branding.accentHoverColorDark ? hexAlpha(branding.accentHoverColorDark) : '0.1',
          widgetButton: hexAlpha(branding.widgetButtonColorDark),
          widgetButtonText: hexAlpha(branding.widgetButtonTextColorDark),
          widgetButtonHover: hexAlpha(branding.widgetButtonHoverColorDark),
          shadow: branding.shadowColorDark ? hexAlpha(branding.shadowColorDark) : '0.22',
          shadowText: hexAlpha(branding.shadowTextColorDark),
          shadowHover: branding.shadowHoverColorDark ? hexAlpha(branding.shadowHoverColorDark) : '0.32',
        }) +
        widgetOutlineRule('html', branding.widgetOutlineColorLight, '#535F5140', branding.widgetOutlineTextColorLight, '#535F51CC', branding.widgetOutlineHoverColorLight, '#535F511A') +
        widgetOutlineRule('html.dark', branding.widgetOutlineColorDark, '#BAC6B666', branding.widgetOutlineTextColorDark, '#BAC6B6', branding.widgetOutlineHoverColorDark, '#BAC6B61A') +
        selectedItemRule('html', branding.selectedColorLight, branding.accentColorLight ? `${branding.accentColorLight.slice(0, 7)}33` : '#788F7533', branding.selectedTextColorLight, branding.textColorLight, '#535F51', branding.selectedHoverColorLight, branding.accentColorLight ? `${branding.accentColorLight.slice(0, 7)}1A` : '#788F751A') +
        selectedItemRule('html.dark', branding.selectedColorDark, branding.accentColorDark ? `${branding.accentColorDark.slice(0, 7)}33` : '#8A9E8633', branding.selectedTextColorDark, branding.textColorDark, '#BAC6B6', branding.selectedHoverColorDark, branding.accentColorDark ? `${branding.accentColorDark.slice(0, 7)}1A` : '#8A9E861A') +
        trainingRule('html', 'Light') +
        trainingRule('html.dark', 'Dark');
    };

    brandingForm.addEventListener(
      'invalid',
      (event) => {
        const field = event.target;
        if (!(field instanceof HTMLElement)) return;
        const details = field.closest('details');
        if (details instanceof HTMLDetailsElement) details.open = true;
      },
      true,
    );

    brandingForm.addEventListener('submit', async (event) => {
      event.preventDefault();
      const submitter = event.submitter instanceof HTMLElement ? event.submitter : null;
      const section = submitter?.closest('[data-brand-section]') ?? brandingForm;
      brandingForm.querySelectorAll('[data-brand-status], [data-brand-error]').forEach((node) => {
        if (!(node instanceof HTMLElement)) return;
        node.classList.add('hidden');
        node.textContent = '';
      });
      const statusEl = section.querySelector('[data-brand-status]');
      const errorEl = section.querySelector('[data-brand-error]');
      colorKeys.forEach((key) => syncPair(key, false));
      try {
        const res = await fetch('/api/org/branding', {
          method: 'POST',
          body: new FormData(brandingForm),
          headers: { Accept: 'application/json' },
        });
        const json = (await res.json().catch(() => ({}))) as {
          error?: string;
          branding?: {
            hasLogo?: boolean;
            logoUrl?: string | null;
            hasFavicon?: boolean;
            faviconUrl?: string | null;
            bgColorLight?: string | null;
            surfaceColorLight?: string | null;
            textColorLight?: string | null;
            primaryColorLight?: string | null;
            primaryTextColorLight?: string | null;
            accentColorLight?: string | null;
            accentTextColorLight?: string | null;
            bgColorDark?: string | null;
            surfaceColorDark?: string | null;
            textColorDark?: string | null;
            primaryColorDark?: string | null;
            primaryTextColorDark?: string | null;
            accentColorDark?: string | null;
            accentTextColorDark?: string | null;
            widgetHeaderColorLight?: string | null;
            widgetBgColorLight?: string | null;
            widgetCardColorLight?: string | null;
            widgetHeaderColorDark?: string | null;
            widgetBgColorDark?: string | null;
            widgetCardColorDark?: string | null;
          };
        };
        if (!res.ok) throw new Error(json.error || 'Could not save branding.');
        if (json.branding) applySavedBrandColors(json.branding);
        if (statusEl instanceof HTMLElement) {
          statusEl.textContent = 'Branding saved.';
          statusEl.classList.remove('hidden');
        }
        const branding = json.branding;
        if (branding?.logoUrl) {
          const logoPreview = brandingForm.querySelector('[data-brand-logo-preview]');
          if (logoPreview instanceof HTMLImageElement) logoPreview.src = branding.logoUrl;
        }
        if (branding?.faviconUrl) {
          const faviconPreview = brandingForm.querySelector('[data-brand-favicon-preview]');
          if (faviconPreview instanceof HTMLImageElement) faviconPreview.src = branding.faviconUrl;
        }
      } catch (error) {
        if (errorEl instanceof HTMLElement) {
          errorEl.textContent = error instanceof Error ? error.message : 'Could not save branding.';
          errorEl.classList.remove('hidden');
        }
      }
    });
  }

  document.addEventListener('click', async (event) => {
    if (!(event.target instanceof Element)) return;
    const button = event.target.closest('[data-copy-text]');
    if (!(button instanceof HTMLButtonElement)) return;
    const text = button.getAttribute('data-copy-text');
    if (!text) return;
    try {
      await navigator.clipboard.writeText(text);
      const previous = button.textContent;
      button.textContent = 'Copied';
      window.setTimeout(() => {
        button.textContent = previous || 'Copy';
      }, 1200);
    } catch {
      window.prompt('Copy this Redirect URI:', text);
    }
  });
</script>
