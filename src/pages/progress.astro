---
import PortalLayout from '../layouts/PortalLayout.astro';
import { listProgressTracksForUser, overallProgress } from '../lib/progress';

export const prerender = false;

const employee = Astro.locals.employee!;
const tracks = await listProgressTracksForUser(employee.id);
const overall = overallProgress(tracks);
---

<PortalLayout title="My progress" wide>
  <p class="text-sm text-sage-dark/65">
    <a href="/" class="hover:text-sage-dark">Home</a>
    <span class="mx-1.5 text-sage-dark/35">/</span>
    My progress
  </p>

  <div class="mt-3">
    <h1 class="font-display text-4xl text-charcoal sm:text-5xl">My progress</h1>
    <p class="mt-3 max-w-2xl text-sage-dark/75">
      Track onboarding, training, and compliance. More modules will appear here as they are published.
    </p>
  </div>

  <section class="card mt-8 max-w-2xl" aria-labelledby="overall-progress">
    <div class="flex flex-wrap items-end justify-between gap-3">
      <div>
        <h2 id="overall-progress" class="text-sm font-semibold uppercase tracking-[0.14em] text-sage-dark/60">
          Overall
        </h2>
        <p class="mt-2 font-display text-4xl text-charcoal">{overall.percent}%</p>
      </div>
      <p class="text-sm text-sage-dark/65">
        {overall.completed} of {overall.total} steps complete
      </p>
    </div>
    <div
      class="mt-4 h-2.5 overflow-hidden rounded-full bg-[#e3e5e8]"
      role="progressbar"
      aria-valuemin={0}
      aria-valuemax={100}
      aria-valuenow={overall.percent}
      aria-label="Overall progress"
    >
      <div class="h-full rounded-full bg-sage-dark" style={`width: ${overall.percent}%`}></div>
    </div>
  </section>

  <div class="mt-8 max-w-2xl space-y-6">
    {
      tracks.map((track) => (
        <section class="card" aria-labelledby={`track-${track.id}`}>
          <div class="flex flex-wrap items-start justify-between gap-3">
            <div class="min-w-0">
              <h2 id={`track-${track.id}`} class="text-xl font-semibold text-charcoal">
                {track.label}
              </h2>
              <p class="mt-1 text-sm text-sage-dark/70">{track.description}</p>
            </div>
            <p class="shrink-0 text-sm font-semibold text-sage-dark/80">{track.percent}%</p>
          </div>

          <div
            class="mt-4 h-2 overflow-hidden rounded-full bg-[#e3e5e8]"
            role="progressbar"
            aria-valuemin={0}
            aria-valuemax={100}
            aria-valuenow={track.percent}
            aria-label={`${track.label} progress`}
          >
            <div
              class:list={[
                'h-full rounded-full',
                track.percent === 100 ? 'bg-emerald-600' : 'bg-sage-dark',
              ]}
              style={`width: ${track.percent}%`}
            ></div>
          </div>
          <p class="mt-2 text-xs text-sage-dark/60">
            {track.completed} of {track.total} complete
          </p>

          <ul class="mt-5 space-y-2.5">
            {track.steps.map((step) => (
              <li
                class:list={[
                  'flex items-start gap-3 rounded-xl border px-3.5 py-3',
                  step.done
                    ? 'border-emerald-200 bg-emerald-50/70'
                    : 'border-sage-dark/10 bg-[#fafbf9]',
                ]}
              >
                <span
                  class:list={[
                    'mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full text-[11px] font-bold',
                    step.done ? 'bg-emerald-600 text-white' : 'bg-white text-sage-dark/45 ring-1 ring-sage-dark/20',
                  ]}
                  aria-hidden="true"
                >
                  {step.done ? '✓' : ''}
                </span>
                <div class="min-w-0 flex-1">
                  <p
                    class:list={[
                      'text-sm font-medium',
                      step.done ? 'text-emerald-950' : 'text-charcoal',
                    ]}
                  >
                    {step.label}
                  </p>
                  {step.href && !step.done ? (
                    <a
                      href={step.href}
                      class="mt-1 inline-block text-xs font-semibold text-sage-dark/75 transition hover:text-charcoal"
                    >
                      Continue
                    </a>
                  ) : null}
                </div>
                <span class="shrink-0 text-[11px] font-semibold uppercase tracking-wide text-sage-dark/50">
                  {step.done ? 'Done' : 'To do'}
                </span>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>
</PortalLayout>
