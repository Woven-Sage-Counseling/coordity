---
import PortalLayout from '../layouts/PortalLayout.astro';
import PortalToolCard from '../components/PortalToolCard.astro';
import { availablePortalTools } from '../lib/portal-tools';

export const prerender = false;

const employee = Astro.locals.employee!;
const tools = availablePortalTools(employee);
---

<PortalLayout title="Tools" wide>
  <p class="text-xs uppercase tracking-[0.2em] text-sage-dark/60">Tools</p>
  <h1 class="mt-3 font-display text-4xl text-charcoal sm:text-5xl">Open a portal tool.</h1>
  <p class="mt-4 max-w-2xl text-sage-dark/75">
    Full pages for timesheets, time off, tasks, and other home widgets. Pick a tile to open the
    complete view.
  </p>

  {
    tools.length > 0 ? (
      <div class="mt-10 flex flex-wrap gap-x-4 gap-y-8">
        {tools.map((tool) => (
          <PortalToolCard tool={tool} />
        ))}
      </div>
    ) : (
      <p class="mt-10 text-sm text-sage-dark/65">No tools are available for your account yet.</p>
    )
  }
</PortalLayout>
