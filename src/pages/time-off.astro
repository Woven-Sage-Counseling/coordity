---
import PortalLayout from '../layouts/PortalLayout.astro';
import { formatTimeOffRequestEntries } from '../lib/time-off';
import {
  formatTimeOffRequestDate,
  listTimeOffRequestsForUser,
  timeOffStatusLabel,
} from '../lib/time-off-requests';

export const prerender = false;

const employee = Astro.locals.employee!;
const error = Astro.url.searchParams.get('error');
const sent = Astro.url.searchParams.get('sent') === '1';
const retracted = Astro.url.searchParams.get('retracted') === '1';
const deleted = Astro.url.searchParams.get('deleted') === '1';
const requests = await listTimeOffRequestsForUser(employee.id);
---

<PortalLayout title="Request time off" wide>
  <p class="text-sm text-sage-dark/65">
    <a href="/" class="hover:text-sage-dark">Home</a>
    <span class="mx-1.5 text-sage-dark/35">/</span>
    Request time off
  </p>

  <div class="mt-3">
    <h1 class="font-display text-4xl text-charcoal sm:text-5xl">Request time off</h1>
    <p class="mt-3 max-w-2xl text-sage-dark/75">
      Add the dates you need off. Pick a start and end date for a multi-day period, or use the same date for a single day or partial day.
    </p>
  </div>

  {
    error ? (
      <p class="mt-6 max-w-2xl rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800">
        {error}
      </p>
    ) : null
  }

  {
    sent ? (
      <p class="mt-6 max-w-2xl rounded-xl border border-sage-dark/15 bg-white px-4 py-3 text-sm text-sage-dark/80">
        Your time off request was submitted.
      </p>
    ) : null
  }

  {
    retracted ? (
      <p class="mt-6 max-w-2xl rounded-xl border border-sage-dark/15 bg-white px-4 py-3 text-sm text-sage-dark/80">
        Your pending time off request was retracted.
      </p>
    ) : null
  }

  {
    deleted ? (
      <p class="mt-6 max-w-2xl rounded-xl border border-sage-dark/15 bg-white px-4 py-3 text-sm text-sage-dark/80">
        Denied request removed from your list.
      </p>
    ) : null
  }

  <form class="card mt-8 max-w-2xl" method="post" action="/api/time-off/request" data-time-off-form>
    <fieldset class="space-y-4" data-time-off-entries>
      <legend class="text-sm font-semibold text-charcoal">Dates requested</legend>
      <div class="rounded-xl border border-sage-dark/10 bg-[#fafbf9] p-4" data-time-off-row>
        <div class="grid gap-4 sm:grid-cols-2">
          <label class="block text-sm font-medium text-charcoal">
            Start date
            <input
              class="field"
              type="date"
              name="entry_start_date_0"
              data-time-off-start-date
              required
            />
          </label>
          <label class="block text-sm font-medium text-charcoal">
            End date
            <input
              class="field"
              type="date"
              name="entry_end_date_0"
              data-time-off-end-date
              required
            />
          </label>
        </div>
        <p class="mt-2 hidden text-xs text-sage-dark/60" data-time-off-range-note>
          Multi-day periods are submitted as full days.
        </p>
        <label
          class="mt-4 inline-flex items-center gap-2 text-sm text-charcoal"
          data-time-off-full-day-wrap
        >
          <input type="checkbox" name="entry_full_day_0" checked data-time-off-full-day />
          Full day
        </label>
        <div class="mt-4 hidden grid gap-4 sm:grid-cols-2" data-time-off-times>
          <label class="block text-sm font-medium text-charcoal">
            Start time
            <input class="field" type="time" name="entry_start_0" data-time-off-start-time />
          </label>
          <label class="block text-sm font-medium text-charcoal">
            End time
            <input class="field" type="time" name="entry_end_0" data-time-off-end-time />
          </label>
        </div>
      </div>
    </fieldset>

    <div class="mt-4 flex flex-wrap gap-2">
      <button class="btn-secondary !px-3 !py-1.5" type="button" data-time-off-add>
        Add another period
      </button>
    </div>

    <label class="mt-6 block text-sm font-medium text-charcoal">
      Notes <span class="font-normal text-sage-dark/60">(optional)</span>
      <textarea class="field min-h-[5rem] resize-y" name="notes" maxlength="1000" placeholder="Anything else your admin should know?"></textarea>
    </label>

    <div class="mt-6">
      <button class="btn-primary" type="submit">Submit request</button>
    </div>
  </form>

  <section class="mt-12 max-w-2xl" aria-labelledby="your-time-off-requests">
    <h2 id="your-time-off-requests" class="font-display text-3xl text-charcoal">Your requests</h2>
    <p class="mt-2 text-sm text-sage-dark/65">
      Track pending, approved, and denied time off requests. Pending requests can be retracted; denied ones can be deleted.
    </p>

    {
      requests.length === 0 ? (
        <p class="mt-6 text-sm text-sage-dark/65">You have not submitted any time off requests yet.</p>
      ) : (
        <div class="mt-6 space-y-4">
          {
            requests.map((request) => (
              <article class="rounded-2xl border border-sage-dark/10 bg-white/80 p-5 shadow-sm">
                <div class="flex flex-wrap items-start justify-between gap-3">
                  <p class="text-xs text-sage-dark/55">
                    Submitted {formatTimeOffRequestDate(request.createdAt)}
                  </p>
                  <span
                    class:list={[
                      'rounded-full px-2.5 py-1 text-[11px] font-semibold uppercase tracking-wide',
                      request.status === 'pending' && 'bg-amber-100 text-amber-900',
                      request.status === 'approved' && 'bg-emerald-100 text-emerald-900',
                      request.status === 'denied' && 'bg-red-100 text-red-900',
                    ]}
                  >
                    {timeOffStatusLabel(request.status)}
                  </span>
                </div>

                <ul class="mt-3 space-y-1.5 text-sm text-charcoal">
                  {
                    formatTimeOffRequestEntries(
                      request.entries.map((entry) => ({
                        date: entry.date,
                        fullDay: entry.fullDay,
                        startTime: entry.startTime,
                        endTime: entry.endTime,
                      })),
                    ).map((label) => <li>{label}</li>)
                  }
                </ul>

                {
                  request.notes ? (
                    <p class="mt-3 rounded-xl bg-[#f4f5f8] px-3 py-2 text-sm text-sage-dark/80">
                      <span class="font-semibold text-charcoal">Notes:</span> {request.notes}
                    </p>
                  ) : null
                }

                {
                  request.reviewedAt ? (
                    <p class="mt-3 text-xs text-sage-dark/55">
                      Reviewed {formatTimeOffRequestDate(request.reviewedAt)}
                      {request.reviewerName ? ` by ${request.reviewerName}` : ''}
                    </p>
                  ) : null
                }

                {
                  request.status === 'pending' && (
                    <form method="post" action="/api/time-off/retract" class="mt-4">
                      <input type="hidden" name="requestId" value={request.id} />
                      <button
                        class="btn-secondary !px-3 !py-1.5"
                        type="submit"
                        data-confirm="Retract this pending time off request?"
                      >
                        Retract request
                      </button>
                    </form>
                  )
                }
                {
                  request.status === 'denied' && (
                    <form method="post" action="/api/time-off/delete" class="mt-4">
                      <input type="hidden" name="requestId" value={request.id} />
                      <button
                        class="btn-secondary !px-3 !py-1.5 !text-red-700"
                        type="submit"
                        data-confirm="Delete this denied request from your list?"
                      >
                        Delete
                      </button>
                    </form>
                  )
                }
              </article>
            ))
          }
        </div>
      )
    }
  </section>
</PortalLayout>

<script>
  import {
    bindTimeOffRow,
    prepareTimeOffFormForSubmit,
    rowDates,
  } from '../lib/time-off-form-client';

  function reindexRows(container: HTMLElement): void {
    const rows = container.querySelectorAll('[data-time-off-row]');
    rows.forEach((row, index) => {
      if (!(row instanceof HTMLElement)) return;
      const startDate = row.querySelector('[data-time-off-start-date]');
      const endDate = row.querySelector('[data-time-off-end-date]');
      const fullDay = row.querySelector('[data-time-off-full-day]');
      const startTime = row.querySelector('[data-time-off-start-time]');
      const endTime = row.querySelector('[data-time-off-end-time]');
      if (startDate instanceof HTMLInputElement) startDate.name = `entry_start_date_${index}`;
      if (endDate instanceof HTMLInputElement) endDate.name = `entry_end_date_${index}`;
      if (fullDay instanceof HTMLInputElement) fullDay.name = `entry_full_day_${index}`;
      if (startTime instanceof HTMLInputElement) startTime.name = `entry_start_${index}`;
      if (endTime instanceof HTMLInputElement) endTime.name = `entry_end_${index}`;

      let removeButton = row.querySelector('[data-time-off-remove]') as HTMLButtonElement | null;
      if (index === 0) {
        removeButton?.remove();
        return;
      }
      if (!(removeButton instanceof HTMLButtonElement)) {
        removeButton = document.createElement('button');
        removeButton.type = 'button';
        removeButton.className = 'mt-3 text-sm font-medium text-sage-dark/70 hover:text-charcoal';
        removeButton.dataset.timeOffRemove = '1';
        removeButton.textContent = 'Remove';
        removeButton.addEventListener('click', () => {
          row.remove();
          reindexRows(container);
        });
        row.appendChild(removeButton);
      }
    });
  }

  function initTimeOffForm(form: HTMLFormElement): void {
    const container = form.querySelector('[data-time-off-entries]');
    const addButton = form.querySelector('[data-time-off-add]');
    if (!(container instanceof HTMLElement) || !(addButton instanceof HTMLButtonElement)) return;

    container.querySelectorAll('[data-time-off-row]').forEach((row) => {
      if (row instanceof HTMLElement) bindTimeOffRow(row);
    });

    form.addEventListener('submit', () => {
      prepareTimeOffFormForSubmit(form);
    });

    addButton.addEventListener('click', () => {
      const template = container.querySelector('[data-time-off-row]');
      if (!(template instanceof HTMLElement)) return;
      const row = template.cloneNode(true) as HTMLElement;
      const { start, end } = rowDates(row);
      const fullDay = row.querySelector('[data-time-off-full-day]');
      const startTime = row.querySelector('[data-time-off-start-time]');
      const endTime = row.querySelector('[data-time-off-end-time]');
      if (start instanceof HTMLInputElement) start.value = '';
      if (end instanceof HTMLInputElement) end.value = '';
      if (fullDay instanceof HTMLInputElement) fullDay.checked = true;
      if (startTime instanceof HTMLInputElement) startTime.value = '';
      if (endTime instanceof HTMLInputElement) endTime.value = '';
      delete row.dataset.savedStartTime;
      delete row.dataset.savedEndTime;
      row.querySelector('[data-time-off-remove]')?.remove();
      container.appendChild(row);
      bindTimeOffRow(row);
      reindexRows(container);
      if (start instanceof HTMLInputElement) start.focus();
    });

    reindexRows(container);
  }

  document.querySelectorAll('[data-time-off-form]').forEach((node) => {
    if (node instanceof HTMLFormElement) initTimeOffForm(node);
  });

  document.addEventListener('click', (event) => {
    const target = event.target;
    if (!(target instanceof HTMLElement)) return;
    const button = target.closest('button[data-confirm]');
    if (!(button instanceof HTMLButtonElement)) return;
    const message = button.getAttribute('data-confirm');
    if (!message) return;
    if (!window.confirm(message)) event.preventDefault();
  });
</script>
