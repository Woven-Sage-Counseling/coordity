---
import PortalLayout from '../layouts/PortalLayout.astro';
import { formatAnnouncementDate } from '../lib/announcements';
import { listNotificationsForUser } from '../lib/notifications';

export const prerender = false;

const employee = Astro.locals.employee!;
const notifications = await listNotificationsForUser(employee.id, 100);
---

<PortalLayout title="Notifications" wide>
  <p class="text-sm text-sage-dark/65">
    <a href="/" class="hover:text-sage-dark">Home</a>
    <span class="mx-1.5 text-sage-dark/35">/</span>
    Notifications
  </p>
  <h1 class="mt-3 font-display text-4xl text-charcoal sm:text-5xl">Notifications</h1>
  <p class="mt-3 max-w-2xl text-sage-dark/75">
    All of your alerts in one place, newest first.
  </p>

  {
    notifications.length === 0 ? (
      <p class="mt-10 text-sm text-sage-dark/65">No notifications yet.</p>
    ) : (
      <ul class="mt-10 space-y-4">
        {notifications.map((item) => (
          <li class="rounded-2xl border border-sage-dark/10 bg-white/80 p-5 shadow-sm">
            <div class="flex flex-wrap items-baseline justify-between gap-x-3 gap-y-1">
              <h2 class="text-lg font-semibold text-charcoal">{item.title}</h2>
              <p class="text-xs text-sage-dark/55">{formatAnnouncementDate(item.createdAt)}</p>
            </div>
            <p class="mt-3 whitespace-pre-wrap text-sm leading-relaxed text-sage-dark/80">{item.body}</p>
          </li>
        ))}
      </ul>
    )
  }
</PortalLayout>
