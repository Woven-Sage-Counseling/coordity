---
import PortalLayout from '../layouts/PortalLayout.astro';
import { formatAnnouncementDate } from '../lib/announcements';
import {
  ACTIVE_NOTIFICATIONS_LIMIT,
  CALENDAR_CONFLICT_SOURCE,
  countActiveNotifications,
  listNotificationsForUser,
} from '../lib/notifications';

export const prerender = false;

const employee = Astro.locals.employee!;
const activeTotal = await countActiveNotifications(employee.id);
const activeNotifications = await listNotificationsForUser(employee.id, ACTIVE_NOTIFICATIONS_LIMIT);
const historyNotifications = await listNotificationsForUser(employee.id, ACTIVE_NOTIFICATIONS_LIMIT, {
  clearedOnly: true,
});
const hasMoreActive = activeTotal > activeNotifications.length;
const showHistory = Astro.url.searchParams.get('history') === '1';
---

<PortalLayout title="Notifications" wide>
  <p class="text-sm text-sage-dark/65">
    <a href="/" class="hover:text-sage-dark">Home</a>
    <span class="mx-1.5 text-sage-dark/35">/</span>
    Notifications
  </p>
  <div class="mt-3 flex flex-wrap items-end justify-between gap-4">
    <div>
      <h1 class="font-display text-4xl text-charcoal sm:text-5xl">
        {showHistory ? 'Notification history' : 'Notifications'}
      </h1>
      <p class="mt-3 max-w-2xl text-sage-dark/75">
        {
          showHistory
            ? 'Cleared alerts stay here until you delete them. Schedule conflicts are not cleared — use Hide/Unhide on those.'
            : 'Active alerts. Schedule conflicts use Hide/Unhide; other alerts can be cleared into history. Cleared alerts move to history — reload will not bring them back unless a new alert is created.'
        }
      </p>
    </div>
    {
      showHistory ? (
        <a
          href="/notifications"
          class="rounded-full border border-sage-dark/20 px-3 py-1.5 text-sm font-semibold text-sage-dark transition hover:border-sage-dark/35 hover:bg-sage/10"
        >
          Back to active
        </a>
      ) : (
        <a
          href="/notifications?history=1"
          class="rounded-full border border-sage-dark/20 px-3 py-1.5 text-sm font-semibold text-sage-dark transition hover:border-sage-dark/35 hover:bg-sage/10"
        >
          Open history
        </a>
      )
    }
  </div>

  {
    showHistory ? (
      historyNotifications.length === 0 ? (
        <p class="mt-10 text-sm text-sage-dark/65">No cleared notifications yet.</p>
      ) : (
        <ul class="mt-10 space-y-4" data-notifications-history>
          {historyNotifications.map((item) => (
            <li
              class="rounded-2xl border border-sage-dark/10 bg-white/60 p-5 shadow-sm"
              data-notification-item
              data-notification-id={item.id}
            >
              <div class="flex flex-wrap items-baseline justify-between gap-x-3 gap-y-1">
                <h2 class="text-lg font-semibold text-charcoal">{item.title}</h2>
                <div class="flex items-center gap-3">
                  <p class="text-xs text-sage-dark/55">{formatAnnouncementDate(item.createdAt)}</p>
                  <button
                    type="button"
                    class="rounded-md px-2 py-1 text-xs font-semibold text-red-700 ring-1 ring-red-200 transition hover:bg-red-50"
                    data-notification-delete
                  >
                    Delete
                  </button>
                </div>
              </div>
              <p class="mt-3 whitespace-pre-wrap text-sm leading-relaxed text-sage-dark/80">{item.body}</p>
            </li>
          ))}
        </ul>
      )
    ) : activeNotifications.length === 0 ? (
      <p class="mt-10 text-sm text-sage-dark/65">
        No active notifications.{' '}
        <a href="/notifications?history=1" class="font-semibold text-sage-dark hover:text-charcoal">
          Open history
        </a>
      </p>
    ) : (
      <>
        {
          hasMoreActive ? (
            <p class="mt-6 rounded-xl border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-900">
              Showing {activeNotifications.length} of {activeTotal} active notifications. Clear more or use Clear all below.
            </p>
          ) : null
        }
        <div class="mt-6 flex flex-wrap items-center justify-between gap-3">
          <p class="text-sm text-sage-dark/65">
            {activeTotal} active notification{activeTotal === 1 ? '' : 's'}
            {activeNotifications.some((item) => item.sourceType === CALENDAR_CONFLICT_SOURCE)
              ? ' · schedule conflicts stay until hidden'
              : ''}
          </p>
          <button
            type="button"
            class="btn-secondary !px-3 !py-1.5 text-sm"
            data-notifications-clear-all
          >
            Clear all
          </button>
        </div>
        <ul class="mt-4 space-y-4" data-notifications-page>
        {activeNotifications.map((item) => {
          const isConflict = item.sourceType === CALENDAR_CONFLICT_SOURCE;
          return (
            <li
              class:list={[
                'rounded-2xl border border-sage-dark/10 bg-white/80 p-5 shadow-sm',
                item.unread && 'ring-1 ring-red-200',
              ]}
              data-notification-item
              data-notification-id={item.id}
              data-source-type={item.sourceType ?? ''}
            >
              <div class="flex flex-wrap items-baseline justify-between gap-x-3 gap-y-1">
                <div class="flex min-w-0 items-center gap-2">
                  <span
                    class:list={[
                      'h-2 w-2 shrink-0 rounded-full',
                      item.unread ? 'bg-red-500' : 'bg-transparent',
                    ]}
                    data-unread-dot
                    aria-hidden="true"
                  ></span>
                  <h2 class="text-lg font-semibold text-charcoal">{item.title}</h2>
                </div>
                <div class="flex items-center gap-3">
                  <p class="text-xs text-sage-dark/55">{formatAnnouncementDate(item.createdAt)}</p>
                  {
                    isConflict ? (
                      <button
                        type="button"
                        class="rounded-md px-2 py-1 text-xs font-semibold text-sage-dark ring-1 ring-sage-dark/20 transition hover:bg-sage/10 hover:text-charcoal"
                        data-notification-toggle
                        data-unread={item.unread ? '1' : '0'}
                      >
                        {item.unread ? 'Hide' : 'Unhide'}
                      </button>
                    ) : (
                      <button
                        type="button"
                        class="rounded-md px-2 py-1 text-xs font-semibold text-sage-dark ring-1 ring-sage-dark/20 transition hover:bg-sage/10 hover:text-charcoal"
                        data-notification-clear
                      >
                        Clear
                      </button>
                    )
                  }
                </div>
              </div>
              <p class="mt-3 whitespace-pre-wrap text-sm leading-relaxed text-sage-dark/80">{item.body}</p>
            </li>
          );
        })}
        </ul>
      </>
    )
  }
</PortalLayout>

<script>
  document.querySelector('[data-notifications-clear-all]')?.addEventListener('click', async (event) => {
    const button = event.currentTarget;
    if (!(button instanceof HTMLButtonElement)) return;
    if (!window.confirm('Clear all notifications except schedule conflicts? They will move to history.')) return;

    button.disabled = true;
    const previousLabel = button.textContent ?? 'Clear all';
    button.textContent = 'Clearing…';

    try {
      await fetch('/api/notifications/clear', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ all: true }),
      });
      window.location.href = '/notifications';
    } catch {
      button.disabled = false;
      button.textContent = previousLabel;
    }
  });

  document.querySelectorAll('[data-notifications-page] [data-notification-toggle]').forEach((button) => {
    button.addEventListener('click', async () => {
      const item = button.closest('[data-notification-item]');
      if (!(item instanceof HTMLElement) || !(button instanceof HTMLButtonElement)) return;
      const id = item.dataset.notificationId;
      if (!id) return;
      const currentlyUnread = button.dataset.unread === '1';
      const nextUnread = !currentlyUnread;
      button.disabled = true;
      try {
        await fetch('/api/notifications/mark-read', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ ids: [id], unread: nextUnread }),
        });
        button.dataset.unread = nextUnread ? '1' : '0';
        button.textContent = nextUnread ? 'Hide' : 'Unhide';
        item.classList.toggle('ring-1', nextUnread);
        item.classList.toggle('ring-red-200', nextUnread);
        const dot = item.querySelector('[data-unread-dot]');
        if (dot instanceof HTMLElement) {
          dot.classList.toggle('bg-red-500', nextUnread);
          dot.classList.toggle('bg-transparent', !nextUnread);
        }
      } catch {
        // keep previous state
      } finally {
        button.disabled = false;
      }
    });
  });

  document.querySelectorAll('[data-notifications-page] [data-notification-clear]').forEach((button) => {
    button.addEventListener('click', async () => {
      const item = button.closest('[data-notification-item]');
      if (!(item instanceof HTMLElement) || !(button instanceof HTMLButtonElement)) return;
      const id = item.dataset.notificationId;
      if (!id) return;
      button.disabled = true;
      try {
        await fetch('/api/notifications/clear', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ ids: [id] }),
        });
        item.remove();
        const list = document.querySelector('[data-notifications-page]');
        if (list && list.querySelectorAll('[data-notification-item]').length === 0) {
          list.outerHTML =
            '<p class="mt-10 text-sm text-sage-dark/65">No active notifications. <a href="/notifications?history=1" class="font-semibold text-sage-dark hover:text-charcoal">Open history</a></p>';
        }
      } catch {
        button.disabled = false;
      }
    });
  });

  document.querySelectorAll('[data-notifications-history] [data-notification-delete]').forEach((button) => {
    button.addEventListener('click', async () => {
      const item = button.closest('[data-notification-item]');
      if (!(item instanceof HTMLElement) || !(button instanceof HTMLButtonElement)) return;
      const id = item.dataset.notificationId;
      if (!id) return;
      button.disabled = true;
      try {
        await fetch('/api/notifications/delete', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ ids: [id] }),
        });
        item.remove();
        const list = document.querySelector('[data-notifications-history]');
        if (list && list.querySelectorAll('[data-notification-item]').length === 0) {
          list.outerHTML = '<p class="mt-10 text-sm text-sage-dark/65">No cleared notifications yet.</p>';
        }
      } catch {
        button.disabled = false;
      }
    });
  });
</script>
