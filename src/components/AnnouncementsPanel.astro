---
import type { Announcement } from '../lib/announcements';
import { formatAnnouncementDate } from '../lib/announcements';

interface Props {
  announcements: Announcement[];
  canManage: boolean;
  error?: string | null;
}

const { announcements, canManage, error = null } = Astro.props;
---

<section class="mt-10" aria-labelledby="announcements-heading">
  <div class="flex flex-wrap items-end justify-between gap-3">
    <h2 id="announcements-heading" class="font-display text-3xl text-charcoal">Announcements</h2>
  </div>

  {
    error && (
      <p class="mt-4 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800">{error}</p>
    )
  }

  {
    canManage && (
      <form
        method="post"
        action="/api/announcements/create"
        class="announcement-glass mt-4 rounded-2xl p-4"
      >
        <label class="block">
          <span class="text-sm font-medium text-sage-dark/80">Title</span>
          <input class="field !bg-white/70" type="text" name="title" maxlength="120" required placeholder="Short headline" />
        </label>
        <label class="mt-3 block">
          <span class="text-sm font-medium text-sage-dark/80">Message</span>
          <textarea
            class="field min-h-[5.5rem] resize-y !bg-white/70"
            name="body"
            maxlength="2000"
            required
            placeholder="What should the team know?"
          ></textarea>
        </label>
        <button class="btn-primary mt-3" type="submit">Post announcement</button>
      </form>
    )
  }

  {
    announcements.length === 0 ? (
      <div class="announcement-glass mt-4 rounded-2xl px-4 py-5">
        <p class="text-sm text-sage-dark/70">No announcements right now.</p>
      </div>
    ) : (
      <ul class="mt-4 space-y-3">
        {announcements.map((item) => (
          <li class="announcement-glass rounded-2xl p-4">
            <div class="flex flex-wrap items-start justify-between gap-3">
              <div class="min-w-0">
                <h3 class="font-display text-xl text-charcoal">{item.title}</h3>
                <p class="mt-1 text-xs text-sage-dark/60">
                  {item.authorName} · {formatAnnouncementDate(item.createdAt)}
                </p>
              </div>
              {canManage && (
                <form method="post" action="/api/announcements/archive">
                  <input type="hidden" name="id" value={item.id} />
                  <button
                    class="rounded-full border border-white/50 bg-white/40 px-3 py-1.5 text-xs font-medium text-sage-dark backdrop-blur-sm transition hover:bg-white/70"
                    type="submit"
                  >
                    Remove
                  </button>
                </form>
              )}
            </div>
            <p class="mt-3 whitespace-pre-wrap text-sm leading-relaxed text-sage-dark/85">{item.body}</p>
          </li>
        ))}
      </ul>
    )
  }
</section>

<style>
  .announcement-glass {
    background:
      linear-gradient(145deg, rgba(255, 255, 255, 0.55), rgba(152, 169, 149, 0.18) 45%, rgba(111, 127, 108, 0.22)),
      rgba(232, 240, 230, 0.45);
    border: 1px solid rgba(255, 255, 255, 0.55);
    box-shadow:
      0 10px 30px rgba(79, 98, 74, 0.12),
      inset 0 1px 0 rgba(255, 255, 255, 0.65);
    backdrop-filter: blur(18px) saturate(1.35);
    -webkit-backdrop-filter: blur(18px) saturate(1.35);
  }
</style>
