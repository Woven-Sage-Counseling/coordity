---
import type { Announcement } from '../lib/announcements';
import { formatAnnouncementDate } from '../lib/announcements';

interface Props {
  announcements: Announcement[];
  unreadCount: number;
  canManage: boolean;
  error?: string | null;
}

const { announcements, unreadCount, canManage, error = null } = Astro.props;
const hasUnread = unreadCount > 0;
const latest = announcements[0] ?? null;
---

<section class="relative mt-10" aria-labelledby="feed-heading" data-feed-panel>
  <div class="announcement-bar overflow-hidden rounded-[1.35rem]">
    <div class="flex flex-wrap items-center justify-between gap-3 border-b border-black/[0.06] px-4 py-3 sm:px-5">
      <h2 id="feed-heading" class="sr-only">Announcements and notifications</h2>
      <div
        class="inline-flex rounded-full bg-black/[0.06] p-1"
        role="tablist"
        aria-label="Feed view"
      >
        <button
          type="button"
          role="tab"
          id="tab-announcements"
          aria-controls="panel-announcements"
          aria-selected="true"
          class="rounded-full px-3.5 py-1.5 text-sm font-semibold text-charcoal transition"
          data-feed-tab="announcements"
        >
          Announcements
        </button>
        <button
          type="button"
          role="tab"
          id="tab-notifications"
          aria-controls="panel-notifications"
          aria-selected="false"
          class="relative rounded-full px-3.5 py-1.5 text-sm font-medium text-sage-dark/70 transition"
          data-feed-tab="notifications"
        >
          Notifications
          {
            hasUnread && (
              <span
                class="ml-1.5 inline-flex h-5 min-w-5 items-center justify-center rounded-full bg-[#2CA01C] px-1 text-[10px] font-bold text-white"
                data-unread-badge
              >
                {unreadCount > 9 ? '9+' : unreadCount}
              </span>
            )
          }
        </button>
      </div>
      <p class="text-[11px] text-sage-dark/60" data-feed-status>
        {latest
          ? `${latest.authorName} · ${formatAnnouncementDate(latest.createdAt)}`
          : 'Nothing posted yet'}
      </p>
    </div>

    <div
      id="panel-announcements"
      role="tabpanel"
      aria-labelledby="tab-announcements"
      class="px-5 py-4 sm:px-6"
      data-feed-panel-view="announcements"
    >
      {
        latest ? (
          <div class="min-w-0">
            <p class="truncate text-[15px] font-medium text-charcoal">{latest.title}</p>
            <p class="mt-1 line-clamp-2 text-sm leading-relaxed text-sage-dark/80">{latest.body}</p>
            {announcements.length > 1 && (
              <ul class="mt-4 space-y-3 border-t border-black/[0.06] pt-4">
                {announcements.slice(1, 4).map((item) => (
                  <li class="min-w-0">
                    <p class="truncate text-sm font-medium text-charcoal">{item.title}</p>
                    <p class="mt-0.5 line-clamp-1 text-xs text-sage-dark/70">
                      {item.authorName} · {formatAnnouncementDate(item.createdAt)}
                    </p>
                  </li>
                ))}
              </ul>
            )}
          </div>
        ) : (
          <p class="text-sm text-sage-dark/75">No announcements right now.</p>
        )
      }
    </div>

    <div
      id="panel-notifications"
      role="tabpanel"
      aria-labelledby="tab-notifications"
      class="hidden"
      data-feed-panel-view="notifications"
      hidden
    >
      {
        announcements.length === 0 ? (
          <p class="px-5 py-5 text-sm text-sage-dark/70 sm:px-6">No notifications right now.</p>
        ) : (
          <ul class="max-h-80 overflow-y-auto">
            {announcements.map((item) => (
              <li
                class:list={[
                  'border-b border-black/[0.05] px-5 py-3 last:border-0 sm:px-6',
                  item.unread && 'bg-white/40',
                ]}
                data-notification-item
              >
                <div class="flex items-start gap-2">
                  {item.unread ? (
                    <span
                      class="mt-1.5 h-2 w-2 shrink-0 rounded-full bg-[#2CA01C]"
                      aria-hidden="true"
                      data-unread-dot
                    ></span>
                  ) : (
                    <span
                      class="mt-1.5 h-2 w-2 shrink-0 rounded-full bg-transparent"
                      aria-hidden="true"
                      data-unread-dot
                    ></span>
                  )}
                  <div class="min-w-0">
                    <p class="text-sm font-semibold text-charcoal">{item.title}</p>
                    <p class="mt-0.5 text-[11px] text-sage-dark/55">
                      {item.authorName} · {formatAnnouncementDate(item.createdAt)}
                    </p>
                    <p class="mt-1.5 line-clamp-3 text-sm leading-relaxed text-sage-dark/80">{item.body}</p>
                  </div>
                </div>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </div>

  {
    error && (
      <p class="mt-4 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800">{error}</p>
    )
  }

  {
    canManage && (
      <form
        method="post"
        action="/api/announcements/create"
        class="announcement-bar mt-4 rounded-[1.35rem] p-4"
      >
        <label class="block">
          <span class="text-sm font-medium text-sage-dark/80">Title</span>
          <input
            class="field !border-white/40 !bg-white/55"
            type="text"
            name="title"
            maxlength="120"
            required
            placeholder="Short headline"
          />
        </label>
        <label class="mt-3 block">
          <span class="text-sm font-medium text-sage-dark/80">Message</span>
          <textarea
            class="field min-h-[5.5rem] resize-y !border-white/40 !bg-white/55"
            name="body"
            maxlength="2000"
            required
            placeholder="What should the team know?"
          ></textarea>
        </label>
        <button class="btn-primary mt-3" type="submit">Post announcement</button>
      </form>
    )
  }
</section>

<style>
  .announcement-bar {
    background: linear-gradient(
      165deg,
      rgba(255, 255, 255, 0.72) 0%,
      rgba(244, 245, 248, 0.62) 45%,
      rgba(227, 229, 232, 0.55) 100%
    );
    border: 1px solid rgba(255, 255, 255, 0.7);
    box-shadow:
      0 1px 1px rgba(255, 255, 255, 0.85) inset,
      0 -1px 1px rgba(57, 58, 61, 0.05) inset,
      0 10px 28px rgba(57, 58, 61, 0.08),
      0 2px 6px rgba(57, 58, 61, 0.04);
    backdrop-filter: blur(28px) saturate(150%);
    -webkit-backdrop-filter: blur(28px) saturate(150%);
  }
</style>

<script>
  function setupFeedPanel(root: Element) {
    const tabs = Array.from(root.querySelectorAll('[data-feed-tab]'));
    const views = {
      announcements: root.querySelector('[data-feed-panel-view="announcements"]'),
      notifications: root.querySelector('[data-feed-panel-view="notifications"]'),
    } as const;
    const status = root.querySelector('[data-feed-status]');
    if (!(views.announcements instanceof HTMLElement) || !(views.notifications instanceof HTMLElement)) {
      return;
    }

    let marked = false;
    let active: 'announcements' | 'notifications' = 'announcements';

    const setTabStyles = (tab: Element, selected: boolean) => {
      tab.setAttribute('aria-selected', selected ? 'true' : 'false');
      if (selected) {
        tab.classList.add('bg-white', 'text-charcoal', 'shadow-sm', 'font-semibold');
        tab.classList.remove('text-sage-dark/70', 'font-medium');
      } else {
        tab.classList.remove('bg-white', 'text-charcoal', 'shadow-sm', 'font-semibold');
        tab.classList.add('text-sage-dark/70', 'font-medium');
      }
    };

    // Initial selected styles
    tabs.forEach((tab) => {
      const key = tab.getAttribute('data-feed-tab');
      setTabStyles(tab, key === 'announcements');
    });

    const markRead = async () => {
      if (marked) return;
      marked = true;
      try {
        await fetch('/api/announcements/mark-read', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({}),
        });
        root.querySelector('[data-unread-badge]')?.remove();
        root.querySelectorAll('[data-notification-item]').forEach((el) => el.classList.remove('bg-white/40'));
        root.querySelectorAll('[data-unread-dot]').forEach((el) => {
          el.classList.remove('bg-[#2CA01C]');
          el.classList.add('bg-transparent');
        });
        if (status && active === 'notifications') {
          status.textContent = 'You are caught up';
        }
      } catch {
        marked = false;
      }
    };

    const setActive = (next: 'announcements' | 'notifications') => {
      active = next;
      for (const [key, view] of Object.entries(views)) {
        const show = key === next;
        view.hidden = !show;
        view.classList.toggle('hidden', !show);
      }
      tabs.forEach((tab) => {
        setTabStyles(tab, tab.getAttribute('data-feed-tab') === next);
      });
      if (status instanceof HTMLElement) {
        if (next === 'notifications') {
          const badge = root.querySelector('[data-unread-badge]');
          status.textContent = badge ? `${badge.textContent?.trim() ?? ''} new` : 'You are caught up';
          void markRead();
        } else {
          status.textContent = status.dataset.announcementsStatus ?? status.textContent;
        }
      }
    };

    if (status instanceof HTMLElement) {
      status.dataset.announcementsStatus = status.textContent ?? '';
    }

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const key = tab.getAttribute('data-feed-tab');
        if (key === 'announcements' || key === 'notifications') setActive(key);
      });
    });
  }

  document.querySelectorAll('[data-feed-panel]').forEach((root) => setupFeedPanel(root));
</script>
