---
import type { Announcement } from '../lib/announcements';
import { formatAnnouncementDate } from '../lib/announcements';
import { CALENDAR_CONFLICT_SOURCE, TIME_OFF_REQUEST_SOURCE, type PortalNotification } from '../lib/notifications';

interface Props {
  announcements: Announcement[];
  announcementUnreadCount: number;
  notifications: PortalNotification[];
  notificationUnreadCount: number;
  canSeeAdmin?: boolean;
}

const {
  announcements,
  announcementUnreadCount,
  notifications,
  notificationUnreadCount,
  canSeeAdmin = false,
} = Astro.props;
const latest = announcements[0] ?? null;
const hasAnnouncementUnread = announcementUnreadCount > 0;
const hasNotificationUnread = notificationUnreadCount > 0;
---

<section class="relative mt-10" aria-labelledby="feed-heading" data-feed-panel>
  <div class="announcement-bar overflow-hidden rounded-[1.35rem]">
    <div class="flex flex-wrap items-center justify-between gap-3 border-b border-black/[0.06] px-4 py-3 sm:px-5">
      <h2 id="feed-heading" class="sr-only">Announcements and notifications</h2>
      <div
        class="relative inline-flex rounded-full bg-black/[0.06] p-1"
        role="tablist"
        aria-label="Feed view"
        data-feed-tablist
      >
        <span
          class="pointer-events-none absolute top-1 bottom-1 left-0 rounded-full bg-white shadow-sm transition-transform duration-300 ease-[cubic-bezier(0.22,1,0.36,1)] will-change-transform"
          data-feed-slider
          aria-hidden="true"
        ></span>
        <button
          type="button"
          role="tab"
          id="tab-announcements"
          aria-controls="panel-announcements"
          aria-selected="true"
          class="relative z-10 inline-flex items-center gap-1.5 rounded-full px-3.5 py-1.5 text-sm font-semibold text-charcoal transition-colors duration-300"
          data-feed-tab="announcements"
        >
          Announcements
          {
            hasAnnouncementUnread && (
              <span
                class="inline-flex h-5 min-w-5 items-center justify-center rounded-full bg-red-500 px-1 text-[10px] font-bold text-white"
                data-unread-badge="announcements"
              >
                {announcementUnreadCount > 9 ? '9+' : announcementUnreadCount}
              </span>
            )
          }
        </button>
        <button
          type="button"
          role="tab"
          id="tab-notifications"
          aria-controls="panel-notifications"
          aria-selected="false"
          class="relative z-10 inline-flex items-center gap-1.5 rounded-full px-3.5 py-1.5 text-sm font-medium text-sage-dark/70 transition-colors duration-300"
          data-feed-tab="notifications"
        >
          Notifications
          {
            hasNotificationUnread && (
              <span
                class="inline-flex h-5 min-w-5 items-center justify-center rounded-full bg-red-500 px-1 text-[10px] font-bold text-white"
                data-unread-badge="notifications"
              >
                {notificationUnreadCount > 9 ? '9+' : notificationUnreadCount}
              </span>
            )
          }
        </button>
      </div>
      <p class="text-[11px] text-sage-dark/60" data-feed-status hidden>
        You are caught up
      </p>
    </div>

    <div class="relative overflow-hidden" data-feed-stage>
      <div
        id="panel-announcements"
        role="tabpanel"
        aria-labelledby="tab-announcements"
        class="px-5 py-4 sm:px-6"
        data-feed-panel-view="announcements"
      >
        {
          latest ? (
            <div class="min-w-0">
              <div class="flex items-start justify-between gap-3">
                <p class="min-w-0 flex-1 truncate text-[15px] font-medium text-charcoal">{latest.title}</p>
                <p class="shrink-0 text-right text-[11px] leading-snug text-sage-dark/60">
                  Posted by: {latest.authorName} · {formatAnnouncementDate(latest.createdAt)}
                </p>
              </div>
              <p class="mt-1 line-clamp-2 text-sm leading-relaxed text-sage-dark/80">{latest.body}</p>
              {announcements.length > 1 && (
                <ul class="mt-4 space-y-3 border-t border-black/[0.06] pt-4">
                  {announcements.slice(1, 4).map((item) => (
                    <li class="min-w-0">
                      <div class="flex items-start justify-between gap-3">
                        <p class="min-w-0 flex-1 truncate text-sm font-medium text-charcoal">{item.title}</p>
                        <p class="shrink-0 text-right text-[11px] leading-snug text-sage-dark/60">
                          Posted by: {item.authorName} · {formatAnnouncementDate(item.createdAt)}
                        </p>
                      </div>
                    </li>
                  ))}
                </ul>
              )}
            </div>
          ) : (
            <p class="text-sm text-sage-dark/75">No announcements right now.</p>
          )
        }
      </div>

      <div
        id="panel-notifications"
        role="tabpanel"
        aria-labelledby="tab-notifications"
        class="hidden"
        data-feed-panel-view="notifications"
        hidden
      >
        {
          notifications.length === 0 ? (
            <p class="px-5 py-4 text-sm text-sage-dark/70 sm:px-6">No notifications right now.</p>
          ) : (
            <ul class="max-h-80 overflow-y-auto">
              {notifications.map((item) => {
                const isConflict = item.sourceType === CALENDAR_CONFLICT_SOURCE;
                const isTimeOff = item.sourceType === TIME_OFF_REQUEST_SOURCE;
                const isTimeOffDecision =
                  isTimeOff &&
                  typeof item.sourceId === 'string' &&
                  (item.sourceId.endsWith(':approved') || item.sourceId.endsWith(':denied'));
                return (
                  <li
                    class:list={[
                      'border-b border-black/[0.05] px-5 py-3 last:border-0 sm:px-6',
                      item.unread && 'bg-white/40',
                    ]}
                    data-notification-item
                    data-notification-id={item.id}
                    data-source-type={item.sourceType ?? ''}
                  >
                    <div class="flex items-start gap-2">
                      {item.unread ? (
                        <span
                          class="mt-1.5 h-2 w-2 shrink-0 rounded-full bg-red-500"
                          aria-hidden="true"
                          data-unread-dot
                        ></span>
                      ) : (
                        <span
                          class="mt-1.5 h-2 w-2 shrink-0 rounded-full bg-transparent"
                          aria-hidden="true"
                          data-unread-dot
                        ></span>
                      )}
                      <div class="min-w-0 flex-1">
                        <div class="flex items-start justify-between gap-3">
                          <div class="min-w-0">
                            <p class="text-sm font-semibold text-charcoal">{item.title}</p>
                            <p class="mt-0.5 text-[11px] text-sage-dark/55">
                              {formatAnnouncementDate(item.createdAt)}
                            </p>
                          </div>
                          {
                            isConflict ? (
                              <button
                                type="button"
                                class="shrink-0 rounded-md px-2 py-1 text-[11px] font-semibold text-sage-dark ring-1 ring-sage-dark/20 transition hover:bg-sage/10 hover:text-charcoal"
                                data-notification-toggle
                                data-unread={item.unread ? '1' : '0'}
                              >
                                {item.unread ? 'Hide' : 'Unhide'}
                              </button>
                            ) : (
                              <button
                                type="button"
                                class="shrink-0 rounded-md px-2 py-1 text-[11px] font-semibold text-sage-dark ring-1 ring-sage-dark/20 transition hover:bg-sage/10 hover:text-charcoal"
                                data-notification-clear
                              >
                                Clear
                              </button>
                            )
                          }
                        </div>
                        <p class="mt-1.5 line-clamp-2 text-sm leading-relaxed text-sage-dark/80">{item.body}</p>
                        {
                          isTimeOffDecision ? (
                            <a
                              href="/time-off"
                              class="mt-2 inline-block text-[11px] font-semibold text-sage-dark/70 transition hover:text-charcoal"
                            >
                              View time off
                            </a>
                          ) : isTimeOff && canSeeAdmin ? (
                            <a
                              href="/admin#time-off-requests"
                              class="mt-2 inline-block text-[11px] font-semibold text-sage-dark/70 transition hover:text-charcoal"
                            >
                              Review in Admin
                            </a>
                          ) : null
                        }
                      </div>
                    </div>
                  </li>
                );
              })}
            </ul>
          )
        }
      </div>
    </div>

    <div class="flex justify-end border-t border-black/[0.06] px-4 py-2.5 sm:px-5">
      <a
        href="/announcements"
        class="text-[11px] font-semibold text-sage-dark hover:text-charcoal"
        data-view-all
      >
        View history
      </a>
    </div>
  </div>

  {
    canSeeAdmin && (
      <div class="mt-2 flex justify-center">
        <a
          href="/admin#post-announcement"
          class="rounded-full border border-sage-dark/20 bg-transparent px-2.5 py-1 text-[11px] font-semibold text-sage-dark/75 transition hover:border-sage-dark/35 hover:bg-sage/10 hover:text-sage-dark"
        >
          Create new announcement
        </a>
      </div>
    )
  }
</section>

<style>
  .announcement-bar {
    background: linear-gradient(
      165deg,
      rgba(255, 255, 255, 0.72) 0%,
      rgba(244, 245, 248, 0.62) 45%,
      rgba(227, 229, 232, 0.55) 100%
    );
    border: 1px solid rgba(255, 255, 255, 0.7);
    box-shadow:
      0 1px 1px rgba(255, 255, 255, 0.85) inset,
      0 -1px 1px rgba(57, 58, 61, 0.05) inset,
      0 10px 28px rgba(57, 58, 61, 0.08),
      0 2px 6px rgba(57, 58, 61, 0.04);
    backdrop-filter: blur(28px) saturate(150%);
    -webkit-backdrop-filter: blur(28px) saturate(150%);
  }
</style>

<script>
  function setupFeedPanel(root: Element) {
    const tablist = root.querySelector('[data-feed-tablist]');
    const slider = root.querySelector('[data-feed-slider]');
    const tabs = Array.from(root.querySelectorAll('[data-feed-tab]'));
    const announcementsView = root.querySelector('[data-feed-panel-view="announcements"]');
    const notificationsView = root.querySelector('[data-feed-panel-view="notifications"]');
    const status = root.querySelector('[data-feed-status]');
    const viewAll = root.querySelector('[data-view-all]');
    if (
      !(tablist instanceof HTMLElement) ||
      !(slider instanceof HTMLElement) ||
      !(announcementsView instanceof HTMLElement) ||
      !(notificationsView instanceof HTMLElement)
    ) {
      return;
    }

    let active: 'announcements' | 'notifications' = 'announcements';
    let announcementsMarked = false;

    const syncViewAll = (key: 'announcements' | 'notifications') => {
      if (!(viewAll instanceof HTMLAnchorElement)) return;
      if (key === 'notifications') {
        viewAll.href = '/notifications?history=1';
        viewAll.textContent = 'Open history';
      } else {
        viewAll.href = '/announcements';
        viewAll.textContent = 'Open history';
      }
    };

    const setTabStyles = (tab: Element, selected: boolean) => {
      tab.setAttribute('aria-selected', selected ? 'true' : 'false');
      if (selected) {
        tab.classList.add('text-charcoal', 'font-semibold');
        tab.classList.remove('text-sage-dark/70', 'font-medium');
      } else {
        tab.classList.remove('text-charcoal', 'font-semibold');
        tab.classList.add('text-sage-dark/70', 'font-medium');
      }
    };

    const moveSlider = (key: 'announcements' | 'notifications') => {
      const tab = tabs.find((el) => el.getAttribute('data-feed-tab') === key);
      if (!(tab instanceof HTMLElement)) return;
      const listRect = tablist.getBoundingClientRect();
      const tabRect = tab.getBoundingClientRect();
      const offset = tabRect.left - listRect.left;
      slider.style.width = `${tabRect.width}px`;
      slider.style.transform = `translateX(${offset}px)`;
    };

    const clearBadge = (key: 'announcements' | 'notifications') => {
      root.querySelector(`[data-unread-badge="${key}"]`)?.remove();
      requestAnimationFrame(() => moveSlider(active));
    };

    const refreshNotificationStatus = () => {
      if (!(status instanceof HTMLElement) || active !== 'notifications') return;
      status.hidden = false;
      const unreadLeft = root.querySelectorAll('[data-notification-item] [data-unread-dot].bg-red-500').length;
      status.textContent = unreadLeft > 0 ? `${unreadLeft > 9 ? '9+' : unreadLeft} new` : 'You are caught up';
      if (unreadLeft === 0) clearBadge('notifications');
    };

    const setNotificationUnreadUi = (item: HTMLElement, unread: boolean) => {
      item.classList.toggle('bg-white/40', unread);
      item.dataset.unread = unread ? '1' : '0';
      const dot = item.querySelector('[data-unread-dot]');
      if (dot instanceof HTMLElement) {
        dot.classList.toggle('bg-red-500', unread);
        dot.classList.toggle('bg-transparent', !unread);
      }
      const toggle = item.querySelector('[data-notification-toggle]');
      if (toggle instanceof HTMLButtonElement) {
        toggle.dataset.unread = unread ? '1' : '0';
        toggle.textContent = unread ? 'Hide' : 'Unhide';
        toggle.disabled = false;
      }
    };

    const syncNotificationBadge = () => {
      const remaining = root.querySelectorAll('[data-notification-item] [data-unread-dot].bg-red-500').length;
      let badge = root.querySelector('[data-unread-badge="notifications"]');
      if (remaining === 0) {
        clearBadge('notifications');
      } else if (badge instanceof HTMLElement) {
        badge.textContent = remaining > 9 ? '9+' : String(remaining);
        requestAnimationFrame(() => moveSlider(active));
      } else {
        const tab = root.querySelector('[data-feed-tab="notifications"]');
        if (tab instanceof HTMLElement) {
          const span = document.createElement('span');
          span.className =
            'inline-flex h-5 min-w-5 items-center justify-center rounded-full bg-red-500 px-1 text-[10px] font-bold text-white';
          span.setAttribute('data-unread-badge', 'notifications');
          span.textContent = remaining > 9 ? '9+' : String(remaining);
          tab.appendChild(span);
          requestAnimationFrame(() => moveSlider(active));
        }
      }
      refreshNotificationStatus();
    };

    const toggleNotification = async (item: HTMLElement) => {
      const id = item.dataset.notificationId;
      if (!id) return;
      const toggle = item.querySelector('[data-notification-toggle]');
      const currentlyUnread = toggle instanceof HTMLButtonElement
        ? toggle.dataset.unread === '1'
        : item.querySelector('[data-unread-dot].bg-red-500') != null;
      const nextUnread = !currentlyUnread;
      if (toggle instanceof HTMLButtonElement) toggle.disabled = true;
      try {
        await fetch('/api/notifications/mark-read', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ ids: [id], unread: nextUnread }),
        });
        setNotificationUnreadUi(item, nextUnread);
        syncNotificationBadge();
      } catch {
        if (toggle instanceof HTMLButtonElement) toggle.disabled = false;
      }
    };

    const clearNotification = async (item: HTMLElement) => {
      const id = item.dataset.notificationId;
      if (!id) return;
      const clearButton = item.querySelector('[data-notification-clear]');
      if (clearButton instanceof HTMLButtonElement) clearButton.disabled = true;
      try {
        await fetch('/api/notifications/clear', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ ids: [id] }),
        });
        item.remove();
        const remainingItems = root.querySelectorAll('[data-notification-item]');
        if (remainingItems.length === 0) {
          const panel = root.querySelector('[data-feed-panel-view="notifications"]');
          if (panel instanceof HTMLElement) {
            panel.innerHTML =
              '<p class="px-5 py-4 text-sm text-sage-dark/70 sm:px-6">No notifications right now.</p>';
          }
        }
        syncNotificationBadge();
      } catch {
        if (clearButton instanceof HTMLButtonElement) clearButton.disabled = false;
      }
    };

    const markAnnouncementsRead = async () => {
      if (announcementsMarked) return;
      announcementsMarked = true;
      try {
        await fetch('/api/announcements/mark-read', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({}),
        });
        clearBadge('announcements');
      } catch {
        announcementsMarked = false;
      }
    };

    const setActive = (next: 'announcements' | 'notifications') => {
      active = next;
      const showAnnouncements = next === 'announcements';
      announcementsView.hidden = !showAnnouncements;
      announcementsView.classList.toggle('hidden', !showAnnouncements);
      notificationsView.hidden = showAnnouncements;
      notificationsView.classList.toggle('hidden', showAnnouncements);
      tabs.forEach((tab) => {
        setTabStyles(tab, tab.getAttribute('data-feed-tab') === next);
      });
      moveSlider(next);
      syncViewAll(next);
      if (status instanceof HTMLElement) {
        if (next === 'notifications') {
          status.hidden = false;
          refreshNotificationStatus();
        } else {
          status.hidden = true;
          void markAnnouncementsRead();
        }
      }
    };

    tabs.forEach((tab) => {
      const key = tab.getAttribute('data-feed-tab');
      setTabStyles(tab, key === 'announcements');
      tab.addEventListener('click', () => {
        if (key === 'announcements' || key === 'notifications') setActive(key);
      });
    });

    root.querySelectorAll('[data-notification-toggle]').forEach((button) => {
      button.addEventListener('click', () => {
        const item = button.closest('[data-notification-item]');
        if (item instanceof HTMLElement) void toggleNotification(item);
      });
    });

    root.querySelectorAll('[data-notification-clear]').forEach((button) => {
      button.addEventListener('click', () => {
        const item = button.closest('[data-notification-item]');
        if (item instanceof HTMLElement) void clearNotification(item);
      });
    });

    moveSlider('announcements');
    syncViewAll('announcements');
    void markAnnouncementsRead();
    window.addEventListener('resize', () => moveSlider(active));
  }

  document.querySelectorAll('[data-feed-panel]').forEach((root) => setupFeedPanel(root));
</script>
