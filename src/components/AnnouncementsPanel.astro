---
import type { Announcement } from '../lib/announcements';
import { formatAnnouncementDate } from '../lib/announcements';

interface Props {
  announcements: Announcement[];
  canManage: boolean;
  error?: string | null;
}

const { announcements, canManage, error = null } = Astro.props;
const latest = announcements[0] ?? null;
---

<section class="relative mt-10" aria-labelledby="feed-heading" data-feed-panel>
  <div class="announcement-bar overflow-hidden rounded-[1.35rem]">
    <div class="flex flex-wrap items-center justify-between gap-3 border-b border-black/[0.06] px-4 py-3 sm:px-5">
      <h2 id="feed-heading" class="sr-only">Announcements and notifications</h2>
      <div
        class="relative inline-flex rounded-full bg-black/[0.06] p-1"
        role="tablist"
        aria-label="Feed view"
        data-feed-tablist
      >
        <span
          class="pointer-events-none absolute top-1 bottom-1 left-0 rounded-full bg-white shadow-sm transition-transform duration-300 ease-[cubic-bezier(0.22,1,0.36,1)] will-change-transform"
          data-feed-slider
          aria-hidden="true"
        ></span>
        <button
          type="button"
          role="tab"
          id="tab-announcements"
          aria-controls="panel-announcements"
          aria-selected="true"
          class="relative z-10 rounded-full px-3.5 py-1.5 text-sm font-semibold text-charcoal transition-colors duration-300"
          data-feed-tab="announcements"
        >
          Announcements
        </button>
        <button
          type="button"
          role="tab"
          id="tab-notifications"
          aria-controls="panel-notifications"
          aria-selected="false"
          class="relative z-10 rounded-full px-3.5 py-1.5 text-sm font-medium text-sage-dark/70 transition-colors duration-300"
          data-feed-tab="notifications"
        >
          Notifications
        </button>
      </div>
      <p class="text-[11px] text-sage-dark/60" data-feed-status>
        {latest
          ? `${latest.authorName} · ${formatAnnouncementDate(latest.createdAt)}`
          : 'Nothing posted yet'}
      </p>
    </div>

    <div class="relative overflow-hidden" data-feed-stage>
      <div
        id="panel-announcements"
        role="tabpanel"
        aria-labelledby="tab-announcements"
        class="px-5 py-4 sm:px-6"
        data-feed-panel-view="announcements"
      >
        {
          latest ? (
            <div class="min-w-0">
              <p class="truncate text-[15px] font-medium text-charcoal">{latest.title}</p>
              <p class="mt-1 line-clamp-2 text-sm leading-relaxed text-sage-dark/80">{latest.body}</p>
              {announcements.length > 1 && (
                <ul class="mt-4 space-y-3 border-t border-black/[0.06] pt-4">
                  {announcements.slice(1, 4).map((item) => (
                    <li class="min-w-0">
                      <p class="truncate text-sm font-medium text-charcoal">{item.title}</p>
                      <p class="mt-0.5 line-clamp-1 text-xs text-sage-dark/70">
                        {item.authorName} · {formatAnnouncementDate(item.createdAt)}
                      </p>
                    </li>
                  ))}
                </ul>
              )}
            </div>
          ) : (
            <p class="text-sm text-sage-dark/75">No announcements right now.</p>
          )
        }
      </div>

      <div
        id="panel-notifications"
        role="tabpanel"
        aria-labelledby="tab-notifications"
        class="hidden px-5 py-4 sm:px-6"
        data-feed-panel-view="notifications"
        hidden
      >
        <p class="text-sm text-sage-dark/70">No notifications right now.</p>
      </div>
    </div>
  </div>

  {
    error && (
      <p class="mt-4 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800">{error}</p>
    )
  }

  {
    canManage && (
      <form
        method="post"
        action="/api/announcements/create"
        class="announcement-bar mt-4 rounded-[1.35rem] p-4"
      >
        <label class="block">
          <span class="text-sm font-medium text-sage-dark/80">Title</span>
          <input
            class="field !border-white/40 !bg-white/55"
            type="text"
            name="title"
            maxlength="120"
            required
            placeholder="Short headline"
          />
        </label>
        <label class="mt-3 block">
          <span class="text-sm font-medium text-sage-dark/80">Message</span>
          <textarea
            class="field min-h-[5.5rem] resize-y !border-white/40 !bg-white/55"
            name="body"
            maxlength="2000"
            required
            placeholder="What should the team know?"
          ></textarea>
        </label>
        <button class="btn-primary mt-3" type="submit">Post announcement</button>
      </form>
    )
  }
</section>

<style>
  .announcement-bar {
    background: linear-gradient(
      165deg,
      rgba(255, 255, 255, 0.72) 0%,
      rgba(244, 245, 248, 0.62) 45%,
      rgba(227, 229, 232, 0.55) 100%
    );
    border: 1px solid rgba(255, 255, 255, 0.7);
    box-shadow:
      0 1px 1px rgba(255, 255, 255, 0.85) inset,
      0 -1px 1px rgba(57, 58, 61, 0.05) inset,
      0 10px 28px rgba(57, 58, 61, 0.08),
      0 2px 6px rgba(57, 58, 61, 0.04);
    backdrop-filter: blur(28px) saturate(150%);
    -webkit-backdrop-filter: blur(28px) saturate(150%);
  }
</style>

<script>
  function setupFeedPanel(root: Element) {
    const tablist = root.querySelector('[data-feed-tablist]');
    const slider = root.querySelector('[data-feed-slider]');
    const tabs = Array.from(root.querySelectorAll('[data-feed-tab]'));
    const announcementsView = root.querySelector('[data-feed-panel-view="announcements"]');
    const notificationsView = root.querySelector('[data-feed-panel-view="notifications"]');
    const status = root.querySelector('[data-feed-status]');
    if (
      !(tablist instanceof HTMLElement) ||
      !(slider instanceof HTMLElement) ||
      !(announcementsView instanceof HTMLElement) ||
      !(notificationsView instanceof HTMLElement)
    ) {
      return;
    }

    let active: 'announcements' | 'notifications' = 'announcements';

    const setTabStyles = (tab: Element, selected: boolean) => {
      tab.setAttribute('aria-selected', selected ? 'true' : 'false');
      if (selected) {
        tab.classList.add('text-charcoal', 'font-semibold');
        tab.classList.remove('text-sage-dark/70', 'font-medium');
      } else {
        tab.classList.remove('text-charcoal', 'font-semibold');
        tab.classList.add('text-sage-dark/70', 'font-medium');
      }
    };

    const moveSlider = (key: 'announcements' | 'notifications') => {
      const tab = tabs.find((el) => el.getAttribute('data-feed-tab') === key);
      if (!(tab instanceof HTMLElement)) return;
      const listRect = tablist.getBoundingClientRect();
      const tabRect = tab.getBoundingClientRect();
      const offset = tabRect.left - listRect.left;
      slider.style.width = `${tabRect.width}px`;
      slider.style.transform = `translateX(${offset}px)`;
    };

    const setActive = (next: 'announcements' | 'notifications') => {
      active = next;
      const showAnnouncements = next === 'announcements';
      announcementsView.hidden = !showAnnouncements;
      announcementsView.classList.toggle('hidden', !showAnnouncements);
      notificationsView.hidden = showAnnouncements;
      notificationsView.classList.toggle('hidden', showAnnouncements);
      tabs.forEach((tab) => {
        setTabStyles(tab, tab.getAttribute('data-feed-tab') === next);
      });
      moveSlider(next);
      if (status instanceof HTMLElement) {
        if (next === 'notifications') {
          status.textContent = 'You are caught up';
        } else {
          status.textContent = status.dataset.announcementsStatus ?? status.textContent;
        }
      }
    };

    if (status instanceof HTMLElement) {
      status.dataset.announcementsStatus = status.textContent ?? '';
    }

    tabs.forEach((tab) => {
      const key = tab.getAttribute('data-feed-tab');
      setTabStyles(tab, key === 'announcements');
      tab.addEventListener('click', () => {
        if (key === 'announcements' || key === 'notifications') setActive(key);
      });
    });

    moveSlider('announcements');
    window.addEventListener('resize', () => moveSlider(active));
  }

  document.querySelectorAll('[data-feed-panel]').forEach((root) => setupFeedPanel(root));
</script>
