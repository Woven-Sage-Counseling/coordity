---
import type { Announcement } from '../lib/announcements';
import { formatAnnouncementDate } from '../lib/announcements';

interface Props {
  announcements: Announcement[];
  unreadCount: number;
  canManage: boolean;
  error?: string | null;
}

const { announcements, unreadCount, canManage, error = null } = Astro.props;
const hasUnread = unreadCount > 0;
const latest = announcements[0] ?? null;
---

<section class="relative mt-10" aria-labelledby="announcements-heading">
  <!-- Notifications: circle widget above the left side of the bar -->
  <div class="relative z-20 mb-3 flex justify-start pl-1 sm:pl-2" data-announcement-bell>
    <button
      type="button"
      class:list={[
        'notification-glass relative flex h-14 w-14 items-center justify-center rounded-full transition',
        hasUnread ? 'text-charcoal' : 'text-sage-dark/70',
      ]}
      aria-expanded="false"
      aria-controls="announcement-popover"
      aria-label={hasUnread ? `${unreadCount} unread notifications` : 'Notifications'}
      data-bell-toggle
    >
      <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path
          d="M15 17h5l-1.4-1.4A2 2 0 0 1 18 14.2V11a6 6 0 1 0-12 0v3.2c0 .5-.2 1-.6 1.4L4 17h5m6 0v1a3 3 0 1 1-6 0v-1m6 0H9"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
        ></path>
      </svg>
      {
        hasUnread && (
          <span class="absolute -right-0.5 -top-0.5 flex h-5 min-w-5 items-center justify-center rounded-full bg-[#2CA01C] px-1 text-[10px] font-bold text-white shadow-sm">
            {unreadCount > 9 ? '9+' : unreadCount}
          </span>
        )
      }
    </button>

    <div
      id="announcement-popover"
      class="notification-glass absolute left-1 top-[calc(100%+0.5rem)] z-30 hidden w-[min(22rem,calc(100vw-2.5rem))] overflow-hidden rounded-[1.35rem] sm:left-2"
      data-bell-popover
      hidden
      role="dialog"
      aria-label="Notifications"
    >
      <div class="border-b border-black/[0.06] px-4 py-3">
        <p class="text-sm font-semibold text-charcoal">Notifications</p>
        <p class="mt-0.5 text-xs text-sage-dark/60">
          {hasUnread ? `${unreadCount} new` : 'You are caught up'}
        </p>
      </div>
      {
        announcements.length === 0 ? (
          <p class="px-4 py-5 text-sm text-sage-dark/70">No notifications right now.</p>
        ) : (
          <ul class="max-h-80 overflow-y-auto">
            {announcements.map((item) => (
              <li
                class:list={[
                  'border-b border-black/[0.05] px-4 py-3 last:border-0',
                  item.unread && 'bg-white/40',
                ]}
              >
                <div class="flex items-start gap-2">
                  {item.unread ? (
                    <span class="mt-1.5 h-2 w-2 shrink-0 rounded-full bg-[#2CA01C]" aria-hidden="true"></span>
                  ) : (
                    <span class="mt-1.5 h-2 w-2 shrink-0 rounded-full bg-transparent" aria-hidden="true"></span>
                  )}
                  <div class="min-w-0">
                    <p class="text-sm font-semibold text-charcoal">{item.title}</p>
                    <p class="mt-0.5 text-[11px] text-sage-dark/55">
                      {item.authorName} · {formatAnnouncementDate(item.createdAt)}
                    </p>
                    <p class="mt-1.5 line-clamp-3 text-sm leading-relaxed text-sage-dark/80">{item.body}</p>
                  </div>
                </div>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </div>

  <!-- Announcements: sage green bar widget -->
  <div class="announcement-bar relative z-10 rounded-full px-5 py-3.5 sm:px-6 sm:py-4">
    <div class="flex min-w-0 items-center gap-4">
      <div class="min-w-0 flex-1">
        <div class="flex flex-wrap items-baseline gap-x-3 gap-y-0.5">
          <h2 id="announcements-heading" class="text-sm font-semibold tracking-wide text-charcoal">
            Announcements
          </h2>
          {
            latest && (
              <p class="text-[11px] text-sage-dark/70">
                {latest.authorName} · {formatAnnouncementDate(latest.createdAt)}
              </p>
            )
          }
        </div>
        {
          latest ? (
            <div class="mt-1 min-w-0">
              <p class="truncate text-[15px] font-medium text-charcoal">{latest.title}</p>
              <p class="mt-0.5 line-clamp-1 text-sm text-sage-dark/80">{latest.body}</p>
            </div>
          ) : (
            <p class="mt-1 text-sm text-sage-dark/75">No announcements right now.</p>
          )
        }
      </div>
    </div>
  </div>

  {
    error && (
      <p class="mt-4 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800">{error}</p>
    )
  }

  {
    canManage && (
      <form
        method="post"
        action="/api/announcements/create"
        class="notification-glass mt-4 rounded-[1.35rem] p-4"
      >
        <label class="block">
          <span class="text-sm font-medium text-sage-dark/80">Title</span>
          <input
            class="field !border-white/40 !bg-white/55"
            type="text"
            name="title"
            maxlength="120"
            required
            placeholder="Short headline"
          />
        </label>
        <label class="mt-3 block">
          <span class="text-sm font-medium text-sage-dark/80">Message</span>
          <textarea
            class="field min-h-[5.5rem] resize-y !border-white/40 !bg-white/55"
            name="body"
            maxlength="2000"
            required
            placeholder="What should the team know?"
          ></textarea>
        </label>
        <button class="btn-primary mt-3" type="submit">Post announcement</button>
      </form>
    )
  }
</section>

<style>
  .notification-glass {
    background: linear-gradient(
      165deg,
      rgba(255, 255, 255, 0.62) 0%,
      rgba(255, 255, 255, 0.28) 48%,
      rgba(246, 250, 246, 0.34) 100%
    );
    border: 1px solid rgba(255, 255, 255, 0.62);
    box-shadow:
      0 1px 1px rgba(255, 255, 255, 0.75) inset,
      0 -1px 1px rgba(60, 80, 55, 0.06) inset,
      0 10px 28px rgba(40, 55, 40, 0.1),
      0 2px 6px rgba(40, 55, 40, 0.05);
    backdrop-filter: blur(28px) saturate(185%);
    -webkit-backdrop-filter: blur(28px) saturate(185%);
  }

  .announcement-bar {
    background: linear-gradient(
      165deg,
      rgba(181, 192, 179, 0.72) 0%,
      rgba(152, 169, 149, 0.78) 45%,
      rgba(111, 127, 108, 0.7) 100%
    );
    border: 1px solid rgba(255, 255, 255, 0.45);
    box-shadow:
      0 1px 1px rgba(255, 255, 255, 0.55) inset,
      0 -1px 1px rgba(60, 80, 55, 0.12) inset,
      0 10px 28px rgba(79, 98, 74, 0.14),
      0 2px 6px rgba(79, 98, 74, 0.08);
    backdrop-filter: blur(28px) saturate(160%);
    -webkit-backdrop-filter: blur(28px) saturate(160%);
  }
</style>

<script>
  function setupAnnouncementBell(root: Element) {
    const toggle = root.querySelector('[data-bell-toggle]');
    const popover = root.querySelector('[data-bell-popover]');
    if (!(toggle instanceof HTMLButtonElement) || !(popover instanceof HTMLElement)) return;

    let open = false;
    let marked = false;

    const setOpen = async (next: boolean) => {
      open = next;
      popover.hidden = !open;
      popover.classList.toggle('hidden', !open);
      toggle.setAttribute('aria-expanded', open ? 'true' : 'false');

      if (open && !marked) {
        marked = true;
        try {
          await fetch('/api/announcements/mark-read', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({}),
          });
          const badge = toggle.querySelector('span.absolute');
          if (badge) badge.remove();
          toggle.classList.remove('text-charcoal');
          toggle.classList.add('text-sage-dark/70');
          toggle.setAttribute('aria-label', 'Notifications');
          const subtitle = popover.querySelector('.border-b p.text-xs');
          if (subtitle) subtitle.textContent = 'You are caught up';
          popover.querySelectorAll('li.bg-white\\/40').forEach((el) => el.classList.remove('bg-white/40'));
          popover.querySelectorAll('span.h-2.w-2').forEach((el) => {
            el.classList.remove('bg-[#2CA01C]');
            el.classList.add('bg-transparent');
          });
        } catch {
          marked = false;
        }
      }
    };

    toggle.addEventListener('click', (event) => {
      event.stopPropagation();
      void setOpen(!open);
    });

    document.addEventListener('click', (event) => {
      if (!open) return;
      if (event.target instanceof Node && root.contains(event.target)) return;
      void setOpen(false);
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && open) void setOpen(false);
    });
  }

  document.querySelectorAll('[data-announcement-bell]').forEach((root) => setupAnnouncementBell(root));
</script>
