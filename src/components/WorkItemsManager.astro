---
import type { TimesheetWorkCategory } from '../lib/timesheet-work-categories';

interface Props {
  categories: TimesheetWorkCategory[];
  error?: string | null;
  saved?: boolean;
  embedded?: boolean;
}

const { categories, error = null, saved = false, embedded = false } = Astro.props;
---

<section class:list={[!embedded && 'mt-10', 'scroll-mt-24']} aria-labelledby="work-items-admin" id="work-items">
  {
    !embedded ? (
      <div>
        <h2 id="work-items-admin" class="font-display text-3xl text-charcoal">Work items</h2>
        <p class="mt-2 text-sm text-sage-dark/65">
          Customize the categories employees can tag on completed shifts. Changes apply to the timesheet and work breakdown chart.
        </p>
      </div>
    ) : (
      <h2 id="work-items-admin" class="sr-only">Work items</h2>
    )
  }

  {
    error ? (
      <p class="mt-4 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800">{error}</p>
    ) : null
  }
  {
    saved ? (
      <p class="mt-4 rounded-xl border border-sage-dark/15 bg-sage/10 px-4 py-3 text-sm text-sage-dark">
        Work items updated.
      </p>
    ) : null
  }

  <form
    method="post"
    action="/api/admin/work-categories/create"
    class="mt-6 rounded-2xl border border-sage-dark/10 bg-white/80 p-5 shadow-sm"
  >
    <h3 class="text-sm font-semibold text-charcoal">Add work item</h3>
    <div class="mt-4 flex flex-wrap items-end gap-3">
      <label class="block min-w-[12rem] flex-1 text-sm">
        <span class="font-medium text-charcoal">Name</span>
        <input
          name="label"
          type="text"
          maxlength="80"
          required
          placeholder="e.g. Intake paperwork"
          class="mt-1.5 w-full rounded-xl border border-sage-dark/15 bg-white px-3 py-2 text-sm text-charcoal placeholder:text-sage-dark/45"
        />
      </label>
      <label class="block text-sm">
        <span class="font-medium text-charcoal">Color</span>
        <input
          name="color"
          type="color"
          value="#475569"
          class="mt-1.5 block h-10 w-14 cursor-pointer rounded-xl border border-sage-dark/15 bg-white p-1"
        />
      </label>
      <button class="btn-primary !px-4 !py-2" type="submit">Add</button>
    </div>
  </form>

  <div class="mt-8">
    <h3 class="text-sm font-semibold text-charcoal">Current work items</h3>
    {
      categories.length === 0 ? (
        <p class="mt-4 text-sm text-sage-dark/65">No work items yet. Add one above.</p>
      ) : (
        <div class="mt-4 space-y-3">
          {
            categories.map((category) => (
              <article class="rounded-2xl border border-sage-dark/10 bg-white/80 p-4 shadow-sm">
                <form method="post" action="/api/admin/work-categories/update" class="flex flex-wrap items-end gap-3">
                  <input type="hidden" name="id" value={category.id} />
                  <label class="block min-w-[12rem] flex-1 text-sm">
                    <span class="font-medium text-charcoal">Name</span>
                    <input
                      name="label"
                      type="text"
                      maxlength="80"
                      required
                      value={category.label}
                      class="mt-1.5 w-full rounded-xl border border-sage-dark/15 bg-white px-3 py-2 text-sm text-charcoal"
                    />
                  </label>
                  <label class="block text-sm">
                    <span class="font-medium text-charcoal">Color</span>
                    <input
                      name="color"
                      type="color"
                      value={category.color}
                      class="mt-1.5 block h-10 w-14 cursor-pointer rounded-xl border border-sage-dark/15 bg-white p-1"
                    />
                  </label>
                  <div class="flex flex-wrap items-center gap-2">
                    <button class="btn-primary !px-3 !py-2 text-sm" type="submit">Save</button>
                  </div>
                </form>
                <form method="post" action="/api/admin/work-categories/delete" class="mt-3">
                  <input type="hidden" name="id" value={category.id} />
                  <button
                    type="submit"
                    class="text-xs font-medium text-red-700 hover:text-red-900"
                    onclick="return confirm('Remove this work item? It will no longer appear on timesheets, but past shift tags are kept.')"
                  >
                    Remove
                  </button>
                </form>
              </article>
            ))
          }
        </div>
      )
    }
  </div>
</section>
