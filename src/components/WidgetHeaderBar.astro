---
import type { HomeWidgetId } from '../lib/home-widgets';
import { resolveWidgetHeaderColor, widgetHeaderForeground } from '../lib/home-widget-header';

interface Props {
  widgetId: HomeWidgetId;
  title: string;
  headingId: string;
  openHref?: string;
  openLabel?: string;
}

const { widgetId, title, headingId, openHref, openLabel = 'Open' } = Astro.props;
const background = resolveWidgetHeaderColor(widgetId);
const foreground = widgetHeaderForeground(background);
---

<div
  class="widget-header-bar px-3 py-2.5"
  data-widget-header
  data-widget-id={widgetId}
  style={`--widget-header-bg: ${background}; --widget-header-fg: ${foreground};`}
>
  <div class="flex items-center justify-between gap-2">
    <div class="flex min-w-0 items-center gap-2">
      <slot name="icon" />
      <h2 id={headingId} class="widget-header-title truncate text-sm font-semibold leading-none">
        {title}
      </h2>
      <slot name="title-extra" />
    </div>
    <div class="flex shrink-0 items-center gap-2">
      <slot name="actions" />
      {
        openHref ? (
          <a href={openHref} class="widget-header-action">
            {openLabel}
          </a>
        ) : null
      }
    </div>
  </div>
</div>

<style is:global>
  .widget-header-bar {
    background-color: var(--widget-header-bg, #535f51);
    color: var(--widget-header-fg, #f7f4ee);
  }

  .widget-header-title {
    color: var(--widget-header-fg, #f7f4ee);
  }

  .widget-header-icon {
    display: flex;
    height: 1.75rem;
    width: 1.75rem;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    border-radius: 0.375rem;
    background-color: color-mix(in srgb, var(--widget-header-fg, #f7f4ee) 15%, transparent);
    color: var(--widget-header-fg, #f7f4ee);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--widget-header-fg, #f7f4ee) 20%, transparent);
  }

  .widget-header-action {
    border-radius: 0.375rem;
    padding: 0.25rem 0.5rem;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--widget-header-fg, #f7f4ee);
    background-color: color-mix(in srgb, var(--widget-header-fg, #f7f4ee) 15%, transparent);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--widget-header-fg, #f7f4ee) 25%, transparent);
    transition: background-color 150ms ease;
  }

  .widget-header-action:hover {
    background-color: color-mix(in srgb, var(--widget-header-fg, #f7f4ee) 25%, transparent);
  }
  .widget-header-icon-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 0.375rem;
    color: var(--widget-header-fg, #f7f4ee);
    transition: background-color 150ms ease;
  }

  .widget-header-icon-btn:hover {
    background-color: color-mix(in srgb, var(--widget-header-fg, #f7f4ee) 15%, transparent);
  }
</style>
