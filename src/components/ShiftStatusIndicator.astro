---
interface Props {
  onShift: boolean;
  onTimeOff?: boolean;
  showLabel?: boolean;
  compact?: boolean;
  /** Update live when the signed-in user starts or ends a shift. */
  self?: boolean;
}

const { onShift, onTimeOff = false, showLabel = false, compact = false, self = false } = Astro.props;
const iconSize = compact ? 'size-3.5' : 'size-4';
const travelIconSize = compact ? 'size-4' : 'size-5';
const dotSize = compact ? 'size-2.5' : 'size-3';
const traveling = onTimeOff;
const available = !traveling && onShift;
const unavailable = !traveling && !onShift;
const statusLabel = traveling ? 'On vacation' : onShift ? 'Available' : 'Unavailable';
const srLabel = traveling
  ? 'Currently on vacation'
  : onShift
    ? 'Currently available'
    : 'Currently unavailable';
---

<div
  class="inline-flex items-center gap-2"
  data-shift-status
  {...self ? { 'data-shift-status-self': '' } : {}}
  data-on-shift={onShift ? '1' : '0'}
  data-on-time-off={onTimeOff ? '1' : '0'}
>
  <span class="inline-flex shrink-0 items-center justify-center" data-shift-status-icon>
    <span
      class:list={[
        'rounded-full',
        dotSize,
        'bg-emerald-500 shadow-[0_0_0_3px_rgba(16,185,129,0.25)]',
        !available && 'hidden',
      ]}
      data-shift-status-available
      aria-hidden="true"
    />
    <svg
      class:list={[iconSize, 'text-sage-dark/45', !unavailable && 'hidden']}
      data-shift-status-unavailable
      viewBox="0 0 24 24"
      fill="currentColor"
      aria-hidden="true"
    >
      <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
    </svg>
    <svg
      class:list={[travelIconSize, 'shrink-0 text-sage-dark/70', !traveling && 'hidden']}
      data-shift-status-traveling
      viewBox="0 0 24 24"
      fill="currentColor"
      aria-hidden="true"
    >
      <path
        d="M21 16v-2l-8-5V3.5C13 2.67 12.33 2 11.5 2S10 2.67 10 3.5V9l-8 5v2l8-2.5V19l-2 1.5V22l3.5-1 3.5 1v-1.5L13 19v-5.5l8 2.5z"
      />
    </svg>
  </span>
  {
    showLabel ? (
      <span class="text-sm font-medium text-sage-dark/80" data-shift-status-label>
        {statusLabel}
      </span>
    ) : null
  }
  <span class="sr-only">{srLabel}</span>
</div>
