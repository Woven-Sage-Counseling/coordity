---
interface Props {
  class?: string;
  variant?: 'light' | 'dark' | 'mark';
}

const { class: className = '', variant = 'dark' } = Astro.props;
const isLight = variant === 'light';
---

{
  variant === 'mark' ? (
    <svg
      class={className}
      viewBox="0 0 40 40"
      width="40"
      height="40"
      aria-hidden="true"
      focusable="false"
    >
      <rect width="40" height="40" rx="10" fill="#005284" />
      <text
        x="9"
        y="27"
        fill="#F5F8FB"
        font-family='"DM Sans", system-ui, sans-serif'
        font-size="20"
        font-weight="700"
      >
        C
      </text>
      <circle cx="30.5" cy="29" r="3.2" fill="#FECB00" />
    </svg>
  ) : (
    <span
      class:list={[
        'inline-flex items-baseline gap-1.5 font-sans text-[1.35rem] font-bold tracking-tight',
        isLight ? 'text-white' : 'text-coordity-blue',
        className,
      ]}
      role="img"
      aria-label="Coordity"
    >
      Coordity
      <span
        class:list={['inline-block h-2 w-2 translate-y-[-0.05em] rounded-full', isLight ? 'bg-coordity-yellow' : 'bg-coordity-yellow']}
        aria-hidden="true"
      />
    </span>
  )
}
