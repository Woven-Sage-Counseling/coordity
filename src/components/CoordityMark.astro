---
/**
 * Coordity arc mark — stylized C from the app icon.
 * Website colors: outer + inner = primary blue, middle = primary yellow.
 */
interface Props {
  class?: string;
  /** dark = colored mark on light UI; light = pale mark on dark UI; mark = icon tile */
  variant?: 'light' | 'dark' | 'mark';
  wordmark?: boolean;
}

const { class: className = '', variant = 'dark', wordmark } = Astro.props;
const showWord = wordmark ?? variant !== 'mark';
const isLight = variant === 'light';

/** Primary brand tokens */
const blue = '#005284';
const yellow = '#FECB00';

/**
 * Three concentric C-arcs (open right) with even stroke width and radius steps.
 * viewBox 0 0 48 48; center 22,24.
 */
const stroke = 3.4;
const arcs = [
  // outer
  { d: 'M33.45 12.55 A16.2 16.2 0 1 0 33.45 35.45', width: stroke },
  // middle
  { d: 'M30.48 15.52 A12.0 12.0 0 1 0 30.48 32.48', width: stroke },
  // inner
  { d: 'M27.51 18.49 A7.8 7.8 0 1 0 27.51 29.51', width: stroke },
] as const;
---

<span
  class:list={[
    'inline-flex items-center gap-2.5',
    isLight ? 'text-white' : 'text-[#005284]',
    className,
  ]}
  role="img"
  aria-label="Coordity"
>
  {
    variant === 'mark' ? (
      <svg class="h-[1.2em] w-[1.2em] shrink-0" viewBox="0 0 48 48" aria-hidden="true" focusable="false">
        <rect width="48" height="48" rx="12" fill={blue} />
        {arcs.map((arc) => (
          <path
            d={arc.d}
            fill="none"
            stroke="#FFFFFF"
            stroke-width={arc.width}
            stroke-linecap="round"
          />
        ))}
      </svg>
    ) : (
      <svg class="h-[1.25em] w-[1.25em] shrink-0" viewBox="0 0 48 48" aria-hidden="true" focusable="false">
        <path
          d={arcs[0].d}
          fill="none"
          stroke={isLight ? 'rgba(255,255,255,0.92)' : blue}
          stroke-width={arcs[0].width}
          stroke-linecap="round"
        />
        <path
          d={arcs[1].d}
          fill="none"
          stroke={isLight ? yellow : yellow}
          stroke-width={arcs[1].width}
          stroke-linecap="round"
        />
        <path
          d={arcs[2].d}
          fill="none"
          stroke={isLight ? 'rgba(255,255,255,0.92)' : blue}
          stroke-width={arcs[2].width}
          stroke-linecap="round"
        />
      </svg>
    )
  }
  {
    showWord ? (
      <span class="font-sans text-[1.05em] font-semibold tracking-[-0.02em] leading-none">Coordity</span>
    ) : null
  }
</span>
