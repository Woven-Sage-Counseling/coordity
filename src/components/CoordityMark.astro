        d="M11 27V13h6.2c3.6 0 5.8 2.1 5.8 5.1 0 3.1-2.2 5.2-5.8 5.2H15.4V27H11Zm4.4-7.2h1.6c1.5 0 2.4-.8 2.4-2.1s-.9-2.1-2.4-2.1h-1.6v4.2Z"
        fill="#F5F8FB"
