---
interface Props {
  class?: string;
  variant?: 'light' | 'dark' | 'mark';
}

const { class: className = '', variant = 'dark' } = Astro.props;
const fill = variant === 'light' ? '#F5F8FB' : '#005284';
const accent = variant === 'light' ? '#FECB00' : '#FECB00';
