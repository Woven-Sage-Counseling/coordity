---
import { listProgressTracksForUser, overallProgress } from '../lib/progress';
import { widgetAccentVarsStyle } from '../lib/home-widget-header';
import WidgetHeaderBar from './WidgetHeaderBar.astro';

interface Props {
  userId: string;
}

const { userId } = Astro.props;
const tracks = await listProgressTracksForUser(userId);
const overall = overallProgress(tracks);
---

<aside
  class="flex h-full min-h-0 max-h-full flex-col overflow-hidden rounded-[1.05rem] shadow-[0_12px_32px_rgba(26,28,30,0.12)] ring-1 ring-black/10"
  aria-labelledby="home-my-progress-heading"
  data-widget-card
  data-widget-id="my_progress"
  style={widgetAccentVarsStyle('my_progress')}
>
  <WidgetHeaderBar
    widgetId="my_progress"
    title="My progress"
    headingId="home-my-progress-heading"
    openHref="/progress"
  />

  <div class="flex min-h-0 flex-1 flex-col bg-[#f4f5f8] px-4 pb-4 pt-3 font-sans text-[#393a3d]">
    <div class="rounded-lg bg-white p-3 shadow-sm ring-1 ring-black/[0.06]">
      <div class="flex items-end justify-between gap-3">
        <div>
          <p class="text-[11px] font-semibold uppercase tracking-[0.14em] text-[#6b6c72]">Overall</p>
          <p class="mt-1 text-2xl font-semibold leading-none text-charcoal">{overall.percent}%</p>
        </div>
        <p class="text-[11px] text-[#6b6c72]">
          {overall.completed} of {overall.total} steps
        </p>
      </div>
      <div
        class="mt-3 h-2 overflow-hidden rounded-full bg-[#e3e5e8]"
        role="progressbar"
        aria-valuemin={0}
        aria-valuemax={100}
        aria-valuenow={overall.percent}
        aria-label="Overall progress"
      >
        <div class="h-full rounded-full bg-sage-dark transition-[width]" style={`width: ${overall.percent}%`}></div>
      </div>
    </div>

    <div class="mt-3 min-h-0 flex-1 space-y-2.5 overflow-y-auto overscroll-contain">
      <p class="text-[11px] font-semibold uppercase tracking-[0.14em] text-[#6b6c72]">Tracks</p>
      {
        tracks.map((track) => (
          <div class="rounded-lg bg-white px-3 py-2.5 shadow-sm ring-1 ring-black/[0.06]">
            <div class="flex items-start justify-between gap-2">
              <div class="min-w-0">
                <p class="text-[12px] font-semibold text-charcoal">{track.label}</p>
                <p class="mt-0.5 line-clamp-2 text-[10px] leading-snug text-[#6b6c72]">{track.description}</p>
              </div>
              <p class="shrink-0 text-[11px] font-semibold text-sage-dark/80">{track.percent}%</p>
            </div>
            <div
              class="mt-2 h-1.5 overflow-hidden rounded-full bg-[#e3e5e8]"
              role="progressbar"
              aria-valuemin={0}
              aria-valuemax={100}
              aria-valuenow={track.percent}
              aria-label={`${track.label} progress`}
            >
              <div
                class:list={[
                  'h-full rounded-full transition-[width]',
                  track.percent === 100 ? 'bg-emerald-600' : 'bg-sage-dark',
                ]}
                style={`width: ${track.percent}%`}
              ></div>
            </div>
            <p class="mt-1.5 text-[10px] text-[#6b6c72]">
              {track.completed} of {track.total} complete
            </p>
          </div>
        ))
      }
    </div>
  </div>
</aside>
