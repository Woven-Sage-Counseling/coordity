---
import PeriodPicker from './PeriodPicker.astro';
import FinancialAccountChecklist from './FinancialAccountChecklist.astro';
import FinancialScrollPanel from './FinancialScrollPanel.astro';
import FinancialTransactionItem from './FinancialTransactionItem.astro';
import {
  bankBalanceForAccount,
  pnlAmountForAccount,
  signedNetCents,
  transactionsForAccounts,
  type DashboardAccountChoice,
  type DashboardCard,
} from '../lib/financials/cards';
import { calendarDateValue, formatDisplayDate, formatUsd } from '../lib/financials/summary';
import type { FinancialSummary } from '../lib/financials/types';
import type { ResolvedPeriod } from '../lib/financials/periods';

interface Props {
  canManage: boolean;
  cards: DashboardCard[];
  choices: DashboardAccountChoice[];
  accountsError: string | null;
  summary: FinancialSummary;
  period: ResolvedPeriod;
  periodLabel: string | null;
  connectionError: string | null;
  needsReconnect: boolean;
  quickbooksConfigured: boolean;
  quickbooksStatus: string;
}

const {
  canManage,
  cards,
  choices,
  accountsError,
  summary,
  period,
  periodLabel,
  connectionError,
  needsReconnect,
  quickbooksConfigured,
  quickbooksStatus,
} = Astro.props;

const snapshot = summary.snapshot;
const cardByKey = new Map(cards.map((card) => [card.key, card]));
const pnlCard = cardByKey.get('pnl');
const incomeCard = cardByKey.get('income_expenses');
const balanceCard = cardByKey.get('account_balance');
const netCard = cardByKey.get('net_income');
const enabled = cards.filter((card) => card.enabled);
const incomeChoices = choices.filter((account) => account.kind === 'income');
const expenseChoices = choices.filter((account) => account.kind === 'expense');
const activityChoices = [...incomeChoices, ...expenseChoices];
const bankChoices = choices.filter((account) => account.kind === 'bank');

const expenseBars = summary.pnlLines
  .filter((line) => line.bucket !== 'income' && line.cents !== 0)
  .sort((a, b) => Math.abs(b.cents) - Math.abs(a.cents));
const incomeCents = snapshot?.revenueCents ?? 0;
const expenseTotal = summary.reportedExpensesCents ?? snapshot?.totalExpensesCents ?? 0;
const pnlScale = Math.max(incomeCents, expenseTotal, ...expenseBars.map((line) => Math.abs(line.cents)), 1);
const barWidth = (cents: number) => `${Math.round((Math.abs(cents) / pnlScale) * 100)}%`;

const incomeBlocks = incomeCard?.blocks ?? [];
const incomePieColors = ['#2CA01C', '#3d8b37', '#6aa84f', '#8fbc8f', '#4f6f52', '#7d9a78'];
const expensePieColors = ['#c4a35a', '#a9533d', '#d4a017', '#8a5a44', '#b8956a', '#6b4f3a'];

function pieFor(accounts: DashboardAccountChoice[], colors: string[]) {
  const parts = accounts.map((account, index) => ({
    account,
    cents: Math.abs(pnlAmountForAccount(summary.pnlLines, account)),
    color: colors[index % colors.length] ?? '#2CA01C',
  }));
  const total = parts.reduce((sum, part) => sum + part.cents, 0);
  let cursor = -Math.PI / 2;
  const slices = parts.map((part) => {
    const sweep = total > 0 ? (part.cents / total) * Math.PI * 2 : 0;
    const start = cursor;
    cursor += sweep;
    return { ...part, start, end: cursor };
  });
  return { slices, total, empty: total <= 0 };
}

function incomeViewLabel(view: string): string {
  if (view === 'list') return 'Detailed list';
  if (view === 'pie') return 'Pie chart';
  return 'Summary graph';
}

function piePath(start: number, end: number): string {
  const radius = 42;
  const center = 50;
  const sweep = end - start;
  if (sweep >= Math.PI * 2 - 0.0001) {
    return `M ${center} ${center - radius} A ${radius} ${radius} 0 1 1 ${center - 0.01} ${center - radius} Z`;
  }
  const x1 = center + radius * Math.cos(start);
  const y1 = center + radius * Math.sin(start);
  const x2 = center + radius * Math.cos(end);
  const y2 = center + radius * Math.sin(end);
  const large = sweep > Math.PI ? 1 : 0;
  return `M ${center} ${center} L ${x1} ${y1} A ${radius} ${radius} 0 ${large} 1 ${x2} ${y2} Z`;
}
const balanceIds = balanceCard?.accountIds ?? [];
const balanceLabels = balanceCard?.labels ?? {};
const balances = balanceIds.flatMap((id) => {
  const found = bankBalanceForAccount(summary.bankAccounts, bankChoices, id);
  if (!found) return [];
  return [{ id, name: found.name, label: balanceLabels[id] ?? '', cents: found.cents }];
});
const remainingBanks = bankChoices.filter((account) => !balanceIds.includes(account.id));
const netCents = signedNetCents(summary.pnlLines, activityChoices, netCard?.accountIds ?? []);
const palette = ['#3d8b37', '#6aa84f', '#8fbc8f', '#a8c5a0', '#c4d7b8'];

function transactionMetaLine(transaction: (typeof summary.transactions)[number]): string {
  return [formatDisplayDate(transaction.date), transaction.accountName].filter(Boolean).join(' · ');
}
---

<div
  data-financial-board
  class:list={[
    'transition-opacity',
    canManage && 'lg:grid lg:grid-cols-[minmax(17rem,22rem)_minmax(0,1fr)] lg:items-start lg:gap-8',
  ]}
>
{
  canManage && (
    <aside class="lg:sticky lg:top-6 lg:max-h-[calc(100vh-3rem)] lg:overflow-y-auto">
    <section class="rounded-2xl bg-white p-5 shadow-sm ring-1 ring-black/[0.06]" aria-labelledby="add-card-heading">
      <h2 id="add-card-heading" class="text-lg font-semibold text-charcoal">Add a card</h2>
      <p class="mt-1 text-sm leading-6 text-sage-dark/75">Check a box. That card shows up on this page. Uncheck it to take the card off.</p>
      <form method="post" action="/api/financials/cards" class="mt-4 space-y-3" data-card-picker>
        <input type="hidden" name="intent" value="layout" />
        <input type="hidden" name="period" value={period.id} />
        <input type="hidden" name="start" value={period.start} />
        <input type="hidden" name="end" value={period.end} />

        <label class="flex items-start gap-3 rounded-xl bg-[#f7f8f6] px-3 py-3 text-sm text-charcoal">
          <input class="mt-0.5" type="checkbox" name="card" value="pnl" checked={pnlCard?.enabled ?? false} />
          <span>
            <span class="font-semibold">Profit and loss</span>
            <span class="mt-0.5 block text-sage-dark/70">Bars for income and each expense.</span>
          </span>
        </label>

        <div class="rounded-xl bg-[#f7f8f6] px-3 py-3">
          <p class="text-sm font-semibold text-charcoal">Income and expenses</p>
          <p class="mt-0.5 text-sm text-sage-dark/70">Add a block for each way you want to see it. A graph, a pie chart, and a list can all be on the page.</p>
          <div class="mt-3 flex flex-wrap gap-2">
            {(['graph', 'pie', 'list'] as const).map((view) => (
              <button class="rounded-md bg-white px-3 py-1.5 text-sm font-semibold text-charcoal shadow-sm ring-1 ring-black/[0.08] hover:bg-[#f4f5f8]" type="submit" form={`add-income-${view}`}>
                {view === 'graph' ? 'Add a summary graph' : view === 'pie' ? 'Add a pie chart' : 'Add a detailed list'}
              </button>
            ))}
          </div>
        </div>

        <label class="flex items-start gap-3 rounded-xl bg-[#f7f8f6] px-3 py-3 text-sm text-charcoal">
          <input class="mt-0.5" type="checkbox" name="card" value="account_balance" checked={balanceCard?.enabled ?? false} />
          <span>
            <span class="font-semibold">Account balance</span>
            <span class="mt-0.5 block text-sage-dark/70">The money in an account right now. Add as many accounts as you want on the card.</span>
          </span>
        </label>

        <label class="flex items-start gap-3 rounded-xl bg-[#f7f8f6] px-3 py-3 text-sm text-charcoal">
          <input class="mt-0.5" type="checkbox" name="card" value="net_income" checked={netCard?.enabled ?? false} />
          <span>
            <span class="font-semibold">Net income</span>
            <span class="mt-0.5 block text-sage-dark/70">Income minus expenses. Pick which accounts count on the card.</span>
          </span>
        </label>
      </form>
      {(['graph', 'pie', 'list'] as const).map((view) => (
        <form id={`add-income-${view}`} method="post" action="/api/financials/cards" class="hidden">
          <input type="hidden" name="intent" value="add-income" />
          <input type="hidden" name="incomeView" value={view} />
          <input type="hidden" name="period" value={period.id} />
          <input type="hidden" name="start" value={period.start} />
          <input type="hidden" name="end" value={period.end} />
        </form>
      ))}
      <p class="mt-3 text-xs text-sage-dark/60">Checking a box saves it and adds the card. The income and expense buttons add another block.</p>

      {
        connectionError && (
          <p class="mt-3 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800">{connectionError}</p>
        )
      }
      {
        accountsError && (
          <p class="mt-3 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800">{accountsError}</p>
        )
      }
      {
        canManage && quickbooksConfigured && (
          <div class="mt-4 flex flex-wrap gap-2">
            <form method="post" action="/api/quickbooks/connect">
              <button class="rounded-md bg-white px-3.5 py-2 text-sm font-semibold text-charcoal shadow-sm ring-1 ring-black/[0.1] hover:bg-[#f4f5f8]" type="submit">
                {quickbooksStatus === 'connected' ? 'Reconnect QuickBooks' : 'Connect QuickBooks'}
              </button>
            </form>
            {
              quickbooksStatus === 'connected' && (
                <form method="post" action="/api/quickbooks/sync">
                  <button class="rounded-md bg-white px-3.5 py-2 text-sm font-semibold text-charcoal shadow-sm ring-1 ring-black/[0.1] hover:bg-[#f4f5f8]" type="submit">
                    Update numbers
                  </button>
                </form>
              )
            }
          </div>
        )
      }
      {
        needsReconnect && (
          <p class="mt-2 text-sm text-sage-dark/70">Sign in to QuickBooks again, then the cards can fill in.</p>
        )
      }
    </section>
    </aside>
  )
}

<div class="min-w-0">
{
  !canManage && enabled.length === 0 && (
    <p class="rounded-2xl bg-white px-4 py-3 text-sm text-charcoal shadow-sm ring-1 ring-black/[0.06]">
      No cards on this dashboard yet.
    </p>
  )
}
{
  canManage && enabled.length === 0 && (
    <p class="mt-6 rounded-2xl bg-white px-4 py-3 text-sm text-charcoal shadow-sm ring-1 ring-black/[0.06] lg:mt-0">
      Cards you add show up here.
    </p>
  )
}

{
  enabled.length > 0 && (
    <div class:list={[canManage && 'mt-6 lg:mt-0']}>
      <PeriodPicker period={period} action="/financials" allowCustom theme="quickbooks" live />
      {periodLabel && <p class="mt-2 text-sm text-sage-dark/65">{periodLabel}</p>}
    </div>
  )
}

<div class="mt-6 space-y-6">
  {
    pnlCard?.enabled && (
      <article class="rounded-2xl bg-white p-5 shadow-sm ring-1 ring-black/[0.06]">
        <div class="flex items-start justify-between gap-3">
          <h2 class="font-display text-2xl text-charcoal">Profit and loss</h2>
          {
            canManage && (
              <form method="post" action="/api/financials/cards">
                <input type="hidden" name="intent" value="remove-card" />
                <input type="hidden" name="cardKey" value="pnl" />
                <input type="hidden" name="period" value={period.id} />
                <input type="hidden" name="start" value={period.start} />
                <input type="hidden" name="end" value={period.end} />
                <button class="rounded-md px-2 py-1 text-sm text-sage-dark/70 hover:bg-[#f4f5f8] hover:text-charcoal" type="submit">
                  Remove
                </button>
              </form>
            )
          }
        </div>
        {
          !snapshot ? (
            <p class="mt-3 text-sm text-sage-dark/70">No numbers yet. Connect QuickBooks, then choose Update numbers.</p>
          ) : (
            <div class="mt-4 space-y-4">
              <div>
                <div class="flex items-baseline justify-between gap-3 text-sm">
                  <span class="font-medium text-charcoal">Income</span>
                  <span class="font-semibold tabular-nums text-charcoal">{formatUsd(incomeCents)}</span>
                </div>
                <div class="mt-2 h-1.5 overflow-hidden rounded-full bg-[#e3e5e8]">
                  <div class="h-full rounded-full bg-[#2CA01C]" style={`width: ${barWidth(incomeCents)}`}></div>
                </div>
              </div>
              {
                (expenseBars.length > 0 ? expenseBars : [{ name: 'Total expenses', cents: expenseTotal }]).map((line, index) => (
                  <div>
                    <div class="flex items-baseline justify-between gap-3 text-sm">
                      <span class="font-medium text-charcoal">{line.name}</span>
                      <span class="font-semibold tabular-nums text-charcoal">{formatUsd(line.cents)}</span>
                    </div>
                    <div class="mt-2 h-1.5 overflow-hidden rounded-full bg-[#e3e5e8]">
                      <div class="h-full rounded-full" style={`width: ${barWidth(line.cents)}; background-color: ${palette[index % palette.length]}`}></div>
                    </div>
                  </div>
                ))
              }
            </div>
          )
        }
      </article>
    )
  }

  {
    incomeBlocks.map((block) => {
      const selected = activityChoices.filter((account) => block.accountIds.includes(account.id));
      const incomeSelected = selected.filter((account) => account.kind === 'income');
      const expenseSelected = selected.filter((account) => account.kind === 'expense');
      const incomePie = pieFor(incomeSelected, incomePieColors);
      const expensePie = pieFor(expenseSelected, expensePieColors);
      const incomeScale = Math.max(1, ...selected.map((account) => Math.abs(pnlAmountForAccount(summary.pnlLines, account))));
      const blockTransactions = transactionsForAccounts(summary.transactions, activityChoices, block.accountIds).sort(
        (a, b) => calendarDateValue(b.date) - calendarDateValue(a.date) || Math.abs(b.cents) - Math.abs(a.cents),
      );
      const pies = [
        { label: 'Income', pie: incomePie, emptyNote: incomeSelected.length === 0 ? 'No income accounts in this block.' : 'No income in this date range.' },
        { label: 'Expenses', pie: expensePie, emptyNote: expenseSelected.length === 0 ? 'No expense accounts in this block.' : 'No expenses in this date range.' },
      ];
      return (
        <article class="rounded-2xl bg-white p-5 shadow-sm ring-1 ring-black/[0.06]">
          <div class="flex items-start justify-between gap-3">
            <div>
              <h2 class="font-display text-2xl text-charcoal">Income and expenses</h2>
              <p class="mt-1 text-sm text-sage-dark/70">{incomeViewLabel(block.viewMode)}</p>
            </div>
            {
              canManage && (
                <form method="post" action="/api/financials/cards">
                  <input type="hidden" name="intent" value="remove-income" />
                  <input type="hidden" name="blockId" value={block.id} />
                  <input type="hidden" name="period" value={period.id} />
                  <input type="hidden" name="start" value={period.start} />
                  <input type="hidden" name="end" value={period.end} />
                  <button class="rounded-md px-2 py-1 text-sm text-sage-dark/70 hover:bg-[#f4f5f8] hover:text-charcoal" type="submit">
                    Remove
                  </button>
                </form>
              )
            }
          </div>
          {
            block.accountIds.length === 0 ? (
              <p class="mt-3 text-sm text-sage-dark/70">Check the accounts that should feed this block, then save.</p>
            ) : block.viewMode === 'list' ? (
              blockTransactions.length === 0 ? (
                <p class="mt-4 text-sm text-sage-dark/70">No transactions for those accounts in this date range.</p>
              ) : (
                <FinancialScrollPanel ariaLabel="Income and expense transactions">
                  <ul class="divide-y divide-black/[0.06]">
                    {blockTransactions.map((transaction) => (
                      <FinancialTransactionItem
                        transaction={transaction}
                        metaLine={transactionMetaLine(transaction)}
                        amountClass={transaction.cents < 0 ? 'text-charcoal' : 'text-[#2CA01C]'}
                      />
                    ))}
                  </ul>
                </FinancialScrollPanel>
              )
            ) : block.viewMode === 'pie' ? (
              <div class="mt-4 grid gap-6 md:grid-cols-2">
                {pies.map(({ label, pie, emptyNote }) => (
                  <div>
                    <h3 class="text-sm font-semibold text-charcoal">{label}</h3>
                    <div class="mt-3 flex flex-wrap items-center gap-4">
                      <svg class="h-40 w-40 shrink-0" viewBox="0 0 100 100" role="img" aria-label={`${label} pie chart`}>
                        {pie.empty ? (
                          <circle cx="50" cy="50" r="42" fill="#e3e5e8" />
                        ) : (
                          pie.slices
                            .filter((slice) => slice.cents > 0)
                            .map((slice) => (
                              <path d={piePath(slice.start, slice.end)} fill={slice.color}>
                                <title>{`${slice.account.name}: ${formatUsd(slice.cents)}`}</title>
                              </path>
                            ))
                        )}
                      </svg>
                      {pie.empty ? (
                        <p class="text-sm text-sage-dark/70">{emptyNote}</p>
                      ) : (
                        <ul class="min-w-0 flex-1 space-y-2">
                          {pie.slices
                            .filter((slice) => slice.cents > 0)
                            .map((slice) => (
                              <li class="flex items-baseline justify-between gap-3 text-sm">
                                <span class="flex min-w-0 items-center gap-2">
                                  <span class="h-2.5 w-2.5 shrink-0 rounded-full" style={`background-color: ${slice.color}`}></span>
                                  <span class="truncate font-medium text-charcoal">{slice.account.name}</span>
                                </span>
                                <span class="shrink-0 tabular-nums text-charcoal">
                                  <span class="font-semibold">{formatUsd(slice.cents)}</span>
                                  <span class="ml-1 text-xs text-sage-dark/55">
                                    {pie.total > 0 ? `${Math.round((slice.cents / pie.total) * 100)}%` : ''}
                                  </span>
                                </span>
                              </li>
                            ))}
                        </ul>
                      )}
                    </div>
                  </div>
                ))}
              </div>
            ) : (
              <div class="mt-4 space-y-4">
                {selected.map((account, index) => {
                  const cents = pnlAmountForAccount(summary.pnlLines, account);
                  return (
                    <div>
                      <div class="flex items-baseline justify-between gap-3 text-sm">
                        <span class="font-medium text-charcoal">{account.name}</span>
                        <span class="font-semibold tabular-nums text-charcoal">{formatUsd(cents)}</span>
                      </div>
                      <div class="mt-2 h-1.5 overflow-hidden rounded-full bg-[#e3e5e8]">
                        <div class="h-full rounded-full" style={`width: ${Math.round((Math.abs(cents) / incomeScale) * 100)}%; background-color: ${account.kind === 'income' ? '#2CA01C' : palette[index % palette.length]}`}></div>
                      </div>
                    </div>
                  );
                })}
              </div>
            )
          }
          {
            canManage && (
              <form method="post" action="/api/financials/cards" class="mt-5 border-t border-black/[0.06] pt-4" data-income-view>
                <input type="hidden" name="intent" value="accounts" />
                <input type="hidden" name="cardKey" value="income_expenses" />
                <input type="hidden" name="blockId" value={block.id} />
                <input type="hidden" name="period" value={period.id} />
                <input type="hidden" name="start" value={period.start} />
                <input type="hidden" name="end" value={period.end} />
                <p class="text-sm font-semibold text-charcoal">How should this block look?</p>
                <div class="mt-2 flex flex-wrap gap-3">
                  {(['graph', 'pie', 'list'] as const).map((view) => (
                    <label class="flex items-center gap-2 text-sm text-charcoal">
                      <input type="radio" name="incomeView" value={view} checked={block.viewMode === view} />
                      {incomeViewLabel(view)}
                    </label>
                  ))}
                </div>
                <p class="mt-4 text-sm font-semibold text-charcoal">Which accounts feed this block?</p>
                <FinancialAccountChecklist
                  accounts={activityChoices.map((account) => ({ id: account.id, name: account.name, accountType: account.kind, accountNumber: null }))}
                  fieldName="accountId"
                  emptyMessage="No income or expense accounts yet. Connect QuickBooks and update the numbers."
                  valueFor={(account) => account.id}
                  isChecked={(account) => block.accountIds.includes(account.id)}
                />
                <button class="mt-3 rounded-md bg-[#2CA01C] px-3.5 py-2 text-sm font-semibold text-white shadow-sm hover:bg-[#248a18]" type="submit">
                  Save accounts
                </button>
              </form>
            )
          }
        </article>
      );
    })
  }

  {
    balanceCard?.enabled && (
      <article class="rounded-2xl bg-white p-5 shadow-sm ring-1 ring-black/[0.06]">
        <h2 class="font-display text-2xl text-charcoal">Account balances</h2>
        {
          balances.length === 0 ? (
            <p class="mt-3 text-sm text-sage-dark/70">Add an account below. Each one shows the money in it right now.</p>
          ) : (
            <div class="mt-4 grid gap-3 sm:grid-cols-2">
              {balances.map((item) => (
                <div class="rounded-xl bg-[#f7f8f6] p-4">
                  {
                    canManage ? (
                      <form method="post" action="/api/financials/cards" data-balance-name>
                        <input type="hidden" name="intent" value="accounts" />
                        <input type="hidden" name="cardKey" value="account_balance" />
                        <input type="hidden" name="period" value={period.id} />
                        <input type="hidden" name="start" value={period.start} />
                        <input type="hidden" name="end" value={period.end} />
                        {balances.map((other) => (
                          <>
                            <input type="hidden" name="accountId" value={other.id} />
                            <input
                              type={other.id === item.id ? 'text' : 'hidden'}
                              class={other.id === item.id ? 'field !mt-0 font-medium' : undefined}
                              name="accountLabel"
                              value={other.id === item.id ? other.label || other.name : other.label}
                              aria-label={other.id === item.id ? 'Name on the dashboard' : undefined}
                            />
                          </>
                        ))}
                        <p class="mt-1 text-[10px] leading-tight text-sage-dark/50">{item.name}</p>
                      </form>
                    ) : (
                      <>
                        <p class="text-sm font-medium text-charcoal">{item.label || item.name}</p>
                        <p class="mt-1 text-[10px] leading-tight text-sage-dark/50">{item.name}</p>
                      </>
                    )
                  }
                  <p class="mt-2 text-3xl font-semibold tabular-nums text-charcoal">{formatUsd(item.cents)}</p>
                  {
                    canManage && (
                      <form method="post" action="/api/financials/cards" class="mt-3">
                        <input type="hidden" name="intent" value="accounts" />
                        <input type="hidden" name="cardKey" value="account_balance" />
                        <input type="hidden" name="period" value={period.id} />
                        <input type="hidden" name="start" value={period.start} />
                        <input type="hidden" name="end" value={period.end} />
                        {balances
                          .filter((other) => other.id !== item.id)
                          .map((other) => (
                            <>
                              <input type="hidden" name="accountId" value={other.id} />
                              <input type="hidden" name="accountLabel" value={other.label} />
                            </>
                          ))}
                        <button class="text-sm font-semibold text-[#248a18] underline" type="submit">
                          Remove
                        </button>
                      </form>
                    )
                  }
                </div>
              ))}
            </div>
          )
        }
        {
          canManage && remainingBanks.length > 0 && (
            <form method="post" action="/api/financials/cards" class="mt-4" data-balance-add>
              <input type="hidden" name="intent" value="accounts" />
              <input type="hidden" name="cardKey" value="account_balance" />
              <input type="hidden" name="period" value={period.id} />
              <input type="hidden" name="start" value={period.start} />
              <input type="hidden" name="end" value={period.end} />
              {balances.map((item) => (
                <>
                  <input type="hidden" name="accountId" value={item.id} />
                  <input type="hidden" name="accountLabel" value={item.label} />
                </>
              ))}
              <label class="block text-sm text-charcoal">
                Add an account
                <select class="field max-w-md" name="accountId">
                  <option value="">Choose an account</option>
                  {remainingBanks.map((account) => (
                    <option value={account.id}>{account.name}</option>
                  ))}
                </select>
              </label>
            </form>
          )
        }
      </article>
    )
  }

  {
    netCard?.enabled && (
      <article class="rounded-2xl bg-white p-5 shadow-sm ring-1 ring-black/[0.06]">
        <h2 class="font-display text-2xl text-charcoal">Net income</h2>
        <p class:list={['mt-3 text-4xl font-semibold tabular-nums', netCents != null && netCents < 0 ? 'text-[#d52b1e]' : 'text-[#2CA01C]']}>
          {formatUsd(netCents)}
        </p>
        <p class="mt-1 text-sm text-sage-dark/70">Income accounts add. Expense accounts subtract.</p>
        {
          canManage && (
            <form method="post" action="/api/financials/cards" class="mt-5 border-t border-black/[0.06] pt-4">
              <input type="hidden" name="intent" value="accounts" />
              <input type="hidden" name="cardKey" value="net_income" />
              <input type="hidden" name="period" value={period.id} />
              <input type="hidden" name="start" value={period.start} />
              <input type="hidden" name="end" value={period.end} />
              <p class="text-sm font-semibold text-charcoal">Income accounts</p>
              <FinancialAccountChecklist
                accounts={incomeChoices.map((account) => ({ id: account.id, name: account.name, accountType: 'income', accountNumber: null }))}
                fieldName="accountId"
                emptyMessage="No income accounts yet."
                valueFor={(account) => account.id}
                isChecked={(account) => netCard.accountIds.includes(account.id)}
              />
              <p class="mt-4 text-sm font-semibold text-charcoal">Expense accounts</p>
              <FinancialAccountChecklist
                accounts={expenseChoices.map((account) => ({ id: account.id, name: account.name, accountType: 'expense', accountNumber: null }))}
                fieldName="accountId"
                emptyMessage="No expense accounts yet."
                valueFor={(account) => account.id}
                isChecked={(account) => netCard.accountIds.includes(account.id)}
              />
              <button class="mt-3 rounded-md bg-[#2CA01C] px-3.5 py-2 text-sm font-semibold text-white shadow-sm hover:bg-[#248a18]" type="submit">
                Save accounts
              </button>
            </form>
          )
        }
      </article>
    )
  }
</div>
</div>
</div>

<script>
  const updateFinancialScrollHints = () => {
    document.querySelectorAll<HTMLElement>('[data-financials-scroll]').forEach((panel) => {
      const shell = panel.closest('.financials-scroll-shell');
      const fade = shell?.querySelector<HTMLElement>('[data-financials-scroll-fade]');
      const hint = shell?.querySelector<HTMLElement>('[data-financials-scroll-hint]');
      const canScroll = panel.scrollHeight > panel.clientHeight + 1;
      const atBottom = panel.scrollTop + panel.clientHeight >= panel.scrollHeight - 8;
      const showHint = canScroll && !atBottom;
      panel.classList.toggle('is-scrollable', canScroll);
      fade?.classList.toggle('is-visible', showHint);
      hint?.classList.toggle('is-visible', showHint);
    });
  };

  const bindFinancialScroll = () => {
    document.querySelectorAll<HTMLElement>('[data-financials-scroll]').forEach((panel) => {
      if (panel.dataset.scrollBound) return;
      panel.dataset.scrollBound = '1';
      panel.addEventListener('scroll', updateFinancialScrollHints, { passive: true });
    });
    updateFinancialScrollHints();
  };

  const applyFinancialHtml = (html: string, url: string) => {
    const doc = new DOMParser().parseFromString(html, 'text/html');
    const next = doc.querySelector('[data-financial-board]');
    const current = document.querySelector('[data-financial-board]');
    if (!(next instanceof HTMLElement) || !(current instanceof HTMLElement)) {
      window.location.assign(url);
      return;
    }
    const scrollY = window.scrollY;
    current.replaceWith(document.importNode(next, true));
    if (url) history.replaceState(null, '', url);
    bindFinancialScroll();
    window.scrollTo(0, scrollY);
  };

  const showFinancialError = (message: string) => {
    const board = document.querySelector('[data-financial-board]');
    if (!(board instanceof HTMLElement)) return;
    board.classList.remove('opacity-60');
    const existing = board.querySelector('[data-financial-live-error]');
    const note = existing instanceof HTMLElement ? existing : document.createElement('p');
    if (!(existing instanceof HTMLElement)) {
      note.dataset.financialLiveError = '';
      note.className = 'mb-3 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800';
      board.insertBefore(note, board.firstChild);
    }
    note.textContent = message;
  };

  const shouldHandleFinancialForm = (form: HTMLFormElement) => {
    if (!form.closest('[data-financial-board]')) return false;
    const action = form.getAttribute('action') || '';
    if (action.includes('/api/quickbooks/connect')) return false;
    return (
      form.hasAttribute('data-financial-period') ||
      action.includes('/api/financials/cards') ||
      action.includes('/api/quickbooks/sync')
    );
  };

  let financialSaving = false;

  const saveFinancialForm = async (form: HTMLFormElement) => {
    if (financialSaving) return;
    financialSaving = true;
    const board = document.querySelector('[data-financial-board]');
    board?.classList.add('opacity-60');
    try {
      const method = (form.getAttribute('method') || 'get').toLowerCase();
      const params = new URLSearchParams();
      new FormData(form).forEach((value, key) => {
        if (typeof value === 'string') params.append(key, value);
      });
      const response =
        method === 'get'
          ? await fetch(`${form.action.split('?')[0]}?${params.toString()}`, {
              headers: { accept: 'text/html' },
              credentials: 'same-origin',
            })
          : await fetch(form.action, {
              method: 'POST',
              body: new FormData(form),
              headers: { accept: 'text/html' },
              credentials: 'same-origin',
            });
      const html = await response.text();
      if (!html.includes('data-financial-board')) {
        throw new Error('Could not update the dashboard.');
      }
      applyFinancialHtml(html, response.url);
    } catch (error) {
      showFinancialError(error instanceof Error ? error.message : 'Could not update the dashboard.');
    } finally {
      financialSaving = false;
    }
  };

  if (!document.documentElement.dataset.financialLive) {
    document.documentElement.dataset.financialLive = '1';

    document.addEventListener('submit', (event) => {
      const form = event.target;
      if (!(form instanceof HTMLFormElement) || !shouldHandleFinancialForm(form)) return;
      event.preventDefault();
      void saveFinancialForm(form);
    });

    document.addEventListener('change', (event) => {
      const target = event.target;
      if (!(target instanceof HTMLElement) || !target.closest('[data-financial-board]')) return;
      const form = target instanceof HTMLInputElement || target instanceof HTMLSelectElement ? target.form : null;
      if (!form) return;

      if (target instanceof HTMLSelectElement && target.name === 'period') {
        form.querySelector('[data-custom-dates]')?.classList.toggle('hidden', target.value !== 'custom');
        return;
      }

      if (target instanceof HTMLInputElement && target.name === 'incomeView' && form.hasAttribute('data-income-view')) {
        form.requestSubmit();
        return;
      }

      if (form.hasAttribute('data-card-picker')) {
        form.requestSubmit();
        return;
      }

      if (target instanceof HTMLInputElement && target.name === 'accountLabel' && form.hasAttribute('data-balance-name')) {
        form.requestSubmit();
        return;
      }

      if (target instanceof HTMLSelectElement && form.hasAttribute('data-balance-add') && target.value) {
        form.requestSubmit();
      }
    });

    document.addEventListener('keydown', (event) => {
      const target = event.target;
      if (!(target instanceof HTMLInputElement) || event.key !== 'Enter') return;
      const form = target.form;
      if (!form?.hasAttribute('data-balance-name') || target.type === 'hidden') return;
      event.preventDefault();
      form.requestSubmit();
    });

    window.addEventListener('resize', updateFinancialScrollHints, { passive: true });
    bindFinancialScroll();
  }
</script>
