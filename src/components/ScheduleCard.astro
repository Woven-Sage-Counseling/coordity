---
import {
  eachDayInRange,
  easternMinutesFromMidnight,
  formatDayNumber,
  formatScheduleEventDay,
  formatScheduleEventTime,
  formatScheduleHeading,
  formatScheduleTodayDate,
  formatWeekdayShort,
  groupEventsByDay,
  monthGridDays,
} from '../lib/schedule/range';
import { conflictCountLabel, conflictingEventCount } from '../lib/schedule/conflicts';
import { layoutOverlappingTimedEvents, weekEventColumnStyle } from '../lib/schedule/week-layout';
import { getScheduleSummary, scheduleRangeOptions } from '../lib/schedule/summary';
import { todayEastern } from '../lib/financials/periods';
import type { ScheduleEvent } from '../lib/schedule/types';
import { widgetAccentVarsStyle } from '../lib/home-widget-header';
import WidgetHeaderBar from './WidgetHeaderBar.astro';

interface Props {
  userId: string;
}

const { userId } = Astro.props;

let summary = null;
try {
  summary = await getScheduleSummary(userId, 'this_week');
} catch (error) {
  console.error('home schedule summary failed', error);
}

const connection = summary?.connection ?? {
  status: 'disconnected' as const,
  googleEmail: null,
  lastError: null,
  configured: false,
  hiddenTitleKeywords: [],
  hideOutOfOffice: false,
};
const range = summary?.range ?? null;
const events = summary?.events ?? [];
const calendars = (summary?.calendars ?? []).filter((calendar) => calendar.enabled);
const rangeOptions = scheduleRangeOptions();
const viewMode = range?.id === 'this_week' ? 'week' : range?.id === 'this_month' ? 'month' : 'stack';
const today = todayEastern();
const weekDays = range && viewMode === 'week' ? eachDayInRange(range.start, range.end) : [];
const monthDays = range && viewMode === 'month' ? monthGridDays(range.start, range.end) : [];
const monthPrefix = range?.start.slice(0, 7) ?? '';
const grouped = groupEventsByDay(events);
const dayKeys = [...grouped.keys()].sort();

const hourHeight = 18;
const gridHours = Array.from({ length: 24 }, (_, index) => index);
const allDayByDay = new Map(
  weekDays.map((day) => [day, (grouped.get(day) ?? []).filter((event) => event.allDay)]),
);
const hasAllDay = [...allDayByDay.values()].some((list) => list.length > 0);

function eventTimeLabel(event: ScheduleEvent): string {
  return formatScheduleEventTime(event);
}

function eventTop(event: ScheduleEvent): number {
  const minutes = Math.max(easternMinutesFromMidnight(event.start), 0);
  return (minutes / 60) * hourHeight;
}

function eventHeight(event: ScheduleEvent): number {
  const start = Math.max(easternMinutesFromMidnight(event.start), 0);
  const end = Math.min(Math.max(easternMinutesFromMidnight(event.end), start + 15), 24 * 60);
  return Math.max(((end - start) / 60) * hourHeight, 14);
}

function layoutDayTimedEvents(events: ScheduleEvent[]) {
  const timed = events.filter((event) => !event.allDay);
  return layoutOverlappingTimedEvents(
    timed.map((event) => {
      const startMin = Math.max(easternMinutesFromMidnight(event.start), 0);
      const endMin = Math.min(Math.max(easternMinutesFromMidnight(event.end), startMin + 15), 24 * 60);
      return { event, startMin, endMin };
    }),
  );
}

function hourLabel(hour: number): string {
  const suffix = hour >= 12 ? 'p' : 'a';
  const display = hour % 12 === 0 ? 12 : hour % 12;
  return `${display}${suffix}`;
}

function countsByCalendar(dayEvents: ScheduleEvent[]): Array<{ color: string; count: number; name: string }> {
  const map = new Map<string, { color: string; count: number; name: string }>();
  for (const event of dayEvents) {
    const existing = map.get(event.calendarId);
    if (existing) {
      existing.count += 1;
    } else {
      map.set(event.calendarId, {
        color: event.calendarColor ?? '#1a73e8',
        count: 1,
        name: event.calendarName,
      });
    }
  }
  return [...map.values()];
}

function eventCountLabel(count: number): string {
  return count === 1 ? '1 event' : `${count} events`;
}

const weekdayHeaders = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
const headingLabel = range ? formatScheduleHeading(range) : 'This week';
const todayDateLabel = range?.id === 'today' ? formatScheduleTodayDate(range.start) : null;
const conflictCount = conflictingEventCount(events);
const conflictLabel = conflictCountLabel(conflictCount);
---

<aside
  class="flex h-full min-h-0 max-h-full flex-col overflow-hidden rounded-[1.05rem] shadow-[0_12px_32px_rgba(26,28,30,0.12)] ring-1 ring-black/10"
  aria-labelledby="home-schedule-heading"
  data-schedule-card
  data-widget-card
  data-widget-id="schedule"
  style={widgetAccentVarsStyle('schedule')}
  data-user-id={userId}
  data-connected={connection.status === 'connected' ? '1' : '0'}
  data-range-start={range?.start ?? ''}
  data-range-end={range?.end ?? ''}
  data-google-email={connection.googleEmail ?? ''}
>
  <WidgetHeaderBar widgetId="schedule" title="Calendar" headingId="home-schedule-heading">
    <div slot="title-extra" class:list={['relative', conflictCount === 0 && 'hidden']} data-schedule-conflict-wrap>
      <button
        type="button"
        class="widget-header-icon-btn inline-flex h-9 w-9"
        data-schedule-conflict-badge
        aria-expanded="false"
        aria-label={conflictLabel}
      >
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path
            d="M12 3.2 2.6 20.2h18.8L12 3.2Z"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linejoin="round"
          />
          <path d="M12 9.2v5.2" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" />
          <circle cx="12" cy="16.7" r="1" fill="currentColor" />
        </svg>
      </button>
      <p
        class="absolute left-0 top-full z-20 mt-1 hidden whitespace-nowrap rounded-md bg-charcoal px-2 py-1 text-[10px] font-semibold text-cream shadow-lg"
        data-schedule-conflict-label
        role="status"
      >
        {conflictLabel}
      </p>
    </div>
    {
      connection.status === 'connected' ? (
        <button
          slot="actions"
          type="button"
          class="widget-header-action"
          data-schedule-expand
        >
          Expand
        </button>
      ) : null
    }
  </WidgetHeaderBar>

  <div class="flex min-h-0 flex-1 flex-col bg-[#f4f5f8] px-4 pb-4 pt-3 font-sans text-[#393a3d]">
    <div class="flex items-start justify-between gap-3">
      <div class="min-w-0 flex-1">
        <div class="flex items-center gap-0.5">
          <button
            type="button"
            class="inline-flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-white text-[#6b6c72] shadow-sm ring-1 ring-[#d5d8de] transition hover:bg-[#eef4ff] hover:text-charcoal"
            data-schedule-prev
            aria-label="Previous period"
          >
            <svg width="11" height="11" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M10 3L5 8l5 5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </button>
          <div class="min-w-0 flex-1 px-0.5 text-center">
            <p class="text-[11px] font-semibold leading-none whitespace-nowrap" data-schedule-range-label>
              {headingLabel}
            </p>
            {
              todayDateLabel ? (
                <p class="mt-1 text-[11px] text-[#6b6c72]" data-schedule-range-sub>{todayDateLabel}</p>
              ) : connection.status === 'connected' && connection.googleEmail ? (
                <p class="mt-1 text-[11px] text-[#6b6c72]" data-schedule-range-sub>{connection.googleEmail}</p>
              ) : (
                <p class="mt-1 hidden text-[11px] text-[#6b6c72]" data-schedule-range-sub></p>
              )
            }
          </div>
          <button
            type="button"
            class="inline-flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-white text-[#6b6c72] shadow-sm ring-1 ring-[#d5d8de] transition hover:bg-[#eef4ff] hover:text-charcoal"
            data-schedule-next
            aria-label="Next period"
          >
            <svg width="11" height="11" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M6 3l5 5-5 5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </button>
        </div>
      </div>
      {
        connection.status === 'connected' ? (
          <label class="shrink-0">
            <span class="sr-only">Calendar range</span>
            <select class="rounded-md border border-[#d5d8de] bg-white px-2 py-1 text-[11px] font-medium text-[#393a3d]" data-schedule-range>
              {
                rangeOptions.map((option) => (
                  <option value={option.id} selected={option.id === (range?.id ?? 'this_week')}>
                    {option.label}
                  </option>
                ))
              }
            </select>
          </label>
        ) : null
      }
    </div>

    <div class="mt-3 flex min-h-0 flex-1 flex-col overflow-hidden rounded-lg bg-white shadow-sm ring-1 ring-black/[0.06]" data-schedule-events-shell>
      {
        connection.status !== 'connected' ? (
          <div class="flex h-full flex-col justify-center gap-3 p-4">
            {
              !connection.configured ? (
                <p class="text-sm text-[#6b6c72]">
                  Google Calendar is not configured yet. Ask an admin to add the OAuth credentials.
                </p>
              ) : (
                <>
                  <p class="text-sm text-[#6b6c72]">
                    Connect your Google account to see your calendar events on the home page.
                  </p>
                  <form method="post" action="/api/google-calendar/connect" class="contents">
                    <input type="hidden" name="returnTo" value="/" />
                    <button
                      type="submit"
                      class="widget-accent-btn inline-flex items-center justify-center rounded-lg px-3 py-2 text-sm font-semibold"
                    >
                      Connect Google Calendar
                    </button>
                  </form>
                </>
              )
            }
          </div>
        ) : connection.lastError ? (
          <div class="p-4">
            <p class="text-sm text-red-700">{connection.lastError}</p>
          </div>
        ) : viewMode === 'week' ? (
          <div class="min-h-0 flex-1 overflow-auto overscroll-contain" data-schedule-events data-view="week">
            <div class="sticky top-0 z-10 grid grid-cols-[1.6rem_repeat(7,minmax(0,1fr))] border-b border-[#eceef2] bg-white">
              <div class="border-r border-[#eceef2]"></div>
              {
                weekDays.map((day) => (
                  <div class={`border-r border-[#eceef2] px-0.5 py-1.5 text-center last:border-r-0 ${day === today ? 'bg-[#eef4ff]' : ''}`}>
                    <p class="text-[9px] font-semibold uppercase tracking-wide text-[#6b6c72]">{formatWeekdayShort(day).slice(0, 3)}</p>
                    <p class:list={['mx-auto mt-0.5 flex h-5 w-5 items-center justify-center text-[11px] font-semibold', day === today ? 'rounded-full bg-[#1a73e8] text-white' : 'text-[#393a3d]']}>
                      {formatDayNumber(day)}
                    </p>
                  </div>
                ))
              }
            </div>
            {
              hasAllDay ? (
                <div class="sticky top-[2.6rem] z-10 grid grid-cols-[1.6rem_repeat(7,minmax(0,1fr))] border-b border-[#eceef2] bg-white">
                  <div class="border-r border-[#eceef2] px-0.5 py-1 text-[8px] text-[#8b8d93]">All</div>
                  {
                    weekDays.map((day) => (
                      <div class="min-h-[1.25rem] space-y-0.5 border-r border-[#eceef2] px-0.5 py-0.5 last:border-r-0">
                        {
                          (allDayByDay.get(day) ?? []).map((event) => (
                            <div
                              class="min-h-3.5 rounded-md border border-black/20"
                              style={`background-color: ${event.calendarColor ?? '#6b6c72'}`}
                              title={event.title}
                            ></div>
                          ))
                        }
                      </div>
                    ))
                  }
                </div>
              ) : null
            }
            <div class="relative grid grid-cols-[1.6rem_repeat(7,minmax(0,1fr))]" style={`height: ${24 * hourHeight}px`}>
              <div class="relative border-r border-[#eceef2]">
                {
                  gridHours.map((hour) => (
                    <div class="absolute right-0.5 -translate-y-1/2 text-[8px] text-[#8b8d93]" style={`top: ${hour * hourHeight}px`}>
                      {hourLabel(hour)}
                    </div>
                  ))
                }
              </div>
              {
                weekDays.map((day) => {
                  const laidOut = layoutDayTimedEvents(grouped.get(day) ?? []);
                  return (
                    <div class={`relative border-r border-[#eceef2] last:border-r-0 ${day === today ? 'bg-[#f7faff]' : ''}`}>
                      {
                        gridHours.map((hour) => (
                          <div class="absolute inset-x-0 border-t border-[#f0f1f4]" style={`top: ${hour * hourHeight}px`}></div>
                        ))
                      }
                      {
                        laidOut.map(({ event, column, columnCount }) => {
                          const columnStyle = weekEventColumnStyle(column, columnCount);
                          return (
                            <a
                              href={event.htmlLink ?? '#'}
                              target={event.htmlLink ? '_blank' : undefined}
                              rel={event.htmlLink ? 'noopener noreferrer' : undefined}
                              class="absolute overflow-hidden rounded-md border border-black/20"
                              data-schedule-timed-event
                              style={`top: ${eventTop(event)}px; height: ${eventHeight(event)}px; left: ${columnStyle.left}; width: ${columnStyle.width}; background-color: ${event.calendarColor ?? '#1a73e8'};`}
                              title={`${event.title} · ${eventTimeLabel(event)}`}
                            ></a>
                          );
                        })
                      }
                    </div>
                  );
                })
              }
            </div>
          </div>
        ) : viewMode === 'month' ? (
          <div class="min-h-0 flex-1 overflow-auto overscroll-contain p-2" data-schedule-events data-view="month">
            <div class="mb-1 grid grid-cols-7 gap-px">
              {
                weekdayHeaders.map((label) => (
                  <div class="py-1 text-center text-[9px] font-semibold uppercase tracking-wide text-[#6b6c72]">{label}</div>
                ))
              }
            </div>
            <div class="grid grid-cols-7 gap-px rounded-md bg-[#eceef2] ring-1 ring-[#eceef2]">
              {
                monthDays.map((day) => {
                  const inMonth = day.startsWith(monthPrefix);
                  const dayEvents = grouped.get(day) ?? [];
                  const counts = countsByCalendar(dayEvents);
                  const isToday = day === today;
                  return (
                    <div class:list={['min-h-[3.1rem] bg-white p-1', !inMonth && 'bg-[#f7f8fa]']}>
                      <p class:list={[
                        'mb-0.5 inline-flex h-4 min-w-4 items-center justify-center px-0.5 text-[10px] font-semibold',
                        isToday ? 'rounded-full bg-[#1a73e8] text-white' : inMonth ? 'text-[#393a3d]' : 'text-[#b0b1b6]',
                      ]}>
                        {formatDayNumber(day)}
                      </p>
                      <div class="flex flex-col gap-0.5">
                        {
                          counts.map((item) => (
                            <span
                              class="text-[9px] font-semibold leading-tight"
                              style={`color: ${item.color}`}
                              title={`${eventCountLabel(item.count)} on ${item.name}`}
                            >
                              {eventCountLabel(item.count)}
                            </span>
                          ))
                        }
                      </div>
                    </div>
                  );
                })
              }
            </div>
          </div>
        ) : events.length === 0 ? (
          <div class="flex min-h-0 flex-1 items-center justify-center p-4" data-schedule-events data-view="stack">
            <p class="text-sm text-[#6b6c72]">No events in this range.</p>
          </div>
        ) : (
          <div class="min-h-0 flex-1 overflow-y-auto overscroll-contain p-3" data-schedule-events data-view="stack">
            {
              dayKeys.map((dayKey) => {
                const dayEvents = grouped.get(dayKey) ?? [];
                return (
                  <section class="mb-4 last:mb-0">
                    <h3 class="text-[11px] font-semibold uppercase tracking-[0.12em] text-[#6b6c72]">
                      {formatScheduleEventDay(dayKey.includes('T') ? dayKey : `${dayKey}T12:00:00`)}
                    </h3>
                    <ul class="mt-2 space-y-2">
                      {
                        dayEvents.map((event) => (
                          <li class="rounded-md border border-[#eceef2] px-3 py-2">
                            <div class="flex items-start justify-between gap-2">
                              <p class="text-sm font-semibold leading-snug text-[#393a3d]">{event.title}</p>
                              {
                                event.htmlLink ? (
                                  <a
                                    href={event.htmlLink}
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    class="shrink-0 text-[11px] font-medium text-sage-dark hover:text-charcoal"
                                  >
                                    Open
                                  </a>
                                ) : null
                              }
                            </div>
                            <p class="mt-1 text-[11px] text-[#6b6c72]">{eventTimeLabel(event)}</p>
                            {
                              event.calendarName ? (
                                <p class="mt-1 text-[10px] uppercase tracking-[0.12em] text-[#8b8d93]">
                                  {event.calendarName}
                                </p>
                              ) : null
                            }
                          </li>
                        ))
                      }
                    </ul>
                  </section>
                );
              })
            }
          </div>
        )
      }
      <p class="pointer-events-none shrink-0 px-3 pb-2 pt-1 text-center text-[10px] uppercase tracking-[0.14em] text-[#8b8d93] opacity-0 transition-opacity" data-schedule-scroll-hint>
        Scroll for more
      </p>
    </div>

    {
      connection.status === 'connected' && calendars.length > 0 ? (
        <div class="mt-2 flex flex-wrap gap-x-3 gap-y-1" data-schedule-legend aria-label="Calendar color key">
          {
            calendars.map((calendar) => (
              <span class="inline-flex items-center gap-1.5 text-[10px] text-[#6b6c72]">
                <span
                  class="h-2 w-2 shrink-0 rounded-sm"
                  style={`background-color: ${calendar.color ?? '#6b6c72'}`}
                  aria-hidden="true"
                ></span>
                <span class="truncate">{calendar.name}</span>
              </span>
            ))
          }
        </div>
      ) : null
    }
  </div>
</aside>

{
  connection.status === 'connected' ? (
    <dialog
      class="schedule-expand-dialog m-0 h-full max-h-none w-full max-w-none bg-transparent p-0 backdrop:bg-charcoal/50"
      data-schedule-dialog
      aria-label="Expanded calendar"
    >
      <div class="flex min-h-full items-center justify-center p-4 sm:p-6">
        <div class="flex h-[min(92vh,56rem)] w-full max-w-5xl flex-col overflow-hidden rounded-2xl bg-[#f4f5f8] shadow-2xl ring-1 ring-black/15">
          <div class="widget-accent-bar flex shrink-0 items-center justify-between gap-3 px-4 py-3">
            <div class="flex min-w-0 flex-1 items-center gap-2">
              <button
                type="button"
                class="inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-white/15 text-cream ring-1 ring-white/20 transition hover:bg-white/25"
                data-schedule-dialog-prev
                aria-label="Previous period"
              >
                <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                  <path d="M10 3L5 8l5 5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </button>
              <div class="min-w-0 flex-1">
                <div class="flex items-center gap-2">
                  <div class="min-w-0">
                    <p class="text-[11px] font-semibold uppercase tracking-[0.14em] text-cream/70">Calendar</p>
                    <p class="text-base font-semibold" data-schedule-dialog-label>{headingLabel}</p>
                  </div>
                  <span
                    class:list={[
                      'inline-flex items-center gap-1.5',
                      conflictCount === 0 && 'hidden',
                    ]}
                    data-schedule-conflict-wrap
                    data-schedule-conflict-expanded
                  >
                    <span class="inline-flex h-9 w-9 shrink-0 items-center justify-center" aria-hidden="true">
                      <svg width="28" height="28" viewBox="0 0 24 24" fill="none">
                        <path
                          d="M12 3.2 2.6 20.2h18.8L12 3.2Z"
                          stroke="white"
                          stroke-width="1.75"
                          stroke-linejoin="round"
                        />
                        <path d="M12 9.2v5.2" stroke="white" stroke-width="1.75" stroke-linecap="round" />
                        <circle cx="12" cy="16.7" r="1" fill="white" />
                      </svg>
                    </span>
                    <span class="text-[11px] font-semibold text-cream" data-schedule-conflict-inline role="status">
                      {conflictLabel}
                    </span>
                  </span>
                </div>
              </div>
              <button
                type="button"
                class="inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-white/15 text-cream ring-1 ring-white/20 transition hover:bg-white/25"
                data-schedule-dialog-next
                aria-label="Next period"
              >
                <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                  <path d="M6 3l5 5-5 5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </button>
            </div>
            <div class="flex items-center gap-2">
              <label class="shrink-0">
                <span class="sr-only">Calendar range</span>
                <select class="rounded-md border-0 bg-white/15 px-2 py-1 text-[11px] font-medium text-cream ring-1 ring-white/20" data-schedule-dialog-range>
                  {
                    rangeOptions.map((option) => (
                      <option value={option.id} selected={option.id === (range?.id ?? 'this_week')} class="text-[#393a3d]">
                        {option.label}
                      </option>
                    ))
                  }
                </select>
              </label>
              <button
                type="button"
                class="rounded-md bg-white/15 px-2.5 py-1 text-[11px] font-semibold text-cream ring-1 ring-white/20 transition hover:bg-white/25 disabled:cursor-not-allowed disabled:opacity-60"
                data-schedule-dialog-sync
              >
                Sync
              </button>
              <button
                type="button"
                class="rounded-md bg-white/15 px-2.5 py-1 text-[11px] font-semibold text-cream ring-1 ring-white/20 transition hover:bg-white/25"
                data-schedule-dialog-close
              >
                Close
              </button>
            </div>
          </div>
          <div class="flex min-h-0 flex-1 flex-col overflow-hidden p-4" data-schedule-dialog-shell>
            <div
              class="min-h-0 flex-1 overflow-y-auto overscroll-contain rounded-xl bg-white shadow-sm ring-1 ring-black/[0.06]"
              data-schedule-dialog-scroll
            >
              <div data-schedule-dialog-events></div>
            </div>
            {
              calendars.length > 0 ? (
                <div
                  class="mt-3 flex shrink-0 flex-wrap gap-x-4 gap-y-1.5 border-t border-sage-dark/10 pt-3"
                  data-schedule-dialog-legend
                  aria-label="Calendar color key"
                >
                  {
                    calendars.map((calendar) => (
                      <span class="inline-flex items-center gap-1.5 text-[11px] text-[#6b6c72]">
                        <span
                          class="h-2.5 w-2.5 shrink-0 rounded-sm"
                          style={`background-color: ${calendar.color ?? '#6b6c72'}`}
                          aria-hidden="true"
                        ></span>
                        <span>{calendar.name}</span>
                      </span>
                    ))
                  }
                </div>
              ) : null
            }
            <div class="mt-3 flex shrink-0 flex-wrap items-center justify-between gap-2">
              <a
                href="/settings#google-calendar"
                class="rounded-full border border-sage-dark/25 bg-transparent px-3 py-1.5 text-[11px] font-medium text-sage-dark/80 transition hover:border-sage-dark/40 hover:bg-white hover:text-charcoal"
              >
                Manage calendars
              </a>
              <a
                href="/time-off"
                class="rounded-full border border-sage-dark/25 bg-transparent px-3 py-1.5 text-[11px] font-medium text-sage-dark/80 transition hover:border-sage-dark/40 hover:bg-white hover:text-charcoal"
              >
                Request time off
              </a>
            </div>
          </div>
        </div>
      </div>
    </dialog>
  ) : null
}

<script>
  type ScheduleEventPayload = {
    id: string;
    title: string;
    start: string;
    end: string;
    allDay: boolean;
    calendarId?: string;
    calendarName: string;
    calendarColor: string | null;
    htmlLink: string | null;
  };

  type EventsResponse = {
    range?: { id: string; start: string; end: string; label: string };
    events?: ScheduleEventPayload[];
    connection?: { lastError?: string | null; status?: string };
  };

  type SizeMode = 'compact' | 'expanded';

  const TZ = 'America/New_York';
  const WEEKDAY_HEADERS = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];

  function rangeStorageKey(userId: string): string {
    return `portal:schedule-range:${userId}`;
  }

  function viewStorageKey(userId: string): string {
    return `portal:schedule-view:${userId}`;
  }

  type StoredScheduleView = { rangeId: string; anchor: string };

  function anchorForRange(rangeId: string, referenceDate = todayEastern()): string {
    if (rangeId === 'today') return referenceDate;
    if (rangeId === 'this_week') return addDays(referenceDate, -weekdayIndex(referenceDate));
    const [year, month] = referenceDate.split('-').map(Number);
    return `${year}-${String(month).padStart(2, '0')}-01`;
  }

  function shiftAnchor(rangeId: string, anchorDate: string, direction: -1 | 1): string {
    if (rangeId === 'today') return addDays(anchorDate, direction);
    if (rangeId === 'this_week') return addDays(anchorDate, direction * 7);
    const [year, month] = anchorDate.split('-').map(Number);
    const shifted = new Date(Date.UTC(year, month - 1 + direction, 1));
    return `${shifted.getUTCFullYear()}-${String(shifted.getUTCMonth() + 1).padStart(2, '0')}-01`;
  }

  function rangeNavLabel(rangeId: string, direction: 'prev' | 'next'): string {
    const unit = rangeId === 'today' ? 'day' : rangeId === 'this_week' ? 'week' : 'month';
    return direction === 'prev' ? `Previous ${unit}` : `Next ${unit}`;
  }

  function readStoredView(userId: string): StoredScheduleView | null {
    try {
      const raw = localStorage.getItem(viewStorageKey(userId));
      if (raw) {
        const parsed = JSON.parse(raw) as StoredScheduleView;
        if (
          (parsed.rangeId === 'today' || parsed.rangeId === 'this_week' || parsed.rangeId === 'this_month') &&
          /^\d{4}-\d{2}-\d{2}$/.test(parsed.anchor)
        ) {
          return parsed;
        }
      }
      const legacy = localStorage.getItem(rangeStorageKey(userId));
      if (legacy === 'today' || legacy === 'this_week' || legacy === 'this_month') {
        return { rangeId: legacy, anchor: anchorForRange(legacy) };
      }
    } catch {
      // ignore
    }
    return null;
  }

  function readStoredRange(userId: string): string | null {
    return readStoredView(userId)?.rangeId ?? null;
  }

  function writeStoredView(userId: string, rangeId: string, anchor: string): void {
    try {
      localStorage.setItem(viewStorageKey(userId), JSON.stringify({ rangeId, anchor }));
      localStorage.setItem(rangeStorageKey(userId), rangeId);
    } catch {
      // ignore
    }
  }

  function writeStoredRange(userId: string, rangeId: string): void {
    writeStoredView(userId, rangeId, anchorForRange(rangeId));
  }

  function escapeHtml(value: string): string {
    return value
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;');
  }

  function todayEastern(): string {
    return new Intl.DateTimeFormat('en-CA', {
      timeZone: TZ,
      year: 'numeric',
      month: '2-digit',
      day: '2-digit',
    }).format(new Date());
  }

  function addDays(iso: string, days: number): string {
    const [year, month, day] = iso.split('-').map(Number);
    const date = new Date(Date.UTC(year, month - 1, day + days));
    return `${date.getUTCFullYear()}-${String(date.getUTCMonth() + 1).padStart(2, '0')}-${String(date.getUTCDate()).padStart(2, '0')}`;
  }

  function eachDay(start: string, end: string): string[] {
    const days: string[] = [];
    let cursor = start;
    for (let i = 0; i < 45; i += 1) {
      days.push(cursor);
      if (cursor === end) break;
      cursor = addDays(cursor, 1);
    }
    return days;
  }

  function weekdayIndex(iso: string): number {
    const label = new Date(`${iso}T12:00:00`).toLocaleDateString('en-US', { timeZone: TZ, weekday: 'short' });
    return { Sun: 0, Mon: 1, Tue: 2, Wed: 3, Thu: 4, Fri: 5, Sat: 6 }[label] ?? 0;
  }

  function monthGridDays(monthStart: string, monthEnd: string): string[] {
    const gridStart = addDays(monthStart, -weekdayIndex(monthStart));
    const gridEnd = addDays(monthEnd, 6 - weekdayIndex(monthEnd));
    return eachDay(gridStart, gridEnd);
  }

  function dayKeyForEvent(event: ScheduleEventPayload): string {
    if (event.allDay) return event.start.slice(0, 10);
    return new Intl.DateTimeFormat('en-CA', {
      timeZone: TZ,
      year: 'numeric',
      month: '2-digit',
      day: '2-digit',
    }).format(new Date(event.start));
  }

  function minutesFromMidnight(iso: string): number {
    if (!iso.includes('T')) return 0;
    const parts = new Intl.DateTimeFormat('en-US', {
      timeZone: TZ,
      hour: '2-digit',
      minute: '2-digit',
      hour12: false,
    }).formatToParts(new Date(iso));
    let hour = Number(parts.find((part) => part.type === 'hour')?.value ?? 0);
    if (hour === 24) hour = 0;
    const minute = Number(parts.find((part) => part.type === 'minute')?.value ?? 0);
    return hour * 60 + minute;
  }

  function formatDay(value: string): string {
    const ms = Date.parse(value.includes('T') ? value : `${value}T12:00:00`);
    return new Date(ms).toLocaleDateString('en-US', {
      timeZone: TZ,
      weekday: 'short',
      month: 'short',
      day: 'numeric',
    });
  }

  function formatTime(event: ScheduleEventPayload): string {
    if (event.allDay) return 'All day';
    const startLabel = new Date(event.start).toLocaleTimeString('en-US', {
      timeZone: TZ,
      hour: 'numeric',
      minute: '2-digit',
    });
    const endLabel = new Date(event.end).toLocaleTimeString('en-US', {
      timeZone: TZ,
      hour: 'numeric',
      minute: '2-digit',
    });
    return `${startLabel} – ${endLabel}`;
  }

  function hourLabel(hour: number): string {
    const suffix = hour >= 12 ? 'p' : 'a';
    const display = hour % 12 === 0 ? 12 : hour % 12;
    return `${display}${suffix}`;
  }

  function weekdayShort(iso: string): string {
    return new Date(`${iso}T12:00:00`).toLocaleDateString('en-US', { timeZone: TZ, weekday: 'short' }).slice(0, 3);
  }

  function dayNumber(iso: string): string {
    return new Date(`${iso}T12:00:00`).toLocaleDateString('en-US', { timeZone: TZ, day: 'numeric' });
  }

  function groupByDay(events: ScheduleEventPayload[]): Map<string, ScheduleEventPayload[]> {
    const groups = new Map<string, ScheduleEventPayload[]>();
    for (const event of events) {
      const key = dayKeyForEvent(event);
      const bucket = groups.get(key) ?? [];
      bucket.push(event);
      groups.set(key, bucket);
    }
    return groups;
  }

  function countsByCalendar(dayEvents: ScheduleEventPayload[]): Array<{ color: string; count: number; name: string }> {
    const map = new Map<string, { color: string; count: number; name: string }>();
    for (const event of dayEvents) {
      const key = event.calendarId ?? event.calendarName;
      const existing = map.get(key);
      if (existing) existing.count += 1;
      else {
        map.set(key, {
          color: event.calendarColor ?? '#1a73e8',
          count: 1,
          name: event.calendarName,
        });
      }
    }
    return [...map.values()];
  }

  function eventCountLabel(count: number): string {
    return count === 1 ? '1 event' : `${count} events`;
  }

  function renderStack(container: HTMLElement, events: ScheduleEventPayload[], size: SizeMode): void {
    container.dataset.view = 'stack';
    container.className =
      size === 'expanded' ? 'p-5' : 'min-h-0 flex-1 overflow-y-auto overscroll-contain p-3';
    if (events.length === 0) {
      container.innerHTML = '<div class="flex h-full items-center justify-center p-4"><p class="text-sm text-[#6b6c72]">No events in this range.</p></div>';
      return;
    }
    const groups = groupByDay(events);
    const titleClass = size === 'expanded' ? 'text-base' : 'text-sm';
    container.innerHTML = [...groups.keys()]
      .sort()
      .map((dayKey) => {
        const dayEvents = groups.get(dayKey) ?? [];
        const items = dayEvents
          .map(
            (event) => `
              <li class="rounded-md border border-[#eceef2] px-3 py-2">
                <div class="flex items-start justify-between gap-2">
                  <p class="${titleClass} font-semibold leading-snug text-[#393a3d]">${escapeHtml(event.title)}</p>
                  ${
                    event.htmlLink
                      ? `<a href="${escapeHtml(event.htmlLink)}" target="_blank" rel="noopener noreferrer" class="shrink-0 text-[11px] font-medium text-sage-dark hover:text-charcoal">Open</a>`
                      : ''
                  }
                </div>
                <p class="mt-1 text-[11px] text-[#6b6c72]">${escapeHtml(formatTime(event))}</p>
                ${
                  event.calendarName
                    ? `<p class="mt-1 text-[10px] uppercase tracking-[0.12em] text-[#8b8d93]">${escapeHtml(event.calendarName)}</p>`
                    : ''
                }
              </li>
            `,
          )
          .join('');
        return `
          <section class="mb-4 last:mb-0">
            <h3 class="text-[11px] font-semibold uppercase tracking-[0.12em] text-[#6b6c72]">${escapeHtml(formatDay(dayKey))}</h3>
            <ul class="mt-2 space-y-2">${items}</ul>
          </section>
        `;
      })
      .join('');
  }

  function layoutOverlappingTimedEventsClient<T extends { startMin: number; endMin: number }>(
    events: T[],
  ): Array<T & { column: number; columnCount: number }> {
    if (events.length === 0) return [];

    const sorted = [...events].sort(
      (left, right) => left.startMin - right.startMin || right.endMin - left.endMin,
    );

    const columns: number[] = [];
    const placed: Array<T & { column: number }> = [];

    for (const event of sorted) {
      let column = columns.findIndex((endMin) => endMin <= event.startMin);
      if (column === -1) {
        column = columns.length;
        columns.push(event.endMin);
      } else {
        columns[column] = event.endMin;
      }
      placed.push({ ...event, column });
    }

    return placed.map((event) => {
      const overlapping = placed.filter(
        (other) => other.startMin < event.endMin && event.startMin < other.endMin,
      );
      const columnCount = new Set(overlapping.map((other) => other.column)).size;
      return { ...event, columnCount: Math.max(columnCount, 1) };
    });
  }

  function layoutDayTimedEventsClient(events: ScheduleEventPayload[]) {
    const timed = events.filter((event) => !event.allDay);
    return layoutOverlappingTimedEventsClient(
      timed.map((event) => {
        const startMin = Math.max(minutesFromMidnight(event.start), 0);
        const endMin = Math.min(Math.max(minutesFromMidnight(event.end), startMin + 15), 24 * 60);
        return { event, startMin, endMin };
      }),
    );
  }

  function weekEventColumnStyleClient(column: number, columnCount: number): { left: string; width: string } {
    const widthPct = 100 / columnCount;
    const leftPct = column * widthPct;
    return {
      left: `calc(${leftPct}% + 1.5px)`,
      width: `calc(${widthPct}% - 3px)`,
    };
  }

  function renderWeek(container: HTMLElement, events: ScheduleEventPayload[], start: string, end: string, size: SizeMode): void {
    container.dataset.view = 'week';
    const hourHeight = size === 'expanded' ? 32 : 18;
    const titleSize = size === 'expanded' ? 'text-[11px]' : 'text-[8px]';
    container.className = size === 'expanded' ? '' : 'min-h-0 flex-1 overflow-auto overscroll-contain';
    const days = eachDay(start, end);
    const today = todayEastern();
    const byDay = groupByDay(events);
    const hasAllDay = events.some((event) => event.allDay);
    const hours = Array.from({ length: 24 }, (_, index) => index);

    const header = `
      <div class="sticky top-0 z-10 grid grid-cols-[2rem_repeat(7,minmax(0,1fr))] border-b border-[#eceef2] bg-white">
        <div class="border-r border-[#eceef2]"></div>
        ${days
          .map((day) => {
            const isToday = day === today;
            return `
              <div class="border-r border-[#eceef2] px-0.5 py-1.5 text-center last:border-r-0 ${isToday ? 'bg-[#eef4ff]' : ''}">
                <p class="text-[9px] font-semibold uppercase tracking-wide text-[#6b6c72]">${weekdayShort(day)}</p>
                <p class="mx-auto mt-0.5 flex h-5 w-5 items-center justify-center text-[11px] font-semibold ${isToday ? 'rounded-full bg-[#1a73e8] text-white' : 'text-[#393a3d]'}">${dayNumber(day)}</p>
              </div>
            `;
          })
          .join('')}
      </div>
    `;

    const allDayRow = hasAllDay
      ? `
      <div class="sticky top-[2.6rem] z-10 grid grid-cols-[2rem_repeat(7,minmax(0,1fr))] border-b border-[#eceef2] bg-white">
        <div class="border-r border-[#eceef2] px-0.5 py-1 text-[8px] text-[#8b8d93]">All</div>
        ${days
          .map((day) => {
            const dayAllDay = (byDay.get(day) ?? []).filter((event) => event.allDay);
            return `
              <div class="min-h-[1.25rem] space-y-0.5 border-r border-[#eceef2] px-0.5 py-0.5 last:border-r-0">
                ${dayAllDay
                  .map(
                    (event) => `
                      ${
                        size === 'expanded'
                          ? `<div class="truncate rounded-md px-0.5 ${titleSize} font-semibold leading-4 text-white border border-black/20" style="background-color: ${escapeHtml(event.calendarColor ?? '#6b6c72')}" title="${escapeHtml(event.title)}">${escapeHtml(event.title)}</div>`
                          : `<div class="min-h-3.5 rounded-md border border-black/20" style="background-color: ${escapeHtml(event.calendarColor ?? '#6b6c72')}" title="${escapeHtml(event.title)}"></div>`
                      }
                    `,
                  )
                  .join('')}
              </div>
            `;
          })
          .join('')}
      </div>
    `
      : '';

    const body = `
      <div class="relative grid grid-cols-[2rem_repeat(7,minmax(0,1fr))]" style="height: ${24 * hourHeight}px">
        <div class="relative border-r border-[#eceef2]">
          ${hours
            .map(
              (hour) => `
              <div class="absolute right-0.5 -translate-y-1/2 text-[8px] text-[#8b8d93]" style="top: ${hour * hourHeight}px">${hourLabel(hour)}</div>
            `,
            )
            .join('')}
        </div>
        ${days
          .map((day) => {
            const laidOut = layoutDayTimedEventsClient(byDay.get(day) ?? []);
            const isToday = day === today;
            return `
              <div class="relative border-r border-[#eceef2] last:border-r-0 ${isToday ? 'bg-[#f7faff]' : ''}">
                ${hours
                  .map(
                    (hour) => `
                    <div class="absolute inset-x-0 border-t border-[#f0f1f4]" style="top: ${hour * hourHeight}px"></div>
                  `,
                  )
                  .join('')}
                ${laidOut
                  .map(({ event, column, columnCount }) => {
                    const startMin = Math.max(minutesFromMidnight(event.start), 0);
                    const endMin = Math.min(Math.max(minutesFromMidnight(event.end), startMin + 15), 24 * 60);
                    const top = (startMin / 60) * hourHeight;
                    const height = Math.max(((endMin - startMin) / 60) * hourHeight, 14);
                    const columnStyle = weekEventColumnStyleClient(column, columnCount);
                    const href = event.htmlLink ? escapeHtml(event.htmlLink) : '#';
                    return `
                      ${
                        size === 'expanded'
                          ? `<a href="${href}" ${event.htmlLink ? 'target="_blank" rel="noopener noreferrer"' : ''} class="absolute overflow-hidden rounded-md px-0.5 ${titleSize} font-semibold leading-tight text-white border border-black/20" data-schedule-timed-event style="top: ${top}px; height: ${height}px; left: ${columnStyle.left}; width: ${columnStyle.width}; background-color: ${escapeHtml(event.calendarColor ?? '#1a73e8')}" title="${escapeHtml(event.title)} · ${escapeHtml(formatTime(event))}">${escapeHtml(event.title)}</a>`
                          : `<a href="${href}" ${event.htmlLink ? 'target="_blank" rel="noopener noreferrer"' : ''} class="absolute overflow-hidden rounded-md border border-black/20" data-schedule-timed-event style="top: ${top}px; height: ${height}px; left: ${columnStyle.left}; width: ${columnStyle.width}; background-color: ${escapeHtml(event.calendarColor ?? '#1a73e8')}" title="${escapeHtml(event.title)} · ${escapeHtml(formatTime(event))}"></a>`
                      }
                    `;
                  })
                  .join('')}
              </div>
            `;
          })
          .join('')}
      </div>
    `;

    container.innerHTML = header + allDayRow + body;
  }

  function renderMonth(container: HTMLElement, events: ScheduleEventPayload[], start: string, end: string, size: SizeMode): void {
    container.dataset.view = 'month';
    container.className = size === 'expanded' ? 'p-4' : 'min-h-0 flex-1 overflow-auto overscroll-contain p-2';
    const days = monthGridDays(start, end);
    const today = todayEastern();
    const monthPrefix = start.slice(0, 7);
    const byDay = groupByDay(events);
    const cellMin = size === 'expanded' ? 'min-h-[5.5rem]' : 'min-h-[3.1rem]';
    const countClass = size === 'expanded' ? 'text-[12px]' : 'text-[9px]';

    container.innerHTML = `
      <div class="mb-1 grid grid-cols-7 gap-px">
        ${WEEKDAY_HEADERS.map((label) => `<div class="py-1 text-center text-[9px] font-semibold uppercase tracking-wide text-[#6b6c72]">${label}</div>`).join('')}
      </div>
      <div class="grid grid-cols-7 gap-px rounded-md bg-[#eceef2] ring-1 ring-[#eceef2]">
        ${days
          .map((day) => {
            const inMonth = day.startsWith(monthPrefix);
            const dayEvents = byDay.get(day) ?? [];
            const counts = countsByCalendar(dayEvents);
            const isToday = day === today;
            return `
              <div class="${cellMin} p-1 ${inMonth ? 'bg-white' : 'bg-[#f7f8fa]'}">
                <p class="mb-0.5 inline-flex h-4 min-w-4 items-center justify-center px-0.5 text-[10px] font-semibold ${isToday ? 'rounded-full bg-[#1a73e8] text-white' : inMonth ? 'text-[#393a3d]' : 'text-[#b0b1b6]'}">${dayNumber(day)}</p>
                <div class="flex flex-col gap-0.5">
                  ${counts
                    .map(
                      (item) => `
                        <span class="${countClass} font-semibold leading-tight" style="color: ${escapeHtml(item.color)}" title="${escapeHtml(eventCountLabel(item.count))} on ${escapeHtml(item.name)}">${escapeHtml(eventCountLabel(item.count))}</span>
                      `,
                    )
                    .join('')}
                </div>
              </div>
            `;
          })
          .join('')}
      </div>
    `;
  }

  function formatHeading(range: { id: string; start: string; end: string }): string {
    if (range.id === 'today') {
      if (range.start === todayEastern()) return 'Today';
      return formatTodaySub(range.start);
    }
    if (range.id === 'this_week') {
      const startLabel = new Date(`${range.start}T12:00:00`).toLocaleDateString('en-US', {
        timeZone: TZ,
        month: 'short',
        day: 'numeric',
      });
      const endLabel = new Date(`${range.end}T12:00:00`).toLocaleDateString('en-US', {
        timeZone: TZ,
        month: 'short',
        day: 'numeric',
      });
      return `${startLabel} – ${endLabel}`;
    }
    if (range.id === 'this_month') {
      return new Date(`${range.start}T12:00:00`).toLocaleDateString('en-US', {
        timeZone: TZ,
        month: 'long',
      });
    }
    return range.id;
  }

  function formatTodaySub(isoDate: string): string {
    return new Date(`${isoDate}T12:00:00`).toLocaleDateString('en-US', {
      timeZone: TZ,
      weekday: 'short',
      month: 'short',
      day: 'numeric',
    });
  }

  function conflictCountLabelClient(count: number): string {
    return count === 1 ? '1 conflict' : `${count} conflicts`;
  }

  function conflictingEventCountClient(events: ScheduleEventPayload[]): number {
    const timed = events.filter((event) => !event.allDay);
    const byDay = new Map<string, ScheduleEventPayload[]>();
    for (const event of timed) {
      const dayKey = dayKeyForEvent(event);
      const bucket = byDay.get(dayKey) ?? [];
      bucket.push(event);
      byDay.set(dayKey, bucket);
    }

    let count = 0;
    for (const dayEvents of byDay.values()) {
      for (let index = 0; index < dayEvents.length; index += 1) {
        for (let otherIndex = index + 1; otherIndex < dayEvents.length; otherIndex += 1) {
          const eventA = dayEvents[index]!;
          const eventB = dayEvents[otherIndex]!;
          const startA = Date.parse(eventA.start);
          const endA = Date.parse(eventA.end);
          const startB = Date.parse(eventB.start);
          const endB = Date.parse(eventB.end);
          if (Number.isNaN(startA) || Number.isNaN(endA) || Number.isNaN(startB) || Number.isNaN(endB)) {
            continue;
          }
          if (startA >= endB || startB >= endA) continue;
          count += 1;
        }
      }
    }
    return count;
  }

  function updateConflictBadges(events: ScheduleEventPayload[]): void {
    const count = conflictingEventCountClient(events);
    const label = conflictCountLabelClient(count);
    document.querySelectorAll('[data-schedule-conflict-wrap]').forEach((wrap) => {
      if (!(wrap instanceof HTMLElement)) return;
      wrap.classList.toggle('hidden', count === 0);
      const badge = wrap.querySelector('[data-schedule-conflict-badge]');
      const labelEl = wrap.querySelector('[data-schedule-conflict-label]');
      const inlineEl = wrap.querySelector('[data-schedule-conflict-inline]');
      if (badge instanceof HTMLElement) {
        badge.setAttribute('aria-label', label);
        badge.setAttribute('aria-expanded', 'false');
      }
      if (labelEl instanceof HTMLElement) {
        labelEl.textContent = label;
        labelEl.classList.add('hidden');
      }
      if (inlineEl instanceof HTMLElement) {
        inlineEl.textContent = label;
      }
    });
  }

  function bindConflictBadges(): void {
    document.querySelectorAll('[data-schedule-conflict-badge]').forEach((node) => {
      if (!(node instanceof HTMLButtonElement) || node.dataset.bound === '1') return;
      node.dataset.bound = '1';
      node.addEventListener('click', (event) => {
        event.stopPropagation();
        const wrap = node.closest('[data-schedule-conflict-wrap]');
        const labelEl = wrap?.querySelector('[data-schedule-conflict-label]');
        if (!(labelEl instanceof HTMLElement)) return;
        const open = labelEl.classList.contains('hidden');
        document.querySelectorAll('[data-schedule-conflict-label]').forEach((other) => {
          if (other instanceof HTMLElement) other.classList.add('hidden');
        });
        document.querySelectorAll('[data-schedule-conflict-badge]').forEach((other) => {
          if (other instanceof HTMLElement) other.setAttribute('aria-expanded', 'false');
        });
        if (open) {
          labelEl.classList.remove('hidden');
          node.setAttribute('aria-expanded', 'true');
        }
      });
    });
  }

  function applyHeading(
    range: { id: string; start: string; end: string; label?: string } | undefined,
    labelEl: HTMLElement | null,
    subEl: HTMLElement | null,
    dialogLabel: HTMLElement | null,
    googleEmail: string | null,
  ): void {
    if (!range) return;
    const heading = formatHeading(range);
    if (labelEl) labelEl.textContent = heading;
    if (dialogLabel) dialogLabel.textContent = heading;
    if (subEl) {
      if (range.id === 'today') {
        subEl.textContent = formatTodaySub(range.start);
        subEl.classList.remove('hidden');
      } else if (googleEmail) {
        subEl.textContent = googleEmail;
        subEl.classList.remove('hidden');
      } else {
        subEl.textContent = '';
        subEl.classList.add('hidden');
      }
    }
  }

  function updateScrollHint(shell: HTMLElement): void {
    const list = shell.querySelector('[data-schedule-events]') as HTMLElement | null;
    const hint = shell.querySelector('[data-schedule-scroll-hint]') as HTMLElement | null;
    if (!list || !hint) {
      if (hint) hint.style.opacity = '0';
      return;
    }
    const overflow = list.scrollHeight > list.clientHeight + 4;
    hint.style.opacity = overflow ? '1' : '0';
  }

  function findWeekScrollContainer(container: HTMLElement): HTMLElement {
    let node: HTMLElement | null = container;
    while (node) {
      const style = getComputedStyle(node);
      if (
        (style.overflowY === 'auto' || style.overflowY === 'scroll') &&
        node.scrollHeight > node.clientHeight + 2
      ) {
        return node;
      }
      node = node.parentElement;
    }
    return container;
  }

  function scheduleWeekScroll(container: HTMLElement): void {
    const run = () => scrollWeekToFirstEvent(container);
    requestAnimationFrame(() => requestAnimationFrame(run));
    window.setTimeout(run, 150);
  }

  function scrollWeekToFirstEvent(container: HTMLElement): void {
    if (container.dataset.view !== 'week') return;
    const events = Array.from(container.querySelectorAll('[data-schedule-timed-event]')).filter(
      (node): node is HTMLElement => node instanceof HTMLElement,
    );
    if (events.length === 0) return;

    const scroller = findWeekScrollContainer(container);
    const scrollerRect = scroller.getBoundingClientRect();

    let minTop = Infinity;
    for (const event of events) {
      const rect = event.getBoundingClientRect();
      minTop = Math.min(minTop, rect.top - scrollerRect.top + scroller.scrollTop);
    }
    if (!Number.isFinite(minTop)) return;

    const stickyBottom = Array.from(container.querySelectorAll('.sticky'))
      .filter((node): node is HTMLElement => node instanceof HTMLElement)
      .reduce((max, node) => {
        const rect = node.getBoundingClientRect();
        return Math.max(max, rect.bottom - scrollerRect.top + scroller.scrollTop);
      }, 0);

    scroller.scrollTop = Math.max(0, minTop - stickyBottom - 8);
  }

  function ensureContainer(shell: HTMLElement): HTMLElement {
    let container = shell.querySelector('[data-schedule-events]') as HTMLElement | null;
    if (!container) {
      shell.innerHTML =
        '<div class="min-h-0 flex-1 overflow-auto overscroll-contain" data-schedule-events></div><p class="pointer-events-none shrink-0 px-3 pb-2 pt-1 text-center text-[10px] uppercase tracking-[0.14em] text-[#8b8d93] opacity-0 transition-opacity" data-schedule-scroll-hint>Scroll for more</p>';
      container = shell.querySelector('[data-schedule-events]') as HTMLElement;
    }
    return container;
  }

  function paint(
    container: HTMLElement,
    payload: EventsResponse,
    size: SizeMode,
  ): void {
    const events = payload.events ?? [];
    if (payload.range?.id === 'this_week' && payload.range.start && payload.range.end) {
      renderWeek(container, events, payload.range.start, payload.range.end, size);
    } else if (payload.range?.id === 'this_month' && payload.range.start && payload.range.end) {
      renderMonth(container, events, payload.range.start, payload.range.end, size);
    } else {
      renderStack(container, events, size);
    }
  }

  function initScheduleCard(root: HTMLElement): void {
    const userId = root.dataset.userId ?? '';
    const connected = root.dataset.connected === '1';
    const shell = root.querySelector('[data-schedule-events-shell]') as HTMLElement | null;
    const labelEl = root.querySelector('[data-schedule-range-label]') as HTMLElement | null;
    const subEl = root.querySelector('[data-schedule-range-sub]') as HTMLElement | null;
    const rangeSelect = root.querySelector('[data-schedule-range]') as HTMLSelectElement | null;
    const prevButton = root.querySelector('[data-schedule-prev]') as HTMLButtonElement | null;
    const nextButton = root.querySelector('[data-schedule-next]') as HTMLButtonElement | null;
    const expandButton = root.querySelector('[data-schedule-expand]') as HTMLButtonElement | null;
    const dialog = document.querySelector('[data-schedule-dialog]') as HTMLDialogElement | null;
    const dialogLabel = dialog?.querySelector('[data-schedule-dialog-label]') as HTMLElement | null;
    const dialogRange = dialog?.querySelector('[data-schedule-dialog-range]') as HTMLSelectElement | null;
    const dialogPrev = dialog?.querySelector('[data-schedule-dialog-prev]') as HTMLButtonElement | null;
    const dialogNext = dialog?.querySelector('[data-schedule-dialog-next]') as HTMLButtonElement | null;
    const dialogEvents = dialog?.querySelector('[data-schedule-dialog-events]') as HTMLElement | null;
    const dialogClose = dialog?.querySelector('[data-schedule-dialog-close]') as HTMLButtonElement | null;
    const dialogSync = dialog?.querySelector('[data-schedule-dialog-sync]') as HTMLButtonElement | null;
    const knownEmail = (root.dataset.googleEmail ?? '').trim() || null;

    let latestPayload: EventsResponse | null = null;
    let currentAnchor = anchorForRange(rangeSelect?.value ?? 'this_week');

    function updateNavLabels(rangeId: string): void {
      const prevLabel = rangeNavLabel(rangeId, 'prev');
      const nextLabel = rangeNavLabel(rangeId, 'next');
      prevButton?.setAttribute('aria-label', prevLabel);
      nextButton?.setAttribute('aria-label', nextLabel);
      dialogPrev?.setAttribute('aria-label', prevLabel);
      dialogNext?.setAttribute('aria-label', nextLabel);
    }

    async function loadEvents(
      rangeId: string,
      anchor = currentAnchor,
      options?: { refresh?: boolean },
    ): Promise<void> {
      if (!shell) return;
      currentAnchor = anchor;
      writeStoredView(userId, rangeId, anchor);
      updateNavLabels(rangeId);

      const refreshQuery = options?.refresh ? '&refresh=1' : '';
      const response = await fetch(
        `/api/google-calendar/events?range=${encodeURIComponent(rangeId)}&anchor=${encodeURIComponent(anchor)}${refreshQuery}`,
        {
          headers: { accept: 'application/json' },
        },
      );
      const payload = (await response.json()) as EventsResponse;
      latestPayload = payload;
      applyHeading(payload.range, labelEl, subEl, dialogLabel, knownEmail);
      if (payload.range?.start) root.dataset.rangeStart = payload.range.start;
      if (payload.range?.end) root.dataset.rangeEnd = payload.range.end;

      if (payload.connection?.lastError) {
        shell.innerHTML = `<div class="p-4"><p class="text-sm text-red-700">${escapeHtml(payload.connection.lastError)}</p></div>`;
        return;
      }

      const container = ensureContainer(shell);
      paint(container, payload, 'compact');
      updateConflictBadges(payload.events ?? []);
      scheduleWeekScroll(container);
      requestAnimationFrame(() => updateScrollHint(shell));
      container.onscroll = () => updateScrollHint(shell);

      if (dialogEvents && dialog?.open) {
        paint(dialogEvents, payload, 'expanded');
        scheduleWeekScroll(dialogEvents);
      }
    }

    function syncRangeControls(rangeId: string): void {
      if (rangeSelect) rangeSelect.value = rangeId;
      if (dialogRange) dialogRange.value = rangeId;
      updateNavLabels(rangeId);
    }

    function navigate(direction: -1 | 1): void {
      if (!rangeSelect) return;
      const rangeId = rangeSelect.value;
      const nextAnchor = shiftAnchor(rangeId, currentAnchor, direction);
      syncRangeControls(rangeId);
      void loadEvents(rangeId, nextAnchor);
    }

    if (!connected || !shell || !rangeSelect) {
      updateScrollHint(shell ?? root);
      return;
    }

    const storedView = readStoredView(userId);
    if (storedView) {
      syncRangeControls(storedView.rangeId);
      currentAnchor = storedView.anchor;
      void loadEvents(storedView.rangeId, storedView.anchor);
    } else {
      updateNavLabels(rangeSelect.value);
      updateScrollHint(shell);
      const weekContainer = shell.querySelector('[data-schedule-events]') as HTMLElement | null;
      if (weekContainer) {
        scheduleWeekScroll(weekContainer);
        requestAnimationFrame(() => updateScrollHint(shell));
      }
      shell.querySelector('[data-schedule-events]')?.addEventListener('scroll', () => updateScrollHint(shell));
    }

    rangeSelect.addEventListener('change', () => {
      const rangeId = rangeSelect.value;
      const nextAnchor = anchorForRange(rangeId);
      syncRangeControls(rangeId);
      void loadEvents(rangeId, nextAnchor);
    });

    dialogRange?.addEventListener('change', () => {
      const rangeId = dialogRange.value;
      const nextAnchor = anchorForRange(rangeId);
      syncRangeControls(rangeId);
      void loadEvents(rangeId, nextAnchor);
    });

    prevButton?.addEventListener('click', () => navigate(-1));
    nextButton?.addEventListener('click', () => navigate(1));
    dialogPrev?.addEventListener('click', () => navigate(-1));
    dialogNext?.addEventListener('click', () => navigate(1));

    dialogSync?.addEventListener('click', () => {
      if (!rangeSelect) return;
      const button = dialogSync;
      const previousLabel = button.textContent ?? 'Sync';
      button.disabled = true;
      button.textContent = 'Syncing…';
      void loadEvents(rangeSelect.value, currentAnchor, { refresh: true }).finally(() => {
        button.disabled = false;
        button.textContent = previousLabel;
      });
    });

    expandButton?.addEventListener('click', () => {
      if (!dialog || !dialogEvents) return;
      if (dialogRange && rangeSelect) dialogRange.value = rangeSelect.value;
      if (latestPayload) {
        paint(dialogEvents, latestPayload, 'expanded');
        applyHeading(latestPayload.range, labelEl, subEl, dialogLabel, knownEmail);
        scheduleWeekScroll(dialogEvents);
      } else {
        void loadEvents(rangeSelect.value, currentAnchor).then(() => {
          if (latestPayload) {
            paint(dialogEvents, latestPayload, 'expanded');
            scheduleWeekScroll(dialogEvents);
          }
        });
      }
      dialog.showModal();
      if (dialogEvents?.dataset.view === 'week') {
        scheduleWeekScroll(dialogEvents);
      }
    });

    dialogClose?.addEventListener('click', () => dialog?.close());
    dialog?.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });

    bindConflictBadges();
  }

  document.addEventListener('click', (event) => {
    const target = event.target;
    if (!(target instanceof Node)) return;
    if (target instanceof Element && target.closest('[data-schedule-conflict-wrap]')) return;
    document.querySelectorAll('[data-schedule-conflict-label]').forEach((node) => {
      if (node instanceof HTMLElement) node.classList.add('hidden');
    });
    document.querySelectorAll('[data-schedule-conflict-badge]').forEach((node) => {
      if (node instanceof HTMLElement) node.setAttribute('aria-expanded', 'false');
    });
  });

  document.querySelectorAll('[data-schedule-card]').forEach((node) => initScheduleCard(node as HTMLElement));
  bindConflictBadges();
</script>

<style>
  .schedule-expand-dialog::backdrop {
    background: rgba(26, 28, 30, 0.5);
  }
</style>
