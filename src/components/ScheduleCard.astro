---
import {
  eachDayInRange,
  easternMinutesFromMidnight,
  formatDayNumber,
  formatScheduleEventDay,
  formatScheduleEventTime,
  formatWeekdayShort,
  groupEventsByDay,
} from '../lib/schedule/range';
import { getScheduleSummary, scheduleRangeOptions } from '../lib/schedule/summary';
import { todayEastern } from '../lib/financials/periods';
import type { ScheduleEvent } from '../lib/schedule/types';

interface Props {
  userId: string;
  ownerEmail: string;
  employeeName: string;
}

const { userId, ownerEmail, employeeName } = Astro.props;

let summary = null;
try {
  summary = await getScheduleSummary(userId, 'this_week');
} catch (error) {
  console.error('home schedule summary failed', error);
}

const connection = summary?.connection ?? {
  status: 'disconnected' as const,
  googleEmail: null,
  lastError: null,
  configured: false,
};
const range = summary?.range ?? null;
const events = summary?.events ?? [];
const rangeOptions = scheduleRangeOptions();
const isWeekGrid = range?.id === 'this_week';
const today = todayEastern();
const weekDays = range ? eachDayInRange(range.start, range.end) : [];
const grouped = groupEventsByDay(events);
const dayKeys = [...grouped.keys()].sort();

const timedEvents = events.filter((event) => !event.allDay);
const eventMinutes = timedEvents.flatMap((event) => [
  easternMinutesFromMidnight(event.start),
  easternMinutesFromMidnight(event.end),
]);
const minHour = eventMinutes.length ? Math.max(0, Math.floor(Math.min(...eventMinutes) / 60) - 1) : 8;
const maxHour = eventMinutes.length ? Math.min(24, Math.ceil(Math.max(...eventMinutes) / 60) + 1) : 18;
const startHour = Math.min(minHour, 8);
const endHour = Math.max(maxHour, startHour + 8);
const hourHeight = 18;
const gridHours = Array.from({ length: endHour - startHour }, (_, index) => startHour + index);
const allDayByDay = new Map(
  weekDays.map((day) => [day, (grouped.get(day) ?? []).filter((event) => event.allDay)]),
);
const hasAllDay = [...allDayByDay.values()].some((list) => list.length > 0);

const timeOffSubject = encodeURIComponent('Time off request');
const timeOffBody = encodeURIComponent(
  `Hi,\n\nI'd like to request time off.\n\nName: ${employeeName}\nDates: \nReason: \n\nThank you.`,
);
const timeOffHref = ownerEmail
  ? `mailto:${ownerEmail}?subject=${timeOffSubject}&body=${timeOffBody}`
  : '#';

function eventTimeLabel(event: ScheduleEvent): string {
  return formatScheduleEventTime(event);
}

function eventTop(event: ScheduleEvent): number {
  const minutes = Math.max(easternMinutesFromMidnight(event.start), startHour * 60);
  return ((minutes - startHour * 60) / 60) * hourHeight;
}

function eventHeight(event: ScheduleEvent): number {
  const start = Math.max(easternMinutesFromMidnight(event.start), startHour * 60);
  const end = Math.min(easternMinutesFromMidnight(event.end), endHour * 60);
  return Math.max(((end - start) / 60) * hourHeight, 14);
}

function hourLabel(hour: number): string {
  const suffix = hour >= 12 ? 'p' : 'a';
  const display = hour % 12 === 0 ? 12 : hour % 12;
  return `${display}${suffix}`;
}
---

<aside
  class="flex h-full min-h-[28rem] flex-col overflow-hidden rounded-[1.05rem] shadow-[0_12px_32px_rgba(26,28,30,0.12)] ring-1 ring-black/10"
  aria-labelledby="home-schedule-heading"
  data-schedule-card
  data-user-id={userId}
  data-connected={connection.status === 'connected' ? '1' : '0'}
  data-range-start={range?.start ?? ''}
  data-range-end={range?.end ?? ''}
>
  <div class="bg-sage-dark px-3 py-2.5 text-cream">
    <div class="flex items-center gap-2">
      <span
        class="flex h-7 w-7 items-center justify-center rounded-md bg-white/15 text-cream ring-1 ring-white/20"
        aria-hidden="true"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
          <rect x="3" y="5" width="18" height="16" rx="2" stroke="currentColor" stroke-width="1.75" />
          <path d="M3 10h18M8 3v4M16 3v4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" />
        </svg>
      </span>
      <h2 id="home-schedule-heading" class="text-sm font-semibold leading-none">Schedule</h2>
    </div>
  </div>

  <div class="flex flex-1 flex-col bg-[#f4f5f8] px-4 pb-4 pt-3 font-sans text-[#393a3d]">
    <div class="flex items-start justify-between gap-3">
      <div>
        <p class="text-[11px] font-semibold uppercase tracking-[0.14em] text-[#6b6c72]">Calendar</p>
        <p class="mt-1 text-base font-semibold leading-tight" data-schedule-range-label>
          {range?.label ?? 'This week'}
        </p>
        {
          connection.status === 'connected' && connection.googleEmail ? (
            <p class="mt-1 text-[11px] text-[#6b6c72]">{connection.googleEmail}</p>
          ) : null
        }
      </div>
      {
        connection.status === 'connected' ? (
          <label class="shrink-0">
            <span class="sr-only">Schedule range</span>
            <select class="rounded-md border border-[#d5d8de] bg-white px-2 py-1 text-[11px] font-medium text-[#393a3d]" data-schedule-range>
              {
                rangeOptions.map((option) => (
                  <option value={option.id} selected={option.id === (range?.id ?? 'this_week')}>
                    {option.label}
                  </option>
                ))
              }
            </select>
          </label>
        ) : null
      }
    </div>

    <div class="mt-3 min-h-0 flex-1 overflow-hidden rounded-lg bg-white shadow-sm ring-1 ring-black/[0.06]" data-schedule-events-shell>
      {
        connection.status !== 'connected' ? (
          <div class="flex h-full flex-col justify-center gap-3 p-4">
            {
              !connection.configured ? (
                <p class="text-sm text-[#6b6c72]">
                  Google Calendar is not configured yet. Ask an admin to add the OAuth credentials.
                </p>
              ) : (
                <>
                  <p class="text-sm text-[#6b6c72]">
                    Connect your Google account to see your calendar events on the home page.
                  </p>
                  <form method="post" action="/api/google-calendar/connect" class="contents">
                    <input type="hidden" name="returnTo" value="/" />
                    <button
                      type="submit"
                      class="inline-flex items-center justify-center rounded-lg bg-sage-dark px-3 py-2 text-sm font-semibold text-cream transition hover:bg-charcoal"
                    >
                      Connect Google Calendar
                    </button>
                  </form>
                </>
              )
            }
          </div>
        ) : connection.lastError ? (
          <div class="p-4">
            <p class="text-sm text-red-700">{connection.lastError}</p>
          </div>
        ) : isWeekGrid ? (
          <div class="financials-scroll-panel max-h-[17rem] overflow-auto" data-schedule-events data-view="week">
            <div class="sticky top-0 z-10 grid grid-cols-[1.6rem_repeat(7,minmax(0,1fr))] border-b border-[#eceef2] bg-white">
              <div class="border-r border-[#eceef2]"></div>
              {
                weekDays.map((day) => (
                  <div class={`border-r border-[#eceef2] px-0.5 py-1.5 text-center last:border-r-0 ${day === today ? 'bg-[#eef4ff]' : ''}`}>
                    <p class="text-[9px] font-semibold uppercase tracking-wide text-[#6b6c72]">{formatWeekdayShort(day).slice(0, 3)}</p>
                    <p class:list={['mx-auto mt-0.5 flex h-5 w-5 items-center justify-center text-[11px] font-semibold', day === today ? 'rounded-full bg-[#1a73e8] text-white' : 'text-[#393a3d]']}>
                      {formatDayNumber(day)}
                    </p>
                  </div>
                ))
              }
            </div>
            {
              hasAllDay ? (
                <div class="grid grid-cols-[1.6rem_repeat(7,minmax(0,1fr))] border-b border-[#eceef2]">
                  <div class="border-r border-[#eceef2] px-0.5 py-1 text-[8px] text-[#8b8d93]">All</div>
                  {
                    weekDays.map((day) => (
                      <div class="min-h-[1.25rem] space-y-0.5 border-r border-[#eceef2] px-0.5 py-0.5 last:border-r-0">
                        {
                          (allDayByDay.get(day) ?? []).map((event) => (
                            <div
                              class="truncate rounded px-0.5 text-[8px] font-semibold leading-4 text-white"
                              style={`background-color: ${event.calendarColor ?? '#6b6c72'}`}
                              title={event.title}
                            >
                              {event.title}
                            </div>
                          ))
                        }
                      </div>
                    ))
                  }
                </div>
              ) : null
            }
            <div class="relative grid grid-cols-[1.6rem_repeat(7,minmax(0,1fr))]" style={`height: ${(endHour - startHour) * hourHeight}px`}>
              <div class="relative border-r border-[#eceef2]">
                {
                  gridHours.map((hour) => (
                    <div class="absolute right-0.5 -translate-y-1/2 text-[8px] text-[#8b8d93]" style={`top: ${(hour - startHour) * hourHeight}px`}>
                      {hourLabel(hour)}
                    </div>
                  ))
                }
              </div>
              {
                weekDays.map((day) => {
                  const dayTimed = (grouped.get(day) ?? []).filter((event) => !event.allDay);
                  return (
                    <div class={`relative border-r border-[#eceef2] last:border-r-0 ${day === today ? 'bg-[#f7faff]' : ''}`}>
                      {
                        gridHours.map((hour) => (
                          <div class="absolute inset-x-0 border-t border-[#f0f1f4]" style={`top: ${(hour - startHour) * hourHeight}px`}></div>
                        ))
                      }
                      {
                        dayTimed.map((event) => (
                          <a
                            href={event.htmlLink ?? '#'}
                            target={event.htmlLink ? '_blank' : undefined}
                            rel={event.htmlLink ? 'noopener noreferrer' : undefined}
                            class="absolute inset-x-0.5 overflow-hidden rounded px-0.5 text-[8px] font-semibold leading-tight text-white"
                            style={`top: ${eventTop(event)}px; height: ${eventHeight(event)}px; background-color: ${event.calendarColor ?? '#1a73e8'};`}
                            title={`${event.title} · ${eventTimeLabel(event)}`}
                          >
                            {event.title}
                          </a>
                        ))
                      }
                    </div>
                  );
                })
              }
            </div>
          </div>
        ) : events.length === 0 ? (
          <div class="flex h-full items-center justify-center p-4" data-schedule-events data-view="stack">
            <p class="text-sm text-[#6b6c72]">No events in this range.</p>
          </div>
        ) : (
          <div class="financials-scroll-panel max-h-[15.5rem] overflow-y-auto p-3" data-schedule-events data-view="stack">
            {
              dayKeys.map((dayKey) => {
                const dayEvents = grouped.get(dayKey) ?? [];
                return (
                  <section class="mb-4 last:mb-0">
                    <h3 class="text-[11px] font-semibold uppercase tracking-[0.12em] text-[#6b6c72]">
                      {formatScheduleEventDay(dayKey.includes('T') ? dayKey : `${dayKey}T12:00:00`)}
                    </h3>
                    <ul class="mt-2 space-y-2">
                      {
                        dayEvents.map((event) => (
                          <li class="rounded-md border border-[#eceef2] px-3 py-2">
                            <div class="flex items-start justify-between gap-2">
                              <p class="text-sm font-semibold leading-snug text-[#393a3d]">{event.title}</p>
                              {
                                event.htmlLink ? (
                                  <a
                                    href={event.htmlLink}
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    class="shrink-0 text-[11px] font-medium text-sage-dark hover:text-charcoal"
                                  >
                                    Open
                                  </a>
                                ) : null
                              }
                            </div>
                            <p class="mt-1 text-[11px] text-[#6b6c72]">{eventTimeLabel(event)}</p>
                            {
                              event.calendarName ? (
                                <p class="mt-1 text-[10px] uppercase tracking-[0.12em] text-[#8b8d93]">
                                  {event.calendarName}
                                </p>
                              ) : null
                            }
                          </li>
                        ))
                      }
                    </ul>
                  </section>
                );
              })
            }
          </div>
        )
      }
      <p class="financials-scroll-hint pointer-events-none px-3 pb-2 text-center text-[10px] uppercase tracking-[0.14em] text-[#8b8d93] opacity-0 transition-opacity" data-schedule-scroll-hint>
        Scroll for more
      </p>
    </div>

    <div class="mt-3 flex flex-wrap items-center justify-between gap-2">
      {
        connection.status === 'connected' ? (
          <a href="/settings#google-calendar" class="text-[10px] font-medium text-sage-dark/70 hover:text-sage-dark">
            Manage calendars
          </a>
        ) : (
          <span></span>
        )
      }
      <a
        href={timeOffHref}
        class:list={[
          'text-[10px] font-medium transition',
          ownerEmail ? 'text-sage-dark/60 hover:text-sage-dark' : 'pointer-events-none text-sage-dark/30',
        ]}
      >
        Request time off
      </a>
    </div>
  </div>
</aside>

<script>
  type ScheduleEventPayload = {
    id: string;
    title: string;
    start: string;
    end: string;
    allDay: boolean;
    calendarName: string;
    calendarColor: string | null;
    htmlLink: string | null;
  };

  type EventsResponse = {
    range?: { id: string; start: string; end: string; label: string };
    events?: ScheduleEventPayload[];
    connection?: { lastError?: string | null; status?: string };
  };

  const TZ = 'America/New_York';
  const HOUR_HEIGHT = 18;

  function rangeStorageKey(userId: string): string {
    return `portal:schedule-range:${userId}`;
  }

  function readStoredRange(userId: string): string | null {
    try {
      return localStorage.getItem(rangeStorageKey(userId));
    } catch {
      return null;
    }
  }

  function writeStoredRange(userId: string, rangeId: string): void {
    try {
      localStorage.setItem(rangeStorageKey(userId), rangeId);
    } catch {
      // ignore
    }
  }

  function escapeHtml(value: string): string {
    return value
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;');
  }

  function todayEastern(): string {
    return new Intl.DateTimeFormat('en-CA', {
      timeZone: TZ,
      year: 'numeric',
      month: '2-digit',
      day: '2-digit',
    }).format(new Date());
  }

  function addDays(iso: string, days: number): string {
    const [year, month, day] = iso.split('-').map(Number);
    const date = new Date(Date.UTC(year, month - 1, day + days));
    return `${date.getUTCFullYear()}-${String(date.getUTCMonth() + 1).padStart(2, '0')}-${String(date.getUTCDate()).padStart(2, '0')}`;
  }

  function eachDay(start: string, end: string): string[] {
    const days: string[] = [];
    let cursor = start;
    for (let i = 0; i < 32; i += 1) {
      days.push(cursor);
      if (cursor === end) break;
      cursor = addDays(cursor, 1);
    }
    return days;
  }

  function dayKeyForEvent(event: ScheduleEventPayload): string {
    if (event.allDay) return event.start.slice(0, 10);
    return new Intl.DateTimeFormat('en-CA', {
      timeZone: TZ,
      year: 'numeric',
      month: '2-digit',
      day: '2-digit',
    }).format(new Date(event.start));
  }

  function minutesFromMidnight(iso: string): number {
    if (!iso.includes('T')) return 0;
    const parts = new Intl.DateTimeFormat('en-US', {
      timeZone: TZ,
      hour: '2-digit',
      minute: '2-digit',
      hour12: false,
    }).formatToParts(new Date(iso));
    const hour = Number(parts.find((part) => part.type === 'hour')?.value ?? 0);
    const minute = Number(parts.find((part) => part.type === 'minute')?.value ?? 0);
    return hour * 60 + minute;
  }

  function formatDay(value: string): string {
    const ms = Date.parse(value.includes('T') ? value : `${value}T12:00:00`);
    return new Date(ms).toLocaleDateString('en-US', {
      timeZone: TZ,
      weekday: 'short',
      month: 'short',
      day: 'numeric',
    });
  }

  function formatTime(event: ScheduleEventPayload): string {
    if (event.allDay) return 'All day';
    const startLabel = new Date(event.start).toLocaleTimeString('en-US', {
      timeZone: TZ,
      hour: 'numeric',
      minute: '2-digit',
    });
    const endLabel = new Date(event.end).toLocaleTimeString('en-US', {
      timeZone: TZ,
      hour: 'numeric',
      minute: '2-digit',
    });
    return `${startLabel} – ${endLabel}`;
  }

  function hourLabel(hour: number): string {
    const suffix = hour >= 12 ? 'p' : 'a';
    const display = hour % 12 === 0 ? 12 : hour % 12;
    return `${display}${suffix}`;
  }

  function weekdayShort(iso: string): string {
    return new Date(`${iso}T12:00:00`).toLocaleDateString('en-US', { timeZone: TZ, weekday: 'short' }).slice(0, 3);
  }

  function dayNumber(iso: string): string {
    return new Date(`${iso}T12:00:00`).toLocaleDateString('en-US', { timeZone: TZ, day: 'numeric' });
  }

  function renderStack(container: HTMLElement, events: ScheduleEventPayload[]): void {
    container.dataset.view = 'stack';
    container.className = 'financials-scroll-panel max-h-[15.5rem] overflow-y-auto p-3';
    if (events.length === 0) {
      container.innerHTML = '<div class="flex h-full items-center justify-center p-4"><p class="text-sm text-[#6b6c72]">No events in this range.</p></div>';
      return;
    }
    const groups = new Map<string, ScheduleEventPayload[]>();
    for (const event of events) {
      const key = dayKeyForEvent(event);
      const bucket = groups.get(key) ?? [];
      bucket.push(event);
      groups.set(key, bucket);
    }
    container.innerHTML = [...groups.keys()]
      .sort()
      .map((dayKey) => {
        const dayEvents = groups.get(dayKey) ?? [];
        const items = dayEvents
          .map(
            (event) => `
              <li class="rounded-md border border-[#eceef2] px-3 py-2">
                <div class="flex items-start justify-between gap-2">
                  <p class="text-sm font-semibold leading-snug text-[#393a3d]">${escapeHtml(event.title)}</p>
                  ${
                    event.htmlLink
                      ? `<a href="${escapeHtml(event.htmlLink)}" target="_blank" rel="noopener noreferrer" class="shrink-0 text-[11px] font-medium text-sage-dark hover:text-charcoal">Open</a>`
                      : ''
                  }
                </div>
                <p class="mt-1 text-[11px] text-[#6b6c72]">${escapeHtml(formatTime(event))}</p>
                ${
                  event.calendarName
                    ? `<p class="mt-1 text-[10px] uppercase tracking-[0.12em] text-[#8b8d93]">${escapeHtml(event.calendarName)}</p>`
                    : ''
                }
              </li>
            `,
          )
          .join('');
        return `
          <section class="mb-4 last:mb-0">
            <h3 class="text-[11px] font-semibold uppercase tracking-[0.12em] text-[#6b6c72]">${escapeHtml(formatDay(dayKey))}</h3>
            <ul class="mt-2 space-y-2">${items}</ul>
          </section>
        `;
      })
      .join('');
  }

  function renderWeek(
    container: HTMLElement,
    events: ScheduleEventPayload[],
    start: string,
    end: string,
  ): void {
    container.dataset.view = 'week';
    container.className = 'financials-scroll-panel max-h-[17rem] overflow-auto';
    const days = eachDay(start, end);
    const today = todayEastern();
    const timed = events.filter((event) => !event.allDay);
    const minutes = timed.flatMap((event) => [minutesFromMidnight(event.start), minutesFromMidnight(event.end)]);
    const minHour = minutes.length ? Math.max(0, Math.floor(Math.min(...minutes) / 60) - 1) : 8;
    const maxHour = minutes.length ? Math.min(24, Math.ceil(Math.max(...minutes) / 60) + 1) : 18;
    const startHour = Math.min(minHour, 8);
    const endHour = Math.max(maxHour, startHour + 8);
    const hours = Array.from({ length: endHour - startHour }, (_, index) => startHour + index);
    const byDay = new Map<string, ScheduleEventPayload[]>();
    for (const day of days) byDay.set(day, []);
    for (const event of events) {
      const key = dayKeyForEvent(event);
      const bucket = byDay.get(key);
      if (bucket) bucket.push(event);
    }
    const hasAllDay = events.some((event) => event.allDay);

    const header = `
      <div class="sticky top-0 z-10 grid grid-cols-[1.6rem_repeat(7,minmax(0,1fr))] border-b border-[#eceef2] bg-white">
        <div class="border-r border-[#eceef2]"></div>
        ${days
          .map((day) => {
            const isToday = day === today;
            return `
              <div class="border-r border-[#eceef2] px-0.5 py-1.5 text-center last:border-r-0 ${isToday ? 'bg-[#eef4ff]' : ''}">
                <p class="text-[9px] font-semibold uppercase tracking-wide text-[#6b6c72]">${weekdayShort(day)}</p>
                <p class="mx-auto mt-0.5 flex h-5 w-5 items-center justify-center text-[11px] font-semibold ${isToday ? 'rounded-full bg-[#1a73e8] text-white' : 'text-[#393a3d]'}">${dayNumber(day)}</p>
              </div>
            `;
          })
          .join('')}
      </div>
    `;

    const allDayRow = hasAllDay
      ? `
      <div class="grid grid-cols-[1.6rem_repeat(7,minmax(0,1fr))] border-b border-[#eceef2]">
        <div class="border-r border-[#eceef2] px-0.5 py-1 text-[8px] text-[#8b8d93]">All</div>
        ${days
          .map((day) => {
            const dayAllDay = (byDay.get(day) ?? []).filter((event) => event.allDay);
            return `
              <div class="min-h-[1.25rem] space-y-0.5 border-r border-[#eceef2] px-0.5 py-0.5 last:border-r-0">
                ${dayAllDay
                  .map(
                    (event) => `
                      <div class="truncate rounded px-0.5 text-[8px] font-semibold leading-4 text-white" style="background-color: ${escapeHtml(event.calendarColor ?? '#6b6c72')}" title="${escapeHtml(event.title)}">${escapeHtml(event.title)}</div>
                    `,
                  )
                  .join('')}
              </div>
            `;
          })
          .join('')}
      </div>
    `
      : '';

    const body = `
      <div class="relative grid grid-cols-[1.6rem_repeat(7,minmax(0,1fr))]" style="height: ${(endHour - startHour) * HOUR_HEIGHT}px">
        <div class="relative border-r border-[#eceef2]">
          ${hours
            .map(
              (hour) => `
              <div class="absolute right-0.5 -translate-y-1/2 text-[8px] text-[#8b8d93]" style="top: ${(hour - startHour) * HOUR_HEIGHT}px">${hourLabel(hour)}</div>
            `,
            )
            .join('')}
        </div>
        ${days
          .map((day) => {
            const dayTimed = (byDay.get(day) ?? []).filter((event) => !event.allDay);
            const isToday = day === today;
            return `
              <div class="relative border-r border-[#eceef2] last:border-r-0 ${isToday ? 'bg-[#f7faff]' : ''}">
                ${hours
                  .map(
                    (hour) => `
                    <div class="absolute inset-x-0 border-t border-[#f0f1f4]" style="top: ${(hour - startHour) * HOUR_HEIGHT}px"></div>
                  `,
                  )
                  .join('')}
                ${dayTimed
                  .map((event) => {
                    const startMin = Math.max(minutesFromMidnight(event.start), startHour * 60);
                    const endMin = Math.min(minutesFromMidnight(event.end), endHour * 60);
                    const top = ((startMin - startHour * 60) / 60) * HOUR_HEIGHT;
                    const height = Math.max(((endMin - startMin) / 60) * HOUR_HEIGHT, 14);
                    const href = event.htmlLink ? escapeHtml(event.htmlLink) : '#';
                    return `
                      <a href="${href}" ${event.htmlLink ? 'target="_blank" rel="noopener noreferrer"' : ''} class="absolute inset-x-0.5 overflow-hidden rounded px-0.5 text-[8px] font-semibold leading-tight text-white" style="top: ${top}px; height: ${height}px; background-color: ${escapeHtml(event.calendarColor ?? '#1a73e8')}" title="${escapeHtml(event.title)} · ${escapeHtml(formatTime(event))}">${escapeHtml(event.title)}</a>
                    `;
                  })
                  .join('')}
              </div>
            `;
          })
          .join('')}
      </div>
    `;

    container.innerHTML = header + allDayRow + body;
  }

  function updateScrollHint(shell: HTMLElement): void {
    const list = shell.querySelector('[data-schedule-events]') as HTMLElement | null;
    const hint = shell.querySelector('[data-schedule-scroll-hint]') as HTMLElement | null;
    if (!list || !hint) {
      if (hint) hint.style.opacity = '0';
      return;
    }
    const overflow = list.scrollHeight > list.clientHeight + 4;
    hint.style.opacity = overflow ? '1' : '0';
  }

  function ensureContainer(shell: HTMLElement): HTMLElement {
    let container = shell.querySelector('[data-schedule-events]') as HTMLElement | null;
    if (!container) {
      shell.innerHTML =
        '<div class="financials-scroll-panel max-h-[15.5rem] overflow-y-auto p-3" data-schedule-events></div><p class="financials-scroll-hint pointer-events-none px-3 pb-2 text-center text-[10px] uppercase tracking-[0.14em] text-[#8b8d93] opacity-0 transition-opacity" data-schedule-scroll-hint>Scroll for more</p>';
      container = shell.querySelector('[data-schedule-events]') as HTMLElement;
    }
    return container;
  }

  async function loadEvents(
    rangeId: string,
    shell: HTMLElement,
    labelEl: HTMLElement | null,
    root: HTMLElement,
  ): Promise<void> {
    const response = await fetch(`/api/google-calendar/events?range=${encodeURIComponent(rangeId)}`, {
      headers: { accept: 'application/json' },
    });
    const payload = (await response.json()) as EventsResponse;
    if (labelEl && payload.range?.label) labelEl.textContent = payload.range.label;
    if (payload.range?.start) root.dataset.rangeStart = payload.range.start;
    if (payload.range?.end) root.dataset.rangeEnd = payload.range.end;

    if (payload.connection?.lastError) {
      shell.innerHTML = `<div class="p-4"><p class="text-sm text-red-700">${escapeHtml(payload.connection.lastError)}</p></div>`;
      return;
    }

    const container = ensureContainer(shell);
    const events = payload.events ?? [];
    if (payload.range?.id === 'this_week' && payload.range.start && payload.range.end) {
      renderWeek(container, events, payload.range.start, payload.range.end);
    } else {
      renderStack(container, events);
    }
    updateScrollHint(shell);
  }

  function initScheduleCard(root: HTMLElement): void {
    const userId = root.dataset.userId ?? '';
    const connected = root.dataset.connected === '1';
    const shell = root.querySelector('[data-schedule-events-shell]') as HTMLElement | null;
    const labelEl = root.querySelector('[data-schedule-range-label]') as HTMLElement | null;
    const rangeSelect = root.querySelector('[data-schedule-range]') as HTMLSelectElement | null;

    if (!connected || !shell || !rangeSelect) {
      updateScrollHint(shell ?? root);
      return;
    }

    const storedRange = readStoredRange(userId);
    if (storedRange && storedRange !== rangeSelect.value) {
      rangeSelect.value = storedRange;
      void loadEvents(storedRange, shell, labelEl, root);
    } else {
      updateScrollHint(shell);
    }

    rangeSelect.addEventListener('change', () => {
      const rangeId = rangeSelect.value;
      writeStoredRange(userId, rangeId);
      void loadEvents(rangeId, shell, labelEl, root);
    });

    shell.querySelector('[data-schedule-events]')?.addEventListener('scroll', () => updateScrollHint(shell));
  }

  document.querySelectorAll('[data-schedule-card]').forEach((node) => initScheduleCard(node as HTMLElement));
</script>
