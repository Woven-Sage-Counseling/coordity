---
interface Props {
  canOpenClinicalCalendar: boolean;
  ownerEmail: string;
  employeeName: string;
}

const { canOpenClinicalCalendar, ownerEmail, employeeName } = Astro.props;

const calendarHref = canOpenClinicalCalendar
  ? 'https://secure.simplepractice.com'
  : 'https://calendar.google.com';
const calendarLabel = canOpenClinicalCalendar ? 'Open clinical calendar' : 'Open practice calendar';

const timeOffSubject = encodeURIComponent('Time off request');
const timeOffBody = encodeURIComponent(
  `Hi,\n\nI'd like to request time off.\n\nName: ${employeeName}\nDates: \nReason: \n\nThank you.`,
);
const timeOffHref = ownerEmail
  ? `mailto:${ownerEmail}?subject=${timeOffSubject}&body=${timeOffBody}`
  : '#';
---

<aside
  class="flex h-full min-h-[28rem] flex-col overflow-hidden rounded-[1.05rem] shadow-[0_12px_32px_rgba(26,28,30,0.12)] ring-1 ring-black/10"
  aria-labelledby="home-schedule-heading"
>
  <div class="bg-sage-dark px-3 py-2.5 text-cream">
    <div class="flex items-center gap-2">
      <span
        class="flex h-7 w-7 items-center justify-center rounded-md bg-white/15 text-cream ring-1 ring-white/20"
        aria-hidden="true"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
          <rect x="3" y="5" width="18" height="16" rx="2" stroke="currentColor" stroke-width="1.75" />
          <path d="M3 10h18M8 3v4M16 3v4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" />
        </svg>
      </span>
      <h2 id="home-schedule-heading" class="text-sm font-semibold leading-none">Schedule</h2>
    </div>
  </div>

  <div class="flex flex-1 flex-col bg-[#f4f5f8] px-4 pb-4 pt-3 font-sans text-[#393a3d]">
    <div>
      <p class="text-[11px] font-semibold uppercase tracking-[0.14em] text-[#6b6c72]">Calendar</p>
      <p class="mt-1 text-base font-semibold leading-tight">
        {canOpenClinicalCalendar ? 'Clinical schedule' : 'Practice schedule'}
      </p>
      <p class="mt-1 text-[11px] text-[#6b6c72]">
        {canOpenClinicalCalendar
          ? 'Jump to your clinical calendar, or request time off.'
          : 'Open the practice calendar, or request time off.'}
      </p>
    </div>

    <div class="mt-4 flex flex-1 flex-col justify-end gap-2.5">
      <div class="space-y-2.5 rounded-lg bg-white p-3 shadow-sm ring-1 ring-black/[0.06]">
        <a
          href={calendarHref}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex w-full items-center justify-center rounded-lg bg-sage-dark px-3 py-2.5 text-sm font-semibold text-cream transition hover:bg-charcoal"
        >
          {calendarLabel}
        </a>
        <a
          href={timeOffHref}
          class:list={[
            'inline-flex w-full items-center justify-center rounded-lg px-3 py-2.5 text-sm font-medium transition',
            ownerEmail
              ? 'bg-[#e8ebe7] text-sage-dark hover:bg-[#dde2dc]'
              : 'pointer-events-none text-sage-dark/40',
          ]}
        >
          Request time off
        </a>
      </div>
    </div>
  </div>
</aside>
