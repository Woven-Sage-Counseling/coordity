---
import FinancialSnapshotCard from './FinancialSnapshotCard.astro';
import ScheduleCard from './ScheduleCard.astro';
import { availableWidgets } from '../lib/home-widgets';

interface Props {
  userId: string;
  canSeeFinancials: boolean;
  canOpenClinicalCalendar: boolean;
  ownerEmail: string;
  employeeName: string;
}

const {
  userId,
  canSeeFinancials,
  canOpenClinicalCalendar,
  ownerEmail,
  employeeName,
} = Astro.props;

const available = availableWidgets(canSeeFinancials);
const availableIds = available.map((w) => w.id);

const arrowClass =
  'inline-flex h-9 w-9 shrink-0 items-center justify-center self-center rounded-full bg-white text-sage-dark/70 shadow-sm ring-1 ring-black/10 transition hover:bg-[#f4f5f8] hover:text-charcoal disabled:pointer-events-none disabled:opacity-30';
---

{
  available.length === 0 ? null : (
    <section
      class="lg:sticky lg:top-6"
      aria-roledescription="carousel"
      aria-label="Home widgets"
      data-widget-carousel
      data-user-id={userId}
      data-available={JSON.stringify(availableIds)}
      data-can-financials={canSeeFinancials ? '1' : '0'}
    >
      <div class="flex items-stretch gap-1.5 sm:gap-2">
        <button type="button" class={arrowClass} aria-label="Previous widget" data-carousel-prev>
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path
              d="M10 3L5 8l5 5"
              stroke="currentColor"
              stroke-width="1.75"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </button>

        <div class="min-w-0 flex-1">
          <div class="relative min-h-[28rem]" data-carousel-stage>
            {availableIds.includes('quickbooks') && (
              <div class="h-full min-h-[28rem]" data-carousel-slide data-widget-id="quickbooks" hidden>
                <FinancialSnapshotCard />
              </div>
            )}
            {availableIds.includes('schedule') && (
              <div class="h-full min-h-[28rem]" data-carousel-slide data-widget-id="schedule" hidden>
                <ScheduleCard
                  canOpenClinicalCalendar={canOpenClinicalCalendar}
                  ownerEmail={ownerEmail}
                  employeeName={employeeName}
                />
              </div>
            )}
          </div>

          <div
            class="mt-3 flex items-center justify-center gap-1.5"
            data-carousel-dots
            role="tablist"
            aria-label="Widget pages"
          ></div>
        </div>

        <button type="button" class={arrowClass} aria-label="Next widget" data-carousel-next>
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path
              d="M6 3l5 5-5 5"
              stroke="currentColor"
              stroke-width="1.75"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </button>
      </div>

      <p class="mt-2 text-center text-[11px] text-sage-dark/50">
        <a href="/settings" class="hover:text-sage-dark">Customize widgets</a>
      </p>
    </section>
  )
}

<script>
  type Prefs = { enabled: string[]; defaultId: string };

  function defaultPrefs(canFinancials: boolean): Prefs {
    const enabled = canFinancials ? ['schedule', 'quickbooks'] : ['schedule'];
    return { enabled, defaultId: 'schedule' };
  }

  function readPrefs(userId: string, canFinancials: boolean, available: string[]): Prefs {
    const fallback = defaultPrefs(canFinancials);
    try {
      const raw = localStorage.getItem('portal:home-widgets:' + userId);
      if (!raw) return fallback;
      const parsed = JSON.parse(raw) as Prefs;
      const allowed = new Set(available);
      const enabled = (parsed.enabled || [])
        .filter((id) => allowed.has(id))
        .slice(0, 10);
      const finalEnabled = enabled.length ? enabled : fallback.enabled.filter((id) => allowed.has(id));
      const defaultId =
        finalEnabled.includes(parsed.defaultId) ? parsed.defaultId : finalEnabled[0]!;
      return { enabled: finalEnabled, defaultId };
    } catch {
      return fallback;
    }
  }

  function setupCarousel(root: Element) {
    if (!(root instanceof HTMLElement)) return;
    const userId = root.dataset.userId ?? '';
    const canFinancials = root.dataset.canFinancials === '1';
    let available: string[] = [];
    try {
      available = JSON.parse(root.dataset.available || '[]') as string[];
    } catch {
      available = [];
    }

    const prefs = readPrefs(userId, canFinancials, available);
    const slides = Array.from(root.querySelectorAll('[data-carousel-slide]')).filter(
      (el): el is HTMLElement => el instanceof HTMLElement,
    );
    const enabledSlides = prefs.enabled
      .map((id) => slides.find((el) => el.dataset.widgetId === id))
      .filter((el): el is HTMLElement => Boolean(el));

    slides.forEach((slide) => {
      slide.hidden = true;
    });

    if (enabledSlides.length === 0) {
      root.hidden = true;
      return;
    }

    const prevBtn = root.querySelector('[data-carousel-prev]');
    const nextBtn = root.querySelector('[data-carousel-next]');
    const dots = root.querySelector('[data-carousel-dots]');
    let index = Math.max(
      0,
      enabledSlides.findIndex((el) => el.dataset.widgetId === prefs.defaultId),
    );

    const renderDots = () => {
      if (!(dots instanceof HTMLElement)) return;
      dots.innerHTML = '';
      enabledSlides.forEach((slide, i) => {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.setAttribute('role', 'tab');
        btn.setAttribute('aria-label', `Show ${slide.dataset.widgetId} widget`);
        btn.setAttribute('aria-selected', i === index ? 'true' : 'false');
        btn.className =
          i === index
            ? 'h-2.5 w-2.5 rounded-full bg-charcoal'
            : 'h-2.5 w-2.5 rounded-full bg-sage-dark/25 hover:bg-sage-dark/45';
        btn.addEventListener('click', () => show(i));
        dots.appendChild(btn);
      });
    };

    const show = (next: number) => {
      index = ((next % enabledSlides.length) + enabledSlides.length) % enabledSlides.length;
      enabledSlides.forEach((slide, i) => {
        slide.hidden = i !== index;
      });
      renderDots();
      const multi = enabledSlides.length > 1;
      if (prevBtn instanceof HTMLButtonElement) {
        prevBtn.disabled = !multi;
        prevBtn.classList.toggle('invisible', !multi);
      }
      if (nextBtn instanceof HTMLButtonElement) {
        nextBtn.disabled = !multi;
        nextBtn.classList.toggle('invisible', !multi);
      }
      if (dots instanceof HTMLElement) {
        dots.classList.toggle('invisible', !multi);
      }
    };

    prevBtn?.addEventListener('click', () => show(index - 1));
    nextBtn?.addEventListener('click', () => show(index + 1));
    show(index);
  }

  document.querySelectorAll('[data-widget-carousel]').forEach((root) => setupCarousel(root));
</script>
