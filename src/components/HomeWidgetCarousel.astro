---
import FinancialSnapshotCard from './FinancialSnapshotCard.astro';
import ScheduleCard from './ScheduleCard.astro';
import PlaceholderWidget from './PlaceholderWidget.astro';
import { availableWidgets } from '../lib/home-widgets';

interface Props {
  userId: string;
  canSeeFinancials: boolean;
  canOpenClinicalCalendar: boolean;
  ownerEmail: string;
  employeeName: string;
}

const {
  userId,
  canSeeFinancials,
  canOpenClinicalCalendar,
  ownerEmail,
  employeeName,
} = Astro.props;

const available = availableWidgets(canSeeFinancials);
const availableIds = available.map((w) => w.id);

const arrowClass =
  'absolute top-1/2 z-20 inline-flex h-9 w-9 -translate-y-1/2 items-center justify-center rounded-full bg-white/95 text-sage-dark/80 shadow-md ring-1 ring-black/10 transition hover:bg-white hover:text-charcoal disabled:pointer-events-none disabled:opacity-30';
---

{
  available.length === 0 ? null : (
    <section
      class="lg:sticky lg:top-6"
      aria-roledescription="carousel"
      aria-label="Home widgets"
      data-widget-carousel
      data-user-id={userId}
      data-available={JSON.stringify(availableIds)}
      data-can-financials={canSeeFinancials ? '1' : '0'}
    >
      <div class="relative" data-carousel-shell>
        <button
          type="button"
          class:list={[arrowClass, 'left-0 -translate-x-1/3']}
          aria-label="Previous widget"
          data-carousel-prev
        >
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path
              d="M10 3L5 8l5 5"
              stroke="currentColor"
              stroke-width="1.75"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </button>

        <div
          class="widget-carousel-viewport overflow-hidden px-0 pt-2"
          data-carousel-viewport
        >
          <div class="widget-carousel-track flex items-stretch" data-carousel-track>
            {availableIds.includes('quickbooks') && (
              <div class="widget-carousel-slide" data-carousel-slide data-widget-id="quickbooks">
                <FinancialSnapshotCard />
              </div>
            )}
            {availableIds.includes('schedule') && (
              <div class="widget-carousel-slide" data-carousel-slide data-widget-id="schedule">
                <ScheduleCard
                  canOpenClinicalCalendar={canOpenClinicalCalendar}
                  ownerEmail={ownerEmail}
                  employeeName={employeeName}
                />
              </div>
            )}
            {availableIds.includes('coming_soon') && (
              <div class="widget-carousel-slide" data-carousel-slide data-widget-id="coming_soon">
                <PlaceholderWidget />
              </div>
            )}
          </div>
        </div>

        <button
          type="button"
          class:list={[arrowClass, 'right-0 translate-x-1/3']}
          aria-label="Next widget"
          data-carousel-next
        >
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path
              d="M6 3l5 5-5 5"
              stroke="currentColor"
              stroke-width="1.75"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </button>
      </div>

      <div
        class="mt-3 flex items-center justify-center gap-1.5"
        data-carousel-dots
        role="tablist"
        aria-label="Widget pages"
      ></div>

      <div class="mt-2 flex justify-center">
        <a
          href="/settings"
          class="rounded-full border border-sage-dark/20 bg-transparent px-2.5 py-1 text-[11px] font-semibold text-sage-dark/75 transition hover:border-sage-dark/35 hover:bg-sage/10 hover:text-sage-dark"
        >
          Widget settings
        </a>
      </div>
    </section>
  )
}

<style is:global>
  .widget-carousel-viewport {
    width: 100%;
    /* Leave room below so card drop-shadows are not hard-clipped */
    padding-bottom: 2.75rem;
    /* Fade only the extreme edges so peeks stay readable */
    -webkit-mask-image: linear-gradient(
      90deg,
      transparent 0%,
      #000 4%,
      #000 96%,
      transparent 100%
    );
    mask-image: linear-gradient(
      90deg,
      transparent 0%,
      #000 4%,
      #000 96%,
      transparent 100%
    );
  }

  [data-widget-carousel][data-solo='true'] .widget-carousel-viewport {
    -webkit-mask-image: none;
    mask-image: none;
  }

  .widget-carousel-track {
    gap: 0.65rem;
    transition: transform 520ms cubic-bezier(0.22, 1, 0.36, 1);
    will-change: transform;
  }

  .widget-carousel-slide {
    box-sizing: border-box;
    flex: 0 0 auto;
    min-height: 28rem;
    width: 70%;
    transform: scale(0.92);
    opacity: 0.72;
    transition:
      transform 520ms cubic-bezier(0.22, 1, 0.36, 1),
      opacity 520ms cubic-bezier(0.22, 1, 0.36, 1);
    /* Grow/shrink from the top so the active card does not paint past the clip edge */
    transform-origin: top center;
  }

  .widget-carousel-slide[data-active='true'] {
    transform: scale(1);
    opacity: 1;
  }

  .widget-carousel-slide[data-solo='true'] {
    width: 100%;
    transform: scale(1);
    opacity: 1;
  }

  .widget-carousel-slide:not([data-active='true']):not([data-solo='true']) {
    cursor: pointer;
  }

  .widget-carousel-slide:not([data-active='true']):not([data-solo='true']) a,
  .widget-carousel-slide:not([data-active='true']):not([data-solo='true']) button,
  .widget-carousel-slide:not([data-active='true']):not([data-solo='true']) input,
  .widget-carousel-slide:not([data-active='true']):not([data-solo='true']) select {
    pointer-events: none;
  }
</style>

<script>
  type Prefs = { enabled: string[]; defaultId: string };

  function defaultPrefs(canFinancials: boolean): Prefs {
    const enabled = canFinancials
      ? ['schedule', 'quickbooks', 'coming_soon']
      : ['schedule', 'coming_soon'];
    return { enabled, defaultId: 'schedule' };
  }

  function readPrefs(userId: string, canFinancials: boolean, available: string[]): Prefs {
    const fallback = defaultPrefs(canFinancials);
    try {
      const raw = localStorage.getItem('portal:home-widgets:' + userId);
      if (!raw) return fallback;
      const parsed = JSON.parse(raw) as Prefs;
      const allowed = new Set(available);
      const enabled = (parsed.enabled || [])
        .filter((id) => allowed.has(id))
        .slice(0, 10);
      const finalEnabled = enabled.length ? enabled : fallback.enabled.filter((id) => allowed.has(id));
      const defaultId =
        finalEnabled.includes(parsed.defaultId) ? parsed.defaultId : finalEnabled[0]!;
      return { enabled: finalEnabled, defaultId };
    } catch {
      return fallback;
    }
  }

  function setupCarousel(root: Element) {
    if (!(root instanceof HTMLElement)) return;
    const userId = root.dataset.userId ?? '';
    const canFinancials = root.dataset.canFinancials === '1';
    let available: string[] = [];
    try {
      available = JSON.parse(root.dataset.available || '[]') as string[];
    } catch {
      available = [];
    }

    const prefs = readPrefs(userId, canFinancials, available);
    const viewport = root.querySelector('[data-carousel-viewport]');
    const track = root.querySelector('[data-carousel-track]');
    if (!(viewport instanceof HTMLElement) || !(track instanceof HTMLElement)) return;

    const allSlides = Array.from(root.querySelectorAll('[data-carousel-slide]')).filter(
      (el): el is HTMLElement => el instanceof HTMLElement,
    );

    const enabledSlides = prefs.enabled
      .map((id) => allSlides.find((el) => el.dataset.widgetId === id))
      .filter((el): el is HTMLElement => Boolean(el));

    allSlides.forEach((slide) => {
      if (!enabledSlides.includes(slide)) slide.remove();
    });
    enabledSlides.forEach((slide) => track.appendChild(slide));

    if (enabledSlides.length === 0) {
      root.hidden = true;
      return;
    }

    const prevBtn = root.querySelector('[data-carousel-prev]');
    const nextBtn = root.querySelector('[data-carousel-next]');
    const dots = root.querySelector('[data-carousel-dots]');
    const solo = enabledSlides.length === 1;
    root.dataset.solo = solo ? 'true' : 'false';
    let index = Math.max(
      0,
      enabledSlides.findIndex((el) => el.dataset.widgetId === prefs.defaultId),
    );

    enabledSlides.forEach((slide) => {
      slide.dataset.solo = solo ? 'true' : 'false';
      slide.addEventListener(
        'click',
        (event) => {
          if (solo) return;
          const slideIndex = enabledSlides.indexOf(slide);
          if (slideIndex === index) return;
          event.preventDefault();
          event.stopPropagation();
          show(slideIndex);
        },
        true,
      );
    });

    const renderDots = () => {
      if (!(dots instanceof HTMLElement)) return;
      dots.innerHTML = '';
      enabledSlides.forEach((slide, i) => {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.setAttribute('role', 'tab');
        btn.setAttribute('aria-label', `Show ${slide.dataset.widgetId} widget`);
        btn.setAttribute('aria-selected', i === index ? 'true' : 'false');
        btn.className =
          i === index
            ? 'h-2.5 w-2.5 rounded-full bg-charcoal'
            : 'h-2.5 w-2.5 rounded-full bg-sage-dark/25 hover:bg-sage-dark/45';
        btn.addEventListener('click', () => show(i));
        dots.appendChild(btn);
      });
    };

    const layout = () => {
      if (solo) {
        track.style.transform = 'translate3d(0,0,0)';
        enabledSlides[0]!.dataset.active = 'true';
        return;
      }

      const viewportWidth = viewport.clientWidth;
      const slideWidth = enabledSlides[index]?.offsetWidth || viewportWidth * 0.7;
      const styles = getComputedStyle(track);
      const gap = Number.parseFloat(styles.columnGap || styles.gap || '0') || 0;
      const peek = Math.max(0, (viewportWidth - slideWidth) / 2);
      const offset = peek - index * (slideWidth + gap);
      track.style.transform = `translate3d(${offset}px, 0, 0)`;

      enabledSlides.forEach((el, i) => {
        el.dataset.active = i === index ? 'true' : 'false';
        el.setAttribute('aria-hidden', i === index ? 'false' : 'true');
      });
    };

    const show = (next: number) => {
      index = Math.min(enabledSlides.length - 1, Math.max(0, next));
      layout();
      renderDots();
      const multi = !solo;
      if (prevBtn instanceof HTMLButtonElement) {
        prevBtn.disabled = !multi || index === 0;
        prevBtn.classList.toggle('invisible', !multi);
      }
      if (nextBtn instanceof HTMLButtonElement) {
        nextBtn.disabled = !multi || index === enabledSlides.length - 1;
        nextBtn.classList.toggle('invisible', !multi);
      }
      if (dots instanceof HTMLElement) {
        dots.classList.toggle('invisible', !multi);
      }
    };

    prevBtn?.addEventListener('click', () => show(index - 1));
    nextBtn?.addEventListener('click', () => show(index + 1));

    track.style.transition = 'none';
    show(index);
    requestAnimationFrame(() => {
      requestAnimationFrame(() => {
        track.style.transition = '';
      });
    });

    window.addEventListener('resize', () => layout());
  }

  document.querySelectorAll('[data-widget-carousel]').forEach((root) => setupCarousel(root));
</script>
