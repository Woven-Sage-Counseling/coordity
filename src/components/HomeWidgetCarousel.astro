---
import FinancialSnapshotCard from './FinancialSnapshotCard.astro';
import ScheduleCard from './ScheduleCard.astro';
import TimeOffCard from './TimeOffCard.astro';
import MyProgressCard from './MyProgressCard.astro';
import CredentialingCard from './CredentialingCard.astro';
import TasksCard from './TasksCard.astro';
import TimesheetCard from './TimesheetCard.astro';
import CaseloadCard from './CaseloadCard.astro';
import { availableWidgets, type HomeWidgetId } from '../lib/home-widgets';

interface Props {
  userId: string;
  employee: PortalEmployee;
  canSeeFinancials: boolean;
  canSeeCredentialing: boolean;
  canSeeClinical: boolean;
  canSeeTimesheet: boolean;
}

const {
  userId,
  employee,
  canSeeFinancials,
  canSeeCredentialing,
  canSeeClinical,
  canSeeTimesheet,
} = Astro.props;

const available = availableWidgets({
  canSeeFinancials,
  canSeeCredentialing,
  canSeeClinical,
  canSeeTimesheet,
});
const availableIds = available.map((w) => w.id);

const preferredOrder: HomeWidgetId[] = [
  'schedule',
  'caseload',
  'time_off',
  'timesheet',
  'my_progress',
  'tasks',
  'credentialing',
  'quickbooks',
];
/** Always SSR every allowed widget — no client filtering. */
const defaultOrder = preferredOrder.filter((id) => availableIds.includes(id));
const widgetCount = defaultOrder.length;
---

{
  available.length === 0 ? null : (
    <section
      class="min-w-0"
      aria-label="Home widgets"
      data-home-widgets
      data-widgets-build="2026-09-07c"
      data-user-id={userId}
      data-can-financials={canSeeFinancials ? '1' : '0'}
      data-can-credentialing={canSeeCredentialing ? '1' : '0'}
      data-can-clinical={canSeeClinical ? '1' : '0'}
      data-can-timesheet={canSeeTimesheet ? '1' : '0'}
    >
      <p
        class="mb-2 text-[11px] font-semibold uppercase tracking-[0.14em] text-sage-dark/55"
        data-widgets-count
      >
        Home widgets · {widgetCount}
      </p>
      <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 xl:grid-cols-4">
        {defaultOrder.map((id) => (
          <div class="home-widget-slot min-w-0" data-widget-id={id}>
            {id === 'schedule' ? <ScheduleCard userId={userId} /> : null}
            {id === 'caseload' ? <CaseloadCard userId={userId} /> : null}
            {id === 'time_off' ? <TimeOffCard userId={userId} /> : null}
            {id === 'timesheet' ? <TimesheetCard userId={userId} /> : null}
            {id === 'my_progress' ? <MyProgressCard userId={userId} /> : null}
            {id === 'tasks' ? <TasksCard userId={userId} /> : null}
            {id === 'credentialing' ? <CredentialingCard employee={employee} /> : null}
            {id === 'quickbooks' ? <FinancialSnapshotCard /> : null}
          </div>
        ))}
      </div>

      <div class="mt-3 flex justify-center">
        <a
          href="/settings"
          class="rounded-full border border-sage-dark/20 bg-transparent px-2.5 py-1 text-[11px] font-semibold text-sage-dark/75 transition hover:border-sage-dark/35 hover:bg-sage/10 hover:text-sage-dark"
        >
          Customize widgets
        </a>
      </div>
    </section>
  )
}

<style is:global>
  /* Inline with the component so card bodies cannot miss the stylesheet. */
  .home-widget-slot,
  .widget-carousel-slide {
    min-width: 0;
    height: 28rem;
  }

  .home-widget-slot > [data-widget-card],
  .widget-carousel-slide > [data-widget-card] {
    display: flex !important;
    flex-direction: column !important;
    height: 28rem !important;
    max-height: 28rem !important;
    min-height: 28rem !important;
    overflow: hidden;
    background-color: #fff;
  }

  .home-widget-slot > [data-widget-card] > [data-widget-header],
  .widget-carousel-slide > [data-widget-card] > [data-widget-header] {
    flex: 0 0 auto !important;
  }

  .home-widget-slot > [data-widget-card] > [data-widget-body],
  .widget-carousel-slide > [data-widget-card] > [data-widget-body] {
    flex: 1 1 auto !important;
    min-height: 12rem !important;
    overflow: auto !important;
    -webkit-overflow-scrolling: touch;
    color: #393a3d !important;
    background-color: #f4f5f8 !important;
    opacity: 1 !important;
    visibility: visible !important;
  }
</style>

<script>
  import { applyWidgetHeaderPrefs } from '../lib/home-widget-header';
  import type { WidgetIconId } from '../lib/home-widget-icons';

  type Prefs = {
    v?: number;
    enabled: string[];
    headerColors?: Record<string, string>;
    headerIcons?: Record<string, WidgetIconId>;
  };

  function sanitizeHeaderColors(raw: unknown): Record<string, string> {
    if (!raw || typeof raw !== 'object') return {};
    const colors: Record<string, string> = {};
    for (const [key, value] of Object.entries(raw)) {
      if (typeof value === 'string' && /^#[0-9a-fA-F]{6}$/.test(value)) {
        colors[key] = value;
      }
    }
    return colors;
  }

  function sanitizeHeaderIcons(raw: unknown): Record<string, WidgetIconId> {
    if (!raw || typeof raw !== 'object') return {};
    const icons: Record<string, WidgetIconId> = {};
    const allowed = new Set([
      'calendar',
      'calendar_plus',
      'clock',
      'chart',
      'checklist',
      'users',
      'badge',
      'star',
      'bell',
      'bookmark',
      'briefcase',
      'folder',
      'heart',
      'home',
      'clipboard',
    ]);
    for (const [key, value] of Object.entries(raw)) {
      if (typeof value === 'string' && allowed.has(value)) {
        icons[key] = value as WidgetIconId;
      }
    }
    return icons;
  }

  /** Header colors/icons only — never hide or remove widget cards. */
  function setupWidgets(root: Element) {
    if (!(root instanceof HTMLElement)) return;
    if (root.dataset.widgetsReady === '1') return;
    root.dataset.widgetsReady = '1';

    const userId = root.dataset.userId ?? '';
    try {
      // Drop broken legacy prefs that collapsed the home grid to one empty card.
      localStorage.removeItem('portal:home-widgets:' + userId);
    } catch {
      /* ignore */
    }

    let headerColors: Record<string, string> = {};
    let headerIcons: Record<string, WidgetIconId> = {};
    try {
      const raw = localStorage.getItem('portal:home-widgets-headers:' + userId);
      if (raw) {
        const parsed = JSON.parse(raw) as Prefs;
        headerColors = sanitizeHeaderColors(parsed.headerColors);
        headerIcons = sanitizeHeaderIcons(parsed.headerIcons);
      }
    } catch {
      /* ignore */
    }

    applyWidgetHeaderPrefs(root, { headerColors, headerIcons });
  }

  function init() {
    document.querySelectorAll('[data-home-widgets]').forEach((root) => {
      try {
        setupWidgets(root);
      } catch (error) {
        console.error('home widgets failed', error);
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
</script>
