---
import FinancialSnapshotCard from './FinancialSnapshotCard.astro';
import ScheduleCard from './ScheduleCard.astro';
import TimeOffCard from './TimeOffCard.astro';
import MyProgressCard from './MyProgressCard.astro';
import CredentialingCard from './CredentialingCard.astro';
import TasksCard from './TasksCard.astro';
import TimesheetCard from './TimesheetCard.astro';
import CaseloadCard from './CaseloadCard.astro';
import { availableWidgets } from '../lib/home-widgets';

interface Props {
  userId: string;
  employee: PortalEmployee;
  canSeeFinancials: boolean;
  canSeeCredentialing: boolean;
  canSeeClinical: boolean;
  canSeeTimesheet: boolean;
}

const { userId, employee, canSeeFinancials, canSeeCredentialing, canSeeClinical, canSeeTimesheet } =
  Astro.props;

const available = availableWidgets({
  canSeeFinancials,
  canSeeCredentialing,
  canSeeClinical,
  canSeeTimesheet,
});
const availableIds = available.map((w) => w.id);

const arrowClass =
  'inline-flex h-9 w-9 items-center justify-center rounded-full bg-white/95 text-sage-dark/80 shadow-md ring-1 ring-black/10 transition hover:bg-white hover:text-charcoal disabled:pointer-events-none disabled:opacity-30';
---

{
  available.length === 0 ? null : (
    <section
      class="min-w-0"
      aria-label="Home widgets"
      data-widget-carousel
      data-user-id={userId}
      data-available={JSON.stringify(availableIds)}
      data-can-financials={canSeeFinancials ? '1' : '0'}
      data-can-credentialing={canSeeCredentialing ? '1' : '0'}
      data-can-clinical={canSeeClinical ? '1' : '0'}
      data-can-timesheet={canSeeTimesheet ? '1' : '0'}
    >
      <div class="flex items-center gap-2">
        <button
          type="button"
          class:list={[arrowClass, 'invisible shrink-0']}
          aria-label="Previous widgets"
          data-carousel-prev
          disabled
        >
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path
              d="M10 3L5 8l5 5"
              stroke="currentColor"
              stroke-width="1.75"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </button>

        <div class="widget-carousel-viewport min-w-0 flex-1 pt-1" data-carousel-viewport>
          <div class="widget-carousel-track" data-carousel-track>
            {availableIds.includes('schedule') && (
              <div class="widget-carousel-slide" data-carousel-slide data-widget-id="schedule">
                <ScheduleCard userId={userId} />
              </div>
            )}
            {availableIds.includes('caseload') && (
              <div class="widget-carousel-slide" data-carousel-slide data-widget-id="caseload">
                <CaseloadCard userId={userId} />
              </div>
            )}
            {availableIds.includes('time_off') && (
              <div class="widget-carousel-slide" data-carousel-slide data-widget-id="time_off">
                <TimeOffCard userId={userId} />
              </div>
            )}
            {availableIds.includes('timesheet') && (
              <div class="widget-carousel-slide" data-carousel-slide data-widget-id="timesheet">
                <TimesheetCard userId={userId} />
              </div>
            )}
            {availableIds.includes('my_progress') && (
              <div class="widget-carousel-slide" data-carousel-slide data-widget-id="my_progress">
                <MyProgressCard userId={userId} />
              </div>
            )}
            {availableIds.includes('tasks') && (
              <div class="widget-carousel-slide" data-carousel-slide data-widget-id="tasks">
                <TasksCard userId={userId} />
              </div>
            )}
            {availableIds.includes('credentialing') && (
              <div class="widget-carousel-slide" data-carousel-slide data-widget-id="credentialing">
                <CredentialingCard employee={employee} />
              </div>
            )}
            {availableIds.includes('quickbooks') && (
              <div class="widget-carousel-slide" data-carousel-slide data-widget-id="quickbooks">
                <FinancialSnapshotCard />
              </div>
            )}
          </div>
        </div>

        <button
          type="button"
          class:list={[arrowClass, 'invisible shrink-0']}
          aria-label="Next widgets"
          data-carousel-next
          disabled
        >
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path
              d="M6 3l5 5-5 5"
              stroke="currentColor"
              stroke-width="1.75"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </button>
      </div>

      <div
        class="mt-3 flex items-center justify-center gap-1.5"
        data-carousel-dots
        role="tablist"
        aria-label="Widget pages"
      ></div>

      <div class="mt-2 flex justify-center">
        <a
          href="/settings"
          class="rounded-full border border-sage-dark/20 bg-transparent px-2.5 py-1 text-[11px] font-semibold text-sage-dark/75 transition hover:border-sage-dark/35 hover:bg-sage/10 hover:text-sage-dark"
        >
          Customize widgets
        </a>
      </div>
    </section>
  )
}

<script>
  import { applyWidgetHeaderPrefs } from '../lib/home-widget-header';
  import type { WidgetIconId } from '../lib/home-widget-icons';

  type Prefs = {
    enabled: string[];
    headerColors?: Record<string, string>;
    headerIcons?: Record<string, WidgetIconId>;
  };

  function defaultPrefs(
    canFinancials: boolean,
    canCredentialing: boolean,
    canClinical: boolean,
    canTimesheet: boolean,
  ): Prefs {
    const enabled = ['schedule', 'time_off', 'my_progress', 'tasks'];
    if (canClinical) enabled.splice(1, 0, 'caseload');
    if (canTimesheet) {
      const timeOffIdx = enabled.indexOf('time_off');
      enabled.splice(timeOffIdx >= 0 ? timeOffIdx + 1 : enabled.length, 0, 'timesheet');
    }
    if (canCredentialing) enabled.push('credentialing');
    if (canFinancials) enabled.push('quickbooks');
    return { enabled };
  }

  function migrateWidgetId(id: string): string {
    return id === 'coming_soon' ? 'my_progress' : id;
  }

  function sanitizeHeaderColors(raw: unknown): Record<string, string> {
    if (!raw || typeof raw !== 'object') return {};
    const colors: Record<string, string> = {};
    for (const [key, value] of Object.entries(raw)) {
      if (typeof value === 'string' && /^#[0-9a-fA-F]{6}$/.test(value)) {
        colors[key] = value;
      }
    }
    return colors;
  }

  function sanitizeHeaderIcons(raw: unknown): Record<string, WidgetIconId> {
    if (!raw || typeof raw !== 'object') return {};
    const icons: Record<string, WidgetIconId> = {};
    const allowed = new Set([
      'calendar',
      'calendar_plus',
      'clock',
      'chart',
      'checklist',
      'users',
      'badge',
      'star',
      'bell',
      'bookmark',
      'briefcase',
      'folder',
      'heart',
      'home',
      'clipboard',
    ]);
    for (const [key, value] of Object.entries(raw)) {
      if (typeof value === 'string' && allowed.has(value)) {
        icons[key] = value as WidgetIconId;
      }
    }
    return icons;
  }

  function readPrefs(
    userId: string,
    canFinancials: boolean,
    canCredentialing: boolean,
    canClinical: boolean,
    canTimesheet: boolean,
    available: string[],
  ): Prefs {
    const fallback = defaultPrefs(canFinancials, canCredentialing, canClinical, canTimesheet);
    try {
      const raw = localStorage.getItem('portal:home-widgets:' + userId);
      if (!raw) return fallback;
      const parsed = JSON.parse(raw) as Prefs;
      const allowed = new Set(available);
      const enabled = (parsed.enabled || [])
        .map(migrateWidgetId)
        .filter((id) => allowed.has(id))
        .slice(0, 10);
      let mutated = false;
      if (allowed.has('time_off') && !enabled.includes('time_off') && enabled.length < 10) {
        const scheduleIdx = enabled.indexOf('schedule');
        enabled.splice(scheduleIdx >= 0 ? scheduleIdx + 1 : enabled.length, 0, 'time_off');
        mutated = true;
      }
      if (allowed.has('caseload') && !enabled.includes('caseload') && enabled.length < 10) {
        const scheduleIdx = enabled.indexOf('schedule');
        enabled.splice(scheduleIdx >= 0 ? scheduleIdx + 1 : enabled.length, 0, 'caseload');
        mutated = true;
      }
      if (allowed.has('my_progress') && !enabled.includes('my_progress') && enabled.length < 10) {
        const timeOffIdx = enabled.indexOf('time_off');
        enabled.splice(timeOffIdx >= 0 ? timeOffIdx + 1 : enabled.length, 0, 'my_progress');
        mutated = true;
      }
      if (allowed.has('timesheet') && !enabled.includes('timesheet') && enabled.length < 10) {
        const timeOffIdx = enabled.indexOf('time_off');
        enabled.splice(timeOffIdx >= 0 ? timeOffIdx + 1 : enabled.length, 0, 'timesheet');
        mutated = true;
      }
      if (allowed.has('tasks') && !enabled.includes('tasks') && enabled.length < 10) {
        const progressIdx = enabled.indexOf('my_progress');
        enabled.splice(progressIdx >= 0 ? progressIdx + 1 : enabled.length, 0, 'tasks');
        mutated = true;
      }
      if (allowed.has('credentialing') && !enabled.includes('credentialing') && enabled.length < 10) {
        const tasksIdx = enabled.indexOf('tasks');
        enabled.splice(tasksIdx >= 0 ? tasksIdx + 1 : enabled.length, 0, 'credentialing');
        mutated = true;
      }
      const finalEnabled = enabled.length ? enabled : fallback.enabled.filter((id) => allowed.has(id));
      const headerColors = sanitizeHeaderColors(parsed.headerColors);
      const headerIcons = sanitizeHeaderIcons(parsed.headerIcons);
      const next: Prefs = {
        enabled: finalEnabled,
        ...(Object.keys(headerColors).length ? { headerColors } : {}),
        ...(Object.keys(headerIcons).length ? { headerIcons } : {}),
      };
      if (mutated || (parsed.enabled || []).includes('coming_soon')) {
        try {
          localStorage.setItem('portal:home-widgets:' + userId, JSON.stringify(next));
        } catch {
          /* ignore */
        }
      }
      return next;
    } catch {
      return fallback;
    }
  }

  function setupCarousel(root: Element) {
    if (!(root instanceof HTMLElement)) return;
    if (root.dataset.carouselReady === '1') return;
    root.dataset.carouselReady = '1';

    const userId = root.dataset.userId ?? '';
    const canFinancials = root.dataset.canFinancials === '1';
    const canCredentialing = root.dataset.canCredentialing === '1';
    const canClinical = root.dataset.canClinical === '1';
    const canTimesheet = root.dataset.canTimesheet === '1';
    let available: string[] = [];
    try {
      available = JSON.parse(root.dataset.available || '[]') as string[];
    } catch {
      available = [];
    }

    const prefs = readPrefs(userId, canFinancials, canCredentialing, canClinical, canTimesheet, available);
    applyWidgetHeaderPrefs(root, prefs);
    window.addEventListener('portal:widget-prefs-changed', () => {
      const fresh = readPrefs(userId, canFinancials, canCredentialing, canClinical, canTimesheet, available);
      applyWidgetHeaderPrefs(root, fresh);
    });

    const track = root.querySelector('[data-carousel-track]');
    if (!(track instanceof HTMLElement)) return;

    const allSlides = Array.from(root.querySelectorAll('[data-carousel-slide]')).filter(
      (el): el is HTMLElement => el instanceof HTMLElement,
    );

    const enabledSlides = prefs.enabled
      .map((id) => allSlides.find((el) => el.dataset.widgetId === id))
      .filter((el): el is HTMLElement => Boolean(el));

    allSlides.forEach((slide) => {
      if (!enabledSlides.includes(slide)) slide.remove();
    });
    enabledSlides.forEach((slide) => track.appendChild(slide));

    if (enabledSlides.length === 0) {
      root.hidden = true;
      return;
    }

    const prevBtn = root.querySelector('[data-carousel-prev]');
    const nextBtn = root.querySelector('[data-carousel-next]');
    const dots = root.querySelector('[data-carousel-dots]');
    let page = 0;

    const perPage = () => {
      const width = root.clientWidth || window.innerWidth;
      if (width < 640) return 1;
      if (width < 1024) return 2;
      return 4;
    };

    const pageCount = () => Math.max(1, Math.ceil(enabledSlides.length / perPage()));

    const renderDots = () => {
      if (!(dots instanceof HTMLElement)) return;
      dots.innerHTML = '';
      const pages = pageCount();
      if (pages <= 1) {
        dots.classList.add('invisible');
        return;
      }
      dots.classList.remove('invisible');
      for (let i = 0; i < pages; i += 1) {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.setAttribute('role', 'tab');
        btn.setAttribute('aria-label', `Show widget page ${i + 1}`);
        btn.setAttribute('aria-selected', i === page ? 'true' : 'false');
        btn.className =
          i === page
            ? 'h-2.5 w-2.5 rounded-full bg-charcoal'
            : 'h-2.5 w-2.5 rounded-full bg-sage-dark/25 hover:bg-sage-dark/45';
        btn.addEventListener('click', () => show(i));
        dots.appendChild(btn);
      }
    };

    const layout = () => {
      const count = perPage();
      const start = page * count;
      const end = start + count;
      root.style.setProperty('--widget-per-page', String(count));
      enabledSlides.forEach((slide, i) => {
        const onPage = i >= start && i < end;
        slide.hidden = !onPage;
        slide.dataset.active = onPage ? 'true' : 'false';
        slide.setAttribute('aria-hidden', onPage ? 'false' : 'true');
        slide.style.width = '';
        slide.style.transform = '';
        slide.style.opacity = '';
      });
    };

    const show = (next: number) => {
      page = Math.min(pageCount() - 1, Math.max(0, next));
      layout();
      renderDots();
      const multi = pageCount() > 1;
      if (prevBtn instanceof HTMLButtonElement) {
        prevBtn.disabled = !multi || page === 0;
        prevBtn.classList.toggle('invisible', !multi);
      }
      if (nextBtn instanceof HTMLButtonElement) {
        nextBtn.disabled = !multi || page >= pageCount() - 1;
        nextBtn.classList.toggle('invisible', !multi);
      }
    };

    prevBtn?.addEventListener('click', () => show(page - 1));
    nextBtn?.addEventListener('click', () => show(page + 1));
    show(0);
    window.addEventListener('resize', () => show(page));
  }

  function initCarousels() {
    document.querySelectorAll('[data-widget-carousel]').forEach((root) => {
      try {
        setupCarousel(root);
      } catch (error) {
        console.error('home widget carousel failed', error);
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCarousels);
  } else {
    initCarousels();
  }
</script>
