---
import {
  buildWorkCategoryLookup,
  type WorkCategoryMeta,
} from '../lib/timesheet-work-categories';
import { serializeWorkItem, type TimesheetShiftWorkItem } from '../lib/timesheet-work-items';

interface Props {
  shiftId: string;
  workItems: TimesheetShiftWorkItem[];
  canEdit: boolean;
  categories: WorkCategoryMeta[];
}

const { shiftId, workItems, canEdit, categories } = Astro.props;
const categoryLookup = buildWorkCategoryLookup(categories);
const serialized = workItems.map((item) => serializeWorkItem(item, categoryLookup));
const selectedCategories = new Set(serialized.map((item) => item.category));
---

<div
  class="mt-3 border-t border-sage-dark/10 pt-3"
  data-shift-work-items
  data-shift-id={shiftId}
  data-work-items={JSON.stringify(serialized)}
>
  <div class="flex flex-wrap items-center justify-between gap-2">
    <p class="text-xs font-semibold uppercase tracking-[0.12em] text-sage-dark/55">Work items</p>
    {
      canEdit ? (
        <button
          type="button"
          class="text-xs font-medium text-sage-dark hover:text-charcoal"
          data-work-items-toggle
        >
          {serialized.length > 0 ? 'Edit items' : 'Add items'}
        </button>
      ) : null
    }
  </div>

  <div class="mt-2 flex flex-wrap gap-1.5" data-work-items-list>
    {
      serialized.length > 0 ? (
        serialized.map((item) => (
          <span
            class="inline-flex items-center gap-1 rounded-full px-2 py-0.5 text-[11px] font-medium text-charcoal ring-1 ring-black/[0.08]"
            style={`background-color: ${item.color}18`}
          >
            <span class="size-1.5 rounded-full" style={`background-color: ${item.color}`} />
            {item.label}
          </span>
        ))
      ) : (
        <p class="text-xs text-sage-dark/60" data-work-items-empty>
          {canEdit ? 'No work items logged for this shift.' : '—'}
        </p>
      )
    }
  </div>

  {
    canEdit ? (
      <form
        class="mt-3 hidden rounded-xl border border-sage-dark/10 bg-[#f8f9fb] p-3"
        data-work-items-form
        action="/api/timesheet/work-items"
        method="post"
      >
        <input type="hidden" name="shiftId" value={shiftId} />
        <p class="text-xs text-sage-dark/70">
          Check what you worked on during this shift. This is used for activity frequency, not hour allocation.
        </p>
        <div class="mt-3 grid gap-2 sm:grid-cols-2">
          {
            categories.map((option) => (
              <label class="flex cursor-pointer items-center gap-2 rounded-lg border border-sage-dark/10 bg-white px-3 py-2 text-sm text-charcoal">
                <input
                  type="checkbox"
                  name="category"
                  value={option.key}
                  checked={selectedCategories.has(option.key)}
                  class="size-4 rounded border-sage-dark/25 text-sage-dark focus:ring-sage-dark/30"
                />
                <span class="size-2 shrink-0 rounded-full" style={`background-color: ${option.color}`} />
                <span>{option.label}</span>
              </label>
            ))
          }
        </div>
        <div class="mt-3 flex flex-wrap items-center gap-2">
          <button type="submit" class="btn-primary !px-3 !py-1.5 text-xs">Save items</button>
          <button type="button" class="text-xs text-sage-dark/70 hover:text-charcoal" data-work-items-cancel>
            Cancel
          </button>
        </div>
        <p class="mt-2 hidden text-xs text-red-700" data-work-items-error />
      </form>
    ) : null
  }
</div>
