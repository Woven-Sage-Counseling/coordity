---
import {
  QUICK_LINK_CATALOG,
  QUICK_LINK_CATALOG_GROUPS,
} from '../lib/apps';
import {
  quickLinkAssignableRoles,
  type QuickLinkCategoryView,
  type QuickLinkView,
} from '../lib/quick-links';

interface RoleOption {
  key: string;
  name: string;
}

interface Props {
  links: QuickLinkView[];
  categories: QuickLinkCategoryView[];
  roles: RoleOption[];
  error?: string | null;
  saved?: boolean;
  embedded?: boolean;
}

const {
  links,
  categories,
  roles: allRoles,
  error = null,
  saved = false,
  embedded = false,
} = Astro.props;
const roles = quickLinkAssignableRoles(allRoles);
const addedCatalogKeys = new Set(links.map((link) => link.catalogKey).filter(Boolean));
const catalogByGroup = Object.fromEntries(
  QUICK_LINK_CATALOG_GROUPS.map((group) => [
    group.id,
    QUICK_LINK_CATALOG.filter((item) => item.group === group.id),
  ]),
) as Record<string, typeof QUICK_LINK_CATALOG>;
const defaultCategoryId = categories[0]?.id ?? '';
---

<section class:list={[!embedded && 'mt-10', 'scroll-mt-24']} id="quick-links" aria-labelledby="quick-links-heading">
  {!embedded ? <h2 id="quick-links-heading" class="font-display text-3xl text-charcoal">Quick links</h2> : <h2 id="quick-links-heading" class="sr-only">Quick links</h2>}

  {
    saved ? (
      <p class="mt-4 rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-900">
        Quick links saved.
      </p>
    ) : null
  }
  {
    error ? (
      <p class="mt-4 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800">{error}</p>
    ) : null
  }

  <div class="mt-6 space-y-8">
    <div class="rounded-2xl border border-sage-dark/15 bg-white p-4 sm:p-5">
      <h3 class="text-sm font-semibold text-charcoal">Sections</h3>
      <p class="mt-1 text-sm text-sage-dark/70">
        Rename section titles and change the order they appear on Quick links and Home.
      </p>
      <div class="mt-4 space-y-3">
        {
          categories.map((category, index) => (
            <div class="flex flex-wrap items-end gap-2 rounded-xl border border-sage-dark/10 bg-[#fafbfc] p-3">
              <form method="post" action="/api/admin/quick-links" class="flex min-w-0 flex-1 flex-wrap items-end gap-2">
                <input type="hidden" name="action" value="update-category" />
                <input type="hidden" name="categoryId" value={category.id} />
                <label class="min-w-[12rem] flex-1 text-sm font-medium text-charcoal">
                  Title
                  <input class="field mt-1" type="text" name="title" required value={category.title} />
                </label>
                <button class="rounded-full bg-brand px-3 py-1.5 text-xs font-semibold text-onbrand" type="submit">
                  Save
                </button>
              </form>
              <form method="post" action="/api/admin/quick-links">
                <input type="hidden" name="action" value="move-category" />
                <input type="hidden" name="categoryId" value={category.id} />
                <input type="hidden" name="direction" value="up" />
                <button
                  class="rounded-full px-2.5 py-1.5 text-xs font-semibold text-sage-dark ring-1 ring-sage-dark/15 disabled:opacity-40"
                  type="submit"
                  disabled={index === 0}
                  aria-label="Move section up"
                >
                  ↑
                </button>
              </form>
              <form method="post" action="/api/admin/quick-links">
                <input type="hidden" name="action" value="move-category" />
                <input type="hidden" name="categoryId" value={category.id} />
                <input type="hidden" name="direction" value="down" />
                <button
                  class="rounded-full px-2.5 py-1.5 text-xs font-semibold text-sage-dark ring-1 ring-sage-dark/15 disabled:opacity-40"
                  type="submit"
                  disabled={index === categories.length - 1}
                  aria-label="Move section down"
                >
                  ↓
                </button>
              </form>
              {
                categories.length > 1 ? (
                  <form method="post" action="/api/admin/quick-links">
                    <input type="hidden" name="action" value="delete-category" />
                    <input type="hidden" name="categoryId" value={category.id} />
                    <input
                      type="hidden"
                      name="moveLinksToCategoryId"
                      value={categories.find((item) => item.id !== category.id)?.id ?? ''}
                    />
                    <button
                      class="rounded-full px-2.5 py-1.5 text-xs font-semibold text-red-700 ring-1 ring-red-200 hover:bg-red-50"
                      type="submit"
                      onclick="return confirm('Delete this section? Links in it move to another section.')"
                    >
                      Delete
                    </button>
                  </form>
                ) : null
              }
            </div>
          ))
        }
      </div>
      <form method="post" action="/api/admin/quick-links" class="mt-4 flex flex-wrap items-end gap-2">
        <input type="hidden" name="action" value="create-category" />
        <label class="min-w-[12rem] flex-1 text-sm font-medium text-charcoal">
          New section title
          <input class="field mt-1" type="text" name="title" required placeholder="e.g. Credentialing tools" />
        </label>
        <button class="btn-primary !py-2 text-sm" type="submit">Add section</button>
      </form>
    </div>

    <div class="rounded-2xl border border-sage-dark/15 bg-white p-4 sm:p-5">
      <h3 class="text-sm font-semibold text-charcoal">Add from catalog</h3>
      <p class="mt-1 text-sm text-sage-dark/70">
        Pick a type of tool, then a specific product. Choose which section it should appear under.
      </p>
      <form
        method="post"
        action="/api/admin/quick-links"
        class="mt-4 space-y-3"
        data-catalog-add
      >
        <input type="hidden" name="action" value="add-from-catalog" />
        <div class="grid gap-3 sm:grid-cols-3">
          <label class="block text-sm font-medium text-charcoal">
            Catalog type
            <select class="field mt-1" name="catalogGroup" data-catalog-group required>
              <option value="">Select a type…</option>
              {
                QUICK_LINK_CATALOG_GROUPS.map((group) => (
                  <option value={group.id}>{group.title}</option>
                ))
              }
            </select>
          </label>
          <label class="block text-sm font-medium text-charcoal">
            Tool
            <select class="field mt-1" name="catalogKey" data-catalog-tool required disabled>
              <option value="">Select a tool…</option>
            </select>
          </label>
          <label class="block text-sm font-medium text-charcoal">
            Show under section
            <select class="field mt-1" name="categoryId" required>
              {
                categories.map((category) => (
                  <option value={category.id} selected={category.id === defaultCategoryId}>
                    {category.title}
                  </option>
                ))
              }
            </select>
          </label>
        </div>
        <fieldset>
          <legend class="text-xs font-semibold uppercase tracking-[0.12em] text-sage-dark/50">Visible to roles</legend>
          <div class="mt-2 flex flex-wrap gap-x-4 gap-y-2">
            {
              roles.map((role) => (
                <label class="inline-flex items-center gap-2 text-sm text-charcoal">
                  <input type="checkbox" name="roleKeys" value={role.key} />
                  {role.name}
                </label>
              ))
            }
          </div>
          <p class="mt-2 text-[11px] text-sage-dark/55">
            Leave all unchecked to use the suggested roles for that tool. Owner accounts always see every link.
          </p>
        </fieldset>
        <button class="btn-primary" type="submit">Add tool</button>
      </form>
      <script
        is:inline
        define:vars={{
          catalogByGroup,
          addedCatalogKeys: [...addedCatalogKeys],
        }}
      >
        (function () {
          var form = document.querySelector('[data-catalog-add]');
          if (!form) return;
          var groupSelect = form.querySelector('[data-catalog-group]');
          var toolSelect = form.querySelector('[data-catalog-tool]');
          if (!(groupSelect instanceof HTMLSelectElement) || !(toolSelect instanceof HTMLSelectElement)) return;
          var added = Array.isArray(addedCatalogKeys) ? addedCatalogKeys : [];

          function fillTools() {
            var group = groupSelect.value;
            var items = (catalogByGroup && catalogByGroup[group]) || [];
            toolSelect.innerHTML = '';
            var placeholder = document.createElement('option');
            placeholder.value = '';
            placeholder.textContent = items.length ? 'Select a tool…' : 'No tools in this type';
            toolSelect.appendChild(placeholder);
            items.forEach(function (item) {
              var opt = document.createElement('option');
              opt.value = item.key;
              opt.textContent = added.indexOf(item.key) >= 0 ? item.name + ' (already added)' : item.name;
              if (added.indexOf(item.key) >= 0) opt.disabled = true;
              toolSelect.appendChild(opt);
            });
            toolSelect.disabled = !group || items.length === 0;
          }

          groupSelect.addEventListener('change', fillTools);
          fillTools();
        })();
      </script>
    </div>

    <div class="rounded-2xl border border-sage-dark/15 bg-white p-4 sm:p-5">
      <h3 class="text-sm font-semibold text-charcoal">Your quick links</h3>
      <p class="mt-1 text-sm text-sage-dark/70">
        Edit each button, including which section it belongs under.
      </p>

      {
        links.length === 0 ? (
          <p class="mt-4 rounded-xl border border-dashed border-sage-dark/20 bg-[#fafbfc] px-4 py-6 text-sm text-sage-dark/65">
            No quick links yet. Add a catalog tool above, or create a custom link below.
          </p>
        ) : (
          <div class="mt-4 space-y-4">
            {links.map((link) => (
              <div class="rounded-xl border border-sage-dark/10 bg-[#fafbfc] p-4">
                <form method="post" action="/api/admin/quick-links" class="space-y-3">
                  <input type="hidden" name="action" value="update-custom" />
                  <input type="hidden" name="linkId" value={link.id} />
                  <div class="grid gap-3 sm:grid-cols-2">
                    <label class="block text-sm font-medium text-charcoal">
                      Name
                      <input class="field mt-1" type="text" name="name" required value={link.name} />
                    </label>
                    <label class="block text-sm font-medium text-charcoal">
                      URL
                      <input class="field mt-1" type="url" name="href" required value={link.href} />
                    </label>
                    <label class="block text-sm font-medium text-charcoal">
                      Section
                      <select class="field mt-1" name="categoryId" required>
                        {categories.map((category) => (
                          <option value={category.id} selected={category.id === link.categoryId}>
                            {category.title}
                          </option>
                        ))}
                      </select>
                    </label>
                    <label class="block text-sm font-medium text-charcoal">
                      Icon URL or /app-icons/ path
                      <input
                        class="field mt-1"
                        type="text"
                        name="iconSrc"
                        value={link.iconSrc ?? ''}
                        placeholder="https://… or /app-icons/example.png"
                      />
                    </label>
                  </div>
                  <label class="block text-sm font-medium text-charcoal">
                    Description
                    <textarea class="field mt-1" name="description" rows="2">{link.description}</textarea>
                  </label>
                  <label class="inline-flex items-center gap-2 text-sm text-charcoal">
                    <input type="checkbox" name="enabled" value="1" checked={link.enabled} />
                    Visible
                  </label>
                  <fieldset>
                    <legend class="text-xs font-semibold uppercase tracking-[0.12em] text-sage-dark/50">Roles</legend>
                    <div class="mt-2 flex flex-wrap gap-x-4 gap-y-2">
                      {roles.map((role) => (
                        <label class="inline-flex items-center gap-2 text-sm text-charcoal">
                          <input
                            type="checkbox"
                            name="roleKeys"
                            value={role.key}
                            checked={link.roleKeys.includes(role.key)}
                          />
                          {role.name}
                        </label>
                      ))}
                    </div>
                    <p class="mt-2 text-[11px] text-sage-dark/55">
                      {link.roleKeys.length === 0
                        ? 'Currently visible to everyone. Check roles to restrict. Owner accounts always see every link.'
                        : 'Leave all unchecked to show to everyone. Owner accounts always see every link.'}
                    </p>
                  </fieldset>
                  <div class="flex flex-wrap justify-end gap-2">
                    <button class="rounded-full bg-brand px-3 py-1.5 text-xs font-semibold text-onbrand" type="submit">
                      Save
                    </button>
                  </div>
                </form>
                <form method="post" action="/api/admin/quick-links" class="mt-2 flex justify-end">
                  <input type="hidden" name="action" value="delete-custom" />
                  <input type="hidden" name="linkId" value={link.id} />
                  <button
                    class="rounded-full px-3 py-1.5 text-xs font-semibold text-red-700 ring-1 ring-red-200 hover:bg-red-50"
                    type="submit"
                    onclick="return confirm('Remove this quick link?')"
                  >
                    Remove
                  </button>
                </form>
              </div>
            ))}
          </div>
        )
      }
    </div>

    <div class="rounded-2xl border border-dashed border-sage-dark/25 bg-[#fafbfc] p-4 sm:p-5">
      <h3 class="text-sm font-semibold text-charcoal">Add a custom link</h3>
      <p class="mt-1 text-sm text-sage-dark/70">
        For anything not in the catalog — paste a name and URL yourself.
      </p>
      <form method="post" action="/api/admin/quick-links" class="mt-4 space-y-3">
        <input type="hidden" name="action" value="create-custom" />
        <input type="hidden" name="enabled" value="1" />
        <div class="grid gap-3 sm:grid-cols-2">
          <label class="block text-sm font-medium text-charcoal">
            Name
            <input class="field mt-1" type="text" name="name" required placeholder="Tool name" />
          </label>
          <label class="block text-sm font-medium text-charcoal">
            URL
            <input class="field mt-1" type="url" name="href" required placeholder="https://…" />
          </label>
          <label class="block text-sm font-medium text-charcoal">
            Section
            <select class="field mt-1" name="categoryId" required>
              {
                categories.map((category) => (
                  <option value={category.id}>{category.title}</option>
                ))
              }
            </select>
          </label>
          <label class="block text-sm font-medium text-charcoal">
            Icon URL or /app-icons/ path
            <input class="field mt-1" type="text" name="iconSrc" placeholder="Optional" />
          </label>
        </div>
        <label class="block text-sm font-medium text-charcoal">
          Description
          <textarea class="field mt-1" name="description" rows="2" placeholder="Optional short description"></textarea>
        </label>
        <fieldset>
          <legend class="text-xs font-semibold uppercase tracking-[0.12em] text-sage-dark/50">Roles</legend>
          <div class="mt-2 flex flex-wrap gap-x-4 gap-y-2">
            {
              roles.map((role) => (
                <label class="inline-flex items-center gap-2 text-sm text-charcoal">
                  <input type="checkbox" name="roleKeys" value={role.key} />
                  {role.name}
                </label>
              ))
            }
          </div>
          <p class="mt-2 text-[11px] text-sage-dark/55">
            Leave all unchecked to show to everyone. Owner accounts always see every link.
          </p>
        </fieldset>
        <button class="btn-primary" type="submit">Add custom link</button>
      </form>
    </div>
  </div>
</section>
