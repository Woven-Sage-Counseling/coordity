---
import { appCategories } from '../lib/apps';
import type { QuickLinkView } from '../lib/quick-links';

interface RoleOption {
  key: string;
  name: string;
}

interface Props {
  links: QuickLinkView[];
  roles: RoleOption[];
  error?: string | null;
  saved?: boolean;
  embedded?: boolean;
}

const { links, roles, error = null, saved = false, embedded = false } = Astro.props;
const builtins = links.filter((link) => link.source === 'builtin');
const customs = links.filter((link) => link.source === 'custom');
---

<section class:list={[!embedded && 'mt-10', 'scroll-mt-24']} id="quick-links" aria-labelledby="quick-links-heading">
  {!embedded ? <h2 id="quick-links-heading" class="font-display text-3xl text-charcoal">Quick links</h2> : <h2 id="quick-links-heading" class="sr-only">Quick links</h2>}

  {
    saved ? (
      <p class="mt-4 rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-900">
        Quick links saved.
      </p>
    ) : null
  }
  {
    error ? (
      <p class="mt-4 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800">{error}</p>
    ) : null
  }

  <div class="mt-6 space-y-8">
    <div class="rounded-2xl border border-sage-dark/15 bg-white p-4 sm:p-5">
      <h3 class="text-sm font-semibold text-charcoal">Built-in links</h3>
      <p class="mt-1 text-sm text-sage-dark/70">
        Turn catalog apps on or off and limit which roles can see them. Until you save roles for a link, it keeps its current permission-based visibility.
      </p>
      <div class="mt-4 space-y-4">
        {
          builtins.map((link) => (
            <form
              method="post"
              action="/api/admin/quick-links"
              class="rounded-xl border border-sage-dark/10 bg-[#fafbfc] p-4"
            >
              <input type="hidden" name="action" value="update-builtin" />
              <input type="hidden" name="appId" value={link.id} />
              <div class="flex flex-wrap items-start justify-between gap-3">
                <div class="min-w-0">
                  <p class="font-semibold text-charcoal">{link.name}</p>
                  <p class="mt-0.5 text-xs text-sage-dark/60">
                    {appCategories.find((c) => c.id === link.category)?.title ?? link.category}
                    {' · '}
                    <a class="underline-offset-2 hover:underline" href={link.href} target="_blank" rel="noopener noreferrer">
                      Open
                    </a>
                  </p>
                </div>
                <label class="inline-flex items-center gap-2 text-sm text-charcoal">
                  <input type="checkbox" name="enabled" value="1" checked={link.enabled} />
                  Visible
                </label>
              </div>
              <fieldset class="mt-3">
                <legend class="text-xs font-semibold uppercase tracking-[0.12em] text-sage-dark/50">Roles</legend>
                <div class="mt-2 flex flex-wrap gap-x-4 gap-y-2">
                  {roles.map((role) => (
                    <label class="inline-flex items-center gap-2 text-sm text-charcoal">
                      <input
                        type="checkbox"
                        name="roleKeys"
                        value={role.key}
                        checked={link.roleKeys.includes(role.key)}
                      />
                      {role.name}
                    </label>
                  ))}
                </div>
                <p class="mt-2 text-[11px] text-sage-dark/55">
                  Leave all unchecked to show to everyone. Saving roles switches this link to role-based visibility.
                </p>
              </fieldset>
              <div class="mt-3 flex justify-end">
                <button class="rounded-full bg-charcoal px-3 py-1.5 text-xs font-semibold text-white" type="submit">
                  Save
                </button>
              </div>
            </form>
          ))
        }
      </div>
    </div>

    <div class="rounded-2xl border border-sage-dark/15 bg-white p-4 sm:p-5">
      <h3 class="text-sm font-semibold text-charcoal">Custom links</h3>
      <p class="mt-1 text-sm text-sage-dark/70">Add practice-specific buttons for tools that are not in the built-in catalog.</p>

      {
        customs.length === 0 ? (
          <p class="mt-4 text-sm text-sage-dark/65">No custom links yet.</p>
        ) : (
          <div class="mt-4 space-y-4">
            {customs.map((link) => (
              <div class="rounded-xl border border-sage-dark/10 bg-[#fafbfc] p-4">
                <form method="post" action="/api/admin/quick-links" class="space-y-3">
                  <input type="hidden" name="action" value="update-custom" />
                  <input type="hidden" name="linkId" value={link.id} />
                  <div class="grid gap-3 sm:grid-cols-2">
                    <label class="block text-sm font-medium text-charcoal">
                      Name
                      <input class="field mt-1" type="text" name="name" required value={link.name} />
                    </label>
                    <label class="block text-sm font-medium text-charcoal">
                      URL
                      <input class="field mt-1" type="url" name="href" required value={link.href} />
                    </label>
                    <label class="block text-sm font-medium text-charcoal">
                      Category
                      <select class="field mt-1" name="category">
                        {appCategories.map((category) => (
                          <option value={category.id} selected={category.id === link.category}>
                            {category.title}
                          </option>
                        ))}
                      </select>
                    </label>
                    <label class="block text-sm font-medium text-charcoal">
                      Icon URL or /app-icons/ path
                      <input
                        class="field mt-1"
                        type="text"
                        name="iconSrc"
                        value={link.iconSrc ?? ''}
                        placeholder="https://… or /app-icons/example.png"
                      />
                    </label>
                  </div>
                  <label class="block text-sm font-medium text-charcoal">
                    Description
                    <textarea class="field mt-1" name="description" rows="2">{link.description}</textarea>
                  </label>
                  <label class="inline-flex items-center gap-2 text-sm text-charcoal">
                    <input type="checkbox" name="enabled" value="1" checked={link.enabled} />
                    Visible
                  </label>
                  <fieldset>
                    <legend class="text-xs font-semibold uppercase tracking-[0.12em] text-sage-dark/50">Roles</legend>
                    <div class="mt-2 flex flex-wrap gap-x-4 gap-y-2">
                      {roles.map((role) => (
                        <label class="inline-flex items-center gap-2 text-sm text-charcoal">
                          <input
                            type="checkbox"
                            name="roleKeys"
                            value={role.key}
                            checked={link.roleKeys.includes(role.key)}
                          />
                          {role.name}
                        </label>
                      ))}
                    </div>
                    <p class="mt-2 text-[11px] text-sage-dark/55">
                      {link.roleKeys.length === 0
                        ? 'Currently visible to everyone. Check roles to restrict, or leave all unchecked to keep everyone.'
                        : 'Leave all unchecked to show to everyone.'}
                    </p>
                  </fieldset>
                  <div class="flex flex-wrap justify-end gap-2">
                    <button class="rounded-full bg-charcoal px-3 py-1.5 text-xs font-semibold text-white" type="submit">
                      Save
                    </button>
                  </div>
                </form>
                <form method="post" action="/api/admin/quick-links" class="mt-2 flex justify-end">
                  <input type="hidden" name="action" value="delete-custom" />
                  <input type="hidden" name="linkId" value={link.id} />
                  <button
                    class="rounded-full px-3 py-1.5 text-xs font-semibold text-red-700 ring-1 ring-red-200 hover:bg-red-50"
                    type="submit"
                    onclick="return confirm('Delete this quick link permanently?')"
                  >
                    Delete
                  </button>
                </form>
              </div>
            ))}
          </div>
        )
      }

      <form
        method="post"
        action="/api/admin/quick-links"
        class="mt-6 space-y-3 rounded-xl border border-dashed border-sage-dark/25 bg-[#fafbfc] p-4"
      >
        <input type="hidden" name="action" value="create-custom" />
        <input type="hidden" name="enabled" value="1" />
        <p class="text-sm font-semibold text-charcoal">Add a custom link</p>
        <div class="grid gap-3 sm:grid-cols-2">
          <label class="block text-sm font-medium text-charcoal">
            Name
            <input class="field mt-1" type="text" name="name" required placeholder="Tool name" />
          </label>
          <label class="block text-sm font-medium text-charcoal">
            URL
            <input class="field mt-1" type="url" name="href" required placeholder="https://…" />
          </label>
          <label class="block text-sm font-medium text-charcoal">
            Category
            <select class="field mt-1" name="category">
              {appCategories.map((category) => (
                <option value={category.id}>{category.title}</option>
              ))}
            </select>
          </label>
          <label class="block text-sm font-medium text-charcoal">
            Icon URL or /app-icons/ path
            <input class="field mt-1" type="text" name="iconSrc" placeholder="Optional" />
          </label>
        </div>
        <label class="block text-sm font-medium text-charcoal">
          Description
          <textarea class="field mt-1" name="description" rows="2" placeholder="Optional short description"></textarea>
        </label>
        <fieldset>
          <legend class="text-xs font-semibold uppercase tracking-[0.12em] text-sage-dark/50">Roles</legend>
          <div class="mt-2 flex flex-wrap gap-x-4 gap-y-2">
            {roles.map((role) => (
              <label class="inline-flex items-center gap-2 text-sm text-charcoal">
                <input type="checkbox" name="roleKeys" value={role.key} />
                {role.name}
              </label>
            ))}
          </div>
          <p class="mt-2 text-[11px] text-sage-dark/55">Leave all unchecked to show to everyone.</p>
        </fieldset>
        <button class="btn-primary" type="submit">Add quick link</button>
      </form>
    </div>
  </div>
</section>
