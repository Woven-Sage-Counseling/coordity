---
import {
  QUICK_LINK_CATALOG,
  QUICK_LINK_CATALOG_GROUPS,
} from '../lib/apps';
import {
  quickLinkAssignableRoles,
  type QuickLinkCategoryView,
  type QuickLinkView,
} from '../lib/quick-links';

interface RoleOption {
  key: string;
  name: string;
}

interface Props {
  links: QuickLinkView[];
  categories: QuickLinkCategoryView[];
  roles: RoleOption[];
  error?: string | null;
  saved?: boolean;
  embedded?: boolean;
}

const {
  links,
  categories,
  roles: allRoles,
  error = null,
  saved = false,
  embedded = false,
} = Astro.props;
const roles = quickLinkAssignableRoles(allRoles);
const addedCatalogKeys = new Set(links.map((link) => link.catalogKey).filter(Boolean));
const catalogByGroup = Object.fromEntries(
  QUICK_LINK_CATALOG_GROUPS.map((group) => [
    group.id,
    QUICK_LINK_CATALOG.filter((item) => item.group === group.id),
  ]),
) as Record<string, typeof QUICK_LINK_CATALOG>;
const defaultCategoryId = categories[0]?.id ?? '';
const knownCategoryIds = new Set(categories.map((category) => category.id));
const unsectioned = links.filter((link) => !knownCategoryIds.has(link.categoryId));
const previewSections = categories.map((category, index) => ({
  id: category.id,
  title: category.title,
  index,
  links: links.filter((link) => link.categoryId === category.id),
}));
---

<section class:list={[!embedded && 'mt-10', 'scroll-mt-24']} id="quick-links" aria-labelledby="quick-links-heading">
  {!embedded ? <h2 id="quick-links-heading" class="font-display text-3xl text-charcoal">Quick links</h2> : <h2 id="quick-links-heading" class="sr-only">Quick links</h2>}

  {
    saved ? (
      <>
        <p data-quick-links-saved class="mt-4 rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-900">
          Quick links saved.
        </p>
        <script is:inline>
          (function () {
            var nav = performance.getEntriesByType('navigation')[0];
            if (nav && nav.type === 'reload') {
              var badge = document.querySelector('[data-quick-links-saved]');
              if (badge) badge.remove();
            }
            var params = new URLSearchParams(location.search);
            if (!params.has('quickLinksSaved')) return;
            params.delete('quickLinksSaved');
            var search = params.toString();
            history.replaceState(null, '', location.pathname + (search ? '?' + search : '') + location.hash);
          })();
        </script>
      </>
    ) : null
  }
  {
    error ? (
      <p class="mt-4 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800">{error}</p>
    ) : null
  }

  <div class="mt-6 space-y-6">
    <div data-ql-board>
      <div class="space-y-5">
            {previewSections.map((section) => (
                <section>
                  <div class="flex w-full items-center gap-1.5">
                    <form method="post" action="/api/admin/quick-links">
                      <input type="hidden" name="action" value="move-category" />
                      <input type="hidden" name="categoryId" value={section.id} />
                      <input type="hidden" name="direction" value="up" />
                      <button
                        class="rounded-full px-2.5 py-1 text-xs font-semibold text-sage-dark ring-1 ring-sage-dark/15 hover:bg-white disabled:opacity-40"
                        type="submit"
                        disabled={section.index === 0}
                        aria-label="Move section up"
                      >
                        ↑
                      </button>
                    </form>
                    <form method="post" action="/api/admin/quick-links">
                      <input type="hidden" name="action" value="move-category" />
                      <input type="hidden" name="categoryId" value={section.id} />
                      <input type="hidden" name="direction" value="down" />
                      <button
                        class="rounded-full px-2.5 py-1 text-xs font-semibold text-sage-dark ring-1 ring-sage-dark/15 hover:bg-white disabled:opacity-40"
                        type="submit"
                        disabled={section.index === categories.length - 1}
                        aria-label="Move section down"
                      >
                        ↓
                      </button>
                    </form>
                    <form method="post" action="/api/admin/quick-links" class="flex min-w-0 flex-1 items-center gap-1.5">
                      <input type="hidden" name="action" value="update-category" />
                      <input type="hidden" name="categoryId" value={section.id} />
                      <input
                        data-ql-section-title
                        class="w-auto max-w-full border-0 bg-transparent p-0 font-display text-lg text-charcoal shadow-none outline-none ring-0 read-only:cursor-default"
                        type="text"
                        name="title"
                        required
                        readonly
                        value={section.title}
                        size={Math.max(section.title.length, 1)}
                        aria-label="Section title"
                      />
                      <button
                        type="button"
                        data-ql-section-edit
                        class="shrink-0 rounded-full px-2.5 py-1 text-xs font-semibold text-sage-dark ring-1 ring-sage-dark/15 hover:bg-white"
                      >
                        Edit
                      </button>
                      <button class="ml-auto shrink-0 rounded-full px-2.5 py-1 text-xs font-semibold text-sage-dark ring-1 ring-sage-dark/15 hover:bg-white" type="submit">
                        Save
                      </button>
                    </form>
                    {
                      categories.length > 1 ? (
                        <form method="post" action="/api/admin/quick-links">
                          <input type="hidden" name="action" value="delete-category" />
                          <input type="hidden" name="categoryId" value={section.id} />
                          <input
                            type="hidden"
                            name="moveLinksToCategoryId"
                            value={categories.find((item) => item.id !== section.id)?.id ?? ''}
                          />
                          <button
                            class="shrink-0 rounded-full px-2.5 py-1 text-xs font-semibold text-red-700 ring-1 ring-red-200 hover:bg-red-50"
                            type="submit"
                            onclick="return confirm('Delete this section? Links in it move to another section.')"
                          >
                            Delete
                          </button>
                        </form>
                      ) : null
                    }
                  </div>
                  <div class="mt-3 flex flex-wrap items-start gap-x-3 gap-y-4">
                    {section.links.map((link) => (
                      <button
                        type="button"
                        data-ql-open={link.id}
                        aria-pressed="false"
                        class:list={[
                          'rounded-xl outline-none transition hover:-translate-y-0.5 aria-pressed:ring-2 aria-pressed:ring-sage-dark aria-pressed:ring-offset-2',
                          link.iconSrc
                            ? 'inline-flex w-[4.65rem] flex-col items-center text-center'
                            : 'flex w-36 flex-col border border-sage-dark/10 bg-white p-2.5 text-left shadow-sm',
                          link.enabled ? '' : 'opacity-45 aria-pressed:opacity-100',
                        ]}
                      >
                        {
                          link.iconSrc ? (
                            <img
                              src={link.iconSrc}
                              alt=""
                              class="h-16 w-16 rounded-[0.92rem] bg-white object-contain shadow-[0_6px_14px_rgba(26,28,30,0.16)] ring-1 ring-black/10"
                            />
                          ) : (
                            <span class="text-[10px] uppercase tracking-[0.14em] text-sage-dark/55">{section.title}</span>
                          )
                        }
                        <span class:list={['font-medium leading-tight text-charcoal', link.iconSrc ? 'mt-1.5 text-[11px]' : 'mt-1 font-display text-base']}>
                          {link.name}
                        </span>
                        {
                          link.iconSrc ? null : (
                            <span class="mt-1 line-clamp-2 text-[11px] leading-snug text-sage-dark/70">{link.description}</span>
                          )
                        }
                        {link.enabled ? null : <span class="mt-1 text-[10px] font-medium text-sage-dark/60">Hidden</span>}
                      </button>
                    ))}
                    <button
                      type="button"
                      data-ql-add={section.id}
                      aria-pressed="false"
                      aria-label={`Add a link to ${section.title}`}
                      class="inline-flex w-[4.65rem] flex-col items-center rounded-xl text-center outline-none transition hover:-translate-y-0.5 aria-pressed:ring-2 aria-pressed:ring-sage-dark aria-pressed:ring-offset-2"
                    >
                      <span class="flex h-16 w-16 items-center justify-center rounded-[0.92rem] border-2 border-dashed border-sage-dark/30 text-sage-dark/45">
                        <svg width="22" height="22" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                          <path d="M8 3v10M3 8h10" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" />
                        </svg>
                      </span>
                    </button>
                  </div>
                </section>
            ))}
            {
              unsectioned.length > 0 ? (
                <section>
                  <h3 class="font-display text-lg text-charcoal">Other</h3>
                  <div class="mt-3 flex flex-wrap gap-x-3 gap-y-4">
                    {unsectioned.map((link) => (
                      <button
                        type="button"
                        data-ql-open={link.id}
                        aria-pressed="false"
                        class:list={[
                          'rounded-xl outline-none transition hover:-translate-y-0.5 aria-pressed:ring-2 aria-pressed:ring-sage-dark aria-pressed:ring-offset-2',
                          link.iconSrc
                            ? 'inline-flex w-[4.65rem] flex-col items-center text-center'
                            : 'flex w-36 flex-col border border-sage-dark/10 bg-white p-2.5 text-left shadow-sm',
                          link.enabled ? '' : 'opacity-45 aria-pressed:opacity-100',
                        ]}
                      >
                        {
                          link.iconSrc ? (
                            <img
                              src={link.iconSrc}
                              alt=""
                              class="h-16 w-16 rounded-[0.92rem] bg-white object-contain shadow-[0_6px_14px_rgba(26,28,30,0.16)] ring-1 ring-black/10"
                            />
                          ) : (
                            <span class="text-[10px] uppercase tracking-[0.14em] text-sage-dark/55">Other</span>
                          )
                        }
                        <span class:list={['font-medium leading-tight text-charcoal', link.iconSrc ? 'mt-1.5 text-[11px]' : 'mt-1 font-display text-base']}>
                          {link.name}
                        </span>
                        {link.enabled ? null : <span class="mt-1 text-[10px] font-medium text-sage-dark/60">Hidden</span>}
                      </button>
                    ))}
                  </div>
                </section>
              ) : null
            }
            <form method="post" action="/api/admin/quick-links">
              <input type="hidden" name="action" value="create-category" />
              <input type="hidden" name="title" value="New section" />
              <button
                type="submit"
                class="flex w-full items-center justify-center gap-2 rounded-xl border-2 border-dashed border-sage-dark/30 px-3 py-2.5 font-display text-lg text-sage-dark/50 transition hover:-translate-y-0.5"
              >
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                  <path d="M8 3v10M3 8h10" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" />
                </svg>
                Section
              </button>
            </form>
          </div>
      <div hidden data-ql-add-panel class="mt-4 rounded-2xl border border-sage-dark/10 bg-white/90 p-4 shadow-sm">
        <div data-ql-add-catalog>
          <form method="post" action="/api/admin/quick-links" class="space-y-2" data-catalog-add>
            <input type="hidden" name="action" value="add-from-catalog" />
            <div class="flex flex-wrap items-center gap-1.5">
              <select class="field min-w-[9rem] flex-1" name="catalogGroup" data-catalog-group required aria-label="Catalog type">
                <option value="">Type</option>
                {
                  QUICK_LINK_CATALOG_GROUPS.map((group) => (
                    <option value={group.id}>{group.title}</option>
                  ))
                }
              </select>
              <select class="field min-w-[9rem] flex-1" name="catalogKey" data-catalog-tool required disabled aria-label="Tool">
                <option value="">Tool</option>
              </select>
              <select class="field min-w-[9rem] flex-1" name="categoryId" required aria-label="Section">
                {
                  categories.map((category) => (
                    <option value={category.id} selected={category.id === defaultCategoryId}>
                      {category.title}
                    </option>
                  ))
                }
              </select>
              <button class="shrink-0 rounded-full bg-brand px-3 py-1.5 text-xs font-semibold text-onbrand" type="submit">Add</button>
              <button
                class="shrink-0 rounded-full px-3 py-1.5 text-xs font-semibold text-sage-dark ring-1 ring-sage-dark/15 hover:bg-white"
                type="button"
                data-ql-show-custom
              >
                Custom
              </button>
            </div>
            <details class="group/ql" data-ql-visibility>
              <summary class="flex w-fit max-w-full cursor-pointer list-none items-center gap-1.5 rounded-full px-3 py-1.5 text-xs font-semibold text-sage-dark ring-1 ring-sage-dark/15 hover:bg-white [&::-webkit-details-marker]:hidden">
                Limit who can see it
                <span data-ql-visibility-state class="font-medium text-sage-dark/55">· Everyone</span>
                <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true" class="shrink-0 transition group-open/ql:rotate-180">
                  <path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </summary>
              <div class="mt-2 flex flex-wrap gap-x-4 gap-y-2">
                {
                  roles.map((role) => (
                    <label class="inline-flex items-center gap-2 text-sm text-charcoal">
                      <input type="checkbox" name="roleKeys" value={role.key} />
                      {role.name}
                    </label>
                  ))
                }
              </div>
              <p class="mt-1.5 text-[11px] text-sage-dark/55">Leave unchecked and everyone can see it. Owners always see every link.</p>
            </details>
          </form>
        </div>
        <form hidden method="post" action="/api/admin/quick-links" class="space-y-2" data-ql-custom-fields>
          <input type="hidden" name="action" value="create-custom" />
          <input type="hidden" name="enabled" value="1" />
          <button
            class="text-xs font-medium text-sage-dark/70 underline-offset-2 hover:underline"
            type="button"
            data-ql-show-catalog
          >
            Catalog
          </button>
          <div class="grid gap-2 sm:grid-cols-2">
            <input class="field" type="text" name="name" required placeholder="Name" aria-label="Name" />
            <input class="field" type="url" name="href" required placeholder="https://" aria-label="URL" />
            <select class="field" name="categoryId" required aria-label="Section">
              {
                categories.map((category) => (
                  <option value={category.id}>{category.title}</option>
                ))
              }
            </select>
            <input class="field" type="text" name="iconSrc" placeholder="Icon URL" aria-label="Icon URL" />
          </div>
          <textarea class="field" name="description" rows="2" placeholder="Description" aria-label="Description"></textarea>
          <details class="group/ql" data-ql-visibility>
            <summary class="flex w-fit max-w-full cursor-pointer list-none items-center gap-1.5 rounded-full px-3 py-1.5 text-xs font-semibold text-sage-dark ring-1 ring-sage-dark/15 hover:bg-white [&::-webkit-details-marker]:hidden">
              Limit who can see it
              <span data-ql-visibility-state class="font-medium text-sage-dark/55">· Everyone</span>
              <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true" class="shrink-0 transition group-open/ql:rotate-180">
                <path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </summary>
            <div class="mt-2 flex flex-wrap gap-x-4 gap-y-2">
              {
                roles.map((role) => (
                  <label class="inline-flex items-center gap-2 text-sm text-charcoal">
                    <input type="checkbox" name="roleKeys" value={role.key} />
                    {role.name}
                  </label>
                ))
              }
            </div>
            <p class="mt-1.5 text-[11px] text-sage-dark/55">Leave unchecked and everyone can see it. Owners always see every link.</p>
          </details>
          <div class="flex justify-end">
            <button class="rounded-full bg-brand px-3 py-1.5 text-xs font-semibold text-onbrand" type="submit">Add</button>
          </div>
        </form>
      </div>
      {
        links.length === 0 ? null : (
          <dialog
            data-ql-dialog
            class="relative max-h-[min(40rem,calc(100%-2rem))] w-[min(36rem,calc(100%-2rem))] overflow-y-auto rounded-2xl border border-sage-dark/10 bg-white p-4 shadow-xl [&::backdrop]:bg-charcoal/35"
          >
            <button
              type="button"
              data-ql-dialog-close
              class="absolute right-3 top-3 rounded-full px-2 py-1 text-sm text-sage-dark/50 hover:bg-sage-dark/5 hover:text-charcoal"
              aria-label="Close"
            >
              ×
            </button>
            {links.map((link) => {
              const formId = `quick-link-${link.id}`;
              return (
                <div hidden data-ql-editor={link.id} class="pr-6">
                  <p class="text-sm font-semibold text-charcoal">{link.name}</p>
                  <form id={formId} method="post" action="/api/admin/quick-links" class="mt-3 space-y-2">
                    <input type="hidden" name="action" value="update-custom" />
                    <input type="hidden" name="linkId" value={link.id} />
                    <div class="grid gap-2 sm:grid-cols-2">
                      <input class="field" type="text" name="name" required value={link.name} aria-label="Name" />
                      <input class="field" type="url" name="href" required value={link.href} aria-label="URL" />
                      <select class="field" name="categoryId" required aria-label="Section">
                        {categories.map((category) => (
                          <option value={category.id} selected={category.id === link.categoryId}>
                            {category.title}
                          </option>
                        ))}
                      </select>
                      <input class="field" type="text" name="iconSrc" value={link.iconSrc ?? ''} placeholder="Icon URL" aria-label="Icon URL" />
                    </div>
                    <textarea class="field" name="description" rows="2" aria-label="Description" placeholder="Description">{link.description}</textarea>
                    <label class="inline-flex items-center gap-2 text-sm text-charcoal">
                      <input type="checkbox" name="enabled" value="1" checked={link.enabled} />
                      Visible
                    </label>
                    <details class="group/ql">
                      <summary class="flex w-fit cursor-pointer list-none items-center gap-1.5 rounded-full px-3 py-1.5 text-xs font-semibold text-sage-dark ring-1 ring-sage-dark/15 hover:bg-white [&::-webkit-details-marker]:hidden">
                        Edit roles
                        <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true" class="transition group-open/ql:rotate-180">
                          <path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                      </summary>
                      <div class="mt-2 flex flex-wrap gap-x-4 gap-y-2">
                        {roles.map((role) => (
                          <label class="inline-flex items-center gap-2 text-sm text-charcoal">
                            <input type="checkbox" name="roleKeys" value={role.key} checked={link.roleKeys.includes(role.key)} />
                            {role.name}
                          </label>
                        ))}
                      </div>
                      <p class="mt-1.5 text-[11px] text-sage-dark/55">Leave unchecked to show everyone. Owners always see every link.</p>
                    </details>
                  </form>
                  <div class="mt-3 flex justify-end gap-2">
                    <form method="post" action="/api/admin/quick-links">
                      <input type="hidden" name="action" value="delete-custom" />
                      <input type="hidden" name="linkId" value={link.id} />
                      <button
                        class="rounded-full px-3 py-1.5 text-xs font-semibold text-red-700 ring-1 ring-red-200 hover:bg-red-50"
                        type="submit"
                        onclick="return confirm('Remove this quick link?')"
                      >
                        Remove
                      </button>
                    </form>
                    <button class="rounded-full bg-brand px-3 py-1.5 text-xs font-semibold text-onbrand" type="submit" form={formId}>
                      Save
                    </button>
                  </div>
                </div>
              );
            })}
          </dialog>
        )
      }
      <script type="application/json" data-ql-catalog is:inline set:html={JSON.stringify({ catalogByGroup, addedCatalogKeys: [...addedCatalogKeys] })}></script>
      <script is:inline>
        window.initQuickLinks = function () {
          var section = document.getElementById('quick-links');
          var root = section && section.querySelector('[data-ql-board]');
          if (!section || !root || section.getAttribute('data-ql-bound') === '1') return;
          section.setAttribute('data-ql-bound', '1');
          var buttons = root.querySelectorAll('[data-ql-open]');
          var panels = root.querySelectorAll('[data-ql-editor]');
          var dialog = root.querySelector('[data-ql-dialog]');
          var addButtons = root.querySelectorAll('[data-ql-add]');
          var addPanel = root.querySelector('[data-ql-add-panel]');
          var catalogChoice = root.querySelector('[data-ql-add-catalog]');
          var customFields = root.querySelector('[data-ql-custom-fields]');

          function showCatalogChoice() {
            if (catalogChoice) catalogChoice.hidden = false;
            if (customFields) customFields.hidden = true;
          }

          function closeAdd() {
            addButtons.forEach(function (item) {
              item.setAttribute('aria-pressed', 'false');
            });
            if (addPanel) addPanel.hidden = true;
            showCatalogChoice();
          }

          function closeEditors() {
            buttons.forEach(function (item) {
              item.setAttribute('aria-pressed', 'false');
            });
            panels.forEach(function (panel) {
              panel.hidden = true;
            });
            if (dialog && dialog.open) dialog.close();
          }

          buttons.forEach(function (button) {
            button.addEventListener('click', function () {
              var id = button.getAttribute('data-ql-open');
              var already = button.getAttribute('aria-pressed') === 'true';
              closeAdd();
              closeEditors();
              if (already) return;
              button.setAttribute('aria-pressed', 'true');
              panels.forEach(function (panel) {
                if (panel.getAttribute('data-ql-editor') === id) panel.hidden = false;
              });
              if (dialog && typeof dialog.showModal === 'function' && !dialog.open) dialog.showModal();
            });
          });

          if (dialog) {
            dialog.addEventListener('click', function (event) {
              if (event.target === dialog) dialog.close();
            });
            dialog.addEventListener('close', function () {
              buttons.forEach(function (item) {
                item.setAttribute('aria-pressed', 'false');
              });
              panels.forEach(function (panel) {
                panel.hidden = true;
              });
            });
            var dialogClose = dialog.querySelector('[data-ql-dialog-close]');
            if (dialogClose) {
              dialogClose.addEventListener('click', function () {
                dialog.close();
              });
            }
          }

          addButtons.forEach(function (addButton) {
            addButton.addEventListener('click', function () {
              var already = addButton.getAttribute('aria-pressed') === 'true';
              var sectionId = addButton.getAttribute('data-ql-add') || '';
              closeEditors();
              if (already) {
                closeAdd();
                return;
              }
              closeAdd();
              addButton.setAttribute('aria-pressed', 'true');
              var section = addButton.closest('section');
              if (section && addPanel) section.appendChild(addPanel);
              if (addPanel) {
                addPanel.hidden = false;
                addPanel.querySelectorAll('select[name="categoryId"]').forEach(function (select) {
                  if (select instanceof HTMLSelectElement) select.value = sectionId;
                });
                if (addPanel.scrollIntoView) addPanel.scrollIntoView({ block: 'nearest' });
              }
              showCatalogChoice();
            });
          });

          var showCustom = root.querySelector('[data-ql-show-custom]');
          var showCatalog = root.querySelector('[data-ql-show-catalog]');
          if (showCustom) {
            showCustom.addEventListener('click', function () {
              if (catalogChoice) catalogChoice.hidden = true;
              if (customFields) customFields.hidden = false;
            });
          }
          if (showCatalog) {
            showCatalog.addEventListener('click', showCatalogChoice);
          }

          root.querySelectorAll('[data-ql-section-edit]').forEach(function (button) {
            button.addEventListener('click', function () {
              var form = button.closest('form');
              var title = form ? form.querySelector('[data-ql-section-title]') : null;
              if (!(title instanceof HTMLInputElement)) return;
              title.readOnly = false;
              title.focus();
              title.select();
            });
          });
          root.querySelectorAll('[data-ql-section-title]').forEach(function (title) {
            title.addEventListener('input', function () {
              if (!(title instanceof HTMLInputElement)) return;
              title.size = Math.max(title.value.length, 1);
            });
          });

          root.querySelectorAll('[data-ql-visibility]').forEach(function (details) {
            var sync = function () {
              var state = details.querySelector('[data-ql-visibility-state]');
              if (!state) return;
              var names = [];
              details.querySelectorAll('input[name="roleKeys"]:checked').forEach(function (input) {
                var label = input.closest('label');
                var text = label ? label.textContent.replace(/\s+/g, ' ').trim() : '';
                if (text) names.push(text);
              });
              state.textContent = names.length ? '· ' + names.join(', ') : '· Everyone';
            };
            details.addEventListener('change', sync);
            sync();
          });

          var catalogEl = section.querySelector('[data-ql-catalog]');
          var catalogForm = root.querySelector('[data-catalog-add]');
          if (catalogEl && catalogForm) {
            var catalogData = {};
            try {
              catalogData = JSON.parse(catalogEl.textContent || '{}');
            } catch (error) {
              catalogData = {};
            }
            var groupSelect = catalogForm.querySelector('[data-catalog-group]');
            var toolSelect = catalogForm.querySelector('[data-catalog-tool]');
            if (groupSelect instanceof HTMLSelectElement && toolSelect instanceof HTMLSelectElement) {
              var added = Array.isArray(catalogData.addedCatalogKeys) ? catalogData.addedCatalogKeys : [];
              var fillTools = function () {
                var group = groupSelect.value;
                var items = (catalogData.catalogByGroup && catalogData.catalogByGroup[group]) || [];
                toolSelect.innerHTML = '';
                var placeholder = document.createElement('option');
                placeholder.value = '';
                placeholder.textContent = items.length ? 'Tool' : 'No tools';
                toolSelect.appendChild(placeholder);
                items.forEach(function (item) {
                  var opt = document.createElement('option');
                  opt.value = item.key;
                  opt.textContent = added.indexOf(item.key) >= 0 ? item.name + ' (already added)' : item.name;
                  if (added.indexOf(item.key) >= 0) opt.disabled = true;
                  toolSelect.appendChild(opt);
                });
                toolSelect.disabled = !group || items.length === 0;
              };
              groupSelect.addEventListener('change', fillTools);
              fillTools();
            }
          }

          section.addEventListener('submit', function (event) {
            var form = event.target;
            if (!(form instanceof HTMLFormElement)) return;
            if (form.getAttribute('action') !== '/api/admin/quick-links') return;
            event.preventDefault();
            var submitter = event.submitter;
            if (submitter instanceof HTMLButtonElement) submitter.disabled = true;
            fetch(form.action, {
              method: 'POST',
              body: new FormData(form),
              credentials: 'same-origin',
              headers: { 'X-Quick-Links-Fetch': '1', Accept: 'application/json' },
            })
              .then(function (res) {
                return res.json().then(function (data) {
                  return { ok: res.ok && data && data.ok, error: data && data.error };
                });
              })
              .then(function (result) {
                if (!result.ok) throw new Error(result.error || 'Could not save quick links.');
                return fetch(location.pathname, {
                  credentials: 'same-origin',
                  cache: 'no-store',
                  headers: { Accept: 'text/html' },
                });
              })
              .then(function (res) {
                if (!res.ok) throw new Error('Saved, but the preview could not refresh.');
                return res.text();
              })
              .then(function (html) {
                var doc = new DOMParser().parseFromString(html, 'text/html');
                var next = doc.getElementById('quick-links');
                var current = document.getElementById('quick-links');
                if (!next || !current || !current.parentNode) throw new Error('Saved, but the preview could not refresh.');
                var openDialog = current.querySelector('[data-ql-dialog]');
                if (openDialog && openDialog.open) openDialog.close();
                current.parentNode.replaceChild(document.importNode(next, true), current);
                if (window.initQuickLinks) window.initQuickLinks();
              })
              .catch(function (error) {
                if (submitter instanceof HTMLButtonElement) submitter.disabled = false;
                var current = document.getElementById('quick-links');
                if (!current) return;
                var note = current.querySelector('[data-ql-error]');
                if (!note) {
                  note = document.createElement('p');
                  note.setAttribute('data-ql-error', '');
                  note.className = 'mt-4 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800';
                  var board = current.querySelector('[data-ql-board]');
                  if (board && board.parentNode) board.parentNode.insertBefore(note, board);
                  else current.appendChild(note);
                }
                note.textContent = error instanceof Error ? error.message : 'Could not save quick links.';
              });
          });
        };
        window.initQuickLinks();
      </script>
    </div>
  </div>
</section>
