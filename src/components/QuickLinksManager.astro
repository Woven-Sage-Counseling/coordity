---
import {
  QUICK_LINK_CATALOG,
  QUICK_LINK_CATALOG_GROUPS,
} from '../lib/apps';
import {
  quickLinkAssignableRoles,
  type QuickLinkCategoryView,
  type QuickLinkView,
} from '../lib/quick-links';

interface RoleOption {
  key: string;
  name: string;
}

interface Props {
  links: QuickLinkView[];
  categories: QuickLinkCategoryView[];
  roles: RoleOption[];
  error?: string | null;
  saved?: boolean;
  embedded?: boolean;
}

const {
  links,
  categories,
  roles: allRoles,
  error = null,
  saved = false,
  embedded = false,
} = Astro.props;
const roles = quickLinkAssignableRoles(allRoles);
const addedCatalogKeys = new Set(links.map((link) => link.catalogKey).filter(Boolean));
const catalogByGroup = Object.fromEntries(
  QUICK_LINK_CATALOG_GROUPS.map((group) => [
    group.id,
    QUICK_LINK_CATALOG.filter((item) => item.group === group.id),
  ]),
) as Record<string, typeof QUICK_LINK_CATALOG>;
const knownCategoryIds = new Set(categories.map((category) => category.id));
const unsectioned = links.filter((link) => !knownCategoryIds.has(link.categoryId));
const previewSections = categories.map((category, index) => ({
  id: category.id,
  title: category.title,
  index,
  links: links.filter((link) => link.categoryId === category.id),
}));
---

<section class:list={[!embedded && 'mt-10', 'scroll-mt-24']} id="quick-links" aria-labelledby="quick-links-heading">
  {!embedded ? <h2 id="quick-links-heading" class="font-display text-3xl text-charcoal">Quick links</h2> : <h2 id="quick-links-heading" class="sr-only">Quick links</h2>}

  {
    saved ? (
      <>
        <p data-quick-links-saved class="mt-4 rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-900">
          Quick links saved.
        </p>
        <script is:inline>
          (function () {
            var nav = performance.getEntriesByType('navigation')[0];
            if (nav && nav.type === 'reload') {
              var badge = document.querySelector('[data-quick-links-saved]');
              if (badge) badge.remove();
            }
            var params = new URLSearchParams(location.search);
            if (!params.has('quickLinksSaved')) return;
            params.delete('quickLinksSaved');
            var search = params.toString();
            history.replaceState(null, '', location.pathname + (search ? '?' + search : '') + location.hash);
          })();
        </script>
      </>
    ) : null
  }
  {
    error ? (
      <p class="mt-4 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800">{error}</p>
    ) : null
  }

  <div class="mt-6 space-y-6">
    <div data-ql-board>
      <div class="space-y-5">
            {previewSections.map((section) => (
                <section>
                  <div class="flex w-full items-center gap-1.5">
                    <form method="post" action="/api/admin/quick-links">
                      <input type="hidden" name="action" value="move-category" />
                      <input type="hidden" name="categoryId" value={section.id} />
                      <input type="hidden" name="direction" value="up" />
                      <button
                        class="rounded-full px-2.5 py-1 text-xs font-semibold text-sage-dark ring-1 ring-sage-dark/15 hover:bg-white disabled:opacity-40"
                        type="submit"
                        disabled={section.index === 0}
                        aria-label="Move section up"
                      >
                        ↑
                      </button>
                    </form>
                    <form method="post" action="/api/admin/quick-links">
                      <input type="hidden" name="action" value="move-category" />
                      <input type="hidden" name="categoryId" value={section.id} />
                      <input type="hidden" name="direction" value="down" />
                      <button
                        class="rounded-full px-2.5 py-1 text-xs font-semibold text-sage-dark ring-1 ring-sage-dark/15 hover:bg-white disabled:opacity-40"
                        type="submit"
                        disabled={section.index === categories.length - 1}
                        aria-label="Move section down"
                      >
                        ↓
                      </button>
                    </form>
                    <form method="post" action="/api/admin/quick-links" class="flex min-w-0 flex-1 items-center gap-1.5">
                      <input type="hidden" name="action" value="update-category" />
                      <input type="hidden" name="categoryId" value={section.id} />
                      <input
                        data-ql-section-title
                        class="w-auto max-w-full border-0 bg-transparent p-0 font-display text-lg text-charcoal shadow-none outline-none ring-0 read-only:cursor-default"
                        type="text"
                        name="title"
                        required
                        readonly
                        value={section.title}
                        size={Math.max(section.title.length, 1)}
                        aria-label="Section title"
                      />
                      <button
                        type="button"
                        data-ql-section-edit
                        class="shrink-0 rounded-full px-2.5 py-1 text-xs font-semibold text-sage-dark ring-1 ring-sage-dark/15 hover:bg-white"
                      >
                        Edit
                      </button>
                    </form>
                    {
                      categories.length > 1 ? (
                        <form method="post" action="/api/admin/quick-links" class="ml-auto">
                          <input type="hidden" name="action" value="delete-category" />
                          <input type="hidden" name="categoryId" value={section.id} />
                          <input
                            type="hidden"
                            name="moveLinksToCategoryId"
                            value={categories.find((item) => item.id !== section.id)?.id ?? ''}
                          />
                          <button
                            class="shrink-0 rounded-full px-2.5 py-1 text-xs font-semibold text-red-700 ring-1 ring-red-200 hover:bg-red-50"
                            type="submit"
                            onclick="return confirm('Delete this section? Links in it move to another section.')"
                          >
                            Delete
                          </button>
                        </form>
                      ) : null
                    }
                  </div>
                  <div class="mt-3 flex flex-wrap items-start gap-x-3 gap-y-4" data-ql-row={section.id}>
                    {section.links.map((link) => (
                      <button
                        type="button"
                        draggable="true"
                        data-ql-open={link.id}
                        data-ql-drag={link.id}
                        aria-pressed="false"
                        class:list={[
                          'cursor-grab rounded-xl outline-none transition hover:-translate-y-0.5 aria-pressed:ring-2 aria-pressed:ring-sage-dark aria-pressed:ring-offset-2 active:cursor-grabbing [&[data-ql-dragging]]:opacity-40',
                          link.iconSrc
                            ? 'inline-flex w-[4.65rem] flex-col items-center text-center'
                            : 'flex w-36 flex-col border border-sage-dark/10 bg-white p-2.5 text-left shadow-sm',
                          link.enabled ? '' : 'opacity-45 aria-pressed:opacity-100',
                        ]}
                      >
                        {
                          link.iconSrc ? (
                            <img
                              src={link.iconSrc}
                              alt=""
                              draggable="false"
                              class="h-16 w-16 rounded-[0.92rem] bg-white object-contain shadow-[0_6px_14px_rgba(26,28,30,0.16)] ring-1 ring-black/10"
                            />
                          ) : (
                            <span class="text-[10px] uppercase tracking-[0.14em] text-sage-dark/55">{section.title}</span>
                          )
                        }
                        <span class:list={['font-medium leading-tight text-charcoal', link.iconSrc ? 'mt-1.5 text-[11px]' : 'mt-1 font-display text-base']}>
                          {link.name}
                        </span>
                        {link.enabled ? null : <span class="mt-1 text-[10px] font-medium text-sage-dark/60">Hidden</span>}
                      </button>
                    ))}
                    <button
                      type="button"
                      data-ql-add={section.id}
                      aria-pressed="false"
                      aria-label={`Add a link to ${section.title}`}
                      class="inline-flex w-[4.65rem] flex-col items-center rounded-xl text-center outline-none transition hover:-translate-y-0.5 aria-pressed:ring-2 aria-pressed:ring-sage-dark aria-pressed:ring-offset-2"
                    >
                      <span class="flex h-16 w-16 items-center justify-center rounded-[0.92rem] border-2 border-dashed border-sage-dark/30 text-sage-dark/45">
                        <svg width="22" height="22" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                          <path d="M8 3v10M3 8h10" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" />
                        </svg>
                      </span>
                    </button>
                  </div>
                </section>
            ))}
            {
              unsectioned.length > 0 ? (
                <section>
                  <h3 class="font-display text-lg text-charcoal">Other</h3>
                  <div class="mt-3 flex flex-wrap gap-x-3 gap-y-4">
                    {unsectioned.map((link) => (
                      <button
                        type="button"
                        data-ql-open={link.id}
                        aria-pressed="false"
                        class:list={[
                          'rounded-xl outline-none transition hover:-translate-y-0.5 aria-pressed:ring-2 aria-pressed:ring-sage-dark aria-pressed:ring-offset-2',
                          link.iconSrc
                            ? 'inline-flex w-[4.65rem] flex-col items-center text-center'
                            : 'flex w-36 flex-col border border-sage-dark/10 bg-white p-2.5 text-left shadow-sm',
                          link.enabled ? '' : 'opacity-45 aria-pressed:opacity-100',
                        ]}
                      >
                        {
                          link.iconSrc ? (
                            <img
                              src={link.iconSrc}
                              alt=""
                              class="h-16 w-16 rounded-[0.92rem] bg-white object-contain shadow-[0_6px_14px_rgba(26,28,30,0.16)] ring-1 ring-black/10"
                            />
                          ) : (
                            <span class="text-[10px] uppercase tracking-[0.14em] text-sage-dark/55">Other</span>
                          )
                        }
                        <span class:list={['font-medium leading-tight text-charcoal', link.iconSrc ? 'mt-1.5 text-[11px]' : 'mt-1 font-display text-base']}>
                          {link.name}
                        </span>
                        {link.enabled ? null : <span class="mt-1 text-[10px] font-medium text-sage-dark/60">Hidden</span>}
                      </button>
                    ))}
                  </div>
                </section>
              ) : null
            }
            <form method="post" action="/api/admin/quick-links">
              <input type="hidden" name="action" value="create-category" />
              <input type="hidden" name="title" value="New section" />
              <button
                type="submit"
                class="flex w-full items-center justify-center gap-2 rounded-xl border-2 border-dashed border-sage-dark/30 px-3 py-2.5 font-display text-lg text-sage-dark/50 transition hover:-translate-y-0.5"
              >
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                  <path d="M8 3v10M3 8h10" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" />
                </svg>
                Section
              </button>
            </form>
          </div>
      <div hidden data-ql-add-panel class="mt-4 rounded-2xl border border-sage-dark/10 bg-white/90 p-4 shadow-sm">
        <div data-ql-add-choice>
          <div class="grid gap-2 sm:grid-cols-2">
          <button
            type="button"
            data-ql-show-prebuilt
            class="flex items-center justify-center rounded-xl border-2 border-dashed border-sage-dark/30 px-3 py-2.5 font-display text-lg text-sage-dark/70 transition hover:-translate-y-0.5"
          >
            Prebuilt
          </button>
          <button
            type="button"
            data-ql-show-custom
            class="flex items-center justify-center rounded-xl border-2 border-dashed border-sage-dark/30 px-3 py-2.5 font-display text-lg text-sage-dark/70 transition hover:-translate-y-0.5"
          >
            Custom
          </button>
          </div>
        </div>
        <div hidden data-ql-add-catalog>
          <form method="post" action="/api/admin/quick-links" class="space-y-2" data-catalog-add>
            <input type="hidden" name="action" value="add-from-catalog" />
            <button
              class="text-xs font-medium text-sage-dark/70 underline-offset-2 hover:underline"
              type="button"
              data-ql-show-choice
            >
              Back
            </button>
            <div class="flex flex-wrap items-center gap-1.5">
              <select class="field min-w-[9rem] flex-1" name="catalogGroup" data-catalog-group required aria-label="Category">
                <option value="">Category</option>
                {
                  QUICK_LINK_CATALOG_GROUPS.map((group) => (
                    <option value={group.id}>{group.title}</option>
                  ))
                }
              </select>
              <select class="field min-w-[9rem] flex-1" name="catalogKey" data-catalog-tool required disabled aria-label="Tool">
                <option value="">Tool</option>
              </select>
              <input type="hidden" name="categoryId" value="" />
              <button class="shrink-0 rounded-full bg-brand px-3 py-1.5 text-xs font-semibold text-onbrand" type="submit">Add</button>
            </div>
            <details class="group/ql" data-ql-visibility>
              <summary class="flex w-fit max-w-full cursor-pointer list-none items-center gap-1.5 rounded-full px-3 py-1.5 text-xs font-semibold text-sage-dark ring-1 ring-sage-dark/15 hover:bg-white [&::-webkit-details-marker]:hidden">
                Limit who can see it
                <span data-ql-visibility-state class="font-medium text-sage-dark/55">· Everyone</span>
                <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true" class="shrink-0 transition group-open/ql:rotate-180">
                  <path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </summary>
              <div class="mt-2 flex flex-wrap gap-x-4 gap-y-2">
                {
                  roles.map((role) => (
                    <label class="inline-flex items-center gap-2 text-sm text-charcoal">
                      <input type="checkbox" name="roleKeys" value={role.key} />
                      {role.name}
                    </label>
                  ))
                }
              </div>
              <p class="mt-1.5 text-[11px] text-sage-dark/55">Leave unchecked and everyone can see it. Owners always see every link.</p>
            </details>
          </form>
        </div>
        <form hidden method="post" action="/api/admin/quick-links" class="space-y-2" data-ql-custom-fields>
          <input type="hidden" name="action" value="create-custom" />
          <input type="hidden" name="enabled" value="1" />
          <input type="hidden" name="categoryId" value="" />
          <button
            class="text-xs font-medium text-sage-dark/70 underline-offset-2 hover:underline"
            type="button"
            data-ql-show-choice
          >
            Back
          </button>
          <div class="grid gap-2 sm:grid-cols-2">
            <input class="field" type="text" name="name" required placeholder="Name" aria-label="Name" />
            <input class="field" type="url" name="href" required placeholder="https://" aria-label="URL" />
          </div>
          <label class="flex cursor-pointer flex-col items-center justify-center gap-1 rounded-xl border-2 border-dashed border-sage-dark/30 px-3 py-4 text-center transition hover:-translate-y-0.5">
            <img data-ql-icon-preview alt="" hidden class="mb-1 h-16 w-16 rounded-[0.92rem] bg-white object-contain" />
            <span data-ql-icon-caption class="text-sm font-medium text-sage-dark">Add your own image</span>
            <span class="text-[11px] text-sage-dark/55">Photos open a square crop for the thumbnail. Leave this empty and the website’s icon is used when you save.</span>
            <input data-ql-icon-file class="sr-only" type="file" name="icon" accept="image/png,image/jpeg,image/webp,image/gif" />
          </label>
          <details class="group/ql" data-ql-visibility>
            <summary class="flex w-fit max-w-full cursor-pointer list-none items-center gap-1.5 rounded-full px-3 py-1.5 text-xs font-semibold text-sage-dark ring-1 ring-sage-dark/15 hover:bg-white [&::-webkit-details-marker]:hidden">
              Limit who can see it
              <span data-ql-visibility-state class="font-medium text-sage-dark/55">· Everyone</span>
              <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true" class="shrink-0 transition group-open/ql:rotate-180">
                <path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </summary>
            <div class="mt-2 flex flex-wrap gap-x-4 gap-y-2">
              {
                roles.map((role) => (
                  <label class="inline-flex items-center gap-2 text-sm text-charcoal">
                    <input type="checkbox" name="roleKeys" value={role.key} />
                    {role.name}
                  </label>
                ))
              }
            </div>
            <p class="mt-1.5 text-[11px] text-sage-dark/55">Leave unchecked and everyone can see it. Owners always see every link.</p>
          </details>
          <div class="flex justify-end">
            <button class="rounded-full bg-brand px-3 py-1.5 text-xs font-semibold text-onbrand" type="submit">Add</button>
          </div>
        </form>
      </div>
      {
        links.length === 0 ? null : (
          <dialog
            data-ql-dialog
            class="relative max-h-[min(40rem,calc(100%-2rem))] w-[min(36rem,calc(100%-2rem))] overflow-y-auto rounded-2xl border border-sage-dark/10 bg-white p-4 shadow-xl [&::backdrop]:bg-charcoal/35"
          >
            <button
              type="button"
              data-ql-dialog-close
              class="absolute right-3 top-3 rounded-full px-2 py-1 text-sm text-sage-dark/50 hover:bg-sage-dark/5 hover:text-charcoal"
              aria-label="Close"
            >
              ×
            </button>
            {links.map((link) => {
              const formId = `quick-link-${link.id}`;
              return (
                <div hidden data-ql-editor={link.id} class="pr-6">
                  <p class="text-sm font-semibold text-charcoal">{link.name}</p>
                  <form id={formId} method="post" action="/api/admin/quick-links" class="mt-3 space-y-2">
                    <input type="hidden" name="action" value="update-custom" />
                    <input type="hidden" name="linkId" value={link.id} />
                    <div class="grid gap-2 sm:grid-cols-2">
                      <input class="field" type="text" name="name" required value={link.name} aria-label="Name" />
                      <input class="field" type="url" name="href" required value={link.href} aria-label="URL" />
                    </div>
                    <input type="hidden" name="categoryId" value={link.categoryId} />
                    <label class="flex cursor-pointer flex-col items-center justify-center gap-1 rounded-xl border-2 border-dashed border-sage-dark/30 px-3 py-4 text-center transition hover:-translate-y-0.5">
                      <img
                        data-ql-icon-preview
                        src={link.iconSrc || undefined}
                        alt=""
                        hidden={!link.iconSrc}
                        class="mb-1 h-16 w-16 rounded-[0.92rem] bg-white object-contain"
                      />
                      <span data-ql-icon-caption class="text-sm font-medium text-sage-dark">
                        {link.iconSrc ? 'Replace image' : 'Add your own image'}
                      </span>
                      <span class="text-[11px] text-sage-dark/55">Photos open a square crop for the thumbnail. Leave this empty to keep the current icon.</span>
                      <input data-ql-icon-file class="sr-only" type="file" name="icon" accept="image/png,image/jpeg,image/webp,image/gif" />
                    </label>
                    <input type="hidden" name="useSiteIcon" value="" data-ql-use-site-icon />
                    <button
                      type="button"
                      data-ql-use-site
                      class="block text-left text-xs font-medium text-sage-dark/70 underline-offset-2 hover:underline"
                    >
                      Use the website’s icon
                    </button>
                    <label class="flex items-center gap-2 text-sm text-charcoal">
                      <input type="checkbox" name="enabled" value="1" checked={link.enabled} />
                      Visible
                    </label>
                    <details class="group/ql">
                      <summary class="flex w-fit cursor-pointer list-none items-center gap-1.5 rounded-full px-3 py-1.5 text-xs font-semibold text-sage-dark ring-1 ring-sage-dark/15 hover:bg-white [&::-webkit-details-marker]:hidden">
                        Edit roles
                        <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true" class="transition group-open/ql:rotate-180">
                          <path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                      </summary>
                      <div class="mt-2 flex flex-wrap gap-x-4 gap-y-2">
                        {roles.map((role) => (
                          <label class="inline-flex items-center gap-2 text-sm text-charcoal">
                            <input type="checkbox" name="roleKeys" value={role.key} checked={link.roleKeys.includes(role.key)} />
                            {role.name}
                          </label>
                        ))}
                      </div>
                      <p class="mt-1.5 text-[11px] text-sage-dark/55">Leave unchecked to show everyone. Owners always see every link.</p>
                    </details>
                  </form>
                  <div class="mt-3 flex justify-end gap-2">
                    <form method="post" action="/api/admin/quick-links">
                      <input type="hidden" name="action" value="delete-custom" />
                      <input type="hidden" name="linkId" value={link.id} />
                      <button
                        class="rounded-full px-3 py-1.5 text-xs font-semibold text-red-700 ring-1 ring-red-200 hover:bg-red-50"
                        type="submit"
                        onclick="return confirm('Remove this quick link?')"
                      >
                        Remove
                      </button>
                    </form>
                    <button class="rounded-full bg-brand px-3 py-1.5 text-xs font-semibold text-onbrand" type="submit" form={formId}>
                      Save
                    </button>
                  </div>
                </div>
              );
            })}
          </dialog>
        )
      }
      <dialog
        data-ql-crop
        class="w-[min(22rem,calc(100%-2rem))] rounded-2xl border border-sage-dark/10 bg-white p-4 shadow-xl [&::backdrop]:bg-charcoal/45"
      >
        <form method="dialog" class="space-y-3">
          <div class="flex items-start justify-between gap-3">
            <div>
              <h3 class="font-display text-xl text-charcoal">Crop thumbnail</h3>
              <p class="mt-1 text-xs leading-snug text-sage-dark/70">Drag the photo and zoom so the square matches the quick link.</p>
            </div>
            <button
              type="submit"
              value="cancel"
              class="rounded-full px-2 py-1 text-sm text-sage-dark/50 hover:bg-sage-dark/5 hover:text-charcoal"
              aria-label="Cancel crop"
            >
              ×
            </button>
          </div>
          <div
            data-ql-crop-stage
            class="relative mx-auto h-72 w-72 cursor-grab overflow-hidden rounded-[0.92rem] bg-sage-dark/5 touch-none active:cursor-grabbing"
          >
            <img data-ql-crop-image alt="" draggable="false" class="pointer-events-none absolute left-0 top-0 max-w-none select-none" />
          </div>
          <label class="flex items-center gap-3 text-xs font-semibold text-sage-dark">
            Zoom
            <input data-ql-crop-zoom class="w-full accent-sage-dark" type="range" min="1" max="4" step="0.01" value="1" />
          </label>
          <div class="flex justify-end gap-2">
            <button type="submit" value="cancel" class="rounded-full px-3 py-1.5 text-xs font-semibold text-sage-dark ring-1 ring-sage-dark/20">
              Cancel
            </button>
            <button
              type="submit"
              value="apply"
              data-ql-crop-apply
              class="rounded-full bg-brand px-3 py-1.5 text-xs font-semibold text-onbrand"
            >
              Use crop
            </button>
          </div>
        </form>
      </dialog>
      <script type="application/json" data-ql-catalog is:inline set:html={JSON.stringify({ catalogByGroup, addedCatalogKeys: [...addedCatalogKeys] })}></script>
      <script is:inline>
        window.initQuickLinks = function () {
          var section = document.getElementById('quick-links');
          var root = section && section.querySelector('[data-ql-board]');
          if (!section || !root || section.getAttribute('data-ql-bound') === '1') return;
          section.setAttribute('data-ql-bound', '1');
          var buttons = root.querySelectorAll('[data-ql-open]');
          var panels = root.querySelectorAll('[data-ql-editor]');
          var dialog = root.querySelector('[data-ql-dialog]');
          var addButtons = root.querySelectorAll('[data-ql-add]');
          var addPanel = root.querySelector('[data-ql-add-panel]');
          var addChoice = root.querySelector('[data-ql-add-choice]');
          var catalogChoice = root.querySelector('[data-ql-add-catalog]');
          var customFields = root.querySelector('[data-ql-custom-fields]');

          function showAddStep(step) {
            if (addChoice) addChoice.hidden = step !== 'choice';
            if (catalogChoice) catalogChoice.hidden = step !== 'prebuilt';
            if (customFields) customFields.hidden = step !== 'custom';
          }

          function closeAdd() {
            addButtons.forEach(function (item) {
              item.setAttribute('aria-pressed', 'false');
            });
            if (addPanel) addPanel.hidden = true;
            showAddStep('choice');
          }

          function closeEditors() {
            buttons.forEach(function (item) {
              item.setAttribute('aria-pressed', 'false');
            });
            panels.forEach(function (panel) {
              panel.hidden = true;
            });
            if (dialog && dialog.open) dialog.close();
          }

          buttons.forEach(function (button) {
            button.addEventListener('click', function () {
              if (button.getAttribute('data-ql-did-drag') === '1') {
                button.removeAttribute('data-ql-did-drag');
                return;
              }
              var id = button.getAttribute('data-ql-open');
              var already = button.getAttribute('aria-pressed') === 'true';
              closeAdd();
              closeEditors();
              if (already) return;
              button.setAttribute('aria-pressed', 'true');
              panels.forEach(function (panel) {
                if (panel.getAttribute('data-ql-editor') === id) panel.hidden = false;
              });
              if (dialog && typeof dialog.showModal === 'function' && !dialog.open) dialog.showModal();
            });
          });

          if (dialog) {
            dialog.addEventListener('click', function (event) {
              if (event.target === dialog) dialog.close();
            });
            dialog.addEventListener('close', function () {
              buttons.forEach(function (item) {
                item.setAttribute('aria-pressed', 'false');
              });
              panels.forEach(function (panel) {
                panel.hidden = true;
              });
            });
            var dialogClose = dialog.querySelector('[data-ql-dialog-close]');
            if (dialogClose) {
              dialogClose.addEventListener('click', function () {
                dialog.close();
              });
            }
          }

          addButtons.forEach(function (addButton) {
            addButton.addEventListener('click', function () {
              var already = addButton.getAttribute('aria-pressed') === 'true';
              var sectionId = addButton.getAttribute('data-ql-add') || '';
              closeEditors();
              if (already) {
                closeAdd();
                return;
              }
              closeAdd();
              addButton.setAttribute('aria-pressed', 'true');
              var section = addButton.closest('section');
              if (section && addPanel) section.appendChild(addPanel);
              if (addPanel) {
                addPanel.hidden = false;
                addPanel.querySelectorAll('[name="categoryId"]').forEach(function (field) {
                  if (field instanceof HTMLInputElement || field instanceof HTMLSelectElement) field.value = sectionId;
                });
                if (addPanel.scrollIntoView) addPanel.scrollIntoView({ block: 'nearest' });
              }
              showAddStep('choice');
            });
          });

          root.querySelectorAll('[data-ql-show-prebuilt]').forEach(function (button) {
            button.addEventListener('click', function () {
              showAddStep('prebuilt');
            });
          });
          root.querySelectorAll('[data-ql-show-custom]').forEach(function (button) {
            button.addEventListener('click', function () {
              showAddStep('custom');
            });
          });
          root.querySelectorAll('[data-ql-show-choice]').forEach(function (button) {
            button.addEventListener('click', function () {
              showAddStep('choice');
            });
          });

          root.querySelectorAll('[data-ql-section-edit]').forEach(function (button) {
            button.addEventListener('click', function () {
              var form = button.closest('form');
              var title = form ? form.querySelector('[data-ql-section-title]') : null;
              if (!(title instanceof HTMLInputElement)) return;
              title.readOnly = false;
              title.focus();
              title.select();
            });
          });
          root.querySelectorAll('[data-ql-section-title]').forEach(function (title) {
            title.addEventListener('input', function () {
              if (!(title instanceof HTMLInputElement)) return;
              title.size = Math.max(title.value.length, 1);
            });
            title.addEventListener('keydown', function (event) {
              if (!(title instanceof HTMLInputElement)) return;
              if (event.key === 'Enter') {
                event.preventDefault();
                title.blur();
              } else if (event.key === 'Escape') {
                event.preventDefault();
                title.value = title.defaultValue;
                title.size = Math.max(title.value.length, 1);
                title.blur();
              }
            });
            title.addEventListener('blur', function () {
              if (!(title instanceof HTMLInputElement) || title.readOnly) return;
              var next = title.value.trim();
              title.readOnly = true;
              if (!next || next.length > 80) {
                title.value = title.defaultValue;
                title.size = Math.max(title.value.length, 1);
                return;
              }
              title.value = next;
              title.size = Math.max(next.length, 1);
              if (next === title.defaultValue) return;
              var form = title.closest('form');
              if (form instanceof HTMLFormElement) form.requestSubmit();
            });
          });

          root.querySelectorAll('[data-ql-visibility]').forEach(function (details) {
            var sync = function () {
              var state = details.querySelector('[data-ql-visibility-state]');
              if (!state) return;
              var names = [];
              details.querySelectorAll('input[name="roleKeys"]:checked').forEach(function (input) {
                var label = input.closest('label');
                var text = label ? label.textContent.replace(/\s+/g, ' ').trim() : '';
                if (text) names.push(text);
              });
              state.textContent = names.length ? '· ' + names.join(', ') : '· Everyone';
            };
            details.addEventListener('change', sync);
            sync();
          });

          var cropDialog = root.querySelector('[data-ql-crop]');
          var cropStage = root.querySelector('[data-ql-crop-stage]');
          var cropImage = root.querySelector('[data-ql-crop-image]');
          var cropZoom = root.querySelector('[data-ql-crop-zoom]');
          var cropApply = root.querySelector('[data-ql-crop-apply]');
          var cropSession = null;

          function cropCoverScale() {
            var size = cropStage.clientWidth || 288;
            return Math.max(size / cropSession.nw, size / cropSession.nh) * cropSession.zoom;
          }

          function clampCrop() {
            var size = cropStage.clientWidth || 288;
            var scale = cropCoverScale();
            var minX = size - cropSession.nw * scale;
            var minY = size - cropSession.nh * scale;
            cropSession.x = Math.min(0, Math.max(minX, cropSession.x));
            cropSession.y = Math.min(0, Math.max(minY, cropSession.y));
          }

          function paintCrop() {
            if (!cropSession || !(cropImage instanceof HTMLImageElement) || !(cropStage instanceof HTMLElement)) return;
            clampCrop();
            var scale = cropCoverScale();
            cropImage.style.width = cropSession.nw * scale + 'px';
            cropImage.style.height = cropSession.nh * scale + 'px';
            cropImage.style.left = cropSession.x + 'px';
            cropImage.style.top = cropSession.y + 'px';
          }

          function setCropZoom(next) {
            if (!cropSession) return;
            var size = cropStage.clientWidth || 288;
            var prev = cropCoverScale();
            var focusX = (size / 2 - cropSession.x) / prev;
            var focusY = (size / 2 - cropSession.y) / prev;
            cropSession.zoom = Math.min(4, Math.max(1, next));
            var scale = cropCoverScale();
            cropSession.x = size / 2 - focusX * scale;
            cropSession.y = size / 2 - focusY * scale;
            if (cropZoom instanceof HTMLInputElement) cropZoom.value = String(cropSession.zoom);
            paintCrop();
          }

          function restoreIconPreview(session) {
            var preview = session.preview;
            var caption = session.caption;
            if (preview instanceof HTMLImageElement) {
              if (session.prevSrc) preview.src = session.prevSrc;
              else preview.removeAttribute('src');
              preview.hidden = session.prevHidden;
            }
            if (caption) caption.textContent = session.prevCaption;
          }

          function assignIconFile(input, file) {
            var transfer = new DataTransfer();
            transfer.items.add(file);
            input.dataset.qlCropApplied = '1';
            input.files = transfer.files;
            setTimeout(function () {
              delete input.dataset.qlCropApplied;
            }, 0);
          }

          function restoreCommittedFile(input) {
            if (!(input instanceof HTMLInputElement)) return;
            var committed = input._qlCroppedFile;
            if (committed) {
              assignIconFile(input, committed);
              return;
            }
            input.value = '';
          }

          function closeCrop() {
            if (!cropSession) return;
            var session = cropSession;
            cropSession = null;
            restoreCommittedFile(session.input);
            restoreIconPreview(session);
            URL.revokeObjectURL(session.url);
          }

          function exportCrop(session, done) {
            var sizes = [512, 384, 256];
            var qualities = [0.9, 0.8, 0.7, 0.6];
            var view = cropStage.clientWidth || 288;
            var scale = Math.max(view / session.nw, view / session.nh) * session.zoom;
            var sx = -session.x / scale;
            var sy = -session.y / scale;
            var sw = view / scale;
            function attempt(sizeIndex, qualityIndex) {
              var px = sizes[sizeIndex];
              var canvas = document.createElement('canvas');
              canvas.width = px;
              canvas.height = px;
              var ctx = canvas.getContext('2d');
              if (!ctx || !(cropImage instanceof HTMLImageElement)) {
                done(null);
                return;
              }
              ctx.fillStyle = '#ffffff';
              ctx.fillRect(0, 0, px, px);
              ctx.drawImage(cropImage, sx, sy, sw, sw, 0, 0, px, px);
              canvas.toBlob(
                function (blob) {
                  if (!blob) {
                    done(null);
                    return;
                  }
                  if (blob.size <= 500000 || (sizeIndex === sizes.length - 1 && qualityIndex === qualities.length - 1)) {
                    done(blob);
                    return;
                  }
                  if (qualityIndex + 1 < qualities.length) attempt(sizeIndex, qualityIndex + 1);
                  else attempt(sizeIndex + 1, 0);
                },
                'image/jpeg',
                qualities[qualityIndex],
              );
            }
            attempt(0, 0);
          }

          function finishCrop() {
            if (!cropSession || !(cropDialog instanceof HTMLDialogElement)) return;
            var session = cropSession;
            cropSession = null;
            if (cropApply instanceof HTMLButtonElement) cropApply.disabled = true;
            exportCrop(session, function (blob) {
              if (cropApply instanceof HTMLButtonElement) cropApply.disabled = false;
              if (!blob || !(session.input instanceof HTMLInputElement)) {
                restoreCommittedFile(session.input);
                restoreIconPreview(session);
                URL.revokeObjectURL(session.url);
                if (cropDialog.open) cropDialog.close();
                return;
              }
              var base = session.file.name.replace(/\.[^.]+$/, '') || 'thumbnail';
              var cropped = new File([blob], base + '.jpg', { type: 'image/jpeg', lastModified: Date.now() });
              session.input._qlCroppedFile = cropped;
              assignIconFile(session.input, cropped);
              if (session.preview instanceof HTMLImageElement) {
                if (session.prevSrc.indexOf('blob:') === 0) URL.revokeObjectURL(session.prevSrc);
                session.preview.src = URL.createObjectURL(cropped);
                session.preview.hidden = false;
              }
              if (session.caption) session.caption.textContent = 'Cropped thumbnail';
              var flag = session.form && session.form.querySelector('[data-ql-use-site-icon]');
              if (flag instanceof HTMLInputElement) flag.value = '';
              URL.revokeObjectURL(session.url);
              if (cropDialog.open) cropDialog.close();
            });
          }

          function openCrop(input, file) {
            if (!(cropDialog instanceof HTMLDialogElement) || !(cropImage instanceof HTMLImageElement) || !(cropStage instanceof HTMLElement)) return;
            var label = input.closest('label');
            var preview = label && label.querySelector('[data-ql-icon-preview]');
            var caption = label && label.querySelector('[data-ql-icon-caption]');
            var url = URL.createObjectURL(file);
            var session = {
              input: input,
              form: input.closest('form'),
              file: file,
              url: url,
              preview: preview,
              caption: caption,
              prevSrc: preview instanceof HTMLImageElement ? preview.getAttribute('src') || '' : '',
              prevHidden: !(preview instanceof HTMLImageElement) || preview.hidden,
              prevCaption: caption ? caption.textContent : '',
              nw: 0,
              nh: 0,
              zoom: 1,
              x: 0,
              y: 0,
            };
            cropImage.onload = function () {
              session.nw = cropImage.naturalWidth;
              session.nh = cropImage.naturalHeight;
              if (!session.nw || !session.nh) {
                URL.revokeObjectURL(url);
                restoreCommittedFile(input);
                return;
              }
              cropSession = session;
              session.zoom = 1;
              if (cropZoom instanceof HTMLInputElement) cropZoom.value = '1';
              document.querySelectorAll('[data-ql-crop]').forEach(function (node) {
                if (node !== cropDialog) node.remove();
              });
              document.body.appendChild(cropDialog);
              var size = cropStage.clientWidth || 288;
              var scale = Math.max(size / session.nw, size / session.nh);
              session.x = (size - session.nw * scale) / 2;
              session.y = (size - session.nh * scale) / 2;
              paintCrop();
              if (!cropDialog.open) cropDialog.showModal();
              requestAnimationFrame(function () {
                if (cropSession !== session || session.moved || session.zoom !== 1) return;
                var fitted = cropStage.clientWidth || size;
                var fittedScale = Math.max(fitted / session.nw, fitted / session.nh);
                session.x = (fitted - session.nw * fittedScale) / 2;
                session.y = (fitted - session.nh * fittedScale) / 2;
                paintCrop();
              });
            };
            cropImage.onerror = function () {
              URL.revokeObjectURL(url);
              restoreCommittedFile(input);
              if (caption) caption.textContent = 'Could not open that image.';
            };
            cropImage.src = url;
          }

          if (cropStage instanceof HTMLElement) {
            cropStage.addEventListener('pointerdown', function (event) {
              if (!cropSession || event.button !== 0) return;
              cropStage.setPointerCapture(event.pointerId);
              cropSession.dragX = event.clientX;
              cropSession.dragY = event.clientY;
              cropSession.dragging = true;
            });
            cropStage.addEventListener('pointermove', function (event) {
              if (!cropSession || !cropSession.dragging) return;
              cropSession.moved = true;
              cropSession.x += event.clientX - cropSession.dragX;
              cropSession.y += event.clientY - cropSession.dragY;
              cropSession.dragX = event.clientX;
              cropSession.dragY = event.clientY;
              paintCrop();
            });
            function endCropDrag(event) {
              if (!cropSession || !cropSession.dragging) return;
              cropSession.dragging = false;
              if (cropStage.hasPointerCapture(event.pointerId)) cropStage.releasePointerCapture(event.pointerId);
            }
            cropStage.addEventListener('pointerup', endCropDrag);
            cropStage.addEventListener('pointercancel', endCropDrag);
            cropStage.addEventListener(
              'wheel',
              function (event) {
                if (!cropSession) return;
                event.preventDefault();
                setCropZoom(cropSession.zoom * (event.deltaY < 0 ? 1.06 : 0.94));
              },
              { passive: false },
            );
          }
          if (cropZoom instanceof HTMLInputElement) {
            cropZoom.addEventListener('input', function () {
              setCropZoom(Number(cropZoom.value));
            });
          }
          if (cropDialog instanceof HTMLDialogElement) {
            var cropForm = cropDialog.querySelector('form');
            if (cropForm) {
              cropForm.addEventListener('submit', function (event) {
                var submitter = event.submitter;
                if (submitter instanceof HTMLButtonElement && submitter.value === 'apply') {
                  event.preventDefault();
                  finishCrop();
                  return;
                }
                closeCrop();
              });
            }
            cropDialog.addEventListener('close', function () {
              closeCrop();
            });
          }

          root.querySelectorAll('[data-ql-icon-file]').forEach(function (input) {
            input.addEventListener('change', function () {
              if (!(input instanceof HTMLInputElement)) return;
              if (input.dataset.qlCropApplied === '1') {
                delete input.dataset.qlCropApplied;
                return;
              }
              var file = input.files && input.files[0];
              if (!file) return;
              var committed = input._qlCroppedFile;
              if (
                committed &&
                file.name === committed.name &&
                file.size === committed.size &&
                file.lastModified === committed.lastModified
              ) {
                return;
              }
              if (!file.type || file.type.indexOf('image/') !== 0) {
                input.value = '';
                return;
              }
              openCrop(input, file);
            });
          });
          root.querySelectorAll('[data-ql-use-site]').forEach(function (button) {
            button.addEventListener('click', function () {
              var form = button.closest('form');
              if (!form) return;
              var flag = form.querySelector('[data-ql-use-site-icon]');
              var file = form.querySelector('[data-ql-icon-file]');
              var preview = form.querySelector('[data-ql-icon-preview]');
              var caption = form.querySelector('[data-ql-icon-caption]');
              if (flag instanceof HTMLInputElement) flag.value = '1';
              if (file instanceof HTMLInputElement) {
                delete file._qlCroppedFile;
                file.value = '';
              }
              if (preview instanceof HTMLImageElement) preview.hidden = true;
              if (caption) caption.textContent = 'Will use the website’s icon';
            });
          });

          var catalogEl = section.querySelector('[data-ql-catalog]');
          var catalogForm = root.querySelector('[data-catalog-add]');
          if (catalogEl && catalogForm) {
            var catalogData = {};
            try {
              catalogData = JSON.parse(catalogEl.textContent || '{}');
            } catch (error) {
              catalogData = {};
            }
            var groupSelect = catalogForm.querySelector('[data-catalog-group]');
            var toolSelect = catalogForm.querySelector('[data-catalog-tool]');
            if (groupSelect instanceof HTMLSelectElement && toolSelect instanceof HTMLSelectElement) {
              var added = Array.isArray(catalogData.addedCatalogKeys) ? catalogData.addedCatalogKeys : [];
              var fillTools = function () {
                var group = groupSelect.value;
                var items = (catalogData.catalogByGroup && catalogData.catalogByGroup[group]) || [];
                toolSelect.innerHTML = '';
                var placeholder = document.createElement('option');
                placeholder.value = '';
                placeholder.textContent = items.length ? 'Tool' : 'No tools';
                toolSelect.appendChild(placeholder);
                items.forEach(function (item) {
                  var opt = document.createElement('option');
                  opt.value = item.key;
                  opt.textContent = added.indexOf(item.key) >= 0 ? item.name + ' (already added)' : item.name;
                  if (added.indexOf(item.key) >= 0) opt.disabled = true;
                  toolSelect.appendChild(opt);
                });
                toolSelect.disabled = !group || items.length === 0;
              };
              groupSelect.addEventListener('change', fillTools);
              fillTools();
            }
          }

          function rowLinkIds(row) {
            var ids = [];
            row.querySelectorAll('[data-ql-drag]').forEach(function (item) {
              var id = item.getAttribute('data-ql-drag');
              if (id) ids.push(id);
            });
            return ids;
          }

          function placeDragged(row, target, clientX) {
            var from = row.querySelector('[data-ql-dragging]');
            if (!from || from === target) return;
            var rect = target.getBoundingClientRect();
            var after = clientX > rect.left + rect.width / 2;
            if (after) target.after(from);
            else target.before(from);
          }

          root.querySelectorAll('[data-ql-row]').forEach(function (row) {
            var orderBefore = '';
            row.querySelectorAll('[data-ql-drag]').forEach(function (button) {
              button.addEventListener('dragstart', function (event) {
                orderBefore = rowLinkIds(row).join(',');
                button.setAttribute('data-ql-dragging', '');
                button.setAttribute('data-ql-did-drag', '1');
                closeAdd();
                closeEditors();
                if (event.dataTransfer) {
                  event.dataTransfer.effectAllowed = 'move';
                  event.dataTransfer.setData('text/plain', button.getAttribute('data-ql-drag') || '');
                }
              });
              button.addEventListener('dragover', function (event) {
                if (!row.querySelector('[data-ql-dragging]')) return;
                event.preventDefault();
                placeDragged(row, button, event.clientX);
              });
              button.addEventListener('drop', function (event) {
                event.preventDefault();
              });
              button.addEventListener('dragend', function () {
                button.removeAttribute('data-ql-dragging');
                var next = rowLinkIds(row).join(',');
                if (!next || next === orderBefore) return;
                var body = new FormData();
                body.set('action', 'reorder-links');
                body.set('categoryId', row.getAttribute('data-ql-row') || '');
                rowLinkIds(row).forEach(function (id) {
                  body.append('linkIds', id);
                });
                postQuickLinks(body);
              });
            });
            var addSquare = row.querySelector('[data-ql-add]');
            if (addSquare) {
              addSquare.addEventListener('dragover', function (event) {
                var from = row.querySelector('[data-ql-dragging]');
                if (!from) return;
                event.preventDefault();
                if (addSquare.previousElementSibling !== from) addSquare.before(from);
              });
              addSquare.addEventListener('drop', function (event) {
                event.preventDefault();
              });
            }
          });

          function postQuickLinks(body, submitter) {
            fetch('/api/admin/quick-links', {
              method: 'POST',
              body: body,
              credentials: 'same-origin',
              headers: { 'X-Quick-Links-Fetch': '1', Accept: 'application/json' },
            })
              .then(function (res) {
                return res.text().then(function (text) {
                  var data = null;
                  try {
                    data = JSON.parse(text);
                  } catch (error) {
                    data = null;
                  }
                  if (!data || typeof data !== 'object') {
                    throw new Error('Could not save quick links.');
                  }
                  return { ok: res.ok && data.ok, error: data.error };
                });
              })
              .then(function (result) {
                if (!result.ok) throw new Error(result.error || 'Could not save quick links.');
                return fetch(location.pathname, {
                  credentials: 'same-origin',
                  cache: 'no-store',
                  headers: { Accept: 'text/html' },
                });
              })
              .then(function (res) {
                if (!res.ok) throw new Error('Saved, but the preview could not refresh.');
                return res.text();
              })
              .then(function (html) {
                var doc = new DOMParser().parseFromString(html, 'text/html');
                var next = doc.getElementById('quick-links');
                var current = document.getElementById('quick-links');
                if (!next || !current || !current.parentNode) throw new Error('Saved, but the preview could not refresh.');
                var openDialog = current.querySelector('[data-ql-dialog]');
                if (openDialog && openDialog.open) openDialog.close();
                current.parentNode.replaceChild(document.importNode(next, true), current);
                if (window.initQuickLinks) window.initQuickLinks();
              })
              .catch(function (error) {
                if (submitter instanceof HTMLButtonElement) submitter.disabled = false;
                var current = document.getElementById('quick-links');
                if (!current) return;
                var note = current.querySelector('[data-ql-error]');
                if (!note) {
                  note = document.createElement('p');
                  note.setAttribute('data-ql-error', '');
                  note.className = 'mt-4 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800';
                  var board = current.querySelector('[data-ql-board]');
                  if (board && board.parentNode) board.parentNode.insertBefore(note, board);
                  else current.appendChild(note);
                }
                note.textContent = error instanceof Error ? error.message : 'Could not save quick links.';
              });
          }

          section.addEventListener('submit', function (event) {
            var form = event.target;
            if (!(form instanceof HTMLFormElement)) return;
            if (form.getAttribute('action') !== '/api/admin/quick-links') return;
            event.preventDefault();
            var submitter = event.submitter;
            if (submitter instanceof HTMLButtonElement) submitter.disabled = true;
            postQuickLinks(new FormData(form), submitter);
          });
        };
        window.initQuickLinks();
      </script>
    </div>
  </div>
</section>
