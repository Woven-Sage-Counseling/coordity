---
---

<aside
  class="flex h-full min-h-[28rem] flex-col overflow-hidden rounded-[1.05rem] shadow-[0_12px_32px_rgba(26,28,30,0.12)] ring-1 ring-black/10"
  aria-labelledby="home-coming-soon-heading"
>
  <div class="bg-accent px-3 py-2.5 text-charcoal">
    <div class="flex items-center gap-2">
      <span
        class="flex h-7 w-7 items-center justify-center rounded-md bg-white/50 text-charcoal ring-1 ring-black/10"
        aria-hidden="true"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
          <path
            d="M12 6v6l4 2"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
          <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.75" />
        </svg>
      </span>
      <h2 id="home-coming-soon-heading" class="text-sm font-semibold leading-none">Coming soon</h2>
    </div>
  </div>

  <div class="flex flex-1 flex-col bg-[#f4f5f8] px-4 pb-4 pt-3 font-sans text-[#393a3d]">
    <div>
      <p class="text-[11px] font-semibold uppercase tracking-[0.14em] text-[#6b6c72]">Widget</p>
      <p class="mt-1 text-base font-semibold leading-tight">Placeholder</p>
      <p class="mt-1 text-[11px] text-[#6b6c72]">
        A new home widget will land here. Use Settings to reorder or hide this card.
      </p>
    </div>

    <div class="mt-4 flex flex-1 flex-col justify-end">
      <div class="rounded-lg bg-white p-4 shadow-sm ring-1 ring-black/[0.06]">
        <div class="space-y-2.5">
          <div class="h-2.5 w-3/4 rounded-full bg-[#e3e5e8]"></div>
          <div class="h-2.5 w-full rounded-full bg-[#e3e5e8]"></div>
          <div class="h-2.5 w-5/6 rounded-full bg-[#e3e5e8]"></div>
        </div>
        <p class="mt-4 text-center text-xs font-medium text-[#6b6c72]">More tools coming soon</p>
      </div>
    </div>
  </div>
</aside>
