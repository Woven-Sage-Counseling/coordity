                                  <div class="flex items-end">
                                    <button class="btn-primary !px-3 !py-2 text-xs" type="submit">
                                      Add question
                                    </button>
                                  </div>
                                </form>
                              </div>
                            ) : null}

                            <div class="mt-3 flex justify-end gap-1" data-training-block-move>
                              <form method="post" action="/api/training/admin" data-training-move-block>
                                <input type="hidden" name="action" value="move-block" />
                                <input type="hidden" name="moduleId" value={selected.id} />
                                <input type="hidden" name="lessonId" value={selectedItem.id} />
                                <input type="hidden" name="blockId" value={block.id} />
                                <input type="hidden" name="direction" value="up" />
                                <button
                                  class="inline-flex h-8 w-8 items-center justify-center rounded-full border border-sage-dark/20 bg-white text-sage-dark hover:bg-white disabled:cursor-not-allowed disabled:opacity-35"
                                  type="submit"
                                  aria-label="Move block up"
                                  disabled={index === 0}
                                  title="Move up"
                                  data-training-move-up
                                >
                                  <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                                    <path
                                      d="M8 12V4M8 4L4.5 7.5M8 4l3.5 3.5"
                                      stroke="currentColor"
                                      stroke-width="1.75"
                                      stroke-linecap="round"
                                      stroke-linejoin="round"
                                    />
                                  </svg>
                                </button>
                              </form>
                              <form method="post" action="/api/training/admin" data-training-move-block>
                                <input type="hidden" name="action" value="move-block" />
                                <input type="hidden" name="moduleId" value={selected.id} />
                                <input type="hidden" name="lessonId" value={selectedItem.id} />
                                <input type="hidden" name="blockId" value={block.id} />
                                <input type="hidden" name="direction" value="down" />
                                <button
                                  class="inline-flex h-8 w-8 items-center justify-center rounded-full border border-sage-dark/20 bg-white text-sage-dark hover:bg-white disabled:cursor-not-allowed disabled:opacity-35"
                                  type="submit"
                                  aria-label="Move block down"
                                  disabled={index === selectedBlocks.length - 1}
                                  title="Move down"
                                  data-training-move-down
                                >
                                  <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                                    <path
                                      d="M8 4v8M8 12l3.5-3.5M8 12L4.5 8.5"
                                      stroke="currentColor"
                                      stroke-width="1.75"
                                      stroke-linecap="round"
                                      stroke-linejoin="round"
                                    />
                                  </svg>
                                </button>
                              </form>
                            </div>
                          </div>
                        );
                      })
                    )}
                  </div>

                  <form
                    method="post"
                    action="/api/training/admin"
                    class="mt-3 flex flex-wrap items-end gap-2 rounded-xl border border-dashed border-sage-dark/25 bg-white p-3"
                  >
                    <input type="hidden" name="action" value="create-block" />
                    <input type="hidden" name="moduleId" value={selected.id} />
                    <input type="hidden" name="lessonId" value={selectedItem.id} />
                    <label class="text-xs font-medium text-charcoal">
                      Add content
                      <select class="field" name="type">
                        <option value="written">Written text</option>
                        <option value="video">YouTube video</option>
                        <option value="resource">Link / resource</option>
                        <option value="quiz">Quiz</option>
                        <option value="ack">Acknowledgment</option>
                        <option value="contact">Contact details</option>
                        <option value="docusign">DocuSign document</option>
                      </select>
                    </label>
                    <button class="btn-primary !px-3 !py-2 text-xs" type="submit">Add</button>
                  </form>
                </div>
              </div>
            ) : (
              <div class="flex h-full min-h-[12rem] items-center justify-center text-center">
                <div class="max-w-sm">
                  {assignments.length + lessons.length === 0 ? (
                    <>
                      <p class="text-sm font-semibold text-charcoal">Nothing in this module yet</p>
                      <p class="mt-2 text-sm text-sage-dark/65">
                        Use <span class="font-medium text-charcoal">+ Add</span> in the middle column, then select the item to put content here.
                      </p>
                    </>
                  ) : (
                    <>
                      <p class="text-sm font-semibold text-charcoal">Select something to edit</p>
                      <p class="mt-2 text-sm text-sage-dark/65">
                        Choose an item from the middle list to edit its content here.
                      </p>
                    </>
                  )}
                </div>
              </div>
            )
          }
        </div>
      </div>
    </div>

    <div
      id="training-new-module-panel"
      class="hidden border-t border-sage-dark/15 bg-[#f7f8fa] px-4 py-4"
      data-training-new-panel
    >
      <div class="mx-auto max-w-3xl">
        <div class="flex flex-wrap items-start justify-between gap-2">
          <div>
            <p class="text-sm font-semibold text-charcoal">New module</p>
            <p class="mt-0.5 text-xs text-sage-dark/60">Pick a template or start custom, then fill in the details.</p>
          </div>
          <button
            type="button"
            class="rounded-full px-2.5 py-1 text-xs font-semibold text-sage-dark/70 hover:bg-white"
            data-training-new-toggle
          >
            Close
          </button>
        </div>

        <form method="post" action="/api/training/admin" class="mt-4 space-y-4" data-training-new-form>
          <input type="hidden" name="action" value="create-module" />
          <input type="hidden" name="templateId" value="custom" data-training-template-id />

          <div class="grid gap-2 sm:grid-cols-2 lg:grid-cols-4">
            {
              MODULE_TEMPLATES.map((template) => (
                <button
                  type="button"
                  class="rounded-xl border border-sage-dark/15 bg-white px-3 py-3 text-left transition hover:border-sage-dark/30 hover:shadow-sm data-[active=true]:border-charcoal data-[active=true]:ring-1 data-[active=true]:ring-charcoal"
                  data-training-template={template.id}
                  data-title={template.defaultTitle}
                  data-description={template.defaultDescription}
                  data-active={template.id === 'custom' ? 'true' : 'false'}
                >
                  <span class="block text-sm font-semibold text-charcoal">{template.label}</span>
                  <span class="mt-1 block text-[11px] leading-snug text-sage-dark/60">{template.blurb}</span>
                  {template.items.length > 0 ? (
                    <span class="mt-2 block text-[10px] font-medium uppercase tracking-wide text-sage-dark/45">
                      {template.items.length} starter item{template.items.length === 1 ? '' : 's'}
                    </span>
                  ) : (
                    <span class="mt-2 block text-[10px] font-medium uppercase tracking-wide text-sage-dark/45">
                      Blank
                    </span>
                  )}
                </button>
              ))
            }
          </div>

          <div class="rounded-xl border border-sage-dark/10 bg-white p-4">
            <p class="text-xs font-semibold uppercase tracking-[0.12em] text-sage-dark/50" data-training-new-detail-label>
              Custom module
            </p>
            <label class="mt-3 block text-sm font-medium text-charcoal">
              Module title
              <input
                class="field"
                type="text"
                name="title"
                maxlength="120"
                placeholder="e.g. HIPAA basics"
                required
                data-training-new-title
              />
            </label>
            <label class="mt-3 block text-sm font-medium text-charcoal">
              Description
              <textarea
                class="field"
                name="description"
                rows="2"
                placeholder="What will people learn?"
                data-training-new-description
              ></textarea>
            </label>
            <p class="mt-3 text-sm font-medium text-charcoal">Who should see it?</p>
            <div class="mt-2 grid max-h-36 gap-1.5 overflow-y-auto sm:grid-cols-2">
              {roles.map((role) => (
                <label class="flex items-center gap-2 text-sm text-charcoal">
                  <input type="checkbox" name="roleKeys" value={role.key} checked={role.key === 'employee'} />
                  {role.name}
                </label>
              ))}
            </div>
            <button class="btn-primary mt-4 !px-4 !py-2 text-sm" type="submit">Create module</button>
          </div>
        </form>
      </div>
    </div>
  </div>
  </div>

  <div class="mt-8 scroll-mt-24 rounded-2xl border border-sage-dark/10 bg-white/90 p-5 shadow-sm" id="training-progress">
    <h3 class="text-base font-semibold text-charcoal">Team progress</h3>
    <p class="mt-1 text-xs text-sage-dark/60">
      Search one person at a time to review lesson answers, signed documents, and contact details.
    </p>
    {
      roster.length === 0 ? (
        <p class="mt-4 text-sm text-sage-dark/65">No active members yet.</p>
      ) : (
        <div class="mt-4 space-y-4">
          <form method="get" action="/admin" class="flex flex-wrap gap-2" data-training-trainee-search>
            {selectedModuleId ? <input type="hidden" name="module" value={selectedModuleId} /> : null}
            {selectedView === 'settings' ? <input type="hidden" name="view" value="settings" /> : null}
            {selectedItemId ? <input type="hidden" name="item" value={selectedItemId} /> : null}
            <input type="hidden" name="trainee" value={traineeReview?.userId ?? ''} data-training-trainee-id />
            <label class="relative min-w-[16rem] flex-1">
              <span class="sr-only">Search team member</span>
              <input
                class="field"
                type="search"
                name="q"
                placeholder="Search by name or email"
                autocomplete="off"
                data-training-trainee-query
                value={traineeReview ? `${traineeReview.name} · ${traineeReview.email}` : ''}
              />
              <div
                class="absolute left-0 right-0 top-full z-20 mt-1 hidden max-h-56 overflow-y-auto rounded-xl border border-sage-dark/15 bg-white py-1 shadow-lg"
                data-training-trainee-results
              ></div>
            </label>
            <button class="btn-primary !px-4 !py-2 text-sm" type="submit" data-training-trainee-open>
              View
            </button>
          </form>

          <script type="application/json" data-training-roster-json set:html={JSON.stringify(
            roster.map((person) => ({
              userId: person.userId,
              name: person.name,
              email: person.email,
              href: traineeHref(person.userId),
            })),
          )} />

          {
            traineeReview ? (
              <div class="space-y-4 rounded-xl border border-sage-dark/10 bg-[#f7f8fa] p-4">
                <div>
                  <p class="text-lg font-semibold text-charcoal">{traineeReview.name}</p>
                  <p class="text-sm text-sage-dark/70">{traineeReview.email}</p>
                  <p class="mt-1 text-xs text-sage-dark/60">
                    {[traineeReview.phone, traineeReview.jobTitle].filter(Boolean).join(' · ') || 'No phone or job title on account yet'}
                  </p>
                </div>

                {traineeReview.modules.length === 0 ? (
                  <p class="text-sm text-sage-dark/65">No assigned modules for this person.</p>
                ) : (
                  traineeReview.modules.map((mod) => (
                    <details class="rounded-xl border border-sage-dark/10 bg-white p-3" open={mod.percent < 100}>
                      <summary class="cursor-pointer list-none">
                        <div class="flex flex-wrap items-center justify-between gap-2">
                          <p class="font-semibold text-charcoal">{mod.title}</p>
                          <p class="text-xs text-sage-dark/65">
                            {mod.percent}%{mod.complete ? ' · complete' : ''}
                          </p>
                        </div>
                      </summary>
                      <div class="mt-3 space-y-3 border-t border-sage-dark/10 pt-3">
                        {mod.lessons.map((lesson) => (
                          <div class="rounded-lg bg-[#f7f8fa] p-3">
                            <div class="flex flex-wrap items-center justify-between gap-2">
                              <p class="text-sm font-semibold text-charcoal">
                                {lesson.isAssignment ? 'Assignment' : 'Lesson'}: {lesson.title}
                              </p>
                              <span
                                class:list={[
                                  'rounded-full px-2 py-0.5 text-[10px] font-semibold uppercase tracking-wide',
                                  lesson.completed
                                    ? 'bg-emerald-100 text-emerald-900'
                                    : 'bg-white text-sage-dark/70 ring-1 ring-sage-dark/10',
                                ]}
                              >
                                {lesson.completed ? 'Complete' : 'In progress'}
                              </span>
                            </div>
                            {lesson.ackName ? (
                              <p class="mt-1 text-xs text-sage-dark/65">Acknowledged as “{lesson.ackName}”</p>
                            ) : null}
                            <ul class="mt-3 space-y-2">
                              {lesson.blocks.map((block) => (
                                <li class="rounded-lg border border-sage-dark/10 bg-white px-3 py-2">
                                  <div class="flex flex-wrap items-center justify-between gap-2">
                                    <p class="text-xs font-semibold text-charcoal">{block.label}</p>
                                    <p class="text-[11px] text-sage-dark/65">{block.status}</p>
                                  </div>
                                  {block.detail ? (
                                    <p class="mt-1 text-xs text-sage-dark/70">{block.detail}</p>
                                  ) : null}
                                  {block.contactAnswers ? (
                                    <dl class="mt-2 grid gap-1 text-xs text-charcoal sm:grid-cols-2">
                                      {CONTACT_FIELD_OPTIONS.filter((field) =>
                                        block.contactAnswers?.[field.key],
                                      ).map((field) => (
                                        <div>
                                          <dt class="text-sage-dark/55">{field.label}</dt>
                                          <dd>{block.contactAnswers?.[field.key] || '—'}</dd>
                                        </div>
                                      ))}
                                    </dl>
                                  ) : null}
                                  {block.quizAnswers ? (
                                    <ul class="mt-2 space-y-1.5">
                                      {block.quizAnswers.map((answer, index) => (
                                        <li class="text-xs text-charcoal">
                                          <p class="font-medium">
                                            {index + 1}. {answer.prompt}
                                          </p>
                                          <p
                                            class:list={[
                                              'mt-0.5',
                                              answer.isCorrect ? 'text-emerald-800' : 'text-amber-900',
                                            ]}
                                          >
                                            Answer: {answer.selected}
                                            {!answer.isCorrect ? ` · Correct: ${answer.correct}` : ''}
                                          </p>
                                        </li>
                                      ))}
                                    </ul>
                                  ) : null}
                                  {block.type === 'docusign' && block.docusignStatus !== 'completed' ? (
                                    <p class="mt-1 text-xs text-amber-800">Document still missing or incomplete.</p>
                                  ) : null}
                                </li>
                              ))}
                            </ul>
                          </div>
                        ))}
                      </div>
                    </details>
                  ))
                )}
              </div>
            ) : (
              <p class="rounded-xl bg-[#f7f8fa] px-3 py-3 text-sm text-sage-dark/65">
                Search for a teammate above to open their full training review.
              </p>
            )
          }
        </div>
      )
    }
  </div>
</section>

<script>
  (() => {
    const FLAG = 'data-training-nav-bound';
    if (document.documentElement.hasAttribute(FLAG)) return;
    document.documentElement.setAttribute(FLAG, '1');

    let requestId = 0;

    const ensureTrainingPanelOpen = () => {
      const shell = document.querySelector('[data-admin-shell]');
      if (!(shell instanceof HTMLElement)) return;
      const menu = shell.querySelector('[data-admin-menu]');
      const header = shell.querySelector('[data-admin-header]');
      const panels = shell.querySelectorAll('[data-admin-panel]');
      if (header instanceof HTMLElement) header.classList.add('hidden');
      if (menu instanceof HTMLElement) menu.classList.add('hidden');
      panels.forEach((panel) => {
        if (!(panel instanceof HTMLElement)) return;
        panel.classList.toggle('hidden', panel.dataset.adminPanel !== 'training');
      });
    };

    const browseUrlFromLink = (link: HTMLAnchorElement) => {
      const url = new URL(link.href, window.location.href);
      const kind = link.getAttribute('data-training-nav');
      // Opening a module should never keep Settings/item selection stuck on screen.
      if (kind === 'module') {
        url.searchParams.delete('view');
        url.searchParams.delete('item');
        url.searchParams.delete('trainingSaved');
        url.searchParams.delete('trainingError');
      }
      url.hash = 'training';
      return url;
    };

    const loadBrowse = async (url: URL, push: boolean) => {
      const current = document.querySelector('[data-training-browse]');
      if (!(current instanceof HTMLElement)) {
        window.location.assign(url.href);
        return;
      }

      const id = ++requestId;
      current.classList.add('pointer-events-none', 'opacity-55');
      current.setAttribute('aria-busy', 'true');

      try {
        const fetchUrl = new URL(url.href);
        fetchUrl.searchParams.set('_browse', String(Date.now()));
        const response = await fetch(fetchUrl.pathname + fetchUrl.search, {
          credentials: 'same-origin',
          cache: 'no-store',
          headers: { Accept: 'text/html', 'X-Requested-With': 'training-browse' },
        });
        if (!response.ok) throw new Error(`HTTP ${response.status}`);
        const html = await response.text();
        if (id !== requestId) return;

        const doc = new DOMParser().parseFromString(html, 'text/html');
        const next = doc.querySelector('[data-training-browse]');
        if (!(next instanceof HTMLElement)) throw new Error('Missing training browse markup');

        const imported = document.importNode(next, true);
        const latest = document.querySelector('[data-training-browse]');
        if (!(latest instanceof HTMLElement)) {
          window.location.assign(url.href);
          return;
        }
        latest.replaceWith(imported);
        ensureTrainingPanelOpen();
        if (push) {
          history.pushState({ trainingBrowse: true }, '', url.pathname + url.search + url.hash);
        }
      } catch {
        if (id === requestId) window.location.assign(url.href);
      } finally {
        if (id !== requestId) return;
        const browse = document.querySelector('[data-training-browse]');
        if (browse instanceof HTMLElement) {
          browse.classList.remove('pointer-events-none', 'opacity-55');
          browse.removeAttribute('aria-busy');
        }
      }
    };

    const setAutosaveStatus = (form: HTMLFormElement, message: string, isError = false) => {
      const status = form.querySelector('[data-training-autosave-status]');
      if (!(status instanceof HTMLElement)) return;
      status.textContent = message;
      status.classList.toggle('text-red-700', isError);
      status.classList.toggle('text-sage-dark/50', !isError);
    };

    const syncLessonTitleUi = (form: HTMLFormElement, title: string) => {
      const heading = document.querySelector('[data-training-item-heading]');
      if (heading instanceof HTMLElement) heading.textContent = title;
      const lessonId = new FormData(form).get('lessonId');
      if (typeof lessonId !== 'string' || !lessonId) return;
      document.querySelectorAll('a[data-training-nav="item"]').forEach((link) => {
        if (!(link instanceof HTMLAnchorElement)) return;
        try {
          const href = new URL(link.href, window.location.href);
          if (href.searchParams.get('item') !== lessonId) return;
        } catch {
          return;
        }
        const titleEl = link.querySelector('[data-item-title]');
        if (titleEl instanceof HTMLElement) titleEl.textContent = title;
      });
    };

    const autosaveForm = async (form: HTMLFormElement) => {
      if (form.dataset.autosaving === '1') {
        form.dataset.autosaveQueued = '1';
        return;
      }
      form.dataset.autosaving = '1';
      setAutosaveStatus(form, 'Saving…');
      try {
        const response = await fetch(form.action || '/api/training/admin', {
          method: 'POST',
          body: new FormData(form),
          credentials: 'same-origin',
          headers: { 'X-Requested-With': 'training-autosave', Accept: 'application/json' },
        });
        const data = (await response.json().catch(() => null)) as
          | { ok?: boolean; error?: string; title?: string }
          | null;
        if (!response.ok || !data?.ok) {
          throw new Error(data?.error || `Could not save (${response.status})`);
        }
        setAutosaveStatus(form, 'Saved');
        if (typeof data.title === 'string' && data.title) {
          syncLessonTitleUi(form, data.title);
        }
      } catch (error) {
        const message = error instanceof Error ? error.message : 'Could not save.';
        setAutosaveStatus(form, message, true);
      } finally {
        form.dataset.autosaving = '0';
        if (form.dataset.autosaveQueued === '1') {
          form.dataset.autosaveQueued = '0';
          void autosaveForm(form);
        }
      }
    };

    const shouldAutosaveField = (form: HTMLFormElement, field: Element) => {
      const ignore = form.getAttribute('data-training-autosave-ignore') ?? '';
      if (ignore.includes('textarea') && field instanceof HTMLTextAreaElement) return false;
      return true;
    };

    let titleTimer: number | undefined;
    document.addEventListener('change', (event) => {
      if (!(event.target instanceof Element)) return;
      const form = event.target.closest('form[data-training-autosave]');
      if (!(form instanceof HTMLFormElement)) return;
      if (!shouldAutosaveField(form, event.target)) return;
      void autosaveForm(form);
    });

    document.addEventListener('input', (event) => {
      if (
        !(event.target instanceof HTMLInputElement) &&
        !(event.target instanceof HTMLTextAreaElement)
      ) {
        return;
      }
      if (event.target instanceof HTMLInputElement) {
        if (event.target.type === 'checkbox' || event.target.type === 'radio') return;
      }
      const form = event.target.closest('form[data-training-autosave]');
      if (!(form instanceof HTMLFormElement)) return;
      if (!shouldAutosaveField(form, event.target)) return;
      window.clearTimeout(titleTimer);
      titleTimer = window.setTimeout(() => {
        void autosaveForm(form);
      }, 450);
    });

    const refreshBlockMoveUi = (list: Element) => {
      const cards = Array.from(list.querySelectorAll(':scope > [data-training-block-card]'));
      cards.forEach((card, index) => {
        if (!(card instanceof HTMLElement)) return;
        const label = card.querySelector('[data-training-block-label]');
        if (label instanceof HTMLElement) {
          const text = label.textContent?.trim() ?? '';
          const withoutNumber = text.replace(/^\d+\.\s*/, '');
          label.textContent = `${index + 1}. ${withoutNumber}`;
        }
        const up = card.querySelector('[data-training-move-up]');
        const down = card.querySelector('[data-training-move-down]');
        if (up instanceof HTMLButtonElement) up.disabled = index === 0;
        if (down instanceof HTMLButtonElement) down.disabled = index === cards.length - 1;
      });
    };

    document.addEventListener('submit', (event) => {
      const form = event.target;
      if (!(form instanceof HTMLFormElement)) return;
      if (!form.hasAttribute('data-training-move-block')) return;
      event.preventDefault();

      const direction = String(new FormData(form).get('direction') ?? '');
      const card = form.closest('[data-training-block-card]');
      const list = card?.parentElement;
      if (!(card instanceof HTMLElement) || !(list instanceof HTMLElement)) return;
      if (form.dataset.moving === '1') return;
      form.dataset.moving = '1';

      const sibling =
        direction === 'up'
          ? card.previousElementSibling
          : card.nextElementSibling;
      if (!(sibling instanceof HTMLElement) || !sibling.hasAttribute('data-training-block-card')) {
        form.dataset.moving = '0';
        return;
      }

      // Optimistic DOM swap for instant feedback.
      if (direction === 'up') list.insertBefore(card, sibling);
      else list.insertBefore(sibling, card);
      refreshBlockMoveUi(list);

      void (async () => {
        try {
          const response = await fetch(form.action || '/api/training/admin', {
            method: 'POST',
            body: new FormData(form),
            credentials: 'same-origin',
            headers: { 'X-Requested-With': 'training-autosave', Accept: 'application/json' },
          });
          const data = (await response.json().catch(() => null)) as { ok?: boolean; error?: string } | null;
          if (!response.ok || !data?.ok) {
            // Roll back on failure.
            if (direction === 'up') list.insertBefore(sibling, card);
            else list.insertBefore(card, sibling);
            refreshBlockMoveUi(list);
            throw new Error(data?.error || `Could not move block (${response.status})`);
          }
        } catch {
          // Keep silent UI rollback; full reload is a last resort only if needed later.
        } finally {
          form.dataset.moving = '0';
        }
      })();
    });

    document.addEventListener('click', (event) => {
      if (!(event.target instanceof Element)) return;

      // Close + Add / item settings popovers when clicking outside them.
      document
        .querySelectorAll('details[data-training-add][open], details[data-training-item-settings][open]')
        .forEach((node) => {
          if (!(node instanceof HTMLDetailsElement)) return;
          if (!node.contains(event.target as Node)) node.open = false;
        });

      const newToggle = event.target.closest('[data-training-new-toggle]');
      if (newToggle instanceof HTMLElement) {
        event.preventDefault();
        const panel = document.querySelector('[data-training-new-panel]');
        if (!(panel instanceof HTMLElement)) return;
        const open = panel.classList.toggle('hidden') === false;
        document.querySelectorAll('[data-training-new-toggle]').forEach((btn) => {
          if (btn instanceof HTMLElement) btn.setAttribute('aria-expanded', open ? 'true' : 'false');
        });
        if (open) {
          panel.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        }
        return;
      }

      const templateBtn = event.target.closest('[data-training-template]');
      if (templateBtn instanceof HTMLElement) {
        event.preventDefault();
        const templateId = templateBtn.getAttribute('data-training-template') ?? 'custom';
        const title = templateBtn.getAttribute('data-title') ?? '';
        const description = templateBtn.getAttribute('data-description') ?? '';
        const label = templateBtn.querySelector('span')?.textContent?.trim() || 'Custom';

        document.querySelectorAll('[data-training-template]').forEach((btn) => {
          if (btn instanceof HTMLElement) {
            btn.dataset.active = btn === templateBtn ? 'true' : 'false';
          }
        });

        const idInput = document.querySelector('[data-training-template-id]');
        const titleInput = document.querySelector('[data-training-new-title]');
        const descriptionInput = document.querySelector('[data-training-new-description]');
        const detailLabel = document.querySelector('[data-training-new-detail-label]');
        if (idInput instanceof HTMLInputElement) idInput.value = templateId;
        if (titleInput instanceof HTMLInputElement) {
          titleInput.value = title;
          titleInput.required = templateId === 'custom';
          titleInput.placeholder =
            templateId === 'custom' ? 'e.g. HIPAA basics' : 'Leave blank to use the template name';
        }
        if (descriptionInput instanceof HTMLTextAreaElement) {
          descriptionInput.value = description;
        }
        if (detailLabel instanceof HTMLElement) {
          detailLabel.textContent =
            templateId === 'custom' ? 'Custom module' : `${label} details`;
        }
        return;
      }

      const link = event.target.closest('a[data-training-nav]');
      if (!(link instanceof HTMLAnchorElement)) return;
      if (event.defaultPrevented) return;
      if (event.button !== 0) return;
      if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
      if (link.target === '_blank') return;

      const nextUrl = browseUrlFromLink(link);
      const currentUrl = new URL(window.location.href);
      if (nextUrl.pathname !== currentUrl.pathname) return;

      event.preventDefault();
      const same =
        nextUrl.pathname === currentUrl.pathname &&
        nextUrl.searchParams.get('module') === currentUrl.searchParams.get('module') &&
        nextUrl.searchParams.get('item') === currentUrl.searchParams.get('item') &&
        nextUrl.searchParams.get('view') === currentUrl.searchParams.get('view');
      if (same) return;
      void loadBrowse(nextUrl, true);
    });

    window.addEventListener('popstate', () => {
      if (!document.querySelector('[data-training-browse]')) return;
      void loadBrowse(new URL(window.location.href), false);
    });

    const bindTraineeSearch = () => {
      const form = document.querySelector('[data-training-trainee-search]');
      const query = document.querySelector('[data-training-trainee-query]');
      const results = document.querySelector('[data-training-trainee-results]');
      const hiddenId = document.querySelector('[data-training-trainee-id]');
      const rosterEl = document.querySelector('[data-training-roster-json]');
      if (
        !(form instanceof HTMLFormElement) ||
        !(query instanceof HTMLInputElement) ||
        !(results instanceof HTMLElement) ||
        !(hiddenId instanceof HTMLInputElement) ||
        !(rosterEl instanceof HTMLElement)
      ) {
        return;
      }

      let people: Array<{ userId: string; name: string; email: string; href: string }> = [];
      try {
        people = JSON.parse(rosterEl.textContent || '[]') as typeof people;
      } catch {
        people = [];
      }

      const hideResults = () => {
        results.classList.add('hidden');
        results.innerHTML = '';
      };

      const escapeHtml = (value: string) =>
        value
          .replaceAll('&', '&amp;')
          .replaceAll('<', '&lt;')
          .replaceAll('>', '&gt;')
          .replaceAll('"', '&quot;');

      const showMatches = (term: string) => {
        const needle = term.trim().toLowerCase();
        const matches = people
          .filter((person) => {
            if (!needle) return true;
            return (
              person.name.toLowerCase().includes(needle) ||
              person.email.toLowerCase().includes(needle)
            );
          })
          .slice(0, 8);
        if (matches.length === 0) {
          results.innerHTML =
            '<p class="px-3 py-2 text-xs text-sage-dark/60">No matching teammates.</p>';
          results.classList.remove('hidden');
          return;
        }
        results.innerHTML = matches
          .map(
            (person) =>
              `<button type="button" class="block w-full px-3 py-2 text-left hover:bg-[#f7f8fa]" data-trainee-pick="${escapeHtml(person.userId)}" data-trainee-href="${escapeHtml(person.href)}">
                <span class="block text-sm font-semibold text-charcoal">${escapeHtml(person.name)}</span>
                <span class="block text-xs text-sage-dark/60">${escapeHtml(person.email)}</span>
              </button>`,
          )
          .join('');
        results.classList.remove('hidden');
      };

      query.addEventListener('focus', () => showMatches(query.value));
      query.addEventListener('input', () => {
        hiddenId.value = '';
        showMatches(query.value);
      });
      results.addEventListener('click', (event) => {
        const button = event.target instanceof Element ? event.target.closest('[data-trainee-pick]') : null;
        if (!(button instanceof HTMLElement)) return;
        const userId = button.getAttribute('data-trainee-pick') || '';
        const href = button.getAttribute('data-trainee-href') || '';
        const person = people.find((row) => row.userId === userId);
        if (!person || !href) return;
        hiddenId.value = userId;
        query.value = `${person.name} · ${person.email}`;
        hideResults();
        window.location.assign(href);
      });
      document.addEventListener('click', (event) => {
        if (!(event.target instanceof Node)) return;
        if (form.contains(event.target)) return;
        hideResults();
      });
      form.addEventListener('submit', (event) => {
        event.preventDefault();
        const selected =
          people.find((person) => person.userId === hiddenId.value) ||
          people.find((person) => {
            const needle = query.value.trim().toLowerCase();
            return (
              person.name.toLowerCase() === needle ||
              person.email.toLowerCase() === needle ||
              `${person.name} · ${person.email}`.toLowerCase() === needle ||
              person.name.toLowerCase().includes(needle) ||
              person.email.toLowerCase().includes(needle)
            );
          });
        if (selected) {
          window.location.assign(selected.href);
          return;
        }
        showMatches(query.value);
      });
    };

    bindTraineeSearch();

    const bindLessonPreview = () => {
      document.addEventListener('click', (event) => {
        const target = event.target;
        if (!(target instanceof Element)) return;

        const openBtn = target.closest('[data-training-preview-open]');
        if (openBtn) {
          const kind = openBtn.getAttribute('data-training-preview-open') || 'lesson';
          const root = openBtn.closest('[data-training-browse]') ?? document;
          const dialog = root.querySelector(`[data-training-preview-dialog="${kind}"]`);
          if (dialog instanceof HTMLDialogElement && typeof dialog.showModal === 'function') {
            dialog.showModal();
          }
          return;
        }

        const closeBtn = target.closest('[data-training-preview-close]');
        if (closeBtn) {
          const dialog = closeBtn.closest('dialog');
          if (dialog instanceof HTMLDialogElement && dialog.open) dialog.close();
          return;
        }

        if (
          target instanceof HTMLDialogElement &&
          target.hasAttribute('data-training-preview-dialog')
        ) {
          target.close();
        }
      });
    };

    bindLessonPreview();
  })();
</script>
