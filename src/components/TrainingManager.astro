---
import type { TrainingModule, TrainingLesson, TrainingBlock } from '../lib/training';
import {
  CONTACT_FIELD_OPTIONS,
  MODULE_TEMPLATES,
  canToggleBlockRequired,
  extractYoutubeId,
} from '../lib/training';

interface Props {
  modules: TrainingModule[];
  selectedModuleId: string | null;
  selectedItemId: string | null;
  selectedView: 'settings' | 'item' | 'idle';
  assignments: TrainingLesson[];
  lessons: TrainingLesson[];
  blocksByItem: Record<string, TrainingBlock[]>;
  roles: Array<{ key: string; name: string }>;
  roster: Array<{
    userId: string;
    name: string;
    email: string;
    roleKeys: string[];
    modules: Array<{ moduleId: string; title: string; percent: number; complete: boolean }>;
  }>;
  traineeReview?: {
    userId: string;
    name: string;
    email: string;
    phone: string | null;
    jobTitle: string | null;
    modules: Array<{
      moduleId: string;
      title: string;
      percent: number;
      complete: boolean;
      lessons: Array<{
        lessonId: string;
        title: string;
        isAssignment: boolean;
        completed: boolean;
        completedAt: number | null;
        ackName: string | null;
        blocks: Array<{
          blockId: string;
          type: string;
          label: string;
          status: string;
          detail: string | null;
          contactAnswers: {
            fullName: string;
            phone: string;
            workEmail: string;
            jobTitle: string;
          } | null;
          quizAnswers: Array<{
            prompt: string;
            selected: string;
            correct: string;
            isCorrect: boolean;
          }> | null;
          docusignStatus: string | null;
        }>;
      }>;
    }>;
  } | null;
  docusignConnected?: boolean;
  docusignTemplates?: Array<{ templateId: string; name: string }>;
  docusignStatuses?: Array<{
    userId: string;
    blockId: string;
    status: string;
    completedAt: number | null;
    userName?: string;
  }>;
  error?: string | null;
  embedded?: boolean;
}

const {
  modules,
  selectedModuleId,
  selectedItemId,
  selectedView,
  assignments,
  lessons,
  blocksByItem,
  roles,
  roster,
  traineeReview = null,
  docusignConnected = false,
  docusignTemplates = [],
  docusignStatuses = [],
  error = null,
  embedded = false,
} = Astro.props;

const selected = modules.find((m) => m.id === selectedModuleId) ?? modules[0] ?? null;
const allItems = selected ? [...assignments, ...lessons] : [];
const selectedItem =
  selectedView === 'item' && selectedItemId
    ? allItems.find((item) => item.id === selectedItemId) ?? null
    : null;
const selectedBlocks = selectedItem ? (blocksByItem[selectedItem.id] ?? []) : [];
const selectedIsAssignment = selectedItem ? Boolean(selectedItem.isAssignment) : false;

const lessonRoleOptions = selected
  ? selected.roleKeys.length > 0
    ? roles.filter((role) => selected.roleKeys.includes(role.key))
    : roles
  : [];

function kindLabel(kind: TrainingModule['kind']): string {
  if (kind === 'onboarding') return 'Onboarding';
  if (kind === 'using_coordity') return 'Using Coordity';
  return 'Custom';
}

function blockLabel(type: TrainingBlock['type']): string {
  if (type === 'written') return 'Written';
  if (type === 'video') return 'Video';
  if (type === 'resource') return 'Link';
  if (type === 'quiz') return 'Quiz';
  if (type === 'ack') return 'Acknowledgment';
  if (type === 'docusign') return 'DocuSign document';
  if (type === 'contact') return 'Contact details';
  return type;
}

function traineeHref(userId: string): string {
  const params = new URLSearchParams();
  if (selectedModuleId) params.set('module', selectedModuleId);
  if (selectedView === 'settings') params.set('view', 'settings');
  if (selectedItemId) params.set('item', selectedItemId);
  params.set('trainee', userId);
  return `/admin?${params.toString()}#training-progress`;
}

function moduleHref(moduleId: string, opts?: { item?: string; view?: 'settings' }): string {
  const params = new URLSearchParams();
  params.set('module', moduleId);
  if (opts?.view === 'settings') params.set('view', 'settings');
  if (opts?.item) params.set('item', opts.item);
  return `/admin?${params.toString()}#training`;
}
---

<section class:list={[!embedded && 'mt-10', 'scroll-mt-24']} id="training" aria-labelledby="training-admin">
  {!embedded ? <h2 id="training-admin" class="font-display text-3xl text-charcoal">Training</h2> : <h2 id="training-admin" class="sr-only">Training</h2>}

  {error ? <p class="mt-4 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800">{error}</p> : null}

  <p class="mt-4 max-w-3xl text-sm leading-relaxed text-sage-dark/75">
    Training is organized into modules — topics your team works through. Click a module on the left,
    then build its list in the middle with <span class="font-medium text-charcoal">+ Add</span>.
    Select an item to edit its content on the right. Add intro text for the module, and use
    <span class="font-medium text-charcoal">Preview</span> to see the learner view.
  </p>

  <div class="mt-3 space-y-3 transition-opacity duration-150" data-training-browse>
  <div class="overflow-hidden rounded-2xl border border-sage-dark/15 bg-white shadow-sm">
    <div class="grid min-h-[42rem] lg:h-[min(94vh,68rem)] lg:grid-cols-[13.5rem_15.5rem_minmax(0,1fr)]">
      {/* Column 1 — Modules */}
      <div class="flex min-h-0 flex-col border-b border-sage-dark/10 lg:border-b-0 lg:border-r lg:h-full">
        <div class="border-b border-sage-dark/10 bg-[#f7f8fa] px-3 py-2.5">
          <p class="text-xs font-semibold uppercase tracking-[0.12em] text-sage-dark/55">Modules</p>
          <p class="mt-0.5 text-[11px] text-sage-dark/55">Topics / folders</p>
        </div>
        <div class="flex-1 space-y-0.5 overflow-y-auto p-2">
          {
            modules.length === 0 ? (
              <p class="px-2 py-4 text-sm text-sage-dark/65">None yet — create one below.</p>
            ) : (
              modules.map((module) => (
                <a
                  href={moduleHref(module.id)}
                  data-training-nav="module"
                  class:list={[
                    'block rounded-lg px-2.5 py-2 text-sm transition',
                    selected?.id === module.id
                      ? 'bg-charcoal text-white'
                      : 'text-charcoal hover:bg-[#f4f5f8]',
                  ]}
                >
                  <span class="font-semibold leading-snug">{module.title}</span>
                  <span
                    class:list={[
                      'mt-0.5 block text-[11px]',
                      selected?.id === module.id ? 'text-white/65' : 'text-sage-dark/55',
                    ]}
                  >
                    {kindLabel(module.kind)}
                    {!module.visible ? ' · hidden' : ''}
                  </span>
                </a>
              ))
            )
          }
        </div>
        <div class="border-t border-sage-dark/10 bg-[#fafbfc] px-3 py-2.5">
          <button
            type="button"
            class="w-full rounded-lg px-2.5 py-2 text-left text-sm font-semibold text-charcoal transition hover:bg-white"
            data-training-new-toggle
            aria-expanded="false"
            aria-controls="training-new-module-panel"
          >
            + New module
          </button>
        </div>
      </div>

      {/* Column 2 — Contents of selected module */}
      <div class="flex min-h-0 flex-col border-b border-sage-dark/10 lg:border-b-0 lg:border-r lg:h-full">
        <div class="border-b border-sage-dark/10 bg-[#f7f8fa] px-3 py-2.5">
          {
            selected ? (
              <>
                <div class="flex items-start justify-between gap-2">
                  <div class="min-w-0 flex-1">
                    <p class="text-xs font-semibold uppercase tracking-[0.12em] text-sage-dark/55">
                      In this module:
                    </p>
                    <p class="mt-0.5 break-words text-sm font-semibold leading-snug text-charcoal">{selected.title}</p>
                  </div>
                  <div class="flex shrink-0 flex-col items-end gap-1">
                    <button
                      type="button"
                      class="rounded-full bg-white px-2.5 py-1 text-[11px] font-semibold text-sage-dark ring-1 ring-sage-dark/15 hover:bg-[#f4f5f8]"
                      data-training-preview-open="module"
                    >
                      Preview
                    </button>
                    <a
                      href={moduleHref(selected.id, { view: 'settings' })}
                      data-training-nav="settings"
                      class:list={[
                        'rounded-full px-2.5 py-1 text-[11px] font-semibold transition',
                        selectedView === 'settings'
                          ? 'bg-charcoal text-white'
                          : 'bg-white text-sage-dark ring-1 ring-sage-dark/15 hover:bg-[#f4f5f8]',
                      ]}
                    >
                      Settings
                    </a>
                  </div>
                </div>
                <p class="mt-1.5 text-[11px] leading-snug text-sage-dark/60">
                  Add intro text, then lessons and assignments for people to finish.
                </p>
              </>
            ) : (
              <>
                <p class="text-xs font-semibold uppercase tracking-[0.12em] text-sage-dark/55">In this module:</p>
                <p class="mt-0.5 text-[11px] text-sage-dark/55">Open a module to see its contents</p>
              </>
            )
          }
        </div>
        {
          !selected ? (
            <p class="px-3 py-6 text-sm text-sage-dark/65">
              Open a module on the left to add assignments and lessons here.
            </p>
          ) : (
            <div class="flex min-h-0 flex-1 flex-col overflow-y-auto">
              <form
                method="post"
                action="/api/training/admin"
                class="border-b border-sage-dark/10 px-2.5 py-2.5"
                data-training-autosave
              >
                <input type="hidden" name="action" value="update-module" />
                <input type="hidden" name="moduleId" value={selected.id} />
                <label class="block text-[11px] font-semibold uppercase tracking-[0.12em] text-sage-dark/50">
                  Intro text
                  <textarea
                    class="field mt-1.5 !py-1.5 text-xs font-normal normal-case tracking-normal"
                    name="description"
                    rows="3"
                    placeholder="Optional description shown at the top of this module for learners…"
                  >{selected.description}</textarea>
                </label>
                <p class="mt-1 text-[10px] text-sage-dark/50" data-training-autosave-status></p>
              </form>

              <div class="flex items-center justify-between gap-2 border-b border-sage-dark/10 px-2.5 py-2">
                <p class="text-[11px] font-semibold uppercase tracking-[0.12em] text-sage-dark/50">
                  To complete
                </p>
                <details class="relative" data-training-add>
                  <summary class="cursor-pointer list-none rounded-full bg-charcoal px-2.5 py-1 text-[11px] font-semibold text-white [&::-webkit-details-marker]:hidden">
                    + Add
                  </summary>
                  <form
                    method="post"
                    action="/api/training/admin"
                    class="absolute right-0 z-20 mt-1.5 w-56 rounded-xl border border-sage-dark/15 bg-white p-2.5 shadow-lg"
                  >
                    <input type="hidden" name="action" value="create-lesson" />
                    <input type="hidden" name="moduleId" value={selected.id} />
                    <label class="block text-[11px] font-medium text-charcoal">
                      Name
                      <input
                        class="field mt-1 !py-1.5 text-xs"
                        type="text"
                        name="title"
                        required
                        placeholder="What should they complete?"
                        autofocus
                      />
                    </label>
                    <label class="mt-2 block text-[11px] font-medium text-charcoal">
                      Type
                      <select class="field mt-1 !py-1.5 text-xs" name="isAssignment">
                        <option value="0">Lesson</option>
                        <option value="1">Assignment</option>
                      </select>
                    </label>
                    <p class="mt-1.5 text-[10px] leading-snug text-sage-dark/55">
                      Lesson = multi-step. Assignment = one short to-do.
                    </p>
                    <button class="btn-primary mt-2 w-full !px-2.5 !py-1.5 text-xs" type="submit">
                      Add to list
                    </button>
                  </form>
                </details>
              </div>

              <div class="flex-1 p-2">
                {
                  assignments.length + lessons.length === 0 ? (
                    <p class="px-1 py-8 text-center text-sm text-sage-dark/55">Nothing to show yet</p>
                  ) : (
                    <div class="space-y-0.5">
                      {assignments.map((item) => (
                        <a
                          href={moduleHref(selected.id, { item: item.id })}
                          data-training-nav="item"
                          class:list={[
                            'block rounded-lg px-2.5 py-2 text-sm transition',
                            selectedItem?.id === item.id
                              ? 'bg-sage/25 font-semibold text-charcoal ring-1 ring-sage-dark/15'
                              : 'text-charcoal hover:bg-[#f4f5f8]',
                          ]}
                        >
                          <span class="flex items-center gap-2">
                            <span class="min-w-0 flex-1 truncate" data-item-title>{item.title}</span>
                            <span class="shrink-0 text-[10px] font-medium uppercase tracking-wide text-sage-dark/45">
                              Assignment
                            </span>
                          </span>
                          <span class="mt-0.5 block text-[11px] font-normal text-sage-dark/55">
                            {(blocksByItem[item.id] ?? []).length === 0
                              ? 'Needs content'
                              : `${(blocksByItem[item.id] ?? []).length} content block${(blocksByItem[item.id] ?? []).length === 1 ? '' : 's'}`}
                            {!item.required ? ' · optional' : ''}
                          </span>
                        </a>
                      ))}
                      {lessons.map((item) => (
                        <a
                          href={moduleHref(selected.id, { item: item.id })}
                          data-training-nav="item"
                          class:list={[
                            'block rounded-lg px-2.5 py-2 text-sm transition',
                            selectedItem?.id === item.id
                              ? 'bg-sage/25 font-semibold text-charcoal ring-1 ring-sage-dark/15'
                              : 'text-charcoal hover:bg-[#f4f5f8]',
                          ]}
                        >
                          <span class="flex items-center gap-2">
                            <span class="min-w-0 flex-1 truncate" data-item-title>{item.title}</span>
                            <span class="shrink-0 text-[10px] font-medium uppercase tracking-wide text-sage-dark/45">
                              Lesson
                            </span>
                          </span>
                          <span class="mt-0.5 block text-[11px] font-normal text-sage-dark/55">
                            {(blocksByItem[item.id] ?? []).length === 0
                              ? 'Needs content'
                              : `${(blocksByItem[item.id] ?? []).length} content block${(blocksByItem[item.id] ?? []).length === 1 ? '' : 's'}`}
                            {!item.required ? ' · optional' : ''}
                          </span>
                        </a>
                      ))}
                    </div>
                  )
                }
              </div>
            </div>
          )
        }

        {
          selected ? (
            <dialog
              class="w-[min(40rem,calc(100vw-2rem))] max-h-[min(90vh,52rem)] overflow-hidden rounded-2xl border border-sage-dark/15 bg-white p-0 shadow-xl backdrop:bg-charcoal/40"
              data-training-preview-dialog="module"
            >
              <div class="flex items-center justify-between gap-3 border-b border-sage-dark/10 px-4 py-3">
                <div class="min-w-0">
                  <p class="text-[11px] font-semibold uppercase tracking-[0.12em] text-sage-dark/55">
                    Learner preview
                  </p>
                  <p class="truncate text-sm font-semibold text-charcoal">{selected.title}</p>
                </div>
                <button
                  type="button"
                  class="rounded-full px-2.5 py-1 text-xs font-semibold text-sage-dark/70 hover:bg-[#f4f5f8]"
                  data-training-preview-close
                >
                  Close
                </button>
              </div>
              <div class="max-h-[min(78vh,44rem)] space-y-5 overflow-y-auto px-4 py-4">
                <div>
                  <p class="text-[11px] font-semibold uppercase tracking-[0.14em] text-sage-dark/55">Module</p>
                  <h3 class="mt-1 font-display text-2xl text-charcoal">{selected.title}</h3>
                  {selected.description ? (
                    <p class="mt-3 whitespace-pre-wrap text-sm leading-relaxed text-sage-dark/75">
                      {selected.description}
                    </p>
                  ) : (
                    <p class="mt-3 text-sm text-sage-dark/55">No intro text yet.</p>
                  )}
                  <p class="mt-4 text-sm font-semibold text-sage-dark/80">0% complete</p>
                  <div class="mt-2 h-2 overflow-hidden rounded-full bg-[#e3e5e8]">
                    <div class="h-full w-0 rounded-full bg-sage-dark" />
                  </div>
                </div>

                {assignments.length > 0 ? (
                  <section>
                    <h4 class="text-xs font-semibold uppercase tracking-[0.14em] text-sage-dark/60">
                      Assignments
                    </h4>
                    <p class="mt-1 text-sm text-sage-dark/65">Tasks and acknowledgments for this module.</p>
                    <ol class="mt-3 space-y-2">
                      {assignments.map((item, index) => (
                        <li class="rounded-xl border border-sage-dark/10 bg-[#f7f8fa] px-3 py-3">
                          <div class="flex items-center justify-between gap-3">
                            <div class="min-w-0">
                              <p class="text-[11px] text-sage-dark/50">Assignment {index + 1}</p>
                              <p class="mt-0.5 text-sm font-semibold text-charcoal">{item.title}</p>
                            </div>
                            <span class="shrink-0 rounded-full bg-sage-dark/10 px-2.5 py-1 text-[11px] font-semibold text-sage-dark/80">
                              Start
                            </span>
                          </div>
                        </li>
                      ))}
                    </ol>
                  </section>
                ) : null}

                <section>
                  <h4 class="text-xs font-semibold uppercase tracking-[0.14em] text-sage-dark/60">Lessons</h4>
                  <ol class="mt-3 space-y-2">
                    {lessons.length === 0 ? (
                      <li class="text-sm text-sage-dark/65">
                        {assignments.length > 0
                          ? 'No lessons in this module yet.'
                          : 'No assignments or lessons in this module yet.'}
                      </li>
                    ) : (
                      lessons.map((item, index) => (
                        <li class="rounded-xl border border-sage-dark/10 bg-[#f7f8fa] px-3 py-3">
                          <div class="flex items-center justify-between gap-3">
                            <div class="min-w-0">
                              <p class="text-[11px] text-sage-dark/50">Lesson {index + 1}</p>
                              <p class="mt-0.5 text-sm font-semibold text-charcoal">{item.title}</p>
                            </div>
                            <span class="shrink-0 rounded-full bg-sage-dark/10 px-2.5 py-1 text-[11px] font-semibold text-sage-dark/80">
                              Start
                            </span>
                          </div>
                        </li>
                      ))
                    )}
                  </ol>
                </section>
              </div>
            </dialog>
          ) : null
        }
      </div>

      {/* Column 3 — Detail editor */}
      <div class="flex min-h-0 flex-col lg:h-full">
        <div class="border-b border-sage-dark/10 bg-[#f7f8fa] px-3 py-2.5">
          <p class="text-xs font-semibold uppercase tracking-[0.12em] text-sage-dark/55">Editor</p>
          <p class="mt-0.5 text-[11px] text-sage-dark/55">
            {selectedItem
              ? `Editing “${selectedItem.title}”`
              : selectedView === 'settings' && selected
                ? `Settings for “${selected.title}”`
                : selected
                  ? 'Nothing selected yet'
                  : 'Open a module to begin'}
          </p>
        </div>
        <div class="min-h-0 flex-1 overflow-y-auto p-4">
          {
            !selected ? (
              <div class="flex h-full min-h-[12rem] items-center justify-center text-center">
                <div class="max-w-xs">
                  <p class="text-sm font-semibold text-charcoal">No module open</p>
                  <p class="mt-2 text-sm text-sage-dark/65">
                    Pick a module on the left, or create one, to see what’s inside.
                  </p>
                </div>
              </div>
            ) : selectedView === 'settings' ? (
              <div class="mx-auto max-w-lg">
                <h3 class="text-lg font-semibold text-charcoal">Module settings</h3>
                <form
                  method="post"
                  action="/api/training/admin"
                  class="mt-5 space-y-4"
                  data-training-autosave
                  data-training-autosave-ignore="textarea"
                >
                  <input type="hidden" name="action" value="update-module" />
                  <input type="hidden" name="moduleId" value={selected.id} />
                  <input type="hidden" name="returnView" value="settings" />
                  <input type="hidden" name="roleKeysConfigured" value="1" />
                  <label class="block text-sm font-medium text-charcoal">
                    Module title
                    <input class="field" type="text" name="title" value={selected.title} required />
                  </label>
                  <div class="rounded-xl bg-[#f7f8fa] p-3">
                    <p class="text-sm font-semibold text-charcoal">Who can see this?</p>
                    <p class="mt-1 text-xs text-sage-dark/60">Leave all checked to show everyone.</p>
                    <div class="mt-2 grid gap-1.5 sm:grid-cols-2">
                      {roles.map((role) => (
                        <label class="flex items-center gap-2 text-sm text-charcoal">
                          <input
                            type="checkbox"
                            name="roleKeys"
                            value={role.key}
                            checked={selected.roleKeys.length === 0 || selected.roleKeys.includes(role.key)}
                          />
                          {role.name}
                        </label>
                      ))}
                    </div>
                  </div>
                  <p class="text-[10px] text-sage-dark/50" data-training-autosave-status></p>
                  <label class="block text-sm font-medium text-charcoal">
                    Intro text
                    <span class="mt-0.5 block text-xs font-normal text-sage-dark/55">
                      Shown at the top of the module for learners. You can also edit this in the middle column.
                    </span>
                    <textarea class="field mt-1.5" name="description" rows="3">{selected.description}</textarea>
                  </label>
                  <div class="flex flex-wrap gap-2">
                    <button class="btn-primary !px-4 !py-2 text-sm" type="submit">Save intro text</button>
                    {selected.kind === 'custom' ? (
                      <button
                        class="rounded-full border border-red-200 px-4 py-2 text-sm font-semibold text-red-700"
                        type="submit"
                        name="action"
                        value="archive-module"
                        formnovalidate
                      >
                        Archive
                      </button>
                    ) : null}
                  </div>
                </form>
              </div>
            ) : selectedItem ? (
              <div class="mx-auto max-w-lg space-y-5">
                <div class="flex items-start justify-between gap-2">
                  <div class="min-w-0">
                    <p class="text-xs font-semibold uppercase tracking-[0.12em] text-sage-dark/50">
                      {selectedIsAssignment ? 'Assignment' : 'Lesson'}
                    </p>
                    <h3 class="mt-1 text-lg font-semibold text-charcoal" data-training-item-heading>
                      {selectedItem.title}
                    </h3>
                  </div>
                  <div class="flex shrink-0 flex-col items-end gap-1">
                    <details class="relative" data-training-item-settings>
                      <summary class="cursor-pointer list-none rounded-full bg-white px-2.5 py-1 text-[11px] font-semibold text-sage-dark ring-1 ring-sage-dark/15 [&::-webkit-details-marker]:hidden hover:bg-[#f4f5f8]">
                        Settings
                      </summary>
                      <form
                        method="post"
                        action="/api/training/admin"
                        class="absolute right-0 z-20 mt-1.5 w-72 rounded-xl border border-sage-dark/15 bg-white p-3 shadow-lg"
                        data-training-autosave
                      >
                        <input type="hidden" name="action" value="update-lesson" />
                        <input type="hidden" name="moduleId" value={selected.id} />
                        <input type="hidden" name="lessonId" value={selectedItem.id} />
                        <label class="block text-sm font-medium text-charcoal">
                          Title
                          <input
                            class="field"
                            type="text"
                            name="title"
                            value={selectedItem.title}
