                      ) : (
                        selectedBlocks.map((block) => {
                          const reqNote = canToggleBlockRequired(block.type)
                            ? block.required
                              ? ' · required'
                              : ' · optional'
                            : '';
                          if (block.type === 'video') {
                            const youtubeId = block.youtubeUrl ? extractYoutubeId(block.youtubeUrl) : null;
                            return (
                              <section class="rounded-xl border border-sage-dark/10 bg-[#f7f8fa] p-4">
                                <h4 class="text-xs font-semibold uppercase tracking-[0.14em] text-sage-dark/60">
                                  Video{reqNote}
                                </h4>
                                {youtubeId ? (
                                  <div class="mt-3 aspect-video overflow-hidden rounded-xl bg-black">
                                    <iframe
                                      class="h-full w-full"
                                      src={`https://www.youtube.com/embed/${youtubeId}`}
