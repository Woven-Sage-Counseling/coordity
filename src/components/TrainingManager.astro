                                      allowfullscreen
                                    />
                                  </div>
                                ) : (
                                  <p class="mt-3 text-sm text-sage-dark/65">Video coming soon.</p>
                                )}
                              </section>
                            );
                          }
                          if (block.type === 'written') {
                            return (
                              <section class="rounded-xl border border-sage-dark/10 bg-[#f7f8fa] p-4">
                                <h4 class="text-xs font-semibold uppercase tracking-[0.14em] text-sage-dark/60">
                                  Content{reqNote}
                                </h4>
                                <div class="mt-3 whitespace-pre-wrap text-sm leading-relaxed text-charcoal">
                                  {block.bodyText || 'Content coming soon.'}
                                </div>
                              </section>
