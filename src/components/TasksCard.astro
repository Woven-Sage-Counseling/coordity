---
import { listTasksForUser, serializeTask, type UserTask } from '../lib/tasks';
import { widgetAccentVarsStyle } from '../lib/home-widget-header';
import WidgetHeaderBar from './WidgetHeaderBar.astro';

interface Props {
  userId: string;
}

const { userId } = Astro.props;

let tasks: UserTask[] = [];
let tasksLoadError: string | null = null;
try {
  tasks = await listTasksForUser(userId, 50);
} catch (error) {
  console.error('tasks widget load failed', error);
  tasksLoadError = 'Tasks are temporarily unavailable.';
}
const error = Astro.url.searchParams.get('tasksError');

const initialFlash =
  error != null && error !== ''
    ? { kind: 'error' as const, text: error }
    : null;

const taskEditPillClass =
  'rounded-full bg-[#f4f5f8] px-2.5 py-1 text-[10px] font-semibold text-charcoal ring-1 ring-black/[0.06] transition hover:bg-sage-dark/10 disabled:opacity-60';
const taskDeletePillClass =
  'rounded-full bg-red-50 px-2.5 py-1 text-[10px] font-semibold text-red-800 ring-1 ring-red-200 transition hover:bg-red-100 disabled:opacity-60';
---

<aside
  class="flex h-full min-h-[28rem] flex-col overflow-hidden rounded-[1.05rem] shadow-[0_12px_32px_rgba(26,28,30,0.12)] ring-1 ring-black/10"
  aria-labelledby="home-tasks-heading"
  data-tasks-widget
  data-widget-card
  data-widget-id="tasks"
  style={widgetAccentVarsStyle('tasks')}
>
  <WidgetHeaderBar widgetId="tasks" title="Tasks" headingId="home-tasks-heading" />

  <div class="flex min-h-0 flex-1 flex-col bg-[#f4f5f8] px-4 pb-4 pt-3 font-sans text-[#393a3d]">
    <div data-tasks-flash hidden={!initialFlash}>
      {
        initialFlash ? (
          <p
            class:list={[
              'rounded-lg border px-2.5 py-2 text-[11px]',
              initialFlash.kind === 'error'
                ? 'border-red-200 bg-red-50 text-red-800'
                : 'border-sage-dark/15 bg-white text-sage-dark/80',
            ]}
          >
            {initialFlash.text}
          </p>
        ) : null
      }
    </div>

    <form
      method="post"
      action="/api/tasks/create"
      class="mt-2 flex gap-2"
      data-tasks-add-form
    >
      <input type="hidden" name="returnTo" value="/" />
      <label class="sr-only" for="home-task-title">New task</label>
      <input
        id="home-task-title"
        name="title"
        type="text"
        maxlength="500"
        required
        placeholder="Add a task…"
        class="min-w-0 flex-1 rounded-lg border border-sage-dark/15 bg-white px-2.5 py-2 text-[12px] text-charcoal shadow-sm outline-none ring-0 placeholder:text-[#6b6c72] focus:border-sage-dark/30"
        autocomplete="off"
      />
      <button
        type="submit"
        class="widget-accent-btn shrink-0 rounded-lg px-3 py-2 text-[11px] font-semibold"
      >
        Add
      </button>
    </form>

    <div class="mt-3 min-h-0 flex-1 overflow-y-auto overscroll-contain">
      <p class="text-[11px] font-semibold uppercase tracking-[0.14em] text-[#6b6c72]">Your tasks</p>
      {
        tasksLoadError ? (
          <p class="mt-2 rounded-lg border border-amber-200 bg-amber-50 px-2.5 py-2 text-[11px] text-amber-900">
            {tasksLoadError}
          </p>
        ) : null
      }
      <p class="mt-2 text-[12px] text-[#6b6c72]" data-tasks-empty hidden={tasks.length > 0 || tasksLoadError != null}>
        No tasks yet.
      </p>
      <ul class="mt-2 space-y-2" data-tasks-list hidden={tasks.length === 0}>
        {
          tasks.map((task) => {
            const serialized = serializeTask(task);
            const completed = serialized.completed;
            return (
              <li
                class="rounded-lg bg-white px-2.5 py-2 shadow-sm ring-1 ring-black/[0.06]"
                data-tasks-item
                data-task-id={task.id}
                data-completed={completed ? '1' : '0'}
              >
                <div class="flex items-start gap-2">
                  <form method="post" action="/api/tasks/toggle" class="mt-0.5 shrink-0" data-tasks-action="toggle">
                    <input type="hidden" name="taskId" value={task.id} />
                    <input type="hidden" name="completed" value={completed ? '0' : '1'} />
                    <input
                      type="checkbox"
                      class="h-4 w-4 rounded border-sage-dark/30 text-sage-dark focus:ring-sage-dark/30"
                      checked={completed}
                      aria-label={completed ? `Mark "${task.title}" incomplete` : `Mark "${task.title}" complete`}
                    />
                  </form>
                  <div class="min-w-0 flex-1" data-task-body>
                    <div data-task-display>
                      <p
                        class:list={[
                          'text-[12px] leading-snug text-charcoal',
                          completed && 'text-[#6b6c72] line-through',
                        ]}
                        data-task-title
                      >
                        {task.title}
                      </p>
                      {
                        serialized.assigned ? (
                          <p class="mt-0.5 text-[10px] text-sage-dark/70" data-task-assigned>
                            Assigned by {serialized.createdByName}
                          </p>
                        ) : null
                      }
                      <div class="mt-1.5 flex flex-wrap items-center gap-1.5" data-task-actions>
                        <button
                          type="button"
                          class={taskEditPillClass}
                          data-task-edit-open
                          aria-label={`Edit "${task.title}"`}
                        >
                          Edit
                        </button>
                        <form method="post" action="/api/tasks/delete" class="inline" data-tasks-action="delete">
                          <input type="hidden" name="taskId" value={task.id} />
                          <input type="hidden" name="returnTo" value="/" />
                          <button
                            type="submit"
                            class={taskDeletePillClass}
                            aria-label={`Delete "${task.title}"`}
                          >
                            Delete
                          </button>
                        </form>
                      </div>
                    </div>
                    <form
                      method="post"
                      action="/api/tasks/update"
                      class="mt-1 hidden flex-col gap-1.5"
                      data-tasks-action="edit"
                    >
                      <input type="hidden" name="taskId" value={task.id} />
                      <input type="hidden" name="returnTo" value="/" />
                      <input
                        name="title"
                        type="text"
                        maxlength="500"
                        required
                        value={task.title}
                        class="w-full rounded-md border border-sage-dark/15 bg-white px-2 py-1.5 text-[12px] text-charcoal outline-none focus:border-sage-dark/30"
                        data-task-edit-input
                      />
                      <div class="flex flex-wrap gap-1.5">
                        <button
                          type="submit"
                          class="rounded-full bg-sage-dark/10 px-2.5 py-1 text-[10px] font-semibold text-charcoal transition hover:bg-sage-dark/15"
                        >
                          Save
                        </button>
                        <button
                          type="button"
                          class="rounded-full bg-[#f4f5f8] px-2.5 py-1 text-[10px] font-semibold text-[#6b6c72] ring-1 ring-black/[0.06] transition hover:bg-sage-dark/10"
                          data-task-edit-cancel
                        >
                          Cancel
                        </button>
                      </div>
                    </form>
                  </div>
                </div>
              </li>
            );
          })
        }
      </ul>
    </div>
  </div>
</aside>

<script>
  type WidgetTask = {
    id: string;
    title: string;
    completed: boolean;
    assigned: boolean;
    createdByName: string;
    createdAtLabel: string;
  };

  type ApiResult =
    | { ok: true; task?: WidgetTask; taskId?: string; error?: undefined }
    | { ok: false; error?: string };

  function escapeHtml(value: string): string {
    return value
      .replaceAll('&', '&amp;')
      .replaceAll('<', '&lt;')
      .replaceAll('>', '&gt;')
      .replaceAll('"', '&quot;')
      .replaceAll("'", '&#39;');
  }

  function setFlash(root: HTMLElement, kind: 'ok' | 'error', text: string): void {
    const flash = root.querySelector('[data-tasks-flash]');
    if (!(flash instanceof HTMLElement)) return;
    const classes =
      kind === 'error'
        ? 'rounded-lg border border-red-200 bg-red-50 px-2.5 py-2 text-[11px] text-red-800'
        : 'rounded-lg border border-sage-dark/15 bg-white px-2.5 py-2 text-[11px] text-sage-dark/80';
    flash.innerHTML = `<p class="${classes}">${escapeHtml(text)}</p>`;
    flash.hidden = false;
  }

  function clearFlash(root: HTMLElement): void {
    const flash = root.querySelector('[data-tasks-flash]');
    if (!(flash instanceof HTMLElement)) return;
    flash.innerHTML = '';
    flash.hidden = true;
  }

  function syncListVisibility(root: HTMLElement): void {
    const list = root.querySelector('[data-tasks-list]');
    const empty = root.querySelector('[data-tasks-empty]');
    if (!(list instanceof HTMLElement) || !(empty instanceof HTMLElement)) return;
    const hasItems = list.querySelector('[data-tasks-item]') != null;
    list.hidden = !hasItems;
    empty.hidden = hasItems;
  }

  function renderTaskItem(task: WidgetTask): string {
    const assignedMeta = task.assigned
      ? `<p class="mt-0.5 text-[10px] text-sage-dark/70" data-task-assigned>Assigned by ${escapeHtml(task.createdByName)}</p>`
      : '';
    const titleClass = task.completed
      ? 'text-[12px] leading-snug text-[#6b6c72] line-through'
      : 'text-[12px] leading-snug text-charcoal';
    const editPillClass =
      'rounded-full bg-[#f4f5f8] px-2.5 py-1 text-[10px] font-semibold text-charcoal ring-1 ring-black/[0.06] transition hover:bg-sage-dark/10 disabled:opacity-60';
    const deletePillClass =
      'rounded-full bg-red-50 px-2.5 py-1 text-[10px] font-semibold text-red-800 ring-1 ring-red-200 transition hover:bg-red-100 disabled:opacity-60';

    return `<li
      class="rounded-lg bg-white px-2.5 py-2 shadow-sm ring-1 ring-black/[0.06]"
      data-tasks-item
      data-task-id="${escapeHtml(task.id)}"
      data-completed="${task.completed ? '1' : '0'}"
    >
      <div class="flex items-start gap-2">
        <form method="post" action="/api/tasks/toggle" class="mt-0.5 shrink-0" data-tasks-action="toggle">
          <input type="hidden" name="taskId" value="${escapeHtml(task.id)}" />
          <input type="hidden" name="completed" value="${task.completed ? '0' : '1'}" />
          <input
            type="checkbox"
            class="h-4 w-4 rounded border-sage-dark/30 text-sage-dark focus:ring-sage-dark/30"
            ${task.completed ? 'checked' : ''}
            aria-label="${task.completed ? 'Mark incomplete' : 'Mark complete'}"
          />
        </form>
        <div class="min-w-0 flex-1" data-task-body>
          <div data-task-display>
            <p class="${titleClass}" data-task-title>${escapeHtml(task.title)}</p>
            ${assignedMeta}
            <div class="mt-1.5 flex flex-wrap items-center gap-1.5" data-task-actions>
              <button
                type="button"
                class="${editPillClass}"
                data-task-edit-open
                aria-label="Edit task"
              >
                Edit
              </button>
              <form method="post" action="/api/tasks/delete" class="inline" data-tasks-action="delete">
                <input type="hidden" name="taskId" value="${escapeHtml(task.id)}" />
                <input type="hidden" name="returnTo" value="/" />
                <button type="submit" class="${deletePillClass}" aria-label="Delete task">
                  Delete
                </button>
              </form>
            </div>
          </div>
          <form method="post" action="/api/tasks/update" class="mt-1 hidden flex-col gap-1.5" data-tasks-action="edit">
            <input type="hidden" name="taskId" value="${escapeHtml(task.id)}" />
            <input type="hidden" name="returnTo" value="/" />
            <input
              name="title"
              type="text"
              maxlength="500"
              required
              value="${escapeHtml(task.title)}"
              class="w-full rounded-md border border-sage-dark/15 bg-white px-2 py-1.5 text-[12px] text-charcoal outline-none focus:border-sage-dark/30"
              data-task-edit-input
            />
            <div class="flex flex-wrap gap-1.5">
              <button
                type="submit"
                class="rounded-full bg-sage-dark/10 px-2.5 py-1 text-[10px] font-semibold text-charcoal transition hover:bg-sage-dark/15"
              >
                Save
              </button>
              <button
                type="button"
                class="rounded-full bg-[#f4f5f8] px-2.5 py-1 text-[10px] font-semibold text-[#6b6c72] ring-1 ring-black/[0.06] transition hover:bg-sage-dark/10"
                data-task-edit-cancel
              >
                Cancel
              </button>
            </div>
          </form>
        </div>
      </div>
    </li>`;
  }

  function closeTaskEdit(item: HTMLElement, restore = true): void {
    const display = item.querySelector('[data-task-display]');
    const form = item.querySelector('[data-tasks-action="edit"]');
    const editOpen = item.querySelector('[data-task-edit-open]');
    const title = item.querySelector('[data-task-title]');
    const input = item.querySelector('[data-task-edit-input]');

    if (form instanceof HTMLFormElement) {
      if (restore && title instanceof HTMLElement && input instanceof HTMLInputElement) {
        input.value = title.textContent ?? '';
      }
      form.classList.add('hidden');
      form.classList.remove('flex');
    }
    display?.classList.remove('hidden');
    if (editOpen instanceof HTMLButtonElement) editOpen.disabled = false;
  }

  function closeAllTaskEdits(root: HTMLElement, except?: HTMLElement): void {
    root.querySelectorAll('[data-tasks-item]').forEach((node) => {
      if (!(node instanceof HTMLElement)) return;
      if (except && node === except) return;
      closeTaskEdit(node);
    });
  }

  function openTaskEdit(item: HTMLElement): void {
    const display = item.querySelector('[data-task-display]');
    const form = item.querySelector('[data-tasks-action="edit"]');
    const editOpen = item.querySelector('[data-task-edit-open]');
    const input = item.querySelector('[data-task-edit-input]');
    const title = item.querySelector('[data-task-title]');

    if (!(form instanceof HTMLFormElement) || !(input instanceof HTMLInputElement)) return;

    const widget = item.closest('[data-tasks-widget]');
    if (widget instanceof HTMLElement) closeAllTaskEdits(widget, item);
    if (title instanceof HTMLElement) input.value = title.textContent ?? '';
    display?.classList.add('hidden');
    form.classList.remove('hidden');
    form.classList.add('flex');
    if (editOpen instanceof HTMLButtonElement) editOpen.disabled = true;
    input.focus();
    input.select();
  }

  function prependTask(root: HTMLElement, task: WidgetTask): void {
    const list = root.querySelector('[data-tasks-list]');
    if (!(list instanceof HTMLElement)) return;
    list.insertAdjacentHTML('afterbegin', renderTaskItem(task));
    syncListVisibility(root);
  }

  function updateTaskItem(root: HTMLElement, item: HTMLElement, task: WidgetTask): void {
    item.dataset.completed = task.completed ? '1' : '0';
    const title = item.querySelector('[data-task-title]');
    if (title instanceof HTMLElement) {
      title.textContent = task.title;
      title.classList.toggle('line-through', task.completed);
      title.classList.toggle('text-[#6b6c72]', task.completed);
      title.classList.toggle('text-charcoal', !task.completed);
    }
    const editInput = item.querySelector('[data-task-edit-input]');
    if (editInput instanceof HTMLInputElement) {
      editInput.value = task.title;
    }
    const editOpen = item.querySelector('[data-task-edit-open]');
    if (editOpen instanceof HTMLButtonElement) {
      editOpen.setAttribute('aria-label', `Edit "${task.title}"`);
    }
    const deleteButton = item.querySelector('[data-tasks-action="delete"] button[type="submit"]');
    if (deleteButton instanceof HTMLButtonElement) {
      deleteButton.setAttribute('aria-label', `Delete "${task.title}"`);
    }
    const toggleForm = item.querySelector('[data-tasks-action="toggle"]');
    if (toggleForm instanceof HTMLFormElement) {
      const completedInput = toggleForm.querySelector('input[name="completed"]');
      const checkbox = toggleForm.querySelector('input[type="checkbox"]');
      if (completedInput instanceof HTMLInputElement) {
        completedInput.value = task.completed ? '0' : '1';
      }
      if (checkbox instanceof HTMLInputElement) {
        checkbox.checked = task.completed;
      }
    }
    reorderTasks(root);
  }

  function removeTask(root: HTMLElement, taskId: string): void {
    const item = root.querySelector(`[data-tasks-item][data-task-id="${CSS.escape(taskId)}"]`);
    item?.remove();
    syncListVisibility(root);
  }

  function reorderTasks(root: HTMLElement): void {
    const list = root.querySelector('[data-tasks-list]');
    if (!(list instanceof HTMLElement)) return;
    const items = Array.from(list.querySelectorAll('[data-tasks-item]')).filter(
      (node): node is HTMLElement => node instanceof HTMLElement,
    );
    items.sort((a, b) => {
      const aDone = a.dataset.completed === '1';
      const bDone = b.dataset.completed === '1';
      if (aDone !== bDone) return aDone ? 1 : -1;
      return 0;
    });
    items.forEach((item) => list.appendChild(item));
  }

  async function postForm(form: HTMLFormElement): Promise<ApiResult> {
    const response = await fetch(form.action, {
      method: 'POST',
      body: new FormData(form),
      headers: { Accept: 'application/json' },
      credentials: 'same-origin',
    });

    let payload: ApiResult;
    try {
      payload = (await response.json()) as ApiResult;
    } catch {
      return { ok: false, error: 'Something went wrong. Please try again.' };
    }

    if (!response.ok || !payload.ok) {
      return { ok: false, error: payload.error || 'Something went wrong. Please try again.' };
    }

    return payload;
  }

  function setBusy(form: HTMLFormElement, busy: boolean): void {
    form.querySelectorAll('button[type="submit"]').forEach((button) => {
      if (button instanceof HTMLButtonElement) button.disabled = busy;
    });
  }

  document.querySelectorAll('[data-tasks-widget]').forEach((root) => {
    if (!(root instanceof HTMLElement)) return;

    const addForm = root.querySelector('[data-tasks-add-form]');
    if (addForm instanceof HTMLFormElement) {
      addForm.addEventListener('submit', (event) => {
        event.preventDefault();
        void (async () => {
          clearFlash(root);
          setBusy(addForm, true);
          try {
            const result = await postForm(addForm);
            if (!result.ok || !result.task) {
              setFlash(root, 'error', result.error || 'Unable to add that task.');
              return;
            }
            prependTask(root, result.task);
            addForm.reset();
          } finally {
            setBusy(addForm, false);
          }
        })();
      });
    }

    root.addEventListener('change', (event) => {
      const target = event.target;
      if (!(target instanceof HTMLInputElement) || target.type !== 'checkbox') return;
      const form = target.form;
      if (!(form instanceof HTMLFormElement)) return;
      if (form.getAttribute('data-tasks-action') !== 'toggle') return;

      void (async () => {
        clearFlash(root);
        setBusy(form, true);
        try {
          const result = await postForm(form);
          if (!result.ok || !result.task) {
            target.checked = !target.checked;
            setFlash(root, 'error', result.error || 'Unable to update that task.');
            return;
          }
          const item = form.closest('[data-tasks-item]');
          if (item instanceof HTMLElement) updateTaskItem(root, item, result.task);
        } finally {
          setBusy(form, false);
        }
      })();
    });

    root.addEventListener('click', (event) => {
      const target = event.target;
      if (!(target instanceof HTMLElement)) return;

      const editOpen = target.closest('[data-task-edit-open]');
      if (editOpen instanceof HTMLButtonElement) {
        const item = editOpen.closest('[data-tasks-item]');
        if (item instanceof HTMLElement) openTaskEdit(item);
        return;
      }

      const editCancel = target.closest('[data-task-edit-cancel]');
      if (editCancel instanceof HTMLButtonElement) {
        const item = editCancel.closest('[data-tasks-item]');
        if (item instanceof HTMLElement) closeTaskEdit(item);
      }
    });

    root.addEventListener('submit', (event) => {
      const form = event.target;
      if (!(form instanceof HTMLFormElement)) return;

      if (form.getAttribute('data-tasks-action') === 'edit') {
        event.preventDefault();
        void (async () => {
          clearFlash(root);
          setBusy(form, true);
          try {
            const result = await postForm(form);
            if (!result.ok || !result.task) {
              setFlash(root, 'error', result.error || 'Unable to update that task.');
              return;
            }
            const item = form.closest('[data-tasks-item]');
            if (item instanceof HTMLElement) {
              closeTaskEdit(item, false);
              updateTaskItem(root, item, result.task);
            }
          } finally {
            setBusy(form, false);
          }
        })();
        return;
      }

      if (form.getAttribute('data-tasks-action') !== 'delete') return;

      event.preventDefault();
      if (!window.confirm('Delete this task?')) return;

      void (async () => {
        clearFlash(root);
        setBusy(form, true);
        try {
          const result = await postForm(form);
          if (!result.ok) {
            setFlash(root, 'error', result.error || 'Unable to delete that task.');
            return;
          }
          const taskId =
            result.taskId || String(new FormData(form).get('taskId') ?? '').trim();
          if (taskId) removeTask(root, taskId);
        } finally {
          setBusy(form, false);
        }
      })();
    });
  });
</script>
