---
import { widgetAccentVarsStyle } from '../lib/home-widget-header';
import TasksPanel from './TasksPanel.astro';
import WidgetHeaderBar from './WidgetHeaderBar.astro';

interface Props {
  userId: string;
}

const { userId } = Astro.props;
const error = Astro.url.searchParams.get('tasksError');
const initialError = error != null && error !== '' ? error : null;
---

<aside
  class="flex h-full min-h-0 max-h-full flex-col overflow-hidden rounded-[1.05rem] shadow-[0_12px_32px_rgba(26,28,30,0.12)] ring-1 ring-black/10"
  aria-labelledby="home-tasks-heading"
  data-tasks-widget
  data-widget-card
  data-widget-id="tasks"
  style={widgetAccentVarsStyle('tasks')}
>
  <WidgetHeaderBar widgetId="tasks" title="Tasks" headingId="home-tasks-heading" openHref="/tasks" />

  <div class="flex min-h-0 flex-1 flex-col bg-[#f4f5f8] font-sans text-[#393a3d]">
    <TasksPanel userId={userId} mode="widget" returnTo="/" initialError={initialError} />
  </div>
</aside>
