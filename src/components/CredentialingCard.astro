---
import {
  canLookupAnyProvider,
  coverageStatusLabel,
  getProviderForUser,
  listProvidersForLookup,
  listProviderCoverage,
  type ProviderCoverageRow,
} from '../lib/credentialing';

interface Props {
  employee: PortalEmployee;
}

const { employee } = Astro.props;
const canPickProvider = canLookupAnyProvider(employee);
const providers = canPickProvider ? await listProvidersForLookup() : [];

const linkedProvider = await getProviderForUser(employee.id);
const initialProviderId = canPickProvider
  ? (providers[0]?.id ?? '')
  : (linkedProvider?.id ?? '');

const initialCoverage =
  initialProviderId.length > 0 ? await listProviderCoverage(initialProviderId) : [];

function groupCoverage(rows: ProviderCoverageRow[]) {
  const map = new Map<string, { groupName: string; plans: ProviderCoverageRow[] }>();
  for (const row of rows) {
    const existing = map.get(row.groupId);
    if (existing) {
      existing.plans.push(row);
    } else {
      map.set(row.groupId, { groupName: row.groupName, plans: [row] });
    }
  }
  return [...map.entries()].map(([groupId, value]) => ({ groupId, ...value }));
}

const initialGroups = groupCoverage(initialCoverage);
const acceptedCount = initialCoverage.filter((row) => row.status === 'accepted').length;
const credentialingCount = initialCoverage.filter((row) => row.status === 'credentialing').length;
---

<aside
  class="flex h-full min-h-[28rem] flex-col overflow-hidden rounded-[1.05rem] shadow-[0_12px_32px_rgba(26,28,30,0.12)] ring-1 ring-black/10"
  aria-labelledby="home-credentialing-heading"
  data-credentialing-widget
  data-can-pick={canPickProvider ? '1' : '0'}
>
  <div class="bg-sage-dark px-3 py-2.5 text-cream">
    <div class="flex items-center justify-between gap-2">
      <div class="flex items-center gap-2">
        <span
          class="flex h-7 w-7 items-center justify-center rounded-md bg-white/15 text-cream ring-1 ring-white/20"
          aria-hidden="true"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
            <path
              d="M9 12l2 2 4-4M7 4h10a2 2 0 0 1 2 2v14l-7-3-7 3V6a2 2 0 0 1 2-2Z"
              stroke="currentColor"
              stroke-width="1.75"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </span>
        <h2 id="home-credentialing-heading" class="text-sm font-semibold leading-none">Credentialing</h2>
      </div>
      <a
        href="/credentialing"
        class="rounded-md bg-white/15 px-2 py-1 text-[10px] font-semibold uppercase tracking-wide text-cream ring-1 ring-white/20 transition hover:bg-white/25"
      >
        Open
      </a>
    </div>
  </div>

  <div class="flex min-h-0 flex-1 flex-col bg-[#f4f5f8] px-4 pb-4 pt-3 font-sans text-[#393a3d]">
    {
      canPickProvider ? (
        <label class="block text-[11px] font-semibold text-[#393a3d]">
          Provider
          <select
            class="mt-1 w-full rounded-md border border-[#d5d8de] bg-white px-2 py-1.5 text-[12px] text-[#393a3d]"
            data-credentialing-provider
          >
            {providers.length === 0 ? (
              <option value="">No providers yet</option>
            ) : (
              providers.map((provider) => (
                <option value={provider.id} selected={provider.id === initialProviderId}>
                  {provider.name}
                </option>
              ))
            )}
          </select>
        </label>
      ) : (
        <div class="rounded-lg bg-white px-3 py-2 shadow-sm ring-1 ring-black/[0.06]">
          <p class="text-[11px] font-semibold uppercase tracking-[0.14em] text-[#6b6c72]">Provider</p>
          <p class="mt-1 text-[12px] font-semibold text-charcoal" data-credentialing-provider-name>
            {linkedProvider ? linkedProvider.name : 'Not linked yet'}
          </p>
          {!linkedProvider ? (
            <p class="mt-1 text-[10px] text-[#6b6c72]">
              Ask an admin to link your account to a credentialing provider.
            </p>
          ) : null}
        </div>
      )
    }

    <label class="mt-3 block text-[11px] font-semibold text-[#393a3d]">
      Search
      <input
        class="mt-1 w-full rounded-md border border-[#d5d8de] bg-white px-2 py-1.5 text-[12px]"
        type="search"
        placeholder="Group or plan…"
        data-credentialing-search
        disabled={!initialProviderId}
      />
    </label>

    <div class="mt-3 flex gap-2 text-[10px] font-semibold uppercase tracking-wide">
      <span class="rounded-full bg-emerald-100 px-2 py-0.5 text-emerald-900" data-credentialing-accepted-count>
        {acceptedCount} accepted
      </span>
      <span class="rounded-full bg-amber-100 px-2 py-0.5 text-amber-900" data-credentialing-credentialing-count>
        {credentialingCount} credentialing
      </span>
    </div>

    <div class="mt-3 min-h-0 flex-1 overflow-y-auto overscroll-contain" data-credentialing-list>
      {
        !initialProviderId ? (
          <p class="text-[12px] text-[#6b6c72]" data-credentialing-empty>
            No provider selected.
          </p>
        ) : initialCoverage.length === 0 ? (
          <p class="text-[12px] text-[#6b6c72]" data-credentialing-empty>
            No coverage listed yet.
          </p>
        ) : (
          <div class="space-y-3" data-credentialing-groups>
            {initialGroups.map((group) => (
              <div data-credentialing-group data-group-name={group.groupName.toLowerCase()}>
                <p class="text-[11px] font-semibold uppercase tracking-[0.14em] text-[#6b6c72]">
                  {group.groupName}
                </p>
                <ul class="mt-1.5 space-y-1.5">
                  {group.plans.map((plan) => (
                    <li
                      class="rounded-lg bg-white px-2.5 py-2 shadow-sm ring-1 ring-black/[0.06]"
                      data-credentialing-plan
                      data-search-text={`${group.groupName} ${plan.planName}`.toLowerCase()}
                    >
                      <div class="flex items-start justify-between gap-2">
                        <p class="text-[11px] font-medium leading-snug text-[#393a3d]">{plan.planName}</p>
                        <span
                          class:list={[
                            'shrink-0 rounded-full px-1.5 py-0.5 text-[9px] font-semibold uppercase tracking-wide',
                            plan.status === 'accepted'
                              ? 'bg-emerald-100 text-emerald-900'
                              : 'bg-amber-100 text-amber-900',
                          ]}
                        >
                          {coverageStatusLabel(plan.status)}
                        </span>
                      </div>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        )
      }
    </div>
  </div>
</aside>

<script>
  type CoverageRow = {
    coverageId: string;
    planId: string;
    planName: string;
    groupId: string;
    groupName: string;
    status: 'accepted' | 'credentialing';
  };

  function escapeHtml(value: string): string {
    return value
      .replaceAll('&', '&amp;')
      .replaceAll('<', '&lt;')
      .replaceAll('>', '&gt;')
      .replaceAll('"', '&quot;');
  }

  function statusLabel(status: CoverageRow['status']): string {
    return status === 'accepted' ? 'Accepted' : 'Credentialing';
  }

  function renderCoverage(list: HTMLElement, rows: CoverageRow[]): void {
    const accepted = rows.filter((row) => row.status === 'accepted').length;
    const credentialing = rows.filter((row) => row.status === 'credentialing').length;
    const root = list.closest('[data-credentialing-widget]');
    root?.querySelector('[data-credentialing-accepted-count]')?.replaceChildren(
      document.createTextNode(`${accepted} accepted`),
    );
    root?.querySelector('[data-credentialing-credentialing-count]')?.replaceChildren(
      document.createTextNode(`${credentialing} credentialing`),
    );

    if (rows.length === 0) {
      list.innerHTML = `<p class="text-[12px] text-[#6b6c72]" data-credentialing-empty>No coverage listed yet.</p>`;
      return;
    }

    const groups = new Map<string, { groupName: string; plans: CoverageRow[] }>();
    for (const row of rows) {
      const existing = groups.get(row.groupId);
      if (existing) existing.plans.push(row);
      else groups.set(row.groupId, { groupName: row.groupName, plans: [row] });
    }

    const html = [...groups.values()]
      .map((group) => {
        const plans = group.plans
          .map((plan) => {
            const badge =
              plan.status === 'accepted'
                ? 'bg-emerald-100 text-emerald-900'
                : 'bg-amber-100 text-amber-900';
            return `<li
              class="rounded-lg bg-white px-2.5 py-2 shadow-sm ring-1 ring-black/[0.06]"
              data-credentialing-plan
              data-search-text="${escapeHtml(`${group.groupName} ${plan.planName}`.toLowerCase())}"
            >
              <div class="flex items-start justify-between gap-2">
                <p class="text-[11px] font-medium leading-snug text-[#393a3d]">${escapeHtml(plan.planName)}</p>
                <span class="shrink-0 rounded-full px-1.5 py-0.5 text-[9px] font-semibold uppercase tracking-wide ${badge}">
                  ${statusLabel(plan.status)}
                </span>
              </div>
            </li>`;
          })
          .join('');
        return `<div data-credentialing-group data-group-name="${escapeHtml(group.groupName.toLowerCase())}">
          <p class="text-[11px] font-semibold uppercase tracking-[0.14em] text-[#6b6c72]">${escapeHtml(group.groupName)}</p>
          <ul class="mt-1.5 space-y-1.5">${plans}</ul>
        </div>`;
      })
      .join('');

    list.innerHTML = `<div class="space-y-3" data-credentialing-groups>${html}</div>`;
  }

  function applySearch(root: HTMLElement): void {
    const input = root.querySelector('[data-credentialing-search]');
    const query =
      input instanceof HTMLInputElement ? input.value.trim().toLowerCase() : '';
    root.querySelectorAll('[data-credentialing-group]').forEach((group) => {
      if (!(group instanceof HTMLElement)) return;
      let visible = 0;
      group.querySelectorAll('[data-credentialing-plan]').forEach((plan) => {
        if (!(plan instanceof HTMLElement)) return;
        const haystack = plan.dataset.searchText ?? '';
        const show = !query || haystack.includes(query);
        plan.hidden = !show;
        if (show) visible += 1;
      });
      group.hidden = visible === 0;
    });
  }

  document.querySelectorAll('[data-credentialing-widget]').forEach((root) => {
    if (!(root instanceof HTMLElement)) return;
    const list = root.querySelector('[data-credentialing-list]');
    const search = root.querySelector('[data-credentialing-search]');
    const select = root.querySelector('[data-credentialing-provider]');
    if (!(list instanceof HTMLElement)) return;

    search?.addEventListener('input', () => applySearch(root));

    if (select instanceof HTMLSelectElement) {
      select.addEventListener('change', () => {
        void (async () => {
          const providerId = select.value;
          if (search instanceof HTMLInputElement) {
            search.value = '';
            search.disabled = !providerId;
          }
          if (!providerId) {
            list.innerHTML = `<p class="text-[12px] text-[#6b6c72]">No provider selected.</p>`;
            return;
          }
          list.innerHTML = `<p class="text-[12px] text-[#6b6c72]">Loading…</p>`;
          try {
            const response = await fetch(
              `/api/credentialing/coverage?providerId=${encodeURIComponent(providerId)}`,
              { headers: { Accept: 'application/json' }, credentials: 'same-origin' },
            );
            const payload = (await response.json()) as { ok?: boolean; coverage?: CoverageRow[]; error?: string };
            if (!response.ok || !payload.ok || !payload.coverage) {
              list.innerHTML = `<p class="text-[12px] text-red-700">${escapeHtml(payload.error || 'Unable to load coverage.')}</p>`;
              return;
            }
            renderCoverage(list, payload.coverage);
            applySearch(root);
          } catch {
            list.innerHTML = `<p class="text-[12px] text-red-700">Unable to load coverage.</p>`;
          }
        })();
      });
    }
  });
</script>
