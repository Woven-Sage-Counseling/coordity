---
import {
  COVERAGE_STATUS_OPTIONS,
  coverageStatusPillClass,
  type CoverageStatus,
  type CredentialingProvider,
  type InsuranceGroup,
} from '../lib/credentialing';
import SectionHeading from './SectionHeading.astro';

interface Props {
  providers: CredentialingProvider[];
  catalog: InsuranceGroup[];
  coverageMap: Record<string, CoverageStatus>;
}

const { providers, catalog, coverageMap } = Astro.props;

const statusOptions = COVERAGE_STATUS_OPTIONS.map((option) => ({
  value: option.value,
  label: option.label,
  pillClass: coverageStatusPillClass(option.value),
}));
---

<div
  class=""
  data-coverage-matrix
  data-providers={JSON.stringify(providers.map((p) => ({ id: p.id, name: p.name })))}
  data-catalog={JSON.stringify(catalog)}
  data-coverage={JSON.stringify(coverageMap)}
  data-status-options={JSON.stringify(statusOptions)}
>
  <div class="flex flex-wrap items-end justify-between gap-3">
    <SectionHeading
      title="Provider coverage"
      description="Plan-level detail for the provider selected above. Click any status pill to change coverage for that provider and plan. Network checkboxes apply to every plan in that company."
    />
    <p class="text-xs text-sage-dark/55" data-matrix-feedback hidden aria-live="polite"></p>
  </div>

  <div class="mt-4 flex flex-col gap-3 sm:flex-row sm:items-end">
    <label class="block min-w-[10rem] flex-1 text-sm font-medium text-charcoal">
      Provider
      <select class="field mt-1" data-matrix-provider-filter>
        <option value="all">All providers</option>
        {providers.map((provider) => (
          <option value={provider.id}>{provider.name}</option>
        ))}
      </select>
    </label>
    <label class="block min-w-[12rem] flex-1 text-sm font-medium text-charcoal">
      Search
      <input
        class="field mt-1"
        type="search"
        placeholder="Insurance company or plan…"
        data-matrix-search
      />
    </label>
  </div>

  <p class="mt-3 hidden text-sm text-sage-dark/65 md:hidden" data-matrix-mobile-hint>
    Select a provider to view and edit coverage on smaller screens.
  </p>

  <div class="mt-4 hidden overflow-x-auto rounded-2xl border border-sage-dark/10 bg-white/90 shadow-sm md:block" data-matrix-desktop></div>
  <div class="mt-4 space-y-4 md:hidden" data-matrix-mobile></div>

  <p class="mt-4 hidden text-sm text-sage-dark/65" data-matrix-empty>
    Add insurance companies, plans, and directory clinicians to manage coverage.
  </p>
</div>

<script>
  type ProviderRow = { id: string; name: string };
  type PlanRow = { id: string; groupId: string; name: string; sortOrder: number };
  type GroupRow = { id: string; name: string; sortOrder: number; plans: PlanRow[] };
  type StatusOption = { value: string; label: string; pillClass: string };
  type CoverageStatusKey = string;

  function escapeHtml(value: string): string {
    return value
      .replaceAll('&', '&amp;')
      .replaceAll('<', '&lt;')
      .replaceAll('>', '&gt;')
      .replaceAll('"', '&quot;');
  }

  function cellKey(providerId: string, planId: string): string {
    return `${providerId}:${planId}`;
  }

  function setupCoverageMatrix(root: HTMLElement) {
    const providers = JSON.parse(root.dataset.providers ?? '[]') as ProviderRow[];
    const catalog = JSON.parse(root.dataset.catalog ?? '[]') as GroupRow[];
    const coverage = JSON.parse(root.dataset.coverage ?? '{}') as Record<string, CoverageStatusKey>;
    const statusOptions = JSON.parse(root.dataset.statusOptions ?? '[]') as StatusOption[];

    const providerFilter = root.querySelector('[data-matrix-provider-filter]') as HTMLSelectElement | null;
    const searchInput = root.querySelector('[data-matrix-search]') as HTMLInputElement | null;
    const desktop = root.querySelector('[data-matrix-desktop]') as HTMLElement | null;
    const mobile = root.querySelector('[data-matrix-mobile]') as HTMLElement | null;
    const empty = root.querySelector('[data-matrix-empty]') as HTMLElement | null;
    const mobileHint = root.querySelector('[data-matrix-mobile-hint]') as HTMLElement | null;
    const feedback = root.querySelector('[data-matrix-feedback]') as HTMLElement | null;

    let openCell: { providerId: string; planId: string; anchor: HTMLElement } | null = null;
    let menu: HTMLElement | null = null;
    let dismissMenu: ((event?: Event) => void) | null = null;

    const statusMeta = new Map(statusOptions.map((option) => [option.value, option]));
    statusMeta.set('not_started', statusMeta.get('not_started') ?? {
      value: 'not_started',
      label: 'Not started',
      pillClass: 'bg-slate-100 text-slate-600',
    });

    function getStatus(providerId: string, planId: string): CoverageStatusKey {
      return coverage[cellKey(providerId, planId)] ?? 'not_started';
    }

    function setFeedback(message: string, tone: 'neutral' | 'error' = 'neutral') {
      if (!feedback) return;
      feedback.textContent = message;
      feedback.hidden = !message;
      feedback.classList.toggle('text-red-700', tone === 'error');
      feedback.classList.toggle('text-sage-dark/55', tone !== 'error');
    }

    function renderPill(status: CoverageStatusKey, extraClass = ''): string {
      const meta = statusMeta.get(status) ?? statusMeta.get('not_started')!;
      const isNotStarted = status === 'not_started';
      const pillClass = isNotStarted
        ? `${meta.pillClass} border border-dashed border-slate-300/90`
        : `${meta.pillClass} border border-transparent`;
      return `<button
        type="button"
        class="coverage-status-pill inline-flex max-w-full cursor-pointer items-center gap-0.5 rounded-full px-2 py-0.5 text-[10px] font-semibold uppercase tracking-wide transition hover:brightness-95 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sage-dark/25 ${pillClass} ${extraClass}"
        data-status-value="${escapeHtml(status)}"
        aria-label="Change coverage status (currently ${escapeHtml(meta.label)})"
        aria-haspopup="listbox"
      ><span>${escapeHtml(meta.label)}</span><svg class="h-2.5 w-2.5 shrink-0 opacity-70" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M3 4.5 6 7.5 9 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></button>`;
    }

    function visibleProviders(filter: string): ProviderRow[] {
      if (filter === 'all') return providers;
      const match = providers.find((provider) => provider.id === filter);
      return match ? [match] : [];
    }

    function matchesSearch(group: GroupRow, plan: PlanRow, query: string): boolean {
      if (!query) return true;
      const haystack = `${group.name} ${plan.name}`.toLowerCase();
      return haystack.includes(query);
    }

    function renderCell(providerId: string, planId: string): string {
      const status = getStatus(providerId, planId);
      return `<td class="relative px-3 py-2 align-middle" data-matrix-cell data-provider-id="${escapeHtml(providerId)}" data-plan-id="${escapeHtml(planId)}">
        ${renderPill(status)}
      </td>`;
    }

    function renderDesktop(filter: string, query: string) {
      if (!desktop) return;
      const visible = visibleProviders(filter);
      const hasPlans = catalog.some((group) => group.plans.length > 0);

      if (providers.length === 0 || !hasPlans) {
        desktop.classList.add('hidden');
        empty?.classList.remove('hidden');
        return;
      }

      empty?.classList.add('hidden');
      desktop.classList.remove('hidden');

      const headerCells = visible
        .map(
          (provider) =>
            `<th class="px-3 py-2 text-left text-xs font-semibold text-sage-dark/70">${escapeHtml(provider.name)}</th>`,
        )
        .join('');

      const body = catalog
        .map((group) => {
          const visiblePlans = group.plans.filter((plan) => matchesSearch(group, plan, query));
          if (visiblePlans.length === 0) return '';

          const planRows = visiblePlans
            .map(
              (plan) => `<tr data-matrix-plan-row data-search-text="${escapeHtml(`${group.name} ${plan.name}`.toLowerCase())}">
                <th scope="row" class="sticky left-0 z-[1] bg-white px-4 py-2 text-left text-sm font-medium text-charcoal shadow-[1px_0_0_0_rgba(0,0,0,0.04)]">
                  ${escapeHtml(plan.name)}
                </th>
                ${visible.map((provider) => renderCell(provider.id, plan.id)).join('')}
              </tr>`,
            )
            .join('');

          return `<tbody data-matrix-group data-group-id="${escapeHtml(group.id)}" data-search-text="${escapeHtml(group.name.toLowerCase())}">
            <tr class="bg-[#fafbf9]">
              <td colspan="${visible.length + 1}" class="px-4 py-2">
                <div class="flex flex-wrap items-center justify-between gap-2">
                  <p class="text-sm font-semibold text-charcoal">${escapeHtml(group.name)}</p>
                </div>
              </td>
            </tr>
            ${planRows}
          </tbody>`;
        })
        .join('');

      desktop.innerHTML = `<table class="min-w-full border-collapse text-sm">
        <thead>
          <tr class="border-b border-sage-dark/10">
            <th class="sticky left-0 z-[1] bg-white px-4 py-2 text-left text-xs font-semibold uppercase tracking-wide text-sage-dark/55 shadow-[1px_0_0_0_rgba(0,0,0,0.04)]">Plan</th>
            ${headerCells}
          </tr>
        </thead>
        ${body}
      </table>`;
    }

    function renderMobile(filter: string, query: string) {
      if (!mobile) return;
      const visible = visibleProviders(filter);
      const hasPlans = catalog.some((group) => group.plans.length > 0);

      if (providers.length === 0 || !hasPlans) {
        mobile.classList.add('hidden');
        return;
      }

      if (filter === 'all') {
        mobile.classList.add('hidden');
        mobileHint?.classList.remove('hidden');
        return;
      }

      mobileHint?.classList.add('hidden');
      mobile.classList.remove('hidden');

      const provider = visible[0];
      if (!provider) {
        mobile.innerHTML = '';
        return;
      }

      mobile.innerHTML = catalog
        .map((group) => {
          const visiblePlans = group.plans.filter((plan) => matchesSearch(group, plan, query));
          if (visiblePlans.length === 0) return '';

          const plans = visiblePlans
            .map(
              (plan) => `<li class="relative flex items-center justify-between gap-3 rounded-xl bg-[#fafbf9] px-3 py-2" data-matrix-cell data-provider-id="${escapeHtml(provider.id)}" data-plan-id="${escapeHtml(plan.id)}" data-search-text="${escapeHtml(`${group.name} ${plan.name}`.toLowerCase())}">
                <span class="text-sm text-charcoal">${escapeHtml(plan.name)}</span>
                ${renderPill(getStatus(provider.id, plan.id))}
              </li>`,
            )
            .join('');

          return `<section class="overflow-hidden rounded-2xl border border-sage-dark/10 bg-white/90 shadow-sm" data-matrix-group data-group-id="${escapeHtml(group.id)}" data-search-text="${escapeHtml(group.name.toLowerCase())}">
            <div class="border-b border-sage-dark/10 bg-[#fafbf9] px-4 py-2.5">
              <p class="text-sm font-semibold text-charcoal">${escapeHtml(group.name)}</p>
            </div>
            <ul class="space-y-2 p-3">${plans}</ul>
          </section>`;
        })
        .join('');
    }

    function render() {
      closeMenu();
      const filter = providerFilter?.value ?? 'all';
      const query = searchInput?.value.trim().toLowerCase() ?? '';
      renderDesktop(filter, query);
      renderMobile(filter, query);
    }

    function detachMenuListeners() {
      if (!dismissMenu) return;
      document.removeEventListener('scroll', dismissMenu, true);
      window.removeEventListener('resize', dismissMenu);
      document.removeEventListener('pointerdown', dismissMenu, true);
      dismissMenu = null;
    }

    function renderMenuOptions(): string {
      return statusOptions
        .map(
          (option) => `<button
            type="button"
            role="option"
            class="flex w-full items-center gap-2 px-3 py-2 text-left text-sm text-charcoal hover:bg-sage/10"
            data-status-choice="${escapeHtml(option.value)}"
          >
            <span class="inline-flex rounded-full px-2 py-0.5 text-[10px] font-semibold uppercase tracking-wide ${option.pillClass}">${escapeHtml(option.label)}</span>
          </button>`,
        )
        .join('');
    }

    function positionMenu(anchor: HTMLElement, menuEl: HTMLElement) {
      const rect = anchor.getBoundingClientRect();
      const menuWidth = menuEl.offsetWidth || 192;
      const menuHeight = menuEl.offsetHeight || 280;
      const margin = 8;
      const left = Math.min(Math.max(margin, rect.left), window.innerWidth - menuWidth - margin);
      const spaceBelow = window.innerHeight - rect.bottom - margin;
      const spaceAbove = rect.top - margin;
      const openBelow = spaceBelow >= menuHeight || spaceBelow >= spaceAbove;
      const top = openBelow
        ? Math.min(rect.bottom + 6, window.innerHeight - menuHeight - margin)
        : Math.max(margin, rect.top - menuHeight - 6);

      menuEl.style.left = `${left}px`;
      menuEl.style.top = `${top}px`;
    }

    function closeMenu() {
      detachMenuListeners();
      openCell?.anchor.removeAttribute('aria-expanded');
      openCell = null;
      menu?.remove();
      menu = null;
    }

    function openMenu(anchor: HTMLElement, providerId: string, planId: string) {
      if (openCell?.anchor === anchor) {
        closeMenu();
        return;
      }

      closeMenu();
      openCell = { providerId, planId, anchor };
      anchor.setAttribute('aria-expanded', 'true');

      menu = document.createElement('div');
      menu.className =
        'coverage-status-menu fixed z-50 max-h-[min(16rem,calc(100vh-2rem))] min-w-[12rem] overflow-y-auto overscroll-y-contain rounded-xl border border-sage-dark/10 bg-white py-1 shadow-lg';
      menu.setAttribute('role', 'listbox');
      menu.setAttribute('aria-label', 'Coverage status');
      menu.innerHTML = renderMenuOptions();
      menu.addEventListener('click', (event) => {
        const target = event.target;
        if (!(target instanceof HTMLElement) || !openCell) return;
        const choice = target.closest('[data-status-choice]');
        if (!(choice instanceof HTMLElement)) return;
        const status = choice.dataset.statusChoice ?? 'not_started';
        const cells = cellsFor(openCell.providerId, openCell.planId);
        const { providerId, planId } = openCell;
        closeMenu();
        void saveStatus(providerId, planId, status, cells);
      });
      document.body.appendChild(menu);

      window.requestAnimationFrame(() => {
        if (!menu || !openCell) return;
        positionMenu(openCell.anchor, menu);
      });

      const onDismiss = (event?: Event) => {
        if (event?.type === 'pointerdown') {
          const target = event.target;
          if (target instanceof Node && (openCell?.anchor.contains(target) || menu?.contains(target))) {
            return;
          }
        }
        closeMenu();
      };

      dismissMenu = onDismiss;
      window.setTimeout(() => {
        document.addEventListener('scroll', onDismiss, true);
        window.addEventListener('resize', onDismiss);
        document.addEventListener('pointerdown', onDismiss, true);
      }, 0);
    }

    async function saveStatus(providerId: string, planId: string, status: CoverageStatusKey, cells: HTMLElement[]) {
      cells.forEach((cell) => {
        cell.dataset.state = 'saving';
        cell.classList.add('opacity-60');
      });
      setFeedback('Saving…');

      try {
        const response = await fetch('/api/credentialing/coverage/update', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          credentials: 'same-origin',
          body: JSON.stringify({ providerId, planId, status }),
        });
        const payload = (await response.json()) as { ok?: boolean; error?: string };
        if (!response.ok || !payload.ok) {
          throw new Error(payload.error || 'Could not save coverage.');
        }

        const key = cellKey(providerId, planId);
        if (status === 'not_started') delete coverage[key];
        else coverage[key] = status;

        cells.forEach((cell) => {
          const pill = cell.querySelector('.coverage-status-pill');
          if (pill instanceof HTMLElement) {
            pill.outerHTML = renderPill(status);
          }
          cell.dataset.state = 'saved';
          cell.classList.remove('opacity-60');
          window.setTimeout(() => {
            delete cell.dataset.state;
          }, 1200);
        });
        setFeedback('Saved.');
        window.setTimeout(() => setFeedback(''), 1500);
        window.dispatchEvent(
          new CustomEvent('credentialing:coverage-changed', {
            detail: { providerId, planId, status },
          }),
        );
      } catch (error) {
        cells.forEach((cell) => {
          cell.dataset.state = 'error';
          cell.classList.remove('opacity-60');
        });
        setFeedback(error instanceof Error ? error.message : 'Could not save coverage.', 'error');
      }
    }

    function cellsFor(providerId: string, planId: string): HTMLElement[] {
      return Array.from(
        root.querySelectorAll(
          `[data-matrix-cell][data-provider-id="${providerId}"][data-plan-id="${planId}"]`,
        ),
      ).filter((node): node is HTMLElement => node instanceof HTMLElement);
    }

    root.addEventListener('click', (event) => {
      const target = event.target;
      if (!(target instanceof HTMLElement)) return;

      const pill = target.closest('.coverage-status-pill');
      if (pill instanceof HTMLElement) {
        event.stopPropagation();
        const cell = pill.closest('[data-matrix-cell]');
        if (!(cell instanceof HTMLElement)) return;
        const providerId = cell.dataset.providerId ?? '';
        const planId = cell.dataset.planId ?? '';
        if (!providerId || !planId) return;
        openMenu(pill, providerId, planId);
      }
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') closeMenu();
    });

    providerFilter?.addEventListener('change', render);
    searchInput?.addEventListener('input', render);

    window.addEventListener('credentialing:provider-selected', (event) => {
      const providerId = (event as CustomEvent<{ providerId?: string }>).detail?.providerId;
      if (!providerFilter || !providerId) return;
      providerFilter.value = providerId;
      render();
    });

    window.addEventListener('credentialing:coverage-changed', (event) => {
      const detail = (event as CustomEvent<{
        providerId?: string;
        planId?: string;
        groupId?: string;
        status?: CoverageStatusKey;
        bulk?: boolean;
      }>).detail;
      if (!detail?.providerId) return;

      if (detail.bulk && detail.groupId) {
        const group = catalog.find((entry) => entry.id === detail.groupId);
        for (const plan of group?.plans ?? []) {
          const key = cellKey(detail.providerId, plan.id);
          if (detail.status === 'not_started') delete coverage[key];
          else if (detail.status) coverage[key] = detail.status;
        }
      } else if (detail.planId) {
        const key = cellKey(detail.providerId, detail.planId);
        if (detail.status === 'not_started') delete coverage[key];
        else if (detail.status) coverage[key] = detail.status;
      }

      render();
    });

    render();
  }

  document.querySelectorAll('[data-coverage-matrix]').forEach((root) => {
    if (root instanceof HTMLElement) setupCoverageMatrix(root);
  });
</script>

<style>
  [data-matrix-cell] {
    cursor: pointer;
  }

  [data-matrix-cell]:hover .coverage-status-pill,
  [data-matrix-cell]:focus-within .coverage-status-pill {
    box-shadow: 0 0 0 2px rgba(83, 95, 81, 0.18);
  }

  .coverage-status-pill[aria-expanded='true'] {
    box-shadow: 0 0 0 2px rgba(83, 95, 81, 0.28);
  }

  [data-matrix-cell][data-state='saving'] .coverage-status-pill {
    animation: pulse 1s ease-in-out infinite;
  }
  [data-matrix-cell][data-state='saved'] .coverage-status-pill {
    box-shadow: 0 0 0 2px rgba(83, 95, 81, 0.25);
  }
  [data-matrix-cell][data-state='error'] .coverage-status-pill {
    box-shadow: 0 0 0 2px rgba(185, 28, 28, 0.35);
  }
</style>
