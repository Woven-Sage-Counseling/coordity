---
import {
  caseloadUtilizationPercent,
  getCaseloadSnapshot,
} from '../lib/caseload';
import { widgetAccentVarsStyle } from '../lib/home-widget-header';
import WidgetHeaderBar from './WidgetHeaderBar.astro';

interface Props {
  userId: string;
}

const { userId } = Astro.props;
const snapshot = getCaseloadSnapshot(userId);
const utilization = caseloadUtilizationPercent(snapshot);
---

<aside
  class="flex h-full min-h-0 max-h-full flex-col overflow-hidden rounded-[1.05rem] shadow-[0_12px_32px_rgba(26,28,30,0.12)] ring-1 ring-black/10"
  aria-labelledby="home-caseload-heading"
  data-widget-card
  data-widget-id="caseload"
  style={widgetAccentVarsStyle('caseload')}
>
  <WidgetHeaderBar
    widgetId="caseload"
    title="Caseload"
    headingId="home-caseload-heading"
    openHref="/caseload"
  />

  <div class="flex min-h-0 flex-1 flex-col bg-[#f4f5f8] px-4 pb-4 pt-3 font-sans text-[#393a3d]">
    <p class="rounded-lg border border-amber-200/80 bg-amber-50 px-2.5 py-2 text-[10px] leading-snug text-amber-900">
      Preview only — sample numbers until your EHR is connected.
    </p>

    <p class="mt-2 text-[10px] text-[#6b6c72]">{snapshot.weekLabel}</p>

    <div class="mt-2 grid grid-cols-2 gap-2">
      <div class="rounded-lg bg-white p-2.5 shadow-sm ring-1 ring-black/[0.06]">
        <p class="text-[10px] font-semibold uppercase tracking-[0.12em] text-[#6b6c72]">Sessions</p>
        <p class="mt-1 text-xl font-semibold leading-none text-charcoal">{snapshot.sessionsThisWeek}</p>
        <p class="mt-1 text-[10px] text-[#6b6c72]">this week</p>
      </div>
      <div class="rounded-lg bg-white p-2.5 shadow-sm ring-1 ring-black/[0.06]">
        <p class="text-[10px] font-semibold uppercase tracking-[0.12em] text-[#6b6c72]">Active clients</p>
        <p class="mt-1 text-xl font-semibold leading-none text-charcoal">{snapshot.activeClients}</p>
        <p class="mt-1 text-[10px] text-[#6b6c72]">on caseload</p>
      </div>
      <div class="rounded-lg bg-white p-2.5 shadow-sm ring-1 ring-black/[0.06]">
        <p class="text-[10px] font-semibold uppercase tracking-[0.12em] text-[#6b6c72]">Remaining</p>
        <p class="mt-1 text-xl font-semibold leading-none text-charcoal">{snapshot.sessionsRemainingThisWeek}</p>
        <p class="mt-1 text-[10px] text-[#6b6c72]">sessions left</p>
      </div>
      <div class="rounded-lg bg-white p-2.5 shadow-sm ring-1 ring-black/[0.06]">
        <p class="text-[10px] font-semibold uppercase tracking-[0.12em] text-[#6b6c72]">New this month</p>
        <p class="mt-1 text-xl font-semibold leading-none text-charcoal">{snapshot.newClientsThisMonth}</p>
        <p class="mt-1 text-[10px] text-[#6b6c72]">clients added</p>
      </div>
    </div>

    {
      utilization != null ? (
        <div class="mt-3 rounded-lg bg-white p-3 shadow-sm ring-1 ring-black/[0.06]">
          <div class="flex items-end justify-between gap-3">
            <div>
              <p class="text-[11px] font-semibold uppercase tracking-[0.14em] text-[#6b6c72]">Caseload fill</p>
              <p class="mt-1 text-lg font-semibold leading-none text-charcoal">
                {snapshot.activeClients} / {snapshot.caseloadTarget}
              </p>
            </div>
            <p class="text-[11px] font-semibold text-sage-dark/80">{utilization}%</p>
          </div>
          <div
            class="mt-2.5 h-2 overflow-hidden rounded-full bg-[#e3e5e8]"
            role="progressbar"
            aria-valuemin={0}
            aria-valuemax={100}
            aria-valuenow={utilization}
            aria-label="Caseload utilization"
          >
            <div class="h-full rounded-full bg-sage-dark transition-[width]" style={`width: ${utilization}%`}></div>
          </div>
        </div>
      ) : null
    }

    <div class="mt-3 min-h-0 flex-1 overflow-y-auto overscroll-contain">
      <p class="text-[11px] font-semibold uppercase tracking-[0.14em] text-[#6b6c72]">Pipeline</p>
      <ul class="mt-2 space-y-2">
        <li class="rounded-lg bg-white px-2.5 py-2 shadow-sm ring-1 ring-black/[0.06]">
          <div class="flex items-center justify-between gap-2">
            <p class="text-[12px] text-charcoal">Intakes pending</p>
            <span class="rounded-full bg-amber-100 px-2 py-0.5 text-[10px] font-semibold text-amber-900">
              {snapshot.intakesPending}
            </span>
          </div>
        </li>
        <li class="rounded-lg bg-white px-2.5 py-2 text-[11px] leading-snug text-[#6b6c72] shadow-sm ring-1 ring-black/[0.06]">
          Planned sources: SimplePractice, Headway, or manual entry.
        </li>
      </ul>
    </div>
  </div>
</aside>
