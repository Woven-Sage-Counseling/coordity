---
import '../styles/bulletin-board.css';
import {
  BULLETIN_IMAGE_MAX_EDGE,
  BULLETIN_MAX_IMAGE_BYTES,
  BULLETIN_MAX_PDF_BYTES,
  getBulletinBoardSettings,
  listBulletinBoardPins,
  serializePin,
  writingModeForSurface,
} from '../lib/bulletin-board';
import { BOARD_ZOOM_ICON, linkifyHtml } from '../lib/bulletin-board-format';
import type { BoardShape } from '../lib/home-layout';

interface Props {
  shape?: BoardShape;
  showSuggest?: boolean;
}

const { shape = 'portrait', showSuggest = true } = Astro.props;

const settings = await getBulletinBoardSettings();
const pins = (await listBulletinBoardPins({ channel: 'live' })).map((pin) =>
  serializePin(pin, settings.surface),
);
const writingMode = writingModeForSurface(settings.surface);
---

<aside
  class:list={[shape === 'landscape' ? 'w-full' : 'lg:sticky lg:top-6']}
  aria-label="Bulletin board"
  data-home-board
  data-surface={settings.surface}
  data-writing-mode={writingMode}
  data-board-shape={shape}
  data-max-image-bytes={BULLETIN_MAX_IMAGE_BYTES}
  data-max-pdf-bytes={BULLETIN_MAX_PDF_BYTES}
  data-image-max-edge={BULLETIN_IMAGE_MAX_EDGE}
>
  <link
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Caveat:wght@500;600&family=Patrick+Hand&family=Permanent+Marker&display=swap"
  />
  <div
    class:list={['board-surface board-frame relative', shape === 'portrait' ? 'mx-auto' : '']}
    data-board-canvas
    data-board-shape={shape}
    data-surface={settings.surface}
  >
    {
      pins.map((pin) => {
        const expandable = pin.kind === 'image' || pin.kind === 'pdf' || Boolean(pin.body && pin.body.length > 80);
        const bodyStyle =
          settings.surface === 'cork'
            ? `background:${pin.color};color:#1f2937;--board-font-size:${pin.fontSizeRem}rem`
            : `background:transparent;color:${pin.color};--board-font-size:${pin.fontSizeRem}rem`;
        return (
          <div
            class="board-pin"
            style={`left:${pin.xPct}%;top:${pin.yPct}%;width:${pin.widthPct}%;z-index:${pin.zIndex};transform:rotate(${pin.rotationDeg}deg)`}
            data-pin-id={pin.id}
            data-expandable={expandable ? 'true' : 'false'}
            data-kind={pin.kind}
            data-file-url={pin.fileUrl ?? ''}
            data-file-name={pin.fileName ?? ''}
            data-body={pin.body ?? ''}
          >
            <span class="board-pin-tack" aria-hidden="true" />
            {
              pin.kind === 'text' ? (
                <div class="board-pin-body whitespace-pre-wrap" data-font-size style={bodyStyle} set:html={linkifyHtml(pin.body || '')} />
              ) : pin.kind === 'image' && pin.fileUrl ? (
                <div class="board-pin-body" style={settings.surface === 'cork' ? 'background:#fff7ed' : 'background:transparent'}>
                  <img class="board-pin-media" src={pin.fileUrl} alt="" draggable="false" />
                </div>
              ) : (
                <div class="board-pin-body" style={settings.surface === 'cork' ? 'background:#fff7ed' : 'background:transparent'}>
                  <div class="board-pin-pdf">
                    <span>PDF</span>
                    <span>{pin.fileName || 'Flyer'}</span>
                  </div>
                </div>
              )
            }
            {
              expandable ? (
                <button type="button" class="board-pin-zoom" aria-label="Expand item" data-board-zoom set:html={BOARD_ZOOM_ICON} />
              ) : null
            }
          </div>
        );
      })
    }
    {
      pins.length === 0 ? (
        <div class="pointer-events-none absolute inset-0 flex items-center justify-center px-6 text-center">
          <p class="text-xs font-semibold uppercase tracking-[0.16em] text-black/25">Bulletin board</p>
        </div>
      ) : null
    }
  </div>

  {
    showSuggest ? (
      <div class="mt-3 flex justify-center">
        <button
          type="button"
          class="inline-flex items-center rounded-full border border-sage-dark/20 bg-white/90 px-3 py-1 text-xs font-semibold text-sage-dark/80 shadow-sm transition hover:border-sage-dark/35 hover:bg-white hover:text-charcoal"
          data-suggest-open
        >
          Suggest a post
        </button>
      </div>
    ) : null
  }

  {
    showSuggest ? (
      <dialog class="board-expand-dialog" data-board-suggest>
        <div class="board-expand-panel w-[min(24rem,calc(100vw-2rem))]">
          <div class="flex items-center justify-between gap-3 border-b border-black/5 px-4 py-3">
            <p class="text-sm font-semibold text-charcoal">Suggest a post</p>
            <button type="button" class="text-sm font-medium text-sage-dark/70 hover:text-charcoal" data-suggest-close>
              Close
            </button>
          </div>
          <form class="space-y-3 px-4 py-4" data-board-suggest-form>
            <p class="text-xs text-sage-dark/65">Submitted posts need admin approval before they appear on the board.</p>
            <label class="block text-sm">
              <span class="font-medium text-charcoal">Type</span>
              <select name="kind" class="field mt-1" data-suggest-kind>
                <option value="text">Sticky note</option>
                <option value="image">Photo / poster</option>
                <option value="pdf">PDF flyer</option>
              </select>
            </label>
            <label class="block text-sm" data-suggest-body-wrap>
              <span class="font-medium text-charcoal">Message</span>
              <textarea
                name="body"
                class="field mt-1 min-h-[4.5rem] resize-y text-sm"
                placeholder="Something for the team board…"
                data-suggest-body
              ></textarea>
            </label>
            <label class="block text-sm hidden" data-suggest-file-wrap>
              <span class="font-medium text-charcoal">File</span>
              <input
                name="file"
                type="file"
                class="mt-1 block w-full text-sm"
                accept="image/jpeg,image/png,image/webp,image/gif,application/pdf"
                data-suggest-file
              />
            </label>
            <button type="submit" class="btn-primary !px-4 !py-2 text-sm" data-suggest-submit>
              Submit for approval
            </button>
            <p class="hidden text-xs text-sage-dark/70" data-suggest-status></p>
            <p class="hidden text-xs text-red-700" data-suggest-error></p>
          </form>
        </div>
      </dialog>
    ) : null
  }

  <dialog class="board-expand-dialog" data-board-expand>
    <div class="board-expand-panel">
      <div class="flex items-center justify-between gap-3 border-b border-black/5 px-4 py-3">
        <p class="text-sm font-semibold text-charcoal" data-expand-title>Item</p>
        <button type="button" class="text-sm font-medium text-sage-dark/70 hover:text-charcoal" data-expand-close>
          Close
        </button>
      </div>
      <div class="p-0" data-expand-body></div>
    </div>
  </dialog>
</aside>

<script>
  function setupHomeBoard(root: Element) {
    if (!(root instanceof HTMLElement)) return;
    const dialog = root.querySelector('[data-board-expand]');
    const title = root.querySelector('[data-expand-title]');
    const body = root.querySelector('[data-expand-body]');
    const closeBtn = root.querySelector('[data-expand-close]');
    if (!(dialog instanceof HTMLDialogElement) || !(body instanceof HTMLElement)) return;

    const openPin = (pin: HTMLElement) => {
      const kind = pin.dataset.kind || 'text';
      const fileUrl = pin.dataset.fileUrl || '';
      const fileName = pin.dataset.fileName || 'Attachment';
      const text = pin.dataset.body || '';
      if (title instanceof HTMLElement) {
        title.textContent = kind === 'pdf' ? fileName : kind === 'image' ? 'Photo' : 'Note';
      }
      if (kind === 'image' && fileUrl) {
        body.innerHTML = `<img src="${fileUrl}" alt="" />`;
      } else if (kind === 'pdf' && fileUrl) {
        body.innerHTML = `<iframe src="${fileUrl}" title="${fileName.replaceAll('"', '')}"></iframe>`;
      } else {
        body.innerHTML = `<div class="whitespace-pre-wrap px-5 py-4 text-sm text-charcoal"></div>`;
        const box = body.firstElementChild;
        if (box) box.textContent = text;
      }
      dialog.showModal();
    };

    root.querySelectorAll('[data-board-zoom]').forEach((btn) => {
      btn.addEventListener('click', (event) => {
        event.preventDefault();
        event.stopPropagation();
        const current = event.currentTarget;
        if (!(current instanceof HTMLElement)) return;
        const pin = current.closest('[data-pin-id]');
        if (pin instanceof HTMLElement) openPin(pin);
      });
    });

    closeBtn?.addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });

    const suggestDialog = root.querySelector('[data-board-suggest]');
    const suggestOpen = root.querySelector('[data-suggest-open]');
    const suggestClose = root.querySelector('[data-suggest-close]');
    const form = root.querySelector('[data-board-suggest-form]');
    const kindSelect = root.querySelector('[data-suggest-kind]');
    const bodyWrap = root.querySelector('[data-suggest-body-wrap]');
    const fileWrap = root.querySelector('[data-suggest-file-wrap]');
    const statusEl = root.querySelector('[data-suggest-status]');
    const errorEl = root.querySelector('[data-suggest-error]');
    const submitBtn = root.querySelector('[data-suggest-submit]');
    const maxImageBytes = Number(root.dataset.maxImageBytes) || 1_000_000;
    const maxPdfBytes = Number(root.dataset.maxPdfBytes) || 1_200_000;
    const imageMaxEdge = Number(root.dataset.imageMaxEdge) || 1600;

    const clearSuggestFeedback = () => {
      if (errorEl instanceof HTMLElement) {
        errorEl.classList.add('hidden');
        errorEl.textContent = '';
      }
      if (statusEl instanceof HTMLElement) {
        statusEl.classList.add('hidden');
        statusEl.textContent = '';
      }
    };

    const syncKind = () => {
      const kind = kindSelect instanceof HTMLSelectElement ? kindSelect.value : 'text';
      if (bodyWrap instanceof HTMLElement) bodyWrap.classList.toggle('hidden', kind !== 'text');
      if (fileWrap instanceof HTMLElement) fileWrap.classList.toggle('hidden', kind === 'text');
    };
    kindSelect?.addEventListener('change', syncKind);
    syncKind();

    suggestOpen?.addEventListener('click', () => {
      if (!(suggestDialog instanceof HTMLDialogElement)) return;
      clearSuggestFeedback();
      syncKind();
      suggestDialog.showModal();
    });
    suggestClose?.addEventListener('click', () => {
      if (suggestDialog instanceof HTMLDialogElement) suggestDialog.close();
    });
    suggestDialog?.addEventListener('click', (event) => {
      if (event.target === suggestDialog && suggestDialog instanceof HTMLDialogElement) {
        suggestDialog.close();
      }
    });

    const loadImage = (file: File) =>
      new Promise<HTMLImageElement>((resolve, reject) => {
        const url = URL.createObjectURL(file);
        const img = new Image();
        img.onload = () => {
          URL.revokeObjectURL(url);
          resolve(img);
        };
        img.onerror = () => {
          URL.revokeObjectURL(url);
          reject(new Error('Could not read that image.'));
        };
        img.src = url;
      });

    const blobToFile = (blob: Blob, name: string, type: string) =>
      new File([blob], name, { type });

    const compressImage = async (file: File) => {
      if (file.size <= maxImageBytes) return file;
      const img = await loadImage(file);
      const scale = Math.min(1, imageMaxEdge / Math.max(img.width, img.height));
      const width = Math.max(1, Math.round(img.width * scale));
      const height = Math.max(1, Math.round(img.height * scale));
      const canvas = document.createElement('canvas');
      canvas.width = width;
      canvas.height = height;
      const ctx = canvas.getContext('2d');
      if (!ctx) throw new Error('Could not compress image.');
      ctx.drawImage(img, 0, 0, width, height);
      let quality = 0.88;
      let best: Blob | null = null;
      for (let i = 0; i < 8; i += 1) {
        const blob = await new Promise<Blob | null>((resolve) =>
          canvas.toBlob((result) => resolve(result), 'image/jpeg', quality),
        );
        if (!blob) break;
        best = blob;
        if (blob.size <= maxImageBytes) break;
        quality -= 0.08;
      }
      if (!best || best.size > maxImageBytes) {
        throw new Error('Image is still too large after compression (max about 1MB).');
      }
      return blobToFile(best, file.name.replace(/\.\w+$/, '') + '.jpg', 'image/jpeg');
    };

    form?.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!(form instanceof HTMLFormElement)) return;
      clearSuggestFeedback();

      const kind = kindSelect instanceof HTMLSelectElement ? kindSelect.value : 'text';
      const bodyInput = form.querySelector('[data-suggest-body]');
      const fileInput = form.querySelector('[data-suggest-file]');
      const note = bodyInput instanceof HTMLTextAreaElement ? bodyInput.value.trim() : '';

      try {
        if (kind === 'text' && !note) throw new Error('Write something for the sticky note.');
        if (submitBtn instanceof HTMLButtonElement) submitBtn.disabled = true;

        const payload = new FormData();
        payload.append('kind', kind);
        if (kind === 'text') payload.append('body', note);

        if (kind === 'image' || kind === 'pdf') {
          const file = fileInput instanceof HTMLInputElement ? fileInput.files?.[0] : null;
          if (!file) throw new Error('Choose a file to upload.');
          if (kind === 'pdf') {
            if (file.type !== 'application/pdf') throw new Error('Upload a PDF file.');
            if (file.size > maxPdfBytes) throw new Error('PDF is too large (max about 1.2MB).');
            payload.append('file', file);
          } else {
            if (statusEl instanceof HTMLElement) {
              statusEl.textContent = 'Preparing image…';
              statusEl.classList.remove('hidden');
            }
            payload.append('file', await compressImage(file));
          }
        }

        if (statusEl instanceof HTMLElement) {
          statusEl.textContent = 'Submitting…';
          statusEl.classList.remove('hidden');
        }

        const res = await fetch('/api/bulletin-board/requests/create', {
          method: 'POST',
          body: payload,
          headers: { Accept: 'application/json' },
        });
        const json = (await res.json().catch(() => ({}))) as { error?: string };
        if (!res.ok) throw new Error(json.error || 'Could not submit.');

        form.reset();
        syncKind();
        if (statusEl instanceof HTMLElement) {
          statusEl.textContent = 'Submitted for admin approval.';
          statusEl.classList.remove('hidden');
        }
        window.setTimeout(() => {
          if (suggestDialog instanceof HTMLDialogElement && suggestDialog.open) {
            suggestDialog.close();
          }
          clearSuggestFeedback();
        }, 1200);
      } catch (error) {
        if (errorEl instanceof HTMLElement) {
          errorEl.textContent = error instanceof Error ? error.message : 'Submit failed.';
          errorEl.classList.remove('hidden');
        }
        if (statusEl instanceof HTMLElement) statusEl.classList.add('hidden');
      } finally {
        if (submitBtn instanceof HTMLButtonElement) submitBtn.disabled = false;
      }
    });
  }

  document.querySelectorAll('[data-home-board]').forEach((root) => setupHomeBoard(root));
</script>
