---
import TaskListItem from './TaskListItem.astro';
import { listTasksForUser, serializeTask } from '../lib/tasks';

interface Props {
  userId: string;
  mode?: 'widget' | 'page';
  returnTo?: string;
  initialError?: string | null;
}

const { userId, mode = 'widget', returnTo = mode === 'page' ? '/tasks' : '/', initialError = null } =
  Astro.props;
const isPage = mode === 'page';

let tasks: Awaited<ReturnType<typeof listTasksForUser>> = [];
let tasksLoadError: string | null = null;
try {
  tasks = await listTasksForUser(userId, isPage ? 200 : 50);
} catch (error) {
  console.error('tasks load failed', error);
  tasksLoadError = 'Tasks are temporarily unavailable.';
}

const serialized = tasks.map(serializeTask);
const activeTasks = serialized.filter((task) => !task.completed);
const completedTasks = serialized.filter((task) => task.completed);
---

<div
  class:list={[isPage ? 'max-w-2xl' : 'flex min-h-0 flex-1 flex-col', !isPage && 'px-4 pb-4 pt-3']}
  data-tasks-panel
  data-tasks-mode={mode}
  data-return-to={returnTo}
>
  <div data-tasks-flash hidden={!initialError}>
    {
      initialError ? (
        <p class="rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800">{initialError}</p>
      ) : null
    }
  </div>

  <form
    method="post"
    action="/api/tasks/create"
    class:list={['flex gap-2', isPage ? 'card mt-6' : 'mt-2']}
    data-tasks-add-form
  >
    <input type="hidden" name="returnTo" value={returnTo} />
    <label class="sr-only" for={isPage ? 'task-title' : 'home-task-title'}>New task</label>
    <input
      id={isPage ? 'task-title' : 'home-task-title'}
      name="title"
      type="text"
      maxlength="500"
      required
      placeholder="Add a task…"
      class:list={[
        'min-w-0 flex-1 rounded-lg border border-sage-dark/15 bg-white text-charcoal shadow-sm outline-none ring-0 placeholder:text-sage-dark/50 focus:border-sage-dark/30',
        isPage ? 'field !py-2.5 text-sm' : 'px-2.5 py-2 text-[12px]',
      ]}
      autocomplete="off"
    />
    <button
      type="submit"
      class:list={[
        'shrink-0 font-semibold',
        isPage ? 'btn-primary !px-4 !py-2.5 text-sm' : 'widget-accent-btn rounded-lg px-3 py-2 text-[11px]',
      ]}
    >
      Add
    </button>
  </form>

  {
    isPage ? (
      <>
        <section class="mt-10" aria-labelledby="active-tasks-heading">
          <h2 id="active-tasks-heading" class="font-display text-2xl text-charcoal">Active</h2>
          <p class="mt-1 text-sm text-sage-dark/65">Open tasks you still need to complete.</p>
          {
            tasksLoadError ? (
              <p class="mt-4 rounded-xl border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-900">
                {tasksLoadError}
              </p>
            ) : null
          }
          <p
            class="mt-4 text-sm text-sage-dark/65"
            data-tasks-empty-active
            hidden={activeTasks.length > 0 || tasksLoadError != null}
          >
            No active tasks. Add one above.
          </p>
          <ul class="mt-4 space-y-3" data-tasks-list-active hidden={activeTasks.length === 0}>
            {activeTasks.map((task) => (
              <TaskListItem task={task} mode="page" returnTo={returnTo} />
            ))}
          </ul>
        </section>

        <section class="mt-10" aria-labelledby="completed-tasks-heading">
          <h2 id="completed-tasks-heading" class="font-display text-2xl text-charcoal">Completed</h2>
          <p class="mt-1 text-sm text-sage-dark/65">Finished tasks stay here until you delete them.</p>
          <p class="mt-4 text-sm text-sage-dark/65" data-tasks-empty-completed hidden={completedTasks.length > 0}>
            No completed tasks yet.
          </p>
          <ul class="mt-4 space-y-3" data-tasks-list-completed hidden={completedTasks.length === 0}>
            {completedTasks.map((task) => (
              <TaskListItem task={task} mode="page" returnTo={returnTo} />
            ))}
          </ul>
        </section>
      </>
    ) : (
      <div class="mt-3 min-h-0 flex-1 overflow-y-auto overscroll-contain">
        <p class="text-[11px] font-semibold uppercase tracking-[0.14em] text-[#6b6c72]">Your tasks</p>
        {
          tasksLoadError ? (
            <p class="mt-2 rounded-lg border border-amber-200 bg-amber-50 px-2.5 py-2 text-[11px] text-amber-900">
              {tasksLoadError}
            </p>
          ) : null
        }
        <p
          class="mt-2 text-[12px] text-[#6b6c72]"
          data-tasks-empty
          hidden={serialized.length > 0 || tasksLoadError != null}
        >
          No tasks yet.
        </p>
        <ul class="mt-2 space-y-2" data-tasks-list hidden={serialized.length === 0}>
          {serialized.map((task) => (
            <TaskListItem task={task} mode="widget" returnTo={returnTo} />
          ))}
        </ul>
      </div>
    )
  }
</div>

<script>
  type WidgetTask = {
    id: string;
    title: string;
    completed: boolean;
    assigned: boolean;
    createdByName: string;
    createdAtLabel: string;
  };

  type ApiResult =
    | { ok: true; task?: WidgetTask; taskId?: string; error?: undefined }
    | { ok: false; error?: string };

  function escapeHtml(value: string): string {
    return value
      .replaceAll('&', '&amp;')
      .replaceAll('<', '&lt;')
      .replaceAll('>', '&gt;')
      .replaceAll('"', '&quot;')
      .replaceAll("'", '&#39;');
  }

  function panelMode(root: HTMLElement): 'widget' | 'page' {
    return root.dataset.tasksMode === 'page' ? 'page' : 'widget';
  }

  function returnToPath(root: HTMLElement): string {
    return root.dataset.returnTo || '/';
  }

  function setFlash(root: HTMLElement, kind: 'ok' | 'error', text: string): void {
    const flash = root.querySelector('[data-tasks-flash]');
    if (!(flash instanceof HTMLElement)) return;
    const classes =
      kind === 'error'
        ? panelMode(root) === 'page'
          ? 'rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800'
          : 'rounded-lg border border-red-200 bg-red-50 px-2.5 py-2 text-[11px] text-red-800'
        : panelMode(root) === 'page'
          ? 'rounded-xl border border-sage-dark/15 bg-white px-4 py-3 text-sm text-sage-dark/80'
          : 'rounded-lg border border-sage-dark/15 bg-white px-2.5 py-2 text-[11px] text-sage-dark/80';
    flash.innerHTML = `<p class="${classes}">${escapeHtml(text)}</p>`;
    flash.hidden = false;
  }

  function clearFlash(root: HTMLElement): void {
    const flash = root.querySelector('[data-tasks-flash]');
    if (!(flash instanceof HTMLElement)) return;
    flash.innerHTML = '';
    flash.hidden = true;
  }

  function syncListVisibility(root: HTMLElement): void {
    const mode = panelMode(root);
    if (mode === 'page') {
      const activeList = root.querySelector('[data-tasks-list-active]');
      const completedList = root.querySelector('[data-tasks-list-completed]');
      const emptyActive = root.querySelector('[data-tasks-empty-active]');
      const emptyCompleted = root.querySelector('[data-tasks-empty-completed]');
      const activeCount = root.querySelectorAll('[data-tasks-list-active] [data-tasks-item]').length;
      const completedCount = root.querySelectorAll('[data-tasks-list-completed] [data-tasks-item]').length;
      if (activeList instanceof HTMLElement) activeList.hidden = activeCount === 0;
      if (completedList instanceof HTMLElement) completedList.hidden = completedCount === 0;
      if (emptyActive instanceof HTMLElement) emptyActive.hidden = activeCount > 0;
      if (emptyCompleted instanceof HTMLElement) emptyCompleted.hidden = completedCount > 0;
      return;
    }

    const list = root.querySelector('[data-tasks-list]');
    const empty = root.querySelector('[data-tasks-empty]');
    if (!(list instanceof HTMLElement) || !(empty instanceof HTMLElement)) return;
    const hasItems = list.querySelector('[data-tasks-item]') != null;
    list.hidden = !hasItems;
    empty.hidden = hasItems;
  }

  function renderTaskItem(task: WidgetTask, mode: 'widget' | 'page', returnTo: string): string {
    const assignedMeta = task.assigned
      ? `<p class="${mode === 'page' ? 'mt-1 text-xs text-sage-dark/65' : 'mt-0.5 text-[10px] text-sage-dark/70'}" data-task-assigned>Assigned by ${escapeHtml(task.createdByName)}${mode === 'page' ? ` · ${escapeHtml(task.createdAtLabel)}` : ''}</p>`
      : mode === 'page'
        ? `<p class="mt-1 text-xs text-sage-dark/65" data-task-meta>Added ${escapeHtml(task.createdAtLabel)}</p>`
        : '';
    const titleClass = task.completed
      ? mode === 'page'
        ? 'text-sm leading-snug text-sage-dark/65 line-through'
        : 'text-[12px] leading-snug text-[#6b6c72] line-through'
      : mode === 'page'
        ? 'text-sm leading-snug text-charcoal'
        : 'text-[12px] leading-snug text-charcoal';
    const itemClass =
      mode === 'page'
        ? 'rounded-xl border border-sage-dark/10 bg-white px-4 py-3 shadow-sm'
        : 'rounded-lg bg-white px-2.5 py-2 shadow-sm ring-1 ring-black/[0.06]';
    const actionPillBase =
      mode === 'page'
        ? 'inline-flex items-center rounded-full px-2.5 py-1 text-xs font-semibold leading-none ring-1 transition disabled:opacity-60'
        : 'inline-flex items-center rounded-full px-2 py-0.5 text-[9px] font-semibold leading-none ring-1 transition disabled:opacity-60';
    const editPillClass = `${actionPillBase} bg-stone-100 text-stone-700 ring-stone-200 hover:bg-stone-200`;
    const deletePillClass = `${actionPillBase} bg-red-50 text-red-800 ring-red-200 hover:bg-red-100`;
    const actionsMargin = mode === 'page' ? 'mt-2' : 'mt-1';
    const editInputClass =
      mode === 'page'
        ? 'w-full rounded-lg border border-sage-dark/15 bg-white px-3 py-2 text-sm text-charcoal outline-none focus:border-sage-dark/30'
        : 'w-full rounded-md border border-sage-dark/15 bg-white px-2 py-1.5 text-[12px] text-charcoal outline-none focus:border-sage-dark/30';
    const saveBtnClass =
      mode === 'page'
        ? 'rounded-full bg-sage-dark/10 px-3 py-1.5 text-xs font-semibold text-charcoal transition hover:bg-sage-dark/15'
        : 'rounded-full bg-sage-dark/10 px-2.5 py-1 text-[10px] font-semibold text-charcoal transition hover:bg-sage-dark/15';
    const cancelBtnClass =
      mode === 'page'
        ? 'rounded-full bg-[#f4f5f8] px-3 py-1.5 text-xs font-semibold text-[#6b6c72] ring-1 ring-black/[0.06] transition hover:bg-sage-dark/10'
        : 'rounded-full bg-[#f4f5f8] px-2.5 py-1 text-[10px] font-semibold text-[#6b6c72] ring-1 ring-black/[0.06] transition hover:bg-sage-dark/10';

    return `<li
      class="${itemClass}"
      data-tasks-item
      data-task-id="${escapeHtml(task.id)}"
      data-completed="${task.completed ? '1' : '0'}"
    >
      <div class="flex items-start gap-3">
        <form method="post" action="/api/tasks/toggle" class="mt-0.5 shrink-0" data-tasks-action="toggle">
          <input type="hidden" name="taskId" value="${escapeHtml(task.id)}" />
          <input type="hidden" name="completed" value="${task.completed ? '0' : '1'}" />
          <input
            type="checkbox"
            class="h-4 w-4 rounded border-sage-dark/30 text-sage-dark focus:ring-sage-dark/30"
            ${task.completed ? 'checked' : ''}
            aria-label="${task.completed ? 'Mark incomplete' : 'Mark complete'}"
          />
        </form>
        <div class="min-w-0 flex-1" data-task-body>
          <div data-task-display>
            <p class="${titleClass}" data-task-title>${escapeHtml(task.title)}</p>
            ${assignedMeta}
            <div class="flex justify-end gap-1.5 ${actionsMargin}" data-task-actions>
              <button type="button" class="${editPillClass}" data-task-edit-open aria-label="Edit task">Edit</button>
              <form method="post" action="/api/tasks/delete" class="inline-flex" data-tasks-action="delete">
                <input type="hidden" name="taskId" value="${escapeHtml(task.id)}" />
                <input type="hidden" name="returnTo" value="${escapeHtml(returnTo)}" />
                <button type="submit" class="${deletePillClass}" aria-label="Delete task">Delete</button>
              </form>
            </div>
          </div>
          <form method="post" action="/api/tasks/update" class="mt-2 hidden flex-col gap-2" data-tasks-action="edit">
            <input type="hidden" name="taskId" value="${escapeHtml(task.id)}" />
            <input type="hidden" name="returnTo" value="${escapeHtml(returnTo)}" />
            <input name="title" type="text" maxlength="500" required value="${escapeHtml(task.title)}" class="${editInputClass}" data-task-edit-input />
            <div class="flex flex-wrap gap-2">
              <button type="submit" class="${saveBtnClass}">Save</button>
              <button type="button" class="${cancelBtnClass}" data-task-edit-cancel>Cancel</button>
            </div>
          </form>
        </div>
      </div>
    </li>`;
  }

  function closeTaskEdit(item: HTMLElement, restore = true): void {
    const display = item.querySelector('[data-task-display]');
    const form = item.querySelector('[data-tasks-action="edit"]');
    const editOpen = item.querySelector('[data-task-edit-open]');
    const title = item.querySelector('[data-task-title]');
    const input = item.querySelector('[data-task-edit-input]');

    if (form instanceof HTMLFormElement) {
      if (restore && title instanceof HTMLElement && input instanceof HTMLInputElement) {
        input.value = title.textContent ?? '';
      }
      form.classList.add('hidden');
      form.classList.remove('flex');
    }
    display?.classList.remove('hidden');
    if (editOpen instanceof HTMLButtonElement) editOpen.disabled = false;
  }

  function closeAllTaskEdits(root: HTMLElement, except?: HTMLElement): void {
    root.querySelectorAll('[data-tasks-item]').forEach((node) => {
      if (!(node instanceof HTMLElement)) return;
      if (except && node === except) return;
      closeTaskEdit(node);
    });
  }

  function openTaskEdit(item: HTMLElement): void {
    const display = item.querySelector('[data-task-display]');
    const form = item.querySelector('[data-tasks-action="edit"]');
    const editOpen = item.querySelector('[data-task-edit-open]');
    const input = item.querySelector('[data-task-edit-input]');
    const title = item.querySelector('[data-task-title]');

    if (!(form instanceof HTMLFormElement) || !(input instanceof HTMLInputElement)) return;

    const panel = item.closest('[data-tasks-panel]');
    if (panel instanceof HTMLElement) closeAllTaskEdits(panel, item);
    if (title instanceof HTMLElement) input.value = title.textContent ?? '';
    display?.classList.add('hidden');
    form.classList.remove('hidden');
    form.classList.add('flex');
    if (editOpen instanceof HTMLButtonElement) editOpen.disabled = true;
    input.focus();
    input.select();
  }

  function targetList(root: HTMLElement, completed: boolean): HTMLElement | null {
    const mode = panelMode(root);
    if (mode === 'page') {
      const selector = completed ? '[data-tasks-list-completed]' : '[data-tasks-list-active]';
      const list = root.querySelector(selector);
      return list instanceof HTMLElement ? list : null;
    }
    const list = root.querySelector('[data-tasks-list]');
    return list instanceof HTMLElement ? list : null;
  }

  function prependTask(root: HTMLElement, task: WidgetTask): void {
    const list = targetList(root, task.completed);
    if (!list) return;
    list.insertAdjacentHTML('afterbegin', renderTaskItem(task, panelMode(root), returnToPath(root)));
    syncListVisibility(root);
  }

  function moveTaskItem(root: HTMLElement, item: HTMLElement, completed: boolean): void {
    const target = targetList(root, completed);
    if (!target) return;
    if (target.firstChild) {
      target.insertBefore(item, target.firstChild);
    } else {
      target.appendChild(item);
    }
    syncListVisibility(root);
  }

  function updateTaskItem(root: HTMLElement, item: HTMLElement, task: WidgetTask): void {
    const wasCompleted = item.dataset.completed === '1';
    item.dataset.completed = task.completed ? '1' : '0';
    const title = item.querySelector('[data-task-title]');
    if (title instanceof HTMLElement) {
      title.textContent = task.title;
      title.classList.toggle('line-through', task.completed);
      if (panelMode(root) === 'page') {
        title.classList.toggle('text-sage-dark/65', task.completed);
        title.classList.toggle('text-charcoal', !task.completed);
      } else {
        title.classList.toggle('text-[#6b6c72]', task.completed);
        title.classList.toggle('text-charcoal', !task.completed);
      }
    }
    const editInput = item.querySelector('[data-task-edit-input]');
    if (editInput instanceof HTMLInputElement) editInput.value = task.title;
    const toggleForm = item.querySelector('[data-tasks-action="toggle"]');
    if (toggleForm instanceof HTMLFormElement) {
      const completedInput = toggleForm.querySelector('input[name="completed"]');
      const checkbox = toggleForm.querySelector('input[type="checkbox"]');
      if (completedInput instanceof HTMLInputElement) completedInput.value = task.completed ? '0' : '1';
      if (checkbox instanceof HTMLInputElement) checkbox.checked = task.completed;
    }

    if (panelMode(root) === 'page' && wasCompleted !== task.completed) {
      moveTaskItem(root, item, task.completed);
      return;
    }

    if (panelMode(root) === 'widget') reorderTasks(root);
  }

  function removeTask(root: HTMLElement, taskId: string): void {
    const item = root.querySelector(`[data-tasks-item][data-task-id="${CSS.escape(taskId)}"]`);
    item?.remove();
    syncListVisibility(root);
  }

  function reorderTasks(root: HTMLElement): void {
    const list = root.querySelector('[data-tasks-list]');
    if (!(list instanceof HTMLElement)) return;
    const items = Array.from(list.querySelectorAll('[data-tasks-item]')).filter(
      (node): node is HTMLElement => node instanceof HTMLElement,
    );
    items.sort((a, b) => {
      const aDone = a.dataset.completed === '1';
      const bDone = b.dataset.completed === '1';
      if (aDone !== bDone) return aDone ? 1 : -1;
      return 0;
    });
    items.forEach((item) => list.appendChild(item));
  }

  async function postForm(form: HTMLFormElement): Promise<ApiResult> {
    const response = await fetch(form.action, {
      method: 'POST',
      body: new FormData(form),
      headers: { Accept: 'application/json' },
      credentials: 'same-origin',
    });

    let payload: ApiResult;
    try {
      payload = (await response.json()) as ApiResult;
    } catch {
      return { ok: false, error: 'Something went wrong. Please try again.' };
    }

    if (!response.ok || !payload.ok) {
      return { ok: false, error: payload.error || 'Something went wrong. Please try again.' };
    }

    return payload;
  }

  function setBusy(form: HTMLFormElement, busy: boolean): void {
    form.querySelectorAll('button[type="submit"]').forEach((button) => {
      if (button instanceof HTMLButtonElement) button.disabled = busy;
    });
  }

  document.querySelectorAll('[data-tasks-panel]').forEach((root) => {
    if (!(root instanceof HTMLElement)) return;

    const addForm = root.querySelector('[data-tasks-add-form]');
    if (addForm instanceof HTMLFormElement) {
      addForm.addEventListener('submit', (event) => {
        event.preventDefault();
        void (async () => {
          clearFlash(root);
          setBusy(addForm, true);
          try {
            const result = await postForm(addForm);
            if (!result.ok || !result.task) {
              setFlash(root, 'error', result.error || 'Unable to add that task.');
              return;
            }
            prependTask(root, result.task);
            addForm.reset();
          } finally {
            setBusy(addForm, false);
          }
        })();
      });
    }

    root.addEventListener('change', (event) => {
      const target = event.target;
      if (!(target instanceof HTMLInputElement) || target.type !== 'checkbox') return;
      const form = target.form;
      if (!(form instanceof HTMLFormElement)) return;
      if (form.getAttribute('data-tasks-action') !== 'toggle') return;

      void (async () => {
        clearFlash(root);
        setBusy(form, true);
        try {
          const result = await postForm(form);
          if (!result.ok || !result.task) {
            target.checked = !target.checked;
            setFlash(root, 'error', result.error || 'Unable to update that task.');
            return;
          }
          const item = form.closest('[data-tasks-item]');
          if (item instanceof HTMLElement) updateTaskItem(root, item, result.task);
        } finally {
          setBusy(form, false);
        }
      })();
    });

    root.addEventListener('click', (event) => {
      const target = event.target;
      if (!(target instanceof HTMLElement)) return;

      const editOpen = target.closest('[data-task-edit-open]');
      if (editOpen instanceof HTMLButtonElement) {
        const item = editOpen.closest('[data-tasks-item]');
        if (item instanceof HTMLElement) openTaskEdit(item);
        return;
      }

      const editCancel = target.closest('[data-task-edit-cancel]');
      if (editCancel instanceof HTMLButtonElement) {
        const item = editCancel.closest('[data-tasks-item]');
        if (item instanceof HTMLElement) closeTaskEdit(item);
      }
    });

    root.addEventListener('submit', (event) => {
      const form = event.target;
      if (!(form instanceof HTMLFormElement)) return;

      if (form.getAttribute('data-tasks-action') === 'edit') {
        event.preventDefault();
        void (async () => {
          clearFlash(root);
          setBusy(form, true);
          try {
            const result = await postForm(form);
            if (!result.ok || !result.task) {
              setFlash(root, 'error', result.error || 'Unable to update that task.');
              return;
            }
            const item = form.closest('[data-tasks-item]');
            if (item instanceof HTMLElement) {
              closeTaskEdit(item, false);
              updateTaskItem(root, item, result.task);
            }
          } finally {
            setBusy(form, false);
          }
        })();
        return;
      }

      if (form.getAttribute('data-tasks-action') !== 'delete') return;

      event.preventDefault();

      void (async () => {
        clearFlash(root);
        setBusy(form, true);
        try {
          const result = await postForm(form);
          if (!result.ok) {
            setFlash(root, 'error', result.error || 'Unable to delete that task.');
            return;
          }
          const taskId = result.taskId || String(new FormData(form).get('taskId') ?? '').trim();
          if (taskId) removeTask(root, taskId);
        } finally {
          setBusy(form, false);
        }
      })();
    });
  });
</script>
