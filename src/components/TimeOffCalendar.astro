---
import {
  eachDayInRange,
  formatDayNumber,
  formatScheduleHeading,
  formatWeekdayShort,
  shiftIsoDate,
  weekRangeForDate,
} from '../lib/schedule/range';
import { todayEastern } from '../lib/financials/periods';

interface Props {
  weekStart?: string | null;
}

const { weekStart = null } = Astro.props;

const anchor =
  weekStart && /^\d{4}-\d{2}-\d{2}$/.test(weekStart) ? weekStart : todayEastern();
const { start, end } = weekRangeForDate(anchor);
const weekDays = eachDayInRange(start, end);
const today = todayEastern();
const hourHeight = 32;
const gridHours = Array.from({ length: 24 }, (_, index) => index);
const heading = formatScheduleHeading({ id: 'this_week', start, end });
const onThisWeek = start === weekRangeForDate(today).start;
const prevHref = `/time-off?week=${shiftIsoDate(start, -7)}`;
const nextHref = `/time-off?week=${shiftIsoDate(start, 7)}`;

function hourLabel(hour: number): string {
  const suffix = hour >= 12 ? 'p' : 'a';
  const display = hour % 12 === 0 ? 12 : hour % 12;
  return `${display}${suffix}`;
}
---

<div class="overflow-hidden rounded-xl bg-white shadow-sm ring-1 ring-black/[0.06]">
  <div class="flex flex-wrap items-center justify-between gap-3 border-b border-[#eceef2] px-4 py-3">
    <p class="text-sm font-semibold text-[#393a3d]">{heading}</p>
    <div class="flex items-center gap-2">
      <a
        href={prevHref}
        class="rounded-md border border-[#d5d8de] px-2.5 py-1 text-[11px] font-semibold text-[#393a3d] transition hover:bg-[#f4f5f8]"
      >
        Previous
      </a>
      {
        !onThisWeek ? (
          <a
            href="/time-off"
            class="rounded-md border border-[#d5d8de] px-2.5 py-1 text-[11px] font-semibold text-[#393a3d] transition hover:bg-[#f4f5f8]"
          >
            This week
          </a>
        ) : null
      }
      <a
        href={nextHref}
        class="rounded-md border border-[#d5d8de] px-2.5 py-1 text-[11px] font-semibold text-[#393a3d] transition hover:bg-[#f4f5f8]"
      >
        Next
      </a>
    </div>
  </div>

  <div class="max-h-[min(70vh,40rem)] overflow-auto overscroll-contain font-sans text-[#393a3d]">
    <div class="sticky top-0 z-10 grid grid-cols-[2.5rem_repeat(7,minmax(0,1fr))] border-b border-[#eceef2] bg-white">
      <div class="border-r border-[#eceef2]"></div>
      {
        weekDays.map((day) => (
          <div
            class:list={[
              'border-r border-[#eceef2] px-1 py-2 text-center last:border-r-0',
              day === today && 'bg-[#eef4ff]',
            ]}
          >
            <p class="text-[10px] font-semibold uppercase tracking-wide text-[#6b6c72]">
              {formatWeekdayShort(day).slice(0, 3)}
            </p>
            <p
              class:list={[
                'mx-auto mt-1 flex h-6 w-6 items-center justify-center text-xs font-semibold',
                day === today ? 'rounded-full bg-[#1a73e8] text-white' : 'text-[#393a3d]',
              ]}
            >
              {formatDayNumber(day)}
            </p>
          </div>
        ))
      }
    </div>

    <div
      class="relative grid grid-cols-[2.5rem_repeat(7,minmax(0,1fr))]"
      style={`height: ${24 * hourHeight}px`}
    >
      <div class="relative border-r border-[#eceef2]">
        {
          gridHours.map((hour) => (
            <div
              class="absolute right-1 -translate-y-1/2 text-[10px] text-[#8b8d93]"
              style={`top: ${hour * hourHeight}px`}
            >
              {hourLabel(hour)}
            </div>
          ))
        }
      </div>
      {
        weekDays.map((day) => (
          <div
            class:list={[
              'relative border-r border-[#eceef2] last:border-r-0',
              day === today && 'bg-[#f7faff]',
            ]}
          >
            {
              gridHours.map((hour) => (
                <div
                  class="absolute inset-x-0 border-t border-[#f0f1f4]"
                  style={`top: ${hour * hourHeight}px`}
                ></div>
              ))
            }
          </div>
        ))
      }
    </div>
  </div>
</div>
