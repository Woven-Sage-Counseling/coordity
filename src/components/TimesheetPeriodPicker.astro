---
import { timesheetPeriodOptions, type TimesheetResolvedPeriod } from '../lib/timesheet-periods';

interface Props {
  period: TimesheetResolvedPeriod;
  action: string;
  class?: string;
  compact?: boolean;
}

const { period, action, compact = false } = Astro.props;
const formClass = Astro.props.class ?? (compact ? '' : 'mt-4');
const options = timesheetPeriodOptions();
const showDates = period.id === 'custom';
---

<form
  method="get"
  action={action}
  class:list={[
    'flex flex-wrap items-center gap-2',
    compact ? '' : 'items-end gap-3',
    formClass,
  ]}
>
  <slot />
  {
    compact ? (
      <select
        name="period"
        aria-label="Timeframe"
        class="field !mt-0 !py-1.5 !text-sm max-w-[11rem]"
        onchange="const custom = this.value === 'custom'; const start = this.form.elements.namedItem('start'); const end = this.form.elements.namedItem('end'); const dates = this.form.querySelector('[data-custom-dates]'); if (start) start.disabled = !custom; if (end) end.disabled = !custom; if (dates) dates.classList.toggle('hidden', !custom); if (!custom) this.form.submit();"
      >
        {
          options.map((option: { id: string; label: string }) => (
            <option value={option.id} selected={period.id === option.id}>
              {option.label}
            </option>
          ))
        }
        <option value="custom" selected={period.id === 'custom'}>
          Custom dates
        </option>
      </select>
    ) : (
      <label class="block">
        <span class="text-sm text-sage-dark/70">Timeframe</span>
        <select
          name="period"
          class="field mt-1 max-w-xs"
          onchange="const custom = this.value === 'custom'; const start = this.form.elements.namedItem('start'); const end = this.form.elements.namedItem('end'); if (start) start.disabled = !custom; if (end) end.disabled = !custom; if (!custom) this.form.submit();"
        >
          {
            options.map((option: { id: string; label: string }) => (
              <option value={option.id} selected={period.id === option.id}>
                {option.label}
              </option>
            ))
          }
          <option value="custom" selected={period.id === 'custom'}>
            Custom dates
          </option>
        </select>
      </label>
    )
  }

  <div
    class:list={[
      'flex flex-wrap items-center gap-2',
      compact ? '' : 'items-end',
      showDates ? '' : 'hidden',
    ]}
    data-custom-dates
  >
    {
      compact ? (
        <>
          <input
            class="field !mt-0 !py-1.5 !text-sm"
            type="date"
            name="start"
            aria-label="From"
            value={period.start}
            disabled={!showDates}
          />
          <span class="text-xs text-sage-dark/45">to</span>
          <input
            class="field !mt-0 !py-1.5 !text-sm"
            type="date"
            name="end"
            aria-label="To"
            value={period.end}
            disabled={!showDates}
          />
          <button class="btn-secondary !px-3 !py-1.5 !text-sm" type="submit">
            Apply
          </button>
        </>
      ) : (
        <>
          <label class="block">
            <span class="text-sm text-sage-dark/70">From</span>
            <input class="field mt-1" type="date" name="start" value={period.start} disabled={!showDates} />
          </label>
          <label class="block">
            <span class="text-sm text-sage-dark/70">To</span>
            <input class="field mt-1" type="date" name="end" value={period.end} disabled={!showDates} />
          </label>
          <button class="btn-secondary !px-4 !py-2" type="submit">
            Apply
          </button>
        </>
      )
    }
  </div>
</form>
