---
import { timesheetPeriodOptions, type TimesheetResolvedPeriod } from '../lib/timesheet-periods';

interface Props {
  period: TimesheetResolvedPeriod;
  action: string;
  class?: string;
  compact?: boolean;
}

const { period, action, compact = false } = Astro.props;
const formClass = Astro.props.class ?? (compact ? '' : 'mt-4');
const options = timesheetPeriodOptions();
const showDates = period.id === 'custom';
---

<form
  method="get"
  action={action}
  class:list={[
    'flex flex-wrap items-center gap-2',
    compact ? '' : 'items-end gap-3',
    formClass,
  ]}
  data-timesheet-period-picker
>
  <slot />
  {
    compact ? (
      <select name="period" aria-label="Timeframe" class="field !mt-0 !h-8 !min-h-0 !w-auto !max-w-[9.5rem] !py-0 !pl-2 !pr-7 !text-xs" data-period-select>
        {
          options.map((option: { id: string; label: string }) => (
            <option value={option.id} selected={period.id === option.id}>
              {option.label}
            </option>
          ))
        }
        <option value="custom" selected={period.id === 'custom'}>
          Custom dates
        </option>
      </select>
    ) : (
      <label class="block">
        <span class="text-sm text-sage-dark/70">Timeframe</span>
        <select name="period" class="field mt-1 max-w-xs" data-period-select>
          {
            options.map((option: { id: string; label: string }) => (
              <option value={option.id} selected={period.id === option.id}>
                {option.label}
              </option>
            ))
          }
          <option value="custom" selected={period.id === 'custom'}>
            Custom dates
          </option>
        </select>
      </label>
    )
  }

  <div
    class:list={[
      'flex flex-wrap items-center gap-2',
      compact ? '' : 'items-end',
      showDates ? '' : 'hidden',
    ]}
    data-custom-dates
  >
    {
      compact ? (
        <>
          <input
            class="field !mt-0 !h-8 !min-h-0 !py-0 !px-2 !text-xs"
            type="date"
            name="start"
            aria-label="From"
            value={period.start}
            disabled={!showDates}
          />
          <span class="text-xs text-sage-dark/45">to</span>
          <input
            class="field !mt-0 !h-8 !min-h-0 !py-0 !px-2 !text-xs"
            type="date"
            name="end"
            aria-label="To"
            value={period.end}
            disabled={!showDates}
          />
          <button class="btn-secondary !h-8 !px-2.5 !py-0 !text-xs" type="submit">
            Apply
          </button>
        </>
      ) : (
        <>
          <label class="block">
            <span class="text-sm text-sage-dark/70">From</span>
            <input class="field mt-1" type="date" name="start" value={period.start} disabled={!showDates} />
          </label>
          <label class="block">
            <span class="text-sm text-sage-dark/70">To</span>
            <input class="field mt-1" type="date" name="end" value={period.end} disabled={!showDates} />
          </label>
          <button class="btn-secondary !px-4 !py-2" type="submit">
            Apply
          </button>
        </>
      )
    }
  </div>
</form>

<script is:inline>
  document.querySelectorAll('[data-timesheet-period-picker]').forEach((form) => {
    if (!(form instanceof HTMLFormElement)) return;
    const select = form.querySelector('[data-period-select]');
    if (!(select instanceof HTMLSelectElement)) return;
    select.addEventListener('change', () => {
      const isCustom = select.value === 'custom';
      const start = form.elements.namedItem('start');
      const end = form.elements.namedItem('end');
      const dates = form.querySelector('[data-custom-dates]');
      if (start instanceof HTMLInputElement) start.disabled = !isCustom;
      if (end instanceof HTMLInputElement) end.disabled = !isCustom;
      if (dates instanceof HTMLElement) dates.classList.toggle('hidden', !isCustom);
      if (!isCustom) form.submit();
    });
  });
</script>
