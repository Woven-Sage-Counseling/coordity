---
import FinancialAccountChecklist from './FinancialAccountChecklist.astro';
import { normalizeMatchName, type OutlookLine } from '../lib/financials/outlook';
import type { ChartAccountChoice } from '../lib/financials/quickbooks';

interface Props {
  lines: OutlookLine[];
  expenseAccounts: ChartAccountChoice[];
  bankAccounts: ChartAccountChoice[];
  accountsLoaded: boolean;
  accountsError: string | null;
  reserveTargetMonths: number;
  operationsStart: string;
  periodId: string;
  periodStart: string;
  periodEnd: string;
}

const {
  lines,
  expenseAccounts,
  bankAccounts,
  accountsLoaded,
  accountsError,
  reserveTargetMonths,
  operationsStart,
  periodId,
  periodStart,
  periodEnd,
} = Astro.props;

const expenseLines = lines.filter((line) => line.kind === 'expense');
const cashLines = lines.filter((line) => line.kind === 'cash');

function accountChecked(line: OutlookLine, account: ChartAccountChoice): boolean {
  return line.accounts.some(
    (saved) =>
      saved.qbAccountId === account.id ||
      saved.matchName === normalizeMatchName(account.name) ||
      (account.accountNumber != null && saved.matchName === normalizeMatchName(account.accountNumber)),
  );
}
---

<section class="mt-12" id="outlook" aria-labelledby="outlook-heading">
  <h2 id="outlook-heading" class="font-display text-2xl text-charcoal">Set up the dashboard</h2>
  <p class="mt-2 max-w-2xl text-sm leading-6 text-sage-dark/75">
    Three steps. Name a group, check the QuickBooks accounts that belong in it, then save. The charts above change. QuickBooks does not.
  </p>
  {
    expenseLines.length === 0 && cashLines.length === 0 && (
      <p class="mt-3 max-w-2xl rounded-xl bg-white px-4 py-3 text-sm leading-6 text-charcoal shadow-sm ring-1 ring-black/[0.06]">
        Nothing is set up yet, so this page shows every income and expense number from QuickBooks.
      </p>
    )
  }

  <form method="post" action="/api/financials/outlook" class="mt-4 space-y-4">
    {accountsLoaded && <input type="hidden" name="accountsLoaded" value="1" />}
    <input type="hidden" name="period" value={periodId} />
    <input type="hidden" name="start" value={periodStart} />
    <input type="hidden" name="end" value={periodEnd} />

    <article class="rounded-2xl bg-white p-5 shadow-sm ring-1 ring-black/[0.06]">
      <h3 class="text-lg font-semibold text-charcoal">1. Expense bars</h3>
      <p class="mt-1 max-w-2xl text-sm leading-6 text-sage-dark/75">
        Each group becomes one bar under Profit and Loss. Check the accounts that should be added together. A group called Payroll might include Wages and Payroll taxes.
      </p>

      {
        expenseLines.map((line) => (
          <fieldset class="mt-4 rounded-xl bg-[#f7f8f6] p-4">
            <legend class="px-1 text-sm font-semibold text-charcoal">{line.label}</legend>
            <input type="hidden" name="lineId" value={line.id} />
            <input type="hidden" name="lineKind" value="expense" />
            <input type="hidden" name="lineRole" value="expense" />
            <label class="block text-sm text-charcoal">
              Name on the dashboard
              <input class="field" type="text" name="lineLabel" required value={line.label} />
            </label>
            <label class="mt-3 block text-sm text-charcoal">
              Bar color
              <input class="field h-11 w-16" type="color" name="lineColor" value={line.color || '#3d8b37'} />
            </label>
            <p class="mt-3 text-sm font-medium text-charcoal">
              QuickBooks accounts in this bar
              <span class="ml-1 font-normal text-sage-dark/60" data-checked-count></span>
            </p>
            {accountsLoaded ? (
              <FinancialAccountChecklist
                accounts={expenseAccounts}
                fieldName="lineAccount"
                emptyMessage="QuickBooks did not return any expense accounts."
                valueFor={(account) => `${line.id}\t${account.id}\t${normalizeMatchName(account.name)}`}
                isChecked={(account) => accountChecked(line, account)}
              />
            ) : (
              <label class="mt-2 block text-sm text-charcoal">
                Type one QuickBooks account name per line
                <textarea class="field min-h-16" name="lineTyped">{line.accounts.map((account) => account.matchName).join('\n')}</textarea>
              </label>
            )}
            <label class="mt-3 inline-flex items-center gap-2 text-sm text-charcoal">
              <input type="checkbox" name="remove" value={line.id} />
              Take this bar off the dashboard
            </label>
          </fieldset>
        ))
      }

      <fieldset class="mt-4 rounded-xl border border-dashed border-sage-dark/30 p-4">
        <legend class="px-1 text-sm font-semibold text-charcoal">Add an expense bar</legend>
        <label class="block text-sm text-charcoal">
          Name on the dashboard
          <input class="field" type="text" name="newExpenseLabel" placeholder="Payroll" />
        </label>
        <label class="mt-3 block text-sm text-charcoal">
          Bar color
          <input class="field h-11 w-16" type="color" name="newExpenseColor" value="#3d8b37" />
        </label>
        <p class="mt-3 text-sm font-medium text-charcoal">
          QuickBooks accounts in this bar
          <span class="ml-1 font-normal text-sage-dark/60" data-checked-count></span>
        </p>
        {accountsLoaded ? (
          <FinancialAccountChecklist
            accounts={expenseAccounts}
            fieldName="newExpenseAccount"
            emptyMessage="QuickBooks did not return any expense accounts."
            valueFor={(account) => `${account.id}\t${normalizeMatchName(account.name)}`}
          />
        ) : (
          <label class="mt-2 block text-sm text-charcoal">
            Type one QuickBooks account name per line
            <textarea class="field min-h-16" name="newExpenseTyped"></textarea>
          </label>
        )}
        <p class="mt-2 text-xs text-sage-dark/60">Leave the name blank if you are not adding a bar.</p>
      </fieldset>
    </article>

    <article class="rounded-2xl bg-white p-5 shadow-sm ring-1 ring-black/[0.06]">
      <h3 class="text-lg font-semibold text-charcoal">2. Bank cards</h3>
      <p class="mt-1 max-w-2xl text-sm leading-6 text-sage-dark/75">
        Each card shows a bank balance under Cash and reserves. Mark one as the savings goal if you want the circle at the top. Only one savings goal is used.
      </p>

      {
        cashLines.map((line) => (
          <fieldset class="mt-4 rounded-xl bg-[#f7f8f6] p-4">
            <legend class="px-1 text-sm font-semibold text-charcoal">{line.label}</legend>
            <input type="hidden" name="lineId" value={line.id} />
            <input type="hidden" name="lineKind" value="cash" />
            <input type="hidden" name="lineColor" value={line.color || '#3d8b37'} />
            <label class="block text-sm text-charcoal">
              Name on the dashboard
              <input class="field" type="text" name="lineLabel" required value={line.label} />
            </label>
            <label class="mt-3 block text-sm text-charcoal">
              What is this money for?
              <select class="field" name="lineRole">
                <option value="operating" selected={line.role !== 'reserve'}>Everyday money</option>
                <option value="reserve" selected={line.role === 'reserve'}>Savings goal</option>
              </select>
            </label>
            <p class="mt-3 text-sm font-medium text-charcoal">
              QuickBooks bank account
              <span class="ml-1 font-normal text-sage-dark/60" data-checked-count></span>
            </p>
            {accountsLoaded ? (
              <FinancialAccountChecklist
                accounts={bankAccounts}
                fieldName="lineAccount"
                emptyMessage="QuickBooks did not return any bank accounts."
                valueFor={(account) => `${line.id}\t${account.id}\t${normalizeMatchName(account.name)}`}
                isChecked={(account) => accountChecked(line, account)}
              />
            ) : (
              <label class="mt-2 block text-sm text-charcoal">
                Type one account name or number per line
                <textarea class="field min-h-16" name="lineTyped">{line.accounts.map((account) => account.matchName).join('\n')}</textarea>
              </label>
            )}
            <label class="mt-3 inline-flex items-center gap-2 text-sm text-charcoal">
              <input type="checkbox" name="remove" value={line.id} />
              Take this card off the dashboard
            </label>
          </fieldset>
        ))
      }

      <fieldset class="mt-4 rounded-xl border border-dashed border-sage-dark/30 p-4">
        <legend class="px-1 text-sm font-semibold text-charcoal">Add a bank card</legend>
        <label class="block text-sm text-charcoal">
          Name on the dashboard
          <input class="field" type="text" name="newCashLabel" placeholder="Operating checking" />
        </label>
        <label class="mt-3 block text-sm text-charcoal">
          What is this money for?
          <select class="field" name="newCashRole">
            <option value="operating">Everyday money</option>
            <option value="reserve">Savings goal</option>
          </select>
        </label>
        <p class="mt-3 text-sm font-medium text-charcoal">
          QuickBooks bank account
          <span class="ml-1 font-normal text-sage-dark/60" data-checked-count></span>
        </p>
        {accountsLoaded ? (
          <FinancialAccountChecklist
            accounts={bankAccounts}
            fieldName="newCashAccount"
            emptyMessage="QuickBooks did not return any bank accounts."
            valueFor={(account) => `${account.id}\t${normalizeMatchName(`${account.name} ${account.accountNumber ?? ''}`)}`}
          />
        ) : (
          <label class="mt-2 block text-sm text-charcoal">
            Type one account name or number per line
            <textarea class="field min-h-16" name="newCashTyped"></textarea>
          </label>
        )}
        <p class="mt-2 text-xs text-sage-dark/60">Leave the name blank if you are not adding a card.</p>
      </fieldset>
    </article>

    <article class="rounded-2xl bg-white p-5 shadow-sm ring-1 ring-black/[0.06]">
      <h3 class="text-lg font-semibold text-charcoal">3. Savings goal</h3>
      <p class="mt-1 max-w-2xl text-sm leading-6 text-sage-dark/75">
        The circle compares the savings-goal bank card with this many months of expenses. It shows up after you save a bank card marked Savings goal.
      </p>
      <div class="mt-4 grid gap-3 sm:grid-cols-2">
        <label class="block text-sm text-charcoal">
          Months of expenses to save
          <input class="field" type="number" name="reserveTargetMonths" min="1" max="24" required value={reserveTargetMonths} />
        </label>
        <label class="block text-sm text-charcoal">
          Start counting from
          <input class="field" type="date" name="operationsStart" value={operationsStart} />
        </label>
      </div>
      <p class="mt-2 text-xs leading-5 text-sage-dark/60">
        Leave the date empty to use every month in the report. Example: 3 months means the circle is full when savings cover three months of expenses.
      </p>
    </article>

    {accountsError && <p class="rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800">{accountsError} You can type account names instead, or refresh this page to try QuickBooks again.</p>}

    <div class="flex flex-wrap items-center gap-3">
      <button class="rounded-md bg-[#2CA01C] px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-[#248a18]" type="submit">
        Save dashboard
      </button>
      <p class="text-sm text-sage-dark/70">The charts update after you save.</p>
    </div>
  </form>
</section>

<script>
  function checkedLabel(count: number): string {
    if (count === 0) return 'None checked yet';
    if (count === 1) return '1 checked';
    return `${count} checked`;
  }

  function refreshChecklist(list: HTMLElement): void {
    const count = list.querySelectorAll('input[type="checkbox"]:checked').length;
    const status = list.closest('fieldset')?.querySelector('[data-checked-count]');
    if (status) status.textContent = checkedLabel(count);
    const query = (list.parentElement?.querySelector('[data-account-filter]') as HTMLInputElement | null)?.value.trim().toLowerCase() ?? '';
    list.querySelectorAll<HTMLElement>('[data-account-name]').forEach((row) => {
      const name = row.dataset.accountName ?? '';
      const checked = row.querySelector('input') instanceof HTMLInputElement && row.querySelector('input')!.checked;
      row.hidden = query.length > 0 && !checked && !name.includes(query);
    });
  }

  document.querySelectorAll<HTMLElement>('[data-account-list]').forEach((list) => {
    refreshChecklist(list);
    list.addEventListener('change', () => refreshChecklist(list));
    const filter = list.parentElement?.querySelector('[data-account-filter]');
    filter?.addEventListener('input', () => refreshChecklist(list));
    filter?.addEventListener('keydown', (event) => {
      if (event instanceof KeyboardEvent && event.key === 'Enter') event.preventDefault();
    });
  });
</script>
