---
import {
  getTimesheetSummary,
  serializeTimesheetShift,
  serializeTimesheetSummary,
} from '../lib/timesheet-entries';
import { getWorkCategoryLookup } from '../lib/timesheet-work-categories';
import { formatWeekLabel } from '../lib/timesheet';
import { shiftButtonClasses } from '../lib/timesheet-shift-buttons';
import { widgetAccentVarsStyle } from '../lib/home-widget-header';
import { isUserOnApprovedTimeOffNow } from '../lib/time-off-requests';
import ShiftStatusIndicator from './ShiftStatusIndicator.astro';
import WidgetHeaderBar from './WidgetHeaderBar.astro';

interface Props {
  userId: string;
}

const { userId } = Astro.props;

let summary = null;
let timesheetLoadError: string | null = null;

try {
  summary = await getTimesheetSummary(userId);
} catch (error) {
  console.error('timesheet widget load failed', error);
  timesheetLoadError = 'Timesheet is temporarily unavailable.';
}

const categoryLookup = await getWorkCategoryLookup();
const serialized = summary ? serializeTimesheetSummary(summary, { categoryLookup }) : null;
const activeShift = summary?.activeShift ?? null;
const onTimeOff = summary ? await isUserOnApprovedTimeOffNow(userId) : false;
const week = summary?.week;
---

<aside
  class="flex h-full min-h-0 max-h-full flex-col overflow-hidden rounded-[1.05rem] shadow-[0_12px_32px_rgba(26,28,30,0.12)] ring-1 ring-black/10"
  aria-labelledby="home-timesheet-heading"
  data-timesheet-widget
  data-widget-card
  data-widget-id="timesheet"
  style={widgetAccentVarsStyle('timesheet')}
  data-summary={serialized ? JSON.stringify(serialized) : ''}
>
  <WidgetHeaderBar
    widgetId="timesheet"
    title="Timesheet"
    headingId="home-timesheet-heading"
    openHref="/timesheet"
  />

  <div class="flex min-h-0 flex-1 flex-col bg-[#f4f5f8] px-4 pb-4 pt-3 font-sans text-[#393a3d]">
    <div data-timesheet-flash hidden></div>

    {
      timesheetLoadError ? (
        <p class="rounded-lg border border-amber-200 bg-amber-50 px-2.5 py-2 text-[11px] text-amber-900">
          {timesheetLoadError}
        </p>
      ) : (
        <>
          <div class="grid grid-cols-2 gap-2">
            <div class="rounded-lg bg-white p-3 shadow-sm ring-1 ring-black/[0.06]">
              <p class="text-[10px] font-semibold uppercase tracking-[0.14em] text-[#6b6c72]">This week</p>
              <p class="mt-1 text-xl font-semibold leading-none text-charcoal" data-timesheet-week-total>
                {serialized?.week.totalLabel ?? '0 hrs'}
              </p>
              {
                week ? (
                  <p class="mt-1 text-[10px] text-[#6b6c72]" data-timesheet-week-label>
                    {formatWeekLabel(week.start, week.end)}
                  </p>
                ) : null
              }
            </div>
            <div class="rounded-lg bg-white p-3 shadow-sm ring-1 ring-black/[0.06]">
              <p class="text-[10px] font-semibold uppercase tracking-[0.14em] text-[#6b6c72]">Weekly avg</p>
              <p class="mt-1 text-xl font-semibold leading-none text-charcoal" data-timesheet-average-total>
                {serialized?.weeklyAverageLabel ?? '0 hrs'}
              </p>
            </div>
          </div>

          <div class="mt-3 flex min-w-0 items-center gap-2">
            <ShiftStatusIndicator onShift={activeShift != null} onTimeOff={onTimeOff} compact self />
            <form method="post" action="/api/timesheet/start-shift" class="min-w-0 flex-1" data-timesheet-start-form>
              <input type="hidden" name="returnTo" value="/" />
              <button
                type="submit"
                class={shiftButtonClasses(activeShift != null, 'start', 'widget')}
                data-timesheet-start-btn
                disabled={activeShift != null}
              >
                START&nbsp;shift
              </button>
            </form>
            <form method="post" action="/api/timesheet/end-shift" class="min-w-0 flex-1" data-timesheet-end-form>
              <input type="hidden" name="returnTo" value="/" />
              <button
                type="submit"
                class={shiftButtonClasses(activeShift != null, 'end', 'widget')}
                data-timesheet-end-btn
                disabled={activeShift == null}
              >
                END&nbsp;shift
              </button>
            </form>
          </div>

          <p class="mt-2 text-[10px] text-[#6b6c72]" data-timesheet-active-since>
            {
              activeShift?.startedAt
                ? `On shift since ${new Date(activeShift.startedAt).toLocaleTimeString('en-US', {
                    timeZone: 'America/New_York',
                    hour: 'numeric',
                    minute: '2-digit',
                  })}`
                : 'Not clocked in'
            }
          </p>

          <div class="mt-3 min-h-0 flex-1 overflow-y-auto overscroll-contain">
            <p class="text-[11px] font-semibold uppercase tracking-[0.14em] text-[#6b6c72]">Recent shifts</p>
            <p
              class="mt-2 text-[12px] text-[#6b6c72]"
              data-timesheet-empty
              hidden={(week?.entries.length ?? 0) > 0}
            >
              No shifts logged this week yet.
            </p>
            <ul class="mt-2 space-y-2" data-timesheet-list hidden={(week?.entries.length ?? 0) === 0}>
              {
                week?.entries.map((entry) => {
                  const item = serializeTimesheetShift(entry, { categoryLookup });
                  return (
                    <li class="rounded-lg bg-white px-2.5 py-2 shadow-sm ring-1 ring-black/[0.06]" data-timesheet-item>
                      <div class="flex items-start justify-between gap-2">
                        <div class="min-w-0">
                          <p class="text-[12px] font-semibold text-charcoal">{item.dateLabel}</p>
                          <p class="mt-0.5 text-[11px] text-[#6b6c72]">{item.timeLabel}</p>
                        </div>
                        <p class="text-[12px] font-semibold text-charcoal">{item.hoursLabel}</p>
                      </div>
                    </li>
                  );
                })
              }
            </ul>
          </div>
        </>
      )
    }
  </div>
</aside>

<script>
  import { applyShiftButtonState } from '../lib/timesheet-shift-buttons';

  function setFlash(root: HTMLElement, kind: 'ok' | 'error', text: string): void {
    const flash = root.querySelector('[data-timesheet-flash]');
    if (!(flash instanceof HTMLElement)) return;
    const classes =
      kind === 'error'
        ? 'rounded-lg border border-red-200 bg-red-50 px-2.5 py-2 text-[11px] text-red-800'
        : 'rounded-lg border border-sage-dark/15 bg-white px-2.5 py-2 text-[11px] text-sage-dark/80';
    flash.innerHTML = `<p class="${classes}">${text}</p>`;
    flash.hidden = false;
  }

  function applySummary(root: HTMLElement, summary: Record<string, unknown>): void {
    root.dataset.summary = JSON.stringify(summary);
    const week = summary.week as { totalLabel?: string; entries?: Array<Record<string, unknown>> };
    const activeShift = summary.activeShift as { startedAt?: number | null } | null;

    const weekTotal = root.querySelector('[data-timesheet-week-total]');
    const averageTotal = root.querySelector('[data-timesheet-average-total]');
    const activeSince = root.querySelector('[data-timesheet-active-since]');
    const startBtn = root.querySelector('[data-timesheet-start-btn]') as HTMLButtonElement | null;
    const endBtn = root.querySelector('[data-timesheet-end-btn]') as HTMLButtonElement | null;
    const list = root.querySelector('[data-timesheet-list]');
    const empty = root.querySelector('[data-timesheet-empty]');

    if (weekTotal && week.totalLabel) weekTotal.textContent = week.totalLabel;
    if (averageTotal && summary.weeklyAverageLabel) {
      averageTotal.textContent = String(summary.weeklyAverageLabel);
    }
    applyShiftButtonState(startBtn, endBtn, activeShift, 'widget');

    const entries = week.entries ?? [];
    if (list instanceof HTMLElement) {
      list.innerHTML = entries
        .map(
          (entry) => `
          <li class="rounded-lg bg-white px-2.5 py-2 shadow-sm ring-1 ring-black/[0.06]" data-timesheet-item>
            <div class="flex items-start justify-between gap-2">
              <div class="min-w-0">
                <p class="text-[12px] font-semibold text-charcoal">${String(entry.dateLabel)}</p>
                <p class="mt-0.5 text-[11px] text-[#6b6c72]">${String(entry.timeLabel)}</p>
              </div>
              <p class="text-[12px] font-semibold text-charcoal">${String(entry.hoursLabel)}</p>
            </div>
          </li>
        `,
        )
        .join('');
      list.hidden = entries.length === 0;
    }
    if (empty instanceof HTMLElement) empty.hidden = entries.length > 0;

    if (activeShift?.startedAt && activeSince) {
      activeSince.textContent = `On shift since ${new Date(Number(activeShift.startedAt)).toLocaleTimeString('en-US', {
        timeZone: 'America/New_York',
        hour: 'numeric',
        minute: '2-digit',
      })}`;
    } else if (activeSince) {
      activeSince.textContent = 'Not clocked in';
    }
  }

  async function submitForm(form: HTMLFormElement, root: HTMLElement): Promise<void> {
    const button = form.querySelector('button[type="submit"]') as HTMLButtonElement | null;
    if (button) button.disabled = true;
    try {
      const response = await fetch(form.action, {
        method: 'POST',
        body: new FormData(form),
        headers: { accept: 'application/json' },
      });
      const payload = (await response.json()) as {
        ok?: boolean;
        summary?: Record<string, unknown>;
        error?: string;
      };
      if (!response.ok || !payload.ok || !payload.summary) {
        throw new Error(payload.error ?? 'Unable to update your timesheet.');
      }
      applySummary(root, payload.summary);
      setFlash(
        root,
        'ok',
        form.matches('[data-timesheet-start-form]') ? 'Shift started.' : 'Shift ended and saved.',
      );
    } catch (error) {
      setFlash(root, 'error', error instanceof Error ? error.message : 'Unable to update your timesheet.');
      const summary = JSON.parse(root.dataset.summary || '{}') as Record<string, unknown>;
      applySummary(root, summary);
    }
  }

  document.querySelectorAll('[data-timesheet-widget]').forEach((root) => {
    if (!(root instanceof HTMLElement) || !root.dataset.summary) return;
    applySummary(root, JSON.parse(root.dataset.summary) as Record<string, unknown>);
    root.querySelectorAll('[data-timesheet-start-form], [data-timesheet-end-form]').forEach((formNode) => {
      if (!(formNode instanceof HTMLFormElement)) return;
      formNode.addEventListener('submit', (event) => {
        event.preventDefault();
        void submitForm(formNode, root);
      });
    });
  });
</script>
