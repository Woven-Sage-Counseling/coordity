---
import '../styles/global.css';
/**
 * Apex product landing for coordity.com — light marketing shell.
 * Workspace finder sits under the hero (replacing the old icon row).
 */
import CoordityMark from './CoordityMark.astro';
import { COORDITY_PRODUCT_NAME } from '../lib/organization';

interface Props {
  error?: string | null;
}

const { error = null } = Astro.props;
const year = new Date().getFullYear();

/**
 * Concentric C-arcs with even stroke width and even centerline spacing
 * (logo mark keeps its staggered terminals; hero wants uniform gaps).
 */
const heroStroke = 3.4;
const heroArcs = [
  { d: 'M33.45 12.55 A16.2 16.2 0 1 0 33.45 35.45', width: heroStroke, color: '#005284', opacity: 0.12 },
  { d: 'M30.48 15.52 A12.0 12.0 0 1 0 30.48 32.48', width: heroStroke, color: '#FECB00', opacity: 0.22 },
  { d: 'M27.51 18.49 A7.8 7.8 0 1 0 27.51 29.51', width: heroStroke, color: '#005284', opacity: 0.14 },
] as const;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="Coordity builds the infrastructure that helps behavioral health practices thrive."
    />
    <link rel="icon" href="/favicon-coordity.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-coordity.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon-coordity-16.png" type="image/png" sizes="16x16" />
    <title>{COORDITY_PRODUCT_NAME} — Connected systems. Brighter care.</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;1,9..40,400&family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="coordity-landing antialiased">
    <header class="relative z-30">
      <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-5 py-5 sm:px-8">
        <div class="flex min-w-0 items-center gap-6 lg:gap-8">
          <a href="/" class="coordity-fade-in shrink-0">
            <CoordityMark variant="dark" class="text-[1.65rem]" />
          </a>

          <nav class="coordity-topnav coordity-fade-in" aria-label="Primary" style="animation-delay: 40ms">
            <div class="coordity-topnav__item" data-coordity-dd>
              <button
                type="button"
                class="coordity-topnav__trigger"
                data-coordity-dd-trigger
                aria-expanded="false"
                aria-haspopup="true"
              >
                Who we&rsquo;re for
                <svg class="coordity-topnav__caret" width="12" height="12" viewBox="0 0 12 12" aria-hidden="true">
                  <path d="M2.5 4.5 L6 8 L9.5 4.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </button>
              <div class="coordity-topnav__panel" data-coordity-dd-panel hidden>
                <a href="#who-group-practices">Group practices</a>
                <a href="#who-solo">Solo clinicians</a>
                <a href="#who-multi">Multi-location orgs</a>
              </div>
            </div>

            <a class="coordity-topnav__link" href="#pricing">Pricing</a>
            <a class="coordity-topnav__link" href="#features">Features</a>

            <div class="coordity-topnav__item" data-coordity-dd>
              <button
                type="button"
                class="coordity-topnav__trigger"
                data-coordity-dd-trigger
                aria-expanded="false"
                aria-haspopup="true"
              >
                More
                <svg class="coordity-topnav__caret" width="12" height="12" viewBox="0 0 12 12" aria-hidden="true">
                  <path d="M2.5 4.5 L6 8 L9.5 4.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </button>
              <div class="coordity-topnav__panel" data-coordity-dd-panel hidden>
                <a href="/sign-up">Create a workspace</a>
                <a href="#workspace">Log in to your workspace</a>
                <a href="#about">About Coordity</a>
              </div>
            </div>
          </nav>
        </div>

        <button
          type="button"
          class="coordity-fade-in inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-full text-[#005284] transition hover:bg-[#005284]/8 md:hidden"
          style="animation-delay: 60ms"
          data-coordity-menu-open
          aria-expanded="false"
          aria-controls="coordity-menu"
          aria-label="Open menu"
        >
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" />
          </svg>
        </button>
      </div>
    </header>

    <div id="coordity-menu" class="coordity-menu" hidden data-coordity-menu>
      <div class="coordity-menu__backdrop" data-coordity-menu-close aria-hidden="true"></div>
      <nav class="coordity-menu__panel" aria-label="Mobile">
        <div class="flex items-center justify-between px-5 py-5">
          <CoordityMark variant="dark" class="text-[1.35rem]" />
          <button
            type="button"
            class="inline-flex h-10 w-10 items-center justify-center rounded-full text-[#005284] hover:bg-[#005284]/8"
            data-coordity-menu-close
            aria-label="Close menu"
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" />
            </svg>
          </button>
        </div>
        <div class="flex flex-col gap-1 px-3 pb-8">
          <p class="px-4 pb-1 pt-2 text-xs font-semibold uppercase tracking-wide text-[#005284]/45">Who we&rsquo;re for</p>
          <a href="#who-group-practices" class="coordity-menu__link" data-coordity-menu-close>Group practices</a>
          <a href="#who-solo" class="coordity-menu__link" data-coordity-menu-close>Solo clinicians</a>
          <a href="#who-multi" class="coordity-menu__link" data-coordity-menu-close>Multi-location orgs</a>
          <a href="#pricing" class="coordity-menu__link" data-coordity-menu-close>Pricing</a>
          <a href="#features" class="coordity-menu__link" data-coordity-menu-close>Features</a>
          <p class="px-4 pb-1 pt-3 text-xs font-semibold uppercase tracking-wide text-[#005284]/45">More</p>
          <a href="/sign-up" class="coordity-menu__link">Create a workspace</a>
          <a href="#workspace" class="coordity-menu__link" data-coordity-menu-close>Log in to your workspace</a>
          <a href="#about" class="coordity-menu__link" data-coordity-menu-close>About Coordity</a>
        </div>
      </nav>
    </div>

    <main>
      <section class="coordity-hero relative">
        <div class="coordity-hero-arcs" aria-hidden="true">
          <svg viewBox="0 0 48 48" class="coordity-hero-arcs__svg" focusable="false">
            {
              heroArcs.map((arc) => (
                <path
                  d={arc.d}
                  fill="none"
                  stroke={arc.color}
                  stroke-width={arc.width}
                  stroke-linecap="round"
                  opacity={arc.opacity}
                />
              ))
            }
          </svg>
        </div>

        <div class="relative z-10 mx-auto max-w-6xl px-5 pb-16 pt-10 sm:px-8 sm:pb-20 sm:pt-14 lg:pt-16">
          <div id="workspace" class="coordity-rise max-w-xl scroll-mt-24">
            <h1 class="font-[Fraunces] text-[2.75rem] font-semibold leading-[1.08] tracking-[-0.02em] text-[#005284] sm:text-5xl lg:text-[3.55rem]">
              Connected systems.<br />Brighter care.
            </h1>
            <p class="mt-5 max-w-md text-base leading-relaxed text-[#005284]/80 sm:text-lg">
              Coordity builds the infrastructure that helps behavioral health practices thrive.
            </p>

            {
              error && (
                <p class="mt-6 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800">
                  {error}
                </p>
              )
            }

            <form id="workspace-finder" class="mt-8 max-w-md space-y-3" autocomplete="off">
              <label class="block text-sm font-medium text-[#005284]">
                Company name
                <input
                  class="field-coordity mt-1.5"
                  type="search"
                  name="q"
                  id="workspace-query"
                  placeholder="e.g. Woven Sage"
                  required
                  minlength="2"
                />
              </label>
              <button class="coordity-cta inline-flex" type="submit">
                Continue to your workspace
                <span aria-hidden="true">→</span>
              </button>
              <p id="workspace-error" class="hidden text-sm text-[#005284]/70" role="alert"></p>
            </form>

            <ul
              id="workspace-results"
              class="mt-3 max-w-md divide-y divide-[#005284]/10 overflow-hidden rounded-xl border border-[#005284]/12 bg-white"
              hidden
            ></ul>
          </div>
        </div>
      </section>
    </main>

    <footer class="border-t border-[#005284]/10">
      <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-4 px-5 py-8 sm:px-8">
        <CoordityMark variant="dark" class="text-base" />
        <p class="text-xs text-[#005284]/45">© {year} {COORDITY_PRODUCT_NAME}</p>
      </div>
    </footer>

    <script is:inline>
      (function () {
        var menu = document.querySelector('[data-coordity-menu]');
        var openBtn = document.querySelector('[data-coordity-menu-open]');
        function setMenu(open) {
          if (!menu || !openBtn) return;
          menu.hidden = !open;
          openBtn.setAttribute('aria-expanded', open ? 'true' : 'false');
          document.body.style.overflow = open ? 'hidden' : '';
        }
        openBtn &&
          openBtn.addEventListener('click', function () {
            setMenu(true);
          });
        document.querySelectorAll('[data-coordity-menu-close]').forEach(function (el) {
          el.addEventListener('click', function () {
            setMenu(false);
          });
        });

        function closeDropdowns(except) {
          document.querySelectorAll('[data-coordity-dd]').forEach(function (item) {
            if (except && item === except) return;
            var trigger = item.querySelector('[data-coordity-dd-trigger]');
            var panel = item.querySelector('[data-coordity-dd-panel]');
            if (trigger) trigger.setAttribute('aria-expanded', 'false');
            if (panel) panel.hidden = true;
            item.classList.remove('is-open');
          });
        }

        document.querySelectorAll('[data-coordity-dd]').forEach(function (item) {
          var trigger = item.querySelector('[data-coordity-dd-trigger]');
          var panel = item.querySelector('[data-coordity-dd-panel]');
          if (!trigger || !panel) return;
          trigger.addEventListener('click', function (event) {
            event.stopPropagation();
            var open = trigger.getAttribute('aria-expanded') === 'true';
            closeDropdowns();
            if (!open) {
              trigger.setAttribute('aria-expanded', 'true');
              panel.hidden = false;
              item.classList.add('is-open');
            }
          });
        });

        document.addEventListener('click', function () {
          closeDropdowns();
        });
        document.addEventListener('keydown', function (event) {
          if (event.key === 'Escape') {
            setMenu(false);
            closeDropdowns();
          }
        });

        var form = document.getElementById('workspace-finder');
        var input = document.getElementById('workspace-query');
        var results = document.getElementById('workspace-results');
        var errorEl = document.getElementById('workspace-error');
        if (!form || !input || !results || !errorEl) return;

        var debounceTimer = 0;

        function showError(message) {
          errorEl.textContent = message || '';
          errorEl.classList.toggle('hidden', !message);
        }

        function renderOrgs(organizations) {
          results.innerHTML = '';
          if (!organizations.length) {
            results.hidden = true;
            return;
          }
          results.hidden = false;
          organizations.forEach(function (org) {
            var li = document.createElement('li');
            var a = document.createElement('a');
            a.href = org.origin + '/sign-in';
            a.className =
              'flex items-center gap-3 px-4 py-3 text-sm text-[#005284] transition hover:bg-[#005284]/6';
            if (org.logoUrl) {
              var img = document.createElement('img');
              img.src = org.logoUrl;
              img.alt = '';
              img.className = 'h-7 w-auto rounded bg-white px-1 py-0.5 ring-1 ring-[#005284]/10';
              a.appendChild(img);
            }
            var text = document.createElement('span');
            text.className = 'font-medium';
            text.textContent = org.name;
            a.appendChild(text);
            var slug = document.createElement('span');
            slug.className = 'ml-auto text-xs text-[#005284]/45';
            slug.textContent = org.slug + '.coordity.com';
            a.appendChild(slug);
            li.appendChild(a);
            results.appendChild(li);
          });
        }

        function search(q) {
          showError('');
          if (q.length < 2) {
            renderOrgs([]);
            return;
          }
          fetch('/api/orgs/resolve?q=' + encodeURIComponent(q), {
            headers: { Accept: 'application/json' },
          })
            .then(function (res) {
              return res.json().then(function (json) {
                return { ok: res.ok, json: json };
              });
            })
            .then(function (result) {
              if (!result.ok) {
                showError(result.json.error || 'Could not find workspaces.');
                renderOrgs([]);
                return;
              }
              renderOrgs(result.json.organizations || []);
              if (!(result.json.organizations || []).length) {
                showError('No matching workspace. Try another company name.');
              }
            })
            .catch(function () {
              showError('Could not search workspaces.');
            });
        }

        input.addEventListener('input', function () {
          window.clearTimeout(debounceTimer);
          debounceTimer = window.setTimeout(function () {
            search(String(input.value || '').trim());
          }, 280);
        });

        form.addEventListener('submit', function (event) {
          event.preventDefault();
          var q = String(input.value || '').trim();
          if (q.length < 2) {
            showError('Enter at least 2 characters.');
            return;
          }
          fetch('/api/orgs/resolve?q=' + encodeURIComponent(q), {
            headers: { Accept: 'application/json' },
          })
            .then(function (res) {
              return res.json().then(function (json) {
                return { ok: res.ok, json: json };
              });
            })
            .then(function (result) {
              var orgs = (result.json && result.json.organizations) || [];
              if (result.ok && orgs.length === 1) {
                window.location.href = orgs[0].origin + '/sign-in';
                return;
              }
              renderOrgs(orgs);
              if (!orgs.length) {
                showError('No matching workspace. Try another company name.');
              } else {
                showError('Pick your workspace from the list.');
              }
            })
            .catch(function () {
              showError('Could not search workspaces.');
            });
        });
      })();
    </script>
  </body>
</html>

<style is:global>
  .coordity-landing {
    margin: 0;
    min-height: 100%;
    background: #ffffff;
    color: #005284;
    font-family: 'DM Sans', system-ui, sans-serif;
  }

  .coordity-hero {
    overflow-x: clip;
    overflow-y: visible;
    min-height: min(70vh, 36rem);
  }

  /* Same semicircle crop, scaled so the left peak lands near mid-page. */
  .coordity-hero-arcs {
    pointer-events: none;
    position: absolute;
    top: 50%;
    right: 0;
    z-index: 0;
    width: 150vw;
    max-width: none;
    aspect-ratio: 1;
    transform: translate(52%, -50%);
  }

  .coordity-hero-arcs__svg {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  @media (min-width: 768px) {
    .coordity-hero {
      min-height: min(76vh, 42rem);
    }

    .coordity-hero-arcs {
      width: 150vw;
      transform: translate(56%, -50%);
    }
  }

  @media (min-width: 1024px) {
    .coordity-hero {
      min-height: min(80vh, 48rem);
    }

    .coordity-hero-arcs {
      width: 150vw;
      transform: translate(58%, -50%);
    }
  }

  .coordity-topnav {
    display: none;
    align-items: center;
    gap: 0.15rem;
  }

  @media (min-width: 768px) {
    .coordity-topnav {
      display: flex;
    }
  }

  .coordity-topnav__link,
  .coordity-topnav__trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    border: none;
    border-radius: 9999px;
    background: transparent;
    padding: 0.45rem 0.75rem;
    font-family: inherit;
    font-size: 0.9rem;
    font-weight: 550;
    color: #005284;
    cursor: pointer;
    transition: background-color 150ms ease;
  }

  .coordity-topnav__link:hover,
  .coordity-topnav__trigger:hover,
  .coordity-topnav__item.is-open .coordity-topnav__trigger {
    background: rgb(0 82 132 / 0.06);
  }

  .coordity-topnav__caret {
    transition: transform 160ms ease;
  }

  .coordity-topnav__item.is-open .coordity-topnav__caret {
    transform: rotate(180deg);
  }

  .coordity-topnav__item {
    position: relative;
  }

  .coordity-topnav__panel {
    position: absolute;
    top: calc(100% + 0.35rem);
    left: 0;
    z-index: 40;
    min-width: 13.5rem;
    border: 1px solid rgb(0 82 132 / 0.1);
    border-radius: 0.85rem;
    background: #fff;
    padding: 0.35rem;
    box-shadow: 0 14px 36px rgb(0 82 132 / 0.1);
  }

  .coordity-topnav__panel a {
    display: block;
    border-radius: 0.55rem;
    padding: 0.65rem 0.75rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: #005284;
    white-space: nowrap;
  }

  .coordity-topnav__panel a:hover {
    background: rgb(0 82 132 / 0.06);
  }

  .coordity-cta {
    align-items: center;
    gap: 0.55rem;
    border: none;
    border-radius: 9999px;
    background: #fecb00;
    padding: 0.8rem 1.35rem;
    font-size: 0.95rem;
    font-weight: 600;
    color: #005284;
    cursor: pointer;
    transition: background-color 150ms ease;
  }

  .coordity-cta:hover {
    background: #ffe066;
  }

  .coordity-menu[hidden] {
    display: none !important;
  }

  .coordity-menu:not([hidden]) {
    display: block;
    position: fixed;
    inset: 0;
    z-index: 50;
  }

  .coordity-menu__backdrop {
    position: absolute;
    inset: 0;
    background: rgb(0 82 132 / 0.28);
  }

  .coordity-menu__panel {
    position: absolute;
    top: 0;
    right: 0;
    height: 100%;
    width: min(20rem, 88vw);
    background: #fff;
    box-shadow: -12px 0 40px rgb(0 82 132 / 0.12);
    animation: coordity-menu-in 0.28s cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  .coordity-menu__link {
    display: block;
    border-radius: 0.75rem;
    padding: 0.85rem 1rem;
    font-size: 1rem;
    font-weight: 600;
    color: #005284;
    transition: background-color 150ms ease;
  }

  .coordity-menu__link:hover {
    background: rgb(0 82 132 / 0.06);
  }

  .coordity-fade-in {
    animation: coordity-fade 0.7s ease both;
  }

  .coordity-rise {
    animation: coordity-rise 0.85s cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  @keyframes coordity-fade {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @keyframes coordity-rise {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes coordity-menu-in {
    from {
      transform: translateX(12px);
      opacity: 0.6;
    }
    to {
      transform: translateX(0);
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .coordity-fade-in,
    .coordity-rise,
    .coordity-menu__panel {
      animation: none;
    }
  }
</style>
