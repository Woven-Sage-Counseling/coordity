---
import '../styles/global.css';
/**
 * Apex product landing for coordity.com — light marketing shell.
 * Workspace finder sits under the hero (replacing the old icon row).
 */
import CoordityMark from './CoordityMark.astro';
import { COORDITY_PRODUCT_NAME } from '../lib/organization';

interface Props {
  error?: string | null;
}

const { error = null } = Astro.props;
const year = new Date().getFullYear();

/**
 * Vertical curved rainbow from the right edge.
 * Arc centers sit at/ past the right of the viewBox so only the left bulge shows —
 * tall near-vertical bands, not a collapsed C tip.
 */
const heroArcs = [
  { d: 'M520 40 A460 460 0 0 0 520 960', width: 78, color: '#005284', opacity: 0.14 },
  { d: 'M520 110 A390 390 0 0 0 520 890', width: 74, color: '#FECB00', opacity: 0.28 },
  { d: 'M520 180 A320 320 0 0 0 520 820', width: 70, color: '#005284', opacity: 0.16 },
] as const;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="Coordity builds the infrastructure that helps behavioral health practices thrive."
    />
    <link rel="icon" href="/favicon-coordity.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-coordity.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon-coordity-16.png" type="image/png" sizes="16x16" />
    <title>{COORDITY_PRODUCT_NAME} — Connected systems. Brighter care.</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;1,9..40,400&family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="coordity-landing antialiased">
    <header class="relative z-30">
      <div class="mx-auto flex max-w-6xl items-center justify-between px-5 py-6 sm:px-8">
        <a href="/" class="coordity-fade-in">
          <CoordityMark variant="dark" class="text-[1.65rem]" />
        </a>
        <button
          type="button"
          class="coordity-fade-in inline-flex h-10 w-10 items-center justify-center rounded-full text-[#005284] transition hover:bg-[#005284]/8"
          style="animation-delay: 60ms"
          data-coordity-menu-open
          aria-expanded="false"
          aria-controls="coordity-menu"
          aria-label="Open menu"
        >
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" />
          </svg>
        </button>
      </div>
    </header>

    <div id="coordity-menu" class="coordity-menu" hidden data-coordity-menu>
      <div class="coordity-menu__backdrop" data-coordity-menu-close aria-hidden="true"></div>
      <nav class="coordity-menu__panel" aria-label="Primary">
        <div class="flex items-center justify-between px-5 py-5">
          <CoordityMark variant="dark" class="text-[1.35rem]" />
          <button
            type="button"
            class="inline-flex h-10 w-10 items-center justify-center rounded-full text-[#005284] hover:bg-[#005284]/8"
            data-coordity-menu-close
            aria-label="Close menu"
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" />
            </svg>
          </button>
        </div>
        <div class="flex flex-col gap-1 px-3 pb-8">
          <a href="#workspace" class="coordity-menu__link" data-coordity-menu-close>Log in to your workspace</a>
          <a href="/sign-up" class="coordity-menu__link">Create a workspace</a>
        </div>
      </nav>
    </div>

    <main>
      <section class="relative overflow-hidden">
        <div class="coordity-hero-arcs" aria-hidden="true">
          <svg viewBox="0 0 520 1000" class="coordity-hero-arcs__svg" preserveAspectRatio="xMaxYMid slice" focusable="false">
            {
              heroArcs.map((arc) => (
                <path
                  d={arc.d}
                  fill="none"
                  stroke={arc.color}
                  stroke-width={arc.width}
                  stroke-linecap="round"
                  opacity={arc.opacity}
                />
              ))
            }
          </svg>
        </div>

        <div class="relative z-10 mx-auto max-w-6xl px-5 pb-10 pt-10 sm:px-8 sm:pb-12 sm:pt-14 lg:pt-16">
          <div class="coordity-rise max-w-xl">
            <h1 class="font-[Fraunces] text-[2.75rem] font-semibold leading-[1.08] tracking-[-0.02em] text-[#005284] sm:text-5xl lg:text-[3.55rem]">
              Connected systems.<br />Brighter care.
            </h1>
            <p class="mt-5 max-w-md text-base leading-relaxed text-[#005284]/80 sm:text-lg">
              Coordity builds the infrastructure that helps behavioral health practices thrive.
            </p>
            <a href="#workspace" class="coordity-cta mt-8 inline-flex">
              Build What&rsquo;s Next
              <span aria-hidden="true">→</span>
            </a>
          </div>
        </div>
      </section>

      <section id="workspace" class="relative z-10 scroll-mt-24">
        <div class="mx-auto max-w-6xl px-5 pb-20 pt-2 sm:px-8 sm:pb-24">
          <div class="coordity-rise coordity-workspace-card max-w-lg" style="animation-delay: 120ms">
            <h2 class="font-[Fraunces] text-2xl font-semibold text-[#005284]">
              Log in to your workspace
            </h2>
            <p class="mt-2 text-sm leading-relaxed text-[#005284]/70">
              Enter your company name to open your organization&rsquo;s sign-in page.
            </p>

            {
              error && (
                <p class="mt-4 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800">
                  {error}
                </p>
              )
            }

            <form id="workspace-finder" class="mt-5 space-y-4" autocomplete="off">
              <label class="block text-sm font-medium text-[#005284]">
                Company name
                <input
                  class="field-coordity mt-1.5"
                  type="search"
                  name="q"
                  id="workspace-query"
                  placeholder="e.g. Woven Sage"
                  required
                  minlength="2"
                />
              </label>
              <button class="btn-coordity" type="submit">Continue</button>
              <p id="workspace-error" class="hidden text-sm text-[#005284]/70" role="alert"></p>
            </form>

            <ul
              id="workspace-results"
              class="mt-4 divide-y divide-[#005284]/10 overflow-hidden rounded-xl border border-[#005284]/12 bg-white"
              hidden
            ></ul>

            <p class="mt-5 text-center text-xs text-[#005284]/50">
              New here?
              <a href="/sign-up" class="font-semibold text-[#005284] underline-offset-2 hover:underline">
                Create a workspace
              </a>
            </p>
          </div>
        </div>
      </section>
    </main>

    <footer class="border-t border-[#005284]/10">
      <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-4 px-5 py-8 sm:px-8">
        <CoordityMark variant="dark" class="text-base" />
        <p class="text-xs text-[#005284]/45">© {year} {COORDITY_PRODUCT_NAME}</p>
      </div>
    </footer>

    <script is:inline>
      (function () {
        var menu = document.querySelector('[data-coordity-menu]');
        var openBtn = document.querySelector('[data-coordity-menu-open]');
        function setMenu(open) {
          if (!menu || !openBtn) return;
          menu.hidden = !open;
          openBtn.setAttribute('aria-expanded', open ? 'true' : 'false');
          document.body.style.overflow = open ? 'hidden' : '';
        }
        openBtn &&
          openBtn.addEventListener('click', function () {
            setMenu(true);
          });
        document.querySelectorAll('[data-coordity-menu-close]').forEach(function (el) {
          el.addEventListener('click', function () {
            setMenu(false);
          });
        });
        document.addEventListener('keydown', function (event) {
          if (event.key === 'Escape') setMenu(false);
        });

        var form = document.getElementById('workspace-finder');
        var input = document.getElementById('workspace-query');
        var results = document.getElementById('workspace-results');
        var errorEl = document.getElementById('workspace-error');
        if (!form || !input || !results || !errorEl) return;

        var debounceTimer = 0;

        function showError(message) {
          errorEl.textContent = message || '';
          errorEl.classList.toggle('hidden', !message);
        }

        function renderOrgs(organizations) {
          results.innerHTML = '';
          if (!organizations.length) {
            results.hidden = true;
            return;
          }
          results.hidden = false;
          organizations.forEach(function (org) {
            var li = document.createElement('li');
            var a = document.createElement('a');
            a.href = org.origin + '/sign-in';
            a.className =
              'flex items-center gap-3 px-4 py-3 text-sm text-[#005284] transition hover:bg-[#005284]/6';
            if (org.logoUrl) {
              var img = document.createElement('img');
              img.src = org.logoUrl;
              img.alt = '';
              img.className = 'h-7 w-auto rounded bg-white px-1 py-0.5 ring-1 ring-[#005284]/10';
              a.appendChild(img);
            }
            var text = document.createElement('span');
            text.className = 'font-medium';
            text.textContent = org.name;
            a.appendChild(text);
            var slug = document.createElement('span');
            slug.className = 'ml-auto text-xs text-[#005284]/45';
            slug.textContent = org.slug + '.coordity.com';
            a.appendChild(slug);
            li.appendChild(a);
            results.appendChild(li);
          });
        }

        function search(q) {
          showError('');
          if (q.length < 2) {
            renderOrgs([]);
            return;
          }
          fetch('/api/orgs/resolve?q=' + encodeURIComponent(q), {
            headers: { Accept: 'application/json' },
          })
            .then(function (res) {
              return res.json().then(function (json) {
                return { ok: res.ok, json: json };
              });
            })
            .then(function (result) {
              if (!result.ok) {
                showError(result.json.error || 'Could not find workspaces.');
                renderOrgs([]);
                return;
              }
              renderOrgs(result.json.organizations || []);
              if (!(result.json.organizations || []).length) {
                showError('No matching workspace. Try another company name.');
              }
            })
            .catch(function () {
              showError('Could not search workspaces.');
            });
        }

        input.addEventListener('input', function () {
          window.clearTimeout(debounceTimer);
          debounceTimer = window.setTimeout(function () {
            search(String(input.value || '').trim());
          }, 280);
        });

        form.addEventListener('submit', function (event) {
          event.preventDefault();
          var q = String(input.value || '').trim();
          if (q.length < 2) {
            showError('Enter at least 2 characters.');
            return;
          }
          fetch('/api/orgs/resolve?q=' + encodeURIComponent(q), {
            headers: { Accept: 'application/json' },
          })
            .then(function (res) {
              return res.json().then(function (json) {
                return { ok: res.ok, json: json };
              });
            })
            .then(function (result) {
              var orgs = (result.json && result.json.organizations) || [];
              if (result.ok && orgs.length === 1) {
                window.location.href = orgs[0].origin + '/sign-in';
                return;
              }
              renderOrgs(orgs);
              if (!orgs.length) {
                showError('No matching workspace. Try another company name.');
              } else {
                showError('Pick your workspace from the list.');
              }
            })
            .catch(function () {
              showError('Could not search workspaces.');
            });
        });
      })();
    </script>
  </body>
</html>

<style is:global>
  .coordity-landing {
    margin: 0;
    min-height: 100%;
    background: #ffffff;
    color: #005284;
    font-family: 'DM Sans', system-ui, sans-serif;
  }

  .coordity-hero-arcs {
    pointer-events: none;
    position: absolute;
    top: -20%;
    right: 0;
    bottom: -20%;
    z-index: 0;
    width: min(62vw, 22rem);
  }

  .coordity-hero-arcs__svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  @media (min-width: 768px) {
    .coordity-hero-arcs {
      width: min(52vw, 30rem);
      top: -28%;
      bottom: -28%;
    }
  }

  @media (min-width: 1024px) {
    .coordity-hero-arcs {
      width: min(46vw, 34rem);
      top: -32%;
      bottom: -32%;
    }
  }

  .coordity-cta {
    align-items: center;
    gap: 0.55rem;
    border-radius: 9999px;
    background: #fecb00;
    padding: 0.8rem 1.35rem;
    font-size: 0.95rem;
    font-weight: 600;
    color: #005284;
    transition: background-color 150ms ease;
  }

  .coordity-cta:hover {
    background: #ffe066;
  }

  .coordity-workspace-card {
    border: 1px solid rgb(0 82 132 / 0.12);
    border-radius: 1.25rem;
    background: #fff;
    padding: 1.5rem;
    box-shadow: 0 18px 40px rgb(0 82 132 / 0.06);
  }

  @media (min-width: 640px) {
    .coordity-workspace-card {
      padding: 1.75rem;
    }
  }

  .coordity-menu[hidden] {
    display: none !important;
  }

  .coordity-menu:not([hidden]) {
    display: block;
    position: fixed;
    inset: 0;
    z-index: 50;
  }

  .coordity-menu__backdrop {
    position: absolute;
    inset: 0;
    background: rgb(0 82 132 / 0.28);
  }

  .coordity-menu__panel {
    position: absolute;
    top: 0;
    right: 0;
    height: 100%;
    width: min(20rem, 88vw);
    background: #fff;
    box-shadow: -12px 0 40px rgb(0 82 132 / 0.12);
    animation: coordity-menu-in 0.28s cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  .coordity-menu__link {
    display: block;
    border-radius: 0.75rem;
    padding: 0.85rem 1rem;
    font-size: 1rem;
    font-weight: 600;
    color: #005284;
    transition: background-color 150ms ease;
  }

  .coordity-menu__link:hover {
    background: rgb(0 82 132 / 0.06);
  }

  .coordity-fade-in {
    animation: coordity-fade 0.7s ease both;
  }

  .coordity-rise {
    animation: coordity-rise 0.85s cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  @keyframes coordity-fade {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @keyframes coordity-rise {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes coordity-menu-in {
    from {
      transform: translateX(12px);
      opacity: 0.6;
    }
    to {
      transform: translateX(0);
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .coordity-fade-in,
    .coordity-rise,
    .coordity-menu__panel {
      animation: none;
    }
  }
</style>
