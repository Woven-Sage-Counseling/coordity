---
import type { PortalApp } from '../lib/apps';

interface Props {
  app: PortalApp;
}

const { app } = Astro.props;
const isIconApp = Boolean(app.iconSrc);
---

{
  isIconApp ? (
    <a
      href={app.href}
      class="group inline-flex w-[9rem] flex-col items-center text-center outline-none"
      target={app.external ? '_blank' : undefined}
      rel={app.external ? 'noopener noreferrer' : undefined}
    >
      <img
        src={app.iconSrc}
        alt=""
        width="102"
        height="102"
        class="h-[6.4rem] w-[6.4rem] rounded-[1.48rem] bg-white shadow-[0_10px_24px_rgba(26,28,30,0.18)] ring-1 ring-black/10 transition group-hover:-translate-y-0.5 group-hover:shadow-[0_14px_28px_rgba(26,28,30,0.22)] group-focus-visible:ring-2 group-focus-visible:ring-sage-dark"
      />
      <span class="mt-1.5 text-sm font-medium leading-tight text-charcoal">{app.name}</span>
    </a>
  ) : (
    <a
      href={app.href}
      class="app-tile"
      target={app.external ? '_blank' : undefined}
      rel={app.external ? 'noopener noreferrer' : undefined}
    >
      <p class="text-xs uppercase tracking-[0.16em] text-sage-dark/55">{app.category}</p>
      <h3 class="mt-2 font-display text-2xl text-charcoal">{app.name}</h3>
      <p class="mt-2 flex-1 text-sm leading-relaxed text-sage-dark/75">{app.description}</p>
      <span class="mt-4 text-sm font-medium text-sage-dark">
        {app.external ? 'Open application ↗' : 'Open'}
      </span>
    </a>
  )
}
