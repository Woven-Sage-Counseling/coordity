---
import type { PortalApp } from '../lib/apps';

interface Props {
  app: PortalApp;
}

const { app } = Astro.props;
---

<a
  href={app.href}
  class="app-tile"
  target={app.external ? '_blank' : undefined}
  rel={app.external ? 'noopener noreferrer' : undefined}
>
  {app.iconSrc ? (
    <img
      src={app.iconSrc}
      alt=""
      width="56"
      height="56"
      class="h-14 w-14 rounded-[0.9rem] shadow-sm ring-1 ring-black/10"
    />
  ) : null}
  <p class:list={['text-xs uppercase tracking-[0.16em] text-sage-dark/55', app.iconSrc ? 'mt-3' : null]}>
    {app.category}
  </p>
  <h3 class="mt-2 font-display text-2xl text-charcoal">{app.name}</h3>
  <p class="mt-2 flex-1 text-sm leading-relaxed text-sage-dark/75">{app.description}</p>
  <span class="mt-4 text-sm font-medium text-sage-dark">
    {app.external ? 'Open application ↗' : 'Open'}
  </span>
</a>
