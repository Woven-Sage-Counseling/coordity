---
import type { CoverageStatus, CredentialingProvider, InsuranceGroup } from '../lib/credentialing';
import { coverageStatusLabel } from '../lib/credentialing';

interface Props {
  providers: CredentialingProvider[];
  catalog: InsuranceGroup[];
  coverageByProvider: Record<
    string,
    Array<{
      planId: string;
      planName: string;
      groupName: string;
      status: CoverageStatus;
    }>
  >;
  linkableUsers: Array<{ id: string; name: string; email: string }>;
  error?: string | null;
  saved?: boolean;
  embedded?: boolean;
}

const {
  providers,
  catalog,
  coverageByProvider,
  linkableUsers,
  error = null,
  saved = false,
  embedded = false,
} = Astro.props;
---

<section
  class:list={[!embedded && 'mt-10', 'scroll-mt-24']}
  aria-labelledby="credentialing-admin"
  id="credentialing-admin"
>
  {
    !embedded ? (
      <div>
        <h2 id="credentialing-admin" class="font-display text-3xl text-charcoal">Credentialing</h2>
        <p class="mt-2 text-sm text-sage-dark/65">
          Manage providers, insurance groups, plans, and coverage status.
        </p>
      </div>
    ) : (
      <h2 id="credentialing-admin" class="sr-only">Credentialing</h2>
    )
  }

  {
    error ? (
      <p class="mt-4 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800">{error}</p>
    ) : null
  }

  <div class="mt-6 space-y-8">
    <div class="rounded-2xl border border-sage-dark/10 bg-white/80 p-5 shadow-sm">
      <h3 class="text-sm font-semibold text-charcoal">Add provider</h3>
      <p class="mt-1 text-sm text-sage-dark/65">
        Directory clinicians (Clinical team or Clinician role) appear automatically. Use this only for
        providers who are not in the directory yet.
      </p>
      <form class="mt-3 grid gap-3 sm:grid-cols-[1fr_1fr_auto] sm:items-end" method="post" action="/api/credentialing/provider/create">
        <label class="block text-sm font-medium text-charcoal">
          Display name
          <input class="field mt-1" type="text" name="name" required maxlength="120" placeholder="Michele L. Evans" />
        </label>
        <label class="block text-sm font-medium text-charcoal">
          Link portal user <span class="font-normal text-sage-dark/55">(optional)</span>
          <select class="field mt-1" name="userId">
            <option value="">None</option>
            {linkableUsers.map((user) => (
              <option value={user.id}>
                {user.name} ({user.email})
              </option>
            ))}
          </select>
        </label>
        <button class="btn-primary" type="submit">Add provider</button>
      </form>
    </div>

    <div class="rounded-2xl border border-sage-dark/10 bg-white/80 p-5 shadow-sm">
      <h3 class="text-sm font-semibold text-charcoal">Add insurance group</h3>
      <form class="mt-3 flex flex-wrap items-end gap-3" method="post" action="/api/credentialing/group/create">
        <label class="block min-w-[14rem] flex-1 text-sm font-medium text-charcoal">
          Group name
          <input class="field mt-1" type="text" name="name" required maxlength="120" placeholder="Aetna" />
        </label>
        <button class="btn-primary" type="submit">Add group</button>
      </form>
    </div>

    <div class="rounded-2xl border border-sage-dark/10 bg-white/80 p-5 shadow-sm">
      <h3 class="text-sm font-semibold text-charcoal">Add plan to a group</h3>
      {
        catalog.length === 0 ? (
          <p class="mt-3 text-sm text-sage-dark/65">Add an insurance group first.</p>
        ) : (
          <form class="mt-3 grid gap-3 sm:grid-cols-[1fr_1fr_auto] sm:items-end" method="post" action="/api/credentialing/plan/create">
            <label class="block text-sm font-medium text-charcoal">
              Group
              <select class="field mt-1" name="groupId" required>
                {catalog.map((group) => (
                  <option value={group.id}>{group.name}</option>
                ))}
              </select>
            </label>
            <label class="block text-sm font-medium text-charcoal">
              Plan name
              <input class="field mt-1" type="text" name="name" required maxlength="160" placeholder="Aetna Choice POS II" />
            </label>
            <button class="btn-primary" type="submit">Add plan</button>
          </form>
        )
      }
    </div>

    <div class="rounded-2xl border border-sage-dark/10 bg-white/80 p-5 shadow-sm">
      <h3 class="text-sm font-semibold text-charcoal">Set provider coverage</h3>
      {
        providers.length === 0 || catalog.every((g) => g.plans.length === 0) ? (
          <p class="mt-3 text-sm text-sage-dark/65">Add a provider and at least one plan first.</p>
        ) : (
          <form class="mt-3 grid gap-3 sm:grid-cols-2" method="post" action="/api/credentialing/coverage/set">
            <label class="block text-sm font-medium text-charcoal">
              Provider
              <select class="field mt-1" name="providerId" required>
                {providers.map((provider) => (
                  <option value={provider.id}>{provider.name}</option>
                ))}
              </select>
            </label>
            <label class="block text-sm font-medium text-charcoal">
              Plan
              <select class="field mt-1" name="planId" required>
                {catalog.map((group) =>
                  group.plans.map((plan) => (
                    <option value={plan.id}>
                      {group.name} — {plan.name}
                    </option>
                  )),
                )}
              </select>
            </label>
            <label class="block text-sm font-medium text-charcoal sm:col-span-2">
              Status
              <select class="field mt-1" name="status" required>
                <option value="accepted">Accepted</option>
                <option value="credentialing">Credentialing in progress</option>
                <option value="none">Remove coverage</option>
              </select>
            </label>
            <div class="flex flex-wrap items-center gap-3 sm:col-span-2">
              <button class="btn-primary" type="submit">Save coverage</button>
              {
                saved ? (
                  <span
                    class="text-sm font-medium text-sage-dark/45 transition-opacity duration-300"
                    data-save-flash
                    aria-live="polite"
                  >
                    Saved.
                  </span>
                ) : null
              }
            </div>
          </form>
        )
      }
    </div>

    <div>
      <h3 class="text-sm font-semibold text-charcoal">Current catalog</h3>
      {
        catalog.length === 0 ? (
          <p class="mt-3 text-sm text-sage-dark/65">No insurance groups yet.</p>
        ) : (
          <ul class="mt-3 space-y-4">
            {catalog.map((group) => (
              <li class="rounded-2xl border border-sage-dark/10 bg-white/80 p-4 shadow-sm">
                <div class="flex flex-wrap items-start justify-between gap-3">
                  <p class="font-semibold text-charcoal">{group.name}</p>
                  <form method="post" action="/api/credentialing/group/delete">
                    <input type="hidden" name="groupId" value={group.id} />
                    <button
                      class="text-xs font-semibold text-red-700 hover:text-red-800"
                      type="submit"
                      data-confirm="Delete this group and all of its plans?"
                    >
                      Delete group
                    </button>
                  </form>
                </div>
                <ul class="mt-3 space-y-2">
                  {group.plans.length === 0 ? (
                    <li class="text-sm text-sage-dark/60">No plans in this group.</li>
                  ) : (
                    group.plans.map((plan) => (
                      <li class="flex items-center justify-between gap-3 rounded-xl bg-[#fafbf9] px-3 py-2 text-sm">
                        <span class="text-charcoal">{plan.name}</span>
                        <form method="post" action="/api/credentialing/plan/delete">
                          <input type="hidden" name="planId" value={plan.id} />
                          <button
                            class="text-xs font-semibold text-red-700 hover:text-red-800"
                            type="submit"
                            data-confirm="Delete this plan?"
                          >
                            Delete
                          </button>
                        </form>
                      </li>
                    ))
                  )}
                </ul>
              </li>
            ))}
          </ul>
        )
      }
    </div>

    <div>
      <h3 class="text-sm font-semibold text-charcoal">Providers and coverage</h3>
      {
        providers.length === 0 ? (
          <p class="mt-3 text-sm text-sage-dark/65">No providers yet.</p>
        ) : (
          <ul class="mt-3 space-y-4">
            {providers.map((provider) => {
              const rows = coverageByProvider[provider.id] ?? [];
              return (
                <li class="rounded-2xl border border-sage-dark/10 bg-white/80 p-4 shadow-sm">
                  <div class="flex flex-wrap items-start justify-between gap-3">
                    <div>
                      <p class="font-semibold text-charcoal">{provider.name}</p>
                      <p class="mt-0.5 text-xs text-sage-dark/55">
                        {provider.fromDirectory
                          ? 'From directory (Clinical / Clinician)'
                          : provider.userId
                            ? 'Linked to a portal user'
                            : 'Manual provider (not in directory)'}
                      </p>
                    </div>
                    {
                      !provider.fromDirectory ? (
                        <form method="post" action="/api/credentialing/provider/delete">
                          <input type="hidden" name="providerId" value={provider.id} />
                          <button
                            class="text-xs font-semibold text-red-700 hover:text-red-800"
                            type="submit"
                            data-confirm="Delete this provider and their coverage rows?"
                          >
                            Delete provider
                          </button>
                        </form>
                      ) : (
                        <p class="text-xs text-sage-dark/45">Managed via Directory</p>
                      )
                    }
                  </div>
                  <ul class="mt-3 space-y-2">
                    {rows.length === 0 ? (
                      <li class="text-sm text-sage-dark/60">No coverage set.</li>
                    ) : (
                      rows.map((row) => (
                        <li class="flex items-center justify-between gap-3 rounded-xl bg-[#fafbf9] px-3 py-2 text-sm">
                          <span class="text-charcoal">
                            {row.groupName} — {row.planName}
                          </span>
                          <span
                            class:list={[
                              'rounded-full px-2 py-0.5 text-[11px] font-semibold uppercase tracking-wide',
                              row.status === 'accepted'
                                ? 'bg-emerald-100 text-emerald-900'
                                : 'bg-amber-100 text-amber-900',
                            ]}
                          >
                            {coverageStatusLabel(row.status)}
                          </span>
                        </li>
                      ))
                    )}
                  </ul>
                </li>
              );
            })}
          </ul>
        )
      }
    </div>
  </div>
</section>

<script>
  document.querySelectorAll('#credentialing-admin button[data-confirm]').forEach((button) => {
    button.addEventListener('click', (event) => {
      if (!(button instanceof HTMLButtonElement)) return;
      const message = button.getAttribute('data-confirm');
      if (!message) return;
      if (!window.confirm(message)) event.preventDefault();
    });
  });
</script>
