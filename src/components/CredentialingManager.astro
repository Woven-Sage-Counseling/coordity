---
import CredentialingCoverageMatrix from './CredentialingCoverageMatrix.astro';
import type { CoverageStatus, CredentialingProvider, InsuranceGroup } from '../lib/credentialing';

interface Props {
  providers: CredentialingProvider[];
  catalog: InsuranceGroup[];
  coverageMap: Record<string, CoverageStatus>;
  groupCoverageMap: Record<string, CoverageStatus>;
  error?: string | null;
  embedded?: boolean;
}

const { providers, catalog, coverageMap, groupCoverageMap, error = null, embedded = false } = Astro.props;
const hasProviders = providers.length > 0;
const hasNetworks = catalog.length > 0;
---

<section
  class:list={[!embedded && 'mt-10', 'scroll-mt-24']}
  aria-labelledby="credentialing-admin"
  id="credentialing-admin"
>
  {
    !embedded ? (
      <div>
        <h2 id="credentialing-admin" class="font-display text-3xl text-charcoal">Credentialing</h2>
        <p class="mt-2 text-sm text-sage-dark/65">
          Manage insurance groups, plans, and coverage for directory clinicians.
        </p>
      </div>
    ) : (
      <h2 id="credentialing-admin" class="sr-only">Credentialing</h2>
    )
  }

  {
    error ? (
      <p class="mt-4 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800">{error}</p>
    ) : null
  }

  <div
    class="mt-6 space-y-8"
    data-credentialing-coverage-root
    data-providers={JSON.stringify(providers.map((provider) => ({ id: provider.id, name: provider.name })))}
    data-catalog={JSON.stringify(catalog)}
    data-coverage={JSON.stringify(coverageMap)}
    data-group-coverage={JSON.stringify(groupCoverageMap)}
  >
    <div class="rounded-2xl border border-sage-dark/10 bg-white/90 p-4 shadow-sm" data-provider-networks>
      <h3 class="text-sm font-semibold text-charcoal">Provider networks</h3>
      {
        !hasProviders ? (
          <p class="mt-2 text-sm text-sage-dark/65">
            Directory clinicians appear here automatically. Add clinicians to the directory before assigning
            insurance networks.
          </p>
        ) : !hasNetworks ? (
          <p class="mt-2 text-sm text-sage-dark/65">
            Add insurance companies in the catalog below, then choose which networks each provider works with.
          </p>
        ) : (
          <>
            <p class="mt-1 text-sm text-sage-dark/65">
              Select a provider, then check each insurance network they participate in. Plans in the catalog
              below are optional and used for internal plan-level detail.
            </p>
            <div class="mt-4 flex flex-col gap-3 sm:flex-row sm:items-end">
              <label class="block min-w-[10rem] flex-1 text-sm font-medium text-charcoal">
                Provider
                <select class="field mt-1" data-network-provider>
                  {providers.map((provider) => (
                    <option value={provider.id}>{provider.name}</option>
                  ))}
                </select>
              </label>
              <label class="block min-w-[12rem] flex-1 text-sm font-medium text-charcoal">
                Search networks
                <input
                  class="field mt-1"
                  type="search"
                  placeholder="Insurance company…"
                  data-network-search
                />
              </label>
            </div>
            <p class="mt-2 hidden text-xs text-sage-dark/55" data-network-feedback aria-live="polite"></p>
            <ul class="mt-4 divide-y divide-sage-dark/10 overflow-hidden rounded-xl border border-sage-dark/10" data-network-list>
              {
                catalog.map((group) => (
                  <li
                    class="flex flex-wrap items-center gap-3 bg-white px-4 py-3"
                    data-network-row
                    data-group-id={group.id}
                    data-search-text={group.name.toLowerCase()}
                  >
                    <input
                      type="checkbox"
                      class="h-4 w-4 shrink-0 rounded border-sage-dark/25 text-sage-dark focus:ring-sage/40"
                      id={`network-${group.id}`}
                      data-network-checkbox
                    />
                    <label
                      class="min-w-0 flex-1 text-sm font-medium text-charcoal"
                      for={`network-${group.id}`}
                    >
                      {group.name}
                    </label>
                    <select
                      class="field max-w-[11rem] shrink-0 py-1.5 text-xs"
                      data-network-status
                      hidden
                      aria-label={`Status for ${group.name}`}
                    >
                      <option value="in_network">In network</option>
                      <option value="credentialing">Credentialing</option>
                    </select>
                  </li>
                ))
              }
            </ul>
          </>
        )
      }
    </div>

    <CredentialingCoverageMatrix providers={providers} catalog={catalog} coverageMap={coverageMap} />

    <div data-insurance-catalog>
      <h3 class="text-sm font-semibold text-charcoal">Insurance catalog</h3>

      {
        catalog.length === 0 ? (
          <p class="mt-3 text-sm text-sage-dark/65">No insurance companies yet.</p>
        ) : (
          <div class="mt-3 overflow-hidden rounded-2xl border border-sage-dark/10 bg-white/90 shadow-sm">
            {
              catalog.map((group) => (
                <details class="group/cat border-b border-sage-dark/10 last:border-b-0" open data-catalog-group={group.id}>
                  <summary class="flex cursor-pointer list-none items-center gap-2 px-4 py-3 hover:bg-sage/5 [&::-webkit-details-marker]:hidden">
                    <svg
                      class="h-3.5 w-3.5 shrink-0 text-sage-dark/45 transition group-open/cat:rotate-90"
                      viewBox="0 0 16 16"
                      fill="none"
                      aria-hidden="true"
                    >
                      <path
                        d="M6 3l5 5-5 5"
                        stroke="currentColor"
                        stroke-width="1.75"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      />
                    </svg>
                    <span class="min-w-0 flex-1 truncate text-[15px] font-medium text-charcoal" data-group-name>
                      {group.name}
                    </span>
                    <div class="flex shrink-0 items-center gap-3">
                      <button
                        type="button"
                        class="text-xs font-semibold text-sage-dark/70 transition hover:text-sage-dark"
                        data-catalog-add-plan={group.id}
                      >
                        + Add plan
                      </button>
                      <form method="post" action="/api/credentialing/group/delete" class="inline">
                        <input type="hidden" name="groupId" value={group.id} />
                        <button
                          type="submit"
                          class="text-xs font-semibold text-red-700/80 transition hover:text-red-800"
                          data-confirm="Delete this company and all of its plans?"
                        >
                          Delete
                        </button>
                      </form>
                    </div>
                  </summary>

                  <div class="pb-2">
                    {
                      group.plans.length === 0 ? (
                        <p class="px-4 py-2 pl-10 text-sm text-sage-dark/55">No plans yet.</p>
                      ) : (
                        <ul>
                          {
                            group.plans.map((plan) => (
                              <li
                                class="flex items-center gap-3 py-2 pl-10 pr-4 text-sm"
                                data-plan-row={plan.id}
                              >
                                <span class="min-w-0 flex-1 truncate text-charcoal" data-plan-name>
                                  {plan.name}
                                </span>
                                <form
                                  class="hidden min-w-0 flex-1 items-center gap-2"
                                  method="post"
                                  action="/api/credentialing/plan/update"
                                  data-plan-edit-form
                                >
                                  <input type="hidden" name="planId" value={plan.id} />
                                  <input
                                    class="field min-w-0 flex-1 py-1.5 text-sm"
                                    type="text"
                                    name="name"
                                    value={plan.name}
                                    required
                                    maxlength="160"
                                    data-plan-edit-input
                                  />
                                  <button class="btn-primary px-3 py-1.5 text-xs" type="submit">Save</button>
                                  <button
                                    class="text-xs font-semibold text-sage-dark/65 hover:text-sage-dark"
                                    type="button"
                                    data-plan-cancel-edit
                                  >
                                    Cancel
                                  </button>
                                </form>
                                <div class="flex shrink-0 items-center gap-2 text-xs font-semibold" data-plan-actions>
                                  <button
                                    type="button"
                                    class="text-sage-dark/70 transition hover:text-sage-dark"
                                    data-plan-edit
                                  >
                                    Edit
                                  </button>
                                  <span class="text-sage-dark/30" aria-hidden="true">·</span>
                                  <form method="post" action="/api/credentialing/plan/delete" class="inline">
                                    <input type="hidden" name="planId" value={plan.id} />
                                    <button
                                      type="submit"
                                      class="text-red-700/80 transition hover:text-red-800"
                                      data-confirm="Delete this plan?"
                                    >
                                      Delete
                                    </button>
                                  </form>
                                </div>
                              </li>
                            ))
                          }
                        </ul>
                      )
                    }

                    <div class="hidden px-4 py-2 pl-10" data-add-plan-panel={group.id}>
                      <form
                        class="flex flex-wrap items-center gap-2"
                        method="post"
                        action="/api/credentialing/plan/create"
                        data-add-plan-form
                      >
                        <input type="hidden" name="groupId" value={group.id} />
                        <input
                          class="field min-w-[12rem] flex-1 py-1.5 text-sm"
                          type="text"
                          name="name"
                          required
                          maxlength="160"
                          placeholder="Plan name"
                          data-add-plan-input
                        />
                        <button class="btn-primary px-3 py-1.5 text-xs" type="submit">Add</button>
                        <button
                          class="text-xs font-semibold text-sage-dark/65 hover:text-sage-dark"
                          type="button"
                          data-add-plan-cancel
                        >
                          Cancel
                        </button>
                      </form>
                    </div>
                  </div>
                </details>
              ))
            }
          </div>
        )
      }

      <div class="mt-3">
        <button
          type="button"
          class="text-sm font-semibold text-sage-dark/75 transition hover:text-sage-dark"
          data-catalog-add-company
        >
          + Add insurance company
        </button>
        <div class="mt-2 hidden rounded-xl border border-sage-dark/10 bg-white/90 px-4 py-3 shadow-sm" data-add-company-panel>
          <form
            class="flex flex-wrap items-center gap-2"
            method="post"
            action="/api/credentialing/group/create"
            data-add-company-form
          >
            <input
              class="field min-w-[12rem] flex-1 py-1.5 text-sm"
              type="text"
              name="name"
              required
              maxlength="120"
              placeholder="Insurance company name"
              data-add-company-input
            />
            <button class="btn-primary px-3 py-1.5 text-xs" type="submit">Add</button>
            <button
              class="text-xs font-semibold text-sage-dark/65 hover:text-sage-dark"
              type="button"
              data-add-company-cancel
            >
              Cancel
            </button>
          </form>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  type PlanRow = { id: string; groupId: string; name: string; sortOrder: number };
  type GroupRow = { id: string; name: string; sortOrder: number; plans: PlanRow[] };
  type CoverageStatusKey = string;
  type NetworkStatus = 'not_started' | 'in_network' | 'credentialing' | 'mixed';

  function cellKey(providerId: string, planId: string): string {
    return `${providerId}:${planId}`;
  }

  function groupKey(providerId: string, groupId: string): string {
    return `${providerId}:${groupId}`;
  }

  function setupProviderNetworks(root: HTMLElement) {
    const catalog = JSON.parse(root.dataset.catalog ?? '[]') as GroupRow[];
    const coverage = JSON.parse(root.dataset.coverage ?? '{}') as Record<string, CoverageStatusKey>;
    const groupCoverage = JSON.parse(root.dataset.groupCoverage ?? '{}') as Record<
      string,
      CoverageStatusKey
    >;

    const panel = root.querySelector('[data-provider-networks]');
    const providerSelect = panel?.querySelector('[data-network-provider]') as HTMLSelectElement | null;
    const searchInput = panel?.querySelector('[data-network-search]') as HTMLInputElement | null;
    const feedback = panel?.querySelector('[data-network-feedback]') as HTMLElement | null;
    const networkList = panel?.querySelector('[data-network-list]');

    if (!panel || !providerSelect || !networkList) return;
    const providerField = providerSelect;
    const networks = networkList;

    function getProviderId(): string {
      return providerField.value;
    }

    function getGroupStatus(providerId: string, group: GroupRow): NetworkStatus {
      const direct = groupCoverage[groupKey(providerId, group.id)];
      if (direct === 'in_network' || direct === 'credentialing') return direct;

      if (group.plans.length === 0) return 'not_started';

      const statuses = group.plans.map((plan) => coverage[cellKey(providerId, plan.id)] ?? 'not_started');
      const active = statuses.filter((status) => status !== 'not_started');
      if (active.length === 0) return 'not_started';

      const unique = new Set(active);
      if (unique.size === 1) {
        const [status] = [...unique];
        if (status === 'in_network' || status === 'credentialing') return status;
      }

      if (active.some((status) => status === 'in_network')) return 'in_network';
      if (active.some((status) => status === 'credentialing')) return 'credentialing';
      return 'mixed';
    }

    function setFeedback(message: string, tone: 'neutral' | 'error' = 'neutral') {
      if (!feedback) return;
      feedback.textContent = message;
      feedback.hidden = !message;
      feedback.classList.toggle('text-red-700', tone === 'error');
      feedback.classList.toggle('text-sage-dark/55', tone !== 'error');
    }

    function notifyCoverageChange(detail: Record<string, unknown>) {
      window.dispatchEvent(new CustomEvent('credentialing:coverage-changed', { detail }));
    }

    function syncNetworkRows() {
      const providerId = getProviderId();
      const query = searchInput?.value.trim().toLowerCase() ?? '';

      networks.querySelectorAll('[data-network-row]').forEach((row) => {
        if (!(row instanceof HTMLElement)) return;

        const searchText = row.dataset.searchText ?? '';
        row.classList.toggle('hidden', Boolean(query) && !searchText.includes(query));

        const checkbox = row.querySelector('[data-network-checkbox]');
        const statusSelect = row.querySelector('[data-network-status]');
        if (!(checkbox instanceof HTMLInputElement) || !(statusSelect instanceof HTMLSelectElement)) return;

        const groupId = row.dataset.groupId ?? '';
        const group = catalog.find((entry) => entry.id === groupId);
        if (!group) return;

        const groupStatus = getGroupStatus(providerId, group);
        const participating =
          groupStatus === 'in_network' || groupStatus === 'credentialing' || groupStatus === 'mixed';

        checkbox.checked = participating;
        statusSelect.hidden = !participating;
        statusSelect.value =
          groupStatus === 'credentialing' ? 'credentialing' : 'in_network';
      });
    }

    async function saveGroupStatus(groupId: string, status: CoverageStatusKey) {
      const providerId = getProviderId();
      const group = catalog.find((entry) => entry.id === groupId);
      if (!group) return;

      const row = networks.querySelector(`[data-network-row][data-group-id="${groupId}"]`);
      const controls = row?.querySelectorAll('input, select');
      controls?.forEach((control) => {
        if (control instanceof HTMLInputElement || control instanceof HTMLSelectElement) {
          control.disabled = true;
        }
      });
      setFeedback('Saving…');

      try {
        const response = await fetch('/api/credentialing/coverage/bulk', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          credentials: 'same-origin',
          body: JSON.stringify({ providerId, groupId, status }),
        });
        const payload = (await response.json()) as {
          ok?: boolean;
          error?: string;
        };

        if (!response.ok || !payload.ok) {
          throw new Error(payload.error || 'Could not save coverage.');
        }

        const groupCoverageKey = groupKey(providerId, groupId);
        if (status === 'not_started') delete groupCoverage[groupCoverageKey];
        else groupCoverage[groupCoverageKey] = status;

        for (const plan of group.plans) {
          const key = cellKey(providerId, plan.id);
          if (status === 'not_started') delete coverage[key];
          else coverage[key] = status;
        }

        notifyCoverageChange({ providerId, groupId, status, bulk: true });
        setFeedback('Saved.');
        window.setTimeout(() => setFeedback(''), 1500);
      } catch (error) {
        syncNetworkRows();
        setFeedback(error instanceof Error ? error.message : 'Could not save coverage.', 'error');
      } finally {
        controls?.forEach((control) => {
          if (control instanceof HTMLInputElement || control instanceof HTMLSelectElement) {
            control.disabled = false;
          }
        });
        syncNetworkRows();
      }
    }

    window.addEventListener('credentialing:coverage-changed', (event) => {
      const detail = (event as CustomEvent<{
        providerId?: string;
        planId?: string;
        groupId?: string;
        status?: CoverageStatusKey;
        bulk?: boolean;
      }>).detail;
      if (!detail?.providerId || detail.providerId !== getProviderId()) return;

      if (detail.bulk && detail.groupId) {
        const group = catalog.find((entry) => entry.id === detail.groupId);
        const key = groupKey(detail.providerId, detail.groupId);
        if (detail.status === 'not_started') delete groupCoverage[key];
        else if (detail.status) groupCoverage[key] = detail.status;

        for (const plan of group?.plans ?? []) {
          const planKey = cellKey(detail.providerId, plan.id);
          if (detail.status === 'not_started') delete coverage[planKey];
          else if (detail.status) coverage[planKey] = detail.status;
        }
      } else if (detail.planId) {
        const key = cellKey(detail.providerId, detail.planId);
        if (detail.status === 'not_started') delete coverage[key];
        else if (detail.status) coverage[key] = detail.status;
      }

      syncNetworkRows();
    });

    providerField.addEventListener('change', () => {
      syncNetworkRows();
      window.dispatchEvent(
        new CustomEvent('credentialing:provider-selected', {
          detail: { providerId: getProviderId() },
        }),
      );
    });

    searchInput?.addEventListener('input', syncNetworkRows);

    networks.addEventListener('change', (event) => {
      const target = event.target;
      if (!(target instanceof HTMLElement)) return;

      const row = target.closest('[data-network-row]');
      if (!(row instanceof HTMLElement)) return;
      const groupId = row.dataset.groupId ?? '';
      if (!groupId) return;

      if (target.matches('[data-network-checkbox]') && target instanceof HTMLInputElement) {
        const statusSelect = row.querySelector('[data-network-status]');
        if (!(statusSelect instanceof HTMLSelectElement)) return;

        if (target.checked) {
          statusSelect.hidden = false;
          const status = statusSelect.value === 'credentialing' ? 'credentialing' : 'in_network';
          void saveGroupStatus(groupId, status);
          return;
        }

        statusSelect.hidden = true;
        void saveGroupStatus(groupId, 'not_started');
        return;
      }

      if (target.matches('[data-network-status]') && target instanceof HTMLSelectElement) {
        const checkbox = row.querySelector('[data-network-checkbox]');
        if (!(checkbox instanceof HTMLInputElement) || !checkbox.checked) return;
        void saveGroupStatus(groupId, target.value);
      }
    });

    syncNetworkRows();
    window.dispatchEvent(
      new CustomEvent('credentialing:provider-selected', {
        detail: { providerId: getProviderId() },
      }),
    );
  }

  function setupInsuranceCatalog(root: Element) {
    const addCompanyButton = root.querySelector('[data-catalog-add-company]');
    const addCompanyPanel = root.querySelector('[data-add-company-panel]');
    const addCompanyInput = root.querySelector('[data-add-company-input]');

    const closeAddCompany = () => {
      addCompanyPanel?.classList.add('hidden');
      addCompanyButton?.classList.remove('hidden');
    };

    addCompanyButton?.addEventListener('click', () => {
      addCompanyButton.classList.add('hidden');
      addCompanyPanel?.classList.remove('hidden');
      if (addCompanyInput instanceof HTMLInputElement) {
        addCompanyInput.value = '';
        addCompanyInput.focus();
      }
    });

    root.querySelector('[data-add-company-cancel]')?.addEventListener('click', closeAddCompany);

    const closeAddPlanPanels = () => {
      root.querySelectorAll('[data-add-plan-panel]').forEach((panel) => panel.classList.add('hidden'));
    };

    root.querySelectorAll('[data-catalog-add-plan]').forEach((button) => {
      button.addEventListener('click', (event) => {
        event.preventDefault();
        event.stopPropagation();
        if (!(button instanceof HTMLButtonElement)) return;
        const groupId = button.dataset.catalogAddPlan;
        if (!groupId) return;

        closeAddPlanPanels();
        const panel = root.querySelector(`[data-add-plan-panel="${groupId}"]`);
        panel?.classList.remove('hidden');
        const input = panel?.querySelector('[data-add-plan-input]');
        if (input instanceof HTMLInputElement) {
          input.value = '';
          input.focus();
        }

        const details = button.closest('details');
        if (details instanceof HTMLDetailsElement) details.open = true;
      });
    });

    root.querySelectorAll('[data-add-plan-cancel]').forEach((button) => {
      button.addEventListener('click', () => {
        button.closest('[data-add-plan-panel]')?.classList.add('hidden');
      });
    });

    root.querySelectorAll('[data-plan-edit]').forEach((button) => {
      button.addEventListener('click', () => {
        const row = button.closest('[data-plan-row]');
        if (!row) return;

        row.querySelector('[data-plan-name]')?.classList.add('hidden');
        row.querySelector('[data-plan-actions]')?.classList.add('hidden');
        const form = row.querySelector('[data-plan-edit-form]');
        form?.classList.remove('hidden');
        form?.classList.add('flex');
        const input = row.querySelector('[data-plan-edit-input]');
        if (input instanceof HTMLInputElement) {
          input.focus();
          input.select();
        }
      });
    });

    root.querySelectorAll('[data-plan-cancel-edit]').forEach((button) => {
      button.addEventListener('click', () => {
        const row = button.closest('[data-plan-row]');
        if (!row) return;

        row.querySelector('[data-plan-name]')?.classList.remove('hidden');
        row.querySelector('[data-plan-actions]')?.classList.remove('hidden');
        const form = row.querySelector('[data-plan-edit-form]');
        form?.classList.add('hidden');
        form?.classList.remove('flex');
      });
    });

    root.querySelectorAll('summary button, summary form button').forEach((button) => {
      button.addEventListener('click', (event) => event.stopPropagation());
    });
  }

  document.querySelectorAll('#credentialing-admin [data-credentialing-coverage-root]').forEach((root) => {
    if (root instanceof HTMLElement) setupProviderNetworks(root);
  });

  document.querySelectorAll('#credentialing-admin [data-insurance-catalog]').forEach((root) => {
    setupInsuranceCatalog(root);
  });

  document.querySelectorAll('#credentialing-admin button[data-confirm]').forEach((button) => {
    button.addEventListener('click', (event) => {
      if (!(button instanceof HTMLButtonElement)) return;
      const message = button.getAttribute('data-confirm');
      if (!message) return;
      if (!window.confirm(message)) event.preventDefault();
    });
  });
</script>
