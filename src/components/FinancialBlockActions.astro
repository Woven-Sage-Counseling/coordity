---
import type { ResolvedPeriod } from '../lib/financials/periods';

interface Props {
  blockRef: string;
  index: number;
  total: number;
  period: ResolvedPeriod;
  removeIntent?: 'remove-card' | 'remove-income';
  cardKey?: string;
  blockId?: string;
}

const { blockRef, index, total, period, removeIntent, cardKey, blockId } = Astro.props;
const buttonClass = 'rounded-md px-2 py-1 text-sm text-sage-dark/70 hover:bg-[#f4f5f8] hover:text-charcoal disabled:cursor-default disabled:opacity-40 disabled:hover:bg-transparent';
---

<div class="flex shrink-0 items-center gap-1">
  {
    (['up', 'down'] as const).map((direction) => (
      <form method="post" action="/api/financials/cards">
        <input type="hidden" name="intent" value="move-block" />
        <input type="hidden" name="blockRef" value={blockRef} />
        <input type="hidden" name="direction" value={direction} />
        <input type="hidden" name="period" value={period.id} />
        <input type="hidden" name="start" value={period.start} />
        <input type="hidden" name="end" value={period.end} />
        <button class={buttonClass} type="submit" disabled={direction === 'up' ? index === 0 : index >= total - 1}>
          {direction === 'up' ? 'Up' : 'Down'}
        </button>
      </form>
    ))
  }
  {
    removeIntent && (
      <form method="post" action="/api/financials/cards">
        <input type="hidden" name="intent" value={removeIntent} />
        {cardKey ? <input type="hidden" name="cardKey" value={cardKey} /> : null}
        {blockId ? <input type="hidden" name="blockId" value={blockId} /> : null}
        <input type="hidden" name="period" value={period.id} />
        <input type="hidden" name="start" value={period.start} />
        <input type="hidden" name="end" value={period.end} />
        <button class={buttonClass} type="submit">
          Remove
        </button>
      </form>
    )
  }
</div>
