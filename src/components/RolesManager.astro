---
import { listAssignablePermissions } from '../lib/org-roles';

interface RoleRow {
  id: string;
  key: string;
  name: string;
  description: string;
  isSystem?: boolean;
  permissions: Array<{ key: string; description: string }>;
}

interface Props {
  roles: RoleRow[];
  error?: string | null;
  saved?: boolean;
  createdRoleName?: string | null;
  createdRoleSurfaces?: string[];
  embedded?: boolean;
}

const {
  roles,
  error = null,
  saved = false,
  createdRoleName = null,
  createdRoleSurfaces = [],
  embedded = false,
} = Astro.props;
const permissionOptions = listAssignablePermissions();
const lockIcon = `<svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M5 7V5.5a3 3 0 0 1 6 0V7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/><rect x="3.5" y="7" width="9" height="7" rx="1.5" stroke="currentColor" stroke-width="1.5"/><circle cx="8" cy="10.5" r="1" fill="currentColor"/></svg>`;
const roleBadgeIcon = `<svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><circle cx="8" cy="5" r="2.25" stroke="currentColor" stroke-width="1.5"/><path d="M3.5 13c.6-2.2 2.2-3.5 4.5-3.5s3.9 1.3 4.5 3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>`;
const chevronIcon = `<svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg>`;
---

<section class:list={[!embedded && 'mt-10', 'scroll-mt-24']} id="roles" aria-labelledby="roles-heading">
  {!embedded ? <h2 id="roles-heading" class="font-display text-3xl text-charcoal">Roles</h2> : <h2 id="roles-heading" class="sr-only">Roles</h2>}

  {
    saved && !createdRoleName ? (
      <p class="mt-4 rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-900">
        Roles saved.
      </p>
    ) : null
  }
  {
    error ? (
      <p class="mt-4 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800">{error}</p>
    ) : null
  }

  <div class="mt-6 space-y-8">
    <div>
      <h3 class="text-sm font-semibold text-charcoal">Roles in this workspace</h3>
      <p class="mt-1 text-sm text-sage-dark/70">
        Rename a role and choose what it can see. Primary owner always has every permission and cannot be deleted. New organizations still start with these defaults.
      </p>

      {
        roles.length === 0 ? (
          <p class="mt-4 rounded-xl border border-dashed border-sage-dark/20 bg-[#fafbfc] px-4 py-6 text-sm text-sage-dark/65">
            No roles loaded yet. Refresh the page — defaults should appear automatically.
          </p>
        ) : (
          <div class="mt-4 space-y-2">
            {roles.map((role) => {
              const isOwner = role.key === 'owner';
              const isDefault = Boolean(role.isSystem);
              return (
                <details class="group overflow-hidden rounded-2xl border border-sage-dark/10 bg-white/90 shadow-sm open:shadow-md">
                  <summary class="flex cursor-pointer list-none items-center gap-3 px-4 py-3.5 [&::-webkit-details-marker]:hidden">
                    <span
                      class:list={[
                        'inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-full',
                        isOwner ? 'bg-sage/25 text-sage-dark' : 'bg-[#f4f5f8] text-sage-dark/70',
                      ]}
                      title={isOwner ? 'Primary owner' : isDefault ? 'Default role' : 'Custom role'}
                      set:html={isOwner ? lockIcon : roleBadgeIcon}
                    />
                    <span class="min-w-0 flex-1">
                      <span class="block font-semibold text-charcoal">{role.name}</span>
                      <span class="mt-0.5 block truncate text-xs text-sage-dark/55">
                        {isOwner ? 'Primary owner · always full access' : isDefault ? 'Default' : 'Custom'}
                        {role.description ? ` · ${role.description}` : ''}
                      </span>
                    </span>
                    <span
                      class="shrink-0 text-sage-dark/40 transition group-open:rotate-180"
                      set:html={chevronIcon}
                    />
                  </summary>

                  <div class="border-t border-sage-dark/10 px-4 py-4">
                    {
                      isOwner ? (
                        <div class="space-y-3">
                          <p class="text-sm text-sage-dark/75">
                            This role always has every permission and can see everything. Its title and access cannot be changed.
                          </p>
                          <ul class="grid gap-2 sm:grid-cols-2">
                            {permissionOptions.map((permission) => (
                              <li class="rounded-xl bg-[#f4f5f8] px-3 py-2 text-sm text-charcoal">{permission.label}</li>
                            ))}
                          </ul>
                        </div>
                      ) : (
                        <>
                        <form method="post" action="/api/admin/roles" class="space-y-3">
                          <input type="hidden" name="action" value="update" />
                          <input type="hidden" name="roleId" value={role.id} />
                          <input type="hidden" name="permissionsConfigured" value="1" />
                          <div class="grid gap-3 sm:grid-cols-2">
                            <label class="block text-sm font-medium text-charcoal">
                              Title
                              <input class="field mt-1" type="text" name="name" required value={role.name} maxlength="80" />
                            </label>
                            <label class="block text-sm font-medium text-charcoal">
                              Description
                              <input
                                class="field mt-1"
                                type="text"
                                name="description"
                                value={role.description}
                                maxlength="200"
                              />
                            </label>
                          </div>
                          <fieldset>
                            <legend class="text-xs font-semibold uppercase tracking-[0.12em] text-sage-dark/50">
                              Can see and do
                            </legend>
                            <div class="mt-2 grid gap-2 sm:grid-cols-2">
                              {permissionOptions.map((permission) => (
                                <label class="flex items-start gap-2 rounded-xl bg-[#f4f5f8] px-3 py-2 text-sm text-charcoal">
                                  <input
                                    class="mt-0.5"
                                    type="checkbox"
                                    name="permissions"
                                    value={permission.key}
                                    checked={
                                      role.permissions.some((p) => p.key === permission.key) ||
                                      permission.key === 'portal:access'
                                    }
                                    disabled={permission.key === 'portal:access'}
                                  />
                                  <span>{permission.label}</span>
                                  {permission.key === 'portal:access' ? (
                                    <input type="hidden" name="permissions" value="portal:access" />
                                  ) : null}
                                </label>
                              ))}
                            </div>
                          </fieldset>
                          <div class="flex justify-end">
                            <button
                              class="rounded-full bg-brand px-3 py-1.5 text-xs font-semibold text-onbrand"
                              type="submit"
                            >
                              Save
                            </button>
                          </div>
                        </form>
                        <form method="post" action="/api/admin/roles" class="mt-3">
                          <input type="hidden" name="action" value="delete" />
                          <input type="hidden" name="roleId" value={role.id} />
                          <input type="hidden" name="roleKey" value={role.key} />
                          <button
                            class="rounded-full px-3 py-1.5 text-xs font-semibold text-red-700 ring-1 ring-red-200 hover:bg-red-50"
                            type="submit"
                            onclick="return confirm('Delete this role? If it is still used anywhere, you will see where and the delete will be blocked.')"
                          >
                            Delete
                          </button>
                        </form>
                        </>
                      )
                    }
                  </div>
                </details>
              );
            })}
          </div>
        )
      }
    </div>

    <div class="rounded-2xl border border-dashed border-sage-dark/25 bg-[#fafbfc] p-4 sm:p-5">
      <h3 class="text-sm font-semibold text-charcoal">Add a role</h3>
      <p class="mt-1 text-sm text-sage-dark/70">
        New roles show up in People, Training, and Quick links, but are not checked on existing items automatically.
      </p>
      <form method="post" action="/api/admin/roles" class="mt-4 space-y-4">
        <input type="hidden" name="action" value="create" />
        <div class="grid gap-3 sm:grid-cols-2">
          <label class="block text-sm font-medium text-charcoal">
            Role name
            <input class="field mt-1" type="text" name="name" required placeholder="e.g. Nurse" maxlength="80" />
          </label>
          <label class="block text-sm font-medium text-charcoal">
            Description
            <input class="field mt-1" type="text" name="description" placeholder="Optional" maxlength="200" />
          </label>
        </div>
        <fieldset>
          <legend class="text-xs font-semibold uppercase tracking-[0.12em] text-sage-dark/50">Permissions</legend>
          <div class="mt-2 grid gap-2 sm:grid-cols-2">
            {
              permissionOptions.map((permission) => (
                <label class="flex items-start gap-2 rounded-xl border border-sage-dark/10 bg-white px-3 py-2 text-sm text-charcoal">
                  <input
                    class="mt-0.5"
                    type="checkbox"
                    name="permissions"
                    value={permission.key}
                    checked={permission.key === 'portal:access'}
                    disabled={permission.key === 'portal:access'}
                  />
                  <span>
                    <span class="font-medium">{permission.label}</span>
                    {permission.key === 'portal:access' ? (
                      <span class="mt-0.5 block text-[11px] text-sage-dark/55">Required so they can sign in</span>
                    ) : null}
                  </span>
                  {permission.key === 'portal:access' ? (
                    <input type="hidden" name="permissions" value="portal:access" />
                  ) : null}
                </label>
              ))
            }
          </div>
        </fieldset>
        <button class="btn-primary" type="submit">Add role</button>
      </form>
    </div>
  </div>
</section>

{
  createdRoleName ? (
    <dialog
      open
      class="fixed inset-0 z-50 m-0 flex h-full w-full items-center justify-center bg-black/40 p-4"
      data-role-created-dialog
    >
      <div class="max-w-md rounded-2xl bg-white p-6 shadow-xl">
        <h3 class="text-lg font-semibold text-charcoal">“{createdRoleName}” added</h3>
        <p class="mt-2 text-sm text-sage-dark/75">
          It is available to assign in these places (not checked automatically on existing items):
        </p>
        <ul class="mt-3 list-disc space-y-1 pl-5 text-sm text-charcoal">
          {createdRoleSurfaces.map((surface) => (
            <li>{surface}</li>
          ))}
        </ul>
        <form method="dialog" class="mt-5 flex justify-end">
          <button class="btn-primary" type="submit" data-role-created-close>
            Got it
          </button>
        </form>
      </div>
    </dialog>
  ) : null
}

<script is:inline>
  (function () {
    var dialog = document.querySelector('[data-role-created-dialog]');
    if (!(dialog instanceof HTMLDialogElement)) return;
    var closeBtn = dialog.querySelector('[data-role-created-close]');
    if (closeBtn) {
      closeBtn.addEventListener('click', function () {
        dialog.close();
        dialog.remove();
        if (window.history && window.location.search) {
          var url = new URL(window.location.href);
          url.searchParams.delete('roleCreated');
          url.searchParams.delete('roleName');
          url.searchParams.delete('roleSurfaces');
          window.history.replaceState({}, '', url.pathname + url.search + url.hash);
        }
      });
    }
  })();
</script>
