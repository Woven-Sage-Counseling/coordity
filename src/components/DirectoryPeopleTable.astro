---
import ShiftStatusIndicator from './ShiftStatusIndicator.astro';
import type { DirectoryPerson } from '../lib/employees';

interface Props {
  people: DirectoryPerson[];
  onShiftUserIds: string[];
  travelingUserIds: string[];
}

const { people, onShiftUserIds, travelingUserIds } = Astro.props;
const onShiftIds = new Set(onShiftUserIds);
const travelingIds = new Set(travelingUserIds);

function initials(name: string): string {
  return name
    .split(/\s+/)
    .filter(Boolean)
    .slice(0, 2)
    .map((part) => part[0]?.toUpperCase() ?? '')
    .join('');
}
---

<div class="mt-4 overflow-x-auto">
  <table class="w-full table-fixed text-left text-sm">
    <colgroup>
      <col class="w-[30%]" />
      <col class="w-16" />
      <col class="w-[22%]" />
      <col class="w-[28%]" />
      <col class="w-[16%]" />
    </colgroup>
    <thead>
      <tr class="border-b border-sage-dark/15 text-sage-dark/60">
        <th class="py-2 pr-4 font-medium">Name</th>
        <th class="py-2 pr-4 text-center font-medium">Status</th>
        <th class="py-2 pr-4 font-medium">Job title</th>
        <th class="py-2 pr-4 font-medium">Email</th>
        <th class="py-2 font-medium">Phone</th>
      </tr>
    </thead>
    <tbody>
      {
        people.map((person) => {
          const avatar = person.hasAvatar ? `/api/avatars/${person.id}` : null;
          const avatarInitials = initials(person.name) || '?';
          return (
            <tr class="border-b border-sage-dark/10">
              <td class="py-3 pr-4">
                <div class="flex min-w-0 items-center gap-3">
                  {
                    avatar ? (
                      <img
                        src={avatar}
                        alt=""
                        width="36"
                        height="36"
                        class="h-9 w-9 shrink-0 rounded-full object-cover ring-1 ring-black/10"
                      />
                    ) : (
                      <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-[#e8ebe7] text-xs font-semibold text-sage-dark ring-1 ring-black/10">
                        {avatarInitials}
                      </div>
                    )
                  }
                  <span class="truncate font-medium text-charcoal">{person.name}</span>
                </div>
              </td>
              <td class="py-3 pr-4">
                <div class="flex justify-center">
                  <ShiftStatusIndicator
                    onShift={onShiftIds.has(person.id)}
                    onTimeOff={travelingIds.has(person.id)}
                    compact
                  />
                </div>
              </td>
              <td class="py-3 pr-4 text-sage-dark/80">{person.jobTitle || '—'}</td>
              <td class="py-3 pr-4">
                <a class="break-all text-charcoal underline-offset-2 hover:underline" href={`mailto:${person.email}`}>
                  {person.email}
                </a>
              </td>
              <td class="py-3">
                {
                  person.phone ? (
                    <a class="text-charcoal underline-offset-2 hover:underline" href={`tel:${person.phone}`}>
                      {person.phone}
                    </a>
                  ) : (
                    <span class="text-sage-dark/50">—</span>
                  )
                }
              </td>
            </tr>
          );
        })
      }
    </tbody>
  </table>
</div>
