---
import { formatUsd, getFinancialSummary } from '../lib/financials/summary';
import { periodQuery, resolvePeriodFromSearch } from '../lib/financials/periods';
import type { FinancialSummary } from '../lib/financials/types';
import PeriodPicker from './PeriodPicker.astro';
import { widgetAccentVarsStyle } from '../lib/home-widget-header';
import WidgetHeaderBar from './WidgetHeaderBar.astro';

let summary: FinancialSummary | null = null;
try {
  summary = await getFinancialSummary(Astro.url.searchParams);
} catch (error) {
  console.error('home financial snapshot failed', error);
}

const snapshot = summary?.snapshot ?? null;
const period = summary?.period ?? resolvePeriodFromSearch(Astro.url.searchParams);
const ratio = summary?.reserveProgressRatio ?? null;
const percent = ratio == null ? null : Math.round(ratio * 100);

function formatPeriod(iso: string): string {
  const [year, month, day] = iso.split('-').map(Number);
  return new Date(Date.UTC(year, month - 1, day)).toLocaleDateString('en-US', {
    month: 'short',
    day: 'numeric',
    year: 'numeric',
    timeZone: 'UTC',
  });
}

const periodLabel = snapshot
  ? `${formatPeriod(snapshot.periodStart)} – ${formatPeriod(snapshot.periodEnd)}`
  : 'No snapshot yet';
---

<aside
  class="flex h-full flex-col overflow-hidden rounded-[1.05rem] bg-white shadow-[0_12px_32px_rgba(26,28,30,0.12)] ring-1 ring-black/10"
  aria-labelledby="home-financials-heading"
  data-widget-card
  data-widget-id="quickbooks"
  style={`${widgetAccentVarsStyle('quickbooks')}; min-height: 28rem;`}
>
  <WidgetHeaderBar
    widgetId="quickbooks"
    title="QuickBooks"
    headingId="home-financials-heading"
    openHref={`/financials${periodQuery(period)}`}
  />

  <div
    class="flex min-h-0 flex-1 flex-col overflow-y-auto overscroll-contain bg-[#f4f5f8] px-4 pb-4 pt-3 font-sans text-[#393a3d]"
    data-widget-body
    style="min-height: 0;"
  >
    <p class="m-0 text-[11px] font-bold uppercase tracking-[0.14em] text-[#6b6c72]">
      Reports
    </p>
    <p class="mt-1 text-base font-semibold text-[#393a3d]">
      Profit and Loss
    </p>
    <p class="mt-1 text-[11px] text-[#6b6c72]">{periodLabel}</p>
    <div class="mt-2">
      <PeriodPicker period={period} action="/" compact />
    </div>

    <div class="mt-4 rounded-lg bg-white p-3 shadow-sm">
      <div class="mb-3 flex justify-between text-xs">
        <span class="font-medium text-[#393a3d]">Income</span>
        <span class="font-semibold text-[#393a3d]">{formatUsd(snapshot?.revenueCents ?? null)}</span>
      </div>
      <div class="mb-3 flex justify-between text-xs">
        <span class="font-medium text-[#393a3d]">Therapist comp.</span>
        <span class="font-semibold text-[#393a3d]">{formatUsd(snapshot?.therapistCompensationCents ?? null)}</span>
      </div>
      <div class="mb-3 flex justify-between text-xs">
        <span class="font-medium text-[#393a3d]">Manager comp.</span>
        <span class="font-semibold text-[#393a3d]">{formatUsd(snapshot?.managementCompensationCents ?? null)}</span>
      </div>
      <div class="flex justify-between text-xs">
        <span class="font-medium text-[#393a3d]">Software &amp; tech</span>
        <span class="font-semibold text-[#393a3d]">{formatUsd(snapshot?.softwareAndTechnologyCents ?? null)}</span>
      </div>
    </div>

    <div class="mt-3 flex items-center justify-between gap-3 rounded-lg bg-white p-3 shadow-sm">
      <div>
        <p class="m-0 text-xs font-medium text-[#393a3d]">Reserve</p>
        <p class="mt-1 text-[11px] text-[#6b6c72]">
          {formatUsd(summary?.cash.boaReserveCents ?? null)} of {formatUsd(summary?.reserveTargetCents ?? null)}
        </p>
      </div>
      <p class="m-0 text-sm font-bold text-[#393a3d]">
        {percent == null ? '—' : `${percent}%`}
      </p>
    </div>
  </div>
</aside>
