---
import { formatUsd, getFinancialSummary } from '../lib/financials/summary';

const summary = await getFinancialSummary();
const snapshot = summary.snapshot;
const ratio = summary.reserveProgressRatio;
const percent = ratio == null ? null : Math.round(ratio * 100);
const clamped = ratio == null ? 0 : Math.min(Math.max(ratio, 0), 1);
const radius = 38;
const circumference = 2 * Math.PI * radius;
const dash = clamped * circumference;
const periodLabel = snapshot ? `${snapshot.periodStart} – ${snapshot.periodEnd}` : null;
---

<aside
  class="card overflow-hidden lg:sticky lg:top-6"
  aria-labelledby="home-financials-heading"
>
  <div class="flex items-start justify-between gap-3">
    <div>
      <p class="text-xs uppercase tracking-[0.18em] text-sage-dark/55">At a glance</p>
      <h2 id="home-financials-heading" class="mt-1 font-display text-2xl text-charcoal">
        Financials
      </h2>
    </div>
    <a href="/financials" class="text-sm font-medium text-sage-dark hover:text-charcoal">
      Full view
    </a>
  </div>

  {
    periodLabel ? (
      <p class="mt-1 text-xs text-sage-dark/55">{periodLabel} · cash basis</p>
    ) : (
      <p class="mt-1 text-xs text-sage-dark/55">No snapshot yet</p>
    )
  }

  <div class="mt-5 flex items-center gap-5">
    <div class="relative h-[6.5rem] w-[6.5rem] shrink-0" role="img" aria-label={
      percent == null
        ? 'Reserve progress unavailable until cash balances are connected'
        : `Reserve progress ${percent} percent of a ${summary.reserveTargetMonths}-month target`
    }>
      <svg viewBox="0 0 96 96" class="-rotate-90 h-full w-full" aria-hidden="true">
        <circle
          cx="48"
          cy="48"
          r={radius}
          fill="none"
          class="stroke-sage-dark/12"
          stroke-width="9"
        />
        <circle
          cx="48"
          cy="48"
          r={radius}
          fill="none"
          class="stroke-sage-dark"
          stroke-width="9"
          stroke-linecap="round"
          stroke-dasharray={`${dash} ${circumference}`}
        />
      </svg>
      <div class="absolute inset-0 flex flex-col items-center justify-center">
        <span class="font-display text-[1.65rem] leading-none text-charcoal">
          {percent == null ? '—' : `${percent}%`}
        </span>
      </div>
    </div>
    <div class="min-w-0">
      <p class="text-xs uppercase tracking-[0.16em] text-sage-dark/55">Reserve</p>
      <p class="mt-1 text-sm leading-snug text-sage-dark/75">
        {summary.reserveTargetMonths} months of average revenue
      </p>
      <p class="mt-1 text-xs text-sage-dark/55">
        Target {formatUsd(summary.reserveTargetCents)}
      </p>
    </div>
  </div>

  <dl class="mt-5 grid grid-cols-2 gap-3 border-t border-sage-dark/10 pt-4">
    <div>
      <dt class="text-xs uppercase tracking-[0.16em] text-sage-dark/55">Revenue</dt>
      <dd class="mt-1 font-display text-2xl leading-none text-charcoal">
        {formatUsd(snapshot?.revenueCents ?? null)}
      </dd>
    </div>
    <div>
      <dt class="text-xs uppercase tracking-[0.16em] text-sage-dark/55">Net income</dt>
      <dd class="mt-1 font-display text-2xl leading-none text-charcoal">
        {formatUsd(snapshot?.netIncomeCents ?? null)}
      </dd>
    </div>
  </dl>
</aside>
