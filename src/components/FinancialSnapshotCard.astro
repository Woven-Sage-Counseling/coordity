---
import { formatUsd, getFinancialSummary } from '../lib/financials/summary';
import { periodQuery, resolvePeriodFromSearch } from '../lib/financials/periods';
import type { FinancialSummary } from '../lib/financials/types';
import PeriodPicker from './PeriodPicker.astro';

let summary: FinancialSummary | null = null;
try {
  summary = await getFinancialSummary(Astro.url.searchParams);
} catch (error) {
  console.error('home financial snapshot failed', error);
}

const snapshot = summary?.snapshot ?? null;
const period = summary?.period ?? resolvePeriodFromSearch(Astro.url.searchParams);
const ratio = summary?.reserveProgressRatio ?? null;
const percent = ratio == null ? null : Math.round(ratio * 100);
const reserveTargetMonths = summary?.reserveTargetMonths ?? 3;
const revenue = snapshot?.revenueCents ?? 0;
const net = snapshot?.netIncomeCents ?? 0;
const therapist = snapshot?.therapistCompensationCents ?? 0;
const management = snapshot?.managementCompensationCents ?? 0;
const scale = Math.max(revenue, therapist, management, 1);
const incomeWidth = `${Math.round((revenue / scale) * 100)}%`;
const therapistWidth = `${Math.round((therapist / scale) * 100)}%`;
const managementWidth = `${Math.round((management / scale) * 100)}%`;
const therapistShare = revenue > 0 ? `${Math.round((therapist / revenue) * 100)}%` : null;
const managementShare = revenue > 0 ? `${Math.round((management / revenue) * 100)}%` : null;
const netPositive = net >= 0;

function formatPeriod(iso: string): string {
  const [year, month, day] = iso.split('-').map(Number);
  return new Date(Date.UTC(year, month - 1, day)).toLocaleDateString('en-US', {
    month: 'short',
    day: 'numeric',
    year: 'numeric',
    timeZone: 'UTC',
  });
}

const periodLabel = snapshot
  ? `${formatPeriod(snapshot.periodStart)} – ${formatPeriod(snapshot.periodEnd)}`
  : 'No snapshot yet';
---

<aside
  class="overflow-hidden rounded-[1.05rem] shadow-[0_12px_32px_rgba(26,28,30,0.12)] ring-1 ring-black/10 lg:sticky lg:top-6"
  aria-labelledby="home-financials-heading"
>
  <div class="bg-[#2CA01C] px-3 py-2.5 text-white">
    <div class="flex items-center gap-2">
      <span
        class="flex h-7 w-7 items-center justify-center rounded-md bg-white text-sm font-black text-[#2CA01C]"
        aria-hidden="true"
      >
        q
      </span>
      <div class="min-w-0">
        <p class="text-[11px] font-medium leading-none text-white/80">QuickBooks</p>
        <h2 id="home-financials-heading" class="mt-0.5 truncate text-sm font-semibold leading-none">
          Woven Sage Counseling
        </h2>
      </div>
    </div>
  </div>

  <div class="bg-[#f4f5f8] px-4 pb-4 pt-3 font-sans text-[#393a3d]">
    <div class="flex items-start justify-between gap-2">
      <div>
        <p class="text-[11px] font-semibold uppercase tracking-[0.14em] text-[#6b6c72]">Reports</p>
        <p class="mt-1 text-base font-semibold leading-tight">Profit and Loss</p>
      </div>
      <span class="rounded-full bg-white px-2 py-0.5 text-[10px] font-semibold uppercase tracking-wide text-[#2CA01C] ring-1 ring-[#2CA01C]/25">
        Cash
      </span>
    </div>
    <p class="mt-1 text-[11px] text-[#6b6c72]">{periodLabel}</p>
    <PeriodPicker period={period} action="/" compact />

    <div class="mt-4 rounded-lg bg-white p-3 shadow-sm ring-1 ring-black/[0.06]">
      <p class="text-[11px] font-medium text-[#6b6c72]">Net income</p>
      <p class:list={['mt-1 text-[1.85rem] font-semibold leading-none tracking-tight', netPositive ? 'text-[#2CA01C]' : 'text-[#d52b1e]']}>
        {formatUsd(snapshot?.netIncomeCents ?? null)}
      </p>
    </div>

    <div class="mt-3 space-y-3 rounded-lg bg-white p-3 shadow-sm ring-1 ring-black/[0.06]">
      <div>
        <div class="flex items-baseline justify-between gap-3 text-[12px]">
          <span class="font-medium">Income</span>
          <span class="font-semibold tabular-nums">{formatUsd(snapshot?.revenueCents ?? null)}</span>
        </div>
        <div class="mt-1.5 h-1.5 overflow-hidden rounded-full bg-[#e3e5e8]">
          <div class="h-full rounded-full bg-[#2CA01C]" style={`width: ${snapshot ? incomeWidth : '0%'}`}></div>
        </div>
      </div>
      <div>
        <div class="flex items-baseline justify-between gap-3 text-[12px]">
          <span class="font-medium">Therapist income</span>
          <span class="flex items-baseline gap-1.5 tabular-nums">
            <span class="font-semibold">{formatUsd(snapshot?.therapistCompensationCents ?? null)}</span>
            {therapistShare ? (
              <span class="font-medium text-[#b0b1b6]">{therapistShare}</span>
            ) : null}
          </span>
        </div>
        <div class="mt-1.5 h-1.5 overflow-hidden rounded-full bg-[#e3e5e8]">
          <div class="h-full rounded-full bg-[#3d8b37]" style={`width: ${snapshot ? therapistWidth : '0%'}`}></div>
        </div>
      </div>
      <div>
        <div class="flex items-baseline justify-between gap-3 text-[12px]">
          <span class="font-medium">Management income</span>
          <span class="flex items-baseline gap-1.5 tabular-nums">
            <span class="font-semibold">{formatUsd(snapshot?.managementCompensationCents ?? null)}</span>
            {managementShare ? (
              <span class="font-medium text-[#b0b1b6]">{managementShare}</span>
            ) : null}
          </span>
        </div>
        <div class="mt-1.5 h-1.5 overflow-hidden rounded-full bg-[#e3e5e8]">
          <div class="h-full rounded-full bg-[#6aa84f]" style={`width: ${snapshot ? managementWidth : '0%'}`}></div>
        </div>
      </div>
    </div>

    <div class="mt-3 flex items-center justify-between rounded-lg bg-white px-3 py-2.5 text-[12px] shadow-sm ring-1 ring-black/[0.06]">
      <div>
        <p class="font-medium">Reserve</p>
        <p class="mt-0.5 text-[11px] text-[#6b6c72]">
          {reserveTargetMonths}-month target {formatUsd(summary?.reserveTargetCents ?? null)}
        </p>
      </div>
      <p class="text-base font-semibold tabular-nums text-[#393a3d]">
        {percent == null ? '—' : `${percent}%`}
      </p>
    </div>

    <div class="mt-3 flex items-center justify-between text-[11px]">
      <a href={`/financials${periodQuery(period)}`} class="font-semibold text-[#2CA01C] hover:underline">
        Open in portal
      </a>
      <a
        href="https://app.qbo.intuit.com"
        class="font-medium text-[#6b6c72] hover:text-[#393a3d]"
        target="_blank"
        rel="noopener noreferrer"
      >
        Open QuickBooks
      </a>
    </div>
  </div>
</aside>
