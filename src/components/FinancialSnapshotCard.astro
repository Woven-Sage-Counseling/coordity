---
import {
  bankBalanceForAccount,
  orderedBoardRefs,
  pnlAmountForAccount,
  signedNetCents,
  splitTransactionsByKind,
  transactionsForAccounts,
  visibleBoardRefs,
  type DashboardAccountChoice,
} from '../lib/financials/cards';
import { normalizeMatchName } from '../lib/financials/outlook';
import { calendarDateValue, formatUsd, getFinancialSummary } from '../lib/financials/summary';
import { transactionShortName } from '../lib/financials/transaction-display';
import { periodQuery, resolvePeriodFromSearch } from '../lib/financials/periods';
import { orgIdFromLocals } from '../lib/organization';
import type { FinancialSummary } from '../lib/financials/types';
import PeriodPicker from './PeriodPicker.astro';
import { widgetAccentVarsStyle } from '../lib/home-widget-header';
import WidgetHeaderBar from './WidgetHeaderBar.astro';

interface Props {
  /** Cached snapshot for the home widget. The financials page still refreshes live. */
  preparedSummary?: FinancialSummary | null;
}

const { preparedSummary } = Astro.props;

let summary: FinancialSummary | null = preparedSummary ?? null;
if (preparedSummary === undefined) {
  try {
    summary = await getFinancialSummary(Astro.url.searchParams, {
      cachedOnly: true,
      orgId: orgIdFromLocals(Astro.locals.organization),
    });
  } catch (error) {
    console.error('home financial snapshot failed', error);
  }
}

const snapshot = summary?.snapshot ?? null;
const period = summary?.period ?? resolvePeriodFromSearch(Astro.url.searchParams);
const enabledCards = summary?.dashboardCards.filter((card) => card.enabled) ?? [];
const boardRefs = orderedBoardRefs(visibleBoardRefs(summary?.dashboardCards ?? []), summary?.boardOrder ?? []);

function formatPeriod(iso: string): string {
  const [year, month, day] = iso.split('-').map(Number);
  return new Date(Date.UTC(year, month - 1, day)).toLocaleDateString('en-US', {
    month: 'short',
    day: 'numeric',
    year: 'numeric',
    timeZone: 'UTC',
  });
}

const periodLabel = snapshot
  ? `${formatPeriod(snapshot.periodStart)} – ${formatPeriod(snapshot.periodEnd)}`
  : 'No snapshot yet';

const activityChoices: DashboardAccountChoice[] = (summary?.pnlLines ?? []).map((line) => ({
  id: line.accountId || `name:${normalizeMatchName(line.name)}`,
  name: line.name,
  kind: line.bucket === 'income' ? 'income' : 'expense',
}));
const incomePieColors = ['#2CA01C', '#3d8b37', '#6aa84f', '#8fbc8f', '#4f6f52', '#7d9a78'];
const expensePieColors = ['#c4a35a', '#a9533d', '#d4a017', '#8a5a44', '#b8956a', '#6b4f3a'];

function pieFor(accounts: DashboardAccountChoice[], colors: string[]) {
  const lines = summary?.pnlLines ?? [];
  const parts = accounts.map((account, index) => ({
    account,
    cents: Math.abs(pnlAmountForAccount(lines, account)),
    color: colors[index % colors.length] ?? '#2CA01C',
  }));
  const total = parts.reduce((sum, part) => sum + part.cents, 0);
  let cursor = -Math.PI / 2;
  const slices = parts.map((part) => {
    const sweep = total > 0 ? (part.cents / total) * Math.PI * 2 : 0;
    const start = cursor;
    cursor += sweep;
    return { ...part, start, end: cursor };
  });
  return { slices, total, empty: total <= 0 };
}

function piePath(start: number, end: number): string {
  const radius = 42;
  const center = 50;
  const sweep = end - start;
  if (sweep >= Math.PI * 2 - 0.0001) {
    return `M ${center} ${center - radius} A ${radius} ${radius} 0 1 1 ${center - 0.01} ${center - radius} Z`;
  }
  const x1 = center + radius * Math.cos(start);
  const y1 = center + radius * Math.sin(start);
  const x2 = center + radius * Math.cos(end);
  const y2 = center + radius * Math.sin(end);
  const large = sweep > Math.PI ? 1 : 0;
  return `M ${center} ${center} L ${x1} ${y1} A ${radius} ${radius} 0 ${large} 1 ${x2} ${y2} Z`;
}
---

<aside
  class="flex h-full min-h-0 flex-col overflow-hidden rounded-[1.05rem] bg-white shadow-[0_12px_32px_rgba(26,28,30,0.12)] ring-1 ring-black/10"
  aria-labelledby="home-financials-heading"
  data-widget-card
  data-widget-id="quickbooks"
  style={widgetAccentVarsStyle('quickbooks')}
>
  <WidgetHeaderBar
    widgetId="quickbooks"
    title="QuickBooks"
    headingId="home-financials-heading"
    openHref={`/financials${periodQuery(period)}`}
  />

  <div
    class="flex min-h-0 flex-1 flex-col overflow-y-auto overscroll-contain bg-[#f4f5f8] px-4 pb-4 pt-3 font-sans text-[#393a3d]"
    data-widget-body
    style="min-height: 0;"
  >
    <p class="m-0 text-[11px] font-bold uppercase tracking-[0.14em] text-[#6b6c72]">
      Reports
    </p>
    <p class="mt-1 text-[11px] text-[#6b6c72]">{periodLabel}</p>
    <div class="mt-2">
      <PeriodPicker period={period} action="/" compact />
    </div>

    {
      enabledCards.length === 0 ? (
        <p class="mt-4 text-xs leading-5 text-[#6b6c72]">No cards yet. Add them on the financials page.</p>
      ) : (
        <div class="mt-4 space-y-3">
          {boardRefs.map((ref) => {
            const card = enabledCards.find((item) => (ref.startsWith('income:') ? item.key === 'income_expenses' : item.key === ref));
            if (!card) return null;
            if (card.key === 'pnl') {
              return (
                <div class="rounded-lg bg-white p-3 shadow-sm">
                  <p class="m-0 text-xs font-semibold text-[#393a3d]">Profit and loss</p>
                  <div class="mt-2 flex justify-between text-xs">
                    <span>Income</span>
                    <span class="font-semibold">{formatUsd(snapshot?.revenueCents ?? null)}</span>
                  </div>
                  <div class="mt-2 flex justify-between text-xs">
                    <span>Expenses</span>
                    <span class="font-semibold">{formatUsd(summary?.reportedExpensesCents ?? null)}</span>
                  </div>
                </div>
              );
            }
            if (card.key === 'net_income') {
              const accountChoices = (summary?.pnlLines ?? [])
                .filter((line) => line.accountId)
                .map((line) => ({
                  id: line.accountId as string,
                  name: line.name,
                  kind: line.bucket === 'income' ? ('income' as const) : ('expense' as const),
                }));
              const net = summary ? signedNetCents(summary.pnlLines, accountChoices, card.accountIds) : null;
              return (
                <div class="rounded-lg bg-white p-3 shadow-sm">
                  <p class="m-0 text-xs font-semibold text-[#393a3d]">Net income</p>
                  <p class="mt-1 text-sm font-semibold">{formatUsd(net)}</p>
                </div>
              );
            }
            if (card.key === 'account_balance') {
              const balances = card.accountIds.flatMap((id) => {
                const found = summary ? bankBalanceForAccount(summary.bankAccounts, [], id) : null;
                if (!found) return [];
                return [{ name: card.labels[id] || found.name, cents: found.cents }];
              });
              return (
                <div class="rounded-lg bg-white p-3 shadow-sm">
                  <p class="m-0 text-xs font-semibold text-[#393a3d]">Account balances</p>
                  {
                    balances.length === 0 ? (
                      <p class="mt-1 text-xs text-[#6b6c72]">Add an account</p>
                    ) : (
                      balances.map((item) => (
                        <div class="mt-2 flex justify-between gap-3 text-xs">
                          <span>{item.name}</span>
                          <span class="font-semibold">{formatUsd(item.cents)}</span>
                        </div>
                      ))
                    )
                  }
                </div>
              );
            }
            const block = card.blocks.find((item) => `income:${item.id}` === ref);
            if (!block) return null;
            if (block.viewMode === 'pie') {
              const selected = activityChoices.filter((account) => block.accountIds.includes(account.id));
              const pies = [
                { label: 'Income', pie: pieFor(selected.filter((account) => account.kind === 'income'), incomePieColors) },
                { label: 'Expenses', pie: pieFor(selected.filter((account) => account.kind === 'expense'), expensePieColors) },
              ];
              return (
                <div class="rounded-lg bg-white p-3 shadow-sm">
                  <p class="m-0 text-xs font-semibold text-[#393a3d]">Income and expenses</p>
                  <div class="mt-2 flex flex-col items-center gap-2">
                    {pies.map(({ label, pie }) => (
                      <div class="flex flex-col items-center">
                        <p class="text-[10px] font-medium uppercase tracking-wide text-[#6b6c72]">{label}</p>
                        <svg class="mt-1 h-14 w-14" viewBox="0 0 100 100" role="img" aria-label={`${label} pie chart`}>
                          {pie.empty ? (
                            <circle cx="50" cy="50" r="42" fill="#e3e5e8">
                              <title>{`No ${label.toLowerCase()} in this range`}</title>
                            </circle>
                          ) : (
                            pie.slices
                              .filter((slice) => slice.cents > 0)
                              .map((slice) => (
                                <path d={piePath(slice.start, slice.end)} fill={slice.color}>
                                  <title>{`${slice.account.name}: ${formatUsd(slice.cents)}`}</title>
                                </path>
                              ))
                          )}
                        </svg>
                      </div>
                    ))}
                  </div>
                </div>
              );
            }
            if (block.viewMode === 'list') {
              const blockTransactions = transactionsForAccounts(summary?.transactions ?? [], activityChoices, block.accountIds).sort(
                (a, b) => calendarDateValue(b.date) - calendarDateValue(a.date) || Math.abs(b.cents) - Math.abs(a.cents),
              );
              const split = splitTransactionsByKind(blockTransactions, activityChoices, block.accountIds);
              const lists = [
                { label: 'Income', items: split.income },
                { label: 'Expenses', items: split.expenses },
              ];
              return (
                <div class="rounded-lg bg-white p-3 shadow-sm">
                  <p class="m-0 text-xs font-semibold text-[#393a3d]">Income and expenses</p>
                  {lists.map((column) => (
                    <div class="mt-2">
                      <p class="text-[10px] font-medium uppercase tracking-wide text-[#6b6c72]">{column.label}</p>
                      <ul class="mt-1 h-14 overflow-y-auto">
                        {column.items.length === 0 ? (
                          <li class="flex h-7 items-center text-[11px] text-[#6b6c72]">None in this range</li>
                        ) : (
                          column.items.map((transaction) => (
                            <li class="flex h-7 items-center justify-between gap-2 text-[11px] text-[#393a3d]">
                              <span class="min-w-0 truncate">{transactionShortName(transaction.name)}</span>
                              <span class="shrink-0 font-semibold tabular-nums">{formatUsd(Math.abs(transaction.cents))}</span>
                            </li>
                          ))
                        )}
                      </ul>
                    </div>
                  ))}
                </div>
              );
            }
            return (
              <div class="rounded-lg bg-white p-3 shadow-sm">
                <p class="m-0 text-xs font-semibold text-[#393a3d]">Income and expenses</p>
                <p class="mt-1 text-xs text-[#6b6c72]">
                  Summary graph
                  {block.accountIds.length > 0 ? ` · ${block.accountIds.length} accounts` : ' · choose accounts'}
                </p>
              </div>
            );
          })}
        </div>
      )
    }
  </div>
</aside>
