---
import '../styles/global.css';
import CoordityMark from '../components/CoordityMark.astro';
import FontLinks from '../components/FontLinks.astro';
import PreviewBanner from '../components/PreviewBanner.astro';
import PortalFooter from '../components/PortalFooter.astro';
import { getEnv } from '../lib/env';
import { countUnreadMessages } from '../lib/messages';
import {
  darkenHex,
  DEFAULT_ORG_COLORS,
  hexToAlpha,
  hexToRgbChannels,
  withAlpha,
} from '../lib/organization';
import { widgetHeaderForeground } from '../lib/home-widget-header';
import { canAccessManagement, hasPermission } from '../lib/permissions';

interface Props {
  title: string;
  wide?: boolean;
  /** Full-bleed content (no max-width padding); fills viewport under the header. */
  flush?: boolean;
}

const { title, wide = false, flush = false } = Astro.props;
const employee = Astro.locals.employee;
const organization = Astro.locals.organization;
const orgName = organization?.displayName ?? organization?.name ?? 'Employee portal';
const orgLogo = organization?.logoUrl ?? null;
const orgFaviconHref = organization?.hasFavicon
  ? `/api/org/favicon?v=${organization.faviconUpdatedAt ?? 0}`
  : '/favicon.png';
const invertLogoDark = organization?.invertLogoDark ?? false;

const lightBg = organization?.bgColorLight ?? DEFAULT_ORG_COLORS.light.background;
const lightSurface = organization?.surfaceColorLight ?? DEFAULT_ORG_COLORS.light.surface;
const lightText = organization?.textColorLight ?? DEFAULT_ORG_COLORS.light.text;
const lightPrimary = organization?.primaryColorLight ?? DEFAULT_ORG_COLORS.light.primary;
const lightPrimaryText = organization?.primaryTextColorLight ?? lightBg;
const lightAccent = organization?.accentColorLight ?? DEFAULT_ORG_COLORS.light.accent;
const lightAccentText = organization?.accentTextColorLight ?? lightAccent;
const lightPrimaryHover = organization?.primaryHoverColorLight ?? lightAccent;
const lightAccentHover = organization?.accentHoverColorLight ?? withAlpha(lightAccent, 10);
const lightShadow = organization?.shadowColorLight ?? withAlpha(lightAccent, 18);
const lightShadowText = organization?.shadowTextColorLight ?? lightAccentText;
const lightShadowHover = organization?.shadowHoverColorLight ?? withAlpha(lightAccent, 28);
const lightSelected = organization?.selectedColorLight ?? withAlpha(lightAccent, 20);
const lightSelectedText = organization?.selectedTextColorLight ?? lightText;
const lightSelectedHover = organization?.selectedHoverColorLight ?? withAlpha(lightAccent, 10);
const lightWidgetHeader = organization?.widgetHeaderColorLight ?? DEFAULT_ORG_COLORS.light.widgetHeader;
const lightWidgetBg = organization?.widgetBgColorLight ?? DEFAULT_ORG_COLORS.light.widgetBg;
const lightWidgetCard = organization?.widgetCardColorLight ?? lightSurface;
const lightWidgetButton = organization?.widgetButtonColorLight ?? lightWidgetHeader;
const lightWidgetButtonText = organization?.widgetButtonTextColorLight ?? widgetHeaderForeground(lightWidgetButton);
const lightWidgetButtonHover = organization?.widgetButtonHoverColorLight ?? darkenHex(lightWidgetButton);
const lightWidgetOutline = organization?.widgetOutlineColorLight ?? DEFAULT_ORG_COLORS.light.widgetOutline;
const lightWidgetOutlineText = organization?.widgetOutlineTextColorLight ?? DEFAULT_ORG_COLORS.light.widgetOutlineText;
const lightWidgetOutlineHover = organization?.widgetOutlineHoverColorLight ?? DEFAULT_ORG_COLORS.light.widgetOutlineHover;
const lightTrainingHeader = organization?.trainingHeaderColorLight ?? lightSelected;
const lightTrainingHeaderText = organization?.trainingHeaderTextColorLight ?? lightText;
const lightTrainingModule = organization?.trainingModuleColorLight ?? lightPrimary;
const lightTrainingModuleText = organization?.trainingModuleTextColorLight ?? lightPrimaryText;
const lightTrainingLesson = organization?.trainingLessonColorLight ?? withAlpha(lightAccent, 25);
const lightTrainingLessonText = organization?.trainingLessonTextColorLight ?? lightText;
const lightTrainingBlock = organization?.trainingBlockColorLight ?? '#F7F8FA';
const lightTrainingBlockText = organization?.trainingBlockTextColorLight ?? lightText;
const lightTrainingField = organization?.trainingFieldColorLight ?? lightSurface;
const lightTrainingFilled = organization?.trainingFilledColorLight ?? lightPrimary;
const lightTrainingFilledText = organization?.trainingFilledTextColorLight ?? lightPrimaryText;
const lightTrainingFilledHover = organization?.trainingFilledHoverColorLight ?? lightPrimaryHover;
const lightTrainingOutline = organization?.trainingOutlineColorLight ?? lightAccent;
const lightTrainingOutlineText = organization?.trainingOutlineTextColorLight ?? lightAccentText;
const lightTrainingOutlineHover = organization?.trainingOutlineHoverColorLight ?? lightAccentHover;
const darkBg = organization?.bgColorDark ?? DEFAULT_ORG_COLORS.dark.background;
const darkSurface = organization?.surfaceColorDark ?? DEFAULT_ORG_COLORS.dark.surface;
const darkText = organization?.textColorDark ?? DEFAULT_ORG_COLORS.dark.text;
const darkPrimary = organization?.primaryColorDark ?? DEFAULT_ORG_COLORS.dark.primary;
const darkPrimaryText = organization?.primaryTextColorDark ?? darkBg;
const darkAccent = organization?.accentColorDark ?? DEFAULT_ORG_COLORS.dark.accent;
const darkAccentText = organization?.accentTextColorDark ?? darkAccent;
const darkPrimaryHover = organization?.primaryHoverColorDark ?? darkAccent;
const darkAccentHover = organization?.accentHoverColorDark ?? withAlpha(darkAccent, 10);
const darkShadow = organization?.shadowColorDark ?? withAlpha(darkAccent, 22);
const darkShadowText = organization?.shadowTextColorDark ?? darkAccentText;
const darkShadowHover = organization?.shadowHoverColorDark ?? withAlpha(darkAccent, 32);
const darkSelected = organization?.selectedColorDark ?? withAlpha(darkAccent, 20);
const darkSelectedText = organization?.selectedTextColorDark ?? darkText;
const darkSelectedHover = organization?.selectedHoverColorDark ?? withAlpha(darkAccent, 10);
const darkWidgetHeader = organization?.widgetHeaderColorDark ?? DEFAULT_ORG_COLORS.dark.widgetHeader;
const darkWidgetBg = organization?.widgetBgColorDark ?? DEFAULT_ORG_COLORS.dark.widgetBg;
const darkWidgetCard = organization?.widgetCardColorDark ?? darkSurface;
const darkWidgetButton = organization?.widgetButtonColorDark ?? darkWidgetHeader;
const darkWidgetButtonText = organization?.widgetButtonTextColorDark ?? widgetHeaderForeground(darkWidgetButton);
const darkWidgetButtonHover = organization?.widgetButtonHoverColorDark ?? darkenHex(darkWidgetButton);
const darkWidgetOutline = organization?.widgetOutlineColorDark ?? DEFAULT_ORG_COLORS.dark.widgetOutline;
const darkWidgetOutlineText = organization?.widgetOutlineTextColorDark ?? DEFAULT_ORG_COLORS.dark.widgetOutlineText;
const darkWidgetOutlineHover = organization?.widgetOutlineHoverColorDark ?? DEFAULT_ORG_COLORS.dark.widgetOutlineHover;
const darkTrainingHeader = organization?.trainingHeaderColorDark ?? darkSelected;
const darkTrainingHeaderText = organization?.trainingHeaderTextColorDark ?? darkText;
const darkTrainingModule = organization?.trainingModuleColorDark ?? darkPrimary;
const darkTrainingModuleText = organization?.trainingModuleTextColorDark ?? darkPrimaryText;
const darkTrainingLesson = organization?.trainingLessonColorDark ?? withAlpha(darkAccent, 25);
const darkTrainingLessonText = organization?.trainingLessonTextColorDark ?? darkText;
const darkTrainingBlock = organization?.trainingBlockColorDark ?? '#252925';
const darkTrainingBlockText = organization?.trainingBlockTextColorDark ?? darkText;
const darkTrainingField = organization?.trainingFieldColorDark ?? darkSurface;
const darkTrainingFilled = organization?.trainingFilledColorDark ?? darkPrimary;
const darkTrainingFilledText = organization?.trainingFilledTextColorDark ?? darkPrimaryText;
const darkTrainingFilledHover = organization?.trainingFilledHoverColorDark ?? darkPrimaryHover;
const darkTrainingOutline = organization?.trainingOutlineColorDark ?? darkAccent;
const darkTrainingOutlineText = organization?.trainingOutlineTextColorDark ?? darkAccentText;
const darkTrainingOutlineHover = organization?.trainingOutlineHoverColorDark ?? darkAccentHover;

const lightBgRgb = hexToRgbChannels(lightBg) ?? '247 244 238';
const lightSurfaceRgb = hexToRgbChannels(lightSurface) ?? '255 255 255';
const lightTextRgb = hexToRgbChannels(lightText) ?? '83 95 81';
const lightPrimaryRgb = hexToRgbChannels(lightPrimary) ?? '83 95 81';
const lightPrimaryTextRgb = hexToRgbChannels(lightPrimaryText) ?? lightBgRgb;
const lightAccentRgb = hexToRgbChannels(lightAccent) ?? '120 143 117';
const lightAccentTextRgb = hexToRgbChannels(lightAccentText) ?? lightAccentRgb;
const lightPrimaryHoverRgb = hexToRgbChannels(lightPrimaryHover) ?? lightAccentRgb;
const lightAccentHoverRgb = hexToRgbChannels(lightAccentHover) ?? lightAccentRgb;
const lightShadowRgb = hexToRgbChannels(lightShadow) ?? lightAccentRgb;
const lightShadowTextRgb = hexToRgbChannels(lightShadowText) ?? lightAccentTextRgb;
const lightShadowHoverRgb = hexToRgbChannels(lightShadowHover) ?? lightAccentRgb;
const lightWidgetBgRgb = hexToRgbChannels(lightWidgetBg) ?? '244 245 248';
const lightWidgetCardRgb = hexToRgbChannels(lightWidgetCard) ?? lightSurfaceRgb;
const lightWidgetButtonRgb = hexToRgbChannels(lightWidgetButton) ?? '83 95 81';
const lightWidgetButtonTextRgb = hexToRgbChannels(lightWidgetButtonText) ?? '247 244 238';
const lightWidgetButtonHoverRgb = hexToRgbChannels(lightWidgetButtonHover) ?? lightWidgetButtonRgb;
const darkBgRgb = hexToRgbChannels(darkBg) ?? '17 19 17';
const darkSurfaceRgb = hexToRgbChannels(darkSurface) ?? '30 33 30';
const darkTextRgb = hexToRgbChannels(darkText) ?? '186 198 182';
const darkPrimaryRgb = hexToRgbChannels(darkPrimary) ?? '186 198 182';
const darkPrimaryTextRgb = hexToRgbChannels(darkPrimaryText) ?? darkBgRgb;
const darkAccentRgb = hexToRgbChannels(darkAccent) ?? '138 158 134';
const darkAccentTextRgb = hexToRgbChannels(darkAccentText) ?? darkAccentRgb;
const darkPrimaryHoverRgb = hexToRgbChannels(darkPrimaryHover) ?? darkAccentRgb;
const darkAccentHoverRgb = hexToRgbChannels(darkAccentHover) ?? darkAccentRgb;
const darkShadowRgb = hexToRgbChannels(darkShadow) ?? darkAccentRgb;
const darkShadowTextRgb = hexToRgbChannels(darkShadowText) ?? darkAccentTextRgb;
const darkShadowHoverRgb = hexToRgbChannels(darkShadowHover) ?? darkAccentRgb;
const darkWidgetBgRgb = hexToRgbChannels(darkWidgetBg) ?? '37 41 37';
const darkWidgetCardRgb = hexToRgbChannels(darkWidgetCard) ?? darkSurfaceRgb;
const darkWidgetButtonRgb = hexToRgbChannels(darkWidgetButton) ?? '83 95 81';
const darkWidgetButtonTextRgb = hexToRgbChannels(darkWidgetButtonText) ?? '247 244 238';
const darkWidgetButtonHoverRgb = hexToRgbChannels(darkWidgetButtonHover) ?? darkWidgetButtonRgb;

function selectedItemRule(selector: string, color: string, text: string, hover: string) {
  return `${selector}{--portal-selected:${hexToRgbChannels(color) ?? '120 143 117'} !important;--portal-selected-a:${hexToAlpha(color)} !important;--portal-on-selected:${hexToRgbChannels(text) ?? '83 95 81'} !important;--portal-on-selected-a:${hexToAlpha(text)} !important;--portal-selected-hover:${hexToRgbChannels(hover) ?? '120 143 117'} !important;--portal-selected-hover-a:${hexToAlpha(hover)} !important;}`;
}

function trainingRule(selector: string, colors: Record<string, string>) {
  const decl = Object.entries(colors)
    .map(
      ([name, hex]) =>
        `--portal-training-${name}:${hexToRgbChannels(hex) ?? '247 248 250'} !important;--portal-training-${name}-a:${hexToAlpha(hex)} !important;`,
    )
    .join('');
  return `${selector}{${decl}}`;
}

function widgetOutlineRule(selector: string, color: string, text: string, hover: string) {
  return `${selector}{--portal-widget-outline:${hexToRgbChannels(color) ?? '83 95 81'} !important;--portal-widget-outline-a:${hexToAlpha(color)} !important;--portal-widget-outline-text:${hexToRgbChannels(text) ?? '83 95 81'} !important;--portal-widget-outline-text-a:${hexToAlpha(text)} !important;--portal-widget-outline-hover:${hexToRgbChannels(hover) ?? '83 95 81'} !important;--portal-widget-outline-hover-a:${hexToAlpha(hover)} !important;}`;
}

function brandBlock(
  selector: string,
  bg: string,
  surface: string,
  text: string,
  primary: string,
  primaryText: string,
  accent: string,
  accentText: string,
  widgetHeader: string,
  widgetHeaderFg: string,
  widgetBg: string,
  widgetCard: string,
  primaryHover: string,
  accentHover: string,
  widgetButton: string,
  widgetButtonText: string,
  widgetButtonHover: string,
  shadow: string,
  shadowText: string,
  shadowHover: string,
  alphas: {
    bg: string;
    surface: string;
    text: string;
    primary: string;
    primaryText: string;
    accent: string;
    accentText: string;
    widgetBg: string;
    widgetCard: string;
    primaryHover: string;
    accentHover: string;
    widgetButton: string;
    widgetButtonText: string;
    widgetButtonHover: string;
    shadow: string;
    shadowText: string;
    shadowHover: string;
  },
) {
  return `${selector}{--portal-cream:${bg} !important;--portal-cream-a:${alphas.bg} !important;--portal-surface:${surface} !important;--portal-surface-a:${alphas.surface} !important;--portal-sage-dark:${text} !important;--portal-sage-dark-a:${alphas.text} !important;--portal-charcoal:${text} !important;--portal-charcoal-a:${alphas.text} !important;--portal-primary:${primary} !important;--portal-primary-a:${alphas.primary} !important;--portal-on-primary:${primaryText} !important;--portal-on-primary-a:${alphas.primaryText} !important;--portal-sage:${accent} !important;--portal-sage-a:${alphas.accent} !important;--portal-sage-light:${accent} !important;--portal-sage-light-a:${alphas.accent} !important;--portal-accent:${accent} !important;--portal-accent-a:${alphas.accent} !important;--portal-on-accent:${accentText} !important;--portal-on-accent-a:${alphas.accentText} !important;--portal-primary-hover:${primaryHover} !important;--portal-primary-hover-a:${alphas.primaryHover} !important;--portal-accent-hover:${accentHover} !important;--portal-accent-hover-a:${alphas.accentHover} !important;--portal-shadow:${shadow} !important;--portal-shadow-a:${alphas.shadow} !important;--portal-on-shadow:${shadowText} !important;--portal-on-shadow-a:${alphas.shadowText} !important;--portal-shadow-hover:${shadowHover} !important;--portal-shadow-hover-a:${alphas.shadowHover} !important;--portal-widget-header:${widgetHeader} !important;--portal-widget-header-fg:${widgetHeaderFg} !important;--portal-widget-bg:${widgetBg} !important;--portal-widget-bg-a:${alphas.widgetBg} !important;--portal-widget-card:${widgetCard} !important;--portal-widget-card-a:${alphas.widgetCard} !important;--portal-widget-button:${widgetButton} !important;--portal-widget-button-a:${alphas.widgetButton} !important;--portal-widget-button-text:${widgetButtonText} !important;--portal-widget-button-text-a:${alphas.widgetButtonText} !important;--portal-widget-button-hover:${widgetButtonHover} !important;--portal-widget-button-hover-a:${alphas.widgetButtonHover} !important;}`;
}
// !important so these beat the default palette in global.css no matter which
// stylesheet Astro injects last.
const brandStyle =
  brandBlock(
    'html',
    lightBgRgb,
    lightSurfaceRgb,
    lightTextRgb,
    lightPrimaryRgb,
    lightPrimaryTextRgb,
    lightAccentRgb,
    lightAccentTextRgb,
    lightWidgetHeader,
    widgetHeaderForeground(lightWidgetHeader),
    lightWidgetBgRgb,
    lightWidgetCardRgb,
    lightPrimaryHoverRgb,
    lightAccentHoverRgb,
    lightWidgetButtonRgb,
    lightWidgetButtonTextRgb,
    lightWidgetButtonHoverRgb,
    lightShadowRgb,
    lightShadowTextRgb,
    lightShadowHoverRgb,
    {
      bg: hexToAlpha(lightBg),
      surface: hexToAlpha(lightSurface),
      text: hexToAlpha(lightText),
      primary: hexToAlpha(lightPrimary),
      primaryText: hexToAlpha(lightPrimaryText),
      accent: hexToAlpha(lightAccent),
      accentText: hexToAlpha(lightAccentText),
      widgetBg: hexToAlpha(lightWidgetBg),
      widgetCard: hexToAlpha(lightWidgetCard),
      primaryHover: hexToAlpha(lightPrimaryHover),
      accentHover: hexToAlpha(lightAccentHover),
      widgetButton: hexToAlpha(lightWidgetButton),
      widgetButtonText: hexToAlpha(lightWidgetButtonText),
      widgetButtonHover: hexToAlpha(lightWidgetButtonHover),
      shadow: hexToAlpha(lightShadow),
      shadowText: hexToAlpha(lightShadowText),
      shadowHover: hexToAlpha(lightShadowHover),
    },
  ) +
  widgetOutlineRule('html', lightWidgetOutline, lightWidgetOutlineText, lightWidgetOutlineHover) +
  selectedItemRule('html', lightSelected, lightSelectedText, lightSelectedHover) +
  trainingRule('html', {
    header: lightTrainingHeader,
    'header-text': lightTrainingHeaderText,
    module: lightTrainingModule,
    'module-text': lightTrainingModuleText,
    lesson: lightTrainingLesson,
    'lesson-text': lightTrainingLessonText,
    block: lightTrainingBlock,
    'block-text': lightTrainingBlockText,
    field: lightTrainingField,
    filled: lightTrainingFilled,
    'filled-text': lightTrainingFilledText,
    'filled-hover': lightTrainingFilledHover,
    outline: lightTrainingOutline,
    'outline-text': lightTrainingOutlineText,
    'outline-hover': lightTrainingOutlineHover,
  }) +
  brandBlock(
    'html.dark',
    darkBgRgb,
    darkSurfaceRgb,
    darkTextRgb,
    darkPrimaryRgb,
    darkPrimaryTextRgb,
    darkAccentRgb,
    darkAccentTextRgb,
    darkWidgetHeader,
    widgetHeaderForeground(darkWidgetHeader),
    darkWidgetBgRgb,
    darkWidgetCardRgb,
    darkPrimaryHoverRgb,
    darkAccentHoverRgb,
    darkWidgetButtonRgb,
    darkWidgetButtonTextRgb,
    darkWidgetButtonHoverRgb,
    darkShadowRgb,
    darkShadowTextRgb,
    darkShadowHoverRgb,
    {
      bg: hexToAlpha(darkBg),
      surface: hexToAlpha(darkSurface),
      text: hexToAlpha(darkText),
      primary: hexToAlpha(darkPrimary),
      primaryText: hexToAlpha(darkPrimaryText),
      accent: hexToAlpha(darkAccent),
      accentText: hexToAlpha(darkAccentText),
      widgetBg: hexToAlpha(darkWidgetBg),
      widgetCard: hexToAlpha(darkWidgetCard),
      primaryHover: hexToAlpha(darkPrimaryHover),
      accentHover: hexToAlpha(darkAccentHover),
      widgetButton: hexToAlpha(darkWidgetButton),
      widgetButtonText: hexToAlpha(darkWidgetButtonText),
      widgetButtonHover: hexToAlpha(darkWidgetButtonHover),
      shadow: hexToAlpha(darkShadow),
      shadowText: hexToAlpha(darkShadowText),
      shadowHover: hexToAlpha(darkShadowHover),
    },
  ) +
  widgetOutlineRule('html.dark', darkWidgetOutline, darkWidgetOutlineText, darkWidgetOutlineHover) +
  selectedItemRule('html.dark', darkSelected, darkSelectedText, darkSelectedHover) +
  trainingRule('html.dark', {
    header: darkTrainingHeader,
    'header-text': darkTrainingHeaderText,
    module: darkTrainingModule,
    'module-text': darkTrainingModuleText,
    lesson: darkTrainingLesson,
    'lesson-text': darkTrainingLessonText,
    block: darkTrainingBlock,
    'block-text': darkTrainingBlockText,
    field: darkTrainingField,
    filled: darkTrainingFilled,
    'filled-text': darkTrainingFilledText,
    'filled-hover': darkTrainingFilledHover,
    outline: darkTrainingOutline,
    'outline-text': darkTrainingOutlineText,
    'outline-hover': darkTrainingOutlineHover,
  });
const canSeeFinancials = hasPermission(employee, 'financials:view');
const canSeeManagement = canAccessManagement(employee);
const showFooter = employee?.status === 'active' && !flush;
const reportIssueEnabled = Boolean(getEnv().RESEND_API_KEY?.trim());
const orgId = organization?.id;
const messagesUnread =
  employee?.status === 'active'
    ? await (Astro.locals.unreadMessages ?? countUnreadMessages(employee.id, orgId).catch(() => 0))
    : 0;

const currentPath = (Astro.url.pathname.replace(/\/$/, '') || '/') as string;
function navIsActive(href: string) {
  if (href === '/') return currentPath === '/';
  return currentPath === href || currentPath.startsWith(`${href}/`);
}
const primaryNav = [
  { href: '/', label: 'Home' },
  { href: '/workspace', label: 'WorkHub' },
  { href: '/apps', label: 'Quick links' },
  { href: '/directory', label: 'Directory' },
  { href: '/messages', label: 'Messages', badge: true as const },
  { href: '/account', label: 'Account' },
  ...(canSeeFinancials ? [{ href: '/financials', label: 'Financials' }] : []),
  ...(canSeeManagement ? [{ href: '/admin', label: 'Admin' }] : []),
];

const navSep = `<svg width="4" height="18" viewBox="0 0 4 18" fill="none" aria-hidden="true"><path d="M2 1v16" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" opacity="0.45"/></svg>`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="description" content={`Private employee workspace for ${orgName}, powered by Coordity.`} />
    <link rel="icon" href={orgFaviconHref} />
    <link rel="apple-touch-icon" href={orgFaviconHref} />
    <FontLinks />
    <title>{title} | {orgName}</title>
    <Fragment set:html={`<style id="org-brand">${brandStyle}</style>`} />
    <script is:inline define:vars={{ themeUserId: employee?.id ?? null }}>
      (function () {
        try {
          var key = themeUserId ? 'portal:theme:' + themeUserId : 'portal:theme';
          var value = localStorage.getItem(key) || localStorage.getItem('portal:theme');
          if (value === 'dark') document.documentElement.classList.add('dark');
          else document.documentElement.classList.remove('dark');
        } catch (e) {}
      })();
    </script>
  </head>
  <body class:list={['flex flex-col', flush ? 'h-dvh overflow-hidden' : 'min-h-screen']}>
    <PreviewBanner />
    {
      employee?.status === 'active' && (
        <header class="relative z-20 shrink-0 border-b border-sage-dark/10 bg-cream/90">
          <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-5 py-3 sm:px-8">
            <a href="/" class="flex items-center gap-3">
              {
                orgLogo ? (
                  <img
                    src={orgLogo}
                    alt={orgName}
                    class:list={['h-7 w-auto', invertLogoDark ? 'org-logo-invert-dark' : null]}
                    width="220"
                    height="38"
                  />
                ) : (
                  <>
                    <span class="dark:hidden">
                      <CoordityMark class="h-7" />
                    </span>
                    <span class="hidden dark:inline-flex">
                      <CoordityMark variant="light" class="h-7" />
                    </span>
                  </>
                )
              }
              <span class="hidden text-xs uppercase tracking-[0.18em] text-sage-dark/70 sm:inline">
                Workspace
              </span>
            </a>
            <nav class="flex flex-wrap items-center justify-end gap-x-1.5 gap-y-2 text-sm" aria-label="Primary">
              <div
                class="relative inline-flex flex-wrap items-center gap-x-0 gap-y-1"
                data-portal-nav
              >
                <span
                  class="item-selected-fill pointer-events-none absolute left-0 top-0 z-0 rounded-full border opacity-0"
                  data-portal-nav-pill
                  aria-hidden="true"
                ></span>
                {
                  primaryNav.map((item, index) => {
                    const active = navIsActive(item.href);
                    return (
                      <>
                        {index > 0 ? (
                          <span
                            class="pointer-events-none relative z-10 mx-0.5 inline-flex shrink-0 items-center self-center text-sage-dark/35"
                            aria-hidden="true"
                            set:html={navSep}
                          />
                        ) : null}
                        <a
                          href={item.href}
                          data-portal-nav-link
                          data-nav-href={item.href}
                          aria-current={active ? 'page' : undefined}
                          class:list={[
                            'relative z-10 inline-flex items-center gap-1.5 rounded-full px-2.5 py-1.5 transition-colors',
                            active
                              ? 'item-selected-text font-medium'
                              : 'text-sage-dark/80 hover:text-sage-dark',
                          ]}
                        >
                          {item.label}
                          {'badge' in item && item.badge ? (
                            <span
                              class:list={[
                                'rounded-full bg-amber-500 px-1.5 text-[10px] font-bold text-white',
                                messagesUnread > 0 ? '' : 'hidden',
                              ]}
                              data-messages-nav-badge
                            >
                              {messagesUnread > 99 ? '99+' : messagesUnread}
                            </span>
                          ) : null}
                        </a>
                      </>
                    );
                  })
                }
              </div>
              <a
                href="/settings"
                data-portal-nav-external
                aria-current={navIsActive('/settings') ? 'page' : undefined}
                aria-label="Settings"
                title="Settings"
                class:list={[
                  'inline-flex items-center text-sage-dark/80 hover:text-sage-dark',
                  navIsActive('/settings') ? 'item-selected-text' : null,
                ]}
              >
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path
                    d="M19.14 12.94c.04-.31.06-.63.06-.94s-.02-.63-.06-.94l2.03-1.58a.49.49 0 0 0 .12-.61l-1.92-3.32a.49.49 0 0 0-.59-.22l-2.39.96c-.5-.4-1.04-.71-1.62-.94l-.36-2.54a.48.48 0 0 0-.48-.41h-3.84a.48.48 0 0 0-.48.41l-.36 2.54c-.58.23-1.12.54-1.62.94l-2.39-.96a.49.49 0 0 0-.59.22L2.74 8.87a.49.49 0 0 0 .12.61l2.03 1.58c-.04.31-.06.63-.06.94s.02.63.06.94L2.86 14.5a.49.49 0 0 0-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.39 1.04.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.48-.41l.36-2.54c.58-.24 1.12-.55 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32a.49.49 0 0 0-.12-.61l-2.03-1.58ZM12 15.6A3.6 3.6 0 1 1 12 8.4a3.6 3.6 0 0 1 0 7.2Z"
                  />
                </svg>
              </a>
            </nav>
          </div>
        </header>
      )
    }
    <main class="relative z-10 flex min-h-0 flex-1 flex-col">
      <div
        class:list={[
          flush ? 'flex min-h-0 flex-1 flex-col' : 'mx-auto px-5 py-10 sm:px-8',
          !flush && (wide ? 'max-w-6xl' : 'max-w-3xl'),
        ]}
      >
        <slot />
      </div>
    </main>
    {
      showFooter && (
        <PortalFooter employeeName={employee!.name} reportIssueEnabled={reportIssueEnabled} />
      )
    }
    <script is:inline>
      (function () {
        function showSaveFlash(el) {
          if (!(el instanceof HTMLElement)) return;
          el.hidden = false;
          el.classList.remove('hidden');
          el.classList.remove('opacity-0');
          el.classList.add('opacity-100');
          var prev = Number(el.getAttribute('data-save-flash-timer') || 0);
          var prevHide = Number(el.getAttribute('data-save-flash-hide') || 0);
          if (prev) window.clearTimeout(prev);
          if (prevHide) window.clearTimeout(prevHide);
          var timer = window.setTimeout(function () {
            el.classList.remove('opacity-100');
            el.classList.add('opacity-0');
            var hide = window.setTimeout(function () {
              el.classList.add('hidden');
              el.hidden = true;
              el.classList.remove('opacity-0');
            }, 280);
            el.setAttribute('data-save-flash-hide', String(hide));
          }, 1600);
          el.setAttribute('data-save-flash-timer', String(timer));
        }

        window.showSaveFlash = showSaveFlash;

        document.querySelectorAll('[data-save-flash]').forEach(function (node) {
          if (!(node instanceof HTMLElement)) return;
          if (node.classList.contains('hidden') || node.hidden) return;
          showSaveFlash(node);
        });

        try {
          var url = new URL(window.location.href);
          var keys = [
            'saved',
            'peopleSaved',
            'peopleUser',
            'credentialingSaved',
            'announcementSaved',
          ];
          var changed = false;
          keys.forEach(function (key) {
            if (url.searchParams.has(key)) {
              url.searchParams.delete(key);
              changed = true;
            }
          });
          if (changed) {
            window.setTimeout(function () {
              history.replaceState(null, '', url.pathname + url.search + url.hash);
            }, 2200);
          }
        } catch (e) {}
      })();
    </script>
    {
      employee?.status === 'active' && (
        <script
          is:inline
          define:vars={{
            userId: employee.id,
            canSeeFinancials,
            canSeeManagement,
          }}
        >
          (function () {
            var path = window.location.pathname.replace(/\/$/, '') || '/';
            var allowed = ['/apps', '/directory', '/account', '/announcements', '/notifications', '/workspace', '/messages'];
            if (canSeeFinancials) allowed.push('/financials');
            if (canSeeManagement) allowed.push('/admin');
            if (allowed.indexOf(path) === -1) return;
            try {
              var key = 'portal:home-visits:' + userId;
              var raw = localStorage.getItem(key);
              var counts = raw ? JSON.parse(raw) : {};
              if (!counts || typeof counts !== 'object') counts = {};
              counts[path] = (counts[path] || 0) + 1;
              localStorage.setItem(key, JSON.stringify(counts));
            } catch (e) {}
          })();
        </script>
        <script is:inline>
          (function () {
            var track = document.querySelector('[data-portal-nav]');
            var pill = document.querySelector('[data-portal-nav-pill]');
            if (!(track instanceof HTMLElement) || !(pill instanceof HTMLElement)) return;

            var STORAGE_KEY = 'portal:nav-pill';
            var reduceMotion =
              window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

            function activeLink() {
              return track.querySelector('[data-portal-nav-link][aria-current="page"]');
            }

            function placePill(link, animate) {
              if (!(link instanceof HTMLElement)) {
                pill.style.transition = animate && !reduceMotion ? 'opacity 160ms ease' : 'none';
                pill.style.opacity = '0';
                return;
              }
              var trackRect = track.getBoundingClientRect();
              var linkRect = link.getBoundingClientRect();
              var left = linkRect.left - trackRect.left + track.scrollLeft;
              var top = linkRect.top - trackRect.top + track.scrollTop;
              if (!animate || reduceMotion) {
                pill.style.transition = 'none';
              } else {
                pill.style.transition =
                  'transform 320ms cubic-bezier(0.22, 1, 0.36, 1), width 320ms cubic-bezier(0.22, 1, 0.36, 1), height 320ms cubic-bezier(0.22, 1, 0.36, 1), opacity 200ms ease';
              }
              pill.style.width = linkRect.width + 'px';
              pill.style.height = linkRect.height + 'px';
              pill.style.transform = 'translate(' + left + 'px, ' + top + 'px)';
              pill.style.opacity = '1';
            }

            function readStored() {
              try {
                var raw = sessionStorage.getItem(STORAGE_KEY);
                if (!raw) return null;
                sessionStorage.removeItem(STORAGE_KEY);
                return JSON.parse(raw);
              } catch (e) {
                return null;
              }
            }

            function storeFrom(link) {
              if (!(link instanceof HTMLElement)) return;
              var trackRect = track.getBoundingClientRect();
              var linkRect = link.getBoundingClientRect();
              try {
                sessionStorage.setItem(
                  STORAGE_KEY,
                  JSON.stringify({
                    left: linkRect.left - trackRect.left + track.scrollLeft,
                    top: linkRect.top - trackRect.top + track.scrollTop,
                    width: linkRect.width,
                    height: linkRect.height,
                  }),
                );
              } catch (e) {}
            }

            function clearStored() {
              try {
                sessionStorage.removeItem(STORAGE_KEY);
              } catch (e) {}
            }

            var current = activeLink();
            var stored = readStored();
            if (stored && current instanceof HTMLElement && !reduceMotion) {
              pill.style.transition = 'none';
              pill.style.width = stored.width + 'px';
              pill.style.height = stored.height + 'px';
              pill.style.transform = 'translate(' + stored.left + 'px, ' + stored.top + 'px)';
              pill.style.opacity = '1';
              requestAnimationFrame(function () {
                requestAnimationFrame(function () {
                  placePill(current, true);
                });
              });
            } else {
              placePill(current, false);
            }

            track.addEventListener('click', function (event) {
              var target = event.target;
              if (!(target instanceof Element)) return;
              var link = target.closest('[data-portal-nav-link]');
              if (!(link instanceof HTMLElement) || !track.contains(link)) return;
              if (link.getAttribute('aria-current') === 'page') {
                clearStored();
                return;
              }
              var from = activeLink();
              if (from instanceof HTMLElement) storeFrom(from);
              else clearStored();
            });

            document.querySelectorAll('[data-portal-nav-external]').forEach(function (node) {
              node.addEventListener('click', function () {
                clearStored();
              });
            });

            window.addEventListener('resize', function () {
              placePill(activeLink(), false);
            });
          })();
        </script>
        <script is:inline>
          (function () {
            var badge = document.querySelector('[data-messages-nav-badge]');
            if (!badge) return;
            function refresh() {
              if (document.visibilityState !== 'visible') return;
              fetch('/api/messages/unread-count', { headers: { Accept: 'application/json' } })
                .then(function (res) {
                  return res.json().then(function (json) {
                    return { ok: res.ok, json: json };
                  });
                })
                .then(function (result) {
                  if (!result.ok) return;
                  var count = Number(result.json.count || 0);
                  badge.textContent = count > 99 ? '99+' : String(count);
                  badge.classList.toggle('hidden', count <= 0);
                })
                .catch(function () {});
            }
            window.setInterval(refresh, 60000);
          })();
        </script>
      )
    }
  </body>
</html>
