---
import '../styles/global.css';
import PreviewBanner from '../components/PreviewBanner.astro';
import { canAccessManagement, hasPermission } from '../lib/permissions';

interface Props {
  title: string;
  wide?: boolean;
}

const { title, wide = false } = Astro.props;
const employee = Astro.locals.employee;
const canSeeFinancials = hasPermission(employee, 'financials:view');
const canSeeManagement = canAccessManagement(employee);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="description" content="Private employee portal for Woven Sage Counseling." />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <title>{title} | Woven Sage Employee Portal</title>
  </head>
  <body class="flex min-h-screen flex-col">
    <PreviewBanner />
    {
      employee?.status === 'active' && (
        <header class="border-b border-sage-dark/10 bg-cream/90">
          <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-5 py-3 sm:px-8">
            <a href="/" class="flex items-center gap-3">
              <img
                src="https://wovensage.com/images/logo-text-header-transparent.png"
                alt="Woven Sage Counseling"
                class="h-7 w-auto"
                width="220"
                height="38"
              />
              <span class="hidden text-xs uppercase tracking-[0.18em] text-sage-dark/70 sm:inline">
                Employee portal
              </span>
            </a>
            <nav class="flex flex-wrap items-center justify-end gap-x-3 gap-y-2 text-sm">
              <a href="/" class="text-sage-dark/80 hover:text-sage-dark">Home</a>
              <a href="/apps" class="text-sage-dark/80 hover:text-sage-dark">Applications</a>
              <a href="/directory" class="text-sage-dark/80 hover:text-sage-dark">Directory</a>
              <a href="/resources" class="text-sage-dark/80 hover:text-sage-dark">Resources</a>
              <div
                class="inline-flex flex-wrap items-center gap-x-3 gap-y-1 rounded-full bg-sage/25 px-3 py-1 ring-1 ring-sage-dark/15"
                aria-label="Special access"
              >
                {canSeeFinancials ? (
                  <a href="/financials" class="font-medium text-sage-dark hover:text-charcoal">
                    Financials
                  </a>
                ) : (
                  <span
                    class="cursor-not-allowed font-medium text-sage-dark/40"
                    title="Requires financial access"
                    aria-disabled="true"
                  >
                    Financials
                  </span>
                )}
                {canSeeManagement ? (
                  <a href="/management" class="font-medium text-sage-dark hover:text-charcoal">
                    Management
                  </a>
                ) : (
                  <span
                    class="cursor-not-allowed font-medium text-sage-dark/40"
                    title="Requires management access"
                    aria-disabled="true"
                  >
                    Management
                  </span>
                )}
              </div>
              <a href="/account" class="text-sage-dark/80 hover:text-sage-dark">Account</a>
            </nav>
          </div>
        </header>
      )
    }
    <main class="flex-1">
      <div class:list={['mx-auto px-5 py-10 sm:px-8', wide ? 'max-w-6xl' : 'max-w-3xl']}>
        <slot />
      </div>
    </main>
  </body>
</html>
