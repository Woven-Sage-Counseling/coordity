{
  "name": "wovensage-portal-preview",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "types": "wrangler types --config wrangler.jsonc",
    "db:migrate:local": "wrangler d1 migrations apply wovensage-portal-preview --local --config wrangler.jsonc",
    "db:migrate:preview": "wrangler d1 migrations apply wovensage-portal-preview --remote --config wrangler.jsonc"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.4",
    "@astrojs/cloudflare": "^12.6.10",
    "@astrojs/tailwind": "^6.0.2",
    "astro": "^5.14.4",
    "better-auth": "^1.5.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "latest",
    "wrangler": "^4.40.0"
  }
}
