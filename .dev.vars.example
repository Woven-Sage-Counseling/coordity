# Local-only secrets. Copy to .dev.vars and never commit.
# This file is for the PREVIEW portal, not wovensage.com.

BETTER_AUTH_SECRET=replace-with-a-long-random-string
BETTER_AUTH_URL=http://localhost:4321
PORTAL_BOOTSTRAP_TOKEN=replace-with-a-long-random-string
PORTAL_OWNER_EMAIL=admin@wovensage.com
COORDITY_PLATFORM_OWNER_EMAIL=admin@coordity.com
# Optional; falls back to PORTAL_BOOTSTRAP_TOKEN if unset
# COORDITY_PLATFORM_BOOTSTRAP_TOKEN=replace-with-a-long-random-string
# From address for ALL outbound Coordity email (early access, invites, time off, etc.)
# Verify coordity.com in Resend and use an address on that domain.
COORDITY_FROM_EMAIL=admin@coordity.com
PORTAL_FROM_EMAIL=admin@coordity.com
PORTAL_ENVIRONMENT=preview

# Resend
# RESEND_API_KEY=

# QuickBooks (optional until OAuth is connected)
# QB_CLIENT_ID=
# QB_CLIENT_SECRET=
# QB_ENVIRONMENT=sandbox

# Google Calendar (optional until OAuth is connected)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
